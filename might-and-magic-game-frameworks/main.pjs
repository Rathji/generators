$meta
  title = Might & Magic Framework
  description = A playable framework for a Heroes-of-Might-&-Magic-style strategy game: hex adventure map, towns, heroes, resources, tactical combat.
  tags = strategy, framework, turn-based, fantasy
  header
    mode = minimal

kv = {import:kv-plugin}

// Config defaults (user-tweakable). The game logic lives in src/ (see src/main.js).
gameConfig
  mapW = 24
  mapH = 16
  players = 2 // human + AI (framework currently supports 1v1)
