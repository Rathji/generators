// ============================================================================
//  PROJECT-U — CENTRAL DASHBOARD HUB
//  High-level configuration surface. Behaviour and screens live in src/; this
//  file holds the generator's identity, metadata and the `pu` config block that
//  src/app.js reads on boot (mirrors the template-u framework conventions).
// ============================================================================

$meta
  title = Project-U — Project U dashboard hub
  description = The central command centre for the Project U family of small-business generators — launch every member tool, search across the whole suite, and see what needs attention from one responsive workspace.
  image = https://user.uploads.dev/file/6d72e2e38f5f0fc5b5e14ddc7ce00d8f.jpg
  tags = project u, dashboard, hub, launcher, small business, workspace, command centre, productivity
  header
    mode = minimal

pu
  appTitle = Project-U
  appShortTitle = PU
  tagline = Your Project U command centre
  slug = project-u
  companyName = Project U
  version = 0.1.0
  storageNamespace = pu-project-u
  defaultTheme = navy
  logoMark = PU
  copyright = Project U

  // Branding overrides — consumed by src/framework/branding.js and converted to
  // semantic --pu-* theme tokens. Leave a value blank to inherit the default.
  branding
    primary = #1e3a8a
    accent = #0d9488
    fontSans = Inter
