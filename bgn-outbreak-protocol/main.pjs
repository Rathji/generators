// ─────────────────────────────────────────────────────────────
//  OUTBREAK PROTOCOL — main.pjs
//  A complete recreation of Pandemic: a 2–4 player cooperative
//  game of containing four diseases and curing the world.
//  Task backlog: src/roadmap.pjs
// ─────────────────────────────────────────────────────────────

$meta
  title = Outbreak Protocol
  description = A complete recreation of Pandemic — a cooperative 2–4 player race to contain four diseases, discover cures, and save humanity before outbreaks overwhelm the world.
  tags = pandemic, board game, cooperative, strategy, multiplayer, disease, outbreak, online
  image = https://user.uploads.dev/file/8224a778fd3dc9b334c3fcfe0fd49259.jpg
  header
    mode = minimal

hubUrl = https://perchance.org/bgn-boardgame-network  // ← SET THIS to your network hub's URL
projectsUrl = https://perchance.org/rathjis-generators  // ← SET THIS to your Perchance projects page
authorInitial = O  // initial shown on the "Rathji's Projects" badge
gameTitle = Outbreak Protocol
gameTagline = A cooperative race to contain four diseases and cure the world.
gameKicker = Contain · Cure · Save Humanity
gameGenre = Co-op Strategy
gamePlayers = 2–4 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/8224a778fd3dc9b334c3fcfe0fd49259.jpg
logoImage = https://user.uploads.dev/file/3d98b536ce420f7938f02d738b4d2099.jpg

// Disease colors used across the app (blue / yellow / black / red)
diseaseColors
  blue
  yellow
  black
  red

// ─────────────────────────────────────────────────────────────
//  WORLD — the 48-city network of the base game.
//  Each city: {name, color (blue|yellow|black|red), mapX, mapY, links[]}.
//  mapX/mapY are geographic longitude/latitude (for board projection).
//  Task 1 (roadmap): city network model + lookup + validation.
//  Official map data cross-checked against the Z-Man rulebook
//  (2024 reprint): 48 city cards, 7 role cards, 6 research-station
//  limit; no Toronto on the base map; Algiers present; Cairo is
//  yellow (Africa), Algiers/Moscow/Middle-East/India are black.
// ─────────────────────────────────────────────────────────────
buildWorld() =>
  const C = [
    {name:"San Francisco", color:"blue", mapX:-122.42, mapY:37.77, links:["Chicago","Los Angeles","Tokyo","Manila"]},
    {name:"Chicago", color:"blue", mapX:-87.63, mapY:41.88, links:["San Francisco","Los Angeles","Mexico City","Atlanta","Montreal"]},
    {name:"Montreal", color:"blue", mapX:-73.57, mapY:45.50, links:["Chicago","New York","Washington"]},
    {name:"New York", color:"blue", mapX:-74.01, mapY:40.71, links:["Montreal","Washington","London","Madrid"]},
    {name:"Washington", color:"blue", mapX:-77.04, mapY:38.91, links:["Montreal","New York","Atlanta","Miami"]},
    {name:"Atlanta", color:"blue", mapX:-84.39, mapY:33.75, links:["Chicago","Washington","Miami"]},
    {name:"Los Angeles", color:"blue", mapX:-118.24, mapY:34.05, links:["San Francisco","Chicago","Mexico City","Sydney"]},
    {name:"London", color:"blue", mapX:-0.13, mapY:51.51, links:["New York","Madrid","Paris","Essen"]},
    {name:"Madrid", color:"blue", mapX:-3.70, mapY:40.42, links:["New York","London","Paris","Algiers","São Paulo"]},
    {name:"Paris", color:"blue", mapX:2.35, mapY:48.86, links:["London","Madrid","Essen","Milan","Algiers"]},
    {name:"Essen", color:"blue", mapX:7.01, mapY:51.46, links:["London","Paris","Milan","St. Petersburg"]},
    {name:"Milan", color:"blue", mapX:9.19, mapY:45.46, links:["Paris","Essen","St. Petersburg","Istanbul"]},
    {name:"St. Petersburg", color:"blue", mapX:30.32, mapY:59.94, links:["Essen","Milan","Istanbul","Moscow"]},
    {name:"Mexico City", color:"yellow", mapX:-99.13, mapY:19.43, links:["Los Angeles","Chicago","Miami","Bogotá","Lima"]},
    {name:"Miami", color:"yellow", mapX:-80.19, mapY:25.76, links:["Atlanta","Washington","Mexico City","Bogotá"]},
    {name:"Bogotá", color:"yellow", mapX:-74.07, mapY:4.71, links:["Mexico City","Miami","Lima","Buenos Aires","São Paulo"]},
    {name:"Lima", color:"yellow", mapX:-77.04, mapY:-12.05, links:["Mexico City","Bogotá","Santiago","Buenos Aires"]},
    {name:"Santiago", color:"yellow", mapX:-70.67, mapY:-33.45, links:["Lima","Buenos Aires"]},
    {name:"Buenos Aires", color:"yellow", mapX:-58.38, mapY:-34.60, links:["Bogotá","Lima","Santiago","São Paulo"]},
    {name:"São Paulo", color:"yellow", mapX:-46.63, mapY:-23.55, links:["Madrid","Bogotá","Buenos Aires","Lagos"]},
    {name:"Lagos", color:"yellow", mapX:3.38, mapY:6.52, links:["São Paulo","Khartoum","Kinshasa"]},
    {name:"Khartoum", color:"yellow", mapX:32.56, mapY:15.50, links:["Lagos","Cairo","Kinshasa","Johannesburg"]},
    {name:"Kinshasa", color:"yellow", mapX:15.27, mapY:-4.44, links:["Lagos","Khartoum","Johannesburg"]},
    {name:"Johannesburg", color:"yellow", mapX:28.05, mapY:-26.20, links:["Khartoum","Kinshasa"]},
    {name:"Cairo", color:"yellow", mapX:31.24, mapY:30.04, links:["Algiers","Istanbul","Baghdad","Riyadh","Khartoum"]},
    {name:"Algiers", color:"black", mapX:3.06, mapY:36.75, links:["Madrid","Paris","Istanbul","Cairo"]},
    {name:"Istanbul", color:"black", mapX:28.98, mapY:41.01, links:["Algiers","St. Petersburg","Milan","Cairo","Baghdad"]},
    {name:"Baghdad", color:"black", mapX:44.37, mapY:33.32, links:["Istanbul","Cairo","Riyadh","Tehran","Karachi"]},
    {name:"Riyadh", color:"black", mapX:46.68, mapY:24.71, links:["Cairo","Baghdad","Karachi"]},
    {name:"Tehran", color:"black", mapX:51.39, mapY:35.69, links:["Baghdad","Moscow","Karachi","Delhi"]},
    {name:"Moscow", color:"black", mapX:37.62, mapY:55.76, links:["St. Petersburg","Tehran"]},
    {name:"Karachi", color:"black", mapX:67.01, mapY:24.86, links:["Baghdad","Riyadh","Tehran","Delhi","Mumbai"]},
    {name:"Delhi", color:"black", mapX:77.21, mapY:28.61, links:["Tehran","Karachi","Kolkata","Chennai","Mumbai"]},
    {name:"Kolkata", color:"black", mapX:88.36, mapY:22.57, links:["Delhi","Chennai","Bangkok","Hong Kong"]},
    {name:"Chennai", color:"black", mapX:80.27, mapY:13.08, links:["Delhi","Kolkata","Mumbai","Bangkok","Jakarta"]},
    {name:"Mumbai", color:"black", mapX:72.88, mapY:19.08, links:["Karachi","Delhi","Chennai"]},
    {name:"Beijing", color:"red", mapX:116.41, mapY:39.90, links:["Shanghai","Seoul"]},
    {name:"Shanghai", color:"red", mapX:121.47, mapY:31.23, links:["Beijing","Seoul","Taipei","Hong Kong","Tokyo"]},
    {name:"Seoul", color:"red", mapX:126.98, mapY:37.57, links:["Beijing","Shanghai","Tokyo"]},
    {name:"Tokyo", color:"red", mapX:139.69, mapY:35.68, links:["San Francisco","Seoul","Shanghai","Osaka"]},
    {name:"Osaka", color:"red", mapX:135.50, mapY:34.69, links:["Tokyo","Taipei"]},
    {name:"Taipei", color:"red", mapX:121.56, mapY:25.03, links:["Osaka","Shanghai","Hong Kong","Manila"]},
    {name:"Hong Kong", color:"red", mapX:114.17, mapY:22.32, links:["Shanghai","Taipei","Bangkok","Manila","Kolkata"]},
    {name:"Bangkok", color:"red", mapX:100.50, mapY:13.76, links:["Hong Kong","Kolkata","Chennai","Jakarta","Ho Chi Minh City"]},
    {name:"Manila", color:"red", mapX:120.98, mapY:14.60, links:["San Francisco","Taipei","Hong Kong","Ho Chi Minh City","Sydney"]},
    {name:"Jakarta", color:"red", mapX:106.85, mapY:-6.21, links:["Chennai","Bangkok","Ho Chi Minh City","Sydney"]},
    {name:"Ho Chi Minh City", color:"red", mapX:106.63, mapY:10.82, links:["Bangkok","Manila","Jakarta"]},
    {name:"Sydney", color:"red", mapX:151.21, mapY:-33.87, links:["Los Angeles","Manila","Jakarta"]}
  ];
  const byNameMap = new Map();
  for (const c of C) byNameMap.set(c.name, c);
  const byName = (name) => byNameMap.get(name) || null;
  const VALID_COLORS = ["blue", "yellow", "black", "red"];
  const validate = () => {
    const errors = [];
    if (C.length !== 48) errors.push("expected 48 cities, got " + C.length);
    for (const c of C) {
      if (!VALID_COLORS.includes(c.color)) errors.push(c.name + " has invalid color: " + c.color);
      if (typeof c.mapX !== "number" || typeof c.mapY !== "number") errors.push(c.name + " missing coordinates");
      if (!Array.isArray(c.links) || c.links.length === 0) errors.push(c.name + " has no links");
      for (const l of c.links) {
        if (l === c.name) errors.push(c.name + " links to itself");
        else if (!byNameMap.has(l)) errors.push(c.name + " links to unknown city: " + l);
        else if (!byNameMap.get(l).links.includes(c.name)) errors.push(c.name + "<->" + l + " is not bidirectional");
      }
    }
    return { ok: errors.length === 0, errors };
  };
  const selfTest = () => {
    const results = [];
    const check = (name, pass, detail) => results.push({ name, pass, detail });
    const v = validate();
    check("validate.48-cities", C.length === 48, "got " + C.length);
    check("validate.all-links-resolve-and-bidirectional", v.ok, v.errors.slice(0, 3).join(" | "));
    check("byName.Atlanta", byName("Atlanta") !== null && byName("Atlanta").color === "blue");
    check("byName.unknown-returns-null", byName("Nowhere") === null);
    check("colors.exactly-4", VALID_COLORS.every(col => C.some(c => c.color === col)));
    check("colors.blue-13", C.filter(c => c.color === "blue").length === 13);
    check("colors.yellow-12", C.filter(c => c.color === "yellow").length === 12);
    check("colors.black-11", C.filter(c => c.color === "black").length === 11);
    check("colors.red-12", C.filter(c => c.color === "red").length === 12);
    check("coords.all-numbers", C.every(c => typeof c.mapX === "number" && typeof c.mapY === "number"));
    const byColor = {};
    for (const c of C) byColor[c.color] = (byColor[c.color] || 0) + 1;
    return { pass: results.every(r => r.pass), results, summary: { cities: C.length, byColor } };
  };
  return { cities: C, count: C.length, byName, validate, selfTest, cityCount: () => C.length };
world = [root.buildWorld()]

// ─────────────────────────────────────────────────────────────
//  DISEASES — the four global diseases of the base game.
//  diseases[color] = {color, cubeSupply, cured, eradicated}.
//  - addCube(color): removes 1 cube from supply (a cube was placed
//    on the board). Returns {ok, supply, reachedZero, color};
//    ok=false when the supply is already 0 (the Phase 4 loss hook
//    keys off this) and reachedZero=true only on the call that
//    makes supply hit 0. Supply never goes below 0.
//  - treatCube(color): returns 1 cube to the supply (capped at 24).
//  - setCured/setEradicated/isCured/isEradicated: flag control.
//  GOTCHA: perchance returns a fresh wrapper object on every root
//  property access, so direct assignment (root.diseases.x.cured = true)
//  does NOT persist — ALWAYS mutate via these methods.
//  Task 2 (roadmap): disease state model + supply accounting.
// ─────────────────────────────────────────────────────────────
buildDiseases() =>
  const COLORS = ["blue", "yellow", "black", "red"];
  const D = {};
  for (const col of COLORS) {
    D[col] = { color: col, cubeSupply: 24, cured: false, eradicated: false };
  }
  const addCube = (color) => {
    const d = D[color];
    if (!d) return { ok: false, error: "unknown color: " + color };
    if (d.cubeSupply <= 0) return { ok: false, supply: 0, reachedZero: false, color };
    d.cubeSupply--;
    return { ok: true, supply: d.cubeSupply, reachedZero: d.cubeSupply === 0, color };
  };
  const treatCube = (color) => {
    const d = D[color];
    if (!d) return { ok: false, error: "unknown color: " + color };
    if (d.cubeSupply < 24) d.cubeSupply++;
    return { ok: true, supply: d.cubeSupply, color };
  };
  const setSupply = (color, value) => {
    const d = D[color];
    if (!d) return null;
    d.cubeSupply = Math.max(0, Math.min(24, Math.floor(Number(value)) || 0));
    return d.cubeSupply;
  };
  const setCured = (color, value) => {
    const d = D[color];
    if (!d) return null;
    d.cured = value === undefined ? true : !!value;
    return d.cured;
  };
  const setEradicated = (color, value) => {
    const d = D[color];
    if (!d) return null;
    if ((value === undefined ? true : !!value) && !d.cured) return false;
    d.eradicated = value === undefined ? true : !!value;
    return d.eradicated;
  };
  const isCured = (color) => (D[color] ? D[color].cured : false);
  const isEradicated = (color) => (D[color] ? D[color].eradicated : false);
  const selfTest = () => {
    const results = [];
    const check = (name, pass, detail) => results.push({ name, pass, detail });
    const f = root.buildDiseases();
    check("state.4-colors", COLORS.every(col => f[col] && !Array.isArray(f[col])), COLORS.join(","));
    check("state.initial-24", COLORS.every(col => f[col].cubeSupply === 24 && f[col].cured === false && f[col].eradicated === false));
    check("addCube.decrements", (f.addCube("blue").ok === true && f.blue.cubeSupply === 23));
    check("addCube.reachedZero-flags-transition", (() => { f.black.cubeSupply = 1; const r = f.addCube("black"); return r.ok && r.supply === 0 && r.reachedZero === true; })());
    check("addCube.at-zero-ok-false", (() => { const r = f.addCube("black"); return r.ok === false && r.supply === 0 && f.black.cubeSupply === 0; })());
    check("addCube.never-below-zero", (() => { f.red.cubeSupply = 0; f.addCube("red"); return f.red.cubeSupply === 0; })());
    check("treatCube.returns-cube", (() => { f.blue.cubeSupply = 5; const r = f.treatCube("blue"); return r.ok && f.blue.cubeSupply === 6; })());
    check("treatCube.capped-at-24", (() => { f.red.cubeSupply = 24; f.treatCube("red"); return f.red.cubeSupply === 24; })());
    check("treatCube-restores-placeability", (() => { f.yellow.cubeSupply = 0; f.treatCube("yellow"); const r = f.addCube("yellow"); return r.ok && f.yellow.cubeSupply === 0 && r.reachedZero === true; })());
    check("unknown-color-rejected", f.addCube("green").ok === false && f.treatCube("green").ok === false);
    check("setSupply.clamps-0to24", (() => { const g = root.buildDiseases(); g.setSupply("blue", 5); const a = g.blue.cubeSupply; g.setSupply("blue", 99); const b = g.blue.cubeSupply; g.setSupply("blue", -3); const c = g.blue.cubeSupply; return a === 5 && b === 24 && c === 0; })());
    check("flags.setCured-readback", (() => { const g = root.buildDiseases(); g.setCured("blue"); return g.isCured("blue") === true && g.isCured("red") === false; })());
    check("flags.eradicate-requires-cured", (() => { const g = root.buildDiseases(); g.setCured("yellow"); const a = g.setEradicated("yellow", true); const b = g.setEradicated("black", true); return a === true && b === false && g.isEradicated("yellow") === true && g.isEradicated("black") === false; })());
    return { pass: results.every(r => r.pass), results };
  };
  D.addCube = addCube;
  D.treatCube = treatCube;
  D.setSupply = setSupply;
  D.setCured = setCured;
  D.setEradicated = setEradicated;
  D.isCured = isCured;
  D.isEradicated = isEradicated;
  D.selfTest = selfTest;
  return D;

// ─────────────────────────────────────────────────────────────
//  PLAYERS — the 2–4 player roster and pawn model.
//  player = {id, name, role, color, location, hand[], actions,
//            isBot, isTurn}; players start in Atlanta (rulebook).
//  - players.createPlayer({name, role, color, isBot, location})
//  - players.startTurn(p): actions→4, isTurn→true, and runs the
//    Medic's start-of-turn auto-clear (root.board.clearCuredAtCity).
//  - players.endTurn(p): isTurn→false.
//  Task 3 (roadmap): player state model + turn lifecycle.
// ─────────────────────────────────────────────────────────────
playerRoles = [["medic","scientist","researcher","operations-expert","dispatcher","quarantine-specialist","contingency-planner"]]
pawnColors = [["red","yellow","blue","green","black","white","orange"]]

buildPlayers() =>
  const ROLES = ["medic","scientist","researcher","operations-expert","dispatcher","quarantine-specialist","contingency-planner"];
  const PAWN_COLORS = ["red","yellow","blue","green","black","white","orange"];
  let nextId = 1;
  const createPlayer = (opts) => {
    const o = opts || {};
    const name = o.name;
    const role = o.role;
    const color = o.color;
    const isBot = !!o.isBot;
    const location = o.location || "Atlanta";
    if (!name || typeof name !== "string") throw new Error("player requires a name");
    if (!ROLES.includes(role)) throw new Error("invalid role: " + role);
    if (!PAWN_COLORS.includes(color)) throw new Error("invalid pawn color: " + color);
    if (!root.world.byName(location)) throw new Error("invalid location: " + location);
    return {
      id: nextId++,
      name: name,
      role: role,
      color: color,
      location: location,
      hand: [],
      actions: 4,
      isBot: isBot,
      isTurn: false,
      opexFlightUsed: false,
      dispatcherRelocateUsed: false,
      contingencyEvent: null
    };
  };
  const startTurn = (player) => {
    player.actions = 4;
    player.isTurn = true;
    player.opexFlightUsed = false;
    player.dispatcherRelocateUsed = false;
    if (player.role === "medic" && root.board && typeof root.board.clearCuredAtCity === "function") {
      root.board.clearCuredAtCity(player.location, player);
    }
    return player;
  };
  const endTurn = (player) => {
    player.isTurn = false;
    return player;
  };
  const selfTest = () => {
    const results = [];
    const check = (name, pass, detail) => results.push({ name, pass, detail });
    const fresh = root.buildPlayers();
    const make = fresh.createPlayer;
    const p = make({ name: "Anna", role: "scientist", color: "white" });
    check("create.defaults", p.actions === 4 && p.isTurn === false && p.isBot === false && p.location === "Atlanta" && Array.isArray(p.hand) && p.hand.length === 0 && p.id === 1);
    check("create.fields-set", p.name === "Anna" && p.role === "scientist" && p.color === "white");
    p.actions = 0;
    fresh.startTurn(p);
    check("startTurn.resets-actions", p.actions === 4 && p.isTurn === true);
    fresh.endTurn(p);
    check("endTurn.clears-isTurn", p.isTurn === false);
    check("startTurn.medic-role-hook", (() => {
      const m = make({ name: "Doc", role: "medic", color: "green" });
      const atlanta = m.location;
      const before = {};
      const cols = ["blue", "yellow", "black", "red"];
      for (const col of cols) before[col] = root.board.cubeCount(atlanta, col);
      fresh.startTurn(m);
      for (const col of cols) {
        const diff = before[col] - root.board.cubeCount(atlanta, col);
        for (let i = 0; i < diff; i++) root.board.placeCube(atlanta, col);
        for (let i = 0; i < -diff; i++) root.board.removeCube(atlanta, col);
      }
      return m.actions === 4 && m.isTurn === true && m.role === "medic";
    })());
    check("roles.7", ROLES.length === 7);
    check("create.invalid-role-throws", (() => { try { make({ name: "X", role: "baker", color: "red" }); return false; } catch (e) { return true; } })());
    check("create.invalid-color-throws", (() => { try { make({ name: "X", role: "medic", color: "pink" }); return false; } catch (e) { return true; } })());
    check("create.invalid-location-throws", (() => { try { make({ name: "X", role: "medic", color: "red", location: "Nowhere" }); return false; } catch (e) { return true; } })());
    check("create.bot-flag", make({ name: "Bot", role: "medic", color: "red", isBot: true }).isBot === true);
    return { pass: results.every(r => r.pass), results };
  };
  return { createPlayer: createPlayer, startTurn: startTurn, endTurn: endTurn, selfTest: selfTest, roles: ROLES, pawnColors: PAWN_COLORS };

// ─────────────────────────────────────────────────────────────
//  BOARD — global board state (game-feature layer).
//  - cubes[city][color] = 0..3 per city; placeCube enforces the cap
//    and returns {ok:false, reason:"city full"} at 3 cubes — the
//    Phase 4 infection flow keys its outbreak branch off that.
//  - stations: per-city research-station flags + hasStation/stationList.
//  - outbreakCounter (start 0, max 8) via incrementOutbreaks().
//  - infectionRate (start 2, max 4) via raiseInfectionRate().
//  - diseaseCubeCounts(): per-disease total cubes on the board.
//  - clearCuredAtCity(city): removes cubes of CURED diseases from a
//    city (activates the players.startTurn Medic hook from task 3).
//  Task 4 (roadmap): board features + trackers.
// ─────────────────────────────────────────────────────────────
buildBoard() =>
  const COLS = ["blue", "yellow", "black", "red"];
  const worldCities = root.world.cities;
  const cubes = {};
  const stations = {};
  let outbreaks = 0;
  // Official infection-rate track: one step forward per epidemic
  // (2,2,2,3,3,4,4). ratePos = how many epidemics have advanced the marker.
  const RATE_TRACK = [2, 2, 2, 3, 3, 4, 4];
  let ratePos = 0;
  for (const c of worldCities) cubes[c.name] = { blue: 0, yellow: 0, black: 0, red: 0 };
  const cubeCount = (city, color) => (cubes[city] && cubes[city][color]) || 0;
  const placeCube = (city, color) => {
    const c = cubes[city];
    if (!c) return { ok: false, reason: "unknown city: " + city };
    if (c[color] >= 3) return { ok: false, reason: "city full", city: city, color: color, count: c[color] };
    c[color]++;
    return { ok: true, city: city, color: color, count: c[color] };
  };
  const removeCube = (city, color) => {
    const c = cubes[city];
    if (!c) return { ok: false, reason: "unknown city: " + city };
    if (c[color] <= 0) return { ok: false, reason: "no cubes to remove", city: city, color: color };
    c[color]--;
    if (root.diseases.isCured(color) && diseaseCubeCounts()[color] === 0) root.diseases.setEradicated(color, true);
    return { ok: true, city: city, color: color, count: c[color] };
  };
  const placeStation = (city) => {
    if (!root.world.byName(city)) return false;
    stations[city] = true;
    return true;
  };
  const removeStation = (city) => {
    if (!stations[city]) return false;
    delete stations[city];
    return true;
  };
  const hasStation = (city) => stations[city] === true;
  const stationList = () => Object.keys(stations);
  const stationCount = () => stationList().length;
  const diseaseCubeCounts = () => {
    const totals = { blue: 0, yellow: 0, black: 0, red: 0 };
    for (const c of worldCities) {
      const row = cubes[c.name];
      for (const col of COLS) totals[col] += row[col];
    }
    return totals;
  };
  const totalCubes = () => {
    const t = diseaseCubeCounts();
    return t.blue + t.yellow + t.black + t.red;
  };
  const incrementOutbreaks = () => { if (outbreaks < 8) outbreaks++; return outbreaks; };
  const setOutbreaks = (value) => { outbreaks = Math.max(0, Math.min(8, Math.floor(Number(value)) || 0)); return outbreaks; };
  const raiseInfectionRate = () => { if (ratePos < RATE_TRACK.length - 1) ratePos++; return RATE_TRACK[ratePos]; };
  const clearCuredAtCity = (city) => {
    const c = cubes[city];
    if (!c) return { ok: false, reason: "unknown city: " + city };
    const cleared = [];
    for (const col of COLS) {
      if (root.diseases.isCured(col) && c[col] > 0) {
        cleared.push({ color: col, count: c[col] });
        while (c[col] > 0) removeCube(city, col);
      }
    }
    return { ok: true, cleared: cleared };
  };
  const selfTest = () => {
    const results = [];
    const check = (name, pass, detail) => results.push({ name, pass, detail });
    const b = root.buildBoard();
    check("init.all-cities-zero-cubes", b.diseaseCubeCounts().blue === 0 && b.diseaseCubeCounts().yellow === 0 && b.diseaseCubeCounts().black === 0 && b.diseaseCubeCounts().red === 0 && b.totalCubes() === 0);
    check("init.no-stations", b.stationCount() === 0);
    check("init.outbreaks-0-rate-2", b.getOutbreaks() === 0 && b.getInfectionRate() === 2);
    check("init.covers-48-cities", (() => { let n = 0; for (const c of root.world.cities) n += b.cubes[c.name] ? 1 : 0; return n === 48; })());
    check("placeCube.increments", b.placeCube("Atlanta", "blue").ok === true && b.cubeCount("Atlanta", "blue") === 1);
    check("placeCube.cap-at-3", (() => { b.placeCube("Atlanta", "blue"); b.placeCube("Atlanta", "blue"); const r = b.placeCube("Atlanta", "blue"); return r.ok === false && r.reason === "city full" && b.cubeCount("Atlanta", "blue") === 3; })());
    check("placeCube.unknown-city", b.placeCube("Nowhere", "blue").ok === false);
    check("removeCube.decrements", (() => { const r = b.removeCube("Atlanta", "blue"); return r.ok === true && b.cubeCount("Atlanta", "blue") === 2; })());
    check("removeCube.at-zero-rejected", (() => { b.removeCube("Atlanta", "blue"); b.removeCube("Atlanta", "blue"); const r = b.removeCube("Atlanta", "blue"); return r.ok === false && b.cubeCount("Atlanta", "blue") === 0; })());
    check("stations.place-and-lookup", (() => { b.placeStation("Chennai"); return b.hasStation("Chennai") === true && b.hasStation("Atlanta") === false && b.stationCount() === 1 && b.stationList()[0] === "Chennai"; })());
    check("stations.unknown-rejected", b.placeStation("Nowhere") === false && b.stationCount() === 1);
    check("stations.remove", (() => { const r = b.removeStation("Chennai"); return r === true && b.hasStation("Chennai") === false && b.stationCount() === 0 && b.removeStation("Chennai") === false; })());
    check("diseaseCubeCounts.sums", (() => { b.placeCube("Lagos", "yellow"); b.placeCube("Lagos", "yellow"); b.placeCube("Khartoum", "yellow"); b.placeCube("Tokyo", "red"); const t = b.diseaseCubeCounts(); return t.yellow === 3 && t.red === 1 && t.blue === 0 && t.black === 0 && b.totalCubes() === 4; })());
    check("outbreaks.capped-at-8", (() => { for (let i = 0; i < 10; i++) b.incrementOutbreaks(); return b.getOutbreaks() === 8; })());
    check("infectionRate.capped-at-4", (() => { for (let i = 0; i < 5; i++) b.raiseInfectionRate(); return b.getInfectionRate() === 4; })());
    check("clearCuredAtCity.clears-cured-only", (() => {
      b.placeCube("Delhi", "black"); b.placeCube("Delhi", "red"); b.placeCube("Delhi", "blue");
      const saved = {};
      for (const col of COLS) { saved[col] = { cured: root.diseases.isCured(col), eradicated: root.diseases.isEradicated(col) }; }
      for (const col of COLS) root.diseases.setCured(col, false);
      root.diseases.setCured("black", true);
      let cleared;
      try { cleared = b.clearCuredAtCity("Delhi"); } finally {
        for (const col of COLS) {
          root.diseases.setCured(col, saved[col].cured);
          root.diseases.setEradicated(col, saved[col].eradicated);
        }
      }
      return cleared.ok === true && cleared.cleared.length === 1 && cleared.cleared[0].color === "black" && cleared.cleared[0].count === 1 && b.cubeCount("Delhi", "black") === 0 && b.cubeCount("Delhi", "red") === 1 && b.cubeCount("Delhi", "blue") === 1;
    })());
    return { pass: results.every(r => r.pass), results };
  };
  return {
    cubes: cubes, stations: stations, placeCube: placeCube, removeCube: removeCube,
    cubeCount: cubeCount, placeStation: placeStation, hasStation: hasStation,
    stationList: stationList, stationCount: stationCount, removeStation: removeStation, diseaseCubeCounts: diseaseCubeCounts,
    totalCubes: totalCubes, incrementOutbreaks: incrementOutbreaks, raiseInfectionRate: raiseInfectionRate,
    getOutbreaks: () => outbreaks, setOutbreaks: setOutbreaks,
    getInfectionRate: () => RATE_TRACK[Math.min(ratePos, RATE_TRACK.length - 1)],
    getRatePos: () => ratePos, setRatePos: (p) => { ratePos = Math.max(0, Math.min(RATE_TRACK.length - 1, Math.floor(Number(p)) || 0)); },
    setInfectionRate: (value) => { const v = Math.max(2, Math.min(4, Math.floor(Number(value)) || 2)); ratePos = RATE_TRACK.indexOf(v); if (ratePos < 0) ratePos = v >= 4 ? RATE_TRACK.length - 1 : 0; return v; },
    clearCuredAtCity: clearCuredAtCity, selfTest: selfTest
  };

// ─────────────────────────────────────────────
//  ACTION FRAMEWORK — the turn controller's core.
//  An action is {id, legal(ctx)→null|reason, apply(ctx)→{ok,...},
//  cost?}. The registry (register/get/list/has/unregister) is seeded
//  with the 8 base-game actions as stubs; tasks 11–18 replace each
//  stub with its real legal/apply via register().
//  The turn controller:
//   - doAction(actionId, args?, playerIndex?): requires a live game,
//     the acting player, actions>0, then runs legal(ctx) (a returned
//     reason blocks the action: no cost, no log), applies, decrements
//     actions by cost (default 1), appends a log entry, and
//     auto-ends the turn (isTurn→false) when actions hit 0.
//     playerIndex defaults to the current player (gs.game.currentPlayerIndex).
//   - pass(playerIndex?): ends the turn early at no action cost and
//     logs it. Advancing to the next player belongs to full turn
//     sequencing (task 20); here the turn merely ENDS.
//  Log entries: {turn, player, name, action, args, result}. Only
//  APPLIED actions are logged; blocked/failed ones are not.
//  Task 10 (roadmap): action framework + turn controller.
// ─────────────────────────────────────────────
buildActionFramework() =>
  const actions = new Map();
  const stub = (id) => ({ id: id, legal: () => null, apply: () => ({ ok: false, error: "action '" + id + "' not implemented yet" }) });
  for (const id of ["drive", "direct-flight", "charter-flight", "shuttle-flight", "treat-disease", "build-station", "share-knowledge", "discover-cure", "operations-expert-flight", "dispatcher-relocate"]) {
    actions.set(id, stub(id));
  }
  const register = (def) => {
    if (!def || typeof def.id !== "string" || !def.id) return null;
    const entry = {
      id: def.id,
      legal: typeof def.legal === "function" ? def.legal : () => null,
      apply: typeof def.apply === "function" ? def.apply : () => ({ ok: false, error: "action '" + def.id + "' has no apply" }),
      cost: def.cost === undefined ? 1 : Math.max(0, def.cost)
    };
    actions.set(entry.id, entry);
    return entry;
  };
  const get = (id) => actions.get(id) || null;
  const has = (id) => actions.has(id);
  const list = () => [...actions.keys()];
  const unregister = (id) => actions.delete(id);
  const doAction = (actionId, args, playerIndex) => {
    const gs = root.__initGameState();
    if (!gs.game) return { ok: false, error: "no game" };
    const action = actions.get(actionId);
    if (!action) return { ok: false, error: "unknown action: " + actionId };
    const playersArr = gs.game.players;
    const idx = playerIndex === undefined ? gs.game.currentPlayerIndex : playerIndex;
    const player = playersArr[idx];
    if (!player) return { ok: false, error: "no player at index " + idx };
    if (!player.isTurn) return { ok: false, error: player.name + " is not the acting player" };
    if (player.actions <= 0) return { ok: false, error: "no actions remaining" };
    const ctx = { gs, player, playerIndex: idx, args: args || {} };
    const reason = action.legal(ctx);
    if (reason) return { ok: false, blocked: true, action: actionId, player: idx, reason: reason };
    const res = action.apply(ctx);
    if (!res || res.ok === false) return { ok: false, action: actionId, player: idx, error: res && res.error, result: res };
    root.checkEndCondition();
    root.medicAutoClear();
    if (action.cost > 0) player.actions -= action.cost;
    const turnEnded = player.actions <= 0;
    root.logEvent(player, actionId, { args: args || {}, result: res });
    if (turnEnded) root.players.endTurn(player);
    return { ok: true, action: actionId, player: idx, playerName: player.name, actionsLeft: player.actions, turnEnded: turnEnded, result: res };
  };
  const pass = (playerIndex) => {
    const gs = root.__initGameState();
    if (!gs.game) return { ok: false, error: "no game" };
    const idx = playerIndex === undefined ? gs.game.currentPlayerIndex : playerIndex;
    const player = gs.game.players[idx];
    if (!player) return { ok: false, error: "no player at index " + idx };
    if (!player.isTurn) return { ok: false, error: player.name + " is not the acting player" };
    root.logEvent(player, "pass", { args: null, result: { actionsLeft: player.actions } });
    root.players.endTurn(player);
    return { ok: true, action: "pass", player: idx, playerName: player.name };
  };
  return { register: register, get: get, has: has, list: list, unregister: unregister, doAction: doAction, pass: pass };

// ─────────────────────────────────────────────
//  HAND HELPERS — shared by every card-discarding action.
// ─────────────────────────────────────────────
findCardInHand(player, cardId) =>
  const hand = player.hand || [];
  for (let i = 0; i < hand.length; i++) {
    if (hand[i].id === cardId) return hand[i];
  }
  return null;

removeCardFromHand(player, card) =>
  const hand = player.hand || [];
  const i = hand.indexOf(card);
  if (i === -1) return null;
  hand.splice(i, 1);
  return card;

//  TURN LOG (task 39). logEvent(player, action, extra) appends a
//  timestamped entry {ts, turn, player, name, role, color, action,
//  ...extra} to gs.game.log (oldest→newest, capped at 200), tagging
//  each entry with the acting player's role and pawn color. Pass null
//  for `player` to tag the current player (draws, infections,
//  outbreaks, epidemics). Every applied action, pass, draw, infection,
//  outbreak, epidemic, event, and phase change is routed through it.
logEvent(player, action, extra) =>
  const gs = root.__initGameState();
  const p = player || (gs.game && gs.game.players[gs.game.currentPlayerIndex]);
  const entry = {
    ts: Date.now(),
    turn: gs.game ? gs.game.turnIndex : null,
    player: gs.game && p ? gs.game.players.indexOf(p) : null,
    name: p ? p.name : null,
    role: p ? p.role : null,
    color: p ? p.color : null,
    action: action
  };
  for (const k in (extra || {})) entry[k] = extra[k];
  if (gs.game) {
    gs.game.log.push(entry);
    while (gs.game.log.length > 200) gs.game.log.shift();
  }
  return entry;

//  MEDIC HELPERS (task 26). medicAtCity(city): true when any pawn with
//  the Medic role is currently in the city — the basis for the Medic's
//  "cured diseases do not infect the city he occupies" prevention.
//  medicAutoClear(): the Medic automatically removes all cubes of CURED
//  diseases from the city he occupies, for free, on any turn — wired to
//  run after every successfully applied action (so entering a city or a
//  cure being discovered elsewhere triggers it), and on players.startTurn.
medicAtCity(city) =>
  const gs = root.__initGameState();
  const roster = gs.game && gs.game.players ? gs.game.players : [];
  for (let i = 0; i < roster.length; i++) {
    if (roster[i].role === "medic" && roster[i].location === city) return true;
  }
  return false;

medicAutoClear() =>
  const gs = root.__initGameState();
  const roster = gs.game && gs.game.players ? gs.game.players : [];
  if (!root.board || typeof root.board.clearCuredAtCity !== "function") return 0;
  let cleared = 0;
  for (let i = 0; i < roster.length; i++) {
    if (roster[i].role === "medic") {
      const r = root.board.clearCuredAtCity(roster[i].location);
      if (r && r.ok) cleared += r.cleared.length;
    }
  }
  return cleared;

//  QUARANTINE SPECIALIST HELPERS (task 31). quarantineAtCity(city): true
//  when a Quarantine Specialist occupies the city itself OR any city linked
//  to it — no disease cubes of any color are placed there and (since an
//  outbreak can only be triggered by a would-be cube) no outbreak can
//  occur there. Reads the live roster so setup-time infection (run before
//  gs.game exists) is unaffected, per the rulebook.
quarantineAtCity(city) =>
  const gs = root.__initGameState();
  const roster = gs.game && gs.game.players ? gs.game.players : [];
  for (let i = 0; i < roster.length; i++) {
    const p = roster[i];
    if (p.role !== "quarantine-specialist") continue;
    if (p.location === city) return true;
    const links = root.world.byName(p.location).links;
    for (let j = 0; j < links.length; j++) if (links[j] === city) return true;
  }
  return false;

// ─────────────────────────────────────────────
//  MOVEMENT + CITY ACTIONS (tasks 11–18) — the real implementations
//  that replace the task-10 stubs via register(). Each costs 1 action;
//  the controller decrements and logs automatically. All four
//  movement actions also reject moving to the current city (no-op
//  guard) on top of the rulebook legality conditions:
//   - drive:          destination must be linked to the current city.
//   - direct-flight:  discard the destination city's card to move there.
//   - charter-flight: discard the current city's card to move anywhere.
//   - shuttle-flight: both endpoints must have a research station.
//   - treat-disease:  remove 1 cube (ALL when cured, eradicating the
//     disease on the board's last cube; the Medic removes ALL cubes of
//     the chosen color even when NOT cured, per task 26); removed cubes
//     return to supply.
//   - build-station:  discard the current city's card; when all 6
//     stations are placed, an existing one is moved (args.fromCity).
//   - share-knowledge: give/take a city card between co-located pawns
//     (args.direction "give"|"take", args.playerIndex); normally the
//     CURRENT city's card, but the Researcher may give any card (as
//     the actor) and may have any card of hers taken (as the donor),
//     via args.cardId (tasks 26–28 role powers); agreement between the
//     two players is enforced by the UI layer.
//   - discover-cure:  at a station city, discard 5 city cards of one
//     color to cure it (the Scientist needs only 4, task 27).
//  Discarded city cards go to the Player Discard Pile (rulebook).
// ─────────────────────────────────────────────
installActions(fw) =>
  const a = fw;
  a.register({
    id: "drive",
    legal: (ctx) => {
      const to = ctx.args.to;
      if (!root.world.byName(to)) return "unknown destination city: " + to;
      const target = ctx.player && ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      if (!target) return "no player at index " + ctx.args.pawnIndex;
      const from = target.location;
      if (to === from) return "already in " + to;
      if (!root.world.byName(from).links.includes(to)) return to + " is not linked to " + from;
      return null;
    },
    apply: (ctx) => {
      const target = ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      const from = target.location;
      target.location = ctx.args.to;
      return { ok: true, from: from, to: target.location };
    }
  });
  a.register({
    id: "direct-flight",
    legal: (ctx) => {
      const to = ctx.args.to;
      if (!root.world.byName(to)) return "unknown destination city: " + to;
      const target = ctx.player && ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      if (!target) return "no player at index " + ctx.args.pawnIndex;
      if (to === target.location) return "already in " + to;
      const card = root.findCardInHand(ctx.player, to);
      if (!card || card.kind !== "city") return "you do not hold the " + to + " city card";
      return null;
    },
    apply: (ctx) => {
      const target = ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      const from = target.location;
      const card = root.findCardInHand(ctx.player, ctx.args.to);
      root.removeCardFromHand(ctx.player, card);
      ctx.gs.playerDiscard.push(card);
      target.location = ctx.args.to;
      return { ok: true, from: from, to: target.location, discarded: card.id };
    }
  });
  a.register({
    id: "charter-flight",
    legal: (ctx) => {
      const to = ctx.args.to;
      if (!root.world.byName(to)) return "unknown destination city: " + to;
      const target = ctx.player && ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      if (!target) return "no player at index " + ctx.args.pawnIndex;
      const from = target.location;
      if (to === from) return "already in " + to;
      const card = root.findCardInHand(ctx.player, from);
      if (!card || card.kind !== "city") return "you do not hold the " + from + " city card";
      return null;
    },
    apply: (ctx) => {
      const target = ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      const from = target.location;
      const card = root.findCardInHand(ctx.player, from);
      root.removeCardFromHand(ctx.player, card);
      ctx.gs.playerDiscard.push(card);
      target.location = ctx.args.to;
      return { ok: true, from: from, to: target.location, discarded: card.id };
    }
  });
  a.register({
    id: "shuttle-flight",
    legal: (ctx) => {
      const to = ctx.args.to;
      if (!root.world.byName(to)) return "unknown destination city: " + to;
      const target = ctx.player && ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      if (!target) return "no player at index " + ctx.args.pawnIndex;
      const from = target.location;
      if (to === from) return "already in " + to;
      if (!ctx.gs.board.hasStation(from)) return "no research station in " + from;
      if (!ctx.gs.board.hasStation(to)) return "no research station in " + to;
      return null;
    },
    apply: (ctx) => {
      const target = ctx.player.role === "dispatcher" && ctx.args.pawnIndex !== undefined ? ctx.gs.game.players[ctx.args.pawnIndex] : ctx.player;
      const from = target.location;
      target.location = ctx.args.to;
      return { ok: true, from: from, to: target.location };
    }
  });
  a.register({
    id: "treat-disease",
    legal: (ctx) => {
      const color = ctx.args.color;
      if (!["blue", "yellow", "black", "red"].includes(color)) return "unknown disease color: " + color;
      if (root.board.cubeCount(ctx.player.location, color) < 1) return "no " + color + " cubes in " + ctx.player.location;
      return null;
    },
    apply: (ctx) => {
      const color = ctx.args.color;
      const city = ctx.player.location;
      const cured = root.diseases.isCured(color);
      const medic = ctx.player.role === "medic";
      let removed = 0;
      if (cured || medic) {
        while (root.board.cubeCount(city, color) > 0) {
          root.board.removeCube(city, color);
          root.diseases.treatCube(color);
          removed++;
        }
        if (root.board.diseaseCubeCounts()[color] === 0) root.diseases.setEradicated(color, true);
      } else {
        root.board.removeCube(city, color);
        root.diseases.treatCube(color);
        removed = 1;
      }
      return { ok: true, color: color, city: city, removed: removed, cured: cured, eradicated: root.diseases.isEradicated(color) };
    }
  });
  a.register({
    id: "build-station",
    legal: (ctx) => {
      const city = ctx.player.location;
      if (ctx.gs.board.hasStation(city)) return "there is already a research station in " + city;
      const opex = ctx.player.role === "operations-expert";
      if (!opex) {
        const card = root.findCardInHand(ctx.player, city);
        if (!card || card.kind !== "city") return "you do not hold the " + city + " city card";
      }
      if (ctx.gs.board.stationCount() >= 6) {
        const fromCity = ctx.args.fromCity;
        if (!fromCity) return "all 6 research stations are in use — specify args.fromCity (a city with a station) to move one";
        if (!root.world.byName(fromCity)) return "unknown city: " + fromCity;
        if (!ctx.gs.board.hasStation(fromCity)) return "no research station in " + fromCity + " to move";
        if (fromCity === city) return "cannot move the station onto itself";
      }
      return null;
    },
    apply: (ctx) => {
      const city = ctx.player.location;
      const opex = ctx.player.role === "operations-expert";
      let card = null;
      if (!opex) {
        card = root.findCardInHand(ctx.player, city);
        root.removeCardFromHand(ctx.player, card);
        ctx.gs.playerDiscard.push(card);
      }
      const movedFrom = ctx.gs.board.stationCount() >= 6 ? ctx.args.fromCity : null;
      if (movedFrom) ctx.gs.board.removeStation(movedFrom);
      ctx.gs.board.placeStation(city);
      return { ok: true, city: city, movedFrom: movedFrom, stationCount: ctx.gs.board.stationCount(), discarded: card ? card.id : null };
    }
  });
  a.register({
    id: "operations-expert-flight",
    legal: (ctx) => {
      if (ctx.player.role !== "operations-expert") return "only the Operations Expert can use the special flight";
      if (ctx.player.opexFlightUsed) return "the Operations Expert's special flight can only be used once per turn";
      const to = ctx.args.to;
      if (!root.world.byName(to)) return "unknown destination city: " + to;
      if (to === ctx.player.location) return "already in " + to;
      if (!ctx.gs.board.hasStation(ctx.player.location)) return "no research station in " + ctx.player.location;
      if (!ctx.args.cardId) return "you must discard a city card to use the special flight";
      const card = root.findCardInHand(ctx.player, ctx.args.cardId);
      if (!card || card.kind !== "city") return "you do not hold the " + ctx.args.cardId + " city card";
      return null;
    },
    apply: (ctx) => {
      const from = ctx.player.location;
      const card = root.findCardInHand(ctx.player, ctx.args.cardId);
      root.removeCardFromHand(ctx.player, card);
      ctx.gs.playerDiscard.push(card);
      ctx.player.location = ctx.args.to;
      ctx.player.opexFlightUsed = true;
      return { ok: true, from: from, to: ctx.player.location, discarded: card.id };
    }
  });
  a.register({
    id: "dispatcher-relocate",
    legal: (ctx) => {
      if (ctx.player.role !== "dispatcher") return "only the Dispatcher can use the relocation action";
      if (ctx.player.dispatcherRelocateUsed) return "the Dispatcher's relocation can only be used once per turn";
      const pawn = ctx.gs.game.players[ctx.args.pawnIndex];
      if (!pawn) return "no player at index " + ctx.args.pawnIndex;
      const to = ctx.args.to;
      if (!root.world.byName(to)) return "unknown destination city: " + to;
      if (to === pawn.location) return pawn.name + " is already in " + to;
      let present = false;
      for (const p of ctx.gs.game.players) {
        if (p !== pawn && p.location === to) { present = true; break; }
      }
      if (!present) return "no other pawn is in " + to;
      return null;
    },
    apply: (ctx) => {
      const pawn = ctx.gs.game.players[ctx.args.pawnIndex];
      const from = pawn.location;
      pawn.location = ctx.args.to;
      ctx.player.dispatcherRelocateUsed = true;
      return { ok: true, pawn: pawn.name, pawnIndex: ctx.args.pawnIndex, from: from, to: pawn.location };
    }
  });
  a.register({
    id: "share-knowledge",
    legal: (ctx) => {
      const target = ctx.gs.game.players[ctx.args.playerIndex];
      if (!target) return "no player at index " + ctx.args.playerIndex;
      if (ctx.args.playerIndex === ctx.playerIndex) return "you cannot share knowledge with yourself";
      if (target.location !== ctx.player.location) return target.name + " is not in " + ctx.player.location;
      const direction = ctx.args.direction === "take" ? "take" : "give";
      const cardId = ctx.args.cardId || ctx.player.location;
      const card = direction === "give" ? root.findCardInHand(ctx.player, cardId) : root.findCardInHand(target, cardId);
      if (!card || card.kind !== "city") {
        return direction === "give" ? "you do not hold the " + cardId + " city card" : target.name + " does not hold the " + cardId + " city card";
      }
      if (direction === "give" && ctx.player.role !== "researcher" && cardId !== ctx.player.location) return "only the Researcher may give a card that is not the card of your current city";
      if (direction === "take" && target.role !== "researcher" && cardId !== ctx.player.location) return "a non-Researcher's cards may only be taken when they match the shared city";
      return null;
    },
    apply: (ctx) => {
      const target = ctx.gs.game.players[ctx.args.playerIndex];
      const cardId = ctx.args.cardId || ctx.player.location;
      const direction = ctx.args.direction === "take" ? "take" : "give";
      let card;
      if (direction === "give") {
        card = root.findCardInHand(ctx.player, cardId);
        root.removeCardFromHand(ctx.player, card);
        target.hand.push(card);
      } else {
        card = root.findCardInHand(target, cardId);
        root.removeCardFromHand(target, card);
        ctx.player.hand.push(card);
      }
      return { ok: true, direction: direction, card: card.id, from: direction === "give" ? ctx.player.name : target.name, to: direction === "give" ? target.name : ctx.player.name };
    }
  });
  a.register({
    id: "discover-cure",
    legal: (ctx) => {
      const color = ctx.args.color;
      if (!["blue", "yellow", "black", "red"].includes(color)) return "unknown disease color: " + color;
      if (!ctx.gs.board.hasStation(ctx.player.location)) return "no research station in " + ctx.player.location;
      if (ctx.gs.diseases.isCured(color)) return color + " is already cured";
      const need = ctx.player.role === "scientist" ? 4 : 5;
      let count = 0;
      for (const c of ctx.player.hand) if (c.kind === "city" && c.color === color) count++;
      if (count < need) return "you need at least " + need + " " + color + " city cards to discover a cure (you have " + count + ")";
      return null;
    },
    apply: (ctx) => {
      const color = ctx.args.color;
      const need = ctx.player.role === "scientist" ? 4 : 5;
      const hand = ctx.player.hand;
      const discarded = [];
      let i = 0;
      while (discarded.length < need && i < hand.length) {
        if (hand[i].kind === "city" && hand[i].color === color) {
          const card = hand.splice(i, 1)[0];
          ctx.gs.playerDiscard.push(card);
          discarded.push(card);
        } else {
          i++;
        }
      }
      ctx.gs.diseases.setCured(color, true);
      return { ok: true, color: color, discarded: discarded.length };
    }
  });
  a.register({
    id: "contingency-planner-collect",
    legal: (ctx) => {
      if (ctx.player.role !== "contingency-planner") return "only the Contingency Planner can store an event card on her role card";
      if (ctx.player.contingencyEvent) return "the Contingency Planner already has " + ctx.player.contingencyEvent.id + " stored — play it first";
      const cardId = ctx.args.cardId;
      if (!cardId) return "you must choose an event card from the Player Discard Pile";
      let found = false;
      for (const c of ctx.gs.playerDiscard.cards) {
        if (c.id === cardId && c.kind === "event") { found = true; break; }
      }
      if (!found) return "no event card '" + cardId + "' is in the Player Discard Pile";
      return null;
    },
    apply: (ctx) => {
      let card = null;
      for (const c of ctx.gs.playerDiscard.cards) {
        if (c.id === ctx.args.cardId && c.kind === "event") { card = c; break; }
      }
      const i = ctx.gs.playerDiscard.cards.indexOf(card);
      ctx.gs.playerDiscard.cards.splice(i, 1);
      ctx.player.contingencyEvent = card;
      return { ok: true, stored: card.id };
    }
  });
  return { installed: ["drive", "direct-flight", "charter-flight", "shuttle-flight", "treat-disease", "build-station", "share-knowledge", "discover-cure", "operations-expert-flight", "dispatcher-relocate", "contingency-planner-collect"] };

// ─────────────────────────────────────────────
//  EVENT CARDS (tasks 33–35; 36–37 extend it) + the Contingency
//  Planner's stored-event lifecycle (task 32).
//  playEvent({playerIndex, cardId, args}) resolves an event card the
//  caller holds (or, for the Contingency Planner, the single card
//  stored on her role card) and applies its effect immediately:
//   - Airlift          (args {pawnIndex, to}): move any pawn to any city.
//   - Government Grant (args {to, fromCity?}): place a research station
//     in any city without a card; when all 6 stations are in play an
//     existing one is moved instead (args.fromCity), like Build Station.
//   - One Quiet Night  (no args): skips the next infection phase
//     (including this turn's), consumed by completeTurn.
//   - Resilient Population (args {discardCardId}): permanently remove
//     any card from the infection discard pile.
//   - Forecast (args {order}): reveal the top 6 infection cards and
//     replace them on top in any chosen order (top first).
//  Events are free (no action cost) and playable on ANY turn — a live,
//  unresolved game is all that's required (rulebook: "at any time except
//  between drawing and resolving a card", which the engine resolves
//  atomically). Hand-held events are discarded to the Player Discard Pile
//  after use (task 38); a stored Contingency Planner event is instead
//  REMOVED from the game, per task 32.
// ─────────────────────────────────────────────
playEvent(opts) =>
  const gs = root.__initGameState();
  if (!gs.game) return { ok: false, error: "no game" };
  if (gs.game.result) return { ok: false, error: "the game has already ended" };
  const o = opts || {};
  const idx = o.playerIndex === undefined ? gs.game.currentPlayerIndex : o.playerIndex;
  const player = gs.game.players[idx];
  if (!player) return { ok: false, error: "no player at index " + idx };
  const cardId = o.cardId;
  if (!cardId) return { ok: false, error: "no cardId supplied" };
  let card = root.findCardInHand(player, cardId);
  let stored = false;
  if (!card && player.role === "contingency-planner" && player.contingencyEvent && player.contingencyEvent.id === cardId) {
    card = player.contingencyEvent;
    stored = true;
  }
  if (!card) return { ok: false, error: player.name + " does not hold the " + cardId + " event card" };
  if (card.kind !== "event") return { ok: false, error: cardId + " is not an event card" };
  const args = o.args || {};
  const resolveAirlift = (state, a) => {
    const to = a.to;
    if (!root.world.byName(to)) return { ok: false, error: "unknown destination city: " + to };
    const pawn = state.game.players[a.pawnIndex];
    if (!pawn) return { ok: false, error: "no player at index " + a.pawnIndex };
    if (to === pawn.location) return { ok: false, error: pawn.name + " is already in " + to };
    const from = pawn.location;
    pawn.location = to;
    root.medicAutoClear();
    return { ok: true, pawn: pawn.name, pawnIndex: a.pawnIndex, from: from, to: to };
  };
  const resolveGovernmentGrant = (state, a) => {
    const to = a.to;
    if (!root.world.byName(to)) return { ok: false, error: "unknown city: " + to };
    if (state.board.hasStation(to)) return { ok: false, error: "there is already a research station in " + to };
    let movedFrom = null;
    if (state.board.stationCount() >= 6) {
      const fromCity = a.fromCity;
      if (!fromCity) return { ok: false, error: "all 6 research stations are in use — specify args.fromCity (a city with a station) to move one" };
      if (!root.world.byName(fromCity)) return { ok: false, error: "unknown city: " + fromCity };
      if (!state.board.hasStation(fromCity)) return { ok: false, error: "no research station in " + fromCity + " to move" };
      if (fromCity === to) return { ok: false, error: "cannot move the station onto itself" };
      state.board.removeStation(fromCity);
      movedFrom = fromCity;
    }
    state.board.placeStation(to);
    return { ok: true, city: to, movedFrom: movedFrom, stationCount: state.board.stationCount() };
  };
  const resolveOneQuietNight = (state) => {
    if (state.game.oneQuietNight) return { ok: false, error: "One Quiet Night is already in effect" };
    state.game.oneQuietNight = true;
    return { ok: true, oneQuietNight: true };
  };
  const resolveResilientPopulation = (state, a) => {
    const targetId = a.discardCardId;
    if (!targetId) return { ok: false, error: "you must choose an infection discard card to remove (args.discardCardId)" };
    let found = -1;
    for (let i = 0; i < state.infectionDiscard.cards.length; i++) {
      if (state.infectionDiscard.cards[i].id === targetId) { found = i; break; }
    }
    if (found === -1) return { ok: false, error: "no infection discard card '" + targetId + "' is in the infection discard pile" };
    const removed = state.infectionDiscard.cards[found];
    state.infectionDiscard.cards.splice(found, 1);
    return { ok: true, removed: removed.id, remaining: state.infectionDiscard.cards.length };
  };
  const resolveForecast = (state, a) => {
    const deck = state.infectionDeck;
    if (!deck) return { ok: false, error: "no infection deck" };
    const drawn = deck.draw(6);
    if (drawn.length === 0) return { ok: false, error: "infection deck is empty" };
    const restore = () => { for (let i = drawn.length - 1; i >= 0; i--) deck.push(drawn[i]); };
    const order = a.order;
    if (!order || order.length !== drawn.length) { restore(); return { ok: false, error: "args.order must list exactly the " + drawn.length + " drawn card ids, top first" }; }
    for (let i = 0; i < order.length; i++) {
      let found = false;
      for (const c of drawn) if (c.id === order[i]) { found = true; break; }
      if (!found) { restore(); return { ok: false, error: "args.order contains unknown id '" + order[i] + "' (drawn: " + drawn.map(x => x.id).join(",") + ")" }; }
      for (let j = 0; j < i; j++) if (order[i] === order[j]) { restore(); return { ok: false, error: "args.order repeats '" + order[i] + "'" }; }
    }
    for (let i = order.length - 1; i >= 0; i--) {
      let c = null;
      for (const d of drawn) if (d.id === order[i]) { c = d; break; }
      deck.push(c);
    }
    return { ok: true, drawn: drawn.map(x => x.id), top: order[0], bottom: order[order.length - 1] };
  };
  let result;
  if (card.id === "Airlift") {
    result = resolveAirlift(gs, args);
  } else if (card.id === "Government Grant") {
    result = resolveGovernmentGrant(gs, args);
  } else if (card.id === "One Quiet Night") {
    result = resolveOneQuietNight(gs);
  } else if (card.id === "Resilient Population") {
    result = resolveResilientPopulation(gs, args);
  } else if (card.id === "Forecast") {
    result = resolveForecast(gs, args);
  } else {
    return { ok: false, error: "event '" + card.id + "' is not implemented yet" };
  }
  if (!result || result.ok === false) return { ok: false, error: result && result.error, result: result };
  if (stored) {
    player.contingencyEvent = null;
    result.removedFromGame = card.id;
  } else {
    root.removeCardFromHand(player, card);
    gs.playerDiscard.push(card);
    result.discarded = card.id;
  }
  root.logEvent(player, "event", { event: card.id, stored: stored, result: result });
  return { ok: true, event: card.id, player: idx, playerName: player.name, stored: stored, result: result };

// ─────────────────────────────────────────────
//  GAME STATE — the ONE mutable instance of every model.
//  Perchance re-evaluates a pjs leaf on every root access, so a
//  leaf's value can never hold state across calls. This window-level
//  singleton (created once, cached forever) is what everything
//  mutates; the leaves below simply point at it for convenient reads.
//  Access mutating methods through root.gameState.* (or root.diseases/
//  board/players — they alias the same objects). Never rebuild state
//  by hand; call root.buildX() only for throwaway test instances.
// ─────────────────────────────────────────────
__initGameState() =>
  if (window.__OP_GAME_STATE__) return window.__OP_GAME_STATE__;
  const gs = {};
  gs.diseases = root.buildDiseases();
  gs.board = root.buildBoard();
  gs.players = root.buildPlayers();
  gs.playerDeck = null;
  gs.playerDiscard = null;
  gs.infectionDeck = null;
  gs.infectionDiscard = null;
  gs.game = null;
  gs.setup = null;
  gs.actions = root.buildActionFramework();
  root.installActions(gs.actions);
  window.__OP_GAME_STATE__ = gs;
  return gs;
gameState = [root.__initGameState()]
diseases = [root.__initGameState().diseases]
board = [root.__initGameState().board]
players = [root.__initGameState().players]

// ─────────────────────────────────────────────────────────────
//  DECK FACTORY — the shared stack primitive for player and
//  infection decks. A deck is a plain array (index 0 = bottom,
//  end of array = top) behind a closure of methods:
//  - draw(n) / drawBottom(n): remove+return n cards from top/bottom,
//    returned in draw order (topmost/bottommost card first); returns
//    fewer when depleted — callers check size().
//  - push(card|cards): add to top.  pop(): remove+return top.
//  - top() / bottom(): peek.  size() / isEmpty().  clone(): copy.
//  - shuffle(seed?): Fisher-Yates via mulberry32(seed); without a
//    seed it uses Math.random. makeDeck(cards, seed) auto-shuffles
//    once at construction when a seed is given, so identical seeds
//    reproduce identical deck order AND draw sequences.
//  Task 5 (roadmap): deck primitive + seeded PRNG.
// ─────────────────────────────────────────────────────────────
buildDeck() =>
  const mulberry32 = (seed) => {
    let a = seed >>> 0;
    return function() {
      a |= 0;
      a = (a + 0x6D2B79F5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  };
  const makeDeck = (cards, seed) => {
    const arr = (cards || []).slice();
    const rng = typeof seed === "number" ? mulberry32(seed) : Math.random;
    const deck = {
      cards: arr,
      size: () => arr.length,
      isEmpty: () => arr.length === 0,
      top: () => arr[arr.length - 1],
      bottom: () => arr[0],
      pop: () => arr.pop(),
      draw: (n) => {
        const start = Math.max(0, arr.length - n);
        return arr.splice(start, n).reverse();
      },
      drawBottom: (n) => arr.splice(0, n),
      push: (cardsIn) => {
        if (Array.isArray(cardsIn)) { for (const c of cardsIn) arr.push(c); } else { arr.push(cardsIn); }
        return arr.length;
      },
      shuffle: (s) => {
        const r = typeof s === "number" ? mulberry32(s) : rng;
        for (let i = arr.length - 1; i > 0; i--) {
          const j = Math.floor(r() * (i + 1));
          const tmp = arr[i];
          arr[i] = arr[j];
          arr[j] = tmp;
        }
        return arr.length;
      },
      clone: () => arr.slice()
    };
    if (typeof seed === "number") deck.shuffle();
    return deck;
  };
  const selfTest = () => {
    const results = [];
    const check = (name, pass, detail) => results.push({ name, pass, detail });
    const cards = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j"];
    const d = makeDeck(cards);
    check("construct.keeps-order", d.top() === "j" && d.bottom() === "a" && d.size() === 10);
    check("pop.removes-top", d.pop() === "j" && d.size() === 9 && d.top() === "i");
    check("draw.removes-from-top", (() => { const got = d.draw(3); return got.join(",") === "i,h,g" && d.size() === 6 && d.top() === "f"; })());
    check("drawBottom.removes-from-bottom", (() => { const got = d.drawBottom(2); return got.join(",") === "a,b" && d.size() === 4 && d.bottom() === "c"; })());
    check("push.adds-to-top", (() => { d.push(["x", "y"]); return d.top() === "y" && d.bottom() === "c" && d.size() === 6; })());
    check("draw-beyond-size-returns-available", (() => { const got = d.draw(50); return got.length === 6 && d.size() === 0 && d.isEmpty() === true; })());
    check("shuffle.seeded-deterministic", (() => {
      const d1 = makeDeck(cards, 42);
      const d2 = makeDeck(cards, 42);
      const d3 = makeDeck(cards, 43);
      const s1 = d1.clone().join(",");
      const s2 = d2.clone().join(",");
      const s3 = d3.clone().join(",");
      return s1 === s2 && s1 !== s3 && d1.size() === 10 && d2.size() === 10;
    })());
    check("reproducible-draw-sequence", (() => {
      const A = makeDeck(cards, 99);
      const B = makeDeck(cards, 99);
      return A.draw(5).join(",") === B.draw(5).join(",") && A.size() === B.size() && A.top() === B.top();
    })());
    check("unseeded-shuffle-changes-order", (() => {
      const big = [];
      for (let i = 0; i < 40; i++) big.push("c" + i);
      const d1 = makeDeck(big);
      d1.shuffle();
      return d1.clone().join(",") !== big.join(",") && d1.size() === 40;
    })());
    check("mulberry32-yields-0to1", (() => { const r = mulberry32(7); for (let i = 0; i < 50; i++) { const v = r(); if (!(v >= 0 && v < 1)) return false; } return true; })());
    return { pass: results.every(r => r.pass), results };
  };
  return { makeDeck: makeDeck, mulberry32: mulberry32, selfTest: selfTest };
deckFactory = [root.buildDeck()]

// ─────────────────────────────────────────────
//  PLAYER DECK — setup of the player draw pile.
//  buildPlayerDeck(epidemicCount, seed) builds the 53-card base
//  deck (48 city cards — one per city, colored by city: 13 blue /
//  12 yellow / 11 black / 12 red — plus the 5 event cards),
//  shuffles it once with `seed`, splits it into `epidemicCount`
//  piles as equal as possible (larger first), shuffles 1 epidemic
//  card into each pile, then stacks the piles with the SMALLER ones
//  on the bottom (official rulebook procedure) so exactly one
//  epidemic sits in each deck segment. Returns {deck, discard,
//  layout:{pileSizes, numEpidemics, total}}. Identical seeds →
//  identical decks. setupPlayerDeck stores the result on the game
//  state singleton (root.gameState.playerDeck / .playerDiscard).
//  Task 6 (roadmap): player deck construction.
//  Optional 3rd arg baseCards: build the deck from that exact card
//  array instead of the full 53-card base (used by setupGame to feed
//  in the cards left over after starting hands are dealt).
// ─────────────────────────────────────────────
buildPlayerDeck(epidemicCount, seed, baseCards) =>
  const n = epidemicCount === undefined ? 5 : epidemicCount;
  if (![4, 5, 6].includes(n)) return { error: "epidemicCount must be 4, 5, or 6, got " + n };
  const EVENT_IDS = ["Airlift", "Government Grant", "One Quiet Night", "Resilient Population", "Forecast"];
  const base = Array.isArray(baseCards) ? baseCards.slice() : (() => {
    const b = [];
    for (const c of root.world.cities) b.push({ id: c.name, kind: "city", color: c.color });
    for (const e of EVENT_IDS) b.push({ id: e, kind: "event", color: null });
    return b;
  })();
  const shuffled = root.deckFactory.makeDeck(base, seed);
  const pileSizes = [];
  let rem = shuffled.size();
  for (let i = n; i >= 1; i--) {
    const ps = Math.ceil(rem / i);
    pileSizes.push(ps);
    rem -= ps;
  }
  const piles = [];
  let acc = 0;
  for (let i = 0; i < n; i++) {
    const pileCards = shuffled.cards.slice(acc, acc + pileSizes[i]);
    acc += pileSizes[i];
    const pileDeck = root.deckFactory.makeDeck(pileCards);
    pileDeck.push({ id: "Epidemic", kind: "epidemic", color: null });
    pileDeck.shuffle(seed + 1000 + i);
    piles.push(pileDeck);
  }
  const finalCards = [];
  for (let i = n - 1; i >= 0; i--) finalCards.push(...piles[i].cards);
  const finalPileSizes = pileSizes.map(ps => ps + 1);
  return {
    deck: root.deckFactory.makeDeck(finalCards),
    discard: root.deckFactory.makeDeck([]),
    layout: { pileSizes: finalPileSizes, numEpidemics: n, total: finalCards.length }
  };

setupPlayerDeck(epidemicCount, seed) =>
  const built = root.buildPlayerDeck(epidemicCount, seed);
  if (built.error) return built;
  const gs = root.__initGameState();
  gs.playerDeck = built.deck;
  gs.playerDiscard = built.discard;
  return built;

playerDeckSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const cityColorCounts = {};
  for (const c of root.world.cities) cityColorCounts[c.color] = (cityColorCounts[c.color] || 0) + 1;
  for (const n of [4, 5, 6]) {
    const built = root.buildPlayerDeck(n, 1234);
    const cards = built.deck.cards;
    const kinds = {};
    for (const c of cards) kinds[c.kind] = (kinds[c.kind] || 0) + 1;
    check("size-" + n, built.deck.size() === 53 + n, "got " + built.deck.size());
    check("epidemics-" + n, kinds.epidemic === n, "got " + kinds.epidemic);
    check("events-5", kinds.event === 5);
    check("cities-48", kinds.city === 48);
    const byColor = {};
    for (const c of cards) if (c.kind === "city") byColor[c.color] = (byColor[c.color] || 0) + 1;
    check("city-colors-" + n, byColor.blue === cityColorCounts.blue && byColor.yellow === cityColorCounts.yellow && byColor.black === cityColorCounts.black && byColor.red === cityColorCounts.red, JSON.stringify(byColor));
    const positions = [];
    cards.forEach((c, i) => { if (c.kind === "epidemic") positions.push(i); });
    const topPoses = positions.map(i => cards.length - 1 - i).sort((a, b) => a - b);
    let accB = 0;
    const bounds = built.layout.pileSizes.map(ps => (accB += ps));
    const segmentsOk = topPoses.length === n && topPoses.every((pos, idx) => {
      const lo = idx === 0 ? 0 : bounds[idx - 1];
      return pos >= lo && pos < bounds[idx];
    });
    check("one-epidemic-per-segment-" + n, segmentsOk, JSON.stringify(topPoses) + " bounds " + JSON.stringify(bounds));
    const ps = built.layout.pileSizes;
    let desc = ps.length === n;
    for (let i = 1; i < ps.length; i++) if (ps[i] > ps[i - 1]) desc = false;
    check("pileSizes-valid-" + n, desc && ps.reduce((a, b) => a + b, 0) === 53 + n, JSON.stringify(ps));
  }
  const a = root.buildPlayerDeck(5, 4242);
  const b = root.buildPlayerDeck(5, 4242);
  const c = root.buildPlayerDeck(5, 9999);
  check("reproducible-same-seed", a.deck.cards.map(x => x.id).join("|") === b.deck.cards.map(x => x.id).join("|"));
  check("different-seed-differs", a.deck.cards.map(x => x.id).join("|") !== c.deck.cards.map(x => x.id).join("|"));
  check("city-ids-unique", (() => { const ids = a.deck.cards.filter(x => x.kind === "city").map(x => x.id); return new Set(ids).size === 48; })());
  check("invalid-epidemic-count-rejected", !!root.buildPlayerDeck(3, 1).error);
  return { pass: results.every(r => r.pass), results };

// ─────────────────────────────────────────────
//  INFECTION DECK + INFECT PRIMITIVE.
//  buildInfectionDeck(seed): 48 infection cards, one per city
//  (color distribution 13 blue / 12 yellow / 11 black / 12 red),
//  seeded-shuffled. setupInfectionDeck stores it on the singleton
//  (root.gameState.infectionDeck / .infectionDiscard).
//  infect(card, n): the atomic infection step — places n cubes of
//  the card's color on the card's city, consuming supply, stopping
//  when the disease is eradicated (no cubes). Infecting a full city
//  (3 cubes) TRIGGERS the outbreak path (task 21): resolveOutbreak
//  spreads one cube to every linked city, chaining depth-first
//  through any that are also full (visited-set, at most once per
//  event), and flags the Phase-4 loss conditions (8 outbreaks / cube
//  supply exhausted) on gs.game.result for the turn flow to act on.
//  Task 7 (roadmap): infection deck + infect(card, n).
// ─────────────────────────────────────────────
buildInfectionDeck(seed) =>
  const base = [];
  for (const c of root.world.cities) base.push({ id: c.name, kind: "infection", color: c.color });
  const deck = root.deckFactory.makeDeck(base, seed);
  return { deck: deck, discard: root.deckFactory.makeDeck([]) };

setupInfectionDeck(seed) =>
  const built = root.buildInfectionDeck(seed);
  const gs = root.__initGameState();
  gs.infectionDeck = built.deck;
  gs.infectionDiscard = built.discard;
  return built;

infect(card, n) =>
  if (!card || card.kind !== "infection") return { ok: false, error: "not an infection card" };
  const city = card.id;
  const color = card.color;
  if (!root.world.byName(city)) return { ok: false, error: "unknown city: " + city };
  const res = { ok: true, city: city, color: color, cubesPlaced: 0, attempts: 0, full: false, eradicated: false, prevented: false, quarantined: false, supplyExhausted: false, outbreak: null };
  if (root.diseases.isEradicated(color)) { res.eradicated = true; return res; }
  const limit = Math.max(0, n || 0);
  for (let i = 0; i < limit; i++) {
    res.attempts++;
    if (root.diseases.isCured(color) && root.medicAtCity(city)) { res.prevented = true; break; }
    if (root.quarantineAtCity(city)) { res.quarantined = true; break; }
    if (root.board.cubeCount(city, color) >= 3) {
      res.full = true;
      res.outbreak = root.resolveOutbreak(city, color);
      break;
    }
    const supply = root.diseases.addCube(color);
    if (!supply.ok) {
      res.supplyExhausted = true;
      const gs = root.__initGameState();
      if (gs.game) root.setDefeat("disease cube supply exhausted");
      break;
    }
    root.board.placeCube(city, color);
    res.cubesPlaced++;
  }
  return res;

//  Task 21 (roadmap): single-city infection + the outbreak path.
//  placeCubeOn: one cube on a city (cap 3, eradicated immunity,
//  supply check). resolveOutbreak: the chain — increment the outbreak
//  counter, then spread 1 cube to every linked city; a linked city at
//  3 cubes chains (depth-first, each city at most once per event via
//  the visited set). Sets gs.game.result on 8 outbreaks or cube-supply
//  exhaustion, so the turn flow can stop the game.
placeCubeOn(city, color) =>
  const res = { placed: false, full: false, supplyExhausted: false, eradicated: false, prevented: false, quarantined: false };
  if (root.diseases.isEradicated(color)) { res.eradicated = true; return res; }
  if (root.diseases.isCured(color) && root.medicAtCity(city)) { res.prevented = true; return res; }
  if (root.quarantineAtCity(city)) { res.quarantined = true; return res; }
  if (root.board.cubeCount(city, color) >= 3) { res.full = true; return res; }
  const supply = root.diseases.addCube(color);
  if (!supply.ok) { res.supplyExhausted = true; return res; }
  root.board.placeCube(city, color);
  res.placed = true;
  return res;

resolveOutbreak(city, color) =>
  const gs = root.__initGameState();
  const events = [];
  const visited = [city];
  const queue = [city];
  while (queue.length > 0) {
    if (gs.game && gs.game.result) break;
    const c = queue.shift();
    gs.board.incrementOutbreaks();
    const count = gs.board.getOutbreaks();
    events.push({ city: c, color: color, outbreakCount: count });
    if (count >= 8) {
      root.setDefeat("8 outbreaks");
      break;
    }
    for (const link of root.world.byName(c).links) {
      const r = root.placeCubeOn(link, color);
      if (r.supplyExhausted) {
        root.setDefeat("disease cube supply exhausted");
        break;
      }
      if (r.full && !visited.includes(link)) { visited.push(link); queue.push(link); }
    }
  }
  if (gs.game) root.logEvent(null, "outbreak", { color: color, triggeredBy: city, outbreaks: events.length, total: gs.board.getOutbreaks() });
  return { ok: true, color: color, triggeredBy: city, events: events };

// drawInfection(rate, decks?): the infection phase step. Draws up to
// `rate` cards from the top of the infection deck, infects each drawn
// card exactly once (1 cube via root.infect), then appends each card
// to the infection discard. If the deck empties mid-draw, the drawn
// cards still resolve normally (depleted=true). Defaults to the game
// state's infectionDeck/infectionDiscard; pass {deck, discard} to test
// against throwaway decks.
drawInfection(rate, decks) =>
  const d = decks || root.__initGameState();
  const deck = d.deck || d.infectionDeck;
  const discard = d.discard || d.infectionDiscard;
  if (!deck) return { error: "no infection deck" };
  const n = Math.max(0, Math.floor(Number(rate)) || 0);
  const drawn = deck.draw(n);
  const results = [];
  for (const card of drawn) {
    const r = root.infect(card, 1);
    if (discard) discard.push(card);
    results.push({ cardId: card.id, color: card.color, infect: r });
  }
  if (!decks && d.game) {
    root.logEvent(null, "infection", { requested: n, drawn: drawn.length, results: results.map(x => ({ card: x.cardId, cubes: x.infect.cubesPlaced, full: !!x.infect.full, outbreak: x.infect.outbreak ? x.infect.outbreak.events.length : 0 })) });
  }
  return { requested: n, drawn: drawn.length, depleted: drawn.length < n, results: results };

// ─────────────────────────────────────────────
//  TURN SEQUENCING (tasks 19–21).
//  resolveEpidemic(): the 3-step Epidemic interrupt — raise the
//  infection rate, draw the BOTTOM infection card and infect it with
//  3 cubes (discard it), then INTENSIFY: shuffle the infection
//  discard pile back onto the TOP of the infection deck (seeded from
//  setup.seed + 50000 + epidemic# for reproducibility).
//  drawPhase(player): draw 2 player cards; fewer than 2 left at draw
//  time → loss (gs.game.result). Epidemic cards drawn are resolved as
//  interrupts and discarded (no replacement drawn); everything else
//  goes to the hand. Reports overLimit (hand > 7).
//  discardCards / discardToHandLimit / handOverLimit: the 7-card hand
//  cap (city AND event cards count).
//  completeTurn(): the turn finalizer — draw phase → infection phase
//  at the current rate (skipped + cleared while gs.game.oneQuietNight
//  is set, per task 35) → end the acting player's turn → advance
//  turnIndex/currentPlayerIndex → start the next player's turn. On a
//  loss (gs.game.result set by the deck check, an outbreak chain, or
//  an epidemic) the game stops without advancing. Guarded against
//  double-completion via lastCompletedPlayerIndex.
// ─────────────────────────────────────────────
resolveEpidemic() =>
  const gs = root.__initGameState();
  if (!gs.game) return { error: "no game" };
  gs.game.epidemicsResolved = (gs.game.epidemicsResolved || 0) + 1;
  const rate = gs.board.raiseInfectionRate();
  const bottom = gs.infectionDeck.drawBottom(1);
  let infectRes = null;
  if (bottom.length === 0) {
    infectRes = { error: "infection deck empty" };
  } else {
    infectRes = root.infect(bottom[0], 3);
    gs.infectionDiscard.push(bottom[0]);
  }
  const seed = (gs.setup && gs.setup.seed ? gs.setup.seed : 1) + 50000 + gs.game.epidemicsResolved;
  const shuffled = root.deckFactory.makeDeck(gs.infectionDiscard.cards, seed);
  gs.infectionDiscard.cards.length = 0;
  for (const c of shuffled.cards) gs.infectionDeck.cards.push(c);
  root.logEvent(null, "epidemic", { rate: rate, bottomCard: bottom[0] ? bottom[0].id : null, infected: infectRes && infectRes.cubesPlaced, intensified: shuffled.cards.length });
  return { ok: true, rate: rate, bottomCard: bottom[0] ? bottom[0].id : null, infect: infectRes, intensified: shuffled.cards.length };

drawPhase(player) =>
  const gs = root.__initGameState();
  if (!gs.game) return { error: "no game" };
  const p = player || gs.game.players[gs.game.currentPlayerIndex];
  const deck = gs.playerDeck;
  if (!deck) return { error: "no player deck" };
  if (deck.size() < 2) {
    root.setDefeat("fewer than 2 player cards left to draw");
    return { ok: true, lost: true, cause: gs.game.result.cause };
  }
  const cards = deck.draw(2);
  const drawn = [];
  const epidemics = [];
  for (const card of cards) {
    if (card.kind === "epidemic") {
      epidemics.push(card.id);
      gs.playerDiscard.push(card);
      root.resolveEpidemic();
    } else {
      p.hand.push(card);
      drawn.push(card);
    }
  }
  root.logEvent(p, "draw", { drawn: drawn.map(c => c.id), epidemics: epidemics, handSize: p.hand.length });
  return { ok: true, drawn: drawn.map(c => c.id), epidemics: epidemics, handSize: p.hand.length, overLimit: p.hand.length > 7 };

handOverLimit(player) =>
  return player.hand.length > 7;

discardCards(player, cardIds) =>
  const gs = root.__initGameState();
  const discarded = [];
  for (const id of cardIds || []) {
    const card = root.findCardInHand(player, id);
    if (card) {
      root.removeCardFromHand(player, card);
      gs.playerDiscard.push(card);
      discarded.push(card);
    }
  }
  return { ok: true, discarded: discarded.map(c => c.id), handSize: player.hand.length };

discardToHandLimit(player, cardIds) =>
  const r = root.discardCards(player, cardIds);
  if (r.handSize > 7) return { ok: false, error: "hand still over 7 (" + r.handSize + ") — discard more", handSize: r.handSize, discarded: r.discarded };
  return r;

// ─────────────────────────────────────────────
//  END-GAME RESOLUTION (tasks 44–45). setDefeat(cause) records a loss
//  with the exact rulebook cause (8 outbreaks / disease cube supply
//  exhausted / fewer than 2 player cards left to draw) on
//  gs.game.result — once, first cause wins, tagged with the current
//  turn index — and logs it. checkEndCondition() detects victory (all
//  four diseases cured) and writes the win summary (turns taken,
//  outbreaks suffered, infection rate, cures found, eradicated
//  diseases, stations, cubes remaining). It is invoked after every
//  applied action (discover-cure is the only path to a cure) and from
//  setDefeat/completeTurn; both helpers are idempotent — a game ends
//  the moment its result is set and never flips back.
// ─────────────────────────────────────────────
setDefeat(cause) =>
  const gs = root.__initGameState();
  if (!gs.game) return null;
  if (gs.game.result) return gs.game.result;
  gs.game.result = { outcome: "lost", cause: cause, turn: gs.game.turnIndex };
  root.logEvent(null, "defeat", { cause: cause });
  return gs.game.result;

checkEndCondition() =>
  const gs = root.__initGameState();
  if (!gs.game || gs.game.result) return gs.game ? gs.game.result : null;
  const COLORS = ["blue", "yellow", "black", "red"];
  let cured = 0;
  let eradicated = 0;
  for (const col of COLORS) {
    if (root.diseases.isCured(col)) cured++;
    if (root.diseases.isEradicated(col)) eradicated++;
  }
  if (cured < 4) return null;
  const cubes = {};
  for (const col of COLORS) cubes[col] = root.diseases[col].cubeSupply;
  const summary = {
    turns: gs.game.turnIndex,
    outbreaks: gs.board.getOutbreaks(),
    infectionRate: gs.board.getInfectionRate(),
    cures: cured,
    eradicated: eradicated,
    stations: gs.board.stationCount(),
    cubesRemaining: cubes,
    cause: "all four diseases cured"
  };
  gs.game.result = { outcome: "won", cause: summary.cause, turn: gs.game.turnIndex, summary: summary };
  root.logEvent(null, "victory", { cause: summary.cause, summary: summary });
  return gs.game.result;

completeTurn() =>
  const gs = root.__initGameState();
  if (!gs.game) return { error: "no game" };
  if (gs.game.result) return { ok: true, alreadyEnded: true, result: gs.game.result };
  const idx = gs.game.currentPlayerIndex;
  if (gs.game.lastCompletedPlayerIndex === idx) return { ok: false, error: "turn already completed" };
  const player = gs.game.players[idx];
  root.logEvent(player, "phase", { phase: "draw" });
  const draw = root.drawPhase(player);
  if (gs.game.result) {
    root.players.endTurn(player);
    return { ok: true, lost: true, cause: gs.game.result.cause, draw: draw, infection: null };
  }
  let infection = null;
  if (gs.game.oneQuietNight) {
    gs.game.oneQuietNight = false;
    root.logEvent(player, "phase", { phase: "infection", skipped: "one quiet night" });
  } else {
    root.logEvent(player, "phase", { phase: "infection" });
    infection = root.drawInfection(gs.board.getInfectionRate());
  }
  root.players.endTurn(player);
  if (gs.game.result) return { ok: true, lost: true, cause: gs.game.result.cause, draw: draw, infection: infection };
  gs.game.lastCompletedPlayerIndex = idx;
  gs.game.turnIndex++;
  gs.game.currentPlayerIndex = (idx + 1) % gs.game.players.length;
  root.players.startTurn(gs.game.players[gs.game.currentPlayerIndex]);
  root.logEvent(gs.game.players[gs.game.currentPlayerIndex], "phase", { phase: "actions" });
  return { ok: true, nextPlayer: gs.game.players[gs.game.currentPlayerIndex].name, nextIndex: gs.game.currentPlayerIndex, turnIndex: gs.game.turnIndex, draw: draw, infection: infection };

// ─────────────────────────────────────────────
//  GAME SNAPSHOTS (online co-op + save/load). The live game state
//  lives in closures and method-bearing objects, so serializeGame()
//  flattens it into plain JSON-safe data and restoreGame(snap)
//  rebuilds the singleton from that data — deck order, board cubes,
//  stations, roles, hands, turn state and the log all round-trip.
//  Used by the online room protocol (task 55) and save/load (57).
// ─────────────────────────────────────────────
serializeGame() =>
  const gs = root.__initGameState();
  if (!gs.game) return { ok: false, error: "no game" };
  const card = (c) => ({ id: c.id, kind: c.kind, color: c.color });
  const cubesOut = {};
  for (const c of root.world.cities) {
    const row = gs.board.cubes[c.name];
    cubesOut[c.name] = { blue: row.blue, yellow: row.yellow, black: row.black, red: row.red };
  }
  return {
    ok: true,
    snap: {
      v: 1,
      setup: gs.setup,
      diseases: ["blue", "yellow", "black", "red"].map(col => [col, { supply: gs.diseases[col].cubeSupply, cured: gs.diseases[col].cured, eradicated: gs.diseases[col].eradicated }]),
      board: { outbreaks: gs.board.getOutbreaks(), rate: gs.board.getInfectionRate(), ratePos: gs.board.getRatePos(), stations: gs.board.stationList(), cubes: cubesOut },
      players: gs.game.players.map(p => ({
        id: p.id, name: p.name, role: p.role, color: p.color, location: p.location,
        actions: p.actions, isBot: p.isBot, isTurn: p.isTurn, botTarget: p.botTarget || null,
        opexFlightUsed: p.opexFlightUsed, dispatcherRelocateUsed: p.dispatcherRelocateUsed,
        contingencyEvent: p.contingencyEvent ? card(p.contingencyEvent) : null,
        hand: p.hand.map(card)
      })),
      playerDeck: gs.playerDeck.cards.map(card),
      playerDiscard: gs.playerDiscard.cards.map(card),
      infectionDeck: gs.infectionDeck.cards.map(card),
      infectionDiscard: gs.infectionDiscard.cards.map(card),
      game: {
        turnIndex: gs.game.turnIndex,
        currentPlayerIndex: gs.game.currentPlayerIndex,
        oneQuietNight: gs.game.oneQuietNight,
        epidemicsResolved: gs.game.epidemicsResolved,
        lastCompletedPlayerIndex: gs.game.lastCompletedPlayerIndex,
        result: gs.game.result,
        log: gs.game.log
      }
    }
  };
restoreGame(snap) =>
  if (!snap) return { ok: false, error: "no snapshot" };
  if (snap.v !== 1) return { ok: false, error: "unsupported snapshot version " + snap.v };
  const gs = root.__initGameState();
  const diseases = root.buildDiseases();
  for (const pair of snap.diseases || []) {
    const col = pair[0];
    const d = pair[1];
    if (!diseases[col]) continue;
    diseases[col].cubeSupply = Math.max(0, Math.min(24, Number(d.supply) || 0));
    diseases[col].cured = !!d.cured;
    diseases[col].eradicated = !!d.eradicated;
  }
  const board = root.buildBoard();
  for (const c of root.world.cities) {
    const row = (snap.board.cubes || {})[c.name];
    if (row) board.cubes[c.name] = { blue: row.blue || 0, yellow: row.yellow || 0, black: row.black || 0, red: row.red || 0 };
  }
  for (const st of snap.board.stations || []) board.stations[st] = true;
  board.setOutbreaks(Number(snap.board.outbreaks) || 0);
  board.setInfectionRate(Number(snap.board.rate) || 2);
  if (snap.board.ratePos != null) board.setRatePos(snap.board.ratePos);
  const factory = root.buildPlayers();
  const roster = [];
  for (const p of snap.players || []) {
    const np = factory.createPlayer({ name: p.name, role: p.role, color: p.color, isBot: p.isBot, location: p.location });
    np.actions = Number(p.actions) || 0;
    np.isTurn = !!p.isTurn;
    np.botTarget = p.botTarget || null;
    np.opexFlightUsed = !!p.opexFlightUsed;
    np.dispatcherRelocateUsed = !!p.dispatcherRelocateUsed;
    np.contingencyEvent = p.contingencyEvent ? { id: p.contingencyEvent.id, kind: p.contingencyEvent.kind, color: p.contingencyEvent.color } : null;
    np.hand = (p.hand || []).map(c => ({ id: c.id, kind: c.kind, color: c.color }));
    roster.push(np);
  }
  const cards = (arr) => (arr || []).map(c => ({ id: c.id, kind: c.kind, color: c.color }));
  gs.diseases = diseases;
  gs.board = board;
  gs.players = factory;
  gs.playerDeck = root.deckFactory.makeDeck(cards(snap.playerDeck));
  gs.playerDiscard = root.deckFactory.makeDeck(cards(snap.playerDiscard));
  gs.infectionDeck = root.deckFactory.makeDeck(cards(snap.infectionDeck));
  gs.infectionDiscard = root.deckFactory.makeDeck(cards(snap.infectionDiscard));
  gs.setup = snap.setup || null;
  gs.game = snap.game ? {
    players: roster, turnIndex: snap.game.turnIndex, currentPlayerIndex: snap.game.currentPlayerIndex,
    log: snap.game.log || [], setup: gs.setup, oneQuietNight: !!snap.game.oneQuietNight,
    epidemicsResolved: snap.game.epidemicsResolved || 0, lastCompletedPlayerIndex: snap.game.lastCompletedPlayerIndex,
    result: snap.game.result || null
  } : null;
  return { ok: true, players: roster };

snapshotSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  root.setupGame({ numPlayers: 3, humanCount: 1, seed: 4242, difficulty: 5 });
  const gs = root.__initGameState();
  const a = root.serializeGame();
  check("serialize.ok", a.ok === true && a.snap && a.snap.v === 1);
  check("serialize.complete", a.snap.players.length === 3 && a.snap.playerDeck.length === gs.playerDeck.size() && a.snap.infectionDeck.length === gs.infectionDeck.size(), "pd " + a.snap.playerDeck.length + " id " + a.snap.infectionDeck.length);
  const r = root.restoreGame(a.snap);
  check("restore.ok", r.ok === true && r.players.length === 3);
  const b = root.serializeGame();
  check("roundtrip-equal", JSON.stringify(a.snap) === JSON.stringify(b.snap));
  const mv = gs.actions.doAction("drive", { to: "Washington" }, 0);
  check("action-applied", mv.ok === true && gs.game.players[0].location === "Washington");
  const c = root.serializeGame();
  const r2 = root.restoreGame(c.snap);
  check("restore-after-action", r2.ok === true && root.__initGameState().game.players[0].location === "Washington");
  const d = root.serializeGame();
  check("roundtrip-equal-2", JSON.stringify(c.snap) === JSON.stringify(d.snap));
  check("restore.invalid-version", root.restoreGame({ v: 99 }).ok === false);
  check("restore.null", root.restoreGame(null).ok === false);
  return { pass: results.every(x => x.pass), results };

infectionSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const built = root.buildInfectionDeck(1234);
  const cards = built.deck.cards;
  check("size-48", cards.length === 48, "got " + cards.length);
  check("all-infection-kind", cards.every(c => c.kind === "infection"));
  check("ids-unique-48", new Set(cards.map(c => c.id)).size === 48);
  const byColor = {};
  for (const c of cards) byColor[c.color] = (byColor[c.color] || 0) + 1;
  check("colors-13-12-11-12", byColor.blue === 13 && byColor.yellow === 12 && byColor.black === 11 && byColor.red === 12, JSON.stringify(byColor));
  const a = root.buildInfectionDeck(99);
  const b = root.buildInfectionDeck(99);
  const c2 = root.buildInfectionDeck(5);
  check("reproducible-same-seed", a.deck.cards.map(x => x.id).join("|") === b.deck.cards.map(x => x.id).join("|"));
  check("different-seed-differs", a.deck.cards.map(x => x.id).join("|") !== c2.deck.cards.map(x => x.id).join("|"));
  check("discard-empty", built.discard.size() === 0);
  const SUPPLY = ["blue", "yellow", "black", "red"];
  const board = root.board;
  const savedBoard = {};
  for (const city of root.world.cities) {
    savedBoard[city.name] = { blue: board.cubeCount(city.name, "blue"), yellow: board.cubeCount(city.name, "yellow"), black: board.cubeCount(city.name, "black"), red: board.cubeCount(city.name, "red") };
  }
  const savedSupply = {};
  const savedFlags = {};
  for (const col of SUPPLY) {
    savedSupply[col] = root.diseases[col].cubeSupply;
    savedFlags[col] = { cured: root.diseases.isCured(col), eradicated: root.diseases.isEradicated(col) };
  }
  const restore = () => {
    for (const city of root.world.cities) {
      for (const col of SUPPLY) {
        const diff = savedBoard[city.name][col] - board.cubeCount(city.name, col);
        for (let i = 0; i < diff; i++) board.placeCube(city.name, col);
        for (let i = 0; i < -diff; i++) board.removeCube(city.name, col);
      }
    }
    for (const col of SUPPLY) {
      root.diseases.setSupply(col, savedSupply[col]);
      root.diseases.setCured(col, savedFlags[col].cured);
      root.diseases.setEradicated(col, savedFlags[col].eradicated);
    }
  };
  const savedGame = root.__initGameState().game;
  root.__initGameState().game = null;
  for (const city of root.world.cities) {
    for (const col of SUPPLY) {
      while (board.cubeCount(city.name, col) > 0) board.removeCube(city.name, col);
    }
  }
  for (const col of SUPPLY) {
    root.diseases.setSupply(col, 24);
    root.diseases.setCured(col, false);
    root.diseases.setEradicated(col, false);
  }
  try {
    const card = { id: "Atlanta", kind: "infection", color: "blue" };
    const r1 = root.infect(card, 3);
    check("infect.places-n-cubes", r1.ok && r1.cubesPlaced === 3 && board.cubeCount("Atlanta", "blue") === 3 && r1.full === false && r1.attempts === 3);
    const r2 = root.infect(card, 1);
    check("infect.full-at-3", r2.ok && r2.full === true && r2.cubesPlaced === 0 && board.cubeCount("Atlanta", "blue") === 3);
    root.infect({ id: "Lagos", kind: "infection", color: "yellow" }, 1);
    const r3 = root.infect({ id: "Lagos", kind: "infection", color: "yellow" }, 3);
    check("infect.partial-then-full", r3.ok && r3.cubesPlaced === 2 && r3.full === true && board.cubeCount("Lagos", "yellow") === 3);
    root.diseases.setSupply("black", 2);
    const r4 = root.infect({ id: "Cairo", kind: "infection", color: "black" }, 3);
    check("infect.supply-exhaustion-flagged", r4.ok && r4.cubesPlaced === 2 && r4.supplyExhausted === true && board.cubeCount("Cairo", "black") === 2);
    root.diseases.setCured("red");
    root.diseases.setEradicated("red");
    const r5 = root.infect({ id: "Tokyo", kind: "infection", color: "red" }, 3);
    check("infect.eradicated-no-cubes", r5.ok && r5.eradicated === true && r5.cubesPlaced === 0 && r5.attempts === 0 && board.cubeCount("Tokyo", "red") === 0);
    const r6 = root.infect({ id: "Nowhere", kind: "infection", color: "blue" }, 1);
    check("infect.unknown-city-rejected", r6.ok === false);
    const r7 = root.infect(null, 1);
    check("infect.null-rejected", r7.ok === false);
  } finally {
    restore();
    root.__initGameState().game = savedGame;
  }
  check("restore-clean", (() => {
    for (const city of root.world.cities) {
      for (const col of SUPPLY) if (board.cubeCount(city.name, col) !== savedBoard[city.name][col]) return false;
    }
    for (const col of SUPPLY) {
      if (root.diseases[col].cubeSupply !== savedSupply[col]) return false;
      if (root.diseases.isCured(col) !== savedFlags[col].cured) return false;
      if (root.diseases.isEradicated(col) !== savedFlags[col].eradicated) return false;
    }
    return true;
  })());
  return { pass: results.every(r => r.pass), results };

infectionDrawSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const SUPPLY = ["blue", "yellow", "black", "red"];
  const board = root.board;
  const savedBoard = {};
  for (const city of root.world.cities) {
    savedBoard[city.name] = { blue: board.cubeCount(city.name, "blue"), yellow: board.cubeCount(city.name, "yellow"), black: board.cubeCount(city.name, "black"), red: board.cubeCount(city.name, "red") };
  }
  const savedSupply = {};
  const savedFlags = {};
  for (const col of SUPPLY) {
    savedSupply[col] = root.diseases[col].cubeSupply;
    savedFlags[col] = { cured: root.diseases.isCured(col), eradicated: root.diseases.isEradicated(col) };
  }
  const restore = () => {
    for (const city of root.world.cities) {
      for (const col of SUPPLY) {
        const diff = savedBoard[city.name][col] - board.cubeCount(city.name, col);
        for (let i = 0; i < diff; i++) board.placeCube(city.name, col);
        for (let i = 0; i < -diff; i++) board.removeCube(city.name, col);
      }
    }
    for (const col of SUPPLY) {
      root.diseases.setSupply(col, savedSupply[col]);
      root.diseases.setCured(col, savedFlags[col].cured);
      root.diseases.setEradicated(col, savedFlags[col].eradicated);
    }
  };
  const savedGame = root.__initGameState().game;
  root.__initGameState().game = null;
  for (const city of root.world.cities) {
    for (const col of SUPPLY) {
      while (board.cubeCount(city.name, col) > 0) board.removeCube(city.name, col);
    }
  }
  for (const col of SUPPLY) {
    root.diseases.setSupply(col, 24);
    root.diseases.setCured(col, false);
    root.diseases.setEradicated(col, false);
  }
  try {
    const fresh = root.buildInfectionDeck(777);
    const r = root.drawInfection(3, fresh);
    check("drawInfection.draws-rate", r.requested === 3 && r.drawn === 3 && r.depleted === false && fresh.deck.size() === 45 && fresh.discard.size() === 3, JSON.stringify({ drawn: r.drawn, deck: fresh.deck.size(), disc: fresh.discard.size() }));
    check("drawInfection.infects-once-per-card", r.results.length === 3 && r.results.every(x => x.infect.cubesPlaced === 1 && x.infect.full === false), JSON.stringify(r.results.map(x => x.cardId)));
    check("drawInfection.discard-holds-drawn-cards", r.results.map(x => x.cardId).join("|") === fresh.discard.cards.map(c => c.id).join("|"));
    const f1 = root.buildInfectionDeck(777);
    const f2 = root.buildInfectionDeck(777);
    const manual = f2.deck.draw(3).map(c => c.id);
    const rd = root.drawInfection(3, f1);
    check("drawInfection.draw-order-preserved", rd.results.map(x => x.cardId).join("|") === manual.join("|"));
    const small = root.deckFactory.makeDeck([{ id: "Milan", kind: "infection", color: "blue" }, { id: "Paris", kind: "infection", color: "blue" }]);
    const smallDiscard = root.deckFactory.makeDeck([]);
    const r2 = root.drawInfection(5, { deck: small, discard: smallDiscard });
    check("drawInfection.empty-deck-mid-draw", r2.drawn === 2 && r2.depleted === true && r2.requested === 5 && r2.results.length === 2 && small.size() === 0 && smallDiscard.size() === 2, JSON.stringify(r2));
    const f3 = root.buildInfectionDeck(1);
    const r3 = root.drawInfection(0, f3);
    check("drawInfection.rate-zero", r3.drawn === 0 && r3.depleted === false && f3.deck.size() === 48);
    const r4 = root.drawInfection(3, {});
    check("drawInfection.no-deck-error", r4.error === "no infection deck");
  } finally {
    restore();
    root.__initGameState().game = savedGame;
  }
  check("drawInfection.restore-clean", (() => {
    for (const city of root.world.cities) {
      for (const col of SUPPLY) if (board.cubeCount(city.name, col) !== savedBoard[city.name][col]) return false;
    }
    for (const col of SUPPLY) {
      if (root.diseases[col].cubeSupply !== savedSupply[col]) return false;
      if (root.diseases.isCured(col) !== savedFlags[col].cured) return false;
      if (root.diseases.isEradicated(col) !== savedFlags[col].eradicated) return false;
    }
    return true;
  })());
  return { pass: results.every(r => r.pass), results };

// ─────────────────────────────────────────────
//  FULL GAME SETUP — compose a complete starting state.
//  setupGame({numPlayers, humanCount, seed, difficulty}):
//   - numPlayers: 2–4 (starting hands of 4/3/2 cards per the
//     rulebook's player-count table).
//   - humanCount: 0–numPlayers; players from index humanCount on
//     are marked isBot.
//   - difficulty: 4 (Introductory) / 5 (Standard) / 6 (Heroic)
//     = number of Epidemic cards in the player deck.
//   - seed: any number; identical seeds → identical starting states.
//  Procedure (official rulebook order):
//   1. Rebuild every singleton model fresh (diseases, board, players).
//   2. Shuffle the 7 role cards, deal 1 unique role per player.
//   3. Shuffle the 53 player cards (City + Event), deal initial hands
//      round-robin from the top (hands may contain Event cards, per
//      the rulebook), then feed the REMAINDER into buildPlayerDeck
//      (task 6) for the epidemic-pile construction.
//   4. Place the first research station in Atlanta; all pawns there.
//   5. buildInfectionDeck (task 7); run the standard initial
//      infection: 3 cards × 3 cubes, then 3 × 2, then 3 × 1 = 18
//      cubes on 9 cities; those 9 cards go to the infection discard.
//  Returns a setup summary and stores the live game record on
//  root.gameState.game / .setup. Because it resets everything,
//  calling setupGame again starts a brand-new game.
//  Task 9 (roadmap): full game setup.
// ─────────────────────────────────────────────
setupGame(opts) =>
  const o = opts || {};
  const numPlayers = Math.floor(Number(o.numPlayers)) || 0;
  const humanCount = Math.floor(Number(o.humanCount)) || 0;
  const difficulty = Math.floor(Number(o.difficulty)) || 0;
  const seed = typeof o.seed === "number" ? o.seed : 1;
  const includeEvents = o.includeEvents !== false;
  if (numPlayers < 2 || numPlayers > 4) return { error: "numPlayers must be 2, 3, or 4, got " + numPlayers };
  if (humanCount < 0 || humanCount > numPlayers) return { error: "humanCount must be 0.." + numPlayers + ", got " + humanCount };
  if (![4, 5, 6].includes(difficulty)) return { error: "difficulty must be 4, 5, or 6, got " + difficulty };
  const HAND_SIZE = { 2: 4, 3: 3, 4: 2 };
  const EVENT_IDS = ["Airlift", "Government Grant", "One Quiet Night", "Resilient Population", "Forecast"];
  const botDiffAt = (i) => {
    let d = "normal";
    if (Array.isArray(o.botDifficulty) && ["easy", "normal", "hard"].includes(o.botDifficulty[i])) d = o.botDifficulty[i];
    else if (typeof o.botDifficulty === "string" && ["easy", "normal", "hard"].includes(o.botDifficulty)) d = o.botDifficulty;
    return d;
  };
  const gs = root.__initGameState();
  gs.diseases = root.buildDiseases();
  gs.board = root.buildBoard();
  gs.players = root.buildPlayers();
  gs.playerDeck = null;
  gs.playerDiscard = null;
  gs.infectionDeck = null;
  gs.infectionDiscard = null;
  const factory = gs.players;
  const roles = root.deckFactory.makeDeck(factory.roles, seed + 101).draw(numPlayers);
  const players = [];
  for (let i = 0; i < numPlayers; i++) {
    const isBot = i >= humanCount;
    const p = factory.createPlayer({
      name: "Player " + (i + 1),
      role: roles[i],
      color: factory.pawnColors[i],
      isBot: isBot,
      location: "Atlanta"
    });
    p.botDifficulty = isBot ? botDiffAt(i) : null;
    players.push(p);
  }
  const handSize = HAND_SIZE[numPlayers];
  const base = [];
  for (const c of root.world.cities) base.push({ id: c.name, kind: "city", color: c.color });
  if (includeEvents) for (const e of EVENT_IDS) base.push({ id: e, kind: "event", color: null });
  const shuffled = root.deckFactory.makeDeck(base, seed + 202);
  const hands = [];
  for (let i = 0; i < numPlayers; i++) hands.push([]);
  const remaining = [];
  let dealt = 0;
  for (let i = shuffled.cards.length - 1; i >= 0; i--) {
    if (dealt < numPlayers * handSize) {
      hands[dealt % numPlayers].push(shuffled.cards[i]);
      dealt++;
    } else {
      remaining.push(shuffled.cards[i]);
    }
  }
  for (let i = 0; i < numPlayers; i++) players[i].hand = hands[i].slice();
  // Assign each bot a persistent target color (starting-hand strong suit,
  // preferring colors no other bot owns) so the team works distinct cure
  // lanes instead of churning from color to color every turn.
  const botColorOrder = ["blue", "yellow", "black", "red"];
  const targetUsed = {};
  for (let i = 0; i < numPlayers; i++) {
    const p = players[i];
    if (!p.isBot) continue;
    const cnt = {};
    for (const c of p.hand) if (c.kind === "city") cnt[c.color] = (cnt[c.color] || 0) + 1;
    let best = null, bestN = -1;
    for (const col of botColorOrder) {
      if (targetUsed[col]) continue;
      const n = cnt[col] || 0;
      if (n > bestN) { bestN = n; best = col; }
    }
    if (!best) for (const col of botColorOrder) { if (!targetUsed[col]) { best = col; break; } }
    p.botTarget = best;
    targetUsed[best] = true;
  }
  gs.board.placeStation("Atlanta");
  const deckBuilt = root.buildPlayerDeck(difficulty, seed + 303, remaining);
  if (deckBuilt.error) return deckBuilt;
  gs.playerDeck = deckBuilt.deck;
  gs.playerDiscard = deckBuilt.discard;
  const infBuilt = root.buildInfectionDeck(seed + 404);
  gs.infectionDeck = infBuilt.deck;
  gs.infectionDiscard = infBuilt.discard;
  // Setup-time infection must not be affected by any PREVIOUS game's roster
  // (e.g. a leftover Quarantine Specialist), per the rulebook — the role
  // powers that block/alter placement only apply once play has begun.
  gs.game = null;
  gs.setup = null;
  const counts = [3, 3, 3, 2, 2, 2, 1, 1, 1];
  const drawn = gs.infectionDeck.draw(9);
  const initialInfection = [];
  for (let i = 0; i < drawn.length; i++) {
    const r = root.infect(drawn[i], counts[i]);
    gs.infectionDiscard.push(drawn[i]);
    initialInfection.push({ city: r.city, color: r.color, cubes: r.cubesPlaced });
  }
  const setup = { numPlayers, humanCount, seed, difficulty, handSize, includeEvents, botDifficulty: Array.isArray(o.botDifficulty) ? o.botDifficulty : typeof o.botDifficulty === "string" ? o.botDifficulty : null };
  gs.setup = setup;
  gs.game = { players: players, turnIndex: 0, currentPlayerIndex: 0, log: [], setup: setup, oneQuietNight: false, epidemicsResolved: 0, lastCompletedPlayerIndex: -1, result: null };
  root.players.startTurn(players[0]);
  root.logEvent(players[0], "phase", { phase: "actions" });
  return {
    ok: true, numPlayers, humanCount, seed, difficulty, handSize, includeEvents,
    players: players.map(p => ({ id: p.id, name: p.name, role: p.role, color: p.color, isBot: p.isBot, botDifficulty: p.botDifficulty, location: p.location, hand: p.hand.map(c => c.id) })),
    playerDeck: { size: gs.playerDeck.size(), pileSizes: deckBuilt.layout.pileSizes, numEpidemics: difficulty, total: deckBuilt.layout.total },
    infectionDeck: { size: gs.infectionDeck.size() },
    initialInfection: initialInfection,
    initialCubes: 18
  };

setupSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const sig = (x) => JSON.stringify(x);
  const a = root.setupGame({ numPlayers: 4, humanCount: 2, seed: 424242, difficulty: 5 });
  const aDeckIds = root.gameState.playerDeck.cards.map(c => c.id).join("|");
  const aInfIds = root.gameState.infectionDeck.cards.map(c => c.id).join("|");
  check("valid-4p-2h", a.ok === true && a.numPlayers === 4 && a.humanCount === 2 && a.handSize === 2 && a.initialCubes === 18);
  check("roles-unique-4", (() => { const r = a.players.map(p => p.role); return new Set(r).size === 4 && r.length === 4; })());
  check("roles-from-7-deck", a.players.every(p => root.players.roles.includes(p.role)));
  check("hand-size-2-each", a.players.every(p => p.hand.length === 2));
  check("bots-marked", a.players.map(p => p.isBot).join("|") === "false|false|true|true");
  check("station-atlanta-only", root.board.hasStation("Atlanta") && root.board.stationCount() === 1);
  check("pawns-at-atlanta", a.players.every(p => p.location === "Atlanta"));
  check("initial-9-distinct-cities", a.initialInfection.length === 9 && new Set(a.initialInfection.map(x => x.city)).size === 9);
  check("initial-cube-pattern", a.initialInfection.map(x => x.cubes).join(",") === "3,3,3,2,2,2,1,1,1");
  check("initial-18-total", root.board.totalCubes() === 18);
  check("infection-decks-after-initial", root.gameState.infectionDeck.size() === 39 && root.gameState.infectionDiscard.size() === 9);
  check("player-deck-50", root.gameState.playerDeck.size() === 50 && root.gameState.playerDeck.cards.filter(c => c.kind === "epidemic").length === 5, "size " + root.gameState.playerDeck.size());
  check("gs-game-record", !!root.gameState.game && root.gameState.game.players.length === 4 && root.gameState.game.turnIndex === 0 && root.gameState.game.currentPlayerIndex === 0 && root.gameState.setup.difficulty === 5);
  const b = root.setupGame({ numPlayers: 4, humanCount: 2, seed: 424242, difficulty: 5 });
  const bDeckIds = root.gameState.playerDeck.cards.map(c => c.id).join("|");
  const bInfIds = root.gameState.infectionDeck.cards.map(c => c.id).join("|");
  check("deterministic-same-seed", sig(a.players.map(p => p.role)) === sig(b.players.map(p => p.role)) && sig(a.players.map(p => p.hand)) === sig(b.players.map(p => p.hand)) && sig(a.initialInfection) === sig(b.initialInfection) && aDeckIds === bDeckIds && aInfIds === bInfIds && a.players[0].color === b.players[0].color);
  const c = root.setupGame({ numPlayers: 4, humanCount: 2, seed: 1, difficulty: 5 });
  check("different-seed-differs", sig(a.players.map(p => p.role)) !== sig(c.players.map(p => p.role)) || sig(a.initialInfection) !== sig(c.initialInfection) || aDeckIds !== root.gameState.playerDeck.cards.map(c => c.id).join("|") || aInfIds !== root.gameState.infectionDeck.cards.map(c => c.id).join("|"));
  const p2 = root.setupGame({ numPlayers: 2, humanCount: 2, seed: 7, difficulty: 4 });
  check("2p-hands-of-4", p2.handSize === 4 && p2.players.every(p => p.hand.length === 4));
  check("player-deck-totals", a.playerDeck.total === 50 && p2.playerDeck.total === 49 && root.gameState.playerDeck.size() === 49, JSON.stringify({ a: a.playerDeck.total, p2: p2.playerDeck.total }));
  const p3 = root.setupGame({ numPlayers: 3, humanCount: 1, seed: 7, difficulty: 6 });
  check("3p-hands-of-3", p3.handSize === 3 && p3.players.every(p => p.hand.length === 3));
  check("3p-6-pile-layout", (() => {
    const ps = p3.playerDeck.pileSizes;
    let ok = ps.length === 6;
    for (let i = 1; i < ps.length; i++) if (ps[i] > ps[i - 1]) ok = false;
    ok = ok && ps.reduce((x, y) => x + y, 0) === p3.playerDeck.total;
    return ok;
  })(), JSON.stringify(p3.playerDeck.pileSizes));
  check("gs-record-final-3p", root.gameState.setup.numPlayers === 3 && root.gameState.game.players.length === 3);
  const ne = root.setupGame({ numPlayers: 4, humanCount: 2, seed: 99, difficulty: 5, includeEvents: false, botDifficulty: ["easy", "hard", "normal", "hard"] });
  check("no-events-deck-size", ne.ok === true && ne.includeEvents === false && root.gameState.playerDeck.size() === 45, "deck " + root.gameState.playerDeck.size());
  check("no-events-in-hands", ne.players.every(p => p.hand.every(id => !["Airlift", "Government Grant", "One Quiet Night", "Resilient Population", "Forecast"].includes(id))), JSON.stringify(ne.players.map(p => p.hand)));
  check("bot-difficulty-per-seat", ne.players.map(p => p.botDifficulty === null ? "null" : p.botDifficulty).join("|") === "null|null|normal|hard" && root.gameState.setup.botDifficulty.join("|") === "easy|hard|normal|hard", ne.players.map(p => p.botDifficulty === null ? "null" : p.botDifficulty).join("|"));
  const ne2 = root.setupGame({ numPlayers: 4, humanCount: 0, seed: 99, difficulty: 5, includeEvents: false, botDifficulty: "hard" });
  check("bot-difficulty-string-applies", ne2.players.every(p => p.botDifficulty === "hard"));
  check("invalid-numPlayers-rejected", !!root.setupGame({ numPlayers: 5, seed: 1 }).error);
  check("invalid-humanCount-rejected", !!root.setupGame({ numPlayers: 2, humanCount: 3, seed: 1 }).error);
  check("invalid-difficulty-rejected", !!root.setupGame({ numPlayers: 2, difficulty: 3, seed: 1 }).error);
  return { pass: results.every(r => r.pass), results };

actionFrameworkSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  const setup = root.setupGame({ numPlayers: 4, humanCount: 2, seed: 4242, difficulty: 5 });
  const P0 = gs.game.players[0];
  check("framework-exists", act && typeof act.register === "function" && typeof act.doAction === "function" && typeof act.pass === "function" && typeof act.unregister === "function");
  const ids = act.list();
  check("registry-seeded-with-11", ["drive", "direct-flight", "charter-flight", "shuttle-flight", "treat-disease", "build-station", "share-knowledge", "discover-cure", "operations-expert-flight", "dispatcher-relocate", "contingency-planner-collect"].every(id => ids.includes(id)) && ids.length === 11, ids.join(","));
  check("lookup-and-has", act.has("drive") && !act.has("bogus") && act.get("drive").id === "drive" && act.get("bogus") === null);
  check("stub-contract", act.get("drive").legal({ args: {} }) !== null && typeof act.get("drive").apply === "function");
  root.players.startTurn(P0);
  const logLen0 = gs.game.log.length;
  act.register({ id: "test-stub", legal: () => null, apply: () => ({ ok: false, error: "not implemented yet" }) });
  const r1 = act.doAction("test-stub");
  check("stub-apply-blocked-no-log", r1.ok === false && r1.error.indexOf("not implemented") !== -1 && P0.actions === 4 && gs.game.log.length === logLen0, JSON.stringify(r1));
  const r2 = act.doAction("bogus");
  check("unknown-action-rejected", r2.ok === false && r2.error.indexOf("unknown action") !== -1);
  const r3 = act.doAction("drive", {}, 2);
  check("non-acting-player-rejected", r3.ok === false && r3.error.indexOf("not the acting player") !== -1);
  P0.actions = 0;
  const r4 = act.doAction("test-stub");
  check("no-actions-remaining-rejected", r4.ok === false && r4.error.indexOf("no actions remaining") !== -1);
  act.register({ id: "test-spend", legal: (ctx) => (ctx.args.cost < 0 ? "cost must be >= 0" : null), apply: (ctx) => ({ ok: true, spent: ctx.args.cost }) });
  act.register({ id: "test-free", cost: 0, legal: () => null, apply: () => ({ ok: true }) });
  root.players.startTurn(P0);
  const logLen1 = gs.game.log.length;
  const r5 = act.doAction("test-spend", { cost: 2 });
  check("apply-decrements-and-logs", r5.ok === true && r5.actionsLeft === 3 && P0.actions === 3 && gs.game.log.length === logLen1 + 1 && gs.game.log[gs.game.log.length - 1].action === "test-spend" && gs.game.log[gs.game.log.length - 1].player === 0 && gs.game.log[gs.game.log.length - 1].args.cost === 2 && gs.game.log[gs.game.log.length - 1].result.spent === 2, JSON.stringify(r5));
  const r6 = act.doAction("test-spend", { cost: -1 });
  check("legal-block-no-decrement-no-log", r6.ok === false && r6.blocked === true && r6.reason === "cost must be >= 0" && P0.actions === 3 && gs.game.log.length === logLen1 + 1, JSON.stringify(r6));
  act.doAction("test-spend", { cost: 1 });
  act.doAction("test-spend", { cost: 1 });
  const r9 = act.doAction("test-spend", { cost: 1 });
  check("auto-end-turn-at-zero", r9.ok === true && r9.turnEnded === true && P0.actions === 0 && P0.isTurn === false && gs.game.log.length === logLen1 + 4, JSON.stringify(r9));
  const r10 = act.doAction("test-spend", { cost: 1 });
  check("turn-ended-not-acting", r10.ok === false && r10.error.indexOf("not the acting player") !== -1);
  root.players.startTurn(P0);
  const logLen2 = gs.game.log.length;
  const r11 = act.doAction("test-free");
  const r12 = act.doAction("test-free");
  check("cost-0-no-decrement", r11.ok && r12.ok && P0.actions === 4 && gs.game.log.length === logLen2 + 2);
  const logLen3 = gs.game.log.length;
  const r13 = act.pass();
  check("pass-ends-turn-and-logs", r13.ok === true && P0.isTurn === false && gs.game.log.length === logLen3 + 1 && gs.game.log[gs.game.log.length - 1].action === "pass" && gs.game.log[gs.game.log.length - 1].result.actionsLeft === 4, JSON.stringify(r13));
  const r14 = act.pass();
  check("pass-requires-acting-player", r14.ok === false && r14.error.indexOf("not the acting player") !== -1);
  const savedGame = gs.game;
  gs.game = null;
  const r15 = act.pass();
  gs.game = savedGame;
  check("no-game-rejected", r15.ok === false && r15.error.indexOf("no game") !== -1);
  act.unregister("test-spend");
  act.unregister("test-free");
  act.unregister("test-stub");
  check("cleanup-unregistered", !act.has("test-spend") && !act.has("test-free") && !act.has("test-stub") && act.list().length === 11);
  return { pass: results.every(r => r.pass), results };

movementActionsSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 3, humanCount: 1, seed: 5, difficulty: 5 });
  const P0 = gs.game.players[0];
  P0.hand = [];
  const give = (card) => P0.hand.push(card);
  const city = (name, color) => ({ id: name, kind: "city", color: color });
  root.players.startTurn(P0);
  const d1 = act.doAction("drive", { to: "Nowhere" });
  check("drive.unknown-city-blocked", d1.ok === false && d1.blocked === true && String(d1.reason).indexOf("unknown destination") !== -1 && P0.actions === 4 && gs.game.log.filter(x => x.action === "drive").length === 0, JSON.stringify(d1));
  const d2 = act.doAction("drive", { to: "Moscow" });
  check("drive.unlinked-blocked", d2.ok === false && d2.blocked === true && String(d2.reason).indexOf("not linked") !== -1 && P0.actions === 4, JSON.stringify(d2));
  const d3 = act.doAction("drive", { to: "Washington" });
  check("drive.moves-and-costs", d3.ok === true && P0.location === "Washington" && P0.actions === 3 && gs.game.log[gs.game.log.length - 1].action === "drive" && gs.game.log[gs.game.log.length - 1].result.from === "Atlanta" && gs.game.log[gs.game.log.length - 1].result.to === "Washington", JSON.stringify(d3));
  give(city("London", "blue"));
  const df1 = act.doAction("direct-flight", { to: "London" });
  check("direct-flight.moves-discards-costs", df1.ok === true && P0.location === "London" && P0.actions === 2 && root.findCardInHand(P0, "London") === null && gs.playerDiscard.top().id === "London", JSON.stringify(df1));
  const df2 = act.doAction("direct-flight", { to: "Moscow" });
  check("direct-flight.missing-card-blocked", df2.ok === false && df2.blocked === true && String(df2.reason).indexOf("do not hold") !== -1 && P0.actions === 2, JSON.stringify(df2));
  const df3 = act.doAction("direct-flight", { to: "London" });
  check("direct-flight.same-city-blocked", df3.ok === false && df3.blocked === true && String(df3.reason).indexOf("already in") !== -1 && P0.actions === 2, JSON.stringify(df3));
  const cf1 = act.doAction("charter-flight", { to: "Cairo" });
  check("charter.missing-current-card-blocked", cf1.ok === false && cf1.blocked === true && String(cf1.reason).indexOf("do not hold") !== -1 && P0.actions === 2, JSON.stringify(cf1));
  give(city("London", "blue"));
  const cf2 = act.doAction("charter-flight", { to: "Cairo" });
  check("charter.moves-discards-costs", cf2.ok === true && P0.location === "Cairo" && P0.actions === 1 && root.findCardInHand(P0, "London") === null && gs.playerDiscard.top().id === "London", JSON.stringify(cf2));
  gs.board.placeStation("Chicago");
  gs.board.placeStation("Miami");
  const sf1 = act.doAction("shuttle-flight", { to: "Miami" });
  check("shuttle.no-station-here-blocked", sf1.ok === false && sf1.blocked === true && String(sf1.reason).indexOf("no research station in Cairo") !== -1 && P0.actions === 1, JSON.stringify(sf1));
  P0.location = "Chicago";
  const sf2 = act.doAction("shuttle-flight", { to: "Atlanta" });
  check("shuttle.stations-ok-ends-turn", sf2.ok === true && P0.location === "Atlanta" && P0.actions === 0 && P0.isTurn === false, JSON.stringify(sf2));
  root.players.startTurn(P0);
  const sf3 = act.doAction("shuttle-flight", { to: "Nowhere" });
  check("shuttle.unknown-city-blocked", sf3.ok === false && sf3.blocked === true && String(sf3.reason).indexOf("unknown destination") !== -1 && P0.actions === 4, JSON.stringify(sf3));
  const sf4 = act.doAction("shuttle-flight", { to: "Sydney" });
  check("shuttle.no-station-there-blocked", sf4.ok === false && sf4.blocked === true && String(sf4.reason).indexOf("no research station in Sydney") !== -1 && P0.actions === 4, JSON.stringify(sf4));
  P0.location = "Miami";
  const sf5 = act.doAction("shuttle-flight", { to: "Miami" });
  check("shuttle.same-city-blocked", sf5.ok === false && sf5.blocked === true && String(sf5.reason).indexOf("already in") !== -1 && P0.actions === 4, JSON.stringify(sf5));
  const sf6 = act.doAction("shuttle-flight", { to: "Chicago" });
  check("shuttle.moves-station-to-station", sf6.ok === true && P0.location === "Chicago" && P0.actions === 3, JSON.stringify(sf6));
  const cf3 = act.doAction("charter-flight", { to: "Nowhere" });
  check("charter.unknown-city-blocked", cf3.ok === false && cf3.blocked === true && String(cf3.reason).indexOf("unknown destination") !== -1, JSON.stringify(cf3));
  check("registry-still-11", act.list().length === 11 && act.has("drive") && act.has("shuttle-flight") && act.has("operations-expert-flight") && act.has("dispatcher-relocate") && act.has("contingency-planner-collect") && act.get("drive").legal({ args: {} }) !== null);
  return { pass: results.every(r => r.pass), results };

cityActionsSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 4, humanCount: 2, seed: 42, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  P0.hand = [];
  P1.hand = [];
  const give = (player, card) => player.hand.push(card);
  const city = (name, color) => ({ id: name, kind: "city", color: color });
  root.players.startTurn(P0);
  // ---- Treat Disease ----
  const t1 = act.doAction("treat-disease", { color: "blue" });
  check("treat.no-cubes-blocked", t1.ok === false && t1.blocked === true && String(t1.reason).indexOf("no blue cubes") !== -1 && P0.actions === 4, JSON.stringify(t1));
  const t2 = act.doAction("treat-disease", { color: "green" });
  check("treat.unknown-color-blocked", t2.ok === false && t2.blocked === true && String(t2.reason).indexOf("unknown disease color") !== -1 && P0.actions === 4, JSON.stringify(t2));
  gs.board.placeCube("Atlanta", "blue");
  gs.board.placeCube("Atlanta", "blue");
  const supplyBefore = gs.diseases.blue.cubeSupply;
  const t3 = act.doAction("treat-disease", { color: "blue" });
  check("treat.removes-one", t3.ok === true && gs.board.cubeCount("Atlanta", "blue") === 1 && gs.diseases.blue.cubeSupply === Math.min(24, supplyBefore + 1) && P0.actions === 3, JSON.stringify(t3));
  root.diseases.setCured("blue");
  gs.board.placeCube("Atlanta", "blue");
  const supplyBefore2 = gs.diseases.blue.cubeSupply;
  const t4 = act.doAction("treat-disease", { color: "blue" });
  check("treat.cured-removes-all", t4.ok === true && t4.result.removed === 2 && gs.board.cubeCount("Atlanta", "blue") === 0 && gs.diseases.blue.cubeSupply === Math.min(24, supplyBefore2 + 2) && P0.actions === 2, JSON.stringify(t4));
  for (const c of root.world.cities) while (gs.board.cubeCount(c.name, "blue") > 0) gs.board.removeCube(c.name, "blue");
  gs.board.placeCube("Atlanta", "blue");
  const t5 = act.doAction("treat-disease", { color: "blue" });
  check("treat.eradication-on-last-cube", t5.ok === true && t5.result.eradicated === true && gs.board.diseaseCubeCounts().blue === 0 && gs.diseases.isEradicated("blue") === true, JSON.stringify({ t5: t5.result, blueOnBoard: gs.board.diseaseCubeCounts().blue, eradicatedFlag: gs.diseases.isEradicated("blue") }));
  // ---- Build Research Station ----
  root.players.startTurn(P0);
  const bs1 = act.doAction("build-station");
  check("build.station-exists-blocked", bs1.ok === false && bs1.blocked === true && String(bs1.reason).indexOf("already a research station") !== -1 && P0.actions === 4, JSON.stringify(bs1));
  P0.location = "Essen";
  const bs2 = act.doAction("build-station");
  check("build.no-card-blocked", bs2.ok === false && bs2.blocked === true && String(bs2.reason).indexOf("do not hold") !== -1 && P0.actions === 4, JSON.stringify(bs2));
  give(P0, city("Essen", "blue"));
  const bs3 = act.doAction("build-station");
  check("build.places-and-discards", bs3.ok === true && gs.board.hasStation("Essen") && gs.board.stationCount() === 2 && P0.actions === 3 && root.findCardInHand(P0, "Essen") === null && gs.playerDiscard.top().id === "Essen", JSON.stringify(bs3));
  for (const c of ["Chicago", "Miami", "London", "Paris"]) gs.board.placeStation(c);
  P0.location = "Madrid";
  give(P0, city("Madrid", "blue"));
  const bs4 = act.doAction("build-station");
  check("build.all-six-need-fromCity", bs4.ok === false && bs4.blocked === true && String(bs4.reason).indexOf("args.fromCity") !== -1 && gs.board.stationCount() === 6, JSON.stringify(bs4));
  const bs5 = act.doAction("build-station", { fromCity: "Chicago" });
  check("build.moves-existing-station", bs5.ok === true && gs.board.hasStation("Madrid") && !gs.board.hasStation("Chicago") && gs.board.stationCount() === 6 && P0.actions === 2, JSON.stringify(bs5));
  P0.location = "Lagos";
  give(P0, city("Lagos", "yellow"));
  const bs6 = act.doAction("build-station", { fromCity: "Nowhere" });
  check("build.unknown-fromCity-blocked", bs6.ok === false && bs6.blocked === true && String(bs6.reason).indexOf("unknown city") !== -1 && P0.actions === 2, JSON.stringify(bs6));
  const bs7 = act.doAction("build-station", { fromCity: "Chicago" });
  check("build.moved-station-gone-blocked", bs7.ok === false && bs7.blocked === true && String(bs7.reason).indexOf("no research station in Chicago") !== -1, JSON.stringify(bs7));
  const bs8 = act.doAction("build-station", { fromCity: "Paris" });
  check("build.moves-station-again", bs8.ok === true && gs.board.hasStation("Lagos") && !gs.board.hasStation("Paris") && P0.actions === 1, JSON.stringify(bs8));
  // ---- Share Knowledge ----
  root.players.startTurn(P0);
  P1.location = "Lagos";
  give(P0, city("Lagos", "yellow"));
  const sk1 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1 });
  check("share.give-to-colocated", sk1.ok === true && P0.hand.length === 0 && root.findCardInHand(P1, "Lagos") !== null && P0.actions === 3, JSON.stringify(sk1));
  const sk2 = act.doAction("share-knowledge", { direction: "take", playerIndex: 1 });
  check("share.take-back", sk2.ok === true && root.findCardInHand(P0, "Lagos") !== null && P1.hand.length === 0 && P0.actions === 2, JSON.stringify(sk2));
  const sk3 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1 });
  check("share.give-again", sk3.ok === true && P0.hand.length === 0 && P1.hand.length === 1 && P0.actions === 1, JSON.stringify(sk3));
  const sk4 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1 });
  check("share.donor-lacks-card-blocked", sk4.ok === false && sk4.blocked === true && String(sk4.reason).indexOf("do not hold") !== -1 && P0.actions === 1, JSON.stringify(sk4));
  P1.location = "Tokyo";
  const sk5 = act.doAction("share-knowledge", { direction: "take", playerIndex: 1 });
  check("share.not-colocated-blocked", sk5.ok === false && sk5.blocked === true && String(sk5.reason).indexOf("is not in Lagos") !== -1 && P0.actions === 1, JSON.stringify(sk5));
  const sk6 = act.doAction("share-knowledge", { direction: "give", playerIndex: 0 });
  check("share.self-blocked", sk6.ok === false && sk6.blocked === true && String(sk6.reason).indexOf("yourself") !== -1, JSON.stringify(sk6));
  const sk7 = act.doAction("share-knowledge", { direction: "give", playerIndex: 9 });
  check("share.no-target-blocked", sk7.ok === false && sk7.blocked === true && String(sk7.reason).indexOf("no player at index") !== -1, JSON.stringify(sk7));
  // ---- Discover Cure ----
  root.players.startTurn(P0);
  P0.location = "London";
  for (const c of ["Beijing", "Shanghai", "Seoul", "Tokyo", "Osaka"]) give(P0, city(c, "red"));
  const dc1 = act.doAction("discover-cure", { color: "red" });
  check("discover.cures-and-discards-5", dc1.ok === true && gs.diseases.isCured("red") === true && P0.hand.length === 0 && P0.actions === 3, JSON.stringify(dc1));
  const dc2 = act.doAction("discover-cure", { color: "red" });
  check("discover.already-cured-blocked", dc2.ok === false && dc2.blocked === true && String(dc2.reason).indexOf("already cured") !== -1 && P0.actions === 3, JSON.stringify(dc2));
  P0.location = "Delhi";
  for (const c of ["Lagos", "Khartoum", "Kinshasa", "Johannesburg", "Cairo"]) give(P0, city(c, "yellow"));
  const dc3 = act.doAction("discover-cure", { color: "yellow" });
  check("discover.no-station-blocked", dc3.ok === false && dc3.blocked === true && String(dc3.reason).indexOf("no research station in Delhi") !== -1 && P0.actions === 3 && gs.diseases.isCured("yellow") === false, JSON.stringify(dc3));
  P0.location = "London";
  for (const c of ["Karachi", "Tehran", "Moscow"]) give(P0, city(c, "black"));
  const dc4 = act.doAction("discover-cure", { color: "black" });
  check("discover.fewer-than-5-blocked", dc4.ok === false && dc4.blocked === true && String(dc4.reason).indexOf("at least 5") !== -1 && P0.actions === 3, JSON.stringify(dc4));
  return { pass: results.every(r => r.pass), results };

singleCityInfectionSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 11, difficulty: 5 });
  const inf = (id, color, n) => root.infect({ id: id, kind: "infection", color: color }, n);
  const clear = (color) => { for (const c of root.world.cities) while (gs.board.cubeCount(c.name, color) > 0) gs.board.removeCube(c.name, color); };
  for (const col of ["blue", "yellow", "black", "red"]) clear(col);
  const r1 = inf("Atlanta", "blue", 1);
  check("single.0-cubes-adds-1", r1.ok && r1.cubesPlaced === 1 && gs.board.cubeCount("Atlanta", "blue") === 1 && r1.outbreak === null);
  const r2 = inf("Atlanta", "blue", 1);
  check("single.2-cubes-adds-1", r2.ok && r2.cubesPlaced === 1 && gs.board.cubeCount("Atlanta", "blue") === 2 && r2.full === false);
  gs.board.placeCube("Atlanta", "blue");
  const ob0 = gs.board.getOutbreaks();
  const r3 = inf("Atlanta", "blue", 1);
  check("single.3-cubes-outbreaks-not-4th", r3.ok && r3.full === true && r3.cubesPlaced === 0 && gs.board.cubeCount("Atlanta", "blue") === 3 && gs.board.getOutbreaks() === ob0 + 1 && r3.outbreak && r3.outbreak.events.length >= 1, JSON.stringify(r3));
  check("single.outbreak-spreads-to-links", gs.board.cubeCount("Chicago", "blue") === 1 && gs.board.cubeCount("Washington", "blue") === 1 && gs.board.cubeCount("Miami", "blue") === 1, JSON.stringify({ c: gs.board.cubeCount("Chicago", "blue"), w: gs.board.cubeCount("Washington", "blue"), m: gs.board.cubeCount("Miami", "blue") }));
  clear("black");
  gs.board.placeCube("Atlanta", "black"); gs.board.placeCube("Atlanta", "black"); gs.board.placeCube("Atlanta", "black");
  gs.board.placeCube("Chicago", "black"); gs.board.placeCube("Chicago", "black"); gs.board.placeCube("Chicago", "black");
  const ob1 = gs.board.getOutbreaks();
  const r4 = inf("Atlanta", "black", 1);
  check("single.chain-outbreak", r4.ok && gs.board.getOutbreaks() === ob1 + 2 && r4.outbreak.events.length === 2 && r4.outbreak.events.map(e => e.city).sort().join(",") === "Atlanta,Chicago" && gs.board.cubeCount("Atlanta", "black") === 3 && gs.board.cubeCount("Chicago", "black") === 3, JSON.stringify(r4.outbreak));
  root.diseases.setCured("red");
  root.diseases.setEradicated("red");
  gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red");
  const ob2 = gs.board.getOutbreaks();
  const r5 = inf("Tokyo", "red", 3);
  check("single.eradicated-no-cubes-no-outbreak", r5.eradicated === true && r5.cubesPlaced === 0 && r5.outbreak === null && gs.board.cubeCount("Tokyo", "red") === 3 && gs.board.getOutbreaks() === ob2);
  clear("yellow");
  gs.board.placeCube("Delhi", "yellow"); gs.board.placeCube("Delhi", "yellow"); gs.board.placeCube("Delhi", "yellow");
  while (gs.board.getOutbreaks() < 7) gs.board.incrementOutbreaks();
  gs.game.result = null;
  const r6 = inf("Delhi", "yellow", 1);
  check("single.eight-outbreaks-lose", r6.ok && r6.outbreak && gs.game.result && gs.game.result.outcome === "lost" && String(gs.game.result.cause).indexOf("8 outbreaks") !== -1 && gs.board.getOutbreaks() === 8, JSON.stringify({ result: gs.game.result, outbreaks: gs.board.getOutbreaks() }));
  gs.game.result = null;
  clear("yellow");
  gs.board.setOutbreaks(0);
  gs.diseases.setSupply("yellow", 1);
  gs.board.placeCube("Khartoum", "yellow"); gs.board.placeCube("Khartoum", "yellow"); gs.board.placeCube("Khartoum", "yellow");
  const r7 = inf("Khartoum", "yellow", 1);
  check("single.supply-exhaustion-lose", r7.ok && r7.outbreak && gs.game.result && gs.game.result.outcome === "lost" && String(gs.game.result.cause).indexOf("supply") !== -1 && gs.diseases.yellow.cubeSupply === 0, JSON.stringify({ result: gs.game.result, supply: gs.diseases.yellow.cubeSupply }));
  gs.game.result = null;
  gs.diseases.setSupply("yellow", 24);
  return { pass: results.every(r => r.pass), results };

chainOutbreakSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 13, difficulty: 5 });
  const clearAll = () => { for (const col of ["blue", "yellow", "black", "red"]) for (const c of root.world.cities) while (gs.board.cubeCount(c.name, col) > 0) gs.board.removeCube(c.name, col); };
  const b = (city, color, n) => { for (let i = 0; i < n; i++) gs.board.placeCube(city, color); };
  gs.board.setOutbreaks(0);
  gs.game.result = null;
  clearAll();
  // Rule: a "would-be 4th cube" triggers an outbreak; REACHING exactly 3 does
  // not. Atlanta at 3 outbreaks; its 2-cube neighbors climb to 3 silently.
  b("Atlanta", "blue", 3); b("Washington", "blue", 2); b("Miami", "blue", 2);
  const obA = gs.board.getOutbreaks();
  const r0 = root.infect({ id: "Atlanta", kind: "infection", color: "blue" }, 1);
  check("chain.reaching-3-not-an-outbreak", r0.ok && gs.board.getOutbreaks() === obA + 1 && r0.outbreak.events.length === 1 && gs.board.cubeCount("Washington", "blue") === 3 && gs.board.cubeCount("Miami", "blue") === 3, JSON.stringify({ ob: gs.board.getOutbreaks(), w: gs.board.cubeCount("Washington", "blue"), m: gs.board.cubeCount("Miami", "blue") }));
  // Triangle Atlanta–Washington–Miami all full: one infection chains through
  // all three, each exactly once, and completes synchronously.
  clearAll(); gs.board.setOutbreaks(0);
  b("Atlanta", "blue", 3); b("Washington", "blue", 3); b("Miami", "blue", 3);
  const ob0 = gs.board.getOutbreaks();
  const r1 = root.infect({ id: "Atlanta", kind: "infection", color: "blue" }, 1);
  check("chain.three-outbreaks-single-event", r1.ok && r1.outbreak && gs.board.getOutbreaks() === ob0 + 3 && r1.outbreak.events.length === 3, JSON.stringify({ ob: gs.board.getOutbreaks(), events: r1.outbreak ? r1.outbreak.events.map(e => e.city) : null }));
  check("chain.cities-at-most-once-visited", r1.outbreak.events.map(e => e.city).sort().join(",") === "Atlanta,Miami,Washington", JSON.stringify(r1.outbreak.events.map(e => e.city)));
  check("chain.no-city-exceeds-3", gs.board.cubeCount("Atlanta", "blue") === 3 && gs.board.cubeCount("Washington", "blue") === 3 && gs.board.cubeCount("Miami", "blue") === 3, JSON.stringify({ a: gs.board.cubeCount("Atlanta", "blue"), w: gs.board.cubeCount("Washington", "blue"), m: gs.board.cubeCount("Miami", "blue") }));
  check("chain.completes-before-draw-continues", gs.game.result === null && gs.board.getOutbreaks() === ob0 + 3);
  // Branch split: Tokyo and Seoul both full, shared neighbor Shanghai full —
  // Shanghai receives would-be-4th cubes from BOTH branches but outbreaks once.
  clearAll(); gs.board.setOutbreaks(0);
  b("Tokyo", "red", 3); b("Seoul", "red", 3); b("Shanghai", "red", 3);
  const ob2 = gs.board.getOutbreaks();
  const r2 = root.infect({ id: "Tokyo", kind: "infection", color: "red" }, 1);
  check("chain.shared-neighbor-outbreaks-once", r2.ok && gs.board.getOutbreaks() === ob2 + 3 && r2.outbreak.events.length === 3 && r2.outbreak.events.filter(e => e.city === "Shanghai").length === 1, JSON.stringify({ ob: gs.board.getOutbreaks(), events: r2.outbreak.events.map(e => e.city) }));
  check("chain.shared-neighbor-stays-3", gs.board.cubeCount("Shanghai", "red") === 3 && gs.board.cubeCount("Tokyo", "red") === 3 && gs.board.cubeCount("Seoul", "red") === 3, JSON.stringify({ s: gs.board.cubeCount("Shanghai", "red"), t: gs.board.cubeCount("Tokyo", "red"), k: gs.board.cubeCount("Seoul", "red") }));
  // Full chain inside the infection-draw step, then a fresh event re-chains
  // (the visited set resets per event).
  clearAll(); gs.board.setOutbreaks(0); gs.game.result = null;
  b("Lagos", "yellow", 3); b("Kinshasa", "yellow", 3);
  const oldDeck = gs.infectionDeck; const oldDiscard = gs.infectionDiscard;
  gs.infectionDeck = root.deckFactory.makeDeck([{ id: "Lagos", kind: "infection", color: "yellow" }]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  const ob3 = gs.board.getOutbreaks();
  const di = root.drawInfection(gs.board.getInfectionRate());
  check("chain.chain-inside-draw-infection", di.drawn === 1 && gs.board.getOutbreaks() === ob3 + 2 && di.results[0].infect.outbreak && di.results[0].infect.outbreak.events.length === 2, JSON.stringify({ ob: gs.board.getOutbreaks(), events: di.results[0].infect.outbreak ? di.results[0].infect.outbreak.events.map(e => e.city) : null }));
  gs.infectionDeck = oldDeck; gs.infectionDiscard = oldDiscard;
  const ob4 = gs.board.getOutbreaks();
  const r3 = root.infect({ id: "Lagos", kind: "infection", color: "yellow" }, 1);
  check("chain.visited-resets-next-event", r3.ok && gs.board.getOutbreaks() === ob4 + 3 && r3.outbreak.events.length === 3 && r3.outbreak.events.map(e => e.city).sort().join(",") === "Khartoum,Kinshasa,Lagos", JSON.stringify({ ob: gs.board.getOutbreaks(), events: r3.outbreak.events.map(e => e.city) }));
  gs.game.result = null;
  return { pass: results.every(r => r.pass), results };

cubeSupplyLossSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 17, difficulty: 5 });
  const clearAll = (color) => { for (const c of root.world.cities) while (gs.board.cubeCount(c.name, color) > 0) gs.board.removeCube(c.name, color); };
  for (const col of ["blue", "yellow", "black", "red"]) clearAll(col);
  gs.board.setOutbreaks(0);
  gs.game.result = null;
  // Direct placement: the supply runs dry while placing cubes in an infection step.
  gs.diseases.setSupply("blue", 1);
  const r1 = root.infect({ id: "Chicago", kind: "infection", color: "blue" }, 3);
  check("supply.direct-placement-loses", r1.ok && r1.cubesPlaced === 1 && r1.supplyExhausted === true && gs.game.result && gs.game.result.outcome === "lost" && String(gs.game.result.cause).indexOf("supply") !== -1, JSON.stringify({ r: r1, result: gs.game.result }));
  gs.game.result = null;
  gs.diseases.setSupply("blue", 24); clearAll("blue");
  // Mid-chain: New York and Washington both full, supply exactly enough for ONE
  // link cube — Washington is queued to outbreak but the chain must die the
  // instant the supply hits 0, before Washington ever pops.
  gs.diseases.setSupply("yellow", 1);
  gs.board.placeCube("New York", "yellow"); gs.board.placeCube("New York", "yellow"); gs.board.placeCube("New York", "yellow");
  gs.board.placeCube("Washington", "yellow"); gs.board.placeCube("Washington", "yellow"); gs.board.placeCube("Washington", "yellow");
  const ob0 = gs.board.getOutbreaks();
  const r2 = root.infect({ id: "New York", kind: "infection", color: "yellow" }, 1);
  check("supply.mid-chain-stops-instantly", r2.ok && r2.outbreak && gs.board.getOutbreaks() === ob0 + 1 && r2.outbreak.events.length === 1 && gs.game.result && gs.game.result.outcome === "lost" && String(gs.game.result.cause).indexOf("supply") !== -1, JSON.stringify({ ob: gs.board.getOutbreaks(), result: gs.game.result, events: r2.outbreak.events.map(e => e.city) }));
  check("supply.pending-outbreak-never-fires", gs.board.cubeCount("Washington", "yellow") === 3 && gs.diseases.yellow.cubeSupply === 0, JSON.stringify({ w: gs.board.cubeCount("Washington", "yellow"), supply: gs.diseases.yellow.cubeSupply }));
  // The turn flow sees the loss: completeTurn stops with the supply cause.
  gs.game.result = null;
  gs.diseases.setSupply("black", 0);
  const oldDeck = gs.infectionDeck; const oldPlayerDeck = gs.playerDeck;
  gs.infectionDeck = root.deckFactory.makeDeck([{ id: "Baghdad", kind: "infection", color: "black" }]);
  gs.playerDeck = root.deckFactory.makeDeck([{ id: "Atlanta", kind: "city", color: "blue" }, { id: "New York", kind: "city", color: "blue" }]);
  const ct = root.completeTurn();
  check("supply.completeTurn-lost", ct.ok && ct.lost === true && String(ct.cause).indexOf("supply") !== -1 && gs.game.result && gs.game.result.outcome === "lost", JSON.stringify({ ct, result: gs.game.result }));
  gs.infectionDeck = oldDeck; gs.playerDeck = oldPlayerDeck;
  gs.game.result = null;
  gs.diseases.setSupply("black", 24);
  return { pass: results.every(r => r.pass), results };

eightOutbreakLossSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 19, difficulty: 5 });
  const clearAll = (color) => { for (const c of root.world.cities) while (gs.board.cubeCount(c.name, color) > 0) gs.board.removeCube(c.name, color); };
  for (const col of ["blue", "yellow", "black", "red"]) clearAll(col);
  gs.board.setOutbreaks(7);
  gs.game.result = null;
  gs.board.placeCube("Kolkata", "black"); gs.board.placeCube("Kolkata", "black"); gs.board.placeCube("Kolkata", "black");
  const r1 = root.infect({ id: "Kolkata", kind: "infection", color: "black" }, 1);
  check("8ob.counter-8-triggers-loss", r1.ok && r1.outbreak && gs.board.getOutbreaks() === 8 && gs.game.result && gs.game.result.outcome === "lost" && String(gs.game.result.cause).indexOf("8 outbreaks") !== -1, JSON.stringify({ ob: gs.board.getOutbreaks(), result: gs.game.result }));
  check("8ob.chain-stops-instantly", r1.outbreak.events.length === 1 && gs.board.cubeCount("Delhi", "black") === 0 && gs.board.cubeCount("Chennai", "black") === 0 && gs.board.cubeCount("Bangkok", "black") === 0 && gs.board.cubeCount("Hong Kong", "black") === 0, JSON.stringify({ events: r1.outbreak.events.map(e => e.city), d: gs.board.cubeCount("Delhi", "black"), c: gs.board.cubeCount("Chennai", "black"), b: gs.board.cubeCount("Bangkok", "black"), h: gs.board.cubeCount("Hong Kong", "black") }));
  // The loss fires mid-turn flow too — even with all 4 actions unspent.
  gs.game.result = null;
  gs.board.setOutbreaks(7);
  gs.board.placeCube("Madrid", "blue"); gs.board.placeCube("Madrid", "blue"); gs.board.placeCube("Madrid", "blue");
  const P0 = gs.game.players[0];
  root.players.startTurn(P0);
  const oldDeck = gs.infectionDeck; const oldPlayerDeck = gs.playerDeck;
  gs.infectionDeck = root.deckFactory.makeDeck([{ id: "Madrid", kind: "infection", color: "blue" }]);
  gs.playerDeck = root.deckFactory.makeDeck([{ id: "Atlanta", kind: "city", color: "blue" }, { id: "New York", kind: "city", color: "blue" }]);
  const ct = root.completeTurn();
  check("8ob.completeTurn-lost-with-actions-remaining", ct.ok && ct.lost === true && String(ct.cause).indexOf("8 outbreaks") !== -1 && gs.game.result && gs.game.result.outcome === "lost" && P0.actions === 4, JSON.stringify({ ct, actions: P0.actions }));
  check("8ob.no-turn-advance", gs.game.currentPlayerIndex === 0 && gs.game.turnIndex === 0, JSON.stringify({ ci: gs.game.currentPlayerIndex, ti: gs.game.turnIndex }));
  gs.infectionDeck = oldDeck; gs.playerDeck = oldPlayerDeck;
  gs.game.result = null;
  gs.board.setOutbreaks(0);
  return { pass: results.every(r => r.pass), results };

eradicationSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 23, difficulty: 5 });
  const clearAll = (color) => { for (const c of root.world.cities) while (gs.board.cubeCount(c.name, color) > 0) gs.board.removeCube(c.name, color); };
  for (const col of ["blue", "yellow", "black", "red"]) clearAll(col);
  gs.game.result = null;
  const P0 = gs.game.players[0];
  root.players.startTurn(P0);
  // Cured but cubes still on the board → NOT eradicated.
  root.diseases.setCured("blue");
  gs.board.placeCube("Atlanta", "blue");
  gs.board.placeCube("Essen", "blue");
  check("erad.cured-with-cubes-not-eradicated", gs.diseases.isCured("blue") === true && gs.diseases.isEradicated("blue") === false);
  // Treat (cured) clears the whole city; only the LAST cube on the board flips eradication.
  P0.location = "Atlanta";
  const t1 = act.doAction("treat-disease", { color: "blue" });
  check("erad.treat-clear-city-keeps-flag", t1.ok && t1.result.removed === 1 && gs.board.cubeCount("Atlanta", "blue") === 0 && gs.diseases.isEradicated("blue") === false, JSON.stringify(t1));
  P0.location = "Essen";
  const t2 = act.doAction("treat-disease", { color: "blue" });
  check("erad.treat-last-cube-eradicates", t2.ok && t2.result.eradicated === true && gs.board.diseaseCubeCounts().blue === 0 && gs.diseases.isEradicated("blue") === true, JSON.stringify({ t2: t2.result, onBoard: gs.board.diseaseCubeCounts().blue }));
  // The Medic-style auto-clear (clearCuredAtCity) also flips eradication.
  root.diseases.setCured("yellow");
  gs.board.placeCube("Lagos", "yellow"); gs.board.placeCube("Lagos", "yellow"); gs.board.placeCube("Lagos", "yellow");
  const mc = gs.board.clearCuredAtCity("Lagos");
  check("erad.medic-clear-eradicates", mc.ok && mc.cleared.length === 1 && mc.cleared[0].count === 3 && gs.diseases.isEradicated("yellow") === true && gs.board.diseaseCubeCounts().yellow === 0, JSON.stringify({ mc, onBoard: gs.board.diseaseCubeCounts().yellow }));
  // Eradicated diseases: never add cubes, never outbreak — even at 3 cubes.
  root.diseases.setCured("red");
  root.diseases.setEradicated("red");
  gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red");
  const ob0 = gs.board.getOutbreaks();
  const r3 = root.infect({ id: "Tokyo", kind: "infection", color: "red" }, 3);
  check("erad.no-cubes-no-outbreak", r3.eradicated === true && r3.cubesPlaced === 0 && r3.outbreak === null && gs.board.cubeCount("Tokyo", "red") === 3 && gs.board.getOutbreaks() === ob0, JSON.stringify(r3));
  const oldDeck = gs.infectionDeck; const oldDiscard = gs.infectionDiscard;
  gs.infectionDeck = root.deckFactory.makeDeck([{ id: "Tokyo", kind: "infection", color: "red" }]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  const di = root.drawInfection(gs.board.getInfectionRate());
  check("erad.draw-infection-places-none", di.drawn === 1 && di.results[0].infect.eradicated === true && di.results[0].infect.cubesPlaced === 0 && gs.board.cubeCount("Tokyo", "red") === 3, JSON.stringify(di.results));
  gs.infectionDeck = oldDeck; gs.infectionDiscard = oldDiscard;
  gs.infectionDeck = root.deckFactory.makeDeck([]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  gs.infectionDeck.push({ id: "Shanghai", kind: "infection", color: "red" });
  gs.infectionDeck.push({ id: "Seoul", kind: "infection", color: "red" });
  const ep = root.resolveEpidemic();
  check("erad.epidemic-places-none", ep.ok && ep.bottomCard === "Shanghai" && ep.infect && ep.infect.eradicated === true && ep.infect.cubesPlaced === 0 && gs.board.cubeCount("Shanghai", "red") === 0 && gs.board.getOutbreaks() === ob0, JSON.stringify({ ep, ob: gs.board.getOutbreaks() }));
  gs.infectionDeck = oldDeck; gs.infectionDiscard = oldDiscard;
  const r4 = root.infect({ id: "Seoul", kind: "infection", color: "red" }, 3);
  check("erad.exempt-rest-of-game", r4.eradicated === true && r4.cubesPlaced === 0 && gs.board.cubeCount("Seoul", "red") === 0);
  check("erad.uncured-never-eradicated", gs.diseases.isEradicated("black") === false && gs.board.diseaseCubeCounts().black === 0);
  return { pass: results.every(r => r.pass), results };

medicSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 3, humanCount: 0, seed: 31, difficulty: 5 });
  const clearAll = (color) => { for (const c of root.world.cities) while (gs.board.cubeCount(c.name, color) > 0) gs.board.removeCube(c.name, color); };
  for (const col of ["blue", "yellow", "black", "red"]) clearAll(col);
  gs.board.setOutbreaks(0);
  gs.game.result = null;
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  const P2 = gs.game.players[2];
  P0.role = "medic";
  P1.role = "dispatcher";
  P2.role = "operations-expert";
  P0.location = "Atlanta";
  P1.location = "Chicago";
  const give = (p, id, color) => p.hand.push({ id: id, kind: "city", color: color });
  root.players.startTurn(P0);
  // Treat removes ALL cubes of one color even when NOT cured.
  gs.board.placeCube("Atlanta", "blue"); gs.board.placeCube("Atlanta", "blue"); gs.board.placeCube("Atlanta", "blue");
  const t1 = act.doAction("treat-disease", { color: "blue" });
  check("medic.treat-removes-all-uncured", t1.ok && t1.result.removed === 3 && gs.board.cubeCount("Atlanta", "blue") === 0 && P0.actions === 3, JSON.stringify(t1));
  // Auto-clear on ENTERING a city: cured cubes vanish the moment he moves in.
  root.diseases.setCured("blue");
  gs.board.placeCube("Chicago", "blue"); gs.board.placeCube("Chicago", "blue");
  const mv = act.doAction("drive", { to: "Chicago" });
  check("medic.auto-clear-on-entry", mv.ok && P0.location === "Chicago" && gs.board.cubeCount("Chicago", "blue") === 0 && P0.actions === 2, JSON.stringify({ mv, chicagoBlue: gs.board.cubeCount("Chicago", "blue") }));
  // Auto-clear on BEING THERE when the cure is discovered elsewhere.
  P0.location = "Essen";
  gs.board.placeCube("Essen", "black"); gs.board.placeCube("Essen", "black");
  P1.location = "Atlanta";
  P1.hand = [];
  const blackCities = root.world.cities.filter(c => c.color === "black").map(c => c.name);
  for (let i = 0; i < 5; i++) give(P1, blackCities[i], "black");
  root.players.startTurn(P1);
  const dc = act.doAction("discover-cure", { color: "black" }, 1);
  check("medic.auto-clear-on-cure", dc.ok && gs.diseases.isCured("black") === true && gs.board.cubeCount("Essen", "black") === 0 && gs.diseases.isEradicated("black") === true, JSON.stringify({ dc, essenBlack: gs.board.cubeCount("Essen", "black") }));
  // Prevention: cured cubes are never placed in the Medic's city — infection draw...
  clearAll("blue");
  root.diseases.setEradicated("blue", false);
  P0.location = "Essen";
  gs.board.placeCube("Essen", "blue");
  gs.infectionDeck = root.deckFactory.makeDeck([{ id: "Essen", kind: "infection", color: "blue" }]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  const di = root.drawInfection(2);
  check("medic.prevents-cured-cubes", di.results[0].infect.prevented === true && di.results[0].infect.cubesPlaced === 0 && gs.board.cubeCount("Essen", "blue") === 1 && gs.board.getOutbreaks() === 0, JSON.stringify(di.results));
  // ...nor by an epidemic's 3-cube infection...
  gs.infectionDeck = root.deckFactory.makeDeck([]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  gs.infectionDeck.push({ id: "Essen", kind: "infection", color: "blue" });
  const ep = root.resolveEpidemic();
  check("medic.prevents-epidemic-cubes", ep.ok && ep.infect.prevented === true && ep.infect.cubesPlaced === 0 && gs.board.cubeCount("Essen", "blue") === 1, JSON.stringify({ ep }));
  // ...nor through an outbreak chain (no 4th cube, no re-chain).
  clearAll("blue");
  root.diseases.setEradicated("blue", false);
  gs.board.placeCube("Paris", "blue"); gs.board.placeCube("Paris", "blue"); gs.board.placeCube("Paris", "blue");
  gs.board.placeCube("Essen", "blue"); gs.board.placeCube("Essen", "blue"); gs.board.placeCube("Essen", "blue");
  const ob0 = gs.board.getOutbreaks();
  const rInf = root.infect({ id: "Paris", kind: "infection", color: "blue" }, 1);
  check("medic.prevents-chain-cubes", rInf.ok && rInf.outbreak && gs.board.getOutbreaks() === ob0 + 1 && gs.board.cubeCount("Essen", "blue") === 3 && gs.board.cubeCount("London", "blue") === 1 && gs.board.cubeCount("Madrid", "blue") === 1 && gs.board.cubeCount("Milan", "blue") === 1 && gs.board.cubeCount("Algiers", "blue") === 1, JSON.stringify({ ob: gs.board.getOutbreaks(), essen: gs.board.cubeCount("Essen", "blue") }));
  // Regression: a non-Medic still removes exactly one cube when NOT cured.
  clearAll("yellow");
  P1.location = "Lagos";
  gs.board.placeCube("Lagos", "yellow"); gs.board.placeCube("Lagos", "yellow");
  root.players.startTurn(P1);
  const t2 = act.doAction("treat-disease", { color: "yellow" }, 1);
  check("medic.non-medic-removes-one", t2.ok && t2.result.removed === 1 && gs.board.cubeCount("Lagos", "yellow") === 1 && t2.result.cured === false, JSON.stringify(t2));
  return { pass: results.every(r => r.pass), results };

scientistSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 37, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  P0.role = "scientist";
  P1.role = "operations-expert";
  const give = (p, id, color) => p.hand.push({ id: id, kind: "city", color: color });
  const byColor = (col) => root.world.cities.filter(c => c.color === col).map(c => c.name);
  root.players.startTurn(P0);
  P0.hand = [];
  const blueCities = byColor("blue");
  for (let i = 0; i < 4; i++) give(P0, blueCities[i], "blue");
  const c1 = act.doAction("discover-cure", { color: "blue" });
  check("scientist.cures-with-4", c1.ok && gs.diseases.isCured("blue") === true && c1.result.discarded === 4 && P0.hand.length === 0 && P0.actions === 3, JSON.stringify(c1));
  P0.hand = [];
  const redCities = byColor("red");
  for (let i = 0; i < 3; i++) give(P0, redCities[i], "red");
  const c2 = act.doAction("discover-cure", { color: "red" });
  check("scientist.blocks-with-3", c2.ok === false && c2.blocked === true && String(c2.reason).indexOf("at least 4") !== -1 && gs.diseases.isCured("red") === false, JSON.stringify(c2));
  P0.hand = [];
  const blackCities = byColor("black");
  for (let i = 0; i < 4; i++) give(P0, blackCities[i], "black");
  P0.location = "Essen";
  const c3 = act.doAction("discover-cure", { color: "black" });
  check("scientist.still-needs-station", c3.ok === false && c3.blocked === true && String(c3.reason).indexOf("no research station") !== -1 && gs.diseases.isCured("black") === false, JSON.stringify(c3));
  P0.location = "Atlanta";
  root.players.startTurn(P0);
  const c4 = act.doAction("discover-cure", { color: "black" });
  check("scientist.cures-again", c4.ok && gs.diseases.isCured("black") === true && c4.result.discarded === 4 && P0.hand.length === 0, JSON.stringify(c4));
  // Non-Scientists keep needing 5.
  root.players.startTurn(P1);
  P1.hand = [];
  P1.location = "Atlanta";
  const yellowCities = byColor("yellow");
  for (let i = 0; i < 4; i++) give(P1, yellowCities[i], "yellow");
  const c5 = act.doAction("discover-cure", { color: "yellow" }, 1);
  check("scientist.non-scientist-blocks-4", c5.ok === false && c5.blocked === true && String(c5.reason).indexOf("at least 5") !== -1 && gs.diseases.isCured("yellow") === false, JSON.stringify(c5));
  give(P1, yellowCities[4], "yellow");
  const c6 = act.doAction("discover-cure", { color: "yellow" }, 1);
  check("scientist.non-scientist-cures-5", c6.ok && c6.result.discarded === 5 && gs.diseases.isCured("yellow") === true && P1.hand.length === 0, JSON.stringify(c6));
  // Already-cured still blocks the Scientist.
  root.players.startTurn(P0);
  P0.hand = [];
  for (let i = 0; i < 4; i++) give(P0, blueCities[i], "blue");
  const c7 = act.doAction("discover-cure", { color: "blue" });
  check("scientist.already-cured-blocked", c7.ok === false && c7.blocked === true && String(c7.reason).indexOf("already cured") !== -1 && P0.hand.length === 4, JSON.stringify(c7));
  return { pass: results.every(r => r.pass), results };

researcherSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 41, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  P0.role = "researcher";
  P1.role = "scientist";
  P0.hand = [];
  P1.hand = [];
  const give = (p, id, color, kind) => p.hand.push({ id: id, kind: kind || "city", color: color });
  root.players.startTurn(P0);
  P0.location = "Chicago";
  P1.location = "Chicago";
  give(P0, "Lagos", "yellow");
  const g1 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1, cardId: "Lagos" });
  check("researcher.gives-any-card", g1.ok && P0.hand.length === 0 && root.findCardInHand(P1, "Lagos") !== null && P0.actions === 3, JSON.stringify(g1));
  give(P0, "Tokyo", "red");
  give(P0, "Airlift", null, "event");
  const g2 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1, cardId: "Tokyo" });
  check("researcher.gives-city-not-event", g2.ok && root.findCardInHand(P1, "Tokyo") !== null && P0.actions === 2, JSON.stringify(g2));
  const g3 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1, cardId: "Airlift" });
  check("researcher.cannot-give-event", g3.ok === false && g3.blocked === true && String(g3.reason).indexOf("city card") !== -1 && root.findCardInHand(P0, "Airlift") !== null, JSON.stringify(g3));
  give(P0, "Beijing", "red");
  root.players.startTurn(P1);
  const g4 = act.doAction("share-knowledge", { direction: "take", playerIndex: 0, cardId: "Beijing" }, 1);
  check("researcher.take-any-from-her", g4.ok && root.findCardInHand(P1, "Beijing") !== null && P0.hand.length === 1 && P1.hand.length === 3, JSON.stringify(g4));
  give(P1, "Paris", "blue");
  root.players.startTurn(P0);
  const g5 = act.doAction("share-knowledge", { direction: "take", playerIndex: 1, cardId: "Paris" });
  check("researcher.non-researcher-donor-city-only", g5.ok === false && g5.blocked === true && root.findCardInHand(P1, "Paris") !== null && gs.game.players[0].location === "Chicago", JSON.stringify(g5));
  root.players.startTurn(P1);
  const g6 = act.doAction("share-knowledge", { direction: "give", playerIndex: 0, cardId: "Tokyo" }, 1);
  check("researcher.non-researcher-give-city-only", g6.ok === false && g6.blocked === true && String(g6.reason).indexOf("Researcher") !== -1 && root.findCardInHand(P1, "Tokyo") !== null, JSON.stringify(g6));
  P1.location = "Tokyo";
  give(P0, "Lagos", "yellow");
  root.players.startTurn(P0);
  const g7 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1, cardId: "Lagos" });
  check("researcher.colocation-required", g7.ok === false && g7.blocked === true && String(g7.reason).indexOf("is not in") !== -1, JSON.stringify(g7));
  P1.location = "Chicago";
  give(P0, "Chicago", "blue");
  const g8 = act.doAction("share-knowledge", { direction: "give", playerIndex: 1, cardId: "Chicago" });
  check("researcher.defaults-to-city-card", g8.ok && root.findCardInHand(P1, "Chicago") !== null, JSON.stringify(g8));
  return { pass: results.every(r => r.pass), results };

operationsExpertSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 47, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  P0.role = "operations-expert";
  P1.role = "scientist";
  P0.hand = [];
  P1.hand = [];
  const give = (p, id, color) => p.hand.push({ id: id, kind: "city", color: color });
  root.players.startTurn(P0);
  // Build a research station with NO card discard.
  P0.location = "Essen";
  const b1 = act.doAction("build-station");
  check("opex.builds-without-card", b1.ok && gs.board.hasStation("Essen") && b1.result.discarded === null && P0.hand.length === 0 && P0.actions === 3, JSON.stringify(b1));
  const b2 = act.doAction("build-station");
  check("opex.existing-station-blocked", b2.ok === false && b2.blocked === true && String(b2.reason).indexOf("already a research station") !== -1 && P0.actions === 3, JSON.stringify(b2));
  // Special flight: from a station city, discard any city card, once per turn.
  P0.location = "Atlanta";
  give(P0, "Cairo", "yellow");
  const f1 = act.doAction("operations-expert-flight", { to: "Delhi", cardId: "Cairo" });
  check("opex.flight-moves-discards-costs", f1.ok && P0.location === "Delhi" && P0.actions === 2 && root.findCardInHand(P0, "Cairo") === null && gs.playerDiscard.top().id === "Cairo", JSON.stringify(f1));
  const f2 = act.doAction("operations-expert-flight", { to: "Lagos", cardId: "Cairo" });
  check("opex.flight-once-per-turn", f2.ok === false && f2.blocked === true && String(f2.reason).indexOf("once per turn") !== -1 && P0.location === "Delhi", JSON.stringify(f2));
  root.players.startTurn(P0);
  P0.location = "Atlanta";
  give(P0, "Tokyo", "red");
  const f3 = act.doAction("operations-expert-flight", { to: "Lagos", cardId: "Tokyo" });
  check("opex.flight-resets-next-turn", f3.ok && P0.location === "Lagos" && P0.actions === 3, JSON.stringify(f3));
  // Requirements: needs a station city, a city card (not an event), and the role.
  root.players.startTurn(P0);
  P0.location = "Sydney";
  give(P0, "London", "blue");
  const f4 = act.doAction("operations-expert-flight", { to: "Lagos", cardId: "London" });
  check("opex.flight-needs-station", f4.ok === false && f4.blocked === true && String(f4.reason).indexOf("no research station") !== -1, JSON.stringify(f4));
  P0.location = "Atlanta";
  const f5 = act.doAction("operations-expert-flight", { to: "Lagos" });
  check("opex.flight-needs-card", f5.ok === false && f5.blocked === true && String(f5.reason).indexOf("discard a city card") !== -1, JSON.stringify(f5));
  P0.hand.push({ id: "Forecast", kind: "event", color: null });
  const f6 = act.doAction("operations-expert-flight", { to: "Lagos", cardId: "Forecast" });
  check("opex.flight-needs-city-card", f6.ok === false && f6.blocked === true && String(f6.reason).indexOf("city card") !== -1, JSON.stringify(f6));
  root.players.startTurn(P1);
  P1.location = "Atlanta";
  const f7 = act.doAction("operations-expert-flight", { to: "Lagos", cardId: "Atlanta" }, 1);
  check("opex.flight-non-opex-blocked", f7.ok === false && f7.blocked === true && String(f7.reason).indexOf("only the Operations Expert") !== -1, JSON.stringify(f7));
  // Regression: a non-Operations Expert still discards the city card to build.
  give(P1, "Madrid", "blue");
  P1.location = "Madrid";
  const b3 = act.doAction("build-station", {}, 1);
  check("opex.non-opex-still-needs-card", b3.ok && gs.board.hasStation("Madrid") && b3.result.discarded === "Madrid" && root.findCardInHand(P1, "Madrid") === null, JSON.stringify(b3));
  return { pass: results.every(r => r.pass), results };

dispatcherSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 3, humanCount: 0, seed: 53, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  const P2 = gs.game.players[2];
  P0.role = "dispatcher";
  P1.role = "scientist";
  P2.role = "medic";
  P0.hand = [];
  P1.hand = [];
  P2.hand = [];
  const give = (p, id, color) => p.hand.push({ id: id, kind: "city", color: color });
  root.players.startTurn(P0);
  // Move ANY pawn as if it were his own.
  const m1 = act.doAction("drive", { to: "Washington", pawnIndex: 1 });
  check("dispatcher.drives-other-pawn", m1.ok && P1.location === "Washington" && P0.location === "Atlanta" && P0.actions === 3, JSON.stringify(m1));
  give(P0, "London", "blue");
  const m2 = act.doAction("direct-flight", { to: "London", pawnIndex: 1 });
  check("dispatcher.direct-flights-other-pawn", m2.ok && P1.location === "London" && root.findCardInHand(P0, "London") === null && gs.playerDiscard.top().id === "London" && P0.actions === 2, JSON.stringify(m2));
  give(P0, "London", "blue");
  const m3 = act.doAction("charter-flight", { to: "Cairo", pawnIndex: 1 });
  check("dispatcher.charter-flights-other-pawn", m3.ok && P1.location === "Cairo" && root.findCardInHand(P0, "London") === null && P0.actions === 1, JSON.stringify(m3));
  gs.board.placeStation("Chicago");
  gs.board.placeStation("Miami");
  P1.location = "Chicago";
  const m4 = act.doAction("shuttle-flight", { to: "Miami", pawnIndex: 1 });
  check("dispatcher.shuttles-other-pawn", m4.ok && P1.location === "Miami" && P0.actions === 0, JSON.stringify(m4));
  root.players.startTurn(P0);
  const m5 = act.doAction("drive", { to: "Washington", pawnIndex: 0 });
  check("dispatcher.moves-own-pawn", m5.ok && P0.location === "Washington" && P0.actions === 3, JSON.stringify(m5));
  // A non-Dispatcher's pawnIndex is ignored: it moves self.
  P2.location = "Atlanta";
  root.players.startTurn(P2);
  const m6 = act.doAction("drive", { to: "Chicago", pawnIndex: 0 }, 2);
  check("dispatcher.non-dispatcher-ignores-pawnIndex", m6.ok && P2.location === "Chicago" && P0.location === "Washington", JSON.stringify(m6));
  // Relocate: once per turn, move any pawn to a city occupied by another pawn.
  root.players.startTurn(P0);
  P1.location = "New York";
  P2.location = "London";
  const r1 = act.doAction("dispatcher-relocate", { pawnIndex: 1, to: "London" });
  check("dispatcher.relocates-pawn-to-teammate", r1.ok && P1.location === "London" && P0.actions === 3, JSON.stringify(r1));
  const r2 = act.doAction("dispatcher-relocate", { pawnIndex: 1, to: "Cairo" });
  check("dispatcher.relocate-once-per-turn", r2.ok === false && r2.blocked === true && String(r2.reason).indexOf("once per turn") !== -1, JSON.stringify(r2));
  // Flag resets on the next turn; may relocate himself to a teammate's city.
  root.players.startTurn(P0);
  const r3 = act.doAction("dispatcher-relocate", { pawnIndex: 1, to: "Delhi" });
  check("dispatcher.relocate-needs-teammate-there", r3.ok === false && r3.blocked === true && String(r3.reason).indexOf("no other pawn") !== -1, JSON.stringify(r3));
  const r4 = act.doAction("dispatcher-relocate", { pawnIndex: 0, to: "London" });
  check("dispatcher.relocates-self-and-resets", r4.ok && P0.location === "London" && P0.actions === 3, JSON.stringify(r4));
  root.players.startTurn(P1);
  const r5 = act.doAction("dispatcher-relocate", { pawnIndex: 0, to: "London" }, 1);
  check("dispatcher.non-dispatcher-blocked", r5.ok === false && r5.blocked === true && String(r5.reason).indexOf("only the Dispatcher") !== -1, JSON.stringify(r5));
  return { pass: results.every(r => r.pass), results };

quarantineSpecialistSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 59, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  P0.role = "quarantine-specialist";
  P0.location = "Essen";
  const clearAll = (color) => { for (const c of root.world.cities) while (gs.board.cubeCount(c.name, color) > 0) gs.board.removeCube(c.name, color); };
  for (const col of ["blue", "yellow", "black", "red"]) clearAll(col);
  gs.board.setOutbreaks(0);
  gs.game.result = null;
  // Her own city: no cubes, no outbreak.
  const r1 = root.infect({ id: "Essen", kind: "infection", color: "blue" }, 3);
  check("quarantine.own-city-blocked", r1.quarantined === true && r1.cubesPlaced === 0 && gs.board.cubeCount("Essen", "blue") === 0 && gs.board.getOutbreaks() === 0, JSON.stringify(r1));
  // Linked cities are protected too.
  const r2 = root.infect({ id: "Paris", kind: "infection", color: "blue" }, 3);
  check("quarantine.linked-city-blocked", r2.quarantined === true && r2.cubesPlaced === 0 && gs.board.cubeCount("Paris", "blue") === 0, JSON.stringify(r2));
  // Unrelated cities still infect normally.
  const r3 = root.infect({ id: "Cairo", kind: "infection", color: "black" }, 3);
  check("quarantine.unrelated-infects", r3.ok && r3.quarantined === false && r3.cubesPlaced === 3 && gs.board.cubeCount("Cairo", "black") === 3, JSON.stringify(r3));
  // An epidemic's 3-cube infection is blocked in the protected region.
  gs.infectionDeck = root.deckFactory.makeDeck([]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  gs.infectionDeck.push({ id: "Essen", kind: "infection", color: "blue" });
  const ep = root.resolveEpidemic();
  check("quarantine.epidemic-blocked", ep.ok && ep.infect.quarantined === true && ep.infect.cubesPlaced === 0 && gs.board.cubeCount("Essen", "blue") === 0, JSON.stringify({ ep }));
  // Outbreak chains stop at the protected border.
  clearAll("blue");
  gs.board.placeCube("New York", "blue"); gs.board.placeCube("New York", "blue"); gs.board.placeCube("New York", "blue");
  const ob0 = gs.board.getOutbreaks();
  const r4 = root.infect({ id: "New York", kind: "infection", color: "blue" }, 1);
  check("quarantine.chain-stops-at-border", r4.ok && r4.outbreak && gs.board.getOutbreaks() === ob0 + 1 && gs.board.cubeCount("New York", "blue") === 3 && gs.board.cubeCount("London", "blue") === 0 && gs.board.cubeCount("Montreal", "blue") === 1 && gs.board.cubeCount("Washington", "blue") === 1 && gs.board.cubeCount("Madrid", "blue") === 1, JSON.stringify({ ob: gs.board.getOutbreaks(), l: gs.board.cubeCount("London", "blue"), m: gs.board.cubeCount("Montreal", "blue"), w: gs.board.cubeCount("Washington", "blue"), d: gs.board.cubeCount("Madrid", "blue") }));
  // Stacks with the Medic: the Medic's prevent rule takes precedence when cured,
  // the quarantine rule applies otherwise.
  P1.role = "medic";
  P1.location = "Essen";
  root.diseases.setCured("blue");
  clearAll("blue");
  root.diseases.setEradicated("blue", false);
  gs.board.placeCube("Essen", "blue");
  const st1 = root.infect({ id: "Essen", kind: "infection", color: "blue" }, 1);
  check("quarantine.medic-prevention-takes-precedence", st1.prevented === true && st1.quarantined === false && gs.board.cubeCount("Essen", "blue") === 1, JSON.stringify(st1));
  root.diseases.setCured("blue", false);
  const st2 = root.infect({ id: "Essen", kind: "infection", color: "blue" }, 1);
  check("quarantine.blocks-when-not-cured", st2.quarantined === true && st2.prevented === false && gs.board.cubeCount("Essen", "blue") === 1, JSON.stringify(st2));
  return { pass: results.every(r => r.pass), results };

eventAndContingencySelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const act = gs.actions;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 61, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  P0.role = "contingency-planner";
  P1.role = "medic";
  P0.location = "Atlanta";
  P1.location = "New York";
  P0.hand = [];
  P1.hand = [];
  const ev = (id) => ({ id: id, kind: "event", color: null });
  const cityCard = (id, color) => ({ id: id, kind: "city", color: color });
  const give = (p, c) => p.hand.push(c);
  // Control both decks so completeTurn's draw + infection phases are harmless.
  gs.playerDeck = root.deckFactory.makeDeck([
    { id: "Cairo", kind: "city", color: "yellow" }, { id: "Essen", kind: "city", color: "blue" },
    { id: "Paris", kind: "city", color: "blue" }, { id: "Milan", kind: "city", color: "blue" },
    { id: "Moscow", kind: "city", color: "black" }, { id: "St. Petersburg", kind: "city", color: "blue" }
  ]);
  gs.infectionDeck = root.deckFactory.makeDeck([
    { id: "Lagos", kind: "infection", color: "yellow" }, { id: "Khartoum", kind: "infection", color: "yellow" }
  ]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  gs.game.result = null;
  root.players.startTurn(P0);
  // ---- Airlift: move any pawn to any city, free, then discard the event.
  give(P0, ev("Airlift"));
  const a1 = root.playEvent({ playerIndex: 0, cardId: "Airlift", args: { pawnIndex: 1, to: "Chicago" } });
  check("airlift.moves-any-pawn-no-cost", a1.ok === true && a1.stored === false && P1.location === "Chicago" && P0.actions === 4 && root.findCardInHand(P0, "Airlift") === null && gs.playerDiscard.top().id === "Airlift" && gs.game.log[gs.game.log.length - 1].action === "event", JSON.stringify(a1));
  give(P0, ev("Airlift"));
  const a2 = root.playEvent({ playerIndex: 0, cardId: "Airlift", args: { pawnIndex: 1, to: "Chicago" } });
  check("airlift.same-city-blocked-keeps-card", a2.ok === false && String(a2.error).indexOf("already in") !== -1 && root.findCardInHand(P0, "Airlift") !== null && P0.actions === 4, JSON.stringify(a2));
  // ---- Government Grant: station in any city, free; 6-station rule like Build Station.
  give(P0, ev("Government Grant"));
  const gg1 = root.playEvent({ playerIndex: 0, cardId: "Government Grant", args: { to: "Mumbai" } });
  check("govgrant.places-station-no-card", gg1.ok === true && gs.board.hasStation("Mumbai") === true && P0.actions === 4 && root.findCardInHand(P0, "Government Grant") === null && gs.playerDiscard.top().id === "Government Grant", JSON.stringify(gg1));
  gs.board.placeStation("Paris");
  gs.board.placeStation("Tokyo");
  gs.board.placeStation("Sydney");
  gs.board.placeStation("Lagos");
  check("govgrant.six-stations-prepared", gs.board.stationCount() === 6, "stations " + gs.board.stationCount());
  give(P0, ev("Government Grant"));
  const gg2 = root.playEvent({ playerIndex: 0, cardId: "Government Grant", args: { to: "Riyadh" } });
  check("govgrant.six-stations-need-fromCity", gg2.ok === false && String(gg2.error).indexOf("fromCity") !== -1 && gs.board.stationCount() === 6, JSON.stringify(gg2));
  give(P0, ev("Government Grant"));
  const gg3 = root.playEvent({ playerIndex: 0, cardId: "Government Grant", args: { to: "Delhi", fromCity: "Paris" } });
  check("govgrant.six-stations-moves", gg3.ok === true && gs.board.hasStation("Delhi") === true && gs.board.hasStation("Paris") === false && gs.board.stationCount() === 6, JSON.stringify(gg3));
  // ---- One Quiet Night: skip the next infection phase (this turn's).
  give(P0, ev("One Quiet Night"));
  const oq1 = root.playEvent({ playerIndex: 0, cardId: "One Quiet Night" });
  check("onequietnight.sets-flag", oq1.ok === true && gs.game.oneQuietNight === true && P0.actions === 4, JSON.stringify(oq1));
  const ct = root.completeTurn();
  check("onequietnight.skips-infection-phase", ct.ok === true && ct.infection === null && gs.game.oneQuietNight === false && ct.nextPlayer === P1.name, JSON.stringify({ infection: ct.infection, oqn: gs.game.oneQuietNight, next: ct.nextPlayer }));
  // ---- Events are playable on ANY turn (P0 is not the acting player now).
  const out1 = root.playEvent({ playerIndex: 0, cardId: "Airlift", args: { pawnIndex: 0, to: "Miami" } });
  check("events.playable-outside-own-turn", out1.ok === true && P0.location === "Miami" && gs.game.players[gs.game.currentPlayerIndex].name === P1.name && P1.actions === 4, JSON.stringify(out1));
  // ---- Guards.
  give(P0, { id: "Ghost Event", kind: "event", color: null });
  const bad1 = root.playEvent({ playerIndex: 0, cardId: "Ghost Event" });
  check("events.unimplemented-event-rejected", bad1.ok === false && String(bad1.error).indexOf("not implemented") !== -1, JSON.stringify(bad1));
  give(P0, cityCard("Madrid", "blue"));
  const bad2 = root.playEvent({ playerIndex: 0, cardId: "Madrid" });
  check("events.non-event-card-rejected", bad2.ok === false && String(bad2.error).indexOf("not an event card") !== -1, JSON.stringify(bad2));
  const bad2b = root.playEvent({ playerIndex: 0, cardId: "One Quiet Night" });
  check("events.unheld-card-rejected", bad2b.ok === false && String(bad2b.error).indexOf("does not hold") !== -1, JSON.stringify(bad2b));
  gs.game.result = { outcome: "lost", cause: "test" };
  const bad3 = root.playEvent({ playerIndex: 0, cardId: "Airlift" });
  gs.game.result = null;
  check("events.game-over-rejected", bad3.ok === false && String(bad3.error).indexOf("already ended") !== -1, JSON.stringify(bad3));
  // ---- Contingency Planner: fresh game, explicit roster.
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 61, difficulty: 5 });
  const Q0 = gs.game.players[0];
  const Q1 = gs.game.players[1];
  Q0.role = "contingency-planner";
  Q1.role = "researcher";
  Q0.hand = [];
  Q1.hand = [];
  root.players.startTurn(Q0);
  check("planner.starts-empty", Q0.contingencyEvent === null);
  give(Q0, ev("Airlift"));
  root.discardCards(Q0, ["Airlift"]);
  const oldRole = Q0.role;
  Q0.role = "medic";
  const c1 = act.doAction("contingency-planner-collect", { cardId: "Airlift" });
  Q0.role = oldRole;
  check("planner.role-required", c1.ok === false && c1.blocked === true && String(c1.reason).indexOf("only the Contingency Planner") !== -1 && Q0.actions === 4 && Q0.contingencyEvent === null, JSON.stringify(c1));
  const c4 = act.doAction("contingency-planner-collect", { cardId: "Madrid" });
  check("planner.only-events-in-discard", c4.ok === false && c4.blocked === true && String(c4.reason).indexOf("no event card") !== -1 && Q0.actions === 4, JSON.stringify(c4));
  const c2 = act.doAction("contingency-planner-collect", { cardId: "Airlift" });
  check("planner.collect-stores-costs-one", c2.ok === true && Q0.actions === 3 && Q0.contingencyEvent && Q0.contingencyEvent.id === "Airlift" && root.findCardInHand(Q0, "Airlift") === null, JSON.stringify(c2));
  let airliftInDiscard = false;
  for (const c of gs.playerDiscard.cards) if (c.id === "Airlift") airliftInDiscard = true;
  check("planner.card-leaves-discard", airliftInDiscard === false, JSON.stringify({ airliftInDiscard }));
  root.players.startTurn(Q0);
  check("planner.stored-event-survives-turn-reset", Q0.contingencyEvent && Q0.contingencyEvent.id === "Airlift" && Q0.actions === 4, String(Q0.contingencyEvent && Q0.contingencyEvent.id));
  give(Q0, ev("Government Grant"));
  root.discardCards(Q0, ["Government Grant"]);
  const c3 = act.doAction("contingency-planner-collect", { cardId: "Government Grant" });
  check("planner.max-one-stored", c3.ok === false && c3.blocked === true && String(c3.reason).indexOf("already has") !== -1 && Q0.contingencyEvent.id === "Airlift" && Q0.actions === 4, JSON.stringify(c3));
  const a3 = root.playEvent({ playerIndex: 0, cardId: "Airlift", args: { pawnIndex: 1, to: "Seoul" } });
  let airliftInDiscard2 = false;
  for (const c of gs.playerDiscard.cards) if (c.id === "Airlift") airliftInDiscard2 = true;
  check("planner.play-stored-removes-from-game", a3.ok === true && a3.stored === true && a3.result.removedFromGame === "Airlift" && Q0.contingencyEvent === null && airliftInDiscard2 === false && Q0.actions === 4 && Q1.location === "Seoul", JSON.stringify(a3));
  const c5 = act.doAction("contingency-planner-collect", { cardId: "Airlift" });
  check("planner.played-event-not-recollectable", c5.ok === false && c5.blocked === true && String(c5.reason).indexOf("no event card") !== -1 && Q0.actions === 4, JSON.stringify(c5));
  // ---- Resilient Population (task 36): permanently remove any infection discard card.
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 61, difficulty: 5 });
  const R0 = gs.game.players[0];
  R0.hand = [];
  gs.infectionDeck = root.deckFactory.makeDeck([
    { id: "Essen", kind: "infection", color: "blue" },
    { id: "Paris", kind: "infection", color: "blue" },
    { id: "London", kind: "infection", color: "blue" },
    { id: "Madrid", kind: "infection", color: "blue" },
    { id: "Milan", kind: "infection", color: "blue" },
    { id: "St. Petersburg", kind: "infection", color: "blue" },
    { id: "Istanbul", kind: "infection", color: "black" },
    { id: "Cairo", kind: "infection", color: "yellow" }
  ]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  const di1 = root.drawInfection(1);
  const discardTop = gs.infectionDiscard.top().id;
  R0.hand.push({ id: "Resilient Population", kind: "event", color: null });
  const rp1 = root.playEvent({ playerIndex: 0, cardId: "Resilient Population", args: { discardCardId: discardTop } });
  check("resilient.removes-discard-card", rp1.ok === true && rp1.result.removed === discardTop && gs.infectionDiscard.size() === 0 && gs.infectionDeck.size() === 7 && R0.hand.length === 0, JSON.stringify(rp1));
  R0.hand.push({ id: "Resilient Population", kind: "event", color: null });
  const rp2 = root.playEvent({ playerIndex: 0, cardId: "Resilient Population", args: { discardCardId: "Nowhere" } });
  check("resilient.unknown-discard-rejected", rp2.ok === false && String(rp2.error).indexOf("infection discard") !== -1, JSON.stringify(rp2));
  // ---- Forecast (task 37): reveal the top 6, replace in any chosen order.
  R0.hand.push({ id: "Forecast", kind: "event", color: null });
  const fc1 = root.playEvent({ playerIndex: 0, cardId: "Forecast", args: { order: ["London", "Madrid", "Milan", "St. Petersburg", "Istanbul", "Paris"] } });
  check("forecast.reorders-top-six", fc1.ok === true && fc1.result.drawn.length === 6 && gs.infectionDeck.size() === 7 && gs.infectionDeck.top().id === "London" && gs.infectionDeck.cards[gs.infectionDeck.cards.length - 2].id === "Madrid" && gs.infectionDeck.cards[0].id === "Essen" && R0.hand.length === 1, JSON.stringify({ fc1: fc1.result, top: gs.infectionDeck.top().id }));
  R0.hand.push({ id: "Forecast", kind: "event", color: null });
  const fc2 = root.playEvent({ playerIndex: 0, cardId: "Forecast", args: { order: ["London", "Madrid"] } });
  check("forecast.wrong-length-rejected-restores", fc2.ok === false && String(fc2.error).indexOf("order") !== -1 && gs.infectionDeck.size() === 7 && gs.infectionDeck.top().id === "London", JSON.stringify(fc2));
  R0.hand.push({ id: "Forecast", kind: "event", color: null });
  const fc3 = root.playEvent({ playerIndex: 0, cardId: "Forecast", args: { order: ["London", "Madrid", "London", "St. Petersburg", "Istanbul", "Paris"] } });
  check("forecast.repeat-rejected-restores", fc3.ok === false && String(fc3.error).indexOf("repeats") !== -1 && gs.infectionDeck.size() === 7 && gs.infectionDeck.top().id === "London", JSON.stringify(fc3));
  // ---- Event-card lifecycle (task 38): events count toward the 7-card
  // hand limit, are discardable to it, and do not draw replacements.
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 61, difficulty: 5 });
  const L0 = gs.game.players[0];
  const L1 = gs.game.players[1];
  L0.hand = [];
  for (let i = 0; i < 8; i++) L0.hand.push(i < 6 ? { id: "E" + i, kind: "event", color: null } : { id: "C" + i, kind: "city", color: "blue" });
  check("lifecycle.events-count-toward-hand-limit", root.handOverLimit(L0) === true && L0.hand.filter(c => c.kind === "event").length === 6, "len " + L0.hand.length + " events " + L0.hand.filter(c => c.kind === "event").length);
  const dl = root.discardToHandLimit(L0, ["E0", "E1"]);
  check("lifecycle.events-discardable-to-limit", dl.ok === true && L0.hand.length === 6 && dl.discarded.length === 2, JSON.stringify(dl));
  L0.hand.push({ id: "Airlift", kind: "event", color: null });
  gs.playerDeck = root.deckFactory.makeDeck([
    { id: "Milan", kind: "city", color: "blue" }, { id: "Osaka", kind: "city", color: "red" }, { id: "Manila", kind: "city", color: "red" }
  ]);
  const before = L0.hand.length;
  const ev1 = root.playEvent({ playerIndex: 0, cardId: "Airlift", args: { pawnIndex: 1, to: "Seoul" } });
  const dp2 = root.drawPhase(L0);
  check("lifecycle.no-replacement-drawn", ev1.ok === true && dp2.drawn.length === 2 && L0.hand.length === before - 1 + 2, JSON.stringify({ before: before, after: L0.hand.length, drawn: dp2.drawn.length }));
  return { pass: results.every(r => r.pass), results };

turnLogSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 2, humanCount: 0, seed: 71, difficulty: 5 });
  const P0 = gs.game.players[0];
  const P1 = gs.game.players[1];
  P0.hand = [];
  gs.playerDeck = root.deckFactory.makeDeck([
    { id: "Cairo", kind: "city", color: "yellow" },
    { id: "Essen", kind: "city", color: "blue" },
    { id: "Epidemic", kind: "epidemic", color: null }
  ]);
  gs.infectionDeck = root.deckFactory.makeDeck([{ id: "Lagos", kind: "infection", color: "yellow" }]);
  gs.infectionDiscard = root.deckFactory.makeDeck([]);
  gs.game.result = null;
  const entryShape = (e) => typeof e.ts === "number" && typeof e.turn === "number" && typeof e.role === "string" && typeof e.color === "string" && typeof e.name === "string";
  const len0 = gs.game.log.length;
  const dr = gs.actions.doAction("drive", { to: "Washington" });
  check("log.action-entry-tagged", dr.ok === true && gs.game.log.length === len0 + 1 && gs.game.log[len0].action === "drive" && entryShape(gs.game.log[len0]) && gs.game.log[len0].role === P0.role && gs.game.log[len0].color === P0.color && gs.game.log[len0].player === 0, JSON.stringify(gs.game.log[len0]));
  const dp = root.drawPhase(P0);
  const hasEpidemicLog = gs.game.log.some(e => e.action === "epidemic");
  const drawLog = gs.game.log[gs.game.log.length - 1];
  check("log.draw-entry", dp.ok === true && dp.epidemics.length === 1 && drawLog.action === "draw" && entryShape(drawLog), JSON.stringify(drawLog));
  check("log.epidemic-entry", hasEpidemicLog === true);
  const di = root.drawInfection(gs.board.getInfectionRate());
  const hasInfectionLog = gs.game.log.some(e => e.action === "infection");
  check("log.infection-entry", di.drawn === 1 && hasInfectionLog === true);
  const obBefore = gs.board.getOutbreaks();
  for (const c of root.world.cities) while (gs.board.cubeCount(c.name, "yellow") > 0) gs.board.removeCube(c.name, "yellow");
  gs.board.placeCube("Lagos", "yellow"); gs.board.placeCube("Lagos", "yellow"); gs.board.placeCube("Lagos", "yellow");
  const obRes = root.infect({ id: "Lagos", kind: "infection", color: "yellow" }, 1);
  const hasOutbreakLog = gs.game.log.some(e => e.action === "outbreak");
  check("log.outbreak-entry", obRes.ok === true && gs.board.getOutbreaks() > obBefore && hasOutbreakLog === true);
  P0.hand.push({ id: "Airlift", kind: "event", color: null });
  const ev = root.playEvent({ playerIndex: 0, cardId: "Airlift", args: { pawnIndex: 1, to: "Chicago" } });
  check("log.event-entry", ev.ok === true && gs.game.log[gs.game.log.length - 1].action === "event" && entryShape(gs.game.log[gs.game.log.length - 1]), JSON.stringify(gs.game.log[gs.game.log.length - 1]));
  for (let i = 0; i < 260; i++) root.logEvent(P0, "test", { i: i });
  check("log.capped-at-200", gs.game.log.length === 200 && gs.game.log[0].action === "test" && gs.game.log[gs.game.log.length - 1].action === "test", "len " + gs.game.log.length);
  check("log.oldest-newest", gs.game.log[gs.game.log.length - 1].i - gs.game.log[0].i === 199, JSON.stringify({ first: gs.game.log[0].i, last: gs.game.log[gs.game.log.length - 1].i }));
  return { pass: results.every(r => r.pass), results };

botSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 4, humanCount: 0, seed: 73, difficulty: 5 });
  const P0 = gs.game.players[0];
  gs.board.placeCube("Atlanta", "blue"); gs.board.placeCube("Atlanta", "blue");
  const cands = root.botCandidatesFor(0);
  check("bot.candidates-nonempty", cands.length > 0, "n=" + cands.length);
  const sorted = cands.slice().sort((a, b) => b.score - a.score);
  check("bot.treat-prioritized", sorted[0].action === "treat-disease" && sorted[0].args.color === "blue", JSON.stringify(sorted.slice(0, 3).map(x => ({ a: x.action, s: x.score }))));
  const choice = root.botChooseAction(0);
  check("bot.choose-best-legal", choice !== null && choice.action === "treat-disease" && choice.args.color === "blue", JSON.stringify(choice));
  const turn = root.runBotTurn(0);
  check("bot.turn-executes-actions", turn.ok === true && turn.actions.length >= 1 && turn.actions.length <= 4 && P0.actions === 4 - turn.actions.length, JSON.stringify({ n: turn.actions.length, actions: turn.actions.map(a => a.action) }));
  root.setupGame({ numPlayers: 4, humanCount: 0, seed: 73, difficulty: 5 });
  const P0b = gs.game.players[0];
  gs.board.placeCube("Atlanta", "blue"); gs.board.placeCube("Atlanta", "blue");
  const turn2 = root.runBotTurn(0);
  const sig = (a) => a.actions.map(x => x.action + ":" + JSON.stringify(x.args)).join("|");
  check("bot.deterministic", sig(turn) === sig(turn2), JSON.stringify({ a: sig(turn), b: sig(turn2) }));
  gs.game.players[0].isBot = false;
  const nb = root.runBotTurn(0);
  check("bot.non-bot-rejected", nb.ok === false && String(nb.error).indexOf("not a bot") !== -1);
  gs.game.players[0].isBot = true;
  root.players.endTurn(P0b);
  const nc = root.botChooseAction(0);
  check("bot.no-candidates-when-not-acting", nc === null);
  root.setupGame({ numPlayers: 4, humanCount: 0, seed: 73, difficulty: 5 });
  const P0c = gs.game.players[0];
  root.players.startTurn(P0c);
  P0c.location = "Atlanta";
  P0c.hand = [{ id: "Tokyo", kind: "city", color: "red" }];
  for (const col of ["blue", "yellow", "black", "red"]) for (const c of root.world.cities) while (gs.board.cubeCount(c.name, col) > 0) gs.board.removeCube(c.name, col);
  for (let i = 1; i < gs.game.players.length; i++) {
    gs.game.players[i].hand = [];
    gs.game.players[i].location = "Sydney";
  }
  gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red");
  gs.board.placeCube("Osaka", "red"); gs.board.placeCube("Osaka", "red");
  const ch = root.botChooseAction(0);
  check("bot.moves-toward-hotspot", ch !== null && ch.action === "direct-flight" && ch.args.to === "Tokyo", JSON.stringify(ch));
  return { pass: results.every(r => r.pass), results };

botDifficultySelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  const sig = (x) => JSON.stringify(x);
  const setupWith = (seed, bd) => {
    root.setupGame({ numPlayers: 4, humanCount: 0, seed: seed, difficulty: 5, botDifficulty: bd });
    gs.board.placeCube("Atlanta", "blue"); gs.board.placeCube("Atlanta", "blue");
    return root.botChooseAction(0);
  };
  const E1 = setupWith(73, "easy");
  const E2 = setupWith(73, "easy");
  check("easy.deterministic", sig(E1) === sig(E2), sig(E1));
  const N = setupWith(73, "normal");
  check("normal.greedy-treat", N !== null && N.action === "treat-disease" && N.args.color === "blue", sig(N));
  check("easy.choice-is-legal", (() => {
    const legal = root.botCandidatesFor(0, "easy");
    return legal.some(c => c.action === E1.action && sig(c.args) === sig(E1.args));
  })(), sig(E1));
  let easyDiffers = false;
  for (const seed of [11, 22, 33, 44, 55, 66, 77, 88, 99, 111]) {
    const e = setupWith(seed, "easy");
    const n = setupWith(seed, "normal");
    if (sig(e) !== sig(n)) { easyDiffers = true; break; }
  }
  check("easy.varies-from-greedy", easyDiffers);
  const H1 = setupWith(73, "hard");
  const H2 = setupWith(73, "hard");
  check("hard.deterministic", sig(H1) === sig(H2), sig(H1));
  const freshState = () => {
    root.setupGame({ numPlayers: 4, humanCount: 0, seed: 73, difficulty: 5, botDifficulty: "normal" });
    const P = gs.game.players[0];
    root.players.startTurn(P);
    P.role = "scientist";
    P.hand = [{ id: "Atlanta", kind: "city", color: "blue" }, { id: "Chicago", kind: "city", color: "blue" }, { id: "Montreal", kind: "city", color: "blue" }];
    gs.game.players[1].role = "researcher";
    gs.game.players[1].hand = [{ id: "Washington", kind: "city", color: "blue" }];
    gs.game.players[1].location = "Atlanta";
    gs.game.players[2].location = "Sydney";
    gs.game.players[3].location = "Sydney";
    gs.board.placeCube("Atlanta", "blue");
    gs.board.placeCube("Atlanta", "blue");
  };
  freshState();
  const hChoose = root.botChooseAction(0, "hard");
  check("hard.cure-completing-share-beats-treat", hChoose !== null && hChoose.action === "share-knowledge" && (hChoose.args.cardId === "Atlanta" || hChoose.args.cardId === "Washington"), sig(hChoose));
  const hardCands = root.botCandidatesFor(0, "hard");
  const normCands = root.botCandidatesFor(0, "normal");
  const findTake = (arr) => arr.filter(c => c.action === "share-knowledge" && c.args.direction === "take" && c.args.cardId === "Washington")[0];
  const hTake = findTake(hardCands);
  const nTake = findTake(normCands);
  check("hard.cure-bonus-scoring", hTake && nTake && hTake.score === nTake.score + 100, JSON.stringify({ h: hTake && hTake.score, n: nTake && nTake.score }));
  freshState();
  const nChoose = root.botChooseAction(0, "normal");
  check("normal.prefers-cure-completing-share", nChoose !== null && nChoose.action === "share-knowledge" && nChoose.args.direction === "take" && nChoose.args.cardId === "Washington", sig(nChoose));
  check("normal.treat-here-is-candidate", (() => { const c = root.botCandidatesFor(0, "normal").filter(x => x.action === "treat-disease" && x.args.color === "blue")[0]; return !!c && c.score < nChoose.score; })(), sig(nChoose));
  root.setupGame({ numPlayers: 4, humanCount: 0, seed: 99, difficulty: 5, botDifficulty: "hard" });
  const HP = gs.game.players[0];
  root.players.startTurn(HP);
  HP.location = "Tokyo";
  HP.hand = [{ id: "Tokyo", kind: "city", color: "red" }];
  for (const col of ["blue", "yellow", "black", "red"]) for (const c of root.world.cities) while (gs.board.cubeCount(c.name, col) > 0) gs.board.removeCube(c.name, col);
  gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red"); gs.board.placeCube("Tokyo", "red");
  gs.board.placeCube("Osaka", "red"); gs.board.placeCube("Osaka", "red");
  for (let i = 1; i < 4; i++) { gs.game.players[i].location = "Sydney"; gs.game.players[i].hand = []; }
  gs.playerDeck = root.deckFactory.makeDeck([{ id: "A", kind: "city", color: "blue" }, { id: "B", kind: "city", color: "blue" }, { id: "C", kind: "city", color: "blue" }, { id: "D", kind: "city", color: "blue" }]);
  const candsLow = root.botCandidatesFor(0, "hard");
  const treatLow = candsLow.filter(c => c.action === "treat-disease" && c.args.color === "red");
  gs.playerDeck = root.deckFactory.makeDeck(root.world.cities.slice(0, 40).map(c => ({ id: c.name, kind: "city", color: c.color })));
  const candsHigh = root.botCandidatesFor(0, "hard");
  const treatHigh = candsHigh.filter(c => c.action === "treat-disease" && c.args.color === "red");
  check("hard.epidemic-pressure-boosts-treat", treatLow.length > 0 && treatHigh.length > 0 && treatLow[0].score > treatHigh[0].score, JSON.stringify({ low: treatLow[0] && treatLow[0].score, high: treatHigh[0] && treatHigh[0].score }));
  check("hard.stays-legal", (() => {
    const legal = root.botCandidatesFor(0, "hard");
    return legal.every(c => !gs.actions.get(c.action).legal({ gs, player: gs.game.players[0], playerIndex: 0, args: c.args }));
  })());
  return { pass: results.every(r => r.pass), results };

endGameSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const sig = (x) => JSON.stringify(x);
  const gs = root.gameState;
  root.setupGame({ numPlayers: 3, humanCount: 0, seed: 5, difficulty: 4 });
  const P0 = gs.game.players[0];
  root.players.startTurn(P0);
  P0.role = "scientist";
  const byCol = { blue: [], yellow: [], black: [], red: [] };
  for (const c of root.world.cities) byCol[c.color].push({ id: c.name, kind: "city", color: c.color });
  P0.hand = byCol.blue.slice(0, 5).concat(byCol.yellow.slice(0, 5), byCol.black.slice(0, 5), byCol.red.slice(0, 5));
  root.diseases.setCured("blue", true);
  root.diseases.setCured("yellow", true);
  root.diseases.setCured("black", true);
  check("victory.not-yet-3-cured", gs.game.result === null && root.checkEndCondition() === null);
  const r = gs.actions.doAction("discover-cure", { color: "red" }, 0);
  check("victory.cure-applied", r.ok === true && r.result.color === "red" && r.result.discarded === 4, sig(r.result));
  check("victory.result-won", !!gs.game.result && gs.game.result.outcome === "won" && gs.game.result.cause === "all four diseases cured", sig(gs.game.result));
  check("victory.summary-shape", !!gs.game.result.summary && gs.game.result.summary.cures === 4 && typeof gs.game.result.summary.turns === "number" && typeof gs.game.result.summary.outbreaks === "number" && typeof gs.game.result.summary.eradicated === "number" && typeof gs.game.result.summary.infectionRate === "number", sig(gs.game.result.summary));
  check("victory.turn-tagged", gs.game.result.turn === gs.game.turnIndex);
  check("victory.logged", gs.game.log.some(e => e.action === "victory"));
  const r2 = root.completeTurn();
  check("victory.completeTurn-stops", r2.alreadyEnded === true && gs.game.result.outcome === "won", sig(r2));
  root.checkEndCondition();
  check("victory.sticky", gs.game.result.outcome === "won");
  root.setupGame({ numPlayers: 3, humanCount: 0, seed: 8, difficulty: 4 });
  const board = gs.board;
  for (let i = 0; i < 7; i++) board.incrementOutbreaks();
  root.resolveOutbreak("Milan", "blue");
  check("defeat.8-outbreaks", !!gs.game.result && gs.game.result.outcome === "lost" && gs.game.result.cause === "8 outbreaks", sig(gs.game.result));
  check("defeat.8-outbreaks-count", board.getOutbreaks() === 8);
  root.setupGame({ numPlayers: 3, humanCount: 0, seed: 8, difficulty: 4 });
  root.diseases.setSupply("yellow", 0);
  root.infect({ id: "Lagos", kind: "infection", color: "yellow" }, 1);
  check("defeat.supply-exhausted", !!gs.game.result && gs.game.result.outcome === "lost" && gs.game.result.cause === "disease cube supply exhausted", sig(gs.game.result));
  root.setupGame({ numPlayers: 3, humanCount: 0, seed: 8, difficulty: 4 });
  const P = gs.game.players[0];
  P.hand = [];
  gs.playerDeck = root.deckFactory.makeDeck([{ id: "Atlanta", kind: "city", color: "blue" }]);
  const dp = root.drawPhase(P);
  check("defeat.fewer-than-2", dp.lost === true && !!gs.game.result && gs.game.result.outcome === "lost" && String(gs.game.result.cause).indexOf("fewer than 2") !== -1, sig(gs.game.result));
  root.setupGame({ numPlayers: 3, humanCount: 0, seed: 8, difficulty: 4 });
  root.diseases.setSupply("black", 0);
  root.infect({ id: "Cairo", kind: "infection", color: "black" }, 1);
  const ct = root.completeTurn();
  check("defeat.completeTurn-stops", ct.alreadyEnded === true && gs.game.result.outcome === "lost", sig(ct));
  check("defeat.logged", gs.game.log.some(e => e.action === "defeat"));
  return { pass: results.every(r => r.pass), results };

drawPhaseSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const gs = root.gameState;
  root.setupGame({ numPlayers: 2, humanCount: 1, seed: 21, difficulty: 5 });
  const P0 = gs.game.players[0];
  P0.hand = [];
  const deck0 = gs.playerDeck.size();
  const d1 = root.drawPhase(P0);
  check("draw.takes-two-into-hand", d1.ok === true && d1.drawn.length === 2 && P0.hand.length === 2 && gs.playerDeck.size() === deck0 - 2 && gs.game.log[gs.game.log.length - 1].action === "draw", JSON.stringify(d1));
  const d2 = root.drawPhase(P0);
  check("draw.repeats", d2.ok === true && d2.drawn.length === 2 && P0.hand.length === 4);
  P0.hand.push({ id: "C", kind: "city", color: "blue" }, { id: "D", kind: "city", color: "blue" });
  const d3 = root.drawPhase(P0);
  check("draw.overlimit-flag", d3.overLimit === true && P0.hand.length === 8, JSON.stringify(d3));
  const disc = root.discardToHandLimit(P0, ["D", "C"]);
  check("hand.discard-to-7", disc.ok === true && disc.handSize === 6 && gs.playerDiscard.size() === 2 && P0.hand.length === 6);
  check("hand.discard-pushes-to-discard", gs.playerDiscard.cards.map(c => c.id).join(",") === "D,C");
  const P1 = gs.game.players[1];
  P1.hand = [];
  const oldRate = gs.board.getInfectionRate();
  const oldRatePos = gs.board.getRatePos();
  gs.playerDeck = root.deckFactory.makeDeck([{ id: "Atlanta", kind: "city", color: "blue" }, { id: "Epidemic", kind: "epidemic", color: null }]);
  const infSizeBefore = gs.infectionDeck.size();
  const infDiscardBefore = gs.infectionDiscard.size();
  const d4 = root.drawPhase(P1);
  check("draw.epidemic-interrupt", d4.ok === true && d4.epidemics.length === 1 && d4.drawn.length === 1 && P1.hand.length === 1 && gs.board.getRatePos() === Math.min(oldRatePos + 1, 6) && gs.board.getInfectionRate() >= oldRate && gs.board.getInfectionRate() <= 4 && gs.playerDiscard.cards.some(c => c.id === "Epidemic"), JSON.stringify(d4));
  check("draw.epidemic-intensify", gs.infectionDeck.size() === infSizeBefore + infDiscardBefore && gs.infectionDiscard.size() === 0, JSON.stringify({ deck: gs.infectionDeck.size(), discard: gs.infectionDiscard.size() }));
  gs.game.result = null;
  gs.playerDeck = root.deckFactory.makeDeck([{ id: "London", kind: "city", color: "blue" }]);
  const d5 = root.drawPhase(P0);
  check("draw.fewer-than-2-lose", d5.lost === true && gs.game.result && gs.game.result.outcome === "lost" && String(gs.game.result.cause).indexOf("fewer than 2") !== -1, JSON.stringify(d5));
  gs.game.result = null;
  return { pass: results.every(r => r.pass), results };

turnSequenceSelfTest() =>
  const results = [];
  const check = (name, pass, detail) => results.push({ name, pass, detail });
  const sig = (x) => JSON.stringify(x);
  const run = (seed) => {
    const gs = root.gameState;
    root.setupGame({ numPlayers: 4, humanCount: 0, seed: seed, difficulty: 5 });
    const TURNS = 6;
    const events = [];
    for (let t = 0; t < TURNS; t++) {
      const idx = gs.game.currentPlayerIndex;
      const P = gs.game.players[idx];
      events.push("t" + t + ":p" + idx);
      const bot = root.runBotTurn(idx);
      if (bot.ok && bot.actions.length) events.push("bot[" + bot.actions.map(a => a.action + ":" + JSON.stringify(a.args)).join(",") + "]");
      const done = root.completeTurn();
      for (let i = 0; i < gs.game.players.length; i++) {
        const p = gs.game.players[i];
        if (p.hand.length > 7) {
          if (root.botDiscardExcess) root.botDiscardExcess(p);
          events.push("discard:" + i + ":" + p.hand.map(c => c.id).join(","));
        }
      }
      events.push("draw[" + (done.draw.drawn ? done.draw.drawn.join(",") : "none") + "]");
      if (done.draw.epidemics && done.draw.epidemics.length) events.push("EPIDEMIC:" + done.draw.epidemics.join(","));
      events.push("inf[" + (done.infection ? done.infection.results.map(x => x.cardId + ":" + x.infect.cubesPlaced).join(",") : "none") + "]");
      if (done.lost) { events.push("LOST:" + done.cause); break; }
      events.push("next:" + done.nextPlayer);
    }
    return {
      events: events.join("|"),
      lost: !!gs.game.result,
      turnIndex: gs.game.turnIndex,
      currentPlayerIndex: gs.game.currentPlayerIndex,
      deckSize: gs.playerDeck.size(),
      outbreaks: gs.board.getOutbreaks(),
      rate: gs.board.getInfectionRate(),
      handSizes: gs.game.players.map(p => p.hand.length).join(","),
      logLen: gs.game.log.length
    };
  };
  const A = run(777);
  const B = run(777);
  check("seq.deterministic-same-seed", sig(A) === sig(B));
  const C = run(999);
  check("seq.different-seed-differs", sig(A) !== sig(C));
  check("seq.turn-advancement", A.lost ? A.turnIndex < 6 : (A.turnIndex === 6 && A.currentPlayerIndex === 2), JSON.stringify({ ti: A.turnIndex, ci: A.currentPlayerIndex, lost: A.lost }));
  check("seq.deck-shrinks", A.deckSize === 50 - 2 * A.turnIndex - (A.lost ? 2 : 0), "deck " + A.deckSize + " ti " + A.turnIndex);
  check("seq.hands-under-limit", A.handSizes.split(",").every(n => Number(n) <= 7), A.handSizes);
  check("seq.draw-and-infect-phases-logged", A.events.indexOf("draw[") !== -1 && A.events.indexOf("inf[") !== -1 && A.logLen >= 6, A.events.slice(0, 160));
  return { pass: results.every(r => r.pass), results };

// ─────────────────────────────────────────────
//  BOT ACTION ENGINE (tasks 40–41). A deterministic heuristic controller:
//  enumerate candidate actions for the acting player, score them, take
//  the best, and repeat until the turn's actions are spent (or no legal
//  action remains). No Math.random anywhere: identical game states
//  always produce identical moves.
//  Difficulty presets (per-seat; setupGame stores player.botDifficulty):
//   - easy:   mostly random legal actions (seeded from setup.seed, so
//             still fully deterministic for a given game).
//   - normal: the greedy heuristic — treat the hottest cube stacks
//             first, discover a cure when the hand allows it, then move
//             toward the hottest city, build stations in high-value
//             cure cities, and consolidate cure-colored cards with
//             co-located players.
//   - hard:   normal PLUS a re-ordered priority — completing a cure
//             beats everything (bonus on discover-cure and on the
//             share-knowledge that fills the last card), and as the
//             player deck thins toward the next epidemic it pre-positions
//             for the known timing by over-prioritizing 3-cube hotspots
//             (treat and movement toward them) so an imminent epidemic
//             can't chain.
// ─────────────────────────────────────────────
botDiscardExcess(player) =>
  const gs = root.__initGameState();
  if (!player) return { ok: false, error: "no player" };
  const over = player.hand.length - 7;
  if (over <= 0) return { ok: true, discarded: 0 };
  const need = player.role === "scientist" ? 4 : 5;
  const byCol = {};
  for (const c of player.hand) if (c.kind === "city") byCol[c.color] = (byCol[c.color] || 0) + 1;
  let target = player.botTarget && !gs.diseases.isCured(player.botTarget) ? player.botTarget : null;
  let best = 0;
  if (!target) {
    for (const col of ["blue", "yellow", "black", "red"]) {
      if ((byCol[col] || 0) > best && !gs.diseases.isCured(col)) { best = byCol[col]; target = col; }
    }
  }
  // Order cards so the ones least useful to a cure get discarded first:
  // events last, then the target color's cards, then low-progress colors.
  const order = player.hand.slice().sort((a, b) => {
    if (a.kind !== "city" && b.kind !== "city") return 0;
    if (a.kind !== "city") return 1;
    if (b.kind !== "city") return -1;
    const cured = (col) => gs.diseases.isCured(col);
    if (cured(a.color) && !cured(b.color)) return -1;
    if (cured(b.color) && !cured(a.color)) return 1;
    if (a.color === target) return 1;
    if (b.color === target) return -1;
    return (byCol[a.color] || 0) - (byCol[b.color] || 0);
  });
  const disc = [];
  for (let i = 0; i < over && i < order.length; i++) disc.push(order[i]);
  for (const c of disc) {
    const i = player.hand.indexOf(c);
    if (i >= 0) player.hand.splice(i, 1);
  }
  return { ok: true, discarded: disc.length };

botCandidatesFor(playerIndex, difficulty) =>
  const gs = root.__initGameState();
  if (!gs.game) return [];
  const idx = playerIndex === undefined ? gs.game.currentPlayerIndex : playerIndex;
  const player = gs.game.players[idx];
  if (!player) return [];
  const diff = difficulty || player.botDifficulty || "normal";
  const cands = [];
  const push = (action, args, score) => cands.push({ action: action, args: args, score: score });
  const COLORS = ["blue", "yellow", "black", "red"];
  const cubeTotal = (city) => {
    let t = 0;
    for (const col of COLORS) t += gs.board.cubeCount(city, col);
    return t;
  };
  const dist = (from, to) => {
    if (from === to) return 0;
    let visited = [from];
    let frontier = [from];
    let d = 0;
    while (frontier.length > 0) {
      d++;
      const next = [];
      for (const c of frontier) {
        for (const l of root.world.byName(c).links) {
          if (l === to) return d;
          if (!visited.includes(l)) { visited.push(l); next.push(l); }
        }
      }
      frontier = next;
    }
    return 99;
  };
  let hotCity = null;
  let hotCubes = -1;
  for (const c of root.world.cities) {
    const t = cubeTotal(c.name);
    if (t > hotCubes) { hotCubes = t; hotCity = c.name; }
  }
  const at = player.location;
  const need = player.role === "scientist" ? 4 : 5;
  const handByColor = {};
  for (const col of COLORS) handByColor[col] = 0;
  for (const c of player.hand) if (c.kind === "city") handByColor[c.color] = (handByColor[c.color] || 0) + 1;
  const teamColor = (col) => {
    let n = handByColor[col] || 0;
    for (const pl of gs.game.players) if (pl !== player) for (const c of pl.hand) if (c.kind === "city" && c.color === col) n++;
    return n;
  };
  for (const col of COLORS) {
    const n = gs.board.cubeCount(at, col);
    if (n > 0) push("treat-disease", { color: col }, 100 + n * n * 14 + (n >= 3 ? 110 : n === 2 ? 25 : 0) + (root.diseases.isCured(col) ? 20 : 0) + (root.diseases[col].cubeSupply <= 6 ? 20 : 0));
  }
  for (const col of COLORS) {
    let count = 0;
    for (const c of player.hand) if (c.kind === "city" && c.color === col) count++;
    if (count >= need && gs.board.hasStation(at)) push("discover-cure", { color: col }, 500 + count * 5);
  }
  // Team cure plan: pick the color this player can help finish soonest and,
  // when the team is close, converge on the nearest research station (building
  // one when none is reachable) or meet a teammate to share toward the cure.
  // Bots hold a persistent botTarget lane from setup so the team covers all
  // four colors; the tier gate keeps idle bots off the lane. This is what
  // makes co-op cures happen.
  const botTarget = player.botTarget && !root.diseases.isCured(player.botTarget) ? player.botTarget : null;
  let planCol = botTarget, planScore = -1;
  if (!botTarget) {
    for (const col of COLORS) {
      if (root.diseases.isCured(col)) continue;
      const sc = (handByColor[col] || 0) * 2 + teamColor(col);
      if (sc > planScore) { planScore = sc; planCol = col; }
    }
  }
  if (planCol) {
    const planGap = need - teamColor(planCol);
    const myCol = handByColor[planCol] || 0;
    if (planGap <= 2 && (planGap <= 1 || myCol >= 1)) {
      const tier = planGap <= 1 ? 0 : 35;
      const anyStations = gs.board.stationList();
      for (const s of anyStations) {
        if (s === at) {
          if (myCol >= need) push("discover-cure", { color: planCol }, 800 + myCol * 5);
        } else {
          push("drive", { to: s }, 205 - tier - dist(at, s) * 6);
          const heldDest = root.findCardInHand(player, s);
          if (heldDest && heldDest.kind === "city") push("direct-flight", { to: s }, 220 - tier - dist(at, s) * 3);
          const heldAtC = root.findCardInHand(player, at);
          if (heldAtC && heldAtC.kind === "city") push("charter-flight", { to: s }, 210 - tier - dist(at, s) * 3);
          if (gs.board.hasStation(at)) push("shuttle-flight", { to: s }, 205 - tier - dist(at, s) * 3);
        }
      }
      const heldAtC2 = root.findCardInHand(player, at);
      if (heldAtC2 && heldAtC2.kind === "city" && !gs.board.hasStation(at) && (heldAtC2.color !== planCol || myCol < need)) {
        push("build-station", {}, 190 - tier);
      }
      for (let i = 0; i < gs.game.players.length; i++) {
        const pl = gs.game.players[i];
        if (pl === player || pl.location === at) continue;
        let mine = 0, theirs = 0;
        for (const c of player.hand) if (c.kind === "city" && c.color === planCol) mine++;
        for (const c of pl.hand) if (c.kind === "city" && c.color === planCol) theirs++;
        if (mine >= 1 && theirs >= 1 && mine + theirs >= need - Math.max(1, planGap)) {
          push("drive", { to: pl.location }, 165 - tier - dist(at, pl.location) * 5);
          const heldDest = root.findCardInHand(player, pl.location);
          if (heldDest && heldDest.kind === "city") push("direct-flight", { to: pl.location }, 180 - tier - dist(at, pl.location) * 3);
          const heldAtC = root.findCardInHand(player, at);
          if (heldAtC && heldAtC.kind === "city") push("charter-flight", { to: pl.location }, 170 - tier - dist(at, pl.location) * 3);
          if (gs.board.hasStation(at)) push("shuttle-flight", { to: pl.location }, 165 - tier - dist(at, pl.location) * 3);
          // Sharing is only legal at a city whose card the giver holds (or a
          // researcher's city), so a plain meet-up at pl's city may be
          // useless. Also propose the nearest planCol city where a trade can
          // actually happen — both bots pick the same spot on their turns.
          let bestX = null, bestD = 1e9;
          for (const city of root.world.cities) {
            if (city.name === at || city.name === pl.location) continue;
            const shareable = root.findCardInHand(player, city.name) || root.findCardInHand(pl, city.name);
            if (!shareable) continue;
            if (city.color !== planCol && player.role !== "researcher" && pl.role !== "researcher") continue;
            const d = dist(at, city.name) + dist(pl.location, city.name);
            if (d < bestD) { bestD = d; bestX = city.name; }
          }
          if (bestX) {
            push("drive", { to: bestX }, 230 - tier - dist(at, bestX) * 4);
            const heldDest = root.findCardInHand(player, bestX);
            if (heldDest && heldDest.kind === "city") push("direct-flight", { to: bestX }, 235 - tier - dist(at, bestX) * 3);
            const heldAtC = root.findCardInHand(player, at);
            if (heldAtC && heldAtC.kind === "city") push("charter-flight", { to: bestX }, 225 - tier - dist(at, bestX) * 3);
            if (gs.board.hasStation(at)) push("shuttle-flight", { to: bestX }, 220 - tier - dist(at, bestX) * 3);
          }
        }
      }
    }
  }
  // Cure-oriented planning: worth(city) = how valuable it is to be there
  // (cubes, teammates to share with, a station near a cure); shareValue
  // (city) = how much a trade there advances a cure. Cards are hoarded
  // toward cures, so flights are only spent on cities that clear the bar.
  const worth = (city) => {
    let w = cubeTotal(city) * 2 + (city === hotCity ? 12 : 0);
    for (const pl of gs.game.players) if (pl !== player && pl.location === city) w += 10;
    const cw = root.world.byName(city);
    const col = cw ? cw.color : null;
    if (col && gs.board.hasStation(city) && !root.diseases.isCured(col) && teamColor(col) >= need - 1) w += 40;
    if (col && root.diseases.isCured(col)) w -= 6;
    return w;
  };
  const shareValue = (city) => {
    let v = 0;
    for (const pl of gs.game.players) {
      if (pl === player || pl.location !== city) continue;
      for (const col of COLORS) {
        if (root.diseases.isCured(col)) continue;
        let mine = 0, theirs = 0;
        for (const c of player.hand) if (c.kind === "city" && c.color === col) mine++;
        for (const c of pl.hand) if (c.kind === "city" && c.color === col) theirs++;
        if (mine >= 1 && theirs >= 1 && mine + theirs >= need) v += 34;
        else if (mine >= 1 && theirs >= 1 && mine + theirs >= need - 1) v += 12;
      }
    }
    return v;
  };
  const heldCity = root.findCardInHand(player, at);
  if (heldCity && heldCity.kind === "city" && !gs.board.hasStation(at)) {
    const col = heldCity.color;
    const tc = teamColor(col);
    if (player.role === "operations-expert") push("build-station", {}, 130 + tc * 5);
    else if (tc >= need - 1 && (handByColor[col] || 0) >= 1) push("build-station", {}, 115 + tc * 8 + (tc >= need ? 60 : 20));
  }
  // Station-for-cure: if this player is one card from a cure and no station
  // is at hand, build one — at the current city when possible, otherwise
  // travel to a city whose card we hold and build there. Without stations,
  // card-rich hands strand and cures never happen.
  for (const col of COLORS) {
    if (root.diseases.isCured(col)) continue;
    const mine = handByColor[col] || 0;
    if (mine < need - 1 || teamColor(col) < need) continue;
    const hc = root.findCardInHand(player, at);
    const canBuildHere = hc && hc.kind === "city" && (player.role === "operations-expert" || hc.color === col);
    if (canBuildHere) {
      if (!gs.board.hasStation(at)) push("build-station", {}, 250);
    } else {
      for (const c of player.hand) {
        if (c.kind !== "city" || c.id === at) continue;
        if (c.color !== col && player.role !== "operations-expert") continue;
        if (dist(at, c.id) <= 2) push("drive", { to: c.id }, 205 - dist(at, c.id) * 8);
        if (gs.board.hasStation(at)) push("shuttle-flight", { to: c.id }, 195 - dist(at, c.id) * 4);
        const td = root.findCardInHand(player, c.id);
        if (td && td.kind === "city") push("direct-flight", { to: c.id }, 215 - dist(at, c.id) * 4);
      }
    }
  }
  for (const link of root.world.byName(at).links) {
    push("drive", { to: link }, 42 - dist(link, hotCity) * 5 + (link === hotCity ? 15 : 0) + cubeTotal(link) * 2 + shareValue(link));
  }
  for (const c of player.hand) {
    if (c.kind !== "city" || c.id === at) continue;
    const w = worth(c.id) + shareValue(c.id);
    if (w >= 26) push("direct-flight", { to: c.id }, 58 + w - dist(c.id, hotCity) * 3);
  }
  if (heldCity && heldCity.kind === "city") {
    for (const c of root.world.cities) {
      const w = worth(c.name) + shareValue(c.name);
      if (w >= 26 && c.name !== at) push("charter-flight", { to: c.name }, 58 + w - dist(c.name, hotCity) * 3);
    }
  }
  const stationList = gs.board.stationList();
  for (const s of stationList) if (s !== at) push("shuttle-flight", { to: s }, 50 - dist(s, hotCity) * 5 + (s === hotCity ? 15 : 0) + cubeTotal(s) * 2 + shareValue(s));
  // Infection control: move toward heavily loaded cities (3+ cubes of a
  // color, or 3+ total) so someone is on-site to treat before outbreaks
  // chain. Scores sit below urgent treats and cure-convergence but well above
  // idle drives, so bots rotate toward hotspots when nothing urgent is up.
  const hotZones = [];
  for (const c of root.world.cities) {
    let worst = 0;
    for (const col of COLORS) worst = Math.max(worst, gs.board.cubeCount(c.name, col));
    if (worst >= 3) hotZones.push({ name: c.name, worst: worst, tot: cubeTotal(c.name) });
  }
  hotZones.sort((a, b) => (b.worst * 10 + b.tot) - (a.worst * 10 + a.tot));
  const hotSeen = {};
  for (const hz of hotZones) {
    if (hz.name === at || hotSeen[hz.name]) continue;
    hotSeen[hz.name] = 1;
    const d = dist(at, hz.name);
    if (d <= 3) {
      for (const link of root.world.byName(at).links) {
        if (dist(link, hz.name) < d) push("drive", { to: link }, 90 + hz.worst * 12 + (d === 1 ? 25 : d === 2 ? 8 : 0) - dist(link, hz.name) * 8);
      }
    }
    const heldDest = root.findCardInHand(player, hz.name);
    if (heldDest && heldDest.kind === "city") push("direct-flight", { to: hz.name }, 120 + hz.worst * 16 - d * 3);
    const heldAtC = root.findCardInHand(player, at);
    if (heldAtC && heldAtC.kind === "city") push("charter-flight", { to: hz.name }, 110 + hz.worst * 16 - d * 3);
    if (gs.board.hasStation(at)) {
      for (const s of gs.board.stationList()) if (s !== at && dist(s, hz.name) < d) push("shuttle-flight", { to: s }, 105 + hz.worst * 12 - dist(s, hz.name) * 6);
    }
  }
  if (gs.board.hasStation(at)) {
    const hw = worth(hotCity) + shareValue(hotCity);
    if (hw >= 14) {
      for (const c of player.hand) if (c.kind === "city") push("operations-expert-flight", { cardId: c.id, to: hotCity }, 58 + hw);
    }
  }
  for (let i = 0; i < gs.game.players.length; i++) {
    const other = gs.game.players[i];
    if (other === player || other.location !== at) continue;
    for (const c of player.hand) {
      if (c.kind !== "city") continue;
      if (player.role !== "researcher" && c.id !== at) continue;
      let mine = 0;
      let theirs = 0;
      for (const h of player.hand) if (h.kind === "city" && h.color === c.color) mine++;
      for (const h of other.hand) if (h.kind === "city" && h.color === c.color) theirs++;
      push("share-knowledge", { playerIndex: i, direction: "give", cardId: c.id }, 70 + (mine + theirs) * 5 + (theirs + 1 >= need ? 110 : 0) + (theirs + 1 >= need - 1 ? 30 : 0));
    }
    for (const c of other.hand) {
      if (c.kind !== "city") continue;
      if (other.role !== "researcher" && c.id !== at) continue;
      let mine = 0;
      let theirs = 0;
      for (const h of player.hand) if (h.kind === "city" && h.color === c.color) mine++;
      for (const h of other.hand) if (h.kind === "city" && h.color === c.color) theirs++;
      push("share-knowledge", { playerIndex: i, direction: "take", cardId: c.id }, 70 + (mine + theirs) * 5 + (mine + 1 >= need ? 110 : 0) + (mine + 1 >= need - 1 ? 30 : 0));
    }
  }
  if (player.role === "dispatcher") {
    for (let i = 0; i < gs.game.players.length; i++) {
      const pawn = gs.game.players[i];
      if (pawn === player) continue;
      for (const c of root.world.cities) {
        if (c.name === pawn.location) continue;
        let present = false;
        for (const p of gs.game.players) if (p !== pawn && p.location === c.name) { present = true; break; }
        if (present) push("dispatcher-relocate", { pawnIndex: i, to: c.name }, 30 + cubeTotal(c.name) * 4);
      }
    }
  }
  if (player.role === "contingency-planner") {
    for (const c of gs.playerDiscard.cards) if (c.kind === "event") push("contingency-planner-collect", { cardId: c.id }, 8);
  }
  const fw = gs.actions;
  const legal = [];
  for (const c of cands) {
    const reason = fw.get(c.action).legal({ gs: gs, player: player, playerIndex: idx, args: c.args });
    if (!reason) legal.push(c);
  }
  if (diff === "easy") {
    const used = 4 - player.actions;
    const rng = root.deckFactory.mulberry32((((gs.setup && gs.setup.seed ? gs.setup.seed : 1) * 1000 + idx * 100 + (gs.game.turnIndex || 0) * 10 + used + ((gs.game.log.length || 0) % 7)) >>> 0));
    for (const c of legal) c.score = rng() < 0.3 ? c.score : rng();
    return legal;
  }
  if (diff === "hard") {
    const remaining = Math.max(1, (gs.setup && gs.setup.difficulty ? gs.setup.difficulty : 5) - (gs.game.epidemicsResolved || 0));
    const deckSize = gs.playerDeck ? gs.playerDeck.size() : 99;
    const perEpi = Math.max(2, deckSize / remaining);
    const press = perEpi < 9 ? (9 - perEpi) * 2 : 0;
    const need = player.role === "scientist" ? 4 : 5;
    const colorCount = (p, col) => { let n = 0; for (const c of p.hand) if (c.kind === "city" && c.color === col) n++; return n; };
    for (const c of legal) {
      if (c.action === "discover-cure") {
        c.score += 250;
      } else if (c.action === "share-knowledge") {
        const dir = c.args.direction;
        const giver = dir === "give" ? player : gs.game.players[c.args.playerIndex];
        const taker = dir === "give" ? gs.game.players[c.args.playerIndex] : player;
        const card = root.findCardInHand(giver, c.args.cardId);
        if (card) {
          const total = colorCount(giver, card.color) + colorCount(taker, card.color);
          if (total >= need) c.score += 100;
          else if (total >= need - 1) c.score += 40;
        }
      } else if (c.action === "treat-disease") {
        const n = gs.board.cubeCount(player.location, c.args.color);
        if (n >= 3) c.score += press * 6;
        else if (n === 2) c.score += press * 3;
      } else if (c.action === "drive" || c.action === "direct-flight" || c.action === "charter-flight" || c.action === "shuttle-flight") {
        const to = c.args.to;
        for (const col of COLORS) {
          const n = gs.board.cubeCount(to, col);
          if (n >= 3 && !root.diseases.isEradicated(col)) { c.score += press * 8; break; }
        }
      }
    }
    return legal;
  }
  return legal;

botChooseAction(playerIndex, difficulty) =>
  const gs = root.__initGameState();
  if (!gs.game) return null;
  const idx = playerIndex === undefined ? gs.game.currentPlayerIndex : playerIndex;
  const player = gs.game.players[idx];
  if (!player || player.actions <= 0 || !player.isTurn || gs.game.result) return null;
  const cands = root.botCandidatesFor(idx, difficulty || player.botDifficulty);
  if (cands.length === 0) return null;
  let best = cands[0];
  for (let i = 1; i < cands.length; i++) if (cands[i].score > best.score) best = cands[i];
  if (best.score < 10) return null;   // nothing worth spending an action on — pass to draw faster
  return { action: best.action, args: best.args, score: best.score };

maybePlayBotEvents(playerIndex) =>
  const gs = root.__initGameState();
  if (!gs.game || gs.game.result) return;
  const player = gs.game.players[playerIndex];
  if (!player || !player.isBot) return;
  const events = player.hand.filter(c => c.kind === "event");
  if (!events.length) return;
  const COLS = ["blue", "yellow", "black", "red"];
  const cubeTotalAt = (city) => { let t = 0; for (const col of COLS) t += gs.board.cubeCount(city, col); return t; };
  const need = player.role === "scientist" ? 4 : 5;
  const dist = (from, to) => {
    if (from === to) return 0;
    let visited = [from], frontier = [from], d = 0;
    while (frontier.length > 0) {
      d++;
      const next = [];
      for (const c of frontier) {
        for (const l of root.world.byName(c).links) {
          if (l === to) return d;
          if (!visited.includes(l)) { visited.push(l); next.push(l); }
        }
      }
      frontier = next;
    }
    return 99;
  };
  for (const ev of events) {
    if (ev.id === "One Quiet Night") {
      let risk = 0, any3 = false;
      for (const c of root.world.cities) {
        const t = cubeTotalAt(c.name);
        if (t >= 3) { any3 = true; risk += 3; } else if (t === 2) risk += 1;
      }
      if (any3 || risk >= 8) root.playEvent({ playerIndex: playerIndex, cardId: "One Quiet Night" });
    } else if (ev.id === "Government Grant") {
      const city = root.world.byName(player.location);
      const col = city ? city.color : null;
      let mine = 0;
      for (const c of player.hand) if (c.kind === "city" && c.color === col) mine++;
      if (col && !gs.board.hasStation(player.location) && mine >= need - 1) {
        root.playEvent({ playerIndex: playerIndex, cardId: "Government Grant", args: { to: player.location } });
      } else if (col && gs.board.stationCount() === 0 && mine >= 2) {
        root.playEvent({ playerIndex: playerIndex, cardId: "Government Grant", args: { to: player.location } });
      }
    } else if (ev.id === "Airlift") {
      let bestP = null, bestN = need - 1;
      for (const pl of gs.game.players) {
        if (gs.board.hasStation(pl.location)) continue;
        const cnt = {};
        for (const c of pl.hand) if (c.kind === "city") cnt[c.color] = (cnt[c.color] || 0) + 1;
        let n = 0;
        for (const col of COLS) n = Math.max(n, cnt[col] || 0);
        if (n >= bestN) { bestN = n; bestP = pl; }
      }
      if (bestP) {
        let sBest = null, sD = 1e9;
        for (const s of gs.board.stationList()) {
          if (s === bestP.location) continue;
          const d = dist(bestP.location, s);
          if (d < sD) { sD = d; sBest = s; }
        }
        if (sBest) root.playEvent({ playerIndex: playerIndex, cardId: "Airlift", args: { pawnIndex: gs.game.players.indexOf(bestP), to: sBest } });
      }
    } else if (ev.id === "Resilient Population") {
      const top = gs.infectionDiscard.top();
      if (top && top.kind === "city" && cubeTotalAt(top.id) >= 2) {
        root.playEvent({ playerIndex: playerIndex, cardId: "Resilient Population", args: { discardCardId: top.id } });
      }
    } else if (ev.id === "Forecast") {
      const top6 = gs.infectionDeck.cards.slice(0, 6);
      if (top6.length === 6 && top6.some(c => c.kind === "city" && cubeTotalAt(c.id) >= 3)) {
        const order = top6.slice().sort((a, b) => {
          const danger = (c) => c.kind !== "city" ? 0 : cubeTotalAt(c.id) >= 3 ? 2 : cubeTotalAt(c.id) === 2 ? 1 : 0;
          return danger(a) - danger(b);
        });
        root.playEvent({ playerIndex: playerIndex, cardId: "Forecast", args: { order: order.map(c => c.id) } });
      }
    }
  }

runBotTurn(playerIndex) =>
  const gs = root.__initGameState();
  const idx = playerIndex === undefined ? gs.game.currentPlayerIndex : playerIndex;
  const player = gs.game.players[idx];
  if (!player) return { ok: false, error: "no player at index " + idx };
  if (!player.isBot) return { ok: false, error: player.name + " is not a bot" };
  root.maybePlayBotEvents(idx);
  const executed = [];
  let guard = 0;
  while (player.actions > 0 && player.isTurn && guard++ < 8) {
    if (gs.game.result) break;
    const choice = root.botChooseAction(idx);
    if (!choice) break;
    const needHere = player.role === "scientist" ? 4 : 5;
    const cnt = {};
    for (const c of player.hand) if (c.kind === "city") cnt[c.color] = (cnt[c.color] || 0) + 1;
    const nearCure = Object.keys(cnt).some(col => !gs.diseases.isCured(col) && cnt[col] >= needHere - 1);
    if (nearCure && gs.board.hasStation(player.location) && ["drive", "direct-flight", "charter-flight", "shuttle-flight", "operations-expert-flight"].includes(choice.action) && choice.args.to !== player.location) {
      break;  // cure-ready at a station: hold position and wait for the last card
    }
    const r = gs.actions.doAction(choice.action, choice.args, idx);
    if (!r.ok) break;
    executed.push({ action: choice.action, args: choice.args, result: r.result });
  }
  return { ok: true, player: idx, playerName: player.name, actions: executed, actionsLeft: player.actions };

// Playing table backgrounds — select with [tableGraphics.selectOne], or access by id (root.tableGraphics.slate.url)
tableGraphics
  slate
    name = Slate
    url = https://user.uploads.dev/file/1c3362ef12b434367c151198fb9ba97c.jpg
  forge
    name = Forge
    url = https://user.uploads.dev/file/5756a746265c584ac77a701221aff3d7.jpg
  ember
    name = Ember
    url = https://user.uploads.dev/file/39143b5b1c649c5c07a5a54bccb9d09f.jpg

createServerSocket = {import:server-plugin}
kv = {import:kv-plugin}
