// ─────────────────────────────────────────────────────────────
//  BGN SPLENDOR — main.pjs
//  Page config + plugin imports. The game (Splendor: tokens,
//  cards, nobles) lives in index.html; this file drives the
//  BGN frame — title, tagline, accent color, hero, hub link.
// ─────────────────────────────────────────────────────────────

$meta
  title = Splendor
  description = The classic gem-trading game of merchants and nobles — local pass-and-play for up to 4 players (with optional AI) or a 2-player online match over the Boardgame Network. Collect tokens, buy development cards, attract nobles, and be the first to 15 prestige.
  tags = board game, strategy, gems, nobles, merchants, multiplayer, online, two player, local
  image = https://user.uploads.dev/file/c36a4ac2b19a7a022fe680cf1e17800d.jpg

hubUrl = https://perchance.org/bgn-boardgame-network  // ← SET THIS to your Boardgame Network hub's URL
gameTitle = Splendor
gameTagline = Trade gems. Court nobles. Be first to 15 prestige.
gameKicker = Host · Join · Play
gameGenre = Strategy
gamePlayers = 2–4 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/c36a4ac2b19a7a022fe680cf1e17800d.jpg

createServerSocket = {import:server-plugin}
commentsPlugin = {import:comments-plugin}
