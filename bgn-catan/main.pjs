// ─────────────────────────────────────────────────────────────
//  SETTLERS OF CATAN (4-player) — main.pjs
//  The classic trading & building board game for four, built on
//  the BGN table template: rooms, turn order, presence, chat,
//  saves, sounds, leaderboard. The game engine lives in src/catan.js.
// ─────────────────────────────────────────────────────────────

$meta
  title = Settlers of Catan (4-Player)
  description = The classic trading & building board game, rebuilt for four on the Boardgame Network. Race to 10 victory points in a 4-player Catan — local hotseat, vs three bots, or online with up to four players.
  tags = catan, board game, strategy, four player, multiplayer, online, trading
  image = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

hubUrl = https://perchance.org/bgn-boardgame-network  // ← your network hub (set to your own BGN hub if you have one)
projectsUrl = https://perchance.org/rathjis-generators  // ← SET THIS to your Perchance projects page (shown as "Rathji's Projects" in the top nav)
authorInitial = R  // initial shown on the "Rathji's Projects" badge
gameTitle = Settlers of Catan
gameTagline = The classic trading-and-building board game, reimagined for four. Settle, build, and race to 10 victory points.
gameKicker = Host · Join · Play
gameGenre = Strategy
gamePlayers = 4 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

// Playing table backgrounds — select with [tableGraphics.selectOne], or access by id (root.tableGraphics.slate.url)
tableGraphics
  slate
    name = Slate
    url = https://user.uploads.dev/file/1c3362ef12b434367c151198fb9ba97c.jpg
  forge
    name = Forge
    url = https://user.uploads.dev/file/5756a746265c584ac77a701221aff3d7.jpg
  ember
    name = Ember
    url = https://user.uploads.dev/file/39143b5b1c649c5c07a5a54bccb9d09f.jpg

createServerSocket = {import:server-plugin}
