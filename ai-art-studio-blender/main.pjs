// AI Art Studio — a clean, simple AI image generator.
// The old AAGA branding, fork-protection and legacy t2i-framework UI have been
// stripped. Styles still come from the imported style lists below; each style
// item has a `prompt`, a `negative` and optionally a `CFG`.

generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}

aagaStyles = {import:aaga-styles-general}
aagaAnime = {import:aaga-styles-anime}
aagaRealistic = {import:aaga-styles-realistic}
perStyles = {import:perstyles-general}
perAnime = {import:perstyles-anime}
perRealistic = {import:perstyles-realistic}

// The style imports' prompt templates read the user's description and negative
// prompt from `window.input` (previously provided by the old t2i framework).
// The index.html script keeps that object up to date before each generation.
DISABLESTYLEPROMPT = "false"

// ── Wacky random themes (fodder for the style blender) ───────────────────────
wSubj
  a pug
  a sentient toaster
  a lawn flamingo
  a tiny wizard
  a garden gnome
  a pirate octopus
  an interdimensional raccoon
  a cyborg hamster
  a mime ghost
  a sushi chef robot
  a grumpy cat in a suit
  a dinosaur lawyer
  a disgruntled snowman
  a beekeeper mermaid
  a haunted Roomba
  a sleepy dragon
  a baguette with a face
  a competitive grandpa

wAct
  breakdancing on top of
  conducting a symphony of
  negotiating a truce with
  recreating the Mona Lisa on
  plotting world domination from
  giving a motivational speech to
  teaching philosophy to
  sipping bubble tea through
  playing chess against
  performing an opera about
  filing taxes for
  hosting a cooking show with
  having a staring contest with
  building an art installation from

wObj
  a giant avocado
  the moon
  a magic carpet
  a CRT television
  a flamingo
  a croissant
  a shopping cart
  a disco ball
  a rubber duck
  a whale shark
  a vending machine
  a trombone
  a birthday cake
  a ferris wheel
  a trampoline
  an enchanted umbrella

wPlace
  in a laundromat
  on the surface of the sun
  inside a washing machine
  at a medieval disco
  in a corporate boardroom
  underwater at a tea party
  on a rollercoaster
  in a mushroom forest
  during the apocalypse
  at a taco festival
  on a tiny floating island
  in a library made of clouds
  at the bottom of the ocean
  on top of a speeding train
  in a spaceship cafeteria
  at a midnight garden party

wWear
  a monocle
  a tiny top hat
  sunglasses at night
  a crown of daisies
  roller skates
  a cowboy hat
  reading glasses
  a woolly scarf
  a VR headset
  water wings

wackyTheme() =>
  let pick = Math.floor(Math.random() * 3);
  let t;
  if (pick === 0)
    t = wSubj.selectOne.evaluateItem + " " + wAct.selectOne.evaluateItem + " " + wObj.selectOne.evaluateItem + ", " + wPlace.selectOne.evaluateItem;
  else if (pick === 1)
    t = wSubj.selectOne.evaluateItem + " " + wAct.selectOne.evaluateItem + " " + wObj.selectOne.evaluateItem + " wearing " + wWear.selectOne.evaluateItem + ", " + wPlace.selectOne.evaluateItem;
  else
    t = "a dramatic portrait of " + wSubj.selectOne.evaluateItem + " " + wAct.selectOne.evaluateItem + " " + wObj.selectOne.evaluateItem + ", " + wPlace.selectOne.evaluateItem;
  return t.charAt(0).toUpperCase() + t.slice(1);

// ── General random prompts (scenic/artistic, for inspiration) ─────────────────
rpSubject
  an old lighthouse keeper's cottage
  a fox curled up on a bed of moss
  a lone cyclist climbing a mountain road
  an abandoned arcade at night
  a bowl of steaming ramen on a rainy windowsill
  a stray cat on a neon-lit city street
  a vintage train station at dawn
  a cozy cabin in a pine forest
  a street bookseller's cart in a village square
  a giant ancient redwood tree
  a diver swimming beside a whale
  a farmer's market stall overflowing with produce
  a lighthouse on a stormy cliff
  a desert highway stretching to the horizon
  a small mountain temple wrapped in mist
  a single coffee cup on a wooden café table
  a vintage film camera on a leather couch
  a glass greenhouse full of ferns
  a hot air balloon drifting over vineyards
  a wooden rowboat on a still lake
  a cat asleep on a stack of old books
  a snowy village at night
  an astronaut floating near a space station
  a bonsai tree on a minimalist desk

rpSetting
  during golden hour
  at dusk
  at first light
  under a starry night sky
  in a heavy snowfall
  on a foggy morning
  during a thunderstorm
  in the pouring rain
  at midnight under a full moon
  in early autumn with falling leaves
  during cherry blossom season
  in the blue hour

rpLight
  with warm golden light
  lit by soft moonlight
  with dramatic chiaroscuro lighting
  bathed in gentle window light
  with glowing neon reflections
  with dappled sunlight filtering through leaves
  lit by warm lantern glow
  with cool, crisp morning light
  with soft rim lighting
  with a dreamy backlit glow

rpMood
  peaceful and contemplative
  cozy and warm
  mysterious and atmospheric
  nostalgic and wistful
  epic and cinematic
  quiet and serene
  melancholic and poetic
  whimsical and dreamlike
  grand and awe-inspiring
  intimate and personal

rpComp
  wide establishing shot
  close-up with shallow depth of field
  shot from a low angle
  symmetrical composition
  rule-of-thirds composition
  leading lines toward the horizon
  centered, minimal composition
  overhead drone view
  dutch angle for dramatic tension
  through a rain-streaked window

rpTag
  photorealistic, highly detailed, 8k
  cinematic, film grain, high detail
  painterly, textured brushstrokes
  ultra-detailed, sharp focus, masterpiece
  soft focus, dreamy, ethereal
  crisp, professional photography
  atmospheric, volumetric lighting, high detail

randomPrompt() =>
  let s = rpSubject.selectOne.evaluateItem;
  let mood = rpMood.selectOne.evaluateItem;
  let tpl = Math.floor(Math.random() * 2);
  let p;
  if (tpl === 0)
    p = s + " " + rpSetting.selectOne.evaluateItem + ", " + rpLight.selectOne.evaluateItem + ", " + mood + ", " + rpComp.selectOne.evaluateItem + ", " + rpTag.selectOne.evaluateItem;
  else
    p = "A " + mood + " scene: " + s + " " + rpSetting.selectOne.evaluateItem + ", " + rpLight.selectOne.evaluateItem + ", " + rpComp.selectOne.evaluateItem + ", " + rpTag.selectOne.evaluateItem;
  return p.charAt(0).toUpperCase() + p.slice(1);

$meta
  title = AI Art Studio Blender
  description = AI art generator with curated styles, a style blender, wacky themes and AI prompt enhancement
  tags = ai art, style blender, text to image, image generator
