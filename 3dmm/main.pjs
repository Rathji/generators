$meta
  title = 3D Model Maker
  description = Type a prompt and turn it into a real 3D model, then export it as the exact file your destination needs: watertight STL scaled in millimetres for 3D printing (hollow, with a base, plus a print report and mass estimate), a Tabletop Simulator OBJ + MTL + texture package, a VTT token image for Roll20 / Foundry / Fantasy Grounds, or a game-engine GLB with LODs and a collision proxy. An AI image is generated, depth is estimated, and a mesh is sculpted that you can spin, rig, animate and re-export any way you like. Just want the picture? Hit Image to generate text-to-image on its own - preview it full-size, save it, reuse it as a reference, or turn it into a 3D model with one click. Works as a two-way bridge with Blender: drop or paste its exports (GLB / GLTF / OBJ / STL / FBX / PLY / DAE) straight onto the page, attach a reference image to steer the AI image, and drag the finished model back out into Blender or your desktop. Then open the built-in Studio - a Blender-style workspace with transform gizmos, an outliner, properties, a keyframe animation timeline and a JS scripting console.
  tags = text to 3d, image to 3d, ai, 3d model, stl, 3d printing, slicer, miniature, watertight, tabletop simulator, vtt, token, roll20, foundry, game engine, unity, unreal, godot, glb, obj, mtl, fbx, ply, collada, lod, collision, blender, import, export, drag and drop, paste, depth map, three.js, studio, animation, reference image, image prompt
  image = https://user.uploads.dev/file/2e2348ad4eda576bf426627f32c004af.png
  header
    mode = minimal

generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}
kv = {import:kv-plugin}
createServerSocket = {import:server-plugin}

randomPrompt
  [subject], [setting], [lighting], [detail]

subject
  a friendly little robot
  a wise old tortoise
  a steampunk airship
  a cute red fox sitting
  a crystal skull
  a mossy stone golem
  a 1960s racing car
  a fantasy castle on a floating island
  a giant hummingbird made of stained glass
  a cartoon rocket ship
  a samurai helmet
  a hot air balloon shaped like a whale
  a vintage folding camera
  a dragon curled around a tower
  a treasure chest overflowing with gold
  a snowy mountain cabin
  a cyberpunk street food stall
  a mechanical owl with brass gears
  a smiling bowl of ramen
  a lighthouse on a stormy cliff
  a tiny astronaut on a purple planet
  a grandfather clock overgrown with ivy

setting
  on a plain seamless background
  in a misty forest
  on a wooden table
  in a sunlit meadow
  against a deep blue studio backdrop
  in a warm cluttered workshop

lighting
  dramatic rim lighting
  soft studio lighting
  golden hour sunlight
  cool cinematic lighting
  bright even product lighting

detail
  highly detailed, sharp focus
  simple clean shapes
  intricate ornate details
  smooth stylised forms

getStylePresets() =>
  return [
    { id: "none", label: "None", keywords: "", negative: "" },
    { id: "clay", label: "Clay", keywords: "claymation sculpture, matte clay texture, soft studio lighting, plain neutral seamless background, single object centred", negative: "glossy, shiny, metal, reflections, text, watermark, busy background, collage" },
    { id: "toy", label: "Toy", keywords: "designer vinyl toy, smooth plastic, bold colours, product photograph, seamless studio background, single object centred", negative: "text, watermark, clutter, multiple objects, collage" },
    { id: "lowpoly", label: "Low poly", keywords: "low poly 3d render, flat shaded facets, minimal geometric forms, soft gradient background, single object centred", negative: "photorealistic, noisy texture, text, watermark, collage" },
    { id: "bronze", label: "Bronze", keywords: "bronze sculpture, verdigris patina, museum studio lighting, dark seamless background, single object centred", negative: "text, watermark, flat drawing, collage" },
    { id: "paper", label: "Papercraft", keywords: "papercraft model, folded card stock, crisp creases, soft shadows, plain pastel background, single object centred", negative: "metal, glossy, text, watermark, collage" },
    { id: "toon", label: "Toon", keywords: "stylised 3d cartoon render, animation studio look, soft global illumination, plain background, single object centred", negative: "photorealistic, text, watermark, collage" },
    { id: "marble", label: "Marble", keywords: "carved white marble sculpture, museum lighting, seamless light grey background, single object centred", negative: "colour, text, watermark, painting, collage" }
  ];
