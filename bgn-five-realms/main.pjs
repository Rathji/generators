// Boardgame Network (BGN) — Five Realms is a full part of the
// Boardgame Network. These values drive the shared BGN chrome in
// index.html (nav, hero, lobby, footer). The multiplayer table —
// rooms, 5-letter codes, turn order, presence, rematch, chat,
// leaderboard — is the BGN blank template's scaffold, adopted
// wholesale; it is already wired up in index.html.
// ─────────────────────────────────────────────────────────────
hubUrl = https://perchance.org/bgn-boardgame-network     // the BGN hub — browse the shelf of network games
projectsUrl = https://perchance.org/rathjis-generators   // "Rathji's Projects" badge (network credit)
authorInitial = R                                        // initial shown on that badge
gameTitle = Five Realms
gameTagline = A complete recreation of the classic 1993 Alpha-edition trading card game — all 295 original cards, faithful vintage rules, reskinned across five realms. Duel the machine, a friend on one screen, or across the network.
gameKicker = Duel · Conjure · Command
gameGenre = Card game
gamePlayers = 1–2 players
accentColor = #D9A441
heroImage = https://user.uploads.dev/file/7a9b9d0b346210572370175be4c89a49.png

// Game configuration — user-tweakable defaults for the classic Alpha-era ruleset.
gameConfig
  minDeckSize = 40
  defaultDeckSize = 60
  openingHandSize = 7
  maxHandSize = 7
  maxPlayers = 2
  startingLife = 20
  // Rule toggles (each adjustable later from the in-app Settings menu):
  rules
    manaBurn = true            // unspent mana damages its owner at end of turn (classic Alpha rule)
    allowMulligan = false      // Alpha had no mulligan; re-draws stay off unless the player enables them
    triggerStack = false       // classic Alpha resolved many triggers immediately; modern-style stack optional
    firstStrikeOrder = true    // Alpha first-strike damage step applies

// Built-in theme accents, exposed for the UI. Realm ids are the canonical names;
// see src/realms.js for the full realm table (domains, MTG color mapping, emblems).
theme
  colors
    solara = #F8F6F0     // Order / Light    (classic white)
    tide = #2A6CB8       // Water / Mystery  (classic blue)
    umbra = #19161B      // Shadow / Death   (classic black)
    ember = #C4372E      // Fire / War       (classic red)
    verdant = #3E8E45    // Nature / Life    (classic green)
    generic = #9B937F    // colourless
    gold = #D9A441
    parchment = #EDE3C9

// Card-back artwork (uploaded asset — used for face-down cards / library in later phases).
cardBackImage = https://user.uploads.dev/file/d887be97e7f7b2c004636edf81cdcde5.png

// Boardgame Network multiplayer — powers the online table (rooms, turn order,
// presence, chat, leaderboard) that index.html's BGN scaffold uses.
createServerSocket = {import:server-plugin}

// The Five Realms rules engine — Phase 1 of an MTG-compatible engine (state,
// zones, turns, priority, mana, seeded RNG, action reducer), imported as `fr`.
// Consume via root.fr(op, ...): "newGame" / "act" / "state" / "legalActions" /
// "cards" / "card" / "render" / "asset" / "assets" / "gem" / "cost" / "realms" /
// "rarities". Docs + full API table live on the plugin's own page.
fr = {import:five-realms-plugin}
