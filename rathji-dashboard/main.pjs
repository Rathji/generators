$meta
  title = rathji's Dashboard
  description = The command center for every rathji generator, plugin and template — searchable project manager, live view/edit stats from the Perchance API, category analytics, plugin import snippets and a full brand/theme configuration panel.
  image = https://user.uploads.dev/file/cdb1ed75a26d94366fcbf706b22391ea.jpg
  tags = dashboard, manager, analytics, generators, plugins, templates, stats, perchance
  header 
    mode = minimal

superFetch = {import:super-fetch-plugin}
charts = {import:data-visualization-plugin}
uploadPlugin = {import:upload-plugin}
generateText = {import:ai-text-plugin}

// ============================================================================
//  RATHJI'S DASHBOARD  —  CONFIGURATION
// ============================================================================
//
//  The dashboard's catalog of projects does NOT live here — it lives in
//  src/data/projects.js (the single source of truth for every generator,
//  plugin and template the dashboard manages). Edit that file to add/remove
//  projects or whole categories.
//
//  This `config` list drives everything else: brand identity, theme, colors,
//  category cards, KPI band, analytics charts and all page copy. The settings
//  panel (gear button, bottom-right) can edit branding, colors, theme, charts
//  and content live, and import/export the whole configuration as JSON.
// ============================================================================

config
  schemaVersion = 1.1.0

  // ── Owner / brand identity ────────────────────────────────────────────────
  branding
    companyName = rathji
    companyShortName = rathji
    companyUrl = https://perchance.org/rathjis-generators
    logoGlyph = R
    logoUrl =
    tagline = The command center for every rathji generator, plugin and template.
    contactEmail =
    contactPhone =
    address =
    footerText = © \{year\} \{companyName\}. Every project free to use, remix & learn from.

  // ── Visual theme ─────────────────────────────────────────────────────────
  theme
    mode = dark                       // light | dark
    accentStyle = gradient            // gradient | solid
    radius = 16
    fontSize = 16
    fontFamily = lato
    reduceMotion = false

  // ── Brand palette (hex colors) ───────────────────────────────────────────
  colors
    primary = #7c3aed                 // rathji violet
    secondary = #a78bfa
    accent = #5b21b6
    background = #f7f7fb
    surface = #ffffff
    text = #1f2333
    textMuted = #667085

  // ── Dashboard hero ───────────────────────────────────────────────────────
  product
    name = rathji's Dashboard
    badge = Command center
    headline = Your Perchance empire, at a glance.
    headlineAccent = at a glance.
    subheadline = Manage every generator, plugin and template in one searchable dashboard — live stats from the Perchance API, category analytics, and copy-ready links.
    primaryCta = Browse generators
    primaryCtaUrl = #generators
    secondaryCta = View plugins
    secondaryCtaUrl = #plugins
    status = Live · 73 projects tracked

  // ── Category quick-nav (shown under the hero) ─────────────────────────────
  trustedBy = [["Games","Video games","Re-creations","Board games","D&D","Images","Tools","Templates","Plugins","Business"]]

  // ── KPI band (values are refreshed live from the catalog) ────────────────
  stats
    s1
      value = 73
      suffix =
      label = Projects tracked
    s2
      value = 10
      suffix =
      label = Categories
    s3
      value = 8
      suffix =
      label = Plugins
    s4
      value = 20
      suffix =
      label = Templates

  // ── Analytics charts — catalog distribution (rendered with the
  //     data-visualization-plugin). Live usage stats are added by dashboard.js.
  charts
    enabled = true
    heading = Catalog at a glance
    description = How the 73 projects break down across categories — with live usage stats further down.
    leads
      title = Projects per category
      labels = [["Games","Video games","Re-creations","Board games","D&D","Images","Tools","Templates","Plugins","Business"]]
      values = [[2,2,4,5,6,9,10,20,8,7]]
    channels
      title = Catalog by category
      values = [[["Games",2],["Video games",2],["Re-creations",4],["Board games",5],["D&D",6],["Images",9],["Tools",10],["Templates",20],["Plugins",8],["Business",7]]]

  // ── "How it works" steps ──────────────────────────────────────────────────
  how
    h1
      title = Browse the catalog
      description = Search and filter every generator, plugin and template from one table — with category chips and copy-ready links.
    h2
      title = Track performance
      description = Live view counts, last-edit times and recent-activity lists update automatically from the Perchance API.
    h3
      title = Manage from one place
      description = Add or edit projects in src/data/projects.js; rebrand colors, theme and copy from the ⚙ panel.

  // ── Showcase / console section ────────────────────────────────────────────
  showcase
    heading = Everything tracked, nothing forgotten
    description = One data file feeds every view on this dashboard — the table, the charts and the live console below.
    points = [["Every generator, plugin and template in one searchable table","Live view counts and last-edit times straight from the Perchance API","Category breakdowns, quick filters and copy-ready links — all in one place"]]

  // ── Featured picks (⭐ cards) ─────────────────────────────────────────────
  testimonials
    t1
      quote = A prototype Debian-inspired OS that runs in your browser — full desktop shell, Start menu, window manager, virtual filesystem, and a Software Center of Perchance generators. Now with AI.
      name = Webuntu OS
      role = Tools
      company = webuntu
    t2
      quote = A code editor that runs entirely in your browser — multi-language editing, terminal, git-style version history, and an autonomous coding agent.
      name = PerchEdit
      role = Business
      company = perch-edit
    t3
      quote = A real-time multiplayer action RPG — create a hero, hunt monsters in a shared fantasy world, and level up with other adventurers.
      name = The Realm
      role = Video games
      company = the-realm

  // ── Final call-to-action band ─────────────────────────────────────────────
  cta
    heading = Ready to ship your next project?
    description = Add it to the catalog and it shows up everywhere — the table, the charts and the plugin grid.
    buttonText = Add to the catalog
    buttonUrl = #generators

  // ── FAQ accordion ─────────────────────────────────────────────────────────
  faq
    q1
      question = How do I add a new project?
      answer = Edit src/data/projects.js — add an entry to the right category (icon, title, desc, url, tags). It appears across the dashboard on the next load.
    q2
      question = Where does the project data live?
      answer = In a single data file, src/data/projects.js. It's the only place you need to touch to manage the whole catalog — every view on the dashboard reads from it.
    q3
      question = Where do view counts and edit times come from?
      answer = The Perchance getGeneratorStats API. The dashboard fetches it live for every tracked project and merges views, last-edit times and metadata into the table.
    q4
      question = Can I change colors and copy without touching code?
      answer = Yes — open the ⚙ panel (bottom-right) to edit branding, colors, theme, charts and content live, or import/export the whole configuration as JSON.

  // ── Footer link columns ───────────────────────────────────────────────────
  footer
    columns
      col1
        heading = Dashboard
        links
          l1
            label = Overview
            url = #overview
          l2
            label = Generators
            url = #generators
          l3
            label = Plugins
            url = #plugins
          l4
            label = Analytics
            url = #analytics
      col2
        heading = Resources
        links
          l1
            label = Project hub
            url = https://perchance.org/rathjis-generators
          l2
            label = Plugin tutorials
            url = https://perchance.org/rathjis-plugin-tutorials
          l3
            label = Perchance analytics
            url = https://perchance.org/perchance-generator-analytics-dashboard
          l4
            label = Perchance
            url = https://perchance.org
      col3
        heading = Manage
        links
          l1
            label = Catalog data
            url = #
          l2
            label = Business Template
            url = https://perchance.org/business-template
          l3
            label = rathji-template
            url = https://perchance.org/rathji-template
          l4
            label = Settings
            url = #

  // ── Editor / admin behavior ───────────────────────────────────────────────
  admin
    showSettingsButton = true
