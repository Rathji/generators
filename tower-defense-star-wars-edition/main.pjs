$meta
  title = Tower Defense — Star Wars Edition
  description = Defend the galaxy across Tatooine, Hoth, Endor and the Death Star. Build and upgrade turrets, strip shields with ion cannons, call down Force powers and orbital strikes, and hold the line against Stormtroopers, Battle Droids, AT-ATs and Sith bosses.
  tags = tower defense, star wars, strategy, game, sci-fi, canvas
  image = https://user.uploads.dev/file/52cba91c5c4b59591cd572c96f4fb90d.png
  header
    mode = minimal

