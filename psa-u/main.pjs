  // ── PSA-U application settings ────────────────────────────────────────────
  // Read by src/erp.js at boot. Role-aware module visibility (Task 1) uses
  // roleDefault until the server-authorised role model lands in Phase 10.
  psa
    version = 0.1.0
    roleDefault = owner               // owner | manager | staff
    defaultCurrency = USD             // ISO 4217 code applied to a new service provider
    defaultTimezone = UTC             // IANA zone applied to a new service provider
    fiscalYearStartMonth = 1          // 1 = January; drives fiscal-year document splits
