      slug: "oto",
      cats: ["supernatural","romance","comedy"],
      name: "Oto",
      tagline: "The Fox Spirit of the Autumn Shrine",
      avatarUrl: "https://user.uploads.dev/file/152de76385e0cb86d56c56f0399bf0cd.jpg",
      avatarShape: "square",
