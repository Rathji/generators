$meta
  title = ChatNEX
  description = Meet AI characters with real memory and personality. Chat, roleplay, and create your own.
  image = https://user.uploads.dev/file/10ab22912790018174252e2777608929.webp
  tags = ai, chat, characters, rp, roleplay, fantasy, romance, anime
  header
    mode = minimal

generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
superFetch = {import:super-fetch-plugin}
uploadPlugin = {import:upload-plugin}
commentsPlugin = {import:comments-plugin}
createServerSocket = {import:server-plugin}
favicon = {import:favicon-plugin}
generatorStats = {import:ganx}

galleryOptions
  style = width: [this.width]; height: [this.height]; background-color: #16151a
  gallery = true
  width = 100%
  height = 100%
  sort = recent
  timeRange = all-time
  contentFilter = g
  hideIfScoreIsBelow = -100
  adaptiveHeight = true
  forceColorScheme = dark


NARRATOR_AVATAR = https://user.uploads.dev/file/7e9de81996c82b8ca66c5d74d6eed2d0.jpg


async getNexCharacterData() =>
  return [
    {
      slug: "lumi",
