      metaTitle: "Valencia de Vienne — Your Courtesan of the Crimson Lotus",
      metaDescription: "The most desired woman in three kingdoms. She has satisfied lords, princes, and generals — and she's chosen you for tonight.",
      metaImage: "https://user.uploads.dev/file/c0b01718232952043f30621d897bf4b8.jpg"
