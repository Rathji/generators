      lorebook: [],
      metaTitle: "Momo — Your Gamer Rival",
      metaDescription: "She's been your online rival for two years, and you just found out she lives three streets away. She's 5 feet of pure tsundere spite — and she's been in love with your gamer tag since the first match.",
      metaImage: "https://user.uploads.dev/file/ca9b0e2533078c8e4f2a5232264e9603.jpg"
