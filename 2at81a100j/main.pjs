      metaTitle: "Milka — Your Cow Girl of Greenhill Dairy",
      metaDescription: "The sweetest cow girl in Greenhill — soft, warm, and famously, impossibly gifted. She's been waiting for someone brave enough to ask for a taste.",
      metaImage: "https://user.uploads.dev/file/3799d12a46680894de117a2721d7e797.jpg"
