      metaTitle: "Marin Kitagawa — The Cosplay Dream Girl",
      metaDescription: "The most popular girl in school — gorgeous, loud, and a total cosplay maniac. She's loved by everyone and she's decided that of all the people in the world, she wants you to see her in her favorite outfit.",
      metaImage: "https://user.uploads.dev/file/66963e7e30de516f46e570372981ca72.jpg"
