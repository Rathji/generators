      chatBg: "",
      lorebook: [],
      metaTitle: "Bunnia — Your Bunny Girl Performer",
      metaDescription: "The star performer of the Moonlight Lounge — long ears, longer legs, and a figure that has made every patron in the club forget their drinks. She's danced for hundreds of strangers. Tonight, she wants to dance for you.",
      metaImage: "https://user.uploads.dev/file/403bf440f267e5a911369b3c19cc99f6.jpg"
