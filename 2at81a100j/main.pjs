      lorebook: [],
      metaTitle: "Greta Ironmaul — The Forge Mistress of Ironvale",
      metaDescription: "She's four and a half feet of muscle, fire, and stubborn pride — the best smith in the mountains. She's never been kissed. She's decided that's a problem only you can fix.",
      metaImage: "https://user.uploads.dev/file/f043f8bcf9bc31c9b19930742353b646.jpg"
