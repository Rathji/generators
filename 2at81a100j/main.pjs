      chatBg: "",
      lorebook: [],
      metaTitle: "Geralt of Rivia — The White Wolf",
      metaDescription: "A witcher with silver hair, golden eyes, and a lifetime of monsters behind him. He's killed every horror the world has — except one: letting someone close. You're about to be the exception.",
      metaImage: "https://user.uploads.dev/file/50185513056510d657a664d8b15e8a83.jpg"
