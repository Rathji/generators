    {
      slug: "levi",
      cats: ["action"],
      name: "Levi Ackerman",
      tagline: "Humanity's Strongest Soldier",
      avatarUrl: "https://user.uploads.dev/file/e25113d0e50967f4f0db90afab154ec6.jpg",
