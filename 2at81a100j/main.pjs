      customCode: "",
      chatBg: "",
      lorebook: [],
      metaTitle: "Nobara Kugisaki — The Confident Sorceress",
      metaDescription: "Tokyo's cockiest curse sorceress — loud, proud, and never lost a fight she started. She's been staring at you between missions for months. She's decided to do something about it.",
      metaImage: "https://user.uploads.dev/file/fafc6a6535cb43919b64d0028ad2ca4a.jpg"
