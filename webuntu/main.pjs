// ============================================================================
// WEBUNTU OS — a fictional Debian-based Linux fork ("Webuntu 12, Perch Mint")
// A browser desktop-OS simulation on Perchance, styled with the Rathji palette.
// Full roadmap history + appendices (game inventories, shortcut sources, design
// tokens): see src/ROADMAP.md
// ============================================================================

// ============================================================================
// PHASE 10 — CODING & AI (planned; post-close-out tranche)
// The roadmap is complete through Task 76. This checklist is the next tranche:
// making Webuntu an actual functional coding + AI OS. Full descriptions live in
// src/ROADMAP.md ("Phase 10" section). Mark each [x] as it's done.
//
//   [x] 77. Webuntu Assistant   — Super+A AI chat app that ACTS on the OS:
//                                 read/write virtual-FS files, launch apps,
//                                 generate images, search the catalog.
//                                 (via the ai-text-plugin generateText import)
//   [x] 79. Voice everywhere    — voice-tools-plugin: tray mic dictation into
//                                 any field (Win+H style) + TTS for Assistant
//                                 replies; ai-voice-assistant as a menu app.
//   [x] 80. AI Images app       — text-to-image-plugin: prompt → save to
//                                 /home/user/Pictures → set as wallpaper.
//   [x] 81. GitHub app          — github-data-plugin: search/browse repos,
//                                 stars, issues; deep-link into the Browser.
//   [x] 82. Upload & Share      — upload-plugin: File Manager right-click
//                                 "Upload & get link" (URL → clipboard history),
//                                 Terminal `upload`, an Easy Uploads app.
//   [x] 83. Projects app        — project-master-style local-first project
//                                 manager (kv-plugin): projects/tasks/kanban/
//                                 pomodoro; backlogs in /home/user/Projects;
//                                 Assistant proposes the single next task.
//   [x] 84. Terminal AI verbs   — `ai "prompt"` (streams), `gh search`,
//                                 `img "prompt"` (saves to Pictures).
//   [x] 85. AI clipboard actions— "Polish / rewrite / summarize" in the Super+V
//                                 picker (per-entry ✨) + right-click edit menu.
//   [x] 86. Dev dashboard       — Control Center view: today's tasks, weather,
//                                 upload quota, online count, system monitor,
//                                 quick AI prompts.
//   [x] 87. File Manager AI     — right-click folder → "Summarize contents" /
//                                 "Generate README" / "Suggest file structure".
//   [x] 88. Task Manager        — Ctrl+Shift+Esc (or System menu): live list of
//                                 every open window with CPU/mem bars (shares
//                                 SystemMonitor's stat model), PIDs, desktop +
//                                 state chips, sortable columns, filter box;
//                                 Switch to / Minimize / Restore / Maximize /
//                                 End process (force-close, GNOME-style
//                                 two-step confirm, bypasses close-confirm
//                                 hooks). (src/taskmanager.js)
//   [x] 78. Editor → Perch Edit — RE-SCOPED (was: replace the in-OS Text
//                                 Editor with a perch-edit embed; PAUSED while
//                                 perch-edit became a plugin). Now a first-class
//                                 Perch Edit app (id perch-edit, Developer,
//                                 singleton): the real perch-edit IDE embedded
//                                 in a Browser-style window — null.perchance.org
//                                 embed, loading overlay with a 12s ↗ new-tab
//                                 fallback, Reload, and an on-close iframe blank
//                                 to stop embedded work. The perch-edit-plugin
//                                 wrapper was evaluated live and found
//                                 redundant (its embed() is the same iframe
//                                 Webuntu already uses for every generator), so
//                                 we embed directly. PerchEdit keeps its own
//                                 project tree in the embed's IndexedDB — it
//                                 cannot open virtual-FS files, so the native
//                                 Text Editor stays the .txt/code handler;
//                                 Terminal `open perch-edit` routes here.
//                                 (src/perchedit.js)
// ============================================================================

// ============================================================================
// IMPLEMENTATION
// ============================================================================

$meta
  title = Webuntu OS
  description = Webuntu 12 "Perch Mint" — a prototype Debian-inspired OS that runs in your browser: full desktop shell with Start menu, window manager, virtual filesystem, login screen, and a Software Center of Perchance generators. Now with AI: a desktop Assistant that reads and writes files, launches apps and creates images, plus voice dictation, text-to-speech, an AI Images app, a GitHub browser, and realtime Perch Chat.
  tags = os, desktop, linux, simulation, ai, assistant
  image = https://user.uploads.dev/file/c447174e333be859e2ca11cab3bd77cc.png
  header
    mode = minimal

// --- POST-52, Task 57: Online presence + chat (server-plugin) -----------------
// Adds the realtime server used by the tray "N online" indicator and the
// Perch Chat app (server code lives in index.html's text/x-server-plugin block).
createServerSocket = {import:server-plugin}

// --- PHASE 10, Task 77: Webuntu Assistant -------------------------------------
// The AI layer: generateText powers the Assistant chat; generateImage lets the
// Assistant create images on demand (save to Pictures / set as wallpaper).
generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}

// --- PHASE 10, Task 79: Voice everywhere ---------------------------------------
// The voice layer: voiceTools powers the tray-mic dictation (Win+H style) and the
// Assistant reading replies aloud via TTS.
voiceTools = {import:voice-tools-plugin}
gh = {import:github-data-plugin}
uploadPlugin = {import:upload-plugin}
kv = {import:kv-plugin}

// --- Phase 1, Task 1: Distro identity -----------------------------------------
// Data object consumed by the About screen, boot screen, Terminal & Settings.
// Access any field as root.distro.<field>.evaluateItem

distro
  name = Webuntu
  codename = Perch Mint
  version = 12
  basedOn = Debian 12
  desktopEnv = Perch Desktop
  kernel = 6.8.0-perch-mint
  shell = Perch Shell
  tagline = A fictional Debian-based Linux fork, rendered in your browser.
  fullName = [this.name] [this.version] "[this.codename]"

// Convenience block for the About screen and the Terminal's `about-webuntu`
// (neofetch-style) command. $output joins the lines with newlines.
distroAboutText
  OS: [distro.name] [distro.version] "[distro.codename]"
  Based on: [distro.basedOn]
  Desktop Environment: [distro.desktopEnv]
  Kernel: [distro.kernel]
  Default Shell: [distro.shell]
  $output = [this.joinItems("\n")]

// --- Phase 1, Task 2: Boot sequence ------------------------------------------
// Pseudo-boot log lines cycled on the boot screen (index.html reads these via
// root.bootLog.selectAll). Each line carries a `status` marker: ok|info|warn.

bootLog
  kernel
    line = Loading kernel [distro.kernel]...
    status = ok
  mount
    line = Mounting root filesystem...
    status = ok
  init
    line = Starting Perch systemd...
    status = info
  hardware
    line = Probing virtual hardware...
    status = info
  network
    line = Bringing up network interfaces...
    status = ok
  desktop
    line = Starting [distro.desktopEnv]...
    status = ok
  wm
    line = Initializing window manager...
    status = info
  theme
    line = Loading Rathji theme...
    status = warn
  session
    line = Starting user session...
    status = ok

