// ─────────────────────────────────────────────────────────────
//  BGN GAME TEMPLATE — main.pjs
//  This file is the CONFIG for your game page. Fill in the values
//  below and the themed page in index.html picks them up
//  automatically. Your game's actual UI/logic lives in index.html.
// ─────────────────────────────────────────────────────────────

hubUrl = https://perchance.org/bgn-boardgame-network  // the hub's URL (back-to-hub links in nav + footer)
gameTitle = My BGN Game
gameTagline = A clever one-liner about your game.
gameKicker = Roll · Move · Conquer        // small line above the title
gameGenre = Strategy
gamePlayers = 2–4 players
accentColor = #d4af37                      // optional: re-tint the whole theme
heroImage =                                 // optional: hero background image URL

// ── SOUND & MUSIC ────────────────────────────────────────────────
// Every BGN game ships with the shared audio system (SFX + a mute /
// volume toggle button) — nothing to add here. To give YOUR game a
// background-music theme, paste a music URL into index.html's
// `window.BGN_AUDIO` line (right above the bgn-audio.js script tag).
// The audio source lives at src/template/audio/bgn-audio.js in the hub.
// Game sounds to call from your code: BGN.sfx.play("win" | "lose" |
// "turn" | "deal" | "flip" | "place" | "discard" | "dice" | "draw" |
// "chip" | "coin" | "boom" | "warn" | "hint" | "step" | "error").
// ────────────────────────────────────────────────────────────────
