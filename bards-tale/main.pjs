// ────────────────────────────────────────────────────────────────────────
//  MAGIC — the spell database. Casters: bard (songs), conjurer (veil-work),
//  magician (raw arcana). Tier 1 spells are known at level 1; tiers 2 and 3
//  unlock at levels 2 and 3. `school`: attack | heal | buff | control.
//  `plus` names the stat whose modifier feeds damage/heal.
// ────────────────────────────────────────────────────────────────────────

spell
  sparkLance
    id = sparkLance
    spellName = Spark Lance
    caster = magician
    tier = 1
    mp = 3
    school = attack
    target = enemy
    damage = 1d6
    plus = int
    desc = A lance of crackling sparks, dealing 1d6 + INT modifier damage to one foe.
  burningHaze
    id = burningHaze
    spellName = Burning Haze
    caster = magician
    tier = 1
    mp = 5
    school = attack
    target = all
    damage = 1d4
    plus = int
    desc = A clinging haze of embers, dealing 1d4 + INT modifier damage to every foe.
  chainBolt
    id = chainBolt
    spellName = Chain Bolt
    caster = magician
    tier = 2
    mp = 7
    school = attack
    target = enemy
    damage = 2d6
    plus = int
    desc = A snapping bolt of force, dealing 2d6 + INT modifier damage to one foe.
  thunderCrack
    id = thunderCrack
    spellName = Thunder Crack
    caster = magician
    tier = 2
    mp = 9
    school = attack
    target = all
    damage = 2d4
    plus = int
    desc = A deafening crack, dealing 2d4 + INT modifier damage to every foe.
  voidHowl
    id = voidHowl
    spellName = Void Howl
    caster = magician
    tier = 3
    mp = 12
    school = attack
    target = enemy
    damage = 4d6
    plus = int
    desc = A scream from beyond the stars, dealing 4d6 + INT modifier damage to one foe.
  stormcall
    id = stormcall
    spellName = Stormcall
    caster = magician
    tier = 3
    mp = 16
    school = attack
    target = all
    damage = 3d6
    plus = int
    desc = You call a storm into the chamber, dealing 3d6 + INT modifier damage to every foe.
  forceDart
    id = forceDart
    spellName = Force Dart
    caster = conjurer
    tier = 1
    mp = 3
    school = attack
    target = enemy
    damage = 1d6
    plus = int
    desc = A dart of invisible force, dealing 1d6 + INT modifier damage to one foe.
  phantomWard
    id = phantomWard
    spellName = Phantom Ward
    caster = conjurer
    tier = 1
    mp = 4
    school = buff
    target = ally
    rounds = 4
    acBonus = 2
    desc = A shimmering ward that grants an ally +2 AC for 4 rounds.
  bindFlesh
    id = bindFlesh
    spellName = Bind Flesh
    caster = conjurer
    tier = 2
    mp = 5
    school = control
    target = enemy
    desc = Tightening bands of force make a foe lose its next turn.
  balmVeil
    id = balmVeil
    spellName = Balm of the Veil
    caster = conjurer
    tier = 2
    mp = 6
    school = heal
    target = ally
    heal = 2d4
    plus = int
    desc = Mends wounds with borrowed light, healing 2d4 + INT modifier HP.
  spectralMaw
    id = spectralMaw
    spellName = Spectral Maw
    caster = conjurer
    tier = 3
    mp = 12
    school = attack
    target = enemy
    damage = 3d8
    plus = int
    desc = A ghostly mouth closes on one foe, dealing 3d8 + INT modifier damage.
  banish
    id = banish
    spellName = Banish
    caster = conjurer
    tier = 3
    mp = 14
    school = control
    target = enemy
