// ────────────────────────────────────────────────────────────────────────
//  RIDDLE GATES — carved on ancient stone gates. Answer in the prompt to
//  open the way; the wrong word leaves the gate shut (and it mocks you).
// ────────────────────────────────────────────────────────────────────────

riddle
  riddleBook
    id = riddleBook
    riddle = I have no voice, yet I speak to those who listen. I hold every story ever told, and never say a word. What am I?
    answer = book
  riddleTomorrow
    id = riddleTomorrow
    riddle = What is always coming, but never arrives?
    answer = tomorrow
  riddleFootsteps
    id = riddleFootsteps
    riddle = The more you take, the more you leave behind. What am I?
    answer = footsteps
  riddleFire
    id = riddleFire
    riddle = I am not alive, but I grow. I do not have lungs, but I need air. What am I?
    answer = fire
  riddleEcho
    id = riddleEcho
    riddle = I speak without a mouth and hear without ears. I have no body, but I come alive with wind. What am I?
    answer = echo
  riddleKeys
    id = riddleKeys
    riddle = I have keys, but open no locks. I have space, but no room. You can enter, but not go inside. What am I?
    answer = keyboard
  riddleNight
    id = riddleNight
    riddle = What has a head and a tail, but no body?
    answer = coin
  riddleShadows
    id = riddleShadows
    riddle = I hide when the sun is high and stretch when it is low. Who am I?
    answer = shadow

