// ============================================================================
//  KERBAL SPACE PROGRAM — a 2D orbital flight sim built on the VGN shell.
//  ----------------------------------------------------------------------------
//  main.pjs is the generator's "control panel": every value in the `config`
//  list below is read at boot by src/main.js (see the `cfg()` helper) and can
//  be tweaked here without touching any JavaScript.
//  ============================================================================


$meta
  title = Kerbal Space Program
  description = A miniature orbital mechanics sandbox: build nothing, fly everything. Launch a 3-stage rocket from the Kerbin Space Center, steer through the atmosphere, stage your boosters, and circularize into orbit — or escape Kerbin entirely. Real 2-body physics, atmospheric drag, weathercocking aero, a gravity-turn autopilot, and live Ap/Pe orbit readouts, wrapped in the VGN CRT arcade shell.
  tags = kerbal, space, orbit, rocket, physics, sim, sandbox, arcade, vgn, flight
  image = https://user.uploads.dev/file/3a677feb5a82979f311c9480f8a25f4e.jpg


// ============================================================================
//  CONFIG  —  brand and tune your game here
//  ============================================================================
config
  // -- Branding -------------------------------------------------------------
  gameTitle = KERBAL SPACE PROGRAM
  tagline = 2D orbital flight sim · reach orbit, or don't come back
  coinPrompt = INSERT COIN ▶ LIGHT THE CANDLE

  // -- VGN network (do not change the hub URL — it's a Beta requirement) ----
  backHubUrl = https://perchance.org/vgn-video-game-network
  backHubLabel = RETURN TO VGN HUB

  // -- Platform -------------------------------------------------------------
  highScoreKey = kerbal-space-program-best
  titleCfg = kerbal-space-program

  // -- Player-facing "How to Play" body (shown in the How-To overlay) ------
  howToPlay
    LEFT / RIGHT — steer the rocket (pitch)
    UP / DOWN — raise / lower throttle
    SPACE — engine on / off
    Z — stage (drop the spent booster)
    G — toggle the guidance autopilot
    P / ESC — pause

    MISSION
    Reach a stable orbit: get your APOAPSIS above 100 km, coast, then burn at
    apoapsis to raise PERIAPSIS above 60 km. That's an orbit — big points.
    Keep going to escape Kerbin for the biggest prize. Don't hit the ground.

    TIPS
    • Throttle up before staging, or your second stage won't ignite.
    • Steer slowly in the thick atmosphere — the rocket wants to align with
      its velocity, so lean with it (a "gravity turn") instead of fighting.
    • Watch AP and PE on the HUD; they tell you where your trajectory ends.
    • Guidance (G) flies the whole gravity turn + circularization for you.
      Fly manual for the full-pilot bonus.
    $output = [this.joinItems("\n")]
