// ============================================================================
//  VGN 2D PHYSICS TEMPLATE  (slug: vgn-2d-physics)
//  ============================================================================
//  The official physics starter for the Video Game Network (VGN).
//  Hub: https://perchance.org/vgn-video-game-network
//
//  WHAT THIS FILE IS
//  ----------------------------------------------------------------------------
//  main.pjs is the generator's "control panel". Everything defined here at the
//  top level becomes a global on the page, readable from src/main.js via
//  `window.root.<name>` — so this is where you tweak branding, tuning numbers
//  and player-facing text WITHOUT touching JavaScript.
//
//  WHAT THIS FILE IS NOT
//  ----------------------------------------------------------------------------
//  All game code lives in src/ as real ES modules. The physics engine is
//  src/physics.js (AABB + circle bodies, restitution, friction, collision
//  layers, contact events, raycasts, anti-tunneling substeps). Two full games
//  are built on it — Breakout/Arkanoid (src/breakoutgame.js) and Pong
//  (src/ponggame.js) — pick one with `demoGame` below, or write your own.
//  ============================================================================


$meta
  title = VGN 2D PHYSICS
  description = A 2D physics engine template for the Video Game Network: AABB + circle bodies, restitution, friction, anti-tunneling substeps, collision layers, contact events and raycasts — with a deep Arkanoid demo (7 brick kinds incl. indestructible iron & chain-reaction bombs, 10 capsules incl. laser / sticky catch / fireball, 8 level patterns) and Pong on the same engine. Fork it, pick demoGame in config, and ship your own arcade bouncer on VGN.
  tags = template, vgn, video game network, physics, engine, breakout, arkanoid, pong, arcade, retro, crt, ball, paddle
  image = https://user.uploads.dev/file/61c4cf71796e025fd70b5d3e2c0b1e04.jpg


// ============================================================================
//  CONFIG  —  edit this list to brand and tune your game
//  ----------------------------------------------------------------------------
//  Every value below is read at boot by src/main.js and the demo games (see
//  the `conf()` helper in each game file). Strings stay strings; numbers and
//  booleans are parsed automatically. Add your own settings here too.
//  ============================================================================
config
  // -- Branding -------------------------------------------------------------
  gameTitle = VGN 2D PHYSICS           // shown on the title screen
  tagline = One engine — Breakout, Arkanoid & Pong.   // subtitle under the title
  coinPrompt = INSERT COIN ▶ PRESS START               // the classic arcade invite

  // -- VGN network (do not change the hub URL — it's a Beta requirement) ----
  backHubUrl = https://perchance.org/vgn-video-game-network
  backHubLabel = RETURN TO VGN HUB

  // -- Platform -------------------------------------------------------------
  highScoreKey = vgn-2d-physics-best   // localStorage key for hi-score
  titleCfg = vgn-2d-physics            // small slug shown in the footer

  // -- Which demo runs? -----------------------------------------------------
  //    breakout — full Arkanoid-ish brick breaker (power-ups, extra balls)
  //    pong     — two-player / AI paddle tennis, first to pongWinScore
  //    none     — blank dark screen, hook up your own game module
  demoGame = breakout

  // -- Physics engine defaults ----------------------------------------------
  // src/physics.js reads none of these directly — they're here so a game can
  // use them, and so tuning lives in one obvious place.
  physicsGravity = 0                   // world gravity, px/s² (+y is down)

  // -- Breakout tuning ------------------------------------------------------
  breakoutPaddleSpeed = 380            // px/s, keyboard & pointer follow
  breakoutBallSpeed = 260              // px/s at level 1 (speeds up per level)
  breakoutRows = 7                     // max brick rows (patterns can be shorter)
  breakoutCols = 10                    // brick columns
  breakoutLives = 3                    // balls before game over
  breakoutPowerups = true              // capsule drops on/off (see breakoutgame.js)
  breakoutDropChance = 0.16            // 0..1 chance a destroyed brick drops a capsule

  // -- Pong tuning ----------------------------------------------------------
  pongWinScore = 7                     // first to this score wins
  pongAi = true                        // true = right paddle is AI, false = ↑/↓
  pongBallSpeed = 300                  // px/s, constant
  pongPaddleSpeed = 320                // px/s

  // -- Player-facing "How to Play" body (fallback when a demo has none) ----
  howToPlay
    Move — ARROWS / WASD / MOUSE
    Launch — SPACE / CLICK
    Pause — P / ESC
    $output = [this.joinItems("\n")]
