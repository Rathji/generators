// ─────────────────────────────────────────────────────────────
//  BGN DOCUMENTATION REFERENCE — Boardgame Network
//  A config-driven documentation reference. Fork this, pick a
//  genre preset (or write your own) in src/config.js, and drop
//  your data into src/data/. The engine (src/app.js) is generic.
//
//  Bundled genre presets — try them with ?game=<id>:
//    dnd             → D&D 5E (2014 + 2024, the default example)
//    pathfinder      → Pathfinder 2E (Pf2eTools sample data)
//    warhammer       → Warhammer 40k-style wargame (sample)
//    crisis-protocol → Crisis Protocol-style skirmish (sample)
//    classic-board   → Classic board games (Chess, Monopoly…)
//    modern-board    → Modern board games (Wingspan, Azul…)
//
//  Most of the text below is the TEMPLATE's default face. The
//  active game's own name/tagline/colors are applied at runtime
//  from src/config.js (edit them THERE).
// ─────────────────────────────────────────────────────────────

$meta
  title = BGN Documentation Reference
  description = A config-driven documentation reference for the Boardgame Network — supports tabletop RPGs, miniature games (Warhammer, Crisis Protocol) and classic & modern board games. Fork it, pick a genre, drop in your data.
  tags = template, reference, documentation, boardgame network, rpg, wargame, tabletop, board games, search, copy
  image = https://user.uploads.dev/file/8630ae1ac1df6491b862ac120c6afa08.jpg

  async dynamic(inputs) =>
    const q = String(inputs.urlParams.q || "").trim().slice(0, 80);
    const gm = String(inputs.urlParams.game || "").trim().slice(0, 24);
    const names = { dnd: "BGN Documentation Reference", pathfinder: "Pathfinder 2E Reference", warhammer: "Warhammer 40K Reference", "crisis-protocol": "Crisis Protocol Reference", "classic-board": "Classic Board Game Rules", "modern-board": "Modern Board Game Rules" };
    const g = names[gm] || "Documentation Reference";
    let title = "BGN Documentation Reference";
    let description = "Search rules, stats, cards and table references for tabletop RPGs, miniature games and board games — then copy the answer and its reference to your table.";
    if (q) title = "\u201C" + q + "\u201D \u2014 " + g;
    if (q) description = "Look up \u201C" + q + "\u201D in " + g + " \u2014 open the entry, then copy the result and its book reference straight to your table.";
    return { title, description };

hubUrl = https://perchance.org/bgn-boardgame-network
gameTitle = BGN Documentation Reference
gameTagline = Search rules, stats and references for RPGs, wargames and board games — then copy the answer and its reference to your table.
gameKicker = Rules · Stats · Copy
gameGenre = Tool
gamePlayers = Any genre
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/8630ae1ac1df6491b862ac120c6afa08.jpg

// Per-user persistent storage for imported custom rules / house rules.
kv = {import:kv-plugin}
// Hosting for sharing published custom content with other players.
uploadPlugin = {import:upload-plugin}
