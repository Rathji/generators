// ═══════════════════════════════════════════════════════════════════════════
// WORLD FORGE — AI worldbuilding & asset generation engine for Perchance
// ═══════════════════════════════════════════════════════════════════════════
// Built on the rathji-template (perchance.org/rathji-template) conventions:
// self-contained, no import machinery, copy-anything patterns.
//
// Paste a theme → get a complete world framework for AI-chat characters:
//   • a contained setting + core conflict axis
//   • 5 pairs of asymmetric rival factions → 10 profiled characters
//   • ready-to-paste Perchance data blocks (2-space indentation)
//   • 11 cinematic Flux image prompts (1 establishing shot + 10 portraits)
// The whole response arrives wrapped in a single ````markdown block so it can
// be copied and saved straight to a .md file.
//
// More generators by Rathji: https://perchance.org/rathjis-generators
// ═══════════════════════════════════════════════════════════════════════════

$meta
  title = World Forge
  description = Paste a theme and forge a complete world for AI-chat characters: a contained setting, a core conflict axis, 5 pairs of asymmetric rival factions, 10 profiled characters, ready-to-paste Perchance data blocks, and 11 cinematic Flux image prompts — all as one copyable .md file.
  tags = worldbuilding, ai-chat, characters, flux, image-prompts, generator, tool, rathji
  image = https://user.uploads.dev/file/e916af8b22f2cb2e41cba527cdac55e1.jpg
  header
    mode = minimal

generateText = {import:ai-text-plugin}
literal = {import:literal-plugin}

// ── 1. THE ENGINE PROMPT ───────────────────────────────────────────────────
// The full system prompt, editable right here. Every line is a list item;
// blank lines are [""]. buildWorldForgePrompt() joins the lines and swaps the
// theme placeholder for the user's actual theme.

worldforgePrompt
  **System Prompt: Worldbuilding & Asset Generation Engine**
  [""]
  **Role:** You are an expert worldbuilder, character designer, and technical prompt engineer.
  [""]
  **Task:** I will provide a core theme or setting. Your objective is to flesh out a complete world framework, construct a 10-character roster built on diametrically opposed pairings, generate structured data blocks for a Perchance generator, and write highly detailed Flux image prompts.
  [""]
  **Execution Steps:**
  [""]
  1. **Setting & Faction Design:**
  * Define a highly specific, contained setting (e.g., a luxury airship during a blackout, a high-society midnight gala).
  * Establish a core conflict axis (e.g., Establishment vs. Disruption, Order vs. Chaos).
  * Divide the 10-character roster into 5 pairs of asymmetric rivals. Do not make them perfect mirrors; create friction through differing methodologies.
  [""]
  [""]
  2. **Character Profiling:**
  * Assign each character a Name, Faction/Axis, Role (or True Form/Mortal Guise), and a visual/ideological Theme.
  * Ensure roles are functional within the setting (e.g., investigator, saboteur, alchemist, quartermaster).
  [""]
  [""]
  3. **Perchance Data Blocks:**
  * Format the roster and setting into strict nested text blocks for Perchance integration.
  * Use 2-space indentation.
  * Include variables for `name`, `faction`/`axis`, `role`/`true_form`/`mortal_guise`, and `theme`.
  [""]
  [""]
  4. **Flux Image Prompts:**
  * Write one cinematic establishing shot for the setting.
  * Write individual portraits for all 10 characters.
  * **Image Prompt Rules:** Start with the framing (e.g., "Portrait of..."), explicitly state the character's archetype/clothing, detail one highly specific prop or physical trait, describe the background setting, and conclude with lighting and style keywords (e.g., cinematic lighting, hyper-realistic, dramatic volumetric lighting).
  [""]
  [""]
  5. **Output Format:**
  * Output the entire response strictly inside a single Markdown code block (````markdown`) so it can be easily copied and saved as a `.md` file.
  * The response has a hard output cap. Write the sections IN ORDER and keep prose efficient — if space gets tight, prioritize reaching and completing the later sections (Perchance block and Flux prompts) over extra detail in earlier ones.
  * Always terminate the response with the closing fence (````). Never leave the markdown block unclosed.
  [""]
  [""]
  [""]
  **Input Theme:** [root.literal("[Insert your setting, genre, or core concept here]")]


// ── 2. SAMPLE THEMES ────────────────────────────────────────────────────────
// Rendered as clickable chips on the page so the tool can be tried instantly.

worldforgeExamples
  airship
    label = Luxury airship blackout
    theme = A luxury airship during a blackout, adrift at 40,000 feet above a storm-darkened ocean. The engines are dead, the lights are failing, and someone is moving through the dark — the crew just realized the manifest doesn't match the passenger list.
  gala
    label = Midnight gala
    theme = A high-society midnight gala inside a drowned, domed city. The richest families of the sea-kingdoms throw parties while the tide presses against the glass, and the host has been dead for three weeks.
  memory-moon
    label = Memory-moon colony
    theme = A frontier mining colony on a moon where the "ore" is crystallized memory. Miners sell their own pasts for passage money, and someone has started stealing memories at gunpoint.
  upward-rain
    label = City of upward rain
    theme = A rooftop warren of couriers in a city where it rains upward — gravity flips at night, and the postal guild decides who is allowed to fly.
  drowned-station
    label = Sunken research station
    theme = A deep-sea research station slowly negotiating with the sunken city it was built on top of. The negotiators keep vanishing, and tonight a delegation is coming up to the surface.
  hospice
    label = Clockwork hospice
    theme = A clockwork hospice where the last patients are dying gods. The night-shift nurse has been quietly changing their prescriptions, and the divine pharmacy is starting to take notice.


// ── 3. HELPERS ─────────────────────────────────────────────────────────────
// Assemble the full instruction: the (editable) system prompt with the theme
// placeholder swapped for the user's actual theme.
buildWorldForgePrompt(theme) =>
  let prompt = root.worldforgePrompt.selectAll.map(i => i.evaluateItem).join("\n").trim();
  let ph = "[Insert your setting, genre, or core concept here]";
  if (prompt.includes(ph)) return prompt.split(ph).join(theme);
  return prompt + "\n\n**Input Theme:** " + theme;
