// Chance Code — config + imports.
// App logic lives in src/*.js (ES modules). This file is high-level config + seed data.

kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}
superFetch = {import:super-fetch-plugin}

$meta
  title = Chance Code — Write & run Perchance generators
  description = A code-focused tool for building Perchance generators in your browser: a real code editor (multi-language), a live preview that actually runs your .pjs lists, an AI assistant grounded in the official platform reference, and an autonomous Agent that builds projects for you.
  tags = perchance, code editor, ide, tools, generator builder, ai, tinker-chance
  header
    mode = minimal

app
  name = Chance Code
  tagline = Write, run & publish Perchance generators — right in your browser.

// Preset example tasks for the Agent mode.
agentPresets
  Build a fantasy name generator with weighted names and a Re-roll button
  Make a simple text adventure with locations you can move between
  Create an NPC generator that outputs a name, race, class and a one-line description
  Build a dice roller for tabletop games (2d6, d20, etc.)
  Make a haiku generator that picks a random haiku from a list
  Create a quest generator with dynamic odds (rare quests are rarer)

// Suggestions for the AI chat.
chatSuggestions
  How does execution order work in Perchance?
  Why does \[list\] twice give the same item — how do I reuse a selection?
  Show me how if/else blocks work in the lists panel
  How do I store data between page loads with the kv plugin?
  What are dynamic odds and how do I use them?
  How do I import and use the ai-text-plugin?
