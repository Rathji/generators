$meta
  title = IT-U — TSP Client Documentation
  description = A client-documentation repository for a Technology Solutions Provider — organizations, assets, credentials, documents, lifecycle trackers, services and deployment runbooks (VoIP and resold internet/ISP) as structured, relationship-linked records, with machine-readable export for your AI assistants.
  tags = IT documentation, TSP, MSP, client documentation, runbooks, deployment, assets
  header
    mode = minimal

// ============================================================================
//  IT-U — TSP CLIENT DOCUMENTATION SYSTEM — BOOT CONFIGURATION
// ============================================================================
//  IT-U is a client-documentation repository for a Technology Solutions
//  Provider, built on the perchance documentation framework (versioned
//  document store + sync/conflict layer + module shell + realtime hub). `kb`
//  below holds the boot defaults the app reads on startup; it keeps its
//  framework name. The majority of editable content (client documentation
//  sets, assets, relationships, runbooks, settings) will live in the app's own
//  versioned document store once each roadmap task is built, not here.
//
//  The build follows roadmap.pjs (project root) — an atomic 56-task checklist
//  across 13 phases, worked strictly one task at a time. A durable copy of the
//  checklist lives at src/ROADMAP.md.
// ============================================================================

kv = {import:kv-plugin}            // local cache + cached edit keys (document store)
uploadPlugin = {import:upload-plugin} // canonical cloud documents (editable files)
generateText = {import:ai-text-plugin} // AI drafting & polish assist (editor)
createServerSocket = {import:server-plugin} // Phase 13 (optional): roles, realtime hub, edit-key sync

// NOTE: the `kb` config name and the storage namespace are framework
// identifiers retained from the base system. The IT-U storage model (one
// versioned document per client documentation set, plus the record types it
// holds) is defined by roadmap Phase 1 task 2.
kb
  appTitle = IT-U
  appShortTitle = IT-U
  tagline = Client documentation for a Technology Solutions Provider
  storageNamespace = kb-system
  storageCeiling = 2097152 // per-set capacity target (bytes) — 2 MiB; capacity/archival is roadmap task 6
  // Single sign-on against an external identity provider (roadmap task 58).
  // `ssoEnabled` turns the whole feature off; `showSimulator` hides only the
  // built-in, role-free demo provider used to exercise the flow offline.
  ssoEnabled = true
  showSimulator = true

// The station set (Organizations, Assets, Documents, Trackers, Services,
// Deployments, Search, Linter, Exports, Settings) is defined in
// src/modules/index.js (roadmap task 1). The IT-U content model — the record
// types and the documents that hold them — is defined by roadmap Phase 1
// task 2 onwards, so no content seeds live here yet.
