// ═══════════════════════════════════════════════════════════════════════════
// KEYSTONE V2 — a modern AI chat template for Perchance
// ───────────────────────────────────────────────────────────────────────────
// 🪄 FREE TEMPLATE — fork, copy and remix freely. If you build on it, a
//    little credit back to "Keystone Chat" would be appreciated. 🧡
//    Built on the rathji-template design system (https://perchance.org/rathji-template).
// Restructured in the style of rathji-template:
//   $meta        — title / description / tags shown on the listing page
//   imports      — the plugins this template needs
//   chatPresets  — ready-to-go starter scenarios, loadable from the sidebar
//   rathji*      — copyable badge & card components (vendored from rathji-template)
//
// The heavy chat logic lives in index.html so that manual stream handling
// (Keystone Protocol Rule 8) can write directly to the DOM.
// ═══════════════════════════════════════════════════════════════════════════
// ═══ FEATURE BACKLOG — say a number and I'll build it ══════════════════════
// The 20 feature ideas for Keystone Chat. Implemented ones are marked [x].
// 1.  [x] Share a conversation via URL hash — one link that loads the whole chat.
// 2.  [x] Multiple AI personas — switch between several characters mid-chat.
// 3.  [x] Per-message edit / delete — inline buttons on each bubble.
// 4.  [x] Multi-bot rooms — several AI characters in one scene, taking turns.
// 5.  [x] Narrator line type — a "Story:" line styled differently from dialogue.
// 6.  [x] Memory vault — pinned notes injected into the prompt each turn.
// 7.  [x] Temperature / max-length sliders in the settings panel.
//     → "Creativity" (Grounded/Balanced/Wild) + "Reply length" sliders. The
//     ai-text-plugin exposes no temperature/maxTokens knobs, so these steer the
//     prompt itself ([TONE] + [LENGTH] sections).
// 8.  [x] Quick-reply buttons under the input ("Yes", "No", custom).
// 9.  [x] Typing effect + optional sound effects for new messages.
// 10. [x] Chat branching — snapshot the log, explore forks, jump back.
// 11. [ ] In-chat art — generateImage portraits of characters and scenes.
// 12. [ ] Preset manager — create, save, and delete your own presets.
// 13. [ ] Chat stats — message counts, turns, words per character.
// 14. [ ] Auto dark mode — respect prefers-color-scheme.
// 15. [x] Search within the chat log (highlight matches).
//     → 🔍 toolbar button opens a search row; typing hides non-matching messages
//     and highlights matches, with prev/next jumping and a match counter.
// 16. [x] Per-user profiles synced with kv-plugin (+secret-plugin for private bits).
//     → Named setups (all sidebar fields + chat log) saved in kv-plugin. Each
//     profile has optional private notes, encrypted with the user's own
//     secret-plugin keypair — exported profiles keep them locked to the keyholder.
// 17. [x] Comments / guestbook for the generator via comments-plugin.
// 18. [x] Mobile input polish — emoji picker, mic-to-text.
// 19. [x] i18n — multilingual UI strings (en/es/fr/de; add more in STRINGS).
// 20. [x] Per-turn token & cost meter in the status bar.
// ═══════════════════════════════════════════════════════════════════════════
// ═══ FEATURE TO DO — ATOMIC ROADMAP ════════════════════════════════════════
// Process: Atomic Roadmap (perchance.org/atomic-roadmap) — planning-first.
// Rules:
//  • PLANNING-FIRST HOLD — nothing is implemented until this roadmap is
//    reviewed and approved (see featureTodo.hold).
//  • ATOMIC tasks — each is the smallest unit that can be built and verified
//    on its own.
//  • PHASES + CONTINUOUS NUMBERING — tasks are numbered 1..45 across phases;
//    expansions append new phase blocks continuing the numbering.
//  • BUILD LOOP — one task at a time, in order: read the next ⬜ task,
//    implement it, flip its ⬜ to ✅, then STOP and await review before the
//    next task.
//  • CLEANUP — once every task is ✅, this whole section is removed from
//    main.pjs so the shipped generator is clean.
// Plain data — read from JS via root.featureTodo.phases.
// ═══════════════════════════════════════════════════════════════════════════

featureTodo
  hold = planning-first gate — do NOT implement anything until this roadmap is reviewed and approved
  totalTasks = 45
  phases
    p1Art
      title = Phase 1 — In-chat art (AI images for characters and scenes)
      goal = Let users generate a portrait of the character and scene images of the conversation, with a kept-images gallery.
      tasks
        1. ✅ Import the text-to-image-plugin (generateImage) in main.pjs and smoke-test it
        2. ✅ Scene image button in the chat toolbar that builds a scene prompt from the last few messages
        3. ✅ Image message rendering with a loading spinner, error and retry state
        4. ✅ Regenerate button on image messages plus a keep-to-gallery action
        5. ✅ Character portrait generation in the editor using the look description and a chosen style preset
        6. ✅ Per-reply image toggle that auto-generates a small scene image with each character reply
        7. ✅ Saved-images gallery modal to list, zoom and delete kept images
    p2Gallery
      title = Phase 2 — Character gallery and multi-character app
      goal = Turn the single chat room into an app with many saved characters.
      tasks
        8. ✅ Character data model in kv-plugin (id, name, avatar, tagline, scenario, persona, instructions, look, reminder, image style)
        9. ✅ Gallery view with a grid of character cards showing avatar, name and tagline
        10. ✅ Category tabs, tag filter, search box and a random character button
        11. ✅ Character editor modal for creating and editing every character field
        12. ✅ Per-character chat threads listed in the sidebar with a new chat and new character flow
    p3Slash
      title = Phase 3 — Slash commands and reply-as modes
      goal = Power-user chat controls and control over who speaks next.
      tasks
        13. ✅ Slash command parser with a suggestions menu above the input
        14. ✅ Commands for as, user, character, narrator, system, image, name, pic, background, memory and help
        15. ✅ Reply-as state machine tracking who speaks next (user, character or narrator) with names and avatars per line type
    p4Import
      title = Phase 4 — Import characters from other sites
      goal = Pull a character from an existing profile page or any web page into the gallery.
      tasks
        16. ✅ Web import modal that accepts a URL plus an optional extra instruction
        17. ✅ Importers for character.ai, chub, janitor, SpicyChat, Crushon and Sakura
        18. ✅ Plain wiki page importer for public-domain characters
        19. ✅ AI fallback that turns arbitrary page text into a character JSON
        20. ✅ Shared import pipeline to parse the card image, dedupe and save into the gallery
    p5MemSummaries
      title = Phase 5 — Memory: hierarchical background summaries
      goal = Long chats never forget the early parts because older blocks are summarized in the background.
      tasks
        21. ✅ Background summarizer that splits the log into blocks and summarizes the older ones
        22. ✅ Inject ready summaries into the prompt in place of the raw old messages
        23. ✅ Summaries viewer and per-chat memory settings (on, off, depth)
    p6MemDeep
      title = Phase 6 — Memory: deep semantic recall
      goal = Recall relevant past messages by meaning, not just recency.
      tasks
        24. ⬜ Local lightweight embedding function (no API) for messages
        25. ⬜ Background indexing of a thread into kv after new messages or when idle
        26. ⬜ At prompt time recall the top relevant past messages by cosine similarity and inject them
        27. ⬜ Rebuild and clear actions in the memory settings
    p7Lorebook
      title = Phase 7 — Memory: lorebook
      goal = World facts triggered by keywords blend into context when mentioned.
      tasks
        28. ⬜ Lorebook data model of facts with trigger keywords stored per character
        29. ⬜ Keyword scan of recent messages at prompt time and injection of matching facts
        30. ⬜ Lorebook editor UI inside the character settings
    p8Community
      title = Phase 8 — Community publishing and browsing
      goal = Share characters publicly and browse what others published.
      tasks
        31. ⬜ Add the server-plugin with a small shared list of published characters
        32. ⬜ Publish and unpublish a character from its profile with an online counter in the gallery
        33. ⬜ Community browser modal to view and save published characters into your gallery
        34. ⬜ Delete own published characters via a per-connection token
    p9Backlog
      title = Phase 9 — Keystone backlog leftovers
      goal = Finish the remaining ideas from the original 20-item backlog.
      tasks
        35. ⬜ Preset manager to create, save and delete your own presets
        36. ⬜ Chat stats with message counts, turns and words per speaker
        37. ⬜ Auto dark mode that respects prefers-color-scheme
    p10Polish
      title = Phase 10 — Chat polish: backgrounds, sound, fullscreen
      goal = Small quality-of-life touches per chat and per user.
      tasks
        38. ⬜ Chat background picker with solid, gradient and image URL options stored per chat
        39. ⬜ Sound and haptic feedback on send and receive with a settings toggle
        40. ⬜ Fullscreen toggle button
    p11Games
      title = Phase 11 — Mini-games against the character
      goal = A couple of light games the AI can play with the user in the chat.
      tasks
        41. ⬜ Games modal listing available games
        42. ⬜ Lucky Dice with a UI bar for rolling, score and rounds and in-character narration
        43. ⬜ A second lightweight game (for example twenty questions) as a follow-up
    p12Feedback
      title = Phase 12 — Notes and feedback window
      goal = A quick way for users to send a note, bug report or suggestion to the author.
      tasks
        44. ⬜ Floating notes window with a textarea
        45. ⬜ Send the note to the author via an editable upload and show a success or failure status

$meta
  title = Keystone V2
  description = Keystone V2 — a full-featured AI chat template for Perchance: editable history, personas & scenarios, one-click presets, themes and settings. Fork it and make it your own.
  tags = chat, ai, roleplay, template, rathji, keystone
  header
    mode = minimal

ai = {import:ai-text-plugin}
favicon = {import:favicon-plugin}
kv = {import:kv-plugin}
secretPlugin = {import:secret-plugin}
commentsPlugin = {import:comments-plugin}
generateImage = {import:text-to-image-plugin}
superFetch = {import:super-fetch-plugin}

// ── PRESETS: starter scenarios the user can load from the sidebar ─────────
// Each preset fills the scenario / names / descriptions / instructions fields
// and seeds the chat with the character's opening line.

chatPresets
  tavern
    label = ⚔️ Fantasy Tavern
    scenario = You walk into the Crossed Antlers, a warm, smoky tavern at the edge of the Whispering Woods. A bard is tuning a lute, and the innkeeper Elara watches you from behind the bar.
    botName = Elara
    botDesc = Innkeeper at the Crossed Antlers. Warm, witty, sharp-eyed; knows every rumor in the valley and is fiercely protective of her regulars.
    narrator = The fire
    personas = Elara | Innkeeper at the Crossed Antlers. Warm, witty, sharp-eyed; knows every rumor in the valley.\nDarian | A traveling bard with a silver tongue, a quick fiddle, and a secret debt.
    userDesc = A weary traveler who just arrived after a long road through the forest.
    instructions = Be descriptive, keep replies to one or two sentences, and let the player's choices shape the evening.
    opening = Welcome to the Crossed Antlers, friend. You look like you've seen some weather. What'll it be — ale, a bed, or a story?

  noir
    label = 🕵️ Detective Noir
    scenario = Los Angeles, 1948. Rain-slicked streets, jazz drifting from a speakeasy below. Detective Marlow sits behind his desk, hat pulled low, a case file open.
    botName = Marlow
    botDesc = Hard-boiled private detective. Cynical, sharp-tongued, secretly decent. Speaks in clipped, world-weary prose.
    narrator = The rain
    userDesc = The client — an heiress with secrets, who just walked into his office.
    instructions = Keep the noir mood thick; short, punchy lines. Describe the scene through smells, shadows and rain.
    opening = Six months of no cases, and then you walk in dripping rain like a bad omen. Sit down, Miss. Tell me what you're really here for.

  cyber
    label = 🌆 Cyberpunk Alley
    scenario = Neon-drenched streets of Neo-Tokyo, 2089. Kira, a street doc with chrome-plated arms, runs a tiny clinic under the noodle shop.
    botName = Kira
    botDesc = Street medic and fixer. Sarcastic, pragmatic, with a soft spot for lost causes. Knows every back alley and every price.
    narrator = The city
    personas = Kira | Street medic and fixer. Sarcastic, pragmatic, with a soft spot for lost causes.\nGhost | A netrunner who never shows his face. Calm, cryptic, always three moves ahead.
    userDesc = A stranger who just collapsed through her door with a bio-mod glitching.
    instructions = Punchy cyberpunk slang, fast-paced dialogue, and one atmospheric detail per reply.
    opening = Hey, careful with the door. Sit down, let me see the arm. Yeah, that mod's fried. What did they tell you it was worth?

  starship
    label = 🚀 Starship Bridge
    scenario = The starship Meridian is three days out from the Frontier, and everything is overdue — supplies, repairs, and one very overdue cargo run.
    botName = Commander Vale
    botDesc = Captain of the Meridian. Calm under pressure, dry humor, cares about her crew more than her commission.
    narrator = Mission log
    userDesc = A new crew member reporting for your first shift on the bridge.
    instructions = Crisp, professional sci-fi dialogue with dry humor; keep it short and cinematic.
    opening = You're right on time, which makes you either very good or very suspicious. Take a seat at navigation — and don't touch the red button.

  manor
    label = 🏚️ Haunted Manor
    scenario = Rain hammers the windows of Blackthorn Manor. The family lawyer has gathered you all for the reading of a very strange will.
    botName = Evelyn
    botDesc = The manor's caretaker. Pale, polite, unsettlingly calm. Has lived here her whole life and knows exactly what the house wants.
    narrator = The house
    personas = Evelyn | The manor's caretaker. Pale, polite, unsettlingly calm.\nAshcroft | The family butler. Ancient, stooped, speaks in formal whispers.
    userDesc = An heir who has never been to the manor until tonight.
    instructions = Slow-burn gothic horror; build dread with small details. Never break the eerie mood.
    opening = The others are already inside. I'd stay close to me, if I were you — the house is particular about who it remembers.

// ── RATHJI-TEMPLATE COMPONENTS (vendored below) ─────────────────────────────

// ── 1. LISTS (options + presets) ───────────────────────────────────────────

// An options node is a list whose items are `key = value` pairs — pass it to
// rathjiTemplate() and it reads each key.

rathjiTemplateOpts
  text = hello
  emoji = 🌊
  color = #22d3ee

// A list of preset options nodes. Pass the whole list and rathjiTemplate()
// picks a random item — a handy way to offer "themes".

rathjiTemplatePresets
  cosmic
    text = Cosmic
    emoji = 🌌
    color = #8b5cf6
  ocean
    text = Ocean
    emoji = 🌊
    color = #22d3ee
  ember
    text = Ember
    emoji = 🔥
    color = #f97316


// ── 2. HELPERS ─────────────────────────────────────────────────────────────

// Read any value through .evaluateItem so Perchance lists work anywhere a
// plain value would.
rathjiTemplateResolve(v) =>
  if(v == null) return v;
  try {
    if(v.evaluateItem !== undefined) return v.evaluateItem; // pjs node → its evaluated value
  } catch(e) {}
  return v; // raw JS value → as-is

rathjiTemplateStamp(text, opts) =>
  let emoji = opts.emoji || "✨";
  let color = opts.color || "#7c6cff";
  return '<span style="display:inline-block;background:' + color + '1a;color:' + color + ';border:1px solid ' + color + '66;border-radius:999px;padding:4px 14px;font-weight:600;font-family:system-ui,sans-serif;">' + emoji + " " + text + "</span>";


// ── 3. ENTRY POINT ─────────────────────────────────────────────────────────
// Accepts, all through ONE function:
//   rathjiTemplate("hi")                       plain value
//   rathjiTemplate("hi", {color:"#f00"})       value + options object
//   rathjiTemplate({text:"hi", color:"#f00"})  options object alone
//   rathjiTemplate(rathjiTemplateOpts)         options read from a list node
//   rathjiTemplate(rathjiTemplatePresets)      a LIST of options → picks a random one
//
// Options are distinguished from plain values the way the text-to-image-plugin
// does it: an options node has a known key (here: `text`), a plain value does
// not. Every value — string, number, item — is read through .evaluateItem so
// Perchance lists work anywhere a plain value would.
//
// Never throw — return a readable "(...)" placeholder on bad input.

rathjiTemplate(input, opts) =>
  // A LIST of preset options (rathjiTemplatePresets) has items but no `.text`
  // key — pick a random item first. A single options node (rathjiTemplateOpts),
  // an options object, or a plain value all keep their own `.text` (or none at
  // all). A plain list of strings (items without `.text`) passes through
  // untouched, so `rathjiTemplate(aPlainList)` evaluates to a random item —
  // free list support.
  if(input != null && input.text === undefined && input.selectOne != null) {
    let item = null;
    try { item = input.selectOne; } catch(e) {}
    if(item != null && item !== input && item.text !== undefined) input = item;
  }

  let o = {};
  if(opts != null) {
    o.text = rathjiTemplateResolve(input);
    o.emoji = rathjiTemplateResolve(opts.emoji);
    o.color = rathjiTemplateResolve(opts.color);
  } else if(input != null && input.text !== undefined) {
    o.text = rathjiTemplateResolve(input.text);
    o.emoji = rathjiTemplateResolve(input.emoji);
    o.color = rathjiTemplateResolve(input.color);
  } else {
    o.text = rathjiTemplateResolve(input);
  }

  if(typeof o.text !== "string" || !o.text.trim()) {
    return "(rathjiTemplate: expected some text — got " + JSON.stringify(rathjiTemplateResolve(input)) + ")";
  }

  return rathjiTemplateStamp(o.text.trim(), o);


// ── 4. BONUS COMPONENT: CARDS ──────────────────────────────────────────────
// A second copyable component that works exactly like the badge: themed cards
// with a title, description text, emoji and accent color. Same call patterns:
//   rathjiCard("Hello")
//   rathjiCard("Hello", { color:"#22c55e" })
//   rathjiCard({ title:"Hi", text:"...", emoji:"🃏", color:"#7c6cff" })
//   rathjiCard(rathjiCardOpts)          options read from a list node
//   rathjiCard(rathjiCardPresets)       a LIST of options → picks a random one

rathjiCardOpts
  title = Hello
  text = A generic card that holds a bit of description text.
  emoji = 🃏
  color = #7c6cff

rathjiCardPresets
  hero
    title = Hero card
    text = A bold opening card for a section of your page.
    emoji = 🏆
    color = #8b5cf6
  story
    title = Story time
    text = A card to hold narrative text, quotes, or lore.
    emoji = 📖
    color = #22d3ee
  tip
    title = Pro tip
    text = Cards make generic content blocks easy to reuse.
    emoji = 💡
    color = #f59e0b

rathjiCardStamp(o) =>
  let emoji = o.emoji || "🃏";
  let color = o.color || "#7c6cff";
  return '<div style="background:' + color + '14;border:1px solid ' + color + '44;border-left:4px solid ' + color + ';border-radius:14px;padding:16px 18px;text-align:left;">' +
    '<div style="font-size:1.6rem;line-height:1;">' + emoji + '</div>' +
    '<div style="font-weight:700;margin-top:8px;">' + o.title + '</div>' +
    '<div style="margin-top:4px;font-size:.92rem;opacity:.75;">' + o.text + '</div></div>';

rathjiCard(input, opts) =>
  // Same input handling as rathjiTemplate (options node vs. list of presets).
  if(input != null && input.title === undefined && input.selectOne != null) {
    let item = null;
    try { item = input.selectOne; } catch(e) {}
    if(item != null && item !== input && item.title !== undefined) input = item;
  }

  let o = {};
  if(opts != null) {
    o.title = rathjiTemplateResolve(input);
    o.text = rathjiTemplateResolve(opts.text);
    o.emoji = rathjiTemplateResolve(opts.emoji);
    o.color = rathjiTemplateResolve(opts.color);
  } else if(input != null && input.title !== undefined) {
    o.title = rathjiTemplateResolve(input.title);
    o.text = rathjiTemplateResolve(input.text);
    o.emoji = rathjiTemplateResolve(input.emoji);
    o.color = rathjiTemplateResolve(input.color);
  } else {
    o.title = rathjiTemplateResolve(input);
    o.text = rathjiTemplateResolve(input);
  }

  if(typeof o.title !== "string" || !o.title.trim()) o.title = o.text;
  if(typeof o.text !== "string" || !o.text.trim()) o.text = o.title;
  if(typeof o.title !== "string" || !o.title.trim()) {
    return "(rathjiCard: expected a title — got " + JSON.stringify(rathjiTemplateResolve(input)) + ")";
  }

  return rathjiCardStamp(o);


