// ============================================================================
//  ✨ THE BEST IMAGE GENERATOR ON PERCHANCE — DEVELOPMENT PLAN
// ============================================================================
//  Strategy: a generalist AI image generator with a curated prompt studio,
//  built on the text-to-image-plugin, borrowing the feature set proven by
//  the top generators (niche curation + huge style library + convenience).
//
//  MILESTONES
//  [1] ✅ DONE  Engine + Prompt Studio + Styles
//        - generateImage engine + loading UX (index.html)
//        - curated tag grids: subject/appearance/scene/lighting/camera/mood/quality
//        - 45-style curated library + random style (this file)
//        - live prompt preview + "randomize prompt" button
//  [2] ✅ DONE  Controls + Gallery
//        - resolution, aspect, seed, CFG, batch count, negative prompt UI
//        - public gallery: save/heart, top/trending sorts, NSFW gate
//  [3] ✅ DONE  Save System + Private Gallery
//        - kv-plugin: prompt history (auto, cap 50), favorites, presets
//        - private gallery: folders, save/delete/download/move, lightbox
//        - import/export JSON backups + upload-plugin hosting
//  [4] ✅ DONE  AI Tools + i2i Studio
//        - ai-text-plugin: enhance / optimize / elaborate / concise + undo
//        - image-to-prompt (remix): describe any image into a prompt
//        - upscale 2x/4x (canvas) with download
//  [5] ✅ DONE  Polish + Community
//        - themes/fonts/accents (persisted), news ticker, splash screen
//        - generator-stats-plugin + comments-plugin footer
//  [6] ✅ DONE  Channels + Sharing
//        - 6 curated channels: per-channel styles + subject/scene chips
//        - share links (URL encodes prompt/seed/cfg/style/channel)
//        - share-link import on page load + $meta.image banner
//  [7] ✅ DONE  Edit Studio + Personal Stats
//        - canvas editor: brightness/contrast/saturation, blur, pixelate
//        - filters (B&W/sepia/vintage/invert), rotate, flip, drag-to-crop
//        - text overlay + download + save to My Gallery
//        - stats: total/today/streak + top style & channel (kv)
//  [8] ✅ DONE  Custom Styles + Style Compare
//        - create/edit/delete your own styles (kv), shown as “⭐ My styles”
//        - style compare: one prompt, 2–4 styles, side-by-side grid
// ============================================================================

$meta
  title = The Best Image Generator
  description = A generalist AI image generator with a curated prompt studio and 45 styles. Free, unlimited, no sign-up.
  image = https://user.uploads.dev/file/50c8f3d1232f9626777d82d2a6260b0e.svg
  tags = ai, image generator, art, styles, prompt studio
  header
    mode = minimal

generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}
kv = {import:kv-plugin}
uploadPlugin = {import:upload-plugin}
generatorStats = {import:generator-stats-plugin}
commentsPlugin = {import:comments-plugin}

// ============================================================================
//  STYLE LIBRARY
//  Each style appends `prompt` to the final prompt and `negative` to the
//  negative prompt. Add your own styles anytime - just copy the pattern.
//  (Named `artStyles` because `styles` is a reserved list name in the engine.)
// ============================================================================
artStyles
  anime-style
    name = Anime
    prompt = anime style, cel shading, clean lineart, vibrant colors
    negative = photorealistic, 3d render, live action
  chibi-style
    name = Chibi
    prompt = chibi style, adorable, big head, small body, kawaii
    negative = realistic proportions
  ghibli-style
    name = Studio Ghibli
    prompt = studio ghibli style, hand-drawn animation, soft pastel colors, whimsical
    negative = photorealistic, 3d render
  manga-style
    name = Manga
    prompt = manga style, black and white, screentone shading, bold inks
    negative = color, photorealistic
  ukiyoe-style
    name = Ukiyo-e
    prompt = ukiyo-e woodblock print, japanese, flat colors, bold outlines
    negative = photorealistic, 3d render
  watercolor-style
    name = Watercolor
    prompt = watercolor painting, soft washes, paper texture, delicate brushwork
    negative = oil paint, photorealistic
  oil-painting-style
    name = Oil Painting
    prompt = oil painting, rich brushstrokes, classical technique, canvas texture
    negative = digital art, pixel art
  concept-art-style
    name = Concept Art
    prompt = concept art, digital painting, matte painting, detailed, design focused
    negative = photo, snapshot
  pixel-art-style
    name = Pixel Art
    prompt = pixel art, 16-bit retro game style, crisp pixels, limited palette
    negative = smooth gradients, photorealistic, 3d render
  voxel-style
    name = Voxel Art
    prompt = voxel art, blocky 3d cubes, video game asset
    negative = smooth 3d render
  lowpoly-style
    name = Low Poly
    prompt = low poly 3d art, geometric facets, flat shading, minimalist
    negative = high poly, photorealistic
  three-d-render-style
    name = 3D Render
    prompt = 3d render, octane render, physically based rendering, sharp details
    negative = painting, cartoon, sketch
  claymation-style
    name = Claymation
    prompt = claymation, stop-motion animation, clay figures, handmade texture
    negative = photorealistic, 3d render
  papercraft-style
    name = Papercraft
    prompt = papercraft, cut paper, layered paper art, handcrafted
    negative = 3d render
  lineart-style
    name = Line Art
    prompt = line art, clean black outlines, white background, ink drawing
    negative = color, shading, photorealistic
  pencil-sketch-style
    name = Pencil Sketch
    prompt = pencil sketch, graphite, hatching, paper texture
    negative = color, photorealistic
  charcoal-style
    name = Charcoal
    prompt = charcoal drawing, smudged, dramatic contrast, textured
    negative = color, photorealistic
  comic-style
    name = Comic Book
    prompt = comic book style, bold ink outlines, halftone shading, dynamic
    negative = photorealistic, anime
  noir-style
    name = Film Noir
    prompt = film noir, black and white, deep shadows, high contrast, 1940s
    negative = color, bright lighting
  cyberpunk-style
    name = Cyberpunk
    prompt = cyberpunk, neon lights, rain slicked streets, futuristic city
    negative = medieval, pastoral
  solarpunk-style
    name = Solarpunk
    prompt = solarpunk, lush green futuristic, sustainable architecture, hopeful
    negative = dystopian, grungy
  steampunk-style
    name = Steampunk
    prompt = steampunk, brass, victorian, gears and cogs, steam
    negative = modern, minimal
  postapoc-style
    name = Post-Apocalyptic
    prompt = post-apocalyptic wasteland, ruins, overgrown, weathered
    negative = clean, pristine
  epic-fantasy-style
    name = Epic Fantasy
    prompt = epic fantasy, magical, highly detailed, dramatic lighting
    negative = sci-fi, modern
  dark-fantasy-style
    name = Dark Fantasy
    prompt = dark fantasy, gothic, ominous, macabre details
    negative = bright, cheerful
  scifi-style
    name = Sci-Fi
    prompt = sci-fi, futuristic, sleek technology, hard surfaces, neon accents
    negative = fantasy, medieval
  photoreal-style
    name = Photorealistic
    prompt = photorealistic, ultra detailed, DSLR photograph, natural lighting
    negative = anime, cartoon, painting, 3d render
  portrait-photo-style
    name = Portrait Photography
    prompt = professional portrait photography, shallow depth of field, bokeh, sharp eyes
    negative = anime, cartoon, full body
  street-photo-style
    name = Street Photography
    prompt = street photography, candid, documentary, natural light
    negative = studio lighting, posed
  macro-style
    name = Macro Photography
    prompt = macro photography, extreme close-up, fine detail, shallow depth of field
    negative = wide shot
  aerial-style
    name = Aerial Drone
    prompt = aerial drone photography, top-down view, landscape, high detail
    negative = close-up, portrait
  cinematic-style
    name = Cinematic
    prompt = cinematic film still, anamorphic, dramatic lighting, film grain
    negative = flat lighting, snapshot
  flat-vector-style
    name = Flat Vector
    prompt = flat vector illustration, solid colors, clean shapes, minimalist
    negative = gradient, texture, 3d render
  minimalist-style
    name = Minimalist
    prompt = minimalist, negative space, simple composition, limited color palette
    negative = cluttered, busy, detailed
  geometric-style
    name = Geometric Abstract
    prompt = geometric abstraction, bold shapes, vibrant colors, modern art
    negative = organic, realistic
  surrealism-style
    name = Surrealism
    prompt = surrealist art, dreamlike, impossible scenes, symbolic
    negative = mundane, ordinary
  impressionism-style
    name = Impressionism
    prompt = impressionist painting, loose brushstrokes, play of light, vibrant
    negative = photorealistic, fine detail
  renaissance-style
    name = Renaissance
    prompt = renaissance painting, classical oil technique, dramatic chiaroscuro, timeless
    negative = modern, anime
  artnouveau-style
    name = Art Nouveau
    prompt = art nouveau, decorative curves, ornamental borders, elegant lines
    negative = minimal, plain
  popart-style
    name = Pop Art
    prompt = pop art, bold flat colors, halftone dots, comic style
    negative = photorealistic, subtle
  graffiti-style
    name = Graffiti
    prompt = graffiti street art, spray paint, bold lettering, urban wall
    negative = clean, indoor
  stainedglass-style
    name = Stained Glass
    prompt = stained glass, leaded panels, glowing colors, ornate frame
    negative = photorealistic
  isometric-style
    name = Isometric
    prompt = isometric view, isometric art, clean 3d, diorama
    negative = perspective, one point
  blueprint-style
    name = Blueprint
    prompt = blueprint, technical drawing, white lines on blue background, annotations
    negative = color, photorealistic
  neon-nocturne-style
    name = Neon Nocturne
    prompt = neon nocturne, glowing neon signs, night scene, reflective wet surfaces
    negative = daytime, soft pastels

// ============================================================================
//  PROMPT STUDIO TAG LIBRARY
//  Clickable chips in the Prompt Studio. Each item is plain text that gets
//  added to the assembled prompt when its chip is toggled on.
// ============================================================================
tagSubject
  a brave knight
  a wise wizard
  a wandering samurai
  a rogue ninja
  a playful fox
  a majestic wolf
  a sleek cyborg
  a curious astronaut
  a mischievous fairy
  a stoic elf
  a fierce dragon
  a clever cat
