$meta
  title = The Ledger — Small-Business Bookkeeping
  description = A comprehensive small-business bookkeeping app: double-entry ledger, accounts payable & receivable, taxes, payroll, inventory, reporting and more. Built incrementally from an atomic roadmap.
  tags = bookkeeping, accounting, double-entry, small business, invoices, bills, payroll, inventory
  header
    mode = minimal

// ============================================================================
//  THE LEDGER — SMALL-BUSINESS BOOKKEEPING
// ============================================================================
//  Base framework modeled on the perchance "business-template" generator:
//  config-driven pages (everything below in `config`), a themable component
//  system (src/theme.css + src/framework.js), and JS-rendered data rather
//  than template text. All domain features are implemented per the roadmap in
//  src/ROADMAP.md; the FEATURES CHECKLIST section at the bottom of this file
//  is the working mirror that drives the in-app "Roadmap" view.

kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}

// ============================================================================
//  CONFIGURATION
// ============================================================================
//  Everything the app shell shows (identity, theme, colors) lives in the
//  `config` list below — edit here to rebrand/retheme. The framework reads it
//  at load time (see src/framework.js), the same pattern business-template
//  uses for its landing page.

config
  schemaVersion = 1.0.0

  // ── Company / product identity ───────────────────────────────────────────
  branding
    companyName = The Ledger          // app name (top bar + footer)
    companyShortName = The Ledger    // compact variant for narrow screens
    logoGlyph = T                     // letter in the logo mark
    tagline = Simple, reliable bookkeeping for small business.
    footerText = © The Ledger — small-business bookkeeping.

  // ── Visual theme ─────────────────────────────────────────────────────────
  theme
    mode = light                      // light | dark (per-browser choice is remembered)
    accentStyle = gradient            // gradient | solid (how primary buttons & accents are filled)
    radius = 14                       // corner radius in px
    fontSize = 15                     // base text size in px
    fontFamily = inter                // inter | lato | manrope | dm-sans | ibm-plex | source-sans | open-sans
    reduceMotion = false              // true disables animations & transitions

  // ── Brand palette (hex colors) ───────────────────────────────────────────
  // Used as-is in light mode; dark mode derives deeper variants automatically.
  colors
    primary = #0f766e                 // main brand color — buttons, links, active nav
    secondary = #14b8a6               // lighter teal — gradients, charts
    accent = #134e4a                  // deep teal — small details, active states
    background = #f2f6f4              // page background
    surface = #ffffff                 // cards, panels, top bar
    text = #17211f                    // main text
    textMuted = #5c6b67               // secondary text

  // ── App behavior ─────────────────────────────────────────────────────────
  app
    defaultView = dashboard           // first view on load (dashboard | roadmap | a module key)
    version = 0.1.0                   // shown in the footer bar

// ============================================================================
//  FEATURES CHECKLIST  —  completed backlog (mirror of src/ROADMAP.md)
// ============================================================================
//  Every feature below is implemented and validated (`done`). The full
//  roadmap lives in src/ROADMAP.md; this list is the canonical working copy
//  the in-app "Roadmap" view renders.
//  Status values:  pending | done
//  The in-app "Roadmap" view renders this list and lets you tick items; UI
//  toggles persist per-browser (kv-plugin, key "roadmap"), and a "Reset"
//  button there returns to the state below. This file is the canonical copy.
//  Module keys: ledger · ap · ar · tax · ocr · payroll · reports · inventory · projects

features
  phases
    p1
      key = ledger
      icon = ledger
      nav = General Ledger
      name = Phase 1 · General Ledger & Chart of Accounts
      blurb = The double-entry core: chart of accounts, journal entries, posting, period closing, audit trail and trial balance.
      items
        t1
          id = 1
          task = Define Chart of Accounts (CoA) Structure
          detail = Implement a hierarchical system to create, edit, and categorize accounts (Assets, Liabilities, Equity, Revenue, Expenses) with unique account codes and parent-child relationships.
          status = done
        t2
          id = 2
          task = Create Double-Entry Journal Entry System
          detail = Implement a mechanism to record transactions where total debits equal total credits, ensuring every transaction is balanced before commit.
          status = done
        t3
          id = 3
          task = Implement Transaction Posting Logic
          detail = Create a system that automatically updates the real-time balance of CoA accounts based on posted journal entries.
          status = done
        t4
          id = 4
          task = Develop Period Closing Mechanism
          detail = Implement a function to lock transactions for a specific date range (Month/Quarter/Year) and carry forward net income to retained earnings.
          status = done
        t5
          id = 5
          task = Implement Ledger Audit Trail
          detail = Create an immutable log that tracks every change to a journal entry, including timestamp, user ID, and previous/new values.
          status = done
        t6
          id = 6
          task = Generate Trial Balance Report
          detail = Create a reporting function that aggregates all account balances to verify that total debits equal total credits at a specific point in time.
          status = done
    p2
      key = ap
      icon = ap
      nav = Accounts Payable
      name = Phase 2 · Accounts Payable
      blurb = Pay what you owe: purchase orders, vendor bills, recurring expenses, payments and A/P aging.
      items
        t1
          id = 7
          task = Manage Purchase Orders (PO)
          detail = Implement a workflow to create POs with vendor details and line-item descriptions that can be transitioned into bills.
          status = done
        t2
          id = 8
          task = Process Vendor Bill Entry
          detail = Implement a system to receive vendor bills, matching line items to existing POs or creating new expense entries.
          status = done
        t3
          id = 9
          task = Implement Recurring Expense Automation
          detail = Create a scheduler to automatically generate draft bills for fixed monthly expenses on a specified date.
          status = done
        t4
          id = 10
          task = Develop Line-Item Matching Engine
          detail = Create a validation tool that flags discrepancies between PO quantities/prices and the final vendor bill.
          status = done
        t5
          id = 11
          task = Manage Payment Disbursement (ACH/Check)
          detail = Implement a payment trigger that marks bills as "Paid," generates a payment reference, and creates the corresponding credit entry in the ledger.
          status = done
        t6
          id = 12
          task = Track A/P Aging
          detail = Create a report that categorizes unpaid vendor bills by the number of days past the due date (0-30, 31-60, 61-90, 90+).
          status = done
    p3
      key = ar
      icon = ar
      nav = Accounts Receivable
      name = Phase 3 · Accounts Receivable
      blurb = Get paid: quotes into invoices, recurring billing, payment processing, reminders and A/R aging.
      items
        t1
          id = 13
          task = Create Customizable Invoicing Engine
          detail = Implement a tool to generate professional invoices with customizable templates, tax calculations, and unique invoice numbering.
          status = done
        t2
          id = 14
          task = Implement Quote-to-Invoice Workflow
          detail = Create a mechanism to convert an approved customer estimate/quote into a live invoice with a single action.
          status = done
        t3
          id = 15
          task = Automate Recurring Billing
          detail = Implement a system to generate and send invoices to customers on a predefined cadence (weekly, monthly, annually).
          status = done
        t4
          id = 16
          task = Integrate Payment Gateway Processing
          detail = Implement a handler to accept credit card and bank transfer payments, automatically marking invoices as "Paid" upon successful webhook confirmation.
          status = done
        t5
          id = 17
          task = Develop Payment Reminder System
          detail = Create a trigger-based notification system that sends automated emails to customers for invoices approaching or exceeding their due date.
          status = done
        t6
          id = 18
          task = Track A/R Aging
          detail = Create a report that categorizes outstanding customer invoices by the number of days past the due date to identify overdue revenue.
          status = done
    p4
      key = tax
      icon = tax
      nav = Tax & Currency
      name = Phase 4 · Multi-Currency & Tax Engine
      blurb = Multi-currency books with per-jurisdiction sales-tax calculation, liability routing and tax reports.
      items
        t1
          id = 19
          task = Base Currency Definition
          detail = Establish a global system base currency; ensure all financial totals are stored in base currency while maintaining the original transaction currency and exchange rate used at the time of entry.
          status = done
        t2
          id = 20
          task = Exchange Rate Integration
          detail = Implement a mechanism to fetch and update currency exchange rates; allow for manual overrides per transaction to handle specific negotiated rates.
          status = done
        t3
          id = 21
          task = Dynamic Tax Calculation
          detail = Calculate applicable taxes (GST/HST/PST/VAT/US Sales Tax) based on the transaction's jurisdictional origin and destination, applying the correct percentage to the subtotal.
          status = done
        t4
          id = 22
          task = Tax Liability Routing
          detail = Automatically route the calculated tax amount from a transaction into a designated "Tax Payable" liability account in the ledger.
          status = done
        t5
          id = 23
          task = Tax Preparation Report
          detail = Generate a summary report aggregating all tax collected and paid over a specific date range, categorized by tax type and jurisdiction.
          status = done
    p5
      key = ocr
      icon = ocr
      nav = Receipt Capture
      name = Phase 5 · OCR Receipt & Document Capture
      blurb = Scan or email receipts and bills, extract the data, verify it, and commit it to the ledger.
      items
        t1
          id = 24
          task = Document Ingestion Pipeline
          detail = Create an entry point for uploading image/PDF files via camera or email, storing the raw file and assigning a unique tracking ID.
          status = done
        t2
          id = 25
          task = Data Extraction Engine
          detail = Extract the transaction date, vendor name, total amount, currency, and individual line items from the ingested document.
          status = done
        t3
          id = 26
          task = CoA Auto-Suggestion
          detail = Analyze extracted vendor and line-item text to suggest the most likely Chart of Accounts (CoA) expense category based on historical data and keywords.
          status = done
        t4
          id = 27
          task = Human-in-the-Loop Review
          detail = Provide a side-by-side interface displaying the raw document and the extracted fields for user verification and correction before final submission.
          status = done
        t5
          id = 28
          task = Ledger Commitment
          detail = Commit the verified OCR data into the ledger as a pending transaction, linking the original document file to the ledger entry for audit purposes.
          status = done
    p6
      key = payroll
      icon = payroll
      nav = Payroll
      name = Phase 6 · Simple Payroll & Workforce Management
      blurb = Employees, timesheets, pay runs with withholdings, payslips and payroll ledger entries.
      items
        t1
          id = 29
          task = Employee Profile Management
          detail = Create and store employee records containing full name, unique employee ID, hourly/salary pay rate, and specific tax withholding percentages.
          status = done
        t2
          id = 30
          task = Timesheet Entry & Submission
          detail = Implement a mechanism for recording hours worked per employee per pay period, requiring a submission state and a subsequent approval state by a manager.
          status = done
        t3
          id = 31
          task = Payroll Calculation Engine
          detail = Calculate gross pay based on approved hours and rates, subtract statutory withholdings based on employee settings, and determine final net pay.
          status = done
        t4
          id = 32
          task = Payslip Generation
          detail = Generate a read-only document for each employee detailing gross pay, individual deductions, net pay, and the pay period dates.
          status = done
        t5
          id = 33
          task = Payroll Ledger Integration
          detail = Automatically create a journal entry that debits the payroll expense account and credits the cash account for the total net pay, while crediting liability accounts for withholdings.
          status = done
    p7
      key = reports
      icon = reports
      nav = Reports & KPIs
      name = Phase 7 · Financial Reporting & Analytics
      blurb = P&L, balance sheet, cash flow, aging, the KPI dashboard and profit-margin analytics.
      items
        t1
          id = 34
          task = Profit & Loss Statement
          detail = Generate a report that aggregates all revenue and expense accounts for a selected date range to calculate net income.
          status = done
        t2
          id = 35
          task = Balance Sheet Generation
          detail = Produce a point-in-time report showing the sum of all asset, liability, and equity accounts, ensuring the fundamental accounting equation remains balanced.
          status = done
        t3
          id = 36
          task = Cash Flow Statement
          detail = Track and report the movement of cash across operating, investing, and financing activities for a specified period.
          status = done
        t4
          id = 37
          task = A/R and A/P Aging Reports
          detail = List all unpaid invoices (Accounts Receivable) and unpaid bills (Accounts Payable), categorized by the number of days elapsed since the due date.
          status = done
        t5
          id = 38
          task = Financial KPI Dashboard
          detail = Display real-time summaries of total revenue, total expenses, current cash position, and the total balance of receivables versus payables.
          status = done
        t6
          id = 39
          task = Profit Margin Analysis
          detail = Calculate and display the percentage difference between total revenue and the cost of goods sold/operating expenses for a given period.
          status = done
    p8
      key = inventory
      icon = inventory
      nav = Inventory & COGS
      name = Phase 8 · Inventory & COGS
      blurb = Item catalog, stock movements, cost-of-goods calculation and inventory valuation.
      items
        t1
          id = 40
          task = Item Catalog Management
          detail = Create a system to define trackable items with attributes for SKU, description, unit of measure, and current quantity on hand.
          status = done
        t2
          id = 41
          task = Inventory Transaction Logic
          detail = Automate quantity adjustments where "Purchase" transactions increase stock and "Sales/Invoice" transactions decrease stock.
          status = done
        t3
          id = 42
          task = COGS Calculation Engine
          detail = Implement a mechanism to calculate the Cost of Goods Sold (COGS) based on the unit cost of items sold during a specific period.
          status = done
        t4
          id = 43
          task = Inventory Valuation Report
          detail = Generate a report calculating the total monetary value of current on-hand inventory based on the most recent purchase price or weighted average cost.
          status = done
    p9
      key = projects
      icon = projects
      nav = Projects & Jobs
      name = Phase 9 · Project & Job Costing
      blurb = Tag income and costs to projects, then measure per-project profit and margin.
      items
        t1
          id = 44
          task = Project Attribution System
          detail = Enable the tagging of any expense, purchase, or invoice to a specific project ID or client entity.
          status = done
        t2
          id = 45
          task = Project Revenue Tracking
          detail = Aggregate all income associated with a specific project ID to determine gross project revenue.
          status = done
        t3
          id = 46
          task = Project Expense Aggregation
          detail = Aggregate all direct costs and labor associated with a specific project ID to determine total project expenditure.
          status = done
        t4
          id = 47
          task = Project Margin Analysis
          detail = Compute the net profit and margin percentage per project by subtracting aggregated expenses from aggregated revenue.
          status = done

// ----------------------------------------------------------------------------
//  END OF FEATURES CHECKLIST — new features get appended above, in phase order.
// ----------------------------------------------------------------------------
