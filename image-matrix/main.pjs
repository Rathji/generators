$meta
  title = Image Matrix
  description = A live aggregation of the best AI-generated images, pulled from the top image generators on Perchance and arranged into one feed. Nothing is generated here — every image is sourced from its original generator's gallery and links back to it.
  image = https://user.uploads.dev/file/674df7634548da96d10143e4659f6286.jpg
  tags = image, gallery, aggregation, curated, text-to-image, ai art, image matrix
  header
    mode = minimal

// superFetch lets this page read the gallery pages of OTHER generators
// (their gallery endpoint doesn't send CORS headers, so we proxy through
// perchance's fetch server). No image generation happens here at all.
superFetch = {import:super-fetch-plugin}

// ---------------------------------------------------------------------
//  CONFIG — tweak these to taste. Everything is overridable from the UI.
// ---------------------------------------------------------------------
config
  // How many of the top image generators to aggregate from.
  numTopGenerators = 10

  // Target number of images shown in the grid.
  numImages = 40

  // "Weighted top x%": from each generator we keep only its top x%
  // of images (top = best-ranked / most-recent, depending on `sort`),
  // then draw from those, weighted toward the higher-ranked ones.
  topPercent = 25

  // top | recent | trending  — how each source gallery is sorted.
  sort = top

  // 1-day | 3-day | 1-week | 1-month | 1-year | all-time
  timeRange = all-time

  // g | pg13 | none  — g = general only; pg13 = general + lightly suggestive; none = everything, incl. NSFW (shown blurred behind a click-to-reveal, with a "reveal all" option).
  contentFilter = g

  // Dynamically discover top image generators (see note below). If false,
  // only `seedGenerators` are used.
  discover = true

  // Fallback / guaranteed base list of known top image generators. The
  // discovery pass adds any other recently-active, high-view generators
  // that also use the text-to-image plugin.
  seedGenerators
    ai-imager-pro-4-x
    flux-reification-engine
    vn-character-art-generator
    persona-and-character-builder
    image-gen
    ai-image-generator
    art-gen
    text-to-image-plugin-example-3
