$meta
  title = sys-plan
  description = System planning board — drag-and-drop component diagrams for anything that can be mapped as a system: electrical circuits, software architecture, networks, machines, fluid circuits and energy flows. Each box is one component; connect its ports to design and plan whole systems.
  tags = system, planning, diagram, architecture, electrical, software, network, blueprint, design
  header
    mode = minimal

// ============================================================================
//  SYS-PLAN — drag & drop system planning board.
//  Docs: see src/README.md (architecture notes for contributors/agents).
//
//  The heavy lifting lives in src/ modules (model, editor, content, panels,
//  main). This file only imports the two plugins the app uses:
//    kv-plugin        → autosave + named save slots (local, per user)
//    ai-text-plugin   → optional AI brainstorm suggestions in the UI
// ============================================================================

kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}
