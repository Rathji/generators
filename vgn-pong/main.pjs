// ============================================================================
//  PONG  (slug: vgn-pong)
//  ============================================================================
//  The classic arcade paddle game, on the VGN cabinet. This file is the
//  generator's "control panel" — brand the game and tune the gameplay here
//  without touching JavaScript. All game code lives in src/ as real ES
//  modules; src/ponggame.js is the game, src/engine.js + src/physics.js are
//  the shell and physics underneath it.
//  ============================================================================


$meta
  title = PONG
  description = The classic arcade paddle game: angle bounces, rally speed-up, a CPU opponent that makes human mistakes, and a first-to-7 match — all on a glowing CRT cabinet. Move with W/S or the mouse, or grab a friend for two-player.
  tags = pong, arcade, retro, crt, vgn, video game network, two-player, cpu, physics, tennis, paddle, ball, neon
  image = https://user.uploads.dev/file/473b2c63ac83837c6588ea3bf3f978de.jpg


// ============================================================================
//  CONFIG  —  edit this list to brand and tune the game
//  ----------------------------------------------------------------------------
//  Every value below is read at boot by src/main.js and the Pong module (see
//  the `conf()` helper in src/ponggame.js). Strings stay strings; numbers
//  and booleans are parsed automatically. Add your own settings here too.
//  ============================================================================
config
  // -- Branding -------------------------------------------------------------
  gameTitle = PONG                          // shown on the title screen
  tagline = The classic arcade paddle game. // subtitle under the title
  coinPrompt = INSERT COIN ▶ PRESS START     // the classic arcade invite

  // -- VGN network (do not change the hub URL — it's a Beta requirement) ----
  backHubUrl = https://perchance.org/vgn-video-game-network
  backHubLabel = RETURN TO VGN HUB

  // -- Platform -------------------------------------------------------------
  highScoreKey = vgn-pong-best               // localStorage key for hi-score
  titleCfg = vgn-pong                        // small slug shown in the footer

  // -- Which game runs? -----------------------------------------------------
  //    pong  — the classic paddle game (this one!)
  //    none  — blank dark screen, hook up your own game module
  demoGame = pong

  // -- Pong tuning ----------------------------------------------------------
  pongWinScore = 7                   // first to this score wins the match
  pongAi = true                      // true = right paddle is CPU, false = ↑/↓
  pongBallSpeed = 300                // px/s at serve (speeds up on rallies)
  pongMaxSpeed = 430                 // px/s cap after long rallies
  pongPaddleSpeed = 330              // px/s
  pongPaddleSize = 46                // px tall

  // -- Player-facing "How to Play" body -------------------------------------
  howToPlay
    Player 1 — W / S, or move the mouse / touch
    Player 2 — ↑ / ↓, or the CPU
    Pause — P / ESC
    First to 7 wins.
    $output = [this.joinItems("\n")]
