// BGN Cover Studio — generates tuned display/cover art for games on the Boardgame Network hub.
// Each game's `scene` is the art-direction prompt fragment for that game's cover art.
// To add a game, copy a `game` block and fill in slug/title/genre/color/icon/scene.

$meta
  title = BGN Cover Studio
  description = Generate tuned display and cover art for every game on the Boardgame Network hub. Pick a game, pick a style and shape, and save or copy the art.
  image = https://user.uploads.dev/file/a9e76a5f66f96d1331d848685f5a7fc9.jpg
  tags = board games, cover art, image generation, bgn, boardgame network, display images
  header
    mode = minimal

generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}

defaultRatio = 768x512
defaultVariations = 2
maxVariations = 4

negativeBase = text, captions, labels, logos, branding, watermark, signature, border, frame, UI elements, gibberish text, distorted, deformed, extra limbs, blurry, low quality, jpeg artifacts, oversaturated

galleryModeration
  hideIfScoreIsBelow = -5
  // Gallery moderation — curate what shows up in the gallery section.
  // To find a user's ID: open the gallery's settings button -> type "admin",
  // then double-click an image to reveal its creator's user ID. Add it below.
  bannedUsers
  // Phrases that hide saved images. Prefix with `pg13:` to ban only in PG-13
  // mode, or use a /regex/ for patterns. Empty lists below are fine.
  bannedPromptPhrases
  bannedNegativePromptPhrases

stylePreset
  preset
    key = house
    label = Cinematic classic
    positive = Cinematic moody still-life, dark atmospheric background, dramatic overhead spotlight, floating dust particles, shallow depth of field, painterly digital art, rich detail, subtle vignette
    negative = flat lighting, cheerful cartoon
  preset
    key = poster
    label = Epic poster
    positive = Epic board-game box art, bold heroic composition, dramatic rim lighting, vibrant saturated color palette, fantasy concept art, cinematic render, high contrast, dynamic energy
    negative = flat, dull colors, minimal
  preset
    key = vintage
    label = Vintage box art
    positive = Vintage 1970s board-game box art, muted retro color palette, halftone print texture, aged paper, mid-century illustration, slightly worn and nostalgic
    negative = modern, glossy, neon, photorealistic
  preset
    key = minimal
    label = Minimal modern
    positive = Clean minimalist 3D product render, soft diffused studio lighting, matte pastel palette, gentle soft shadows, elegant simple composition, modern
    negative = dark, grunge, busy, cluttered
  preset
    key = noir
    label = Noir
    positive = Film-noir scene, deep black shadows, hard side lighting, drifting smoke, cinematic grainy photography, tense moody atmosphere
    negative = color, bright, cheerful, cartoon

game
  game
    slug = bgn-dnd-character-manager
    title = D&D Character Manager
    genre = Role Playing
    color = #7a4bbf
    icon = ⚔
    scene = A candlelit tavern table with stacked leather spellbooks, a handwritten hero character sheet, a glowing green d20 die, an ink quill, and a ring of small pewter adventurer miniatures
  game
    slug = bgn-dnd-source-reference
    title = D&D 5E Rules & Stats
    genre = Reference
    color = #c8332e
    icon = 🎲
    scene = A towering stack of thick fantasy rulebooks beside a glowing open spellbook, polyhedral dice scattered on dark wood, a small brass dragon figurine
  game
    slug = battle-map-forge
    title = Battle Map Forge
    genre = Role Playing
    color = #b4632a
    icon = ✒
    scene = A dungeon battle map being sketched with a quill on grid paper, scattered miniature figurines and terrain tiles, a lantern and candles, topographic contour lines
  game
    slug = bgn-checkers
    title = Checkers
    genre = Strategy
    color = #9aa5b1
    icon = ●
    scene = Round flat red and black wooden checkers disks scattered mid-game on a worn wooden checkerboard, one disk stacked on top of another, dramatic side lighting, deep shadows
  game
    slug = bgn-chess
    title = Chess
    genre = Strategy
    color = #9aa5b1
