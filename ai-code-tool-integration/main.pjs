// ═══════════════════════════════════════════════════════════════════════
// ai-code-tool-integration — Perchance plugin (rathji-plugin-template base)
// ═══════════════════════════════════════════════════════════════════════
//
// Bridges a local dev workspace and a 3rd-party AI coding platform: syncs
// context (file tree, file contents, token budget), sends structured
// prompts, parses code blocks out of responses, applies them to files only
// after user approval, logs everything for rollback, and translates API
// errors into actionable notifications.
//
// Built on the rathji-plugin-template structure (perchance.org/
// rathji-plugin-template). Consuming generators import it once with the
// standard import block, then call the bound function (the $output below),
// e.g. from a script:  await root.aiCode(opts).authenticate();
// (The docs page shows the exact import line.)
//
// IMPLEMENTED: 12 modules — Connection Protocol, Health Monitoring, Credential
// Management store, File System Indexing, Targeted Context Injection, Token
// Budget Tracking, Prompt Dispatcher, Response Parser, Local File Application,
// Change Validation Gate, Execution Log with rollback, and the Error Handling
// Bridge. Each module is a composable, never-throwing helper.
// ═══════════════════════════════════════════════════════════════════════

$meta
  title = ai-code-tool-integration
  description = A bridge plugin for synchronizing a local dev workspace with a 3rd-party AI coding platform (Codex / Claude Code style): secure connection sessions, context file-tree sync with token budgets, prompt dispatch, code-block parsing, gated file application, logs with rollback, and friendly API-error handling. Built on the rathji-plugin-template structure.
  tags = plugin, ai, code, integration, bridge, session, context, rollback
  header
    mode = minimal


// ── 0. IMPORTS ─────────────────────────────────────────────────────────

simpleGenFooter = {import:simple-gen-footer}
kv = {import:kv-plugin}


// ── 1. EMBEDDED DATA (lazy-initialised payload) ─────────────────────────
// Small default bundle, created exactly once on first use.

initAiCodeToolIntegrationData() =>
  window.AI_CODE_TOOL_INTEGRATION_PAYLOAD = {
    version: 1,
    defaults: {
      probePath: "/models",
      scheme: "Bearer",
      headerName: "Authorization",
      timeoutMs: 15000,
      heartbeat: { intervalMs: 30000, backoffMs: 1000, backoffMaxMs: 60000 }
    }
  };
  return window.AI_CODE_TOOL_INTEGRATION_PAYLOAD;

aiCodeToolIntegrationDefaults() =>
  if(!window.AI_CODE_TOOL_INTEGRATION_PAYLOAD) initAiCodeToolIntegrationData();
  return window.AI_CODE_TOOL_INTEGRATION_PAYLOAD;


// ── 2. LISTS (config presets users can point the plugin at) ─────────────
// A `key = value` options node. baseUrl + apiKey are intentionally NOT here
// — credentials come from the consumer (env-style variable, user input) or
// from the per-user credential store (Module 3), never from hardcoded source.
// `credential` names a store profile to resolve apiKey from at
// authenticate() time (true = profile "default").

aiCodeToolIntegrationOpts
  platform = generic-ai
  probePath = /models
  scheme = Bearer
  headerName = Authorization
  timeoutMs = 15000
  autoConnect = false
  model =
  credential =


// ── 3. HELPERS ──────────────────────────────────────────────────────────
// One job each, kept out of $output, reachable from the page as root.<name>
// so they can be tested directly.

aiCodeToolIntegrationResolve(v) =>
  if(v == null) return v;
  if(typeof v !== "object") return v;
  try {
    if(v.evaluateItem !== undefined) return v.evaluateItem;
  } catch(e) {}
  return v;

aiCodeToolIntegrationProbeField(obj, key) =>
  if(obj == null) return undefined;
  let v = undefined;
  try { v = obj[key]; } catch(e) { return undefined; }
  if(v === undefined || v === null) return undefined;
  return aiCodeToolIntegrationResolve(v);

aiCodeToolIntegrationError(code, message, status) =>
  let info = aiCodeToolIntegrationErrorInfo(code, status);
  let err = {
    ok: false,
    code: code || "error",
    message: message || "Something went wrong.",
    status: (typeof status === "undefined") ? null : status,
    severity: info.severity,
    userMessage: info.userMessage,
    action: info.action,
    toString: function() { return "(ai-code-tool-integration: " + this.message + ")"; }
  };
  if(status === 429 || code === "rate_limited") err.retryAfterSeconds = 5;
  let def = null;
  try { def = window.AI_CODE_TOOL_INTEGRATION_ERRORS || aiCodeToolIntegrationErrorsBuild({ auto: true }); window.AI_CODE_TOOL_INTEGRATION_ERRORS = def; } catch(e) { def = null; }
  if(def) { try { def._record({ code: err.code, message: err.message, status: err.status, severity: err.severity, userMessage: err.userMessage, action: err.action, ts: new Date().toISOString() }); } catch(e) {} }
  return err;

aiCodeToolIntegrationSafeMessage(e) =>
  if(e == null) return "unknown error";
  let m = (typeof e.message === "string") ? e.message : String(e);
  if(m.length > 200) m = m.slice(0, 200) + "...";
  return m;

aiCodeToolIntegrationNewId() =>
  if(typeof crypto !== "undefined" && typeof crypto.randomUUID === "function") {
    return "sess_" + crypto.randomUUID().replace(/-/g, "").slice(0, 12);
  }
  return "sess_" + Math.random().toString(36).slice(2, 10);

aiCodeToolIntegrationFingerprint(key) =>
  if(typeof key !== "string" || !key.trim()) return "(none)";
  let k = key.trim();
  return "..." + (k.length > 4 ? k.slice(-4) : k);

aiCodeToolIntegrationErrorText(code) =>
  if(code === "auth_failed") return "Authentication failed: the API rejected the provided credentials.";
  if(code === "invalid_config") return "Invalid configuration: required options are missing.";
  if(code === "timeout") return "The connection attempt timed out.";
  if(code === "network_error") return "A network error occurred while contacting the API.";
  if(code === "http_error") return "The API returned an HTTP error during the connection probe.";
  if(code === "transport_unavailable") return "No fetch implementation and no custom transport were available.";
  if(code === "no_credentials") return "No credential is available: nothing is stored for the requested credential profile.";
  if(code === "credential_store_error") return "The credential store could not be read or written.";
  if(code === "invalid_credential") return "A non-empty credential value is required.";
  if(code === "invalid_index_source") return "The index source must be a File System Access directory handle (kind 'directory' with a values() iterator) or a plain object mapping workspace-relative paths to file content/metadata.";
  if(code === "invalid_index_path") return "The file table contains an invalid path (paths must be non-empty, workspace-relative, with no '..' segments).";
  if(code === "invalid_index_value") return "The file table contains a value that is not file content or recognized metadata.";
  if(code === "invalid_index_conflict") return "The file table declares the same path as both a file and a directory.";
  if(code === "index_error") return "The file index could not be built.";
  if(code === "invalid_tree") return "A tree node object was expected.";
  return "The connection could not be established.";

// ── Config assembly: input (options node or plain object) + opts override ─

aiCodeToolIntegrationConfig(input, opts) =>
  let defaults = aiCodeToolIntegrationDefaults().defaults;
  let config = {};
  let keys = ["platform", "baseUrl", "apiKey", "credential", "probePath", "scheme", "headerName", "timeoutMs", "autoConnect", "model", "transport", "fetchFn", "heartbeatEnabled", "heartbeatIntervalMs", "heartbeatBackoffMs", "heartbeatBackoffMaxMs"];
  let i = 0, key = "", v = undefined;
  for(i = 0; i < keys.length; i++) {
    key = keys[i];
    if(input != null) {
      v = aiCodeToolIntegrationProbeField(input, key);
      if(v !== undefined) config[key] = v;
    }
  }
  for(i = 0; i < keys.length; i++) {
    key = keys[i];
    if(opts != null) {
      v = aiCodeToolIntegrationProbeField(opts, key);
      if(v !== undefined) config[key] = v;
    }
  }
  config.platform = (typeof config.platform === "string" && config.platform) ? config.platform : "generic-ai";
  config.scheme = (typeof config.scheme === "string" && config.scheme) ? config.scheme : defaults.scheme;
  config.headerName = (typeof config.headerName === "string" && config.headerName) ? config.headerName : defaults.headerName;
  config.probePath = (typeof config.probePath === "string" && config.probePath) ? config.probePath : defaults.probePath;
  config.timeoutMs = (typeof config.timeoutMs === "number" && config.timeoutMs > 0) ? config.timeoutMs : defaults.timeoutMs;
  if(typeof config.autoConnect === "undefined") config.autoConnect = false;
  config.heartbeatEnabled = !!config.heartbeatEnabled;
  let hbDef = defaults.heartbeat || { intervalMs: 30000, backoffMs: 1000, backoffMaxMs: 60000 };
  config.heartbeatIntervalMs = (typeof config.heartbeatIntervalMs === "number" && config.heartbeatIntervalMs > 0) ? config.heartbeatIntervalMs : hbDef.intervalMs;
  config.heartbeatBackoffMs = (typeof config.heartbeatBackoffMs === "number" && config.heartbeatBackoffMs > 0) ? config.heartbeatBackoffMs : hbDef.backoffMs;
  config.heartbeatBackoffMaxMs = (typeof config.heartbeatBackoffMaxMs === "number" && config.heartbeatBackoffMaxMs > 0) ? config.heartbeatBackoffMaxMs : hbDef.backoffMaxMs;
  let missing = [];
  if(typeof config.baseUrl !== "string" || !config.baseUrl.trim()) {
    missing.push("baseUrl");
  } else {
    config.baseUrl = config.baseUrl.trim();
  }
  let credRef = config.credential;
  config.credentialProfile = null;
  if(credRef === true) {
    config.credentialProfile = "default";
  } else if(typeof credRef === "string" && credRef.trim()) {
    config.credentialProfile = credRef.trim();
  } else if(credRef !== null && typeof credRef === "object" && typeof credRef.profile === "string" && credRef.profile.trim()) {
    config.credentialProfile = credRef.profile.trim();
  }
  delete config.credential;
  if(typeof config.apiKey === "string" && config.apiKey.trim()) {
    config.apiKey = config.apiKey.trim();
  } else {
    delete config.apiKey;
    if(!config.credentialProfile) missing.push("apiKey");
  }
  if(config.transport !== undefined && typeof config.transport !== "function") {
    let err = aiCodeToolIntegrationError("invalid_config", "The transport option must be a function (or omitted) — it receives the session and returns an ok result, or an ok:false result carrying code/message/status.");
    err.missing = ["transport"];
    return { ok: false, missing: ["transport"], config: config, result: err };
  }
  if(config.fetchFn !== undefined && typeof config.fetchFn !== "function") {
    let err = aiCodeToolIntegrationError("invalid_config", "The fetchFn option must be a function (or omitted) — it is used as the fetch implementation for the built-in connection probe.");
    err.missing = ["fetchFn"];
    return { ok: false, missing: ["fetchFn"], config: config, result: err };
  }
  if(missing.length) {
    let hint = "Pass an options node or object with " + missing.join(" and ") + ". Example: aiCode({ baseUrl: 'https://api.example.com/v1', apiKey: myKey }). Or store the key once per browser via aiCodeToolIntegrationCredentials().ingest(key) and create the session with credential: true.";
    let err = aiCodeToolIntegrationError("invalid_config", hint);
    err.missing = missing;
    return { ok: false, missing: missing, config: config, result: err };
  }
  return { ok: true, config: config };

// ── Default transport: probe the platform to establish the session ──────
// GET <baseUrl>/<probePath> with the Authorization header; 2xx means the
// session is authenticated and live. Consumers may supply their own
// `transport` function instead — it receives the session and returns an
// ok:true result, or an ok:false result carrying code/message/status.
// Never throws.

aiCodeToolIntegrationRace(promise, ms) =>
  return new Promise(function(resolve) {
    let timer = setTimeout(function() { resolve({ timedOut: true }); }, ms);
    promise.then(
      function(v) { clearTimeout(timer); resolve({ timedOut: false, value: v }); },
      function(e) { clearTimeout(timer); resolve({ timedOut: false, error: e }); }
    );
  });

async aiCodeToolIntegrationProbe(session) =>
  let fetchFn = session._fetchFn;
  if(!fetchFn && typeof fetch === "function") fetchFn = fetch;
  if(!fetchFn) {
    return { ok: false, code: "transport_unavailable", message: aiCodeToolIntegrationErrorText("transport_unavailable") };
  }
  let base = String(session.baseUrl || "").replace(/\/+$/, "");
  let path = String(session.probePath || "/models").replace(/^\/+/, "");
  let url = base + "/" + path;
  let timeoutMs = session.timeoutMs || 15000;
  let ctrl = null;
  if(typeof AbortController !== "undefined") ctrl = new AbortController();
  let reqOpts = { method: "GET", headers: session.authHeaders() };
  if(ctrl) reqOpts.signal = ctrl.signal;
  let started = null;
  try {
    started = Promise.resolve(fetchFn(url, reqOpts));
  } catch(e) {
    return { ok: false, code: "network_error", message: "Network request failed: " + aiCodeToolIntegrationSafeMessage(e) };
  }
  let out = await aiCodeToolIntegrationRace(started, timeoutMs);
  if(out.timedOut) {
    if(ctrl) { try { ctrl.abort(); } catch(e) {} }
    return { ok: false, code: "timeout", message: "Connection attempt timed out after " + timeoutMs + "ms." };
  }
  if(out.error) {
    return { ok: false, code: "network_error", message: "Network request failed: " + aiCodeToolIntegrationSafeMessage(out.error) };
  }
  let res = out.value;
  let status = (res && res.status !== undefined) ? res.status : 200;
  if(status >= 200 && status < 300) return { ok: true, status: status };
  if(status === 401 || status === 403) {
    return { ok: false, code: "auth_failed", status: status, message: "The API rejected the credentials (HTTP " + status + "). Check your API key and session configuration." };
  }
  return { ok: false, code: "http_error", status: status, message: "The API responded with HTTP " + status + " during the connection probe." };

// ── Session factory: the handle returned by $output ─────────────────────

aiCodeToolIntegrationSession(config) =>
  let key = config.apiKey;
  let session = {
    ok: true,
    kind: "ai-code-tool-integration-session",
    id: aiCodeToolIntegrationNewId(),
    platform: config.platform,
    baseUrl: config.baseUrl,
    probePath: config.probePath,
    model: config.model || null,
    credentialProfile: config.credentialProfile || null,
    credentialBackend: null,
    scheme: config.scheme,
    headerName: config.headerName,
    timeoutMs: config.timeoutMs,
    autoConnect: !!config.autoConnect,
    status: "unauthenticated",
    createdAt: new Date().toISOString(),
    authenticatedAt: null,
    keyFingerprint: aiCodeToolIntegrationFingerprint(key),
    lastAttempt: null,
    error: null,
    heartbeat: null,
    heartbeatIntervalMs: (typeof config.heartbeatIntervalMs === "number" && config.heartbeatIntervalMs > 0) ? config.heartbeatIntervalMs : 30000,
    heartbeatBackoffMs: (typeof config.heartbeatBackoffMs === "number" && config.heartbeatBackoffMs > 0) ? config.heartbeatBackoffMs : 1000,
    heartbeatBackoffMaxMs: (typeof config.heartbeatBackoffMaxMs === "number" && config.heartbeatBackoffMaxMs > 0) ? config.heartbeatBackoffMaxMs : 60000
  };
  Object.defineProperty(session, "_secret", { value: key, enumerable: false, writable: true });
  if(typeof config.transport === "function") {
    Object.defineProperty(session, "_transport", { value: config.transport, enumerable: false, writable: true });
  }
  if(typeof config.fetchFn === "function") {
    Object.defineProperty(session, "_fetchFn", { value: config.fetchFn, enumerable: false, writable: true });
  }
  session.authHeaders = function() {
    let h = {};
    if(session._secret) h[session.headerName] = session.scheme ? (session.scheme + " " + session._secret) : session._secret;
    return h;
  };
  session.isConnected = function() { return session.status === "connected"; };
  session.authenticate = async function() {
    if(session.status === "authenticating") return session;
    session.status = "authenticating";
    session.error = null;
    session.lastAttempt = { at: new Date().toISOString(), code: null, message: null, status: null };
    let cred = null;
    try {
      cred = await aiCodeToolIntegrationResolveCredentials(session);
    } catch(e) {
      cred = { ok: false, code: "credential_store_error", message: "Credential resolution threw: " + aiCodeToolIntegrationSafeMessage(e) };
    }
    if(!cred.ok) {
      session.error = { code: cred.code, message: cred.message, status: null };
      session.lastAttempt.code = cred.code;
      session.lastAttempt.message = cred.message;
      session.status = "error";
      return session;
    }
    let transport = session._transport || aiCodeToolIntegrationProbe;
    let r = null;
    try {
      r = await transport(session);
    } catch(e) {
      r = { ok: false, code: "unexpected_error", message: "Transport threw: " + aiCodeToolIntegrationSafeMessage(e) };
    }
    if(r && r.ok === true) {
      session.status = "connected";
      session.authenticatedAt = new Date().toISOString();
      session.lastAttempt.code = "ok";
      session.lastAttempt.message = "Authenticated successfully.";
      session.lastAttempt.status = (typeof r.status !== "undefined") ? r.status : null;
      return session;
    }
    let code = (r && r.code) || "auth_failed";
    let msg = (r && r.message) || aiCodeToolIntegrationErrorText(code);
    session.error = { code: code, message: msg, status: (r && r.status !== undefined) ? r.status : null };
    session.lastAttempt.code = code;
    session.lastAttempt.message = msg;
    session.lastAttempt.status = session.error.status;
    session.status = (code === "auth_failed") ? "auth_failed" : "error";
    return session;
  };
  session.describe = function() {
    return "ai-code-tool-integration session " + session.id + " | " + session.status + " | " + session.platform + " | " + session.baseUrl + (session.model ? " | model " + session.model : "") + " | key " + session.keyFingerprint + (session.credentialProfile ? " | store profile '" + session.credentialProfile + "'" : "");
  };
  session.toJSON = function() {
    return {
      ok: session.ok,
      kind: session.kind,
      id: session.id,
      status: session.status,
      platform: session.platform,
      baseUrl: session.baseUrl,
      probePath: session.probePath,
      model: session.model,
      scheme: session.scheme,
      headerName: session.headerName,
      timeoutMs: session.timeoutMs,
      autoConnect: session.autoConnect,
      createdAt: session.createdAt,
      authenticatedAt: session.authenticatedAt,
      keyFingerprint: session.keyFingerprint,
      credentialProfile: session.credentialProfile,
      credentialBackend: session.credentialBackend,
      lastAttempt: session.lastAttempt,
      error: session.error
    };
  };
  session.toString = function() { return session.describe(); };
  session.startHeartbeat = function(opts) {
    if(session.heartbeat && session.heartbeat.running) return session.heartbeat;
    let o = opts || {};
    let pick = function(v, fallback) { return (typeof v === "number" && v > 0) ? v : fallback; };
    let intervalMs = pick(o.intervalMs, session.heartbeatIntervalMs);
    let backoffMs = pick(o.backoffMs, session.heartbeatBackoffMs);
    let backoffMaxMs = pick(o.backoffMaxMs, session.heartbeatBackoffMaxMs);
    let onEvent = (typeof o.onEvent === "function") ? o.onEvent : null;
    session.heartbeat = aiCodeToolIntegrationHeartbeat(session, { intervalMs: intervalMs, backoffMs: backoffMs, backoffMaxMs: backoffMaxMs, onEvent: onEvent });
    session.heartbeat.start();
    return session.heartbeat;
  };
  session.stopHeartbeat = function() {
    if(session.heartbeat) session.heartbeat.stop();
    return session;
  };
  session.heartbeatStatus = function() {
    if(!session.heartbeat) return "no-heartbeat";
    return session.heartbeat.status;
  };
  if(session.autoConnect) session.authenticate();
  return session;


// ── Module 2: Health monitoring (heartbeat) ───────────────────────────────
// Periodic checks validate the session is still alive; a failed check arms
// a reconnection sequence (single-flight, one scheduled attempt per
// failure) with exponential backoff. Status log: ok | reconnecting | down
// | stopped (+ starting while the first check is in flight). auth_failed
// (rejected credentials) halts the heartbeat — retrying would not help.
// Single-timer design: exactly one next check is ever scheduled, so a
// failure can never fan out into duplicate reconnection sequences.

aiCodeToolIntegrationBackoff(failures, baseMs, maxMs) =>
  let f = (typeof failures === "number" && failures >= 1) ? Math.floor(failures) : 1;
  let base = (typeof baseMs === "number" && baseMs > 0) ? baseMs : 1000;
  let max = (typeof maxMs === "number" && maxMs > 0) ? maxMs : 60000;
  let delay = base * Math.pow(2, f - 1);
  return Math.min(Math.round(delay), max);

aiCodeToolIntegrationHeartbeat(session, opts) =>
  let o = opts || {};
  let config = {
    intervalMs: (typeof o.intervalMs === "number" && o.intervalMs > 0) ? o.intervalMs : 30000,
    backoffMs: (typeof o.backoffMs === "number" && o.backoffMs > 0) ? o.backoffMs : 1000,
    backoffMaxMs: (typeof o.backoffMaxMs === "number" && o.backoffMaxMs > 0) ? o.backoffMaxMs : 60000,
    checkOnStart: o.checkOnStart !== false,
    onEvent: (typeof o.onEvent === "function") ? o.onEvent : null
  };
  let controller = {
    kind: "ai-code-tool-integration-heartbeat",
    running: false,
    status: "stopped",
    consecutiveFailures: 0,
    totalChecks: 0,
    reconnectCount: 0,
    lastCheckAt: null,
    lastOkAt: null,
    lastResult: null,
    history: [],
    config: { intervalMs: config.intervalMs, backoffMs: config.backoffMs, backoffMaxMs: config.backoffMaxMs }
  };
  let timer = null;
  let inFlight = false;
  controller.push = function(entry) {
    if(!entry.ts) entry.ts = new Date().toISOString();
    controller.history.push(entry);
    if(controller.history.length > 200) controller.history.shift();
    if(config.onEvent) { try { config.onEvent(entry); } catch(e) {} }
    return entry;
  };
  controller.scheduleNext = function(delayMs) {
    if(!controller.running) return;
    if(timer) { clearTimeout(timer); timer = null; }
    timer = setTimeout(async function() {
      timer = null;
      await controller.runCheck();
    }, delayMs);
  };
  controller.runCheck = async function() {
    if(inFlight) return controller.lastResult;
    inFlight = true;
    controller.totalChecks++;
    let attemptsBefore = controller.consecutiveFailures;
    let checkError = null;
    try {
      await session.authenticate();
    } catch(e) {
      checkError = { code: "unexpected_error", message: "Heartbeat check threw: " + aiCodeToolIntegrationSafeMessage(e) };
    }
    controller.lastCheckAt = new Date().toISOString();
    let ok = !checkError && session.status === "connected";
    if(ok) {
      controller.consecutiveFailures = 0;
      if(attemptsBefore > 0) controller.reconnectCount++;
      controller.lastOkAt = controller.lastCheckAt;
      controller.status = "ok";
      controller.lastResult = { ok: true, status: (session.lastAttempt && session.lastAttempt.status) || null };
      controller.push({
        event: attemptsBefore > 0 ? "reconnect-ok" : "check-ok",
        status: controller.status,
        failures: 0,
        detail: attemptsBefore > 0 ? "Reconnection succeeded — session healthy again." : "Heartbeat check passed — session active."
      });
      controller.scheduleNext(config.intervalMs);
    } else {
      let code = checkError ? checkError.code : ((session.error && session.error.code) || "check-failed");
      let message = checkError ? checkError.message : ((session.error && session.error.message) || aiCodeToolIntegrationErrorText(code));
      controller.consecutiveFailures++;
      controller.lastResult = { ok: false, code: code, message: message };
      if(code === "auth_failed") {
        controller.status = "down";
        controller.push({
          event: "auth-fail",
          status: controller.status,
          failures: controller.consecutiveFailures,
          detail: "Credentials rejected — heartbeat halted until restarted."
        });
        controller.running = false;
        if(timer) { clearTimeout(timer); timer = null; }
      } else {
        controller.status = "reconnecting";
        let delayMs = aiCodeToolIntegrationBackoff(controller.consecutiveFailures, config.backoffMs, config.backoffMaxMs);
        controller.push({
          event: attemptsBefore > 0 ? "reconnect-fail" : "check-fail",
          status: controller.status,
          failures: controller.consecutiveFailures,
          detail: attemptsBefore > 0 ? "Reconnection attempt failed — retrying with backoff." : "Heartbeat check failed — starting reconnection sequence.",
          nextRetryMs: delayMs
        });
        controller.scheduleNext(delayMs);
      }
    }
    inFlight = false;
    return controller.lastResult;
  };
  controller.start = function() {
    if(controller.running) return controller;
    controller.running = true;
    controller.status = session.isConnected() ? "ok" : "starting";
    controller.push({ event: "start", status: controller.status, failures: controller.consecutiveFailures, detail: "Heartbeat started." });
    controller.scheduleNext(config.checkOnStart ? 0 : config.intervalMs);
    return controller;
  };
  controller.stop = function() {
    if(!controller.running) return controller;
    controller.running = false;
    if(timer) { clearTimeout(timer); timer = null; }
    controller.push({ event: "stop", status: controller.status, failures: controller.consecutiveFailures, detail: "Heartbeat stopped." });
    controller.status = "stopped";
    return controller;
  };
  controller.checkNow = function() { return controller.runCheck(); };
  controller.isOk = function() { return controller.status === "ok"; };
  return controller;


// ── Module 3: Credential management (per-user local key store) ────────────
// API keys are never hardcoded in source and never logged. Consumers ingest
// a key once per browser into a credential store; sessions then reference
// the store by profile name, and authenticate() pulls the raw key out at
// the last moment to assemble the auth header. Storage is per-user and
// local: kv-plugin (IndexedDB) when the module is on the page — this plugin
// imports it, so it is — with localStorage and page-lifetime memory as
// graceful fallbacks. Readable surfaces (get/describe/JSON/console) expose
// only a fully masked redaction plus a fingerprint; the raw value leaves
// the store exclusively through read(), for session header assembly.

aiCodeToolIntegrationRedact(key) =>
  if(typeof key !== "string") return "(none)";
  let k = key.trim();
  if(!k.length) return "(none)";
  if(k.length <= 4) return new Array(k.length + 1).join("*");
  return new Array(k.length - 3).join("*") + k.slice(-4);

aiCodeToolIntegrationKvHandle() =>
  try {
    if(typeof window !== "undefined" && window.__kvPluginProxy7583683) return window.__kvPluginProxy7583683;
    if(typeof root !== "undefined" && root.kv) return root.kv;
  } catch(e) {}
  return null;

async aiCodeToolIntegrationCredentialOp(kind, profile, record) =>
  let payload = aiCodeToolIntegrationDefaults();
  let kv = null;
  if(!payload._kvDown) kv = aiCodeToolIntegrationKvHandle();
  if(kv) {
    try {
      let folder = kv["ai-code-tool-integration"];
      if(kind === "write") {
        await folder.set(profile, record);
        return { ok: true, backend: "kv" };
      }
      if(kind === "remove") {
        await folder.delete(profile);
        return { ok: true, backend: "kv" };
      }
      let v = await folder.get(profile);
      if(v === undefined || v === null) {
        let emptySet = payload._kvEmptyProfiles || (payload._kvEmptyProfiles = {});
        if(!emptySet[profile]) {
          let delays = [100, 200];
          let i = 0;
          for(i = 0; i < delays.length && (v === undefined || v === null); i++) {
            await new Promise(function(r2) { setTimeout(r2, delays[i]); });
            v = await folder.get(profile);
          }
          if(v === undefined || v === null) emptySet[profile] = true;
        }
      }
      return { ok: true, backend: "kv", record: (v === undefined || v === null) ? null : v };
    } catch(e) {
      payload._kvDown = true;
    }
  }
  try {
    let ls = (typeof localStorage !== "undefined") ? localStorage : null;
    let lsKey = "ai-code-tool-integration:credential:" + profile;
    if(ls) {
      if(kind === "write") {
        ls.setItem(lsKey, JSON.stringify(record));
        return { ok: true, backend: "localStorage" };
      }
      if(kind === "remove") {
        ls.removeItem(lsKey);
        return { ok: true, backend: "localStorage" };
      }
      let raw2 = ls.getItem(lsKey);
      let rec = null;
      if(raw2) {
        try { rec = JSON.parse(raw2); } catch(e) { rec = null; }
      }
      return { ok: true, backend: "localStorage", record: rec };
    }
  } catch(e) {}
  if(!payload._memoryCredentials) payload._memoryCredentials = {};
  let mem = payload._memoryCredentials;
  if(kind === "write") {
    mem[profile] = record;
    return { ok: true, backend: "memory" };
  }
  if(kind === "remove") {
    delete mem[profile];
    return { ok: true, backend: "memory" };
  }
  return { ok: true, backend: "memory", record: mem[profile] || null };

aiCodeToolIntegrationCredentials(opts) =>
  let o = opts || {};
  let profile = (typeof o.profile === "string" && o.profile.trim()) ? o.profile.trim() : "default";
  let store = {
    kind: "ai-code-tool-integration-credentials",
    ok: true,
    profile: profile,
    describe: function() {
      return "ai-code-tool-integration credential store | profile '" + store.profile + "' | keys kept per-user in this browser only";
    },
    toJSON: function() {
      return { ok: store.ok, kind: store.kind, profile: store.profile };
    },
    toString: function() { return store.describe(); },
    ingest: async function(raw, o2) {
      if(typeof raw !== "string" || !raw.trim()) {
        return { ok: false, code: "invalid_credential", message: "No credential value was provided to ingest()." };
      }
      let oo = o2 || {};
      let label = (typeof oo.label === "string" && oo.label.trim()) ? oo.label.trim() : null;
      let trimmed = raw.trim();
      let before = await aiCodeToolIntegrationCredentialOp("read", profile, null);
      let existed = !!(before && before.ok && before.record && before.record.secret);
      let out = await aiCodeToolIntegrationCredentialOp("write", profile, { secret: trimmed, storedAt: new Date().toISOString(), label: label });
      if(!out.ok) {
        return { ok: false, code: "credential_store_error", message: "Could not write to the credential store." };
      }
      return { ok: true, profile: profile, backend: out.backend, replaced: existed, fingerprint: aiCodeToolIntegrationFingerprint(trimmed), redacted: aiCodeToolIntegrationRedact(trimmed), storedAt: new Date().toISOString() };
    },
    has: async function() {
      let r = await aiCodeToolIntegrationCredentialOp("read", profile, null);
      return !!(r && r.ok && r.record && r.record.secret);
    },
    get: async function() {
      let r = await aiCodeToolIntegrationCredentialOp("read", profile, null);
      if(!r || !r.ok) return { ok: false, code: "credential_store_error", message: "The credential store could not be read." };
      if(!r.record || !r.record.secret) {
        return { ok: true, has: false, profile: profile, backend: r.backend, fingerprint: "(none)", redacted: "(none)", storedAt: null, label: null };
      }
      return { ok: true, has: true, profile: profile, backend: r.backend, fingerprint: aiCodeToolIntegrationFingerprint(r.record.secret), redacted: aiCodeToolIntegrationRedact(r.record.secret), storedAt: r.record.storedAt || null, label: r.record.label || null };
    },
    read: async function() {
      let r = await aiCodeToolIntegrationCredentialOp("read", profile, null);
      if(!r || !r.ok) return { ok: false, code: "credential_store_error", message: "The credential store could not be read." };
      if(!r.record || !r.record.secret) return { ok: true, has: false, value: null, profile: profile, backend: r.backend };
      return { ok: true, has: true, value: r.record.secret, profile: profile, backend: r.backend };
    },
    clear: async function() {
      let r = await aiCodeToolIntegrationCredentialOp("read", profile, null);
      let existed = !!(r && r.ok && r.record && r.record.secret);
      let out = await aiCodeToolIntegrationCredentialOp("remove", profile, null);
      if(!out.ok) return { ok: false, code: "credential_store_error", message: "Could not clear the credential store." };
      return { ok: true, cleared: existed, profile: profile, backend: out.backend };
    }
  };
  return store;

async aiCodeToolIntegrationResolveCredentials(session) =>
  if(session._secret) return { ok: true, source: "provided" };
  let profile = session.credentialProfile;
  if(!profile) {
    return { ok: false, code: "no_credentials", message: "No apiKey was provided and no credential profile is configured. Pass apiKey to the plugin, or set credential to a profile name after storing the key with aiCodeToolIntegrationCredentials().ingest(key)." };
  }
  let store = aiCodeToolIntegrationCredentials({ profile: profile });
  let r = null;
  try { r = await store.read(); } catch(e) { r = null; }
  if(!r || !r.ok) {
    return { ok: false, code: "credential_store_error", message: "The credential store could not be read while resolving profile '" + profile + "'." };
  }
  if(!r.has || !r.value) {
    return { ok: false, code: "no_credentials", message: "No stored credential for profile '" + profile + "'. Store one first, e.g. await aiCodeToolIntegrationCredentials({ profile: '" + profile + "' }).ingest(yourKey)." };
  }
  session._secret = r.value;
  session.keyFingerprint = aiCodeToolIntegrationFingerprint(r.value);
  session.credentialBackend = r.backend;
  return { ok: true, source: "store", backend: r.backend };


// ── Module 4: File System Indexing (structural context map) ──────────────
// aiCodeToolIntegrationIndexTree(source, opts) builds a normalized file tree
// {kind, name, path, size, type, children} from a local workspace so it can
// be sent to the AI as structural context (task 5 consumes it). `source` is
// one of:
//   • an injected FILE TABLE — a plain object mapping workspace-relative
//     paths to content/metadata, for sandboxed environments that have no
//     direct filesystem access (the docs demo uses this; a browser page
//     cannot enumerate local folders without the File System Access API):
//       { "main.js": "console.log(1)",
//         "src/app.js": { type: "text/javascript", bytes: "…" },
//         "assets/": null }
//     A value may be: string | Uint8Array | ArrayBuffer | Blob | DataView
//     (file bytes), a number (byte-count placeholder, content unknown),
//     null (empty text file), or a metadata object {size?, type?, bytes?
//     |content?, dir?}. A path ending in "/" (or a {dir:true} value / a
//     type of "directory") declares a DIRECTORY — the way to express empty
//     ones. "\\" separators are normalized; ".." segments and empty paths
//     are rejected loudly (never thrown), as is a path that would have to
//     be both a file and a directory.
//   • a File System Access DIRECTORY HANDLE — anything with .kind ===
//     "directory" and a .values() iterator over {name, kind} entries (real
//     or faked); walked depth-first and asynchronously. Real handles first
//     need read permission (showDirectoryPicker grants it on user gesture).
// The walk honors IGNORE RULES. Defaults (aiCodeToolIntegrationDefaultIgnores:
// node_modules, .git, .hg, .svn, .DS_Store, __pycache__, .venv, venv) plus
// opts.ignore patterns — exact segment names, *-globs on a name (e.g.
// "*.min.js"), or slash-paths matched against the workspace-relative path
// (e.g. "docs/generated/**" ignores that whole subtree). opts.ignoreDefaults
// false clears the built-ins. BINARY files are excluded by default (known
// binary extensions / binary mime types / NUL bytes in the first 1 KB when
// content is available) unless opts.includeBinaries is true — a binary file
// that sneaks into context would just waste tokens, since its bytes are not
// readable text.
// Result: the ROOT directory node — {kind:"directory", name, path:"",
// type:"directory", size: total file bytes beneath it, children:[...]},
// children sorted directories-first then alphabetically. Every node is
// {kind, name, path, size, type, children} — files carry children:null;
// directory size aggregates the file bytes below. This is a STRUCTURAL map
// only (no file contents) — task 5 reads contents back through the same
// source when building context. Any problem resolves to an {ok:false, code,
// message} error object; the function never throws.

aiCodeToolIntegrationNameMatch(name, pattern) =>
  if(typeof name !== "string" || typeof pattern !== "string") return false;
  if(pattern.indexOf("*") === -1) return name === pattern;
  let out = "^", i = 0, ch = "";
  for(i = 0; i < pattern.length; i++) {
    ch = pattern.charAt(i);
    if(ch === "*") out += "[^/]*";
    else out += ch.replace(/[.+?^${}()|[\]\\]/g, "\\$&");
  }
  out += "$";
  try { return new RegExp(out).test(name); } catch(e) { return name === pattern; }

aiCodeToolIntegrationPatternSegments(pattern) =>
  if(typeof pattern !== "string" || !pattern.trim()) return [];
  let out = [], parts = pattern.split("/"), i = 0, p = "";
  for(i = 0; i < parts.length; i++) {
    p = parts[i];
    if(p === "" || p === ".") continue;
    out.push(p);
  }
  return out;

aiCodeToolIntegrationPatternMatches(segs, pattern) =>
  if(!segs || !segs.length || typeof pattern !== "string") return false;
  if(pattern.indexOf("/") === -1) return aiCodeToolIntegrationNameMatch(segs[segs.length - 1], pattern);
  let psegs = aiCodeToolIntegrationPatternSegments(pattern);
  if(!psegs.length) return false;
  if(psegs[psegs.length - 1] === "**") psegs.pop();
  if(psegs.length > segs.length) return false;
  let i = 0;
  for(i = 0; i < psegs.length; i++) {
    if(!aiCodeToolIntegrationNameMatch(segs[i], psegs[i])) return false;
  }
  return true;

aiCodeToolIntegrationDefaultIgnores() =>
  return ["node_modules", ".git", ".hg", ".svn", ".DS_Store", "__pycache__", ".venv", "venv"];

aiCodeToolIntegrationIsIgnored(segs, patterns) =>
  if(!segs || !segs.length || !patterns || !patterns.length) return false;
  let i = 0;
  for(i = 0; i < patterns.length; i++) {
    if(aiCodeToolIntegrationPatternMatches(segs, patterns[i])) return true;
  }
  return false;

aiCodeToolIntegrationTextExtMime() =>
  return {
    js: "text/javascript", mjs: "text/javascript", cjs: "text/javascript", jsx: "text/jsx",
    ts: "text/typescript", tsx: "text/tsx", json: "application/json", jsonc: "application/json",
    map: "application/json", ipynb: "application/json", webmanifest: "application/manifest+json",
    md: "text/markdown", markdown: "text/markdown", txt: "text/plain", text: "text/plain",
    html: "text/html", htm: "text/html", css: "text/css", scss: "text/scss", sass: "text/sass", less: "text/less",
    xml: "application/xml", svg: "image/svg+xml", yml: "application/yaml", yaml: "application/yaml", toml: "application/toml",
    ini: "text/plain", cfg: "text/plain", conf: "text/plain", env: "text/plain", lock: "text/plain",
    py: "text/x-python", rb: "text/x-ruby", go: "text/x-go", rs: "text/x-rust",
    java: "text/x-java", kt: "text/x-kotlin", kts: "text/x-kotlin", swift: "text/x-swift",
    c: "text/x-c", h: "text/x-c-header", cpp: "text/x-c++", hpp: "text/x-c++-header", cc: "text/x-c++", cs: "text/x-csharp",
    php: "text/x-php", sh: "text/x-shellscript", bash: "text/x-shellscript", zsh: "text/x-shellscript", fish: "text/x-shellscript",
    bat: "text/x-batch", cmd: "text/x-batch", ps1: "text/x-powershell",
