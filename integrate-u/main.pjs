$meta
  title = Integrate-U — Project U integration hub
  description = The integration hub for the Project U family of small-business generators. Integrate-U gives IT-U, CRM-U, PSA-U and RMM-U one canonical identity, a shared integration registry with field ownership and sync rules, a versioned event bus, cross-tool entity linking, drift-aware sync, exportable data bundles, and connector monitoring.
  tags = integration hub, project u, it-u, crm-u, psa-u, rmm-u, identity, event bus, registry, sync, dashboard
  header
    mode = minimal

// ============================================================================
//  INTEGRATE-U — BOOT CONFIGURATION
// ----------------------------------------------------------------------------
//  Declarative configuration read by src/framework/config.js at startup.
//  Implementation belongs in src/; this block holds identity, branding and
//  tunables only. See src/README.md and src/CUSTOMIZATION.md for what to
//  change when deploying your own hub.
// ============================================================================

kv = {import:kv-plugin}

pu
  appId = integrate-u
  appTitle = Integrate-U
  appShortTitle = IU
  tagline = One identity, one registry, every Project U tool
  companyName = Project U
  version = 0.1.0
  storageNamespace = pu-integrate-u
  defaultTheme = navy
  logoMark = IU
  copyright = Project U
  docsUrl = https://perchance.org/template-u

  branding
    primary = #1e3a8a
    accent = #0d9488
    fontSans = Inter


