// ─────────────────────────────────────────────
//  BGN WORD SEARCH — main.pjs (config + data)
//  A word search game for The Boardgame Network
//  (perchance.org/bgn-boardgame-network).
//
//  The game logic lives in index.html; this file
//  holds the metadata, the shared leaderboard
//  config, the difficulty tuning, the theme list
//  and the word bank.
//
//  Sections below: metadata · leaderboard ·
//  game config · themes · word bank.
// ─────────────────────────────────────────────

$meta
  title = Word Search
  description = A word search game from The Boardgame Network — fresh puzzles every play, pick a theme (Animals, Food, Nature and more), three difficulties, a timer, hints, a shared leaderboard, a Daily Challenge where everyone races the same grid, or type your own words for a custom puzzle. Find every hidden word before the clock runs out.
  tags = word search, puzzle, word, game, bgn, board game, timer, leaderboard, themes, daily challenge, custom puzzle
  image = https://user.uploads.dev/file/9ee0cab834d1f83e87417277178f65ed.jpg

// ─────────────────────────────────────────────
//  BGN NETWORK — chrome config + multiplayer.
//  The BGN nav bar / hero / footer in index.html
//  read these values to frame the game.
// ─────────────────────────────────────────────

hubUrl = https://perchance.org/bgn-boardgame-network
gameTitle = Word Search
gameTagline = Solo, hotseat or online — fresh word-search puzzles from The Boardgame Network
gameKicker = Find every word
gameGenre = Puzzle
gamePlayers = 1-2 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/a80630e1c2b814e9888b71bb63fdcc5b.jpg

createServerSocket = {import:server-plugin}

uploadPlugin = {import:upload-plugin}

// Shared leaderboard: a single public editable text file in this generator's
// namespace. Anyone can read it; the game updates it with the edit key below.
// The key is public source by design: this is how a shared, crowd-editable
// board works.
leaderboardFileName = wslblwt00h3elw5lb1sqz68z
leaderboardEditKey = ATSf0sw7pBhGB8gO0M_5o4b6sX0IHjHgRy99LBOwM1Q

// ─────────────────────────────────────────────
//  GAME CONFIG — word search difficulty tuning.
//  The shell in index.html reads these values
//  and builds the grids.
// ─────────────────────────────────────────────

// grid width/height in letters
wsSizeEasy = 10
wsSizeMedium = 12
wsSizeHard = 14
// how many words are hidden per difficulty
wsWordsEasy = 6
wsWordsMedium = 10
wsWordsHard = 14
// longest word allowed per difficulty
wsMaxLenEasy = 8
wsMaxLenMedium = 10
wsMaxLenHard = 12
// shortest word allowed (any difficulty)
wsMinLen = 3
// daily challenge — everyone gets the SAME grid, once a day
// (generated deterministically from the date; resets at midnight UTC)
wsDailySize = 12
wsDailyWords = 10
wsDailyMaxLen = 10
// seconds added to your finish time per hint
hintPenaltySeconds = 30

// ─────────────────────────────────────────────
//  THEMES — the puzzle categories shown above
//  the board. "Mixed" uses every word in the
//  bank; each other theme uses only words whose
//  `theme` child matches its name. Add your own
//  themes here and tag words with them below.
// ─────────────────────────────────────────────
themes
  theme
    name = Mixed
    desc = Every kind of word mixed together
  theme
    name = Animals
    desc = Creatures big and small
  theme
    name = Food
    desc = Meals, treats and drinks
  theme
    name = Nature
    desc = Land, sea, sky and weather
  theme
    name = Home
    desc = Rooms, things and clothes
  theme
    name = Body
    desc = Parts of the human body
  theme
    name = Feelings
    desc = Moods, traits and experiences
  theme
    name = Actions
    desc = Verbs — things you do
  theme
    name = School & Tech
    desc = Learning, gadgets and science
  theme
    name = Sports
    desc = Games you play to win

// ─────────────────────────────────────────────
//  WORD BANK — every word the puzzle generator
//  draws from. Give each word a name, then
//  `word = ...` (the letters to hide in the
//  grid), `clue = ...` (shown under the word in
//  the word list) and `theme = ...` (one of the
//  themes above — it lands in "Mixed" either
//  way). The shortest words allowed are set by
//  `wsMinLen` above.
// ─────────────────────────────────────────────
words
  cat
    word = CAT
    clue = Small pet that purrs
    theme = animals
