# Perchance capture output is LF; keep it that way regardless of core.autocrlf.
#
# This is not only a tidiness rule. Every file under a slug's src/ has a byte size declared in
# that slug's meta.json srcManifest, and that declared size is the only integrity check this repo
# has -- it is what proves a capture downloaded a whole file rather than a truncated one. A CRLF
# conversion changes the byte size of every text file it touches and would break that check
# repo-wide, turning the one available proof of completeness into noise. So every text extension
# that appears under src/ must be pinned here.
*.txt           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.js            text eol=lf
*.pjs           text eol=lf
*.html          text eol=lf
# Added 2026-08-14 with the srcManifest backfill, which introduced these under src/.
*.css           text eol=lf
*.ts            text eol=lf
*.jsx           text eol=lf
LICENSE         text eol=lf
.gitattributes  text eol=lf

# Binary srcManifest payloads -- srcManifest declares sizes for these too, so any conversion
# corrupts both the file and the check. Marked explicitly rather than left to auto-detection.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.zip           binary
