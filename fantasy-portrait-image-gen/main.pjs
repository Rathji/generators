// helpers referenced by the 🎲 Random options inside the lists above
pickFromOptions(list, tag=null) =>
  let arr = list.getAllKeys.map(key => list[key]).filter(item => !item.skip);
  if (tag) arr = arr.filter(item => item[tag] == 1);
  if (arr.length === 0) return "";
  return arr[Math.floor(Math.random() * arr.length)].prompt.evaluateItem;

pickLocation(tag=null) =>
  return pickFromOptions(frLocation, tag);


