$meta
  title = Necropolis Prime
  description = A fully explorable, procedurally generated city of the dead. Wander its avenues, read the epitaphs of the buried, speak with the spirits who linger, and gather the seven Soul Sigils to open the Sanctum at its heart. Every seed builds a new city.
  tags = 3d, procedural, exploration, necropolis, dark fantasy, atmospheric, threejs, first-person
  image = https://user.uploads.dev/file/a0df3bd817c7072b39fda30976eb498b.png

generateText = {import:ai-text-plugin}
kv = {import:kv-plugin}

// =====================================================================
//  CONFIG — tweak these to reshape the city
// =====================================================================
config
  seed = 0                  // non-zero = fixed city; 0 = random per session (New City re-rolls)
  avenueCount = 14          // radial avenues (spokes)
  cityRadius = 250          // outer wall radius
  fogDensity = 0.0072        // thicker = more claustrophobic
  spiritCount = 12          // wandering spirits
  sigilsRequired = 7        // sigils needed to open the Sanctum
  walkSpeed = 5.2
  sprintSpeed = 9.0
  eyeHeight = 1.7
  bloom = 1                // 0 disables post-processing (bloom)
  quality = auto           // auto | 1 (full) | 0 (reduced: smaller shadows, fewer motes, lower render scale)

// =====================================================================
//  NAME + EPITAPH FRAGMENTS  (assembled in src/necropolis/inscriptions.js)
// =====================================================================
