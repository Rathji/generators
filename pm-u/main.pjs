// ═══════════════════════════════════════════════════════════════════════════
// PM-U — Project Manager member of the Project U family
// Built on the Template-U framework (https://perchance.org/template-u).
// Feature baseline forked from project-master.
//
// All data is stored LOCALLY in the browser (IndexedDB via the kv-plugin).
// Nothing is ever uploaded to a server.
//
// Architecture notes: see src/README.md
// ═══════════════════════════════════════════════════════════════════════════

$meta
  title = PM-U — Project Manager
  description = PM-U is the Project Manager member of the Project U family — a local-first workspace for portfolios, projects, tasks, a calendar, boards, notes, habits, a focus timer and weekly reporting. Built on the Template-U framework; all data stays in your browser and nothing is uploaded.
  image = https://user.uploads.dev/file/cf37cfe7076ca9ea08bd3d865812937f.png
  tags = project manager, project management, projects, tasks, portfolio, kanban, gantt, calendar, local-first, project u, small business
  header
    mode = minimal

// ── plugins ────────────────────────────────────────────────────────────────
kv = {import:kv-plugin}
generateText = {import:ai-text-plugin}

// ── PM-U / Template-U configuration ────────────────────────────────────────
// read by src/app.js (readConfig) and src/framework/branding.js. Member
// generators rebrand by editing this block alone — no code changes required.
pu
  appTitle = PM-U
  appShortTitle = PMU
  tagline = Project Manager for the Project U family
  companyName = Project U
  version = 0.1.0
  storageNamespace = pu-pm
  defaultTheme = navy
  logoMark = PMU
  footer = Project U
  branding
    primary = #1e3a8a
    accent = #0d9488
    fontSans = Inter

// ── display title ──────────────────────────────────────────────────────────
title = Project Manager
