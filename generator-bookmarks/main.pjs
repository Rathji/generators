$meta
  title = Generator Bookmarks
  description = A personal bookmark manager — store, tag, search and organise your links. Backed by kv storage (saved on your device, survives reloads) with full import/export.
  tags = bookmarks, links, organizer, kv, storage, rathji
  header
    mode = minimal

kv = {import:kv-plugin}
superFetch = {import:super-fetch-plugin}
generateText = {import:ai-text-plugin}
uploadPlugin = {import:upload-plugin}

// ═══════════════════════════════════════════════════════════════════════════════
