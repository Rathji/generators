// ─────────────────────────────────────────────────────────────
//  ALL ABOARD! — a Ticket-to-Ride-style train game for Perchance
//  Config + branding live here; the game (map, decks, routes,
//  scoring, AI, board rendering) is built in index.html following
//  the atomic backlog in src/roadmap.pjs. The server-plugin
//  import powers online 2-player matches.
// ─────────────────────────────────────────────────────────────

$meta
  title = All Aboard!
  description = A complete Ticket-to-Ride-style board game for Perchance — claim colored rail routes across North America, complete destination tickets, and build the longest railroad to win. Play locally (2–5 players), against AI, or online with a friend.
  tags = board game, ticket to ride, trains, route building, strategy, multiplayer, online, 2-5 players
  image = https://user.uploads.dev/file/4cea7a6943647d896f1b07511d54118c.jpg
  header
    mode = minimal

hubUrl = https://perchance.org/bgn-boardgame-network  // ← hub this game belongs to (Boardgame Network)
projectsUrl = https://perchance.org/rathjis-generators  // ← shown as "Rathji's Projects" in the top nav
authorInitial = R  // initial shown on the "Rathji's Projects" badge
gameTitle = All Aboard!
gameTagline = Claim the rails, connect the cities, ride to victory — a Ticket-to-Ride-style race across North America.
gameKicker = Draw · Claim · Connect
gameGenre = Board Game
gamePlayers = 2–5 players
accentColor = #e0a53a
heroImage = https://user.uploads.dev/file/4cea7a6943647d896f1b07511d54118c.jpg

// Playing table backgrounds — select with [tableGraphics.selectOne], or access by id (root.tableGraphics.slate.url)
tableGraphics
  slate
    name = Slate
    url = https://user.uploads.dev/file/1c3362ef12b434367c151198fb9ba97c.jpg
  forge
    name = Forge
    url = https://user.uploads.dev/file/5756a746265c584ac77a701221aff3d7.jpg
  ember
    name = Ember
    url = https://user.uploads.dev/file/39143b5b1c649c5c07a5a54bccb9d09f.jpg

createServerSocket = {import:server-plugin}
