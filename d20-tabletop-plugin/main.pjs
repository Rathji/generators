    "You cast Fly on a random creature within 60 ft.",
    "You briefly slip into the Astral Plane until the end of your next turn, then return.",
    "Your hands glow; unarmed strikes deal an extra 1d4 fire for 1 minute.",
    "A rain of small fish falls in a 30 ft radius.",
    "You are soaked to the bone; harmless.",
    "A spectral wolf growls at a random creature, then vanishes.",
    "You glow faintly; attacks against you have advantage for 1 minute.",
    "You cast Confusion on yourself; on a failed save you are confused for 1 minute.",
    "The floor in a 5 ft radius turns to ice; DC 10 DEX or you fall prone.",
    "Your gender swaps until you finish a long rest.",
    "Your voice echoes for 1 hour; creatures always know where you are.",
    "A minor illusion of a dragon appears overhead, frightening nearby creatures.",
    "You cast Fireball centered on a random creature within 60 ft.",
    "A spectral griffin carries you 30 ft straight up, then drops you.",
    "Your clothes change style and color for 24 hours.",
    "You cast Darkness centered on yourself for 1 minute.",
    "A strong wind surrounds you for 1 minute; ranged attacks against you are disadvantaged.",
    "You gain temporary hit points equal to 5 × your proficiency bonus.",
    "You lose your voice for 1 minute (no verbal spell components).",
    "A swarm of butterflies surrounds you; +2 to stealth checks for 1 minute.",
    "You cast Shield; your AC increases by 5 until your next turn.",
    "A ghostly hand pats your head. Harmless.",
    "You teleport to a random point within 30 ft (DM's choice).",
    "Your shadow dances independently for 1 minute.",
    "A spectral crown appears on your head; advantage on Charisma checks for 1 minute.",
    "You cast Feather Fall; you float gently for 1 minute.",
    "A random commoner materializes nearby, confused, then fades.",
    "Your reflection winks at you for 1 minute.",
    "You heal for 5 × your proficiency bonus.",
    "A spectral trumpeter announces your presence; loud but harmless.",
    "You cast Charm Person on the nearest creature.",
    "You gain tremorsense out to 30 ft for 1 minute.",
    "Your eyes turn silver; you gain darkvision for 1 hour.",
    "A spectral bell tolls; creatures within 30 ft make a WIS save or become frightened.",
    "You become invisible, but only while standing perfectly still.",
    "A gust of wind snuffs all candles and torches within 30 ft.",
    "You cast Thunderwave centered on yourself.",
    "A spectral frog sits on your head for 1 hour; it croaks on command.",
    "Your weight doubles for 1 hour; you are encumbered.",
    "Your weight halves for 1 hour; you can leap twice as far.",
    "You cast Disguise Self, appearing as your ideal self.",
    "A spectral hound barks at anything that comes within 10 ft.",
    "You gain a +1 bonus to AC for 1 minute.",
    "Your weapon glows; your next attack deals an extra 1d6 force.",
    "A torrent of water erupts from your mouth for 1 round; harmless.",
    "You cast Sleep on the nearest creature with the fewest hit points.",
    "You grow gills for 1 hour; you can breathe water but not air.",
    "A spectral door appears in the air, slams shut, and fades.",
    "You are doused in glitter; easy to spot for 1 hour.",
    "You cast Expeditious Retreat; your speed doubles for 1 minute.",
    "A spectral cat winds between your legs, purring, then fades.",
    "You hiccup loudly for 1 minute; disadvantage on stealth checks.",
    "Your skin becomes bark-like; +1 AC for 1 hour.",
    "A faint aurora swirls above your head for 1 minute.",
    "You cast Mending on the nearest damaged object.",
    "A spectral eagle lands on your shoulder, gives you a fish, and flies off.",
    "You swap places with the nearest creature.",
    "A shower of golden sparks heals the nearest wounded creature for 1d4.",
    "You cast Light on the nearest object; it glows for 1 hour.",
    "A spectral knight salutes you, then dissolves.",
    "Good fortune: your next attack roll has advantage.",
    "Bad luck: your next saving throw has disadvantage.",
    "A spectral spider spins a web across a nearby doorway; harmless.",
    "You sneeze a cloud of glitter; the 10 ft area is lightly obscured for 1 round.",
    "You cast Jump; your jump distance triples for 1 minute.",
    "A spectral lute plays a jaunty tune; flavor only.",
    "A small rift to the Feywild opens for a moment; a pixie giggles and leaves.",
    "You regain your lowest-level expended spell slot, if any."];


d20WildMagicOutcome(opts) =>
  let o = opts || {};
  let roll = o.roll != null ? Math.max(1, Math.min(100, Math.floor(Number(o.roll)))) : Math.floor(Math.random() * 100) + 1;
  return { roll, effect: d20WildMagicTable()[roll - 1] };

d20WildMagicDispatch(state, opts) =>
  let o = opts || {};
  let trig = d20WildMagicTrigger({ fixed: o.roll20 });
  if(!trig.surge) return { surge: false, roll20: trig.roll };
  let outcome = d20WildMagicOutcome({ roll: o.roll100 });
  state.surges++;
  state.lastSurge = outcome.effect;
  return { surge: true, roll20: trig.roll, roll100: outcome.roll, effect: outcome.effect, surges: state.surges };

// Item 108 — Metamagic modifier engine.
d20MetamagicOptions() =>
  return [
    { name: "careful", baseCost: 1, perLevel: false, effect: "allies you choose automatically succeed their save" },
    { name: "distant", baseCost: 1, perLevel: false, effect: "spell range doubled, or touch becomes 30 ft" },
    { name: "empowered", baseCost: 1, perLevel: false, effect: "reroll up to 5 damage dice when you roll damage" },
    { name: "extended", baseCost: 1, perLevel: false, effect: "spell duration doubled (minimum 1 minute)" },
    { name: "heightened", baseCost: 3, perLevel: false, effect: "one target has disadvantage on its first saving throw" },
    { name: "quickened", baseCost: 2, perLevel: false, effect: "cast the spell as a bonus action instead of an action" },
    { name: "subtle", baseCost: 1, perLevel: false, effect: "cast with no verbal or somatic components" },
    { name: "twinned", baseCost: 1, perLevel: true, effect: "target a second creature within range with the same spell" }];

d20MetamagicFind(name) =>
  let n = String(name || "").toLowerCase();
  let opts = d20MetamagicOptions();
  for(let i = 0; i < opts.length; i++) { if(opts[i].name === n) return opts[i]; }
  return null;

d20MetamagicCost(option, spellLevel) =>
  let opt = typeof option === "string" ? d20MetamagicFind(option) : option;
  if(!opt) return { error: "unknown metamagic: " + String(option) };
  let cost = Number(opt.baseCost) || 0;
  if(opt.perLevel) cost += Math.max(0, Number(spellLevel) || 0) - 1;
  return { name: opt.name, cost, perLevel: !!opt.perLevel, effect: opt.effect };

d20MetamagicValidate(sorceryPoints, option, spellLevel, opts) =>
  let o = opts || {};
  let cost = d20MetamagicCost(option, spellLevel);
  if(cost.error) return cost;
  let sp = Number(sorceryPoints) || 0;
  if(sp < cost.cost) return { ok: false, reason: "not enough sorcery points (need " + cost.cost + ", have " + sp + ")", cost };
  if(cost.name === "twinned") {
    if(o.target === "self") return { ok: false, reason: "twinned spell cannot target yourself", cost };
    if(o.multiTarget) return { ok: false, reason: "twinned spell requires a single-target spell", cost };
  }
  return { ok: true, cost };

d20MetamagicApply(state, option, spellLevel, opts) =>
  let o = opts || {};
  let v = d20MetamagicValidate(state.sp, option, spellLevel, o);
  if(!v.ok) return v;
  state.sp -= v.cost.cost;
  return { ok: true, metamagic: v.cost.name, cost: v.cost.cost, sp: state.sp, effect: v.cost.effect };

// Item 109 — Homebrew entity & spell builder.
d20HomebrewStore(state, kind) =>
  if(state[kind] !== undefined) return state[kind];
  if(state[kind + "s"] !== undefined) return state[kind + "s"];
  return null;

d20HomebrewRegistry() =>
  return { monsters: {}, items: {}, spells: {}, schemas: {} };

d20HomebrewSchema(state, kind, schema) =>
  let k = kind;
  if(state.schemas[kind] === undefined && state.schemas[kind.replace(/s$/, "")] !== undefined) k = kind.replace(/s$/, "");
  state.schemas[k] = d20Schema(schema);
  return state.schemas[k];

d20HomebrewValidate(state, kind, def) =>
  let schema = state.schemas[kind] || state.schemas[kind.replace(/s$/, "")];
  if(!schema) return { ok: true, problems: [], data: Object.assign({}, def || {}), note: "no schema for " + kind + " — skipped" };
  let applied = d20SchemaApplyDefaults(Object.assign({}, def || {}), schema);
  let res = d20SchemaValidate(applied, schema);
  return { ok: res.ok, problems: res.problems, data: applied };

d20HomebrewRegister(state, kind, def, opts) =>
  let o = opts || {};
  let store = d20HomebrewStore(state, kind);
  if(!store) return { error: "unknown homebrew kind: " + kind };
  let v = d20HomebrewValidate(state, kind, def);
  if(!v.ok) return { ok: false, reason: "validation failed", problems: v.problems };
  let name = (o.name != null ? o.name : (def && def.name)) || "entity";
  if(store[name] && !o.overwrite) return { ok: false, reason: name + " already registered" };
  let entry = Object.assign({ kind, name }, v.data, def || {});
  store[name] = entry;
  return { ok: true, kind, name, entry };

d20HomebrewBuild(state, kind, name) =>
  let store = d20HomebrewStore(state, kind);
  if(!store) return { error: "unknown homebrew kind: " + kind };
  if(!store[name]) return { error: "not found: " + name };
  return store[name];

d20HomebrewList(state, kind) =>
  let store = d20HomebrewStore(state, kind);
  if(!store) return { error: "unknown homebrew kind: " + kind };
  return Object.keys(store).map(function(n) { return store[n]; });

// Item 110 — CR estimator from DPR, attack bonus, effective AC/HP, immunities.
d20CRFromHP(hp) =>
  let h = Math.max(0, Number(hp) || 0);
  let thresholds = [[6, "0"], [35, "1/8"], [49, "1/4"], [70, "1/2"], [85, "1"], [100, "2"], [115, "3"], [130, "4"], [145, "5"], [160, "6"], [175, "7"], [190, "8"], [205, "9"], [220, "10"], [235, "11"], [250, "12"], [265, "13"], [280, "14"], [295, "15"], [310, "16"], [325, "17"], [340, "18"], [355, "19"], [400, "20"], [445, "21"], [490, "22"], [535, "23"], [580, "24"], [625, "25"], [670, "26"], [715, "27"], [760, "28"], [805, "29"], [850, "30"]];
  let cr = "30";
  for(let i = 0; i < thresholds.length; i++) { if(h <= thresholds[i][0]) { cr = thresholds[i][1]; break; } }
  return cr;

d20CRFromDPR(dpr) =>
  let d = Math.max(0, Number(dpr) || 0);
  let thresholds = [[1, "0"], [3, "1/8"], [5, "1/4"], [8, "1/2"], [14, "1"], [20, "2"], [26, "3"], [32, "4"], [38, "5"], [44, "6"], [50, "7"], [56, "8"], [62, "9"], [68, "10"], [74, "11"], [80, "12"], [86, "13"], [92, "14"], [98, "15"], [104, "16"], [110, "17"], [116, "18"], [122, "19"], [140, "20"], [158, "21"], [176, "22"], [194, "23"], [212, "24"], [230, "25"], [248, "26"], [266, "27"], [284, "28"], [302, "29"], [320, "30"]];
  let cr = "30";
  for(let i = 0; i < thresholds.length; i++) { if(d <= thresholds[i][0]) { cr = thresholds[i][1]; break; } }
  return cr;

d20CRLabel(value) =>
  let v = Number(value) || 0;
  if(v <= 0) return "0";
  if(v < 1) {
    if(v <= 0.2) return "1/8";
    if(v <= 0.35) return "1/4";
    return "1/2";
  }
  return String(Math.round(v));

d20ExpectedAC(cr) =>
  let v = d20CRValue(cr).value || 0;
  return 13 + Math.floor(v / 2);

d20ExpectedAttackBonus(cr) =>
  let v = d20CRValue(cr).value || 0;
  return 3 + Math.floor(v / 2);

d20CRAssess(opts) =>
  let o = opts || {};
  let hp = Math.max(0, Number(o.hp) || 0);
  let ac = Math.max(0, Number(o.ac) || 0);
  let dpr = Math.max(0, Number(o.dpr) || 0);
  let ab = Number(o.attackBonus) || 0;
  let immunities = Array.isArray(o.immunities) ? o.immunities.length : (o.immunities ? 1 : 0);
  let effectiveHp = hp * (1 + Math.min(0.5, immunities * 0.1));
  let defBase = d20CRFromHP(effectiveHp);
  let defValue = d20CRValue(defBase).value || 0;
  let acAdjust = Math.floor((ac - d20ExpectedAC(defBase)) / 2);
  defValue = Math.max(0, defValue + acAdjust);
  let offBase = d20CRFromDPR(dpr);
  let offValue = d20CRValue(offBase).value || 0;
  let abAdjust = Math.floor((ab - d20ExpectedAttackBonus(offBase)) / 2);
  offValue = Math.max(0, offValue + abAdjust);
  let finalValue = (defValue + offValue) / 2;
  return { hp: Math.floor(effectiveHp), ac, dpr, attackBonus: ab, immunities, acAdjust, attackAdjust: abAdjust, defensiveCR: d20CRLabel(defValue), offensiveCR: d20CRLabel(offValue), cr: d20CRLabel(finalValue), value: finalValue };

// ────────────────────────────────────────────────────────────────────
//  Phases 37–40: Campaign Tooling, Dimensional Travel & Batch Resolution
// ────────────────────────────────────────────────────────────────────

// Item 111 — Point-budget trait & race builder.
d20PointBudgetTraits() =>
  return [
    { name: "darkvision60", cost: 2, note: "darkvision 60 ft" },
    { name: "darkvision120", cost: 4, note: "darkvision 120 ft" },
    { name: "abilityBump", cost: 2, note: "+1 to one ability score" },
    { name: "skillProficiency", cost: 1, note: "proficiency in one skill" },
    { name: "toolProficiency", cost: 1, note: "proficiency in one tool" },
    { name: "extraLanguage", cost: 1, note: "one extra language" },
    { name: "weaponProficiency", cost: 1, note: "proficiency with one weapon group" },
    { name: "armorProficiency", cost: 2, note: "proficiency with one armor type" },
    { name: "cantrip", cost: 2, note: "one cantrip of your choice" },
    { name: "naturalWeapon", cost: 2, note: "natural weapon dealing 1d6 damage" },
    { name: "climbingSpeed", cost: 2, note: "climbing speed equal to walking speed" },
    { name: "swimmingSpeed", cost: 2, note: "swimming speed equal to walking speed" },
    { name: "amphibious", cost: 2, note: "can breathe air and water" },
    { name: "resistance", cost: 3, note: "resistance to one damage type" },
    { name: "telepathy", cost: 3, note: "telepathy within 30 ft" },
    { name: "poisonImmunity", cost: 3, note: "immunity to poison damage and the poisoned condition" },
    { name: "extraArms", cost: 4, note: "a second pair of arms" },
    { name: "flight", cost: 8, note: "flying speed of 30 ft" }];

d20PointBudgetTrait(name) =>
  let list = d20PointBudgetTraits();
  let n = String(name || "").toLowerCase().replace(/[^a-z0-9]/g, "");
  for(let i = 0; i < list.length; i++) {
    if(list[i].name.toLowerCase().replace(/[^a-z0-9]/g, "") === n) return list[i];
  }
  return null;

d20PointBudgetCost(traits) =>
  let list = Array.isArray(traits) ? traits : [];
  let cost = 0, unknown = [], detail = [];
  for(let i = 0; i < list.length; i++) {
    let raw = list[i];
    let t = typeof raw === "string" ? d20PointBudgetTrait(raw) : d20PointBudgetTrait(raw && raw.name);
    if(!t) { unknown.push(String(raw && raw.name || raw)); continue; }
    cost += t.cost;
    detail.push(t);
  }
  return { cost, unknown, detail };

d20PointBudgetBuild(opts) =>
  let o = opts || {};
  let budget = Math.max(1, Number(o.budget) || 10);
  let traits = Array.isArray(o.traits) ? o.traits : [];
  let c = d20PointBudgetCost(traits);
  let over = c.cost > budget;
  let problems = [];
  if(over) problems.push("traits cost " + c.cost + " points, over the " + budget + " budget");
  if(c.unknown.length) problems.push("unknown traits: " + c.unknown.join(", "));
  return {
    name: o.name || "unnamed lineage", budget, traits: traits.slice(), cost: c.cost,
    remaining: Math.max(0, budget - c.cost), overBudget: over,
    ok: !over && c.unknown.length === 0, problems,
    note: over ? "reduce trait selection" : (c.unknown.length ? "fix unknown traits" : "within budget")
  };

// Item 112 — Quest state machine.
d20QuestState(opts) =>
  return { quests: {}, order: [], counter: 0 };

d20QuestAdd(state, quest, opts) =>
  let o = opts || {};
  let id = quest && quest.id ? String(quest.id) : "q" + (++state.counter);
  if(state.quests[id]) return { error: "quest already exists: " + id };
  let entry = { id, title: (quest && quest.title) || id, status: o.start ? "active" : "not_started", xp: quest && quest.xp != null ? Number(quest.xp) : 0, history: [{ status: o.start ? "active" : "not_started", at: Date.now() }] };
  for(let k in quest || {}) { if(entry[k] === undefined && k !== "id") entry[k] = quest[k]; }
  state.quests[id] = entry;
  state.order.push(id);
  return entry;

d20QuestSet(state, id, status) =>
  let q = state.quests[id];
  if(!q) return { error: "unknown quest: " + id };
  let allowed = { not_started: ["active", "abandoned"], active: ["completed", "failed", "abandoned"], completed: [], failed: [], abandoned: [] };
  if((allowed[q.status] || []).indexOf(status) === -1) return { error: "cannot go from " + q.status + " to " + status };
  q.status = status;
  q.history.push({ status, at: Date.now() });
  return q;

d20QuestStart(state, id) =>
  return d20QuestSet(state, id, "active");

d20QuestComplete(state, id) =>
  return d20QuestSet(state, id, "completed");

d20QuestFail(state, id) =>
  return d20QuestSet(state, id, "failed");

d20QuestAbandon(state, id) =>
  return d20QuestSet(state, id, "abandoned");

d20QuestStatus(state, id) =>
  let q = state.quests[id];
  return q ? q.status : { error: "unknown quest: " + id };

d20QuestList(state, filter) =>
  let out = [];
  for(let i = 0; i < state.order.length; i++) {
    let q = state.quests[state.order[i]];
    if(filter && q.status !== filter) continue;
    out.push(q);
  }
  return out;

// Item 113 — Branching sub-objective tracker.
d20ObjectiveState(opts) =>
  return { objectives: {}, counter: 0 };

d20ObjectiveAdd(state, obj, opts) =>
  let o = opts || {};
  let id = obj && obj.id ? String(obj.id) : "obj" + (++state.counter);
  if(state.objectives[id]) return { error: "objective already exists: " + id };
  let entry = { id, title: (obj && obj.title) || id, status: "pending", mandatory: !!(obj && obj.mandatory), prereqs: Array.isArray(obj && obj.prereqs) ? obj.prereqs.slice() : [], branch: (obj && obj.branch) || null };
  state.objectives[id] = entry;
  return entry;

d20ObjectivePrereqsMet(state, id) =>
  let e = state.objectives[id];
  if(!e) return { error: "unknown objective: " + id };
  let unmet = [];
  for(let i = 0; i < e.prereqs.length; i++) {
    let p = state.objectives[e.prereqs[i]];
    if(!p || p.status !== "completed") unmet.push(e.prereqs[i]);
  }
  return { met: unmet.length === 0, unmet };

d20ObjectiveCanStart(state, id) =>
  let e = state.objectives[id];
  if(!e) return { error: "unknown objective: " + id };
  if(e.status === "skipped") return { ok: false, reason: "skipped by exclusive branch" };
  if(e.status === "completed") return { ok: false, reason: "already completed" };
  let m = d20ObjectivePrereqsMet(state, id);
  if(!m.met) return { ok: false, reason: "prereqs unmet: " + m.unmet.join(", ") };
  return { ok: true };

d20ObjectiveStart(state, id) =>
  let e = state.objectives[id];
  if(!e) return { error: "unknown objective: " + id };
  let c = d20ObjectiveCanStart(state, id);
  if(!c.ok) return { ok: false, reason: c.reason };
  e.status = "active";
  return e;

d20ObjectiveComplete(state, id) =>
  let e = state.objectives[id];
  if(!e) return { error: "unknown objective: " + id };
  if(e.status !== "active") return { ok: false, reason: "objective is not active (" + e.status + ")" };
  e.status = "completed";
  if(e.branch) {
    for(let k in state.objectives) {
      let other = state.objectives[k];
      if(other.branch === e.branch && other.id !== e.id && (other.status === "pending" || other.status === "active")) other.status = "skipped";
    }
  }
  return e;

d20ObjectiveAvailable(state, id) =>
  let e = state.objectives[id];
  if(!e) return { error: "unknown objective: " + id };
  return { available: e.status === "pending" || e.status === "active", status: e.status, prereqsMet: d20ObjectivePrereqsMet(state, id).met };

d20ObjectiveList(state, opts) =>
  let o = opts || {};
  let out = [];
  for(let k in state.objectives) {
    let e = state.objectives[k];
    if(o.status && e.status !== o.status) continue;
    if(o.branch && e.branch !== o.branch) continue;
    out.push(e);
  }
  return out;

d20ObjectiveSummary(state) =>
  let counts = { pending: 0, active: 0, completed: 0, skipped: 0 };
  let mandatoryLeft = 0;
  for(let k in state.objectives) {
    let e = state.objectives[k];
    counts[e.status] = (counts[e.status] || 0) + 1;
    if(e.mandatory && e.status !== "completed") mandatoryLeft++;
  }
  return { total: Object.keys(state.objectives).length, counts, mandatoryLeft, allMandatoryDone: mandatoryLeft === 0 };

// Item 114 — Milestone reward dispatcher.
d20RewardState(opts) =>
  let o = opts || {};
  return { xp: Number(o.xp) || 0, reputation: Object.assign({}, o.reputation || {}), levelUps: Number(o.levelUps) || 0, items: Array.isArray(o.items) ? o.items.slice() : [], log: [] };

d20RewardDispatch(state, reward, opts) =>
  let r = reward || {};
  let xp = Math.max(0, Number(r.xp) || 0);
  let beforeLevel = d20LevelFromXP(state.xp);
  state.xp += xp;
  let afterLevel = d20LevelFromXP(state.xp);
  let levelGained = Math.max(0, afterLevel - beforeLevel);
  let reps = {};
  for(let f in (r.reputation || {})) { state.reputation[f] = (state.reputation[f] || 0) + Number(r.reputation[f]); reps[f] = Number(r.reputation[f]); }
  let levelUps = Math.max(0, Number(r.levelUp) || 0);
  state.levelUps += levelUps;
  let items = Array.isArray(r.items) ? r.items.slice() : [];
  state.items = state.items.concat(items);
  let entry = { at: Date.now(), name: r.name || "milestone", xp, levelBefore: beforeLevel, levelAfter: afterLevel, levelGained, levelUp: levelUps, reputation: reps, items: items.length };
  state.log.push(entry);
  return { ok: true, entry };

d20RewardPartyXP(state, xp, opts) =>
  let amount = Math.max(0, Number(xp) || 0);
  return d20RewardDispatch(state, { name: (opts && opts.name) || "party XP", xp: amount });

d20RewardLevelUp(state, count) =>
  let c = Math.max(1, Number(count) || 1);
  state.levelUps += c;
  let entry = { at: Date.now(), name: "level up", levelUp: c };
  state.log.push(entry);
  return entry;

d20RewardReputation(state, faction, amount) =>
  let f = String(faction || "default");
  let a = Number(amount) || 0;
  state.reputation[f] = (state.reputation[f] || 0) + a;
  let entry = { at: Date.now(), name: "reputation", reputation: {}, reputationAmount: {} };
  entry.reputation[f] = a;
  state.log.push(entry);
  return entry;

d20RewardItems(state, items) =>
  let list = Array.isArray(items) ? items : [items];
  state.items = state.items.concat(list);
  let entry = { at: Date.now(), name: "items", items: list.length };
  state.log.push(entry);
  return entry;

d20RewardUndo(state) =>
  let last = state.log.pop();
  if(!last) return { error: "nothing to undo" };
  if(last.xp) state.xp = Math.max(0, state.xp - last.xp);
  if(last.levelUp) state.levelUps = Math.max(0, state.levelUps - last.levelUp);
  if(last.reputation) for(let f in last.reputation) state.reputation[f] = Math.max(0, (state.reputation[f] || 0) - last.reputation[f]);
  if(last.items) state.items = state.items.slice(0, state.items.length - last.items);
  return { ok: true, undone: last };

d20RewardSummary(state) =>
  return { xp: state.xp, level: d20LevelFromXP(state.xp), levelUps: state.levelUps, reputation: Object.assign({}, state.reputation), items: state.items.slice(), dispatches: state.log.length };

// Item 115 — Planar environmental rules engine.
d20PlaneState(opts) =>
  return { planes: {}, active: null };

d20PlaneDefine(state, plane, opts) =>
  let o = opts || {};
  let name = plane && plane.name ? String(plane.name) : "plane" + (Object.keys(state.planes).length + 1);
  let entry = { name, description: (plane && plane.description) || "", rules: Array.isArray(plane && plane.rules) ? plane.rules.slice() : [] };
  state.planes[name] = entry;
  if(o.activate) state.active = name;
  return entry;

d20PlaneActivate(state, name) =>
  if(!state.planes[name]) return { error: "unknown plane: " + name };
  state.active = name;
  return state.planes[name];

d20PlaneDeactivate(state) =>
  state.active = null;
  return { ok: true, active: null };

d20PlaneList(state) =>
  return Object.keys(state.planes).map(function(n) { return state.planes[n]; });

d20PlaneEffects(state, name) =>
  let pn = name || state.active;
  if(!pn || !state.planes[pn]) return { plane: null, wildMagicDC: null, gravityMultiplier: 1, timeDilation: 1, psychicDissonance: 0, flightRestricted: false };
  let eff = { plane: pn, wildMagicDC: null, gravityMultiplier: 1, timeDilation: 1, psychicDissonance: 0, flightRestricted: false };
  let rules = state.planes[pn].rules;
  for(let i = 0; i < rules.length; i++) {
    let r = rules[i];
    let t = String(r.type).toLowerCase().replace(/[^a-z]/g, "");
    if(t === "wildmagic" || t === "wildmagiczone") eff.wildMagicDC = r.dc != null ? Number(r.dc) : eff.wildMagicDC;
    else if(t === "gravity") eff.gravityMultiplier = r.multiplier != null ? Number(r.multiplier) : (r.value != null ? Number(r.value) : eff.gravityMultiplier);
    else if(t === "time" || t === "timedilation") eff.timeDilation = r.ratio != null ? Number(r.ratio) : (r.value != null ? Number(r.value) : eff.timeDilation);
    else if(t === "psychic" || t === "psychicdissonance") eff.psychicDissonance = r.dc != null ? Number(r.dc) : (r.value != null ? Number(r.value) : eff.psychicDissonance);
    else if(t === "flight") eff.flightRestricted = true;
  }
  return eff;

d20PlaneResolve(state, event, opts) =>
  let o = opts || {};
  let eff = d20PlaneEffects(state);
  let ev = String(event || "").toLowerCase();
  if(ev === "spellcast") {
    if(eff.wildMagicDC != null) {
      let check = d20ResolveCheck(eff.wildMagicDC, { abilityMod: Number(o.abilityMod) || 0, bonus: Number(o.bonus) || 0, fixed: o.fixed });
      return { event: "spellcast", plane: eff.plane, wildMagicDC: eff.wildMagicDC, surge: !check.passed, roll: check.total, note: check.passed ? "no surge" : "wild magic surge on this plane" };
    }
    return { event: "spellcast", plane: eff.plane, surge: false, note: "no wild magic zone" };
  }
  if(ev === "fall") {
    let height = Math.max(0, Number(o.height) || 0);
    let damage = Math.round(height / 10 * 3.5 * eff.gravityMultiplier);
    return { event: "fall", plane: eff.plane, gravityMultiplier: eff.gravityMultiplier, height, damage };
  }
  if(ev === "duration") {
    let rounds = Math.max(1, Number(o.rounds) || 1);
    return { event: "duration", plane: eff.plane, timeDilation: eff.timeDilation, adjustedRounds: Math.max(1, Math.round(rounds / eff.timeDilation)) };
  }
  if(ev === "psychic") {
    if(eff.psychicDissonance) {
      let check = d20ResolveCheck(eff.psychicDissonance, { abilityMod: Number(o.abilityMod) || 0, bonus: Number(o.bonus) || 0, fixed: o.fixed });
      return { event: "psychic", plane: eff.plane, dc: eff.psychicDissonance, dissonant: !check.passed, roll: check.total, damage: check.passed ? 0 : 2 };
    }
    return { event: "psychic", plane: eff.plane, dissonant: false };
  }
  return { event, plane: eff.plane, note: "no rules apply" };

// Item 116 — Teleportation accuracy & mishap engine.
d20TeleportTable() =>
  return [
    { key: "permanent_circle", label: "Permanent Circle", on: 100, off: 0, similar: 0, mishap: 0 },
    { key: "associated_object", label: "Associated Object", on: 100, off: 0, similar: 0, mishap: 0 },
    { key: "very_familiar", label: "Very Familiar", on: 97, off: 3, similar: 0, mishap: 0 },
    { key: "seen_casually", label: "Seen Casually", on: 94, off: 6, similar: 0, mishap: 0 },
    { key: "viewed_once", label: "Viewed Once", on: 89, off: 8, similar: 3, mishap: 0 },
    { key: "description", label: "From Description", on: 76, off: 10, similar: 14, mishap: 0 },
    { key: "false_destination", label: "False Destination", on: 0, off: 0, similar: 0, mishap: 100 }];

d20TeleportFamiliarity(key) =>
  let k = String(key || "").toLowerCase().replace(/[^a-z_]/g, "");
  let t = d20TeleportTable();
  for(let i = 0; i < t.length; i++) {
    if(t[i].key === k || t[i].label.toLowerCase() === k) return t[i];
  }
  return null;

d20TeleportResolve(opts) =>
  let o = opts || {};
  let tier = d20TeleportFamiliarity(o.tier || o.familiarity);
  if(!tier) return { error: "unknown familiarity tier: " + (o.tier || o.familiarity) };
  let roll = o.fixed != null ? Math.max(1, Math.min(100, Number(o.fixed))) : Math.floor(Math.random() * 100) + 1;
  let result, distanceMiles = 0, similarMiles = 0;
  if(roll <= tier.on) result = "on_target";
  else if(roll <= tier.on + tier.off) result = "off_target";
  else if(roll <= tier.on + tier.off + tier.similar) result = "similar_area";
  else result = "mishap";
  let note = tier.label;
  if(result === "off_target") {
    distanceMiles = (Math.floor(Math.random() * 10) + 1) * (Math.floor(Math.random() * 10) + 1);
    note += ": off-target, " + distanceMiles + " miles away in a random direction";
  } else if(result === "similar_area") {
    similarMiles = (Math.floor(Math.random() * 4) + 1) * (Math.floor(Math.random() * 10) + 1);
    note += ": similar area, " + similarMiles + " miles away";
  } else if(result === "mishap") {
    note += ": teleportation mishap — 3d6 force damage and a random destination";
  } else {
    note += ": arrival on target";
  }
  return { tier: tier.key, label: tier.label, roll, result, distanceMiles, similarMiles, damage: result === "mishap" ? "3d6" : null, note };

d20TeleportMishapDamage(opts) =>
  let o = opts || {};
  let total = 0;
  if(o.fixed != null) {
    total = Math.max(3, Math.min(18, Number(o.fixed)));
  } else {
    for(let i = 0; i < 3; i++) total += Math.floor(Math.random() * 6) + 1;
  }
  return { expr: "3d6", total, force: true, note: "force damage" };

// Item 117 — Extradimensional storage mechanics.
d20ExtradimensionalItems() =>
  return [
    { key: "bag_of_holding", label: "Bag of Holding", capacityLbs: 500, capacityFt: 64, interiorDiameter: 2, interiorDepth: 4 },
    { key: "portable_hole", label: "Portable Hole", capacityLbs: 500, capacityFt: 282, interiorDiameter: 6, interiorDepth: 10 },
    { key: "handy_haversack", label: "Handy Haversack", capacityLbs: 120, capacityFt: 64, interiorDiameter: 2, interiorDepth: 4 }];

d20ExtradimensionalState(opts) =>
  return { containers: {} };

d20ExtradimensionalAdd(state, item, opts) =>
  let o = opts || {};
  let key = String((item && item.key) || item || "bag_of_holding");
  let def = null, items = d20ExtradimensionalItems();
  for(let i = 0; i < items.length; i++) { if(items[i].key === key) def = items[i]; }
  if(!def) return { error: "unknown container: " + key };
  let id = o.id || key + "_" + (Object.keys(state.containers).length + 1);
  if(state.containers[id]) return { error: "container already exists: " + id };
  let c = { id, key: def.key, label: def.label, capacityLbs: def.capacityLbs, capacityFt: def.capacityFt, weight: 0, volume: 0, contents: [] };
  state.containers[id] = c;
  return c;

d20ExtradimensionalFill(state, id, weight, volume, opts) =>
  let o = opts || {};
  let c = state.containers[id];
  if(!c) return { error: "unknown container: " + id };
  let w = Math.max(0, Number(weight) || 0);
  let v = Math.max(0, Number(volume) || 0);
  if(Number(c.weight) + w > c.capacityLbs) return { ok: false, reason: "exceeds " + c.capacityLbs + " lb capacity", overCapacity: true, remainingLbs: Math.max(0, c.capacityLbs - c.weight), remainingFt: Math.max(0, c.capacityFt - c.volume) };
  if(Number(c.volume) + v > c.capacityFt) return { ok: false, reason: "exceeds " + c.capacityFt + " cu ft capacity", overCapacity: true, remainingFt: Math.max(0, c.capacityFt - c.volume), remainingLbs: Math.max(0, c.capacityLbs - c.weight) };
  c.weight = Number(c.weight) + w;
  c.volume = Number(c.volume) + v;
  if(o.item) c.contents.push({ name: o.item, weight: w, volume: v, at: Date.now() });
  return { ok: true, id: c.id, weight: c.weight, volume: c.volume, remainingLbs: Math.max(0, c.capacityLbs - c.weight), remainingFt: Math.max(0, c.capacityFt - c.volume) };

d20ExtradimensionalRemove(state, id, weight, opts) =>
  let o = opts || {};
  let c = state.containers[id];
  if(!c) return { error: "unknown container: " + id };
  let w = Math.min(Math.max(0, Number(weight) || 0), c.weight);
  c.weight = Math.max(0, c.weight - w);
  if(o.volume) c.volume = Math.max(0, c.volume - Number(o.volume));
  return { ok: true, removedWeight: w, weight: c.weight, volume: c.volume };

d20ExtradimensionalSuffocation(opts) =>
  let o = opts || {};
  let breathing = Math.max(1, Number(o.breathingCreatures) || 1);
  let minutes = Math.max(0, (Number(o.airMinutes) || 10) / breathing);
  let elapsed = Math.max(0, Number(o.elapsedMinutes) || 0);
  let left = Math.max(0, minutes - elapsed);
  return { airMinutes: minutes, remainingMinutes: left, suffocating: left <= 0, warning: left > 0 && left <= 0.5 };

d20ExtradimensionalRift(state, opts) =>
  let o = opts || {};
  let inside = String(o.inside || o.first || "").toLowerCase();
  let outside = String(o.outside || o.second || "").toLowerCase();
  let pair = (inside + " " + outside);
  let isBag = pair.indexOf("bag") !== -1 || pair.indexOf("haversack") !== -1;
  let isHole = pair.indexOf("hole") !== -1;
  if(!(isBag && isHole)) return { ok: false, reason: "not an extradimensional container pairing" };
  if(o.id) delete state.containers[o.id];
  return { rift: true, description: "A rift to the Astral Plane tears open; everything nearby is drawn through", astral: true, note: "containers destroyed, contents lost to the Astral Plane" };

// Item 118 — Mass saving throw auto-resolver.
d20MassSavingThrows(entities, dc, opts) =>
  let o = opts || {};
  let list = Array.isArray(entities) ? entities : [];
  let results = [];
  for(let i = 0; i < list.length; i++) {
    let e = list[i];
    let mod = e && (e.mod != null ? Number(e.mod) : (e.bonus != null ? Number(e.bonus) : (Number(o.saveMod) || 0)));
    let fixed = o.fixed != null ? (Array.isArray(o.fixed) ? o.fixed[i] : o.fixed) : null;
    let res = d20ResolveCheck(Number(dc) || 10, { abilityMod: mod, bonus: Number(o.bonus) || 0, advantage: o.advantage, disadvantage: o.disadvantage, fixed });
    results.push({ target: i, id: e && e.id != null ? e.id : i, name: (e && e.name) || "entity " + i, roll: res.kept, total: res.total, passed: res.passed, natural: res.natural });
  }
  let passed = results.filter(function(r) { return r.passed; }).length;
  let failed = results.length - passed;
  let damage = null;
  if(o.damage != null) {
    let raw = Math.max(0, Number(o.damage) || 0);
    let entries = [];
    for(let i = 0; i < results.length; i++) {
      let r = results[i];
      let dmg = r.passed ? Math.floor(raw / 2) : raw;
      if(o.immune && o.immune.indexOf(r.id) !== -1) dmg = 0;
      else if(o.resist && o.resist.indexOf(r.id) !== -1) dmg = Math.max(0, Math.floor(dmg / 2));
      else if(o.vulnerable && o.vulnerable.indexOf(r.id) !== -1) dmg = dmg * 2;
      r.damage = dmg;
      entries.push({ id: r.id, name: r.name, damage: dmg, passed: r.passed });
    }
    damage = { raw, total: entries.reduce(function(a, b) { return a + b.damage; }, 0), entries };
  }
  return { dc: Number(dc) || 10, count: results.length, passed, failed, successPct: results.length ? Math.round(passed / results.length * 100) : 0, results, damage };

d20MassSavingThrowsSummary(result) =>
  return { count: result.count, passed: result.passed, failed: result.failed, successPct: result.successPct, totalDamage: result.damage ? result.damage.total : null, allPassed: result.failed === 0, nonePassed: result.passed === 0 };

// Item 119 — Batch damage & condition applicator.
d20BatchPct(e) =>
  return Math.max(0, Math.min(100, Math.round(e.hp / e.maxHp * 100)));

d20BatchTargets(state, targets) =>
  if(!Array.isArray(targets)) return Object.keys(state.entities).map(function(k) { return state.entities[k]; });
  let out = [];
  for(let i = 0; i < targets.length; i++) {
    let id = String(targets[i]);
    if(state.entities[id]) out.push(state.entities[id]);
  }
  return out;

d20BatchState(opts) =>
  return { entities: {} };

d20BatchAdd(state, entity, opts) =>
  let o = opts || {};
  let e = entity || {};
  let id = e.id != null ? String(e.id) : "e" + (Object.keys(state.entities).length + 1);
  if(state.entities[id]) return { error: "entity already exists: " + id };
  let maxHp = Math.max(1, Number(e.maxHp) || Number(e.hp) || 10);
  let entry = { id, name: e.name || id, hp: e.hp != null ? Math.max(0, Number(e.hp)) : maxHp, maxHp, conditions: {}, resources: Object.assign({}, e.resources || {}) };
  state.entities[id] = entry;
  return entry;

d20BatchDamage(state, damage, opts) =>
  let o = opts || {};
  let raw = Math.max(0, Number(damage) || 0);
  let targets = d20BatchTargets(state, o.targets);
  let results = [];
  for(let i = 0; i < targets.length; i++) {
    let e = targets[i];
    let d = raw;
    if(o.immune && o.immune.indexOf(e.id) !== -1) d = 0;
    else if(o.resist && o.resist.indexOf(e.id) !== -1) d = Math.floor(d / 2);
    else if(o.vulnerable && o.vulnerable.indexOf(e.id) !== -1) d = d * 2;
    e.hp = Math.max(0, e.hp - d);
    results.push({ id: e.id, name: e.name, damage: d, hp: e.hp, hpPct: d20BatchPct(e), alive: e.hp > 0 });
  }
  return { damage: raw, total: results.reduce(function(a, b) { return a + b.damage; }, 0), results };

d20BatchHeal(state, amount, opts) =>
  let o = opts || {};
  let amt = Math.max(0, Number(amount) || 0);
  let targets = d20BatchTargets(state, o.targets);
  let results = [];
  for(let i = 0; i < targets.length; i++) {
    let e = targets[i];
    let before = e.hp;
    e.hp = Math.min(e.maxHp, e.hp + amt);
    results.push({ id: e.id, name: e.name, healed: e.hp - before, hp: e.hp, hpPct: d20BatchPct(e) });
  }
  return { amount: amt, results };

d20BatchCondition(state, condition, opts) =>
  let o = opts || {};
  let targets = d20BatchTargets(state, o.targets);
  let results = [];
  for(let i = 0; i < targets.length; i++) {
    let e = targets[i];
    let r = d20ConditionApply(e, condition, { duration: o.duration, saveDC: o.saveDC, savingThrow: o.savingThrow });
    results.push({ id: e.id, name: e.name, applied: !r.error, error: r.error });
  }
  return { condition, results };

d20BatchRemoveCondition(state, condition, opts) =>
  let o = opts || {};
  let targets = d20BatchTargets(state, o.targets);
  let results = [];
  for(let i = 0; i < targets.length; i++) {
    let e = targets[i];
    let r = d20ConditionRemove(e, condition);
    results.push({ id: e.id, name: e.name, removed: r.removed });
  }
  return { condition, results };

d20BatchStatus(state) =>
  let ids = Object.keys(state.entities);
  let out = [];
  for(let i = 0; i < ids.length; i++) {
    let e = state.entities[ids[i]];
    out.push({ id: e.id, name: e.name, hp: e.hp, maxHp: e.maxHp, hpPct: d20BatchPct(e), alive: e.hp > 0, conditions: d20ConditionList(e) });
  }
  return out;

// Item 120 — Encounter state dashboard & health monitor.
d20EncounterState(opts) =>
  let o = opts || {};
  return { round: Number(o.round) || 1, turnIndex: 0, teams: { party: [], enemies: [] }, log: [] };

d20EncounterAll(state) =>
  return state.teams.party.concat(state.teams.enemies);

d20EncounterAdd(state, team, entity) =>
  let t = team === "party" ? "party" : "enemies";
  let e = entity || {};
  let id = e.id != null ? String(e.id) : t + (state.teams[t].length + 1);
  let maxHp = Math.max(1, Number(e.maxHp) || Number(e.hp) || 10);
  let entry = { id, name: e.name || id, team: t, hp: e.hp != null ? Math.max(0, Number(e.hp)) : maxHp, maxHp, conditions: {}, resources: {} };
  for(let r in (e.resources || {})) {
    let v = e.resources[r];
    entry.resources[r] = (v && typeof v === "object") ? { cur: Math.max(0, Number(v.cur) || 0), max: Math.max(0, Number(v.max) || 0) } : { cur: Math.max(0, Number(v) || 0), max: Math.max(0, Number(v) || 0) };
  }
  state.teams[t].push(entry);
  return entry;

d20EncounterMetrics(state) =>
  let teams = {};
  for(let tn in state.teams) {
    let list = state.teams[tn];
    let hp = 0, maxHp = 0, alive = 0, conditions = {}, resources = {};
    for(let i = 0; i < list.length; i++) {
      let e = list[i];
      hp += Math.max(0, e.hp);
      maxHp += e.maxHp;
      if(e.hp > 0) alive++;
      let cl = d20ConditionList(e);
      for(let j = 0; j < cl.length; j++) conditions[cl[j]] = (conditions[cl[j]] || 0) + 1;
      for(let r in e.resources) {
        let cur = e.resources[r].cur, mx = e.resources[r].max;
        if(!resources[r]) resources[r] = { cur: 0, max: 0 };
        resources[r].cur += cur;
        resources[r].max += mx;
      }
    }
    let resourcePct = {};
    for(let r in resources) resourcePct[r] = resources[r].max > 0 ? Math.round(resources[r].cur / resources[r].max * 100) : 0;
    teams[tn] = { count: list.length, alive, dead: list.length - alive, hp, maxHp, hpPct: maxHp ? Math.round(hp / maxHp * 100) : 0, conditionCounts: conditions, resources: resourcePct };
  }
  let danger = d20EncounterDanger(teams.party, teams.enemies);
  return { round: state.round, turn: state.turnIndex, teams, danger, log: state.log.length };

d20EncounterDanger(party, enemies) =>
  let p = party ? party.hpPct : 100;
  let e = enemies ? enemies.hpPct : 100;
  if(p <= 25) return "critical";
  if(p <= 50) return "dangerous";
  if(p <= 75) return "wary";
  if(e <= 50) return "favorable";
  return "calm";

d20EncounterRound(state) =>
  state.round += 1;
  state.turnIndex = 0;
  return { round: state.round, turn: state.turnIndex };

d20EncounterTurn(state, step) =>
  let all = d20EncounterAll(state);
  if(!all.length) return { round: state.round, turn: 0, entity: null };
  let s = Number(step) || 1;
  state.turnIndex = (state.turnIndex + s) % all.length;
  return { round: state.round, turn: state.turnIndex, entity: all[state.turnIndex] };

d20EncounterCurrentTurn(state) =>
  let all = d20EncounterAll(state);
  if(!all.length) return { round: state.round, turn: 0, entity: null };
  return { round: state.round, turn: state.turnIndex, entity: all[state.turnIndex] };

d20EncounterDamage(state, id, damage, opts) =>
  let o = opts || {};
  let all = d20EncounterAll(state);
  let e = null;
  for(let i = 0; i < all.length; i++) { if(String(all[i].id) === String(id)) { e = all[i]; break; } }
  if(!e) return { error: "unknown entity: " + id };
  let d = Math.max(0, Number(damage) || 0);
  if(o.condition) { let r = d20ConditionApply(e, o.condition, o); if(r.error) return { error: r.error }; }
  e.hp = Math.max(0, e.hp - d);
  state.log.push({ at: Date.now(), type: "damage", id: e.id, amount: d });
  return { id: e.id, name: e.name, hp: e.hp, hpPct: d20BatchPct(e), metrics: d20EncounterMetrics(state) };

d20EncounterSummary(state) =>
  let m = d20EncounterMetrics(state);
  let p = m.teams.party, en = m.teams.enemies;
  return "Round " + m.round + " | Party " + p.hpPct + "% HP (" + p.alive + "/" + p.count + " alive) vs Enemies " + (en ? en.hpPct : 0) + "% HP (" + (en ? en.alive : 0) + "/" + (en ? en.count : 0) + ") | Danger: " + m.danger;

// ────────────────────────────────────────────────────────────────────
//  Phase 41: Adventure Prep & Campaign Tools
// ────────────────────────────────────────────────────────────────────

// Item 121 — Combat initiative tracker.
d20CombatRoll(bonus, opts) =>
  let o = opts || {};
  let b = Number(bonus) || 0;
  let roll = o.fixed != null ? Math.max(1, Math.min(20, Number(o.fixed))) : Math.floor(Math.random() * 20) + 1;
  return { roll, bonus: b, total: roll + b };

d20CombatState(opts) =>
  let o = opts || {};
  return { round: Number(o.round) || 1, turnIndex: 0, combatants: [], byId: {} };

d20CombatAdd(state, entity, opts) =>
  let o = opts || {};
  let e = entity || {};
  let id = e.id != null ? String(e.id) : "c" + (state.combatants.length + 1);
  if(state.byId[id]) return { error: "combatant already exists: " + id };
  let dexMod = Number(e.dexMod) || 0;
  let bonus = Number(e.bonus) || 0;
  let r = d20CombatRoll(dexMod + bonus, { fixed: o.fixed != null ? o.fixed : e.fixed });
  let entry = { id, name: e.name || id, dexMod, bonus, roll: r.roll, initiative: r.total };
  state.byId[id] = entry;
  state.combatants.push(entry);
  d20CombatSort(state);
  return entry;

d20CombatSort(state) =>
  state.combatants.sort(function(a, b) {
    if(b.initiative !== a.initiative) return b.initiative - a.initiative;
    return a.name < b.name ? -1 : (a.name > b.name ? 1 : 0);
  });
  if(state.combatants.length && state.turnIndex >= state.combatants.length) state.turnIndex = 0;
  return state.combatants;

d20CombatOrder(state) =>
  return state.combatants.slice();

d20CombatNext(state) =>
  if(!state.combatants.length) return { round: state.round, turn: 0, current: null };
  state.turnIndex = (state.turnIndex + 1) % state.combatants.length;
  if(state.turnIndex === 0) state.round += 1;
  return { round: state.round, turn: state.turnIndex, current: state.combatants[state.turnIndex] };

d20CombatCurrent(state) =>
  if(!state.combatants.length) return null;
  return state.combatants[Math.min(state.turnIndex, state.combatants.length - 1)];

d20CombatReroll(state, id, opts) =>
  let o = opts || {};
  let e = state.byId[id];
  if(!e) return { error: "unknown combatant: " + id };
  let r = d20CombatRoll(e.dexMod + e.bonus, { fixed: o.fixed });
  e.roll = r.roll;
  e.initiative = r.total;
  d20CombatSort(state);
  return e;

d20CombatRemove(state, id) =>
  let e = state.byId[id];
  if(!e) return { error: "unknown combatant: " + id };
  let idx = state.combatants.indexOf(e);
  if(idx !== -1) state.combatants.splice(idx, 1);
  delete state.byId[id];
  if(state.combatants.length && state.turnIndex >= state.combatants.length) state.turnIndex = 0;
  return { ok: true, removed: id, current: d20CombatCurrent(state) };

d20CombatStatus(state) =>
  return { round: state.round, turn: state.turnIndex, current: d20CombatCurrent(state), order: d20CombatOrder(state) };

// Item 122 — Encounter budget builder.
d20EncounterBudget(level, size, opts) =>
  let o = opts || {};
  let lv = Math.max(1, Math.min(20, Number(level) || 1));
  let n = Math.max(1, Math.floor(Number(size) || 4));
  let row = d20EncounterThresholdForLevel(lv);
  return { level: lv, size: n, easy: row.easy * n, medium: row.medium * n, hard: row.hard * n, deadly: row.deadly * n };

d20EncounterBuild(pool, opts) =>
  let o = opts || {};
  let difficulty = String(o.difficulty || "medium").toLowerCase();
  let budget = d20EncounterBudget(o.level, o.partySize);
  let maxXp = budget[difficulty] != null ? budget[difficulty] : budget.medium;
  let list = Array.isArray(pool) ? pool : [];
  let monsters = [];
  for(let i = 0; i < list.length; i++) {
    let m = list[i];
    if(typeof m === "string" || typeof m === "number") {
      let cr = d20CRXP(String(m));
      if(!cr.error) monsters.push({ name: "CR " + m, cr: cr.cr, xp: cr.xp, count: 1 });
      continue;
    }
    if(!m) continue;
    let crRes = d20CRXP(String(m.cr));
    let xp = m.xp != null ? Number(m.xp) : (crRes.error ? 0 : crRes.xp);
    monsters.push({ name: m.name || "monster " + (i + 1), cr: String(m.cr), xp, count: Math.max(1, Number(m.count) || 1) });
  }
  let slots = [];
  for(let i = 0; i < monsters.length; i++) {
    for(let k = 0; k < monsters[i].count; k++) slots.push({ name: monsters[i].name, cr: monsters[i].cr, xp: monsters[i].xp });
  }
  slots.sort(function(a, b) { return b.xp - a.xp; });
  let used = [], totalXp = 0, remaining = maxXp;
  for(let i = 0; i < slots.length; i++) {
    if(slots[i].xp > remaining) continue;
    used.push(slots[i]);
    remaining -= slots[i].xp;
    totalXp += slots[i].xp;
  }
  let diff = d20EncounterDifficulty(totalXp, { easy: budget.easy, medium: budget.medium, hard: budget.hard, deadly: budget.deadly });
  return { level: budget.level, partySize: budget.size, difficulty, budgetXp: maxXp, totalXp, remaining, monsters: used, difficultyLabel: diff && diff.difficulty };

// Item 123 — Treasure hoard generator.
d20TreasureTiers() =>
  return [
    { key: "0-4", label: "CR 0-4", coins: { cp: ["6d6", 100], sp: ["3d6", 100], gp: ["2d6", 10], pp: ["0", 1] }, gems: { count: ["2d6", 1], value: 10 }, magicRolls: 0 },
    { key: "5-10", label: "CR 5-10", coins: { cp: ["2d6", 100], sp: ["2d6", 1000], gp: ["6d6", 100], pp: ["3d6", 10] }, gems: { count: ["2d4", 1], value: 50 }, magicRolls: 1 },
    { key: "11-16", label: "CR 11-16", coins: { cp: ["0", 1], sp: ["0", 1], gp: ["4d6", 1000], pp: ["5d6", 100] }, gems: { count: ["2d4", 1], value: 250 }, magicRolls: 2 },
    { key: "17-20", label: "CR 17-20", coins: { cp: ["0", 1], sp: ["0", 1], gp: ["12d6", 1000], pp: ["8d6", 100] }, gems: { count: ["2d6", 1], value: 750 }, magicRolls: 3 }];

d20ExprRoll(expr, fixed) =>
  if(String(expr) === "0") return { expr: "0", count: 0, faces: 0, rolls: [], total: 0 };
  let m = String(expr).toLowerCase().match(/^(\d+)d(\d+)$/);
  if(!m) return { error: "bad dice expr: " + expr };
  let count = Math.min(100, parseInt(m[1], 10));
  let faces = Math.min(1000, parseInt(m[2], 10));
  let rolls = [], total = 0;
  for(let i = 0; i < count; i++) {
    let v = fixed != null ? Math.max(1, Math.min(faces, Number(fixed))) : Math.floor(Math.random() * faces) + 1;
    rolls.push(v); total += v;
  }
  return { expr, count, faces, rolls, total };

d20TreasureGems(count, value, opts) =>
  let o = opts || {};
  let c = Math.max(0, Number(count) || 0);
  let types = ["quartz", "garnet", "jade", "amethyst", "topaz", "sapphire", "emerald", "ruby", "diamond"];
  let list = [];
  for(let i = 0; i < c; i++) {
    let t = o.fixedGem != null ? types[Math.min(Math.max(0, Number(o.fixedGem)), types.length - 1)] : types[Math.floor(Math.random() * types.length)];
    list.push({ type: t, value: Math.max(1, Number(value) || 1) });
  }
  return list;

d20MagicItems() =>
  return {
    common: ["potion of healing", "scroll of cantrip", "compass", "cloak of billowing"],
    uncommon: ["weapon +1", "bag of holding", "boots of elvenkind", "cloak of protection", "wand of magic missiles"],
    rare: ["weapon +2", "cloak of displacement", "ring of protection", "wand of fireballs", "amulet of health"],
    very_rare: ["weapon +3", "belt of giant strength", "ring of invisibility", "staff of power"],
    legendary: ["holy avenger", "vorpal sword", "deck of many things", "ring of three wishes"]
  };

d20MagicItem(rarity, opts) =>
  let o = opts || {};
  let key = String(rarity || "uncommon").toLowerCase().replace(/ /g, "_");
  let list = d20MagicItems()[key] || d20MagicItems().common;
  let idx = o.fixed != null ? Math.min(Math.max(0, Number(o.fixed)), list.length - 1) : Math.floor(Math.random() * list.length);
  return { rarity: key, name: list[idx] };

d20TreasureHoard(opts) =>
  let o = opts || {};
  let tierKey = String(o.tier || o.range || "0-4");
  let tier = null, tiers = d20TreasureTiers();
  for(let i = 0; i < tiers.length; i++) { if(tiers[i].key === tierKey) tier = tiers[i]; }
  if(!tier) return { error: "unknown tier: " + tierKey };
  let coins = {};
  for(let k in tier.coins) {
    let spec = tier.coins[k];
    let r = d20ExprRoll(spec[0], o.fixed);
    coins[k] = r.total * spec[1];
  }
  let gemsRoll = d20ExprRoll(tier.gems.count[0], o.fixed);
  let gems = d20TreasureGems(gemsRoll.total, tier.gems.value, { fixedGem: o.fixedGem });
  let magicItems = [];
  for(let i = 0; i < tier.magicRolls; i++) magicItems.push(d20MagicItem(o.rarity || "uncommon", { fixed: o.fixedMagic }));
  let gpValue = coins.cp / 100 + coins.sp / 10 + coins.gp + coins.pp * 10;
  let gemsValue = gems.reduce(function(a, g) { return a + g.value; }, 0);
  return { tier: tier.key, coins, gems, magicItems, totalValue: Math.round(gpValue + gemsValue) };

// Item 124 — NPC generator.
d20SeededRand(seed) =>
  if(seed == null) return Math.random;
  let s = Number(seed) || 0;
  return function() { s = (s * 9301 + 49297) % 233280; return s / 233280; };

d20NPCRaces() =>
  return ["human", "elf", "dwarf", "halfling", "gnome", "orc", "tiefling", "dragonborn"];

d20NPCNameParts(race) =>
  let pools = {
    human: { g: ["Ar", "Bar", "Cas", "Ed", "Gar", "Kyl", "Leo", "Mar", "Osw", "Rhe", "Theo", "Urs"], s: ["wyn", "en", "on", "ard", "el", "ian", "o", "a"], sur: ["son", "ford", "wright", "hart", "locke", "gray", "mann", "cole"] },
    elf: { g: ["Ae", "Cae", "El", "Fae", "Gal", "Ily", "Lor", "Nym", "Ser", "Thae", "Vae"], s: ["riel", "lira", "dora", "ion", "vyn", "anor", "wen", "aeth"], sur: ["Starweave", "Moonbrook", "Leafsong", "Dawnbough"] },
    dwarf: { g: ["Bru", "Dor", "Gim", "Kor", "Thor", "Bael", "Hael", "Orin"], s: ["dar", "grim", "gil", "rin", "li", "kenn"], sur: ["Ironfist", "Stonehelm", "Goldvein", "Deepforger"] },
    halfling: { g: ["Cor", "Finn", "Jas", "Mer", "Pip", "Ros", "Sam", "Wyl"], s: ["bin", "do", "ry", "la", "den", "o"], sur: ["Lightfoot", "Grasshopper", "Hilltop", "Brandy"] },
    gnome: { g: ["Alv", "Fim", "Nim", "Pip", "Tob", "Wig", "Zook"], s: ["in", "wick", "ble", "fer", "ton"], sur: ["Sparkwhistle", "Nackle", "Bittergear"] },
    orc: { g: ["Gru", "Mok", "Ugr", "Zug", "Krag", "Thok"], s: ["mash", "nar", "shak", "dush", "lak"], sur: ["Bonecrusher", "Skullsplitter", "Bloodaxe"] },
    tiefling: { g: ["Amd", "Bel", "Kal", "Lys", "Mal", "Vex", "Zar"], s: ["iel", "ith", "on", "ara", "ys"], sur: ["Shadowcaller", "Emberveil", "Nightbane"] },
    dragonborn: { g: ["Arj", "Bal", "Da", "Hes", "Kriv", "Nad", "Per", "Shed", "Taru"], s: ["han", "thar", "akh", "arr", "rix", "kir"], sur: ["Clan of the Flame", "Clan of the Storm"] }
  };
  let r = String(race || "human").toLowerCase();
  return pools[r] || pools.human;

d20NPCName(race, opts) =>
  let o = opts || {};
  let pool = d20NPCNameParts(race);
  let rand = d20SeededRand(o.seed);
  let given = pool.g[Math.floor(rand() * pool.g.length)];
  let syll = pool.s[Math.floor(rand() * pool.s.length)];
  let sur = pool.sur[Math.floor(rand() * pool.sur.length)];
  let full = given + syll + " " + sur;
  return { race: String(race || "human").toLowerCase(), given: given + syll, surname: sur, full };

d20NPCOccupation(opts) =>
  let o = opts || {};
  let list = ["farmer", "blacksmith", "innkeeper", "guard", "merchant", "soldier", "priest", "scholar", "thief", "bounty hunter", "barkeep", "healer", "hermit", "miner", "fisher"];
  return list[o.fixed != null ? Math.min(Math.max(0, Number(o.fixed)), list.length - 1) : Math.floor(Math.random() * list.length)];

d20NPCPersonality(opts) =>
  let o = opts || {};
  let traits = ["curious", "brave", "cautious", "gregarious", "stoic", "hot-headed", "sly", "honest", "superstitious", "witty"];
  let ideals = ["justice", "freedom", "honor", "greed", "knowledge", "family", "power", "redemption"];
  let bonds = ["a family heirloom", "a lost friend", "a sworn oath", "a childhood home", "a hidden debt", "a mentor's memory"];
  let flaws = ["gullible", "proud", "vengeful", "greedy", "fearful", "loyal to a fault", "secretive", "reckless"];
  let pick = function(arr) { return arr[o.fixed != null ? Math.min(Math.max(0, Number(o.fixed)), arr.length - 1) : Math.floor(Math.random() * arr.length)]; };
  return { trait: pick(traits), ideal: pick(ideals), bond: pick(bonds), flaw: pick(flaws) };

d20NPC(opts) =>
  let o = opts || {};
  let races = d20NPCRaces();
  let race = o.race || races[o.fixedRace != null ? Math.min(Math.max(0, Number(o.fixedRace)), races.length - 1) : Math.floor(Math.random() * races.length)];
  let name = d20NPCName(race, { seed: o.seed });
  let age = o.age != null ? Number(o.age) : 18 + Math.floor((o.seed != null ? d20SeededRand(o.seed + 1)() : Math.random()) * 50);
  return { name: name.full, given: name.given, surname: name.surname, race, occupation: o.occupation || d20NPCOccupation({ fixed: o.fixedOcc }), age, personality: d20NPCPersonality({ fixed: o.fixedPersonality }), note: o.note || "" };

// Item 125 — Weather & season engine.
d20WeatherSeasons() =>
  return ["spring", "summer", "autumn", "winter"];

d20WeatherConditions() =>
  return [
    { key: "clear", label: "Clear", travelMult: 1, visibilityFt: 2000, precipitation: "none", cold: false, hot: false },
    { key: "cloudy", label: "Cloudy", travelMult: 1, visibilityFt: 1000, precipitation: "none", cold: false, hot: false },
    { key: "rain_light", label: "Light rain", travelMult: 0.9, visibilityFt: 500, precipitation: "rain", cold: false, hot: false },
    { key: "rain_heavy", label: "Heavy rain", travelMult: 0.7, visibilityFt: 150, precipitation: "rain", cold: false, hot: false },
    { key: "fog", label: "Fog", travelMult: 0.8, visibilityFt: 100, precipitation: "none", cold: false, hot: false },
    { key: "wind_high", label: "High wind", travelMult: 0.75, visibilityFt: 800, precipitation: "none", cold: false, hot: false },
    { key: "snow_light", label: "Light snow", travelMult: 0.8, visibilityFt: 300, precipitation: "snow", cold: true, hot: false },
    { key: "snow_heavy", label: "Heavy snow / blizzard", travelMult: 0.5, visibilityFt: 50, precipitation: "snow", cold: true, hot: false },
    { key: "heatwave", label: "Heatwave", travelMult: 0.7, visibilityFt: 2000, precipitation: "none", cold: false, hot: true }];

d20WeatherWeights(season) =>
  let s = String(season || "spring").toLowerCase();
  let weights = {
    spring: { clear: 4, cloudy: 3, rain_light: 3, rain_heavy: 1, fog: 2, wind_high: 1, snow_light: 0, snow_heavy: 0, heatwave: 0 },
    summer: { clear: 5, cloudy: 2, rain_light: 2, rain_heavy: 1, fog: 1, wind_high: 1, snow_light: 0, snow_heavy: 0, heatwave: 2 },
    autumn: { clear: 3, cloudy: 3, rain_light: 3, rain_heavy: 2, fog: 2, wind_high: 2, snow_light: 1, snow_heavy: 0, heatwave: 0 },
    winter: { clear: 2, cloudy: 2, rain_light: 1, rain_heavy: 0, fog: 2, wind_high: 2, snow_light: 4, snow_heavy: 3, heatwave: 0 }
  };
  return weights[s] || weights.spring;

d20WeatherFor(season, opts) =>
  let o = opts || {};
  let conds = d20WeatherConditions();
  let w = d20WeatherWeights(season);
  if(o.fixed != null) return conds[Math.min(Math.max(0, Number(o.fixed)), conds.length - 1)];
  let total = 0;
  for(let i = 0; i < conds.length; i++) total += w[conds[i].key] || 0;
  let r = Math.random() * total;
  let acc = 0;
  for(let i = 0; i < conds.length; i++) { acc += w[conds[i].key] || 0; if(r < acc) return conds[i]; }
  return conds[0];

d20WeatherRoll(opts) =>
  let o = opts || {};
  let seasons = d20WeatherSeasons();
  let season = o.season || seasons[o.fixedSeason != null ? Math.min(Math.max(0, Number(o.fixedSeason)), seasons.length - 1) : Math.floor(Math.random() * seasons.length)];
  let w = d20WeatherFor(season, o);
  return Object.assign({ season }, w);

d20WeatherDaily(opts) =>
  let o = opts || {};
  let days = Math.max(1, Number(o.days) || 7);
  let out = [];
  for(let i = 0; i < days; i++) {
    out.push(d20WeatherRoll({ season: o.season, fixed: Array.isArray(o.fixed) ? o.fixed[i] : o.fixed }));
  }
  return out;

// Item 126 — Travel, forced march & rest recovery.
d20TravelTime(distanceMiles, pace) =>
  let p = d20TravelPace(pace);
  let d = Math.max(0, Number(distanceMiles) || 0);
  let milesPerDay = p.milesPerDay || 24;
  let days = d / milesPerDay;
  return { distance: d, pace: p.name, milesPerDay, days, hours: Math.round(days * 24 * 100) / 100 };

d20ForcedMarch(hours, opts) =>
  let o = opts || {};
  let h = Math.max(0, Number(hours) || 0);
  let extra = Math.max(0, h - 8);
  let conMod = Number(o.conMod) || 0;
  let checks = [];
  for(let i = 1; i <= extra; i++) {
    let dc = 10 + i;
    let roll = o.fixed != null ? (Array.isArray(o.fixed) ? Number(o.fixed[i - 1]) : Number(o.fixed)) : Math.floor(Math.random() * 20) + 1;
    let total = roll + conMod;
    checks.push({ hour: 8 + i, dc, roll, conMod, total, passed: total >= dc });
  }
  let exhaustion = checks.filter(function(c) { return !c.passed; }).length;
  return { hours: h, extraHours: extra, checks, exhaustion };

d20ExhaustionLevel(exhaustion) =>
  let lv = Math.max(0, Math.min(6, Number(exhaustion) || 0));
  let effects = ["no effect", "disadvantage on ability checks", "speed halved", "disadvantage on attack rolls and saving throws", "hit point maximum halved", "speed reduced to 0", "death"];
  return { level: lv, effect: effects[lv], died: lv >= 6 };

// NOTE ON HP-POOL SHAPES: the d20HitPoints()/d20HPDamage()/d20HPHeal() family
// works on {max, current, temp} pools, but the rest helpers below take FLAT
// values — d20RestShort wants a plain array of die sizes (e.g. [8, 8, 6]),
// and d20RestLong wants {maxHp, hp, hitDice: [...], hitDiceMax, hitDiceFaces,
// spellSlots}. To run a long rest on a d20HitPoints() pool, pass its flat
// fields: d20RestLong({maxHp: pool.max, hp: pool.current}).
d20RestShort(hitDice, opts) =>
  let o = opts || {};
  let list = Array.isArray(hitDice) ? hitDice : [];
  let maxDice = o.dice != null ? Math.min(Math.max(0, Number(o.dice)), list.length) : list.length;
  let healed = 0, spent = 0, rolls = [];
  for(let i = 0; i < maxDice; i++) {
    let faces = Math.max(2, Number(list[i]) || 8);
    let roll = o.fixed != null ? Math.max(1, Math.min(faces, Number(o.fixed))) : Math.floor(Math.random() * faces) + 1;
    let gain = roll + (Number(o.conMod) || 0);
    rolls.push({ faces, roll, gain });
    healed += gain; spent++;
  }
  return { diceSpent: spent, healed, rolls, note: "short rest: spend hit dice to heal" };

d20RestLong(state, opts) =>
  let o = opts || {};
  let s = state || {};
  let maxHp = Math.max(1, Number(s.maxHp) || 10);
  let hp = Math.max(0, Number(s.hp) || 0);
  let hpGain = Math.max(0, maxHp - hp);
  s.hp = maxHp;
  let hitDiceRestored = 0;
  if(Array.isArray(s.hitDice)) {
    let maxDice = Math.max(0, Number(s.hitDiceMax) || s.hitDice.length);
    let want = Math.ceil(maxDice / 2);
    let faces = Number(s.hitDiceFaces) || 8;
    while(s.hitDice.length < want) { s.hitDice.push(faces); hitDiceRestored++; }
  }
  let slotsRestored = 0;
  if(Array.isArray(s.spellSlots)) {
    for(let i = 0; i < s.spellSlots.length; i++) {
      let sl = s.spellSlots[i];
      if(sl && sl.used) { slotsRestored += sl.used; sl.used = 0; }
    }
  }
  return { hp: s.hp, maxHp, hpGain, hitDiceRestored, slotsRestored, note: "long rest complete" };

// Item 127 — Shop & merchant economy.
d20ShopItem(name, price, opts) =>
  let o = opts || {};
  let rarityMult = { common: 1, uncommon: 2, rare: 10, very_rare: 40, legendary: 100 };
  let mult = rarityMult[String(o.rarity || "common").toLowerCase()] || 1;
  return { name, price: Math.max(1, Math.round((Number(price) || 10) * mult)), rarity: o.rarity || "common", qty: Math.max(1, Number(o.qty) || 1) };

d20ShopState(opts) =>
  let o = opts || {};
  return { gold: Math.max(0, Number(o.gold) || 0), inventory: Array.isArray(o.inventory) ? o.inventory.slice() : [], possessions: [], merchantBonus: Number(o.merchantBonus) || 0, sold: [] };

d20ShopStock(opts) =>
  let o = opts || {};
  let base = [
    { name: "shortsword", price: 10, rarity: "common" },
    { name: "longsword", price: 15, rarity: "common" },
    { name: "leather armor", price: 10, rarity: "common" },
    { name: "chain mail", price: 75, rarity: "common" },
    { name: "shield", price: 10, rarity: "common" },
    { name: "healing potion", price: 50, rarity: "common" },
    { name: "spell scroll (1st)", price: 25, rarity: "common" },
    { name: "+1 weapon", price: 500, rarity: "uncommon" },
    { name: "ring of protection", price: 1000, rarity: "rare" }];
  let count = Math.max(1, Math.min(base.length, Number(o.count) || base.length));
  let list = [];
  for(let i = 0; i < count; i++) {
    let b = base[i];
    list.push(d20ShopItem(b.name, b.price, { rarity: b.rarity, qty: o.qty }));
  }
  return list;

d20ShopBuy(state, itemName, qty) =>
  let q = Math.max(1, Number(qty) || 1);
  let item = null;
  for(let i = 0; i < state.inventory.length; i++) {
    if(state.inventory[i].name === itemName) { item = state.inventory[i]; break; }
  }
  if(!item) return { error: "not in stock: " + itemName };
  let cost = item.price * q;
  if(cost > state.gold) return { ok: false, reason: "not enough gold", cost, gold: state.gold };
  state.gold -= cost;
  state.possessions.push({ name: item.name, qty: q, price: cost, at: Date.now() });
  if(item.qty != null) item.qty -= q;
  if(item.qty <= 0) {
    let idx = state.inventory.indexOf(item);
    if(idx !== -1) state.inventory.splice(idx, 1);
  }
  return { ok: true, name: item.name, qty: q, cost, gold: state.gold };

d20ShopSell(state, item, opts) =>
  let o = opts || {};
  let value = Math.max(1, Number(item.price) || Number(item.value) || 10);
  let base = Math.floor(value / 2);
  let price = base;
  let res = { ok: true, name: item.name || "item", base, price };
  if(o.persuasion != null || o.persuasionBonus != null) {
    let check = d20ResolveCheck(15, { abilityMod: Number(o.persuasion) || 0, bonus: Number(o.persuasionBonus) || 0, fixed: o.fixed });
    if(check.passed) price = value;
    state.gold += price;
    state.sold.push({ name: item.name || "item", price });
    res.passed = check.passed;
    res.persuadable = true;
    res.price = price;
    return res;
  }
  state.gold += price;
  state.sold.push({ name: item.name || "item", price });
  return res;

d20ShopBarter(state, itemName, targetPrice, opts) =>
  let o = opts || {};
  let item = null;
  for(let i = 0; i < state.inventory.length; i++) { if(state.inventory[i].name === itemName) { item = state.inventory[i]; break; } }
  if(!item) return { error: "not in stock: " + itemName };
  let dc = 10 + Math.round(state.merchantBonus) + Math.floor(item.price / 100);
  let check = d20ResolveCheck(dc, { abilityMod: Number(o.persuasion) || 0, bonus: Number(o.persuasionBonus) || 0, fixed: o.fixed });
  let price = item.price;
  if(check.passed) price = Math.max(1, Math.round(item.price * 0.85));
  return { ok: check.passed, item: item.name, price, original: item.price, dc, roll: check.total, note: check.passed ? "merchant drops the price" : "merchant holds firm" };

d20ShopSummary(state) =>
  return { gold: state.gold, stock: state.inventory.length, possessions: state.possessions.length, sold: state.sold.length };

// Item 128 — Skill challenge engine.
d20SkillChallengeState(opts) =>
  let o = opts || {};
  return { target: Math.max(1, Number(o.target) || 5), maxFailures: Math.max(1, Number(o.maxFailures) || 3), dc: Math.max(1, Number(o.dc) || 15), successes: 0, failures: 0, complete: false, log: [] };

d20SkillChallengeRoll(state, participant, opts) =>
  let o = opts || {};
  let check = d20ResolveCheck(state.dc, { abilityMod: Number(o.abilityMod) || 0, bonus: Number(o.bonus) || 0, advantage: o.advantage, disadvantage: o.disadvantage, fixed: o.fixed });
  if(check.passed) state.successes += 1; else state.failures += 1;
  if(state.successes >= state.target || state.failures >= state.maxFailures) state.complete = true;
  state.log.push({ participant: participant || "party", roll: check.kept, total: check.total, passed: check.passed });
  let outcome = state.complete ? (state.successes >= state.target ? "success" : "failure") : null;
  return { participant: participant || "party", roll: check.kept, total: check.total, passed: check.passed, successes: state.successes, failures: state.failures, complete: state.complete, outcome };

d20SkillChallengeResult(state) =>
  return { complete: !!state.complete, won: state.successes >= state.target, lost: state.failures >= state.maxFailures, successes: state.successes, failures: state.failures, target: state.target, maxFailures: state.maxFailures };

// Item 129 — Downtime activities.
d20DowntimeActivities() =>
  return [
    { key: "carousing", label: "Carousing", cost: 10, dc: 15, days: 3, reward: "contacts and rumors; maybe a bounty" },
    { key: "gambling", label: "Gambling", cost: 25, dc: 14, days: 1, reward: "win double the stake" },
    { key: "training", label: "Training", cost: 100, dc: 16, days: 10, reward: "a new proficiency or skill" },
    { key: "crafting", label: "Crafting", cost: 25, dc: 15, days: 5, reward: "goods worth 50 gp" },
    { key: "research", label: "Research", cost: 50, dc: 16, days: 7, reward: "knowledge or a map" },
    { key: "pit_fighting", label: "Pit fighting", cost: 10, dc: 14, days: 2, reward: "a 50 gp purse" },
    { key: "criminal", label: "Criminal activity", cost: 50, dc: 15, days: 3, reward: "stolen goods worth 100 gp" }];

d20DowntimeActivity(key) =>
  let k = String(key || "").toLowerCase().replace(/[^a-z_]/g, "");
  let list = d20DowntimeActivities();
  for(let i = 0; i < list.length; i++) {
    if(list[i].key === k || list[i].label.toLowerCase() === k) return list[i];
  }
  return null;

d20DowntimeResolve(activity, opts) =>
  let o = opts || {};
  let a = d20DowntimeActivity(activity && activity.key ? activity.key : activity);
  if(!a) return { error: "unknown downtime activity: " + activity };
  let check = d20ResolveCheck(a.dc, { abilityMod: Number(o.abilityMod) || 0, bonus: Number(o.bonus) || 0, advantage: o.advantage, disadvantage: o.disadvantage, fixed: o.fixed });
  return { activity: a.key, label: a.label, days: a.days, cost: a.cost, dc: a.dc, roll: check.kept, total: check.total, passed: check.passed, outcome: check.passed ? "success" : "failure", reward: a.reward };

// Item 130 — Dungeon delving toolkit.
d20DungeonState(opts) =>
  let o = opts || {};
  return { rooms: [], current: -1, cleared: {}, monstersSlain: 0, treasureFound: 0, goldFound: 0 };

d20RoomPurposes() =>
  return ["guardroom", "treasury", "prison cell", "library", "temple shrine", "kitchen", "barracks", "laboratory", "throne room", "mausoleum", "storage vault", "great hall", "workshop", "gallery"];

d20Traps() =>
  return [
    { key: "pit", label: "Hidden pit", dc: 13, damage: "2d6", save: "dexterity" },
    { key: "spikes", label: "Spike trap", dc: 14, damage: "1d8", save: "dexterity" },
    { key: "poison_dart", label: "Poison darts", dc: 13, damage: "1d4", save: "constitution" },
    { key: "fire_jet", label: "Fire jet", dc: 15, damage: "2d6", save: "dexterity" },
    { key: "tripwire", label: "Tripwire + arrow", dc: 12, damage: "1d6", save: "dexterity" },
    { key: "falling_block", label: "Falling block", dc: 15, damage: "2d8", save: "dexterity" },
    { key: "sleep_gas", label: "Sleep gas", dc: 13, damage: "0", save: "constitution" }];

d20DungeonTrap(key) =>
  let k = String(key || "").toLowerCase().replace(/[^a-z_]/g, "");
  let list = d20Traps();
  for(let i = 0; i < list.length; i++) { if(list[i].key === k) return list[i]; }
  return null;

d20DungeonRoom(opts) =>
  let o = opts || {};
  let purposes = d20RoomPurposes();
  let purpose = o.purpose || purposes[o.fixedPurpose != null ? Math.min(Math.max(0, Number(o.fixedPurpose)), purposes.length - 1) : Math.floor(Math.random() * purposes.length)];
  let exits = o.exits != null ? Math.max(1, Number(o.exits)) : 1 + Math.floor(Math.random() * 3);
  let trap = null;
  if(o.trap === true) {
    let traps = d20Traps();
    trap = traps[o.fixedTrap != null ? Math.min(Math.max(0, Number(o.fixedTrap)), traps.length - 1) : Math.floor(Math.random() * traps.length)];
  } else if(o.trap == null && Math.random() < 0.3) {
    let traps = d20Traps();
    trap = traps[Math.floor(Math.random() * traps.length)];
  }
  let monsters = o.monsters != null ? Math.max(0, Number(o.monsters)) : (Math.random() < 0.4 ? 1 + Math.floor(Math.random() * 3) : 0);
  let treasure = o.treasure != null ? Math.max(0, Number(o.treasure)) : (Math.random() < 0.5 ? 10 + Math.floor(Math.random() * 40) : 0);
  return { name: o.name || "Room " + (o.index != null ? o.index + 1 : 1), purpose, exits, trap, monsters, treasure };

d20DungeonExplore(state, opts) =>
  let o = opts || {};
  state.current += 1;
  let room = d20DungeonRoom({ index: state.current, name: o.name, purpose: o.purpose, exits: o.exits, trap: o.trap, monsters: o.monsters, treasure: o.treasure, fixedPurpose: o.fixedPurpose, fixedTrap: o.fixedTrap });
  room.index = state.current;
  state.rooms.push(room);
  state.cleared[state.current] = false;
  return room;

d20DungeonTrapTrigger(state, roomIndex, opts) =>
  let o = opts || {};
  let idx = roomIndex != null ? Number(roomIndex) : state.current;
  let room = state.rooms[idx];
  if(!room || !room.trap) return { error: "no trap in room " + idx };
  let trap = room.trap;
  let check = d20ResolveCheck(trap.dc, { abilityMod: Number(o.abilityMod) || 0, bonus: Number(o.bonus) || 0, fixed: o.fixed });
  let damage = 0;
  if(!check.passed) {
    let d = d20Roll(trap.damage);
    if(!d.error) damage = d.total;
  }
  return { room: idx, trap: trap.key, label: trap.label, dc: trap.dc, save: trap.save, passed: check.passed, damaged: !check.passed, damage };

d20DungeonClear(state, roomIndex) =>
  let idx = roomIndex != null ? Number(roomIndex) : state.current;
  let room = state.rooms[idx];
  if(!room) return { error: "no room at index " + idx };
  state.cleared[idx] = true;
  state.monstersSlain += room.monsters || 0;
  state.treasureFound += (room.treasure > 0 ? 1 : 0);
  state.goldFound += room.treasure || 0;
  return { room: idx, cleared: true, monstersSlain: state.monstersSlain, treasureFound: state.treasureFound, goldFound: state.goldFound };

d20DungeonSummary(state) =>
  return { rooms: state.rooms.length, cleared: Object.keys(state.cleared).filter(function(k) { return state.cleared[k]; }).length, monstersSlain: state.monstersSlain, treasureFound: state.treasureFound, goldFound: state.goldFound, current: state.current };

// ────────────────────────────────────────────────────────────────────
//  Phase 42: Combat & Campaign Polish
// ────────────────────────────────────────────────────────────────────

// Item 131 — Combat action validator.
d20CombatActions() =>
  return [
    { key: "attack", label: "Attack", slot: "action" },
    { key: "cast_spell", label: "Cast a spell", slot: "action" },
    { key: "dodge", label: "Dodge", slot: "action" },
    { key: "dash", label: "Dash", slot: "action" },
    { key: "disengage", label: "Disengage", slot: "action" },
    { key: "hide", label: "Hide", slot: "action" },
    { key: "ready", label: "Ready", slot: "action" },
    { key: "help", label: "Help", slot: "action" },
    { key: "search", label: "Search", slot: "action" },
    { key: "use_item", label: "Use an object", slot: "action" },
    { key: "offhand_attack", label: "Off-hand attack", slot: "bonus" },
    { key: "opportunity_attack", label: "Opportunity attack", slot: "reaction" },
    { key: "counterspell", label: "Counterspell", slot: "reaction" },
    { key: "interact", label: "Interact with an object", slot: "free" }];

d20CombatAction(key) =>
  let k = String(key || "").toLowerCase().replace(/[^a-z_]/g, "");
  let list = d20CombatActions();
  for(let i = 0; i < list.length; i++) { if(list[i].key === k) return list[i]; }
  return null;

d20ActionAllowed(action, opts) =>
  let o = opts || {};
  let a = typeof action === "string" ? d20CombatAction(action) : action;
  if(!a) return { ok: false, reason: "unknown action: " + action };
  let cons = Array.isArray(o.conditions) ? o.conditions : [];
  let blocked = [];
  for(let i = 0; i < cons.length; i++) {
    let c = String(cons[i]).toLowerCase();
    if(["incapacitated", "stunned", "paralyzed", "petrified", "unconscious", "dead"].indexOf(c) !== -1) blocked.push(c);
  }
  if(blocked.length) return { ok: false, reason: "cannot act while " + blocked.join(", ") };
  return { ok: true, action: a.key, note: a.key === "attack" && cons.indexOf("prone") !== -1 ? "prone: melee attacks disadvantaged" : undefined };

d20ValidateAction(budget, action, opts) =>
  let o = opts || {};
  let a = typeof action === "string" ? d20CombatAction(action) : action;
  if(!a) return { ok: false, reason: "unknown action: " + action };
  let allowed = d20ActionAllowed(a, { conditions: o.conditions });
  if(!allowed.ok) return allowed;
  let slots = { action: budget.action, bonus: budget.bonusAction, reaction: budget.reaction };
  if(a.slot !== "free" && slots[a.slot] === false) return { ok: false, reason: a.slot + " already used" };
  return { ok: true, action: a.key, slot: a.slot };

d20TakeAction(budget, action, opts) =>
  let v = d20ValidateAction(budget, action, opts);
  if(!v.ok) return v;
  if(v.slot === "action") budget.action = false;
  else if(v.slot === "bonus") budget.bonusAction = false;
  else if(v.slot === "reaction") budget.reaction = false;
  return { ok: true, action: v.action, slot: v.slot, budget: d20BudgetRemaining(budget) };

// Item 132 — Advantage/disadvantage stack resolver.
d20AdvantageStack(opts) =>
  let o = opts || {};
  let adv = Math.max(0, Number(o.advantage) || 0);
  let dis = Math.max(0, Number(o.disadvantage) || 0);
  let mode = adv === dis ? "normal" : (adv > dis ? "advantage" : "disadvantage");
  return { advantage: adv, disadvantage: dis, net: Math.abs(adv - dis), mode };

d20AdvantageRoll(opts) =>
  let o = opts || {};
  let st = d20AdvantageStack(o);
  let d = d20D20(st.mode === "advantage" ? "advantage" : (st.mode === "disadvantage" ? "disadvantage" : "normal"), o.fixed);
  let bonus = Number(o.bonus) || 0;
  return { mode: d.mode, rolls: d.rolls, kept: d.kept, bonus, total: d.kept + bonus, stack: st };

d20AdvantageSummary(mode) =>
  let m = String(mode || "normal");
  return { mode: m, note: m === "advantage" ? "roll twice, keep higher" : (m === "disadvantage" ? "roll twice, keep lower" : "single roll") };

// Item 133 — Monster recharge tracker.
d20RechargeState(opts) =>
  let o = opts || {};
  let abilities = {};
  for(let k in (o.abilities || {})) {
    let a = o.abilities[k];
    abilities[k] = { min: Math.max(1, Math.min(6, Number(a.min) || 5)), max: Math.max(1, Math.min(6, Number(a.max) || 6)), ready: a.ready !== false };
  }
  return { abilities };

d20RechargeRoll(state, name, opts) =>
  let o = opts || {};
  let a = state.abilities[name];
  if(!a) return { error: "unknown recharge ability: " + name };
  let roll = o.fixed != null ? Math.max(1, Math.min(6, Number(o.fixed))) : Math.floor(Math.random() * 6) + 1;
  let recharged = roll >= a.min && roll <= a.max;
  if(recharged) a.ready = true;
  return { ability: name, roll, min: a.min, max: a.max, recharged, ready: a.ready };

d20RechargeUse(state, name) =>
  let a = state.abilities[name];
  if(!a) return { error: "unknown recharge ability: " + name };
  if(!a.ready) return { ok: false, reason: "ability not ready" };
  a.ready = false;
  return { ok: true, ability: name, ready: false };

d20RechargeReady(state) =>
  let out = [];
  for(let k in state.abilities) { if(state.abilities[k].ready) out.push(k); }
  return out;

d20RechargeReset(state) =>
  for(let k in state.abilities) state.abilities[k].ready = true;
  return state.abilities;

// Item 134 — Loot-by-monster generator.
d20MonsterLootTable() =>
  return {
    "0-4": { coins: ["1d4", 10], mundane: ["torn clothing", "rusty dagger", "bone necklace", "crude torch", "small pouch", "broken tool"], magicChance: 0.05 },
    "5-10": { coins: ["2d6", 10], mundane: ["fine cloak", "carved idol", "locked chest", "silver goblet", "old map", "vial of alchemist fire"], magicChance: 0.15 },
    "11-16": { coins: ["4d6", 10], mundane: ["ornate armor piece", "jeweled bracelet", "rare book", "silk bundle", "masterwork weapon", "gem pouch"], magicChance: 0.3 },
    "17-20": { coins: ["6d6", 10], mundane: ["enchanted-looking relic", "crown fragment", "dragon scale", "ancient coin hoard", "royal seal", "crystal orb"], magicChance: 0.5 }
  };

d20LootTier(cr) =>
  let v = d20CRValue(cr);
  if(v.error) return "0-4";
  if(v.value < 5) return "0-4";
  if(v.value < 11) return "5-10";
  if(v.value < 17) return "11-16";
  return "17-20";

d20MonsterLoot(cr, opts) =>
  let o = opts || {};
  let tier = d20LootTier(cr);
  let table = d20MonsterLootTable()[tier];
  let coinsRoll = d20ExprRoll(table.coins[0], o.fixed);
  let coins = coinsRoll.total * table.coins[1];
  let pick = function(arr, fixed) { return arr[fixed != null ? Math.min(Math.max(0, Number(fixed)), arr.length - 1) : Math.floor(Math.random() * arr.length)]; };
  let mundane = [];
  let mCount = o.fixedMundane != null ? Number(o.fixedMundane) : 1 + Math.floor(Math.random() * 3);
  for(let i = 0; i < mCount; i++) mundane.push(pick(table.mundane, o.fixedItem));
  let magic = null;
  let chance = o.magicChance != null ? Number(o.magicChance) : table.magicChance;
  if((o.fixedMagicRoll != null ? Number(o.fixedMagicRoll) : Math.random()) < chance) magic = d20MagicItem(o.rarity || "uncommon", { fixed: o.fixedMagic });
  return { cr: String(cr), tier, coinsGp: coins, mundane, magic, note: "loot from a defeated monster" };

// Item 135 — Tavern & rumor generator.
d20TavernAdjectives() =>
  return ["Rusty", "Gilded", "Sleepy", "Drunken", "Silent", "Jolly", "Black", "Green", "Last", "Crooked", "Smiling", "Wandering"];
d20TavernNouns() =>
  return ["Anchor", "Mermaid", "Falcon", "Cask", "Harp", "Boot", "Dragon", "Rat", "Griffin", "Spoon", "Lantern", "Serpent"];

d20TavernName(opts) =>
  let o = opts || {};
  let pick = function(arr) { return arr[o.fixed != null ? Math.min(Math.max(0, Number(o.fixed)), arr.length - 1) : Math.floor(Math.random() * arr.length)]; };
  return "The " + pick(d20TavernAdjectives()) + " " + pick(d20TavernNouns());

d20TavernAtmosphere(opts) =>
  let o = opts || {};
  let pick = function(arr, f) { return arr[f != null ? Math.min(Math.max(0, Number(f)), arr.length - 1) : Math.floor(Math.random() * arr.length)]; };
  return { noise: pick(["hushed", "lively", "raucous", "somber"], o.fixedNoise), clientele: pick(["farmhands", "merchants", "soldiers", "scholars", "smugglers", "miners"], o.fixedClientele), decor: pick(["smoke-stained beams", "hunting trophies", "faded tapestries", "bare stone walls", "drying herbs", "mismatched chairs"], o.fixedDecor) };

d20TavernRumors() =>
  return [
    "The old mill is haunted — folk hear grinding at midnight.",
    "A merchant caravan vanished on the north road last week.",
    "They say the baron pays well for troublesome relics.",
    "There's a map hidden under the floor of the burnt chapel.",
    "The lake monster's been seen again, closer to shore.",
    "A stranger in black paid in platinum and asked about the castle.",
    "The bridge toll's doubled — folk are crossing the ford instead.",
    "Someone's been poisoning the well; three dogs died this week."];


d20TavernRumor(opts) =>
  let o = opts || {};
  let list = d20TavernRumors();
  return list[o.fixed != null ? Math.min(Math.max(0, Number(o.fixed)), list.length - 1) : Math.floor(Math.random() * list.length)];

d20Tavern(opts) =>
  let o = opts || {};
  return { name: o.name || d20TavernName(o), atmosphere: d20TavernAtmosphere(o), innkeeper: o.innkeeper || d20NPC({ seed: o.seed }).name, rumor: o.rumor || d20TavernRumor(o) };

// Item 136 — Place-name generator.
d20PlaceNameParts(kind) =>
  let pools = {
    town: { pre: ["Ash", "Brook", "Dun", "East", "Fair", "Gran", "Hollow", "Iron", "Maple", "Silver"], mid: ["ford", "moor", "wick", "bury", "ton", "haven", "holm", "gate"] },
    village: { pre: ["Green", "Mill", "Oak", "Pine", "Stone", "West", "Raven", "Fen"], mid: ["brook", "field", "dale", "ham", "ley", "well", "wood"] },
    forest: { pre: ["Whispering", "Black", "Tangled", "Sunless", "Eternal", "Dread"], mid: ["wood", "grove", "hollow", "thicket", "fells", "shade"] },
    mountain: { pre: ["Crag", "Storm", "Thunder", "Iron", "Wyrm", "Frost"], mid: ["peak", "fang", "spur", "horn", "ridge", "teeth"] },
    river: { pre: ["Silver", "Rust", "Wide", "Black", "Swift", "Mirror"], mid: ["flow", "brook", "run", "reach", "water", "ford"] },
    inn: { pre: ["The Weary", "The Drunken", "The Golden", "The Last", "The Wandering", "The Hanged"], mid: ["", "", "", "", "", ""] },
    region: { pre: ["Vale", "Moor", "Hearth", "Storm", "West", "North"], mid: ["land", "reach", "mere", "mark", "haven", "fall"] }
  };
  return pools[String(kind || "town").toLowerCase()] || pools.town;

d20PlaceName(kind, opts) =>
  let o = opts || {};
  let pool = d20PlaceNameParts(kind);
  let rand = d20SeededRand(o.seed);
  let pre = pool.pre[Math.floor(rand() * pool.pre.length)];
  let mid = pool.mid[Math.floor(rand() * pool.mid.length)];
  return { kind: String(kind || "town").toLowerCase(), name: (pre + mid).trim(), pre, mid };

// Item 137 — Wilderness encounter tables.
d20WildernessTerrain() =>
  return ["forest", "plains", "hills", "swamp", "mountains", "coast", "desert", "arctic", "underground"];

d20EncounterData(terrain) =>
  let t = String(terrain || "forest").toLowerCase();
  let data = {
    forest: [
      { w: 12, label: "Deer herd", cr: "0", count: "2d6" },
      { w: 10, label: "Goblin scouts", cr: "1/4", count: "1d4" },
      { w: 8, label: "Wolves", cr: "1/4", count: "2d4" },
      { w: 8, label: "Bandits", cr: "1/8", count: "2d4" },
      { w: 6, label: "Dire wolves", cr: "1", count: "1d4" },
      { w: 4, label: "Owlbear", cr: "3", count: "1" },
      { w: 4, label: "Dryad and sprites", cr: "1", count: "1d4" },
      { w: 2, label: "Treant", cr: "9", count: "1" },
      { w: 2, label: "Unicorn", cr: "5", count: "1" },
      { w: 6, label: "Giant spiders", cr: "1", count: "1d4" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    plains: [
      { w: 12, label: "Wild horses", cr: "1/4", count: "2d4" },
      { w: 10, label: "Bandits on foot", cr: "1/8", count: "2d4" },
      { w: 8, label: "Horsemen patrol", cr: "1/2", count: "1d4" },
      { w: 6, label: "Ankheg", cr: "2", count: "1" },
      { w: 6, label: "Gnoll hunting pack", cr: "1/2", count: "2d4" },
      { w: 4, label: "Giant eagles", cr: "1", count: "1d4" },
      { w: 2, label: "Roc circling", cr: "11", count: "1" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    hills: [
      { w: 12, label: "Goblin raiders", cr: "1/4", count: "2d4" },
      { w: 10, label: "Hobgoblin squad", cr: "1/2", count: "1d4" },
      { w: 8, label: "Orc war party", cr: "1/2", count: "1d4" },
      { w: 6, label: "Griffons", cr: "2", count: "1d4" },
      { w: 6, label: "Wyvern", cr: "6", count: "1" },
      { w: 4, label: "Ettin", cr: "4", count: "1" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    swamp: [
      { w: 12, label: "Giant frogs", cr: "1/4", count: "1d4" },
      { w: 10, label: "Lizardfolk patrol", cr: "1/2", count: "2d4" },
      { w: 8, label: "Crocodiles", cr: "1/2", count: "1d4" },
      { w: 6, label: "Shambling mound", cr: "5", count: "1" },
      { w: 6, label: "Will-o'-wisps", cr: "2", count: "1d4" },
      { w: 4, label: "Hag's hut", cr: "5", count: "1" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    mountains: [
      { w: 12, label: "Harpies", cr: "1", count: "1d4" },
      { w: 10, label: "Aarakocra scouts", cr: "1/4", count: "1d4" },
      { w: 8, label: "Perytons", cr: "2", count: "1d4" },
      { w: 6, label: "Galeb duhr", cr: "6", count: "1" },
      { w: 4, label: "Wyvern", cr: "6", count: "1" },
      { w: 4, label: "Stone giant", cr: "7", count: "1" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    coast: [
      { w: 12, label: "Merfolk", cr: "1/8", count: "2d4" },
      { w: 10, label: "Giant octopus", cr: "1", count: "1" },
      { w: 8, label: "Sahuagin patrol", cr: "1/2", count: "1d4" },
      { w: 6, label: "Sea hag", cr: "2", count: "1" },
      { w: 6, label: "Water weird", cr: "3", count: "1" },
      { w: 4, label: "Pirate ship", cr: "2", count: "2d4" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    desert: [
      { w: 12, label: "Dust mephits", cr: "1/2", count: "1d4" },
      { w: 10, label: "Giant scorpions", cr: "3", count: "1d4" },
      { w: 8, label: "Jackalweres", cr: "1/2", count: "2d4" },
      { w: 6, label: "Manticore", cr: "3", count: "1" },
      { w: 4, label: "Lamia", cr: "4", count: "1" },
      { w: 4, label: "Mummy", cr: "3", count: "1" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    arctic: [
      { w: 12, label: "Polar bears", cr: "2", count: "1d4" },
      { w: 10, label: "Crag cats", cr: "1", count: "1d4" },
      { w: 8, label: "Winter wolves", cr: "3", count: "1d4" },
      { w: 6, label: "Yetis", cr: "3", count: "1d4" },
      { w: 4, label: "Frost giant", cr: "8", count: "1" },
      { w: 4, label: "Remorhaz", cr: "11", count: "1" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }],
    underground: [
      { w: 12, label: "Giant bats", cr: "1/4", count: "2d4" },
      { w: 10, label: "Xvart band", cr: "1/8", count: "2d4" },
      { w: 8, label: "Gricks", cr: "2", count: "1d4" },
      { w: 6, label: "Carrion crawler", cr: "2", count: "1" },
      { w: 6, label: "Basilisk", cr: "5", count: "1" },
      { w: 4, label: "Hook horrors", cr: "3", count: "1d4" },
      { w: 20, label: "No encounter", cr: "0", count: "0" }]
  };
  return data[t] || data.forest;

d20EncounterTable(terrain) =>
  let rows = d20EncounterData(terrain);
  let entries = [], acc = 0;
  for(let i = 0; i < rows.length; i++) {
    let r = rows[i];
    let w = Math.max(0, Number(r.w) || 0);
    entries.push({ lo: acc + 1, hi: acc + w, label: r.label, cr: r.cr, count: r.count, w });
    acc += w;
  }
  return { terrain: String(terrain || "forest").toLowerCase(), total: acc, entries };

d20EncounterRoll(terrain, opts) =>
  let o = opts || {};
  let table = d20EncounterTable(terrain);
  let roll = o.fixed != null ? Math.max(1, Math.min(table.total, Number(o.fixed))) : Math.floor(Math.random() * table.total) + 1;
  let found = null;
  for(let i = 0; i < table.entries.length; i++) {
    if(roll >= table.entries[i].lo && roll <= table.entries[i].hi) { found = table.entries[i]; break; }
  }
  let enc = found || table.entries[table.entries.length - 1];
  let count = d20ExprRoll(enc.count, o.fixedCount).total;
  return { terrain: table.terrain, roll, total: table.total, encounter: { label: enc.label, cr: enc.cr, count } };

d20EncounterChance(opts) =>
  let o = opts || {};
  let day = Math.max(0, Math.min(1, o.day != null ? Number(o.day) : 0.4));
  let night = Math.max(0, Math.min(1, o.night != null ? Number(o.night) : 0.2));
  return { day, night, note: "chance of an encounter per 8h watch" };

// Item 138 — Party XP split & level-up assignment.
d20PartyXP(total, members, opts) =>
  let o = opts || {};
  let t = Math.max(0, Number(total) || 0);
  let list = Array.isArray(members) ? members : [];
  let n = Math.max(1, list.length);
  let share = Math.floor(t / n);
  let remainder = t - share * n;
  let awards = [];
  for(let i = 0; i < list.length; i++) {
    let m = list[i];
    let got = share + (i < remainder ? 1 : 0);
    awards.push({ member: m && m.name != null ? m.name : m, id: m && m.id != null ? m.id : i, xp: got, level: d20LevelFromXP((Number(m && m.xp) || 0) + got) });
  }
  return { total: t, members: n, share, remainder, awards };

d20PartyLevelUps(xp, members, opts) =>
  let o = opts || {};
  let list = Array.isArray(members) ? members : [];
  let add = Math.max(0, Number(xp) || 0);
  let awards = [];
  for(let i = 0; i < list.length; i++) {
    let m = list[i];
    let cur = Number(m && m.xp) || 0;
    let before = d20LevelFromXP(cur);
    let after = d20LevelFromXP(cur + add);
    awards.push({ member: m && m.name != null ? m.name : m, xpBefore: cur, xpAfter: cur + add, levelBefore: before, levelAfter: after, levelUps: Math.max(0, after - before) });
  }
  return { xp: add, awards };

d20MilestoneSuggestion(opts) =>
  let o = opts || {};
  let level = Math.max(1, Math.min(20, Number(o.level) || 1));
  let cur = d20XPForLevel(level);
  let next = d20XPForLevel(Math.min(20, level + 1));
  return { level, xpToNext: Math.max(0, next - cur), note: "suggest a milestone when the party finishes a major story beat" };

// Item 139 — Magic item crafting engine.
d20CraftRecipe(rarity) =>
  let r = String(rarity || "common").toLowerCase();
  let table = {
    common: { gp: 50, days: 2, dc: 12 },
    uncommon: { gp: 200, days: 4, dc: 14 },
    rare: { gp: 2000, days: 10, dc: 16 },
    very_rare: { gp: 20000, days: 25, dc: 18 },
    legendary: { gp: 100000, days: 50, dc: 20 }
  };
  return table[r] || table.common;

d20CraftItem(item, opts) =>
  let o = opts || {};
  let name = (item && item.name) || "magic item";
  let rarity = String((item && item.rarity) || o.rarity || "common").toLowerCase();
  let rec = d20CraftRecipe(rarity);
  let essences = ["fire", "frost", "storm", "shadow", "light", "fey", "dragon", "abyss"];
  let essence = essences[o.fixedIng != null ? Math.min(Math.max(0, Number(o.fixedIng)), essences.length - 1) : Math.floor(Math.random() * essences.length)];
  let foci = ["fine metal alloy", "rare herbs", "a blessed tool", "an ancient tome", "a rival's blood", "moonlit silver"];
  let focus = foci[o.fixedFocus != null ? Math.min(Math.max(0, Number(o.fixedFocus)), foci.length - 1) : Math.floor(Math.random() * foci.length)];
  return { name, rarity, costGp: rec.gp, days: rec.days, dc: rec.dc, ingredients: ["essence of " + essence, focus] };

d20CraftCheck(opts) =>
  let o = opts || {};
  let rec = d20CraftRecipe(o.rarity || "common");
  let dc = o.dc != null ? Number(o.dc) : rec.dc;
  let check = d20ResolveCheck(dc, { abilityMod: Number(o.abilityMod) || 0, bonus: Number(o.bonus) || 0, fixed: o.fixed });
  return { rarity: String(o.rarity || "common").toLowerCase(), dc, roll: check.kept, total: check.total, passed: check.passed, daysWorked: check.passed ? rec.days : Math.ceil(rec.days / 2), gpSpent: check.passed ? rec.gp : Math.ceil(rec.gp / 2), note: check.passed ? "smooth progress" : "half progress, materials wasted" };

d20CraftComplete(state, opts) =>
  let o = opts || {};
  let s = state || {};
  s.daysWorked = Math.max(0, Number(s.daysWorked) || 0) + Math.max(0, Number(o.days) || 0);
  s.gpSpent = Math.max(0, Number(s.gpSpent) || 0) + Math.max(0, Number(o.gp) || 0);
  let rec = d20CraftRecipe(s.rarity || "common");
  let done = s.daysWorked >= rec.days;
  return { rarity: String(s.rarity || "common").toLowerCase(), daysWorked: s.daysWorked, needed: rec.days, gpSpent: s.gpSpent, budget: rec.gp, done, remainingDays: Math.max(0, rec.days - s.daysWorked) };

// Item 140 — Campaign calendar & timekeeper.
d20Calendar(opts) =>
  let o = opts || {};
  let months = o.months || ["Deepwinter", "Wintertide", "Dawnspring", "Greengrass", "Summertide", "Highsun", "Harvest", "Leaffall", "Frostmere"];
  return { year: Number(o.year) || 1250, month: Math.max(1, Math.min(months.length, Number(o.month) || 1)), day: Math.max(1, Math.min(Number(o.daysPerMonth) || 30, Number(o.day) || 1)), daysPerMonth: Number(o.daysPerMonth) || 30, months: months.slice(), elapsedDays: Math.max(0, Number(o.elapsedDays) || 0) };

d20CalendarAdvance(state, days) =>
  let d = Math.max(0, Number(days) || 0);
  state.elapsedDays += d;
  let total = state.day + d - 1;
  state.month += Math.floor(total / state.daysPerMonth);
  state.day = (total % state.daysPerMonth) + 1;
  while(state.month > state.months.length) { state.month -= state.months.length; state.year += 1; }
  return d20CalendarDate(state);

d20CalendarDate(state) =>
  let monthName = state.months[state.month - 1];
  return { year: state.year, month: state.month, day: state.day, monthName, elapsedDays: state.elapsedDays, string: state.day + " " + monthName + ", " + state.year };

d20MoonPhase(state) =>
  let d = state.day + (state.month - 1) * state.daysPerMonth;
  let names = ["new", "waxing crescent", "first quarter", "waxing gibbous", "full", "waning gibbous", "last quarter", "waning crescent"];
  return names[Math.min(7, Math.floor((d % 30) / 4))];

d20Festivals() =>
  return [
    { month: 1, name: "New Year's Fires", note: "bonfires and pledges" },
    { month: 3, name: "Springtide Fair", note: "markets and games" },
    { month: 6, name: "Highsun Festival", note: "longest day feast" },
    { month: 8, name: "Harvest Home", note: "first grain blessing" },
    { month: 12, name: "Frostmoons", note: "gift-giving and story nights" }];

d20Festival(state) =>
  let list = d20Festivals();
  for(let i = 0; i < list.length; i++) { if(list[i].month === state.month) return Object.assign({}, list[i]); }
  return { month: state.month, name: null, note: "no festival this month" };

d20ElapsedTime(opts) =>
  let o = opts || {};
  let totalHours = Math.max(0, Number(o.hours) || 0);
  return { hours: totalHours, days: Math.floor(totalHours / 24), hoursToday: totalHours % 24, nightsPassed: Math.floor(totalHours / 24), note: "track elapsed in-game time since campaign start" };

// ── 4. ENTRY POINT ($output) ────────────────────────────────────────────────
// $output is a single-item value list whose item is a plain OBJECT API — the
// game-math-plugin / data-visualization-plugin pattern. Importing generators
// receive that object verbatim (objects survive imports; top-level helpers and
// function properties do not — the engine hands out a bare callable for a
// function-valued $output and drops its properties). Importers write:
//
//     d20Tabletop = {import:d20-tabletop-plugin}
//     root.d20Tabletop.roll("3d6+4")              // -> {diceResults, total}
//     root.d20Tabletop.d20(2, {fixed: 17})        // -> {kept, mode}
//     root.d20Tabletop.check(15, {bonus: 4})      // -> {outcome, passed}
//     root.d20Tabletop.npc({seed: 7})             // -> generated NPC
//     root.d20Tabletop.selfCheck().pass === true
//
// Every d20* helper in this file is mapped — the d20 prefix is stripped and
// camelCased (d20Roll -> roll, d20D20 -> d20, d20XPTable -> xpTable,
// d20HPHeal -> hpHeal, d20CheckOutcome -> checkOutcome, ...) — plus
// `version`, `selfCheck()`, and the badge: `d20Tabletop.badge("hello")` (or
// `.call(...)`) renders the original pill on any page, including importers.
//
// The BADGE is still callable the classic way on the plugin's OWN page, where
// the demo binds `var d20Tabletop = root.d20TabletopCall;` — calling it with a
// value renders the stamp; calling it with NO arguments returns this same api
// object. Accepted badge inputs:
//     d20Tabletop("hi")                        plain value
//     d20Tabletop("hi", {color:"#f00"})        value + options object
//     d20Tabletop({text:"hi", color:"#f00"})   options object alone
//     d20Tabletop(d20TabletopOpts)             options read from a list node
//     d20Tabletop(d20TabletopPresets)          a LIST of options -> picks a random one
//
// Options are distinguished from plain values the way text-to-image-plugin
// does it: an options node has a known key (here: `text`), a plain value does
// not. Every value — string, number, item — is read through .evaluateItem so
// Perchance lists work anywhere a plain value would.
//
// Never throw — return a readable "(...)" placeholder on bad input, just like
// card-deck-plugin returns "(unknown card id: ...)".

$output = [d20TabletopEntry()]

d20TabletopEntry() =>
  // Build once, cache forever — repeated evaluations (the engine re-evaluates
  // $output on every access) must all return the SAME object.
  if(window.__D20_TABLETTOP_API_OBJ__) return window.__D20_TABLETTOP_API_OBJ__;
  let api = d20TabletopBuildApi();
  window.__D20_TABLETTOP_API_OBJ__ = api;
  return api;

d20TabletopCall(input, opts) =>
  // No arguments -> the whole engine as a plain object (see comment above).
  if(input == null && opts == null) return d20TabletopBuildApi();
  // A LIST of preset options (d20TabletopPresets) has items but no `.text` key —
  // select a random item exactly ONCE and reuse it (reading selectOne twice
  // would make two independent draws, the first silently discarded). A single
  // options node (d20TabletopOpts), an options object, or a plain value all
  // keep their own `.text` (or none at all). A plain list of strings passes
  // through untouched, so `d20Tabletop(aPlainList)` evaluates to a random
  // item — free list support.
  if(input != null && input.text === undefined) {
    let item = null;
    try { item = input.selectOne; } catch(e) {}
    if(item != null && item !== input && item.text !== undefined) input = item;
  }

  let o = {};
  if(opts != null) {
    o.text = d20TabletopResolve(input);
    o.emoji = d20TabletopResolve(opts.emoji);
    o.color = d20TabletopResolve(opts.color);
  } else if(input != null && input.text !== undefined) {
    o.text = d20TabletopResolve(input.text);
    o.emoji = d20TabletopResolve(input.emoji);
    o.color = d20TabletopResolve(input.color);
  } else {
    o.text = d20TabletopResolve(input);
  }

  if(typeof o.text !== "string" || !o.text.trim()) {
    return "(d20Tabletop: expected some text — got " + JSON.stringify(d20TabletopResolve(input)) + ")";
  }

  return d20TabletopStamp(o.text.trim(), o);

d20TabletopKey(name) =>
  // "Roll" -> "roll", "D20" -> "d20", "XPTable" -> "xpTable",
  // "NPC" -> "npc", "HPHeal" -> "hpHeal", "CRValue" -> "crValue",
  // "SpellSaveDC" -> "spellSaveDC": acronym runs and CamelWords both survive.
  let s = String(name).replace(/([a-z0-9])([A-Z])/g, "$1 $2").replace(/([A-Z])([A-Z][a-z])/g, "$1 $2");
  let words = s.split(" ");
  let out = words[0].toLowerCase();
  for(let i = 1; i < words.length; i++) {
    let w = words[i];
    out += w.toUpperCase() === w ? w : w[0].toUpperCase() + w.slice(1).toLowerCase();
  }
  return out;

d20TabletopBuildApi() =>
  if(window.__D20_TABLETTOP_API_OBJ__) return window.__D20_TABLETTOP_API_OBJ__;
  let names = ["TabletopDefaults","TabletopResolve","TabletopEscape","TabletopSafeColor","TabletopStamp","Roll","D20","CheckOutcome","Check","ScoreMod","Abilities","AbilityModifiers","AdjustScore","HitPoints","HPSetMax","HPDamage","HPHeal","HPTemp","HitDice","HitDiceAdd","HitDiceRemaining","HitDiceSpend","HitDiceRoll","HitDiceRecover","HitDiceFromClass","DeathState","DeathSave","DeathOnDamage","ProficiencyBonus","ProficiencyTiers","ProficiencyTierMultiplier","ProficiencyBonusFor","Skills","ProficiencyMap","CheckBonus","ResolveCheck","XPTable","LevelFromXP","XPForLevel","XPToNext","LevelUpHP","Multiclass","Inventory","InventoryAdd","InventoryWeight","Encumbrance","AC","WeaponProperties","Weapon","WeaponHas","Initiative","InitiativeNext","ActionBudget","BudgetSpendAction","BudgetMove","BudgetRemaining","RoundReset","TurnNext","Attack","Damage","DamageDefense","DamageTypeDefense","Conditions","ConditionState","ConditionApply","ConditionRemove","ConditionHas","ConditionList","ConditionModifiers","AttackWithConditions","SaveWithConditions","ConditionTick","Resources","ResourceAdd","ResourceSpend","ResourceRefund","ResourceReset","SpellSlots","ShortRest","LongRest","SpellAttack","SpellSaveDC","Spellcasting","SpellsPrepared","SpellsKnown","CantripsKnown","SpellLimits","SpellLimitCheck","Concentration","ConcentrationCast","ConcentrationSaveDC","ConcentrationEnd","ConcentrationSave","Upcast","CastSpell","GridDistance","Speeds","SpeedMove","ReachRange","OpportunityAttack","AoeTiles","MassSave","SaveForHalf","MassSaveDamage","CoverModifiers","AttackWithCover","VisionModifier","PassiveScore","PassiveFor","StealthRoll","StealthResolve","HiddenState","Hide","SpotCheck","UnseenAttacker","Fall","BreathHold","SuffocationTimer","SuffocateState","SuffocateTick","Exhaustion","ExhaustionAdd","ExhaustionModifiers","Grapple","GrappledState","GrappleEnds","Shove","TacticalActions","Dodge","DodgeModifiers","Help","Ready","ReadyTrigger","TacticalReset","ConditionalModifiers","ApplyConditionalModifiers","PrerequisiteCheck","DamageReduction","DamageReductionFor","DamageThreshold","ApplyDamageReductions","CRXPTable","CRValue","CRXP","CRProficiencyBonus","Multiattack","LegendaryActions","LegendaryRecharge","LegendarySpend","LegendaryAvailable","LegendaryResistance","LegendaryResist","LegendaryResistanceAvailable","AttunementSlots","AttunementCheck","Attune","Unautune","AttunementSlotsRemaining","Charges","ItemCharges","ChargeCount","ChargeUse","ChargeRecharge","Enhancement","EnhancedAttack","EnhancedDamage","EnhancedAC","EnhancedDC","ReactionHooks","ReactionRegister","ReactionRun","ReactionSpend","ReactionShield","ReactionUncannyDodge","ReactionReset","PostRollBonus","PostRollAdd","PostRollAvailable","PostRollApply","PostRollReset","AuditLogger","Audit","AuditQuery","AuditLast","AuditSummary","AuditClear","EncounterThresholds","EncounterThresholdForLevel","EncounterThresholdsForParty","EncounterDifficulty","EncounterMultiplier","AdjustedXP","AdjustedEncounterXP","RewardPool","RewardSplit","RewardAward","RewardMilestone","TravelPaces","TravelPace","TravelDistance","NavigationDC","NavigationCheck","ForageDC","ForageCheck","Clock","ClockAdvance","ClockDisplay","Dispositions","DispositionState","DispositionSet","DispositionGet","DispositionAdjust","DispositionChange","SocialDC","SocialCheck","PassiveInsight","InsightVsDeception","Currency","CurrencyRates","CurrencyValue","CurrencyTo","CurrencyAdd","CurrencyNormalize","CurrencyWeight","CurrencyFromValue","CraftingDays","CraftingCost","CraftingCheck","CraftStart","CraftWork","CraftStatus","Lifestyles","LifestyleCost","LifestyleExpense","LifestylePay","LairActions","LairRegister","LairCanAct","LairResolve","LairNewRound","RegionalEffects","RegionalAdd","RegionalSetRadius","RegionalCheck","RegionalModifiers","Trap","TrapDetect","TrapDisarm","TrapArmed","TrapTrigger","TrapResolve","Mount","MountControl","MountAction","MountInitiative","MountTarget","MountCost","Dismount","ForcedDismount","VehicleSection","Vehicle","VehicleDamage","VehicleStatus","VehicleCrew","VehicleRepair","Companion","CompanionScale","CompanionStats","SummonController","SummonRegister","SummonInitiative","SummonCommandCost","SummonCommand","SummonTurnOrder","Swarm","SwarmDegraded","SwarmDamage","SwarmCondition","SwarmImmunities","SwarmSpace","AlignmentAxes","Alignment","AlignmentShift","FactionState","FactionAdd","FactionRank","FactionReputation","FactionGain","FactionPerks","FactionContacts","AlignmentRestriction","FactionRestriction","RestrictionCheck","ExposureState","HeatExposureState","ColdExposureState","HeatExposure","ColdExposure","UnderwaterMovement","UnderwaterCombat","UnderwaterModifiers","WeatherHazards","WeatherEffects","WeatherModifiers","Serialize","Deserialize","Schema","SchemaApplyDefaults","SchemaValidate","Migrate","SnapshotEngine","SnapshotTake","SnapshotRestore","SnapshotPeek","SnapshotCount","SnapshotClear","PoisonVectors","Poison","PoisonExposure","PoisonSave","Disease","DiseaseState","DiseaseStage","DiseaseTick","DiseaseCure","CurseState","CurseApply","CurseCheck","CurseModifiers","CurseList","SanityState","SanityCheck","HorrorCheck","MadnessTables","MadnessRoll","MadnessState","MadnessApply","MadnessTick","MadnessList","StressState","StressGain","StressRelieve","StressRecover","StressStatus","ChaseState","ChaseAddPursuer","ChaseUpdate","ChaseLead","DashStamina","ChaseStaminaState","ChaseDash","ChaseStaminaReset","ChaseComplications","ChaseComplicationRoll","ChaseComplicationResolve","UnitFormations","Unit","UnitRemaining","UnitDamage","UnitAttack","UnitStatus","MobNeeded","MobAttackersPerHit","MobAttack","MoraleState","MoraleShouldCheck","MoraleCheck","MoraleResolve","Scroll","ScrollCompatibility","ScrollHighestSlot","ScrollActivate","InscriptionCost","SpellbookState","SpellbookAdd","ScrollMishaps","ScrollMishapRoll","ScrollMishapResolve","ScrollResolve","WildMagicState","WildMagicTrigger","TidesOfChaos","TidesOfChaosRecharge","WildMagicCast","WildMagicTable","WildMagicOutcome","WildMagicDispatch","MetamagicOptions","MetamagicFind","MetamagicCost","MetamagicValidate","MetamagicApply","HomebrewStore","HomebrewRegistry","HomebrewSchema","HomebrewValidate","HomebrewRegister","HomebrewBuild","HomebrewList","CRFromHP","CRFromDPR","CRLabel","ExpectedAC","ExpectedAttackBonus","CRAssess","PointBudgetTraits","PointBudgetTrait","PointBudgetCost","PointBudgetBuild","QuestState","QuestAdd","QuestSet","QuestStart","QuestComplete","QuestFail","QuestAbandon","QuestStatus","QuestList","ObjectiveState","ObjectiveAdd","ObjectivePrereqsMet","ObjectiveCanStart","ObjectiveStart","ObjectiveComplete","ObjectiveAvailable","ObjectiveList","ObjectiveSummary","RewardState","RewardDispatch","RewardPartyXP","RewardLevelUp","RewardReputation","RewardItems","RewardUndo","RewardSummary","PlaneState","PlaneDefine","PlaneActivate","PlaneDeactivate","PlaneList","PlaneEffects","PlaneResolve","TeleportTable","TeleportFamiliarity","TeleportResolve","TeleportMishapDamage","ExtradimensionalItems","ExtradimensionalState","ExtradimensionalAdd","ExtradimensionalFill","ExtradimensionalRemove","ExtradimensionalSuffocation","ExtradimensionalRift","MassSavingThrows","MassSavingThrowsSummary","BatchPct","BatchTargets","BatchState","BatchAdd","BatchDamage","BatchHeal","BatchCondition","BatchRemoveCondition","BatchStatus","EncounterState","EncounterAll","EncounterAdd","EncounterMetrics","EncounterDanger","EncounterRound","EncounterTurn","EncounterCurrentTurn","EncounterDamage","EncounterSummary","CombatRoll","CombatState","CombatAdd","CombatSort","CombatOrder","CombatNext","CombatCurrent","CombatReroll","CombatRemove","CombatStatus","EncounterBudget","EncounterBuild","TreasureTiers","ExprRoll","TreasureGems","MagicItems","MagicItem","TreasureHoard","SeededRand","NPCRaces","NPCNameParts","NPCName","NPCOccupation","NPCPersonality","NPC","WeatherSeasons","WeatherConditions","WeatherWeights","WeatherFor","WeatherRoll","WeatherDaily","TravelTime","ForcedMarch","ExhaustionLevel","RestShort","RestLong","ShopItem","ShopState","ShopStock","ShopBuy","ShopSell","ShopBarter","ShopSummary","SkillChallengeState","SkillChallengeRoll","SkillChallengeResult","DowntimeActivities","DowntimeActivity","DowntimeResolve","DungeonState","RoomPurposes","Traps","DungeonTrap","DungeonRoom","DungeonExplore","DungeonTrapTrigger","DungeonClear","DungeonSummary","CombatActions","CombatAction","ActionAllowed","ValidateAction","TakeAction","AdvantageStack","AdvantageRoll","AdvantageSummary","RechargeState","RechargeRoll","RechargeUse","RechargeReady","RechargeReset","MonsterLootTable","LootTier","MonsterLoot","TavernAdjectives","TavernNouns","TavernName","TavernAtmosphere","TavernRumors","TavernRumor","Tavern","PlaceNameParts","PlaceName","WildernessTerrain","EncounterData","EncounterTable","EncounterRoll","EncounterChance","PartyXP","PartyLevelUps","MilestoneSuggestion","CraftRecipe","CraftItem","CraftCheck","CraftComplete","Calendar","CalendarAdvance","CalendarDate","MoonPhase","Festivals","Festival","ElapsedTime"];
  let api = { version: "1.0.0" };
  for(let i = 0; i < names.length; i++) {
    let fn = root["d20" + names[i]];
    if(typeof fn !== "function") continue;
    api[d20TabletopKey(names[i])] = fn;
  }
  api.selfCheck = root["d20TabletopSelfCheck"];
  api.call = root["d20TabletopCall"];
  api.badge = api.call;
  // Stringifying the api object must never produce a square-bracket pair:
  // the engine scans page text for `[...]` template blocks, and the default
  // String(api) = "[object Object]" would be re-parsed as an expression and
  // raise a load-time "unexpected token" error. Non-enumerable so the api's
  // key set stays exactly {version, helpers..., selfCheck, call, badge}.
  Object.defineProperty(api, "toString", { value: function() {
    return "d20-tabletop-plugin engine API, version " + (api.version || "?") + " — call root.d20Tabletop.roll, check, npc, selfCheck, badge and friends (see the plugin page docs)";
  }, enumerable: false, configurable: true });
  window.__D20_TABLETTOP_API_OBJ__ = api;
  return api;

d20TabletopSelfCheck() =>
  let checks = [];
  let add = function(name, pass, detail) { checks.push({ name, pass: !!pass, detail: detail != null ? detail : (pass ? "ok" : "FAIL") }); };

  // 1. dice — result shape, bounds and bad input
  let r1 = d20Roll("2d6+4");
  add("roll.shape-and-bounds", r1.total === r1.diceTotal + r1.modifier && r1.diceResults.length === 2 && r1.diceTotal >= 2 && r1.diceTotal <= 12 && r1.modifier === 4);
  add("roll.bad-input", d20Roll("not dice").error != null && d20Roll(42).error != null && d20Roll("").error != null);
  add("roll.expr-fixed", d20ExprRoll("3d6", 4).total === 12 && d20ExprRoll("3d6", 4).rolls.join(",") === "4,4,4");
  add("roll.expr-zero", d20ExprRoll("0").total === 0);

  // 2. d20 — advantage keeps the higher roll, disadvantage the lower
  let savedRandom = Math.random;
  let advOk = false, disOk = false, fixedOk = false;
  try {
    let q = [0.05, 0.95];
    Math.random = function() { return q.length ? q.shift() : 0.5; };
    let a = d20D20("advantage");
    advOk = a.kept === 20 && a.kept === Math.max(a.rolls[0], a.rolls[1]) && a.mode === "advantage";
    q = [0.95, 0.05];
    Math.random = function() { return q.length ? q.shift() : 0.5; };
    let b = d20D20("disadvantage");
    disOk = b.kept === 2 && b.kept === Math.min(b.rolls[0], b.rolls[1]) && b.mode === "disadvantage";
    fixedOk = d20D20("normal", 17).kept === 17 && d20D20("normal", 99).kept === 20 && d20D20("normal", 0).kept === 1;
  } catch(e) { advOk = false; disOk = false; fixedOk = false; }
  Math.random = savedRandom;
  add("d20.advantage-keeps-higher", advOk);
  add("d20.disadvantage-keeps-lower", disOk);
  add("d20.fixed-clamps", fixedOk);

  // 3. crit classification
  add("checkOutcome.crit-success", d20CheckOutcome(25, 20, 15).outcome === "critical_success" && d20CheckOutcome(25, 20, 15).passed === true);
  add("checkOutcome.crit-failure", d20CheckOutcome(5, 1, 15).outcome === "critical_failure" && d20CheckOutcome(5, 1, 15).passed === false);
  add("checkOutcome.pass-fail", d20CheckOutcome(17, 14, 15).outcome === "success" && d20CheckOutcome(10, 10, 15).outcome === "failure");

  // 4. score modifier
  add("scoreMod", d20ScoreMod(14) === 2 && d20ScoreMod(8) === -1 && d20ScoreMod(10) === 0);

  // 5. HP pool — temp absorbs damage first, heal caps at max
  let pool = d20HitPoints(10, 10, 5);
  let dmg = d20HPDamage(pool, 7);
  add("hpDamage.temp-absorbs-first", dmg.tempAbsorbed === 5 && dmg.hpDamage === 2 && pool.current === 8 && pool.temp === 0);
  let pool2 = d20HitPoints(10, 5);
  let heal = d20HPHeal(pool2, 20);
  add("hpHeal.caps-at-max", heal.applied === 5 && pool2.current === 10);

  // 6. hit dice pool — add, remaining, spend
  let hd = d20HitDice();
  d20HitDiceAdd(hd, 8, 2);
  d20HitDiceAdd(hd, 6, 3);
  let rem = d20HitDiceRemaining(hd);
  let spent = d20HitDiceSpend(hd, 8, 1);
  add("hitDice.pool", rem.remaining === 5 && rem.byDie.d8 === 2 && rem.byDie.d6 === 3);
  add("hitDice.spend", spent.spent === 1 && d20HitDiceRemaining(hd).remaining === 4);

  // 7. combat tracker — add entities, then order by initiative desc
  let st = d20CombatState();
  d20CombatAdd(st, { id: "a", name: "Aaa", fixed: 12 });
  d20CombatAdd(st, { id: "b", name: "Bbb", fixed: 5 });
  d20CombatAdd(st, { id: "c", name: "Ccc", fixed: 20 });
  let order = d20CombatOrder(st).map(function(e) { return e.id; });
  add("combat.add", st.byId.a.initiative === 12 && st.byId.b.initiative === 5 && st.byId.c.initiative === 20 && st.combatants.length === 3);
  add("combat.order", order.join(",") === "c,a,b");

  // 8. NPC generation — seeded + deterministic
  let n1 = d20NPC({ seed: 7, race: "elf", fixedOcc: 0, fixedPersonality: 1 });
  let n2 = d20NPC({ seed: 7, race: "elf", fixedOcc: 0, fixedPersonality: 1 });
  add("npc.gen", typeof n1.name === "string" && n1.race === "elf" && n1.name.indexOf(" ") > 0 && n1.name === n1.given + " " + n1.surname && n1.age >= 18);
  add("npc.seeded-deterministic", n1.name === n2.name && n1.age === n2.age);

  // 9. treasure hoard — fixed rolls compute exact coins & value
  let h = d20TreasureHoard({ tier: "0-4", fixed: 1, fixedGem: 0, fixedMagic: 0 });
  add("treasure.hoard", h.tier === "0-4" && h.coins.cp === 600 && h.coins.sp === 300 && h.gems.length === 2 && h.totalValue === 76);

  // 10. weather — daily series respects season & fixed condition indices
  let wd = d20WeatherDaily({ season: "summer", days: 3, fixed: [0, 1, 2] });
  add("weather.daily", wd.length === 3 && wd[0].season === "summer" && wd[0].key === "clear" && wd[1].key === "cloudy" && wd[2].key === "rain_light");

  // 11. encounter budget — ascending difficulty
  let b = d20EncounterBudget(5, 4);
  add("encounter.budget", b.level === 5 && b.size === 4 && b.easy < b.medium && b.medium < b.hard && b.hard < b.deadly);

  let failed = checks.filter(function(c) { return !c.pass; });
  return { pass: failed.length === 0, version: "1.0.0", checked: checks.length, failed: failed.length, checks };
