// ─────────────────────────────────────────────────────────────
//  BATTLEMECH · 3025 — main.pjs
//  A first-edition-style BattleTech table built on the BGN Hex
//  framework: 'Mech lances on a hex battlefield with movement
//  points, terrain, line of sight, armor/internal damage, critical
//  hits, heat, ammo explosions, pilot wounds, melee and the online
//  multiplayer table (rooms, turn order, presence, chat).
//  ─────────────────────────────────────────────────────────────

$meta
  title = BattleMech 3025
  description = First-edition-style BattleTech on the BGN table: two lances of BattleMechs fight across a ridge and river valley with movement points, terrain, line of sight, armor vs internal damage, critical hits, heat and ammo explosions. Play locally, vs AI, or online with a friend.
  tags = battletech, mech, wargame, hex, strategy, two player, multiplayer, online, rooms
  image = https://user.uploads.dev/file/d0de92ad02b9a481c1d17aa1ccd56f3d.jpg

hubUrl = https://perchance.org/bgn-boardgame-network  // ← SET THIS to your network hub's URL
projectsUrl = https://perchance.org/rathjis-generators  // ← SET THIS to your Perchance projects page (shown as "Rathji's Projects" in the top nav)
projectsLabel = Rathji's Projects  // ← SET THIS to what you want the nav button to say
authorInitial = R  // ← SET THIS to the initial shown on the "Rathji's Projects" badge
gameTitle = BattleMech 3025
gameTagline = Two lances of BattleMechs, one ridge, and all the armor-piercing, ammo-exploding, heat-dumping chaos of the first-edition tabletop — now on a hex grid.
gameKicker = Mechs · Lasers · Heat
gameGenre = Hex Wargame
gamePlayers = 2 players
accentColor = #e2573d
heroImage = https://user.uploads.dev/file/d0de92ad02b9a481c1d17aa1ccd56f3d.jpg

createServerSocket = {import:server-plugin}
