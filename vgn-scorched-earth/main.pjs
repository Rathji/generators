// ════════════════════════════════════════════════════════════════
//  SCORCHED EARTH — VGN EDITION
//  A hand-built artillery duel rebuilt on the VGN Platform Template
//  (perchance.org/vgn-platform-template) for the Video Game Network
//  (perchance.org/vgn-video-game-network).
//
//  The game code lives in index.html's src/ scripts (00-core.js,
//  10-terrain.js, 20-entities.js, 30-ai.js, 40-audio.js, 50-ui.js).
//  This file carries the generator metadata plus a couple of lists
//  the game pulls from at runtime (computer tank names).
// ════════════════════════════════════════════════════════════════

$meta
  title = Scorched Earth — VGN Edition
  description = A rebuilt artillery duel on the VGN Platform Template. Take turns setting angle, power and weapon — mind the wind — and blast the other tanks off the mountain. Destructible terrain, homing missiles, napalm, nukes, AI opponents and local multiplayer.
  tags = scorched earth, artillery, tanks, game, vgn, video game network, canvas, destructible terrain, multiplayer, ai, retro
  image = https://user.uploads.dev/file/3eab3fad24f7d5d53d6d2e9f12a9b1c4.jpg
  header
    mode = minimal

// Computer tank first names, e.g. "Iron Bunker"
aiNameAdj
  Iron
  Rusty
  Mad
  Silent
  Crazed
  Lucky
  Furious
  Old
  Foxy
  Savage
  Drunken
  Sneaky

// Computer tank last names
aiNameNoun
  Bunker
  Blaster
  Wrecker
  Gunner
  Howitzer
  Ironclad
  Barrage
  Turret
  Cannon
  Sniper
  Recoil
  Tanker
