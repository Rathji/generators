$meta
  title = Battlefield 3025
  description = BattleTech-styled tactical field report generator — random mechs, pilots, and deployment orders.
  tags = battletech, mechs, sci-fi, military

title
  BATTLEFIELD 3025

subtitle
  TACTICAL FIELD REPORT // MECH COMBAT DOCTRINE

d6 = {1-6}
d10 = {1-10}

mech
  Atlas AS7-D
  Mad Cat Prime
  Warhammer WHM-6R
  Marauder MAD-3R
  Locust LCT-1V
  Shadow Hawk SHD-2H
  Archer ARC-2R
  Awesome AWS-8Q
  Hunchback HBK-4G
  Catapult CPLT-C1
  BattleMaster BLR-1G
  Wolverine WVR-6R
  Grasshopper GHR-5H
  Black Knight BL-6-KNT
  Thunderbolt TDR-5S
  Stalker STK-3F
  Orion ON1-K
  Crab CRB-27

callsign
  Raptor
  Vulture
  Wraith
  Anvil
  Hex
  Nomad
  Dagger
  Ironclad
  Sabre
  Titan
  Coyote
  Warden
  Ghost
  Bulwark

pilot
  Major [callsign]
  Captain [callsign]
  Lieutenant [callsign]
  Sergeant [callsign]
  Star Captain [callsign]
  Kommandant [callsign]

planet
  Outreach
  Hesperus II
  New Avalon
  Tharkad
  Solaris VII
  Luthien
  Robinson
  Donegal
  Tukayyid
  Coventry
  Sudeten
  Tamar
  Canopus IV
  Galatea
  Arc-Royal

faction
  House Davion
  House Steiner
  House Kurita
  House Marik
  House Liao
  Clan Wolf
  Clan Jade Falcon
  Clan Ghost Bear
  Wolf's Dragoons
  Eridani Light Horse
  Kell Hounds
  ComStar
  Gray Death Legion
  Northwind Highlanders

mission
  a recon patrol
  a planetary assault
  a defensive screen
  a convoy escort
  a search-and-destroy sweep
  a garrison rotation
  a Trial of Possession
  an extraction operation
  artillery suppression
  a hot landing-zone drop
  a training exercise
  a dueling circuit bout

weather
  clear
  overcast
  sandstorm
  heavy rain
  arctic gale
  volcanic ash
  monsoon

terrain
  lowlands
  highlands
  urban sprawl
  forest canopy
  frozen tundra
  blasted flats
  canyon network
  wetland bog

encounter
  light
  moderate
  heavy
  extreme

status
  ALL VITALS NOMINAL
  COMBAT-READY
  REDUCED EFFECTIVENESS
  ONE CREWMAN IN THE MASH
  ARMAMENT 80%

percent = {5-45}
days = {2-9}
hours = {3-8}

output
  DEPLOYMENT ORDER CN-[d6][d10][d10]-[d6][d10][d10]<br>[mech] — [pilot]<br>ASSIGNMENT: [mission] in the [planet] system<br>AUTHORITY: [faction] // GRID [d6][d6][d6]-[d6][d6][d6]
  FIELD SITREP — [planet] system<br>[pilot] (in [mech]) reports [encounter] enemy contact across the [terrain].<br>[weather] conditions degrade targeting by [percent]%.<br>SUPPORT: [faction] logistics // NEXT DROP: [days] DAYS
  TRIAL OF POSSESSION — [planet]<br>CHALLENGER: [pilot] aboard a [mech]<br>CONTRA: [faction] garrison<br>VICTORY: submission or destruction // EST. DURATION: [hours] HOURS
  POST-BATTLE SALVAGE REPORT<br>HULL: [mech] // DAMAGE: [percent]%<br>FIELD RESUPPLY: [faction] // CREW: [status]<br>RECOMMENDATION: ROTATE TO REAR ECHELON
  GARRISON LOG — [planet] system<br>STANDING UNIT: [pilot] // [mech]<br>POSTURE: [encounter] alert // [terrain] patrol grid<br>LIAISON: [faction] // COMMS CHECK: [d6]/[d6] NOMINAL
