// ============================================================================
// WEBUNTU BUSINESS — a fictional Debian-based business OS ("Webuntu 12, Iron
// Ledger") that runs in your browser on Perchance, styled with the Rathji
// palette. It is the business edition of the Webuntu desktop: the gaming /
// hobby content is replaced by a suite of 11 embedded Perchance generators —
// The Ledger (bookkeeping), sys-plan (system boards), Chance Code (IDE),
// Diagram It (IT diagrams), Atomic Roadmap (AI backlogs), Perch Edit (code
// editor), Project Master (PM suite), AI Voice Assistant, File Format
// Converter, Todo Checklist and Voice Assistant — plus native business apps
// (Mail, Notes, File Manager, Finance folder, AI Assistant, Browser, ...).
// Prior roadmap history (v1 gaming era) lives on in src/ROADMAP.md.
// ============================================================================

$meta
  title = Webuntu Business OS
  description = Webuntu Business 12 "Iron Ledger" — a fictional Debian-inspired business desktop that runs in your browser: full shell with Start menu, window manager, virtual filesystem, login screen, and a pre-installed suite of Perchance productivity apps (The Ledger, Project Master, Atomic Roadmap, sys-plan, Diagram It, Chance Code, Perch Edit, Todo Checklist, File Format Converter + AI/voice assistants). Includes AI desktop Assistant, voice dictation, AI Images, Mail, Software Center, and realtime Perch Chat.
  tags = os, desktop, business, productivity, finance, ai
  image = https://user.uploads.dev/file/1f7aa97804ff60d12a0d8a6fef74f075.png
  header
    mode = minimal

// --- POST-52, Task 57: Online presence + chat (server-plugin) -----------------
// Adds the realtime server used by the tray "N online" indicator and the
// Perch Chat app (server code lives in index.html's text/x-server-plugin block).
createServerSocket = {import:server-plugin}

// --- PHASE 10, Task 77: Webuntu Assistant -------------------------------------
// The AI layer: generateText powers the Assistant chat; generateImage lets the
// Assistant create images on demand (save to Pictures / set as wallpaper).
generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}

// --- PHASE 10, Task 79: Voice everywhere ---------------------------------------
// The voice layer: voiceTools powers the tray-mic dictation (Win+H style) and
// the Assistant reading replies aloud via TTS. gh = GitHub data, uploadPlugin
// hosts files, kv backs the (legacy) native Projects module + settings.
voiceTools = {import:voice-tools-plugin}
gh = {import:github-data-plugin}
uploadPlugin = {import:upload-plugin}
kv = {import:kv-plugin}

// --- Phase 1, Task 1: Distro identity -----------------------------------------
// Data object consumed by the About screen, boot screen, Terminal & Settings.
// Access any field as root.distro.<field>.evaluateItem

distro
  name = Webuntu Business
  codename = Iron Ledger
  version = 12
  edition = Business
  basedOn = Debian 12
  desktopEnv = Perch Desktop
  kernel = 6.8.0-perch-mint
  shell = Perch Shell
  tagline = The browser desktop for your business — books, plans, boards and code on Perchance.
  fullName = [this.name] [this.version] "[this.codename]"

// Convenience block for the About screen and the Terminal's `about-webuntu`
// (neofetch-style) command. $output joins the lines with newlines.
distroAboutText
  OS: [distro.name] [distro.version] "[distro.codename]"
  Edition: [distro.edition]
  Based on: [distro.basedOn]
  Desktop Environment: [distro.desktopEnv]
  Kernel: [distro.kernel]
  Default Shell: [distro.shell]
  $output = [this.joinItems("\n")]

// --- Phase 1, Task 2: Boot sequence ------------------------------------------
// Pseudo-boot log lines cycled on the boot screen (index.html reads these via
// root.bootLog.selectAll). Each line carries a `status` marker: ok|info|warn.

bootLog
  kernel
    line = Loading kernel [distro.kernel]...
    status = ok
  mount
    line = Mounting root filesystem...
    status = ok
  init
    line = Starting Perch systemd...
    status = info
  hardware
    line = Probing virtual hardware...
    status = info
  network
    line = Bringing up network interfaces...
    status = ok
  ledger
    line = Opening the ledger...
    status = ok
  wm
    line = Initializing window manager...
    status = info
  theme
    line = Loading Rathji theme...
    status = warn
  session
    line = Starting user session...
    status = ok

// --- Phase 1, Task 3: Desktop root -------------------------------------------
// Default desktop icons. These mirror the virtual-filesystem folders + the
// flagship business suite; when the FS exists, the desktop reads its icons
// from there instead. Each item: id, name (label), icon (emoji glyph),
// color (tile accent), kind (app|folder|link), target (folder path / slug).

desktopDefaults
  ledger
    id = the-ledger
    name = The Ledger
    icon = 🧾
    color = #22c55e
    kind = app
  projectMaster
    id = project-master
    name = Project Master
    icon = 📋
    color = #34d399
    kind = app
  atomicRoadmap
    id = atomic-roadmap
    name = Atomic Roadmap
    icon = 🗺️
    color = #8b5cf6
    kind = app
  documents
    id = documents
    name = Documents
    icon = 📄
    color = #22d3ee
    kind = folder
    target = /home/user/Documents
  finance
    id = finance
    name = Finance
    icon = 💰
    color = #22c55e
    kind = folder
    target = /home/user/Finance
  projects
    id = projects
    name = Projects
    icon = 🗂️
    color = #8b5cf6
    kind = folder
    target = /home/user/Projects
  softwareCenter
    id = software-center
    name = Software Center
    icon = 🧩
    color = #94a3b8
    kind = app
    singleton = true
  trash
    id = trash
    name = Trash
    icon = 🗑️
    color = #64748b
    kind = folder
    target = /Trash

// --- Phase 1, Task 4: Lock / login screen ------------------------------------
// User profile shown on the login screen (avatar, name, host) and used by apps.

user
  name = user
  host = webuntu
  displayName = Business User

// --- Phase 3, Task 14: Start menu app catalog ----------------------------------
// The "installed" app set shown in the Start menu (and Software Center's
// "Installed" tab). Fields: id, name, icon, color, category, blurb.
// type=link opens a perchance slug in a new tab; stub marks a planned app.
// Embed apps (the business suite) register a content builder in
// window.AppContent via src/webapps.js (or src/perchedit.js for perch-edit).

