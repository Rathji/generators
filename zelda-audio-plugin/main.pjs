orchestralAudioSources
  zreoArchive
    name = Zelda Reorchestrated Archive
    kind = orchestral fan arrangements
    url = https://www.zreoarchive.org/
    status = DONE — all 21 albums / 331 tracks wired into orchestralTracks (cat=orchestral, game=orchestral, direct static.zreoarchive.org URLs)
    notes = Console: LoZ, AoL, LttP, OoT, MM, WW, TP, SS. Handheld: LA, OoA, OoS, FSA, MC, PH, ST. Compositions: Soundscape Vol. 1-3, Open Symphony, Battlescapes, Twilight Symphony. Durations computed 2026-08-20 from browser audio metadata (Xing headers). Audio element playback of these URLs works directly (fetch is CORS-blocked; no re-hosting needed).

// ---------- API ----------
getState() =>
  const S = window.__zeldaAudioState;
  if (S) return S;
  const fresh = {
    activeEl: null,
    current: null,
    volume: 1,
    loop: false,
    crossfade: 0,
    playlist: [],
    plIdx: -1,
    shuffle: false,
    changeCb: null,
    endedCb: null,
    tracks: null,
    cats: null,
    games: null
  };
  const saved = getSettings();
  if (saved) {
    if (typeof saved.volume === "number") fresh.volume = saved.volume;
    if (typeof saved.loop === "boolean") fresh.loop = saved.loop;
  }
  window.__zeldaAudioState = fresh;
  return fresh;

getSettings() =>
  try {
    const raw = localStorage.getItem("zeldaAudioSettings");
    return raw ? JSON.parse(raw) : null;
  } catch (e) { return null; }

saveSettings() =>
  const S = getState();
  try { localStorage.setItem("zeldaAudioSettings", JSON.stringify({ volume: S.volume, loop: S.loop })); } catch (e) {}

getCats() =>
  const S = getState();
  if (S.cats) return S.cats;
  const cats = {
    title: "Title / Intro",
    overworld: "Overworld",
    town: "Towns & NPCs",
    dungeon: "Dungeons",
    boss: "Boss Battles",
    combat: "Combat & Chases",
    ocarina: "Ocarina Songs",
    event: "Events & Story",
    ambient: "Ambient & Fairy",
    minigame: "Minigames",
    jingle: "Jingles & Fanfares",
    credits: "End Credits",
    orchestral: "Orchestral (ZREO)"
  };
  S.cats = cats;
  return cats;

getEras() =>
  return {
    console: "Console",
    handheld: "Handheld",
    compositions: "Compositions"
  };

getAlbums() =>
  const S = getState();
  if (S.albums) return S.albums;
  const albums = {};
  const nodes = orchestralTracks.selectAll;
  for (let i = 0; i < nodes.length; i++) {
    const n = nodes[i];
    const slug = n.albumSlug.evaluateItem;
    if (!albums[slug]) {
      albums[slug] = {
        slug: slug,
        album: n.album.evaluateItem,
        era: n.era.evaluateItem,
        count: 0,
        tracks: []
      };
    }
    albums[slug].count++;
    albums[slug].tracks.push({
      track: n.track.evaluateItem,
      name: n.name.evaluateItem,
      cat: "orchestral",
      length: "",
      url: n.url.evaluateItem,
      game: "orchestral"
    });
  }
  S.albums = albums;
  return albums;

getTracks() =>
  const S = getState();
  if (S.tracks) return S.tracks;
  const list = [];
  const tables = { oot: ootTracks, lttp: lttpTracks, ww: wwTracks, botw: botwTracks, orchestral: orchestralTracks };
  for (const g in tables) {
    const nodes = tables[g].selectAll;
    for (let i = 0; i < nodes.length; i++) {
      const n = nodes[i];
      const t = {
        track: n.track.evaluateItem,
        name: n.name.evaluateItem,
        cat: n.cat.evaluateItem,
        length: (n.length && n.length.evaluateItem) || "",
        url: n.url.evaluateItem,
        game: g
      };
      if (g === "orchestral") {
        t.album = n.album.evaluateItem;
        t.albumSlug = n.albumSlug.evaluateItem;
        t.era = n.era.evaluateItem;
      }
      if (g === "ww" || g === "botw") t.disc = (n.disc && n.disc.evaluateItem) || "";
      list.push(t);
    }
  }
  S.tracks = list;
  return list;

getGames() =>
  const S = getState();
  if (S.games) return S.games;
  const tracks = getTracks();
  const games = {
    oot: { label: "The Legend of Zelda: Ocarina of Time", trackCount: tracks.filter(function (t) { return t.game === "oot"; }).length },
    lttp: { label: "The Legend of Zelda: A Link to the Past", trackCount: tracks.filter(function (t) { return t.game === "lttp"; }).length },
    ww: { label: "The Legend of Zelda: The Wind Waker", trackCount: tracks.filter(function (t) { return t.game === "ww"; }).length },
    botw: { label: "The Legend of Zelda: Breath of the Wild", trackCount: tracks.filter(function (t) { return t.game === "botw"; }).length },
    orchestral: { label: "Orchestral (ZREO)", trackCount: tracks.filter(function (t) { return t.game === "orchestral"; }).length }
  };
  S.games = games;
  return games;

find(query) =>
  const q = String(query == null ? "" : query).trim().toLowerCase();
  const tracks = getTracks();
  if (!q) return tracks.slice();
  if (getCats()[q]) return tracks.filter(function (t) { return t.cat === q; });
  if (getGames()[q]) return tracks.filter(function (t) { return t.game === q; });
  const num = parseInt(q, 10);
  return tracks.filter(function (t) {
    return String(t.track) === q ||
      (isFinite(num) && parseInt(t.track, 10) === num) ||
      t.name.toLowerCase().indexOf(q) !== -1 ||
      (t.album || "").toLowerCase().indexOf(q) !== -1 ||
      (t.era && getEras()[t.era] ? getEras()[t.era].toLowerCase().indexOf(q) !== -1 : false);
  });

pick(query) =>
  const list = find(query);
  if (!list.length) return null;
  return list[Math.floor(Math.random() * list.length)];

shuffleArr(arr) =>
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    const tmp = arr[i];
    arr[i] = arr[j];
    arr[j] = tmp;
  }

fadeIn(el, ms, target) =>
  if (ms <= 0) { el.volume = target; return; }
  const steps = 30;
  const dt = ms / steps;
  const dv = target / steps;
  let v = 0;
  const iv = setInterval(function () {
    v = Math.min(target, v + dv);
    el.volume = v;
    if (v >= target) clearInterval(iv);
  }, dt);

fadeOut(el, ms) =>
  if (ms <= 0) { try { el.pause(); } catch (e) {} return; }
  const steps = 30;
  const dt = ms / steps;
  const dv = (el.volume || 0) / steps;
  const iv = setInterval(function () {
    const nv = el.volume - dv;
    if (nv <= 0.01) {
      el.volume = 0;
      try { el.pause(); } catch (e) {}
      clearInterval(iv);
    } else {
      el.volume = nv;
    }
  }, dt);

play(query, opts) =>
  opts = opts || {};
  const t = query && typeof query === "object" && query.url ? query : pick(query);
  if (!t) return null;
  const S = getState();
  if (opts.loop != null) S.loop = !!opts.loop;
  if (opts.volume != null) setVolume(opts.volume);
  const cf = opts.crossfade != null ? opts.crossfade : (S.crossfade || (t.game === "orchestral" ? 800 : 0));
  const el = new Audio(t.url);
  el.loop = S.loop;
  el.preload = "auto";
  const old = S.activeEl;
  S.activeEl = el;
  S.current = t;
  el.onended = function () {
    if (el.loop) return;
    let next = null;
    if (S.playlist.length) {
      if (S.shuffle) S.plIdx = Math.floor(Math.random() * S.playlist.length);
      else S.plIdx = (S.plIdx + 1) % S.playlist.length;
      next = S.playlist[S.plIdx];
    }
    if (next) play(next, { crossfade: cf });
    else if (S.endedCb) S.endedCb(t);
  };
  if (old) {
    if (cf > 0) fadeOut(old, Math.min(cf, 800));
    else { try { old.pause(); old.currentTime = 0; } catch (e) {} }
  }
  el.volume = 0;
  el.play().then(function () { fadeIn(el, cf, S.volume); }).catch(function () {});
  if (S.changeCb) S.changeCb(t);
  return t;

playShuffle(query, opts) =>
  opts = opts || {};
  const tracks = find(query);
  if (!tracks.length) return null;
  const S = getState();
  S.playlist = tracks.slice();
  S.shuffle = true;
  S.plIdx = Math.floor(Math.random() * S.playlist.length);
  return play(S.playlist[S.plIdx], opts);

startPlaylist(tracks, opts) =>
  opts = opts || {};
  const S = getState();
  S.playlist = (tracks || []).slice();
  S.shuffle = !!opts.shuffle;
  if (S.shuffle) shuffleArr(S.playlist);
  S.plIdx = 0;
  return S.playlist.length ? play(S.playlist[0], opts) : null;

next(opts) =>
  const S = getState();
  if (!S.playlist.length) return null;
  if (S.shuffle) S.plIdx = Math.floor(Math.random() * S.playlist.length);
  else S.plIdx = (S.plIdx + 1) % S.playlist.length;
  const t = S.playlist[S.plIdx];
  if (t) play(t, opts);
  return t;

prev() =>
  const S = getState();
  if (!S.playlist.length) return null;
  S.plIdx = (S.plIdx - 1 + S.playlist.length) % S.playlist.length;
  const t = S.playlist[S.plIdx];
  if (t) play(t);
  return t;

stop() =>
  const S = getState();
  if (S.activeEl) { try { S.activeEl.pause(); S.activeEl.currentTime = 0; } catch (e) {} }
  S.current = null;

pause() =>
  const S = getState();
  if (S.activeEl && !S.activeEl.paused) S.activeEl.pause();

resume() =>
  const S = getState();
  if (S.activeEl && S.activeEl.paused) S.activeEl.play().catch(function () {});

seek(s) =>
  const S = getState();
  if (S.activeEl && isFinite(s)) S.activeEl.currentTime = s;

setVolume(v) =>
  const S = getState();
  S.volume = Math.max(0, Math.min(1, v));
  if (S.activeEl) S.activeEl.volume = S.volume;
  saveSettings();
  return S.volume;

volume(v) =>
  const S = getState();
  if (v != null) {
    S.volume = Math.max(0, Math.min(1, v));
    if (S.activeEl) S.activeEl.volume = S.volume;
    saveSettings();
    return S.volume;
  }
  return S.volume;

loop(v) =>
  const S = getState();
  if (v != null) { S.loop = !!v; if (S.activeEl) S.activeEl.loop = S.loop; saveSettings(); return S.loop; }
  return S.loop;

crossfade(v) =>
  const S = getState();
  if (v != null) S.crossfade = Math.max(0, v);
  return S.crossfade;

current() =>
  const S = getState();
  return S.current;

isPlaying() =>
  const S = getState();
  return !!(S.activeEl && !S.activeEl.paused && !S.activeEl.ended);

audioEl() =>
  const S = getState();
  return S.activeEl;

onTrackChange(cb) =>
  const S = getState();
  S.changeCb = cb;

onEnd(cb) =>
  const S = getState();
  S.endedCb = cb;

playUrl(url, opts) =>
  if (!url) return null;
  const name = String(url).split("/").pop().split("?")[0].replace(/%20/g, " ").replace(/\.[a-z0-9]+$/i, "");
  return play({ track: "-", name: name, cat: "custom", game: "?", length: null, url: url }, opts);

getFavUrls() =>
  try {
    const s = JSON.parse(localStorage.getItem("zeldaAudioFavorites"));
    return Array.isArray(s) ? s : [];
  } catch (e) { return []; }

saveFavUrls(urls) =>
  try { localStorage.setItem("zeldaAudioFavorites", JSON.stringify(urls)); } catch (e) {}

favorites() =>
  const favs = getFavUrls();
  if (!favs.length) return [];
  const byUrl = {};
  const tracks = getTracks();
  for (let i = 0; i < tracks.length; i++) byUrl[tracks[i].url] = tracks[i];
  return favs.map(function (u) { return byUrl[u]; }).filter(function (t) { return !!t; });

isFavorite(url) =>
  return getFavUrls().indexOf(url) !== -1;

toggleFavorite(url) =>
  const favs = getFavUrls();
  const i = favs.indexOf(url);
  if (i === -1) favs.push(url);
  else favs.splice(i, 1);
  saveFavUrls(favs);
  return i === -1;

getZeldaAudio() =>
  const cached = window.__zeldaAudioApi;
  if (cached) return cached;
  const api = {
    version: "1.2.0",
    games: getGames(),
    host: "user.uploads.dev",
    cats: getCats(),
    eras: getEras(),
    albums: getAlbums(),
    tracks: getTracks(),
    find: find,
    pick: pick,
    play: play,
    playUrl: playUrl,
    playShuffle: playShuffle,
    startPlaylist: startPlaylist,
    next: next,
    prev: prev,
    stop: stop,
    pause: pause,
    resume: resume,
    seek: seek,
    setVolume: setVolume,
    volume: volume,
    loop: loop,
    crossfade: crossfade,
    current: current,
    isPlaying: isPlaying,
    audioEl: audioEl,
    onTrackChange: onTrackChange,
    onEnd: onEnd,
    favorites: favorites,
    isFavorite: isFavorite,
    toggleFavorite: toggleFavorite
  };
  window.__zeldaAudioApi = api;
  return api;

zeldaAudio = [getZeldaAudio()]
