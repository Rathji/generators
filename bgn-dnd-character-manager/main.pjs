// ─────────────────────────────────────────────────────────────
//  D&D CHARACTER FORGE — main.pjs
//  A character manager for Dungeons & Dragons 5th edition —
//  2014 (Legacy) and 2024 rules — built on the BGN blank template.
//  - main.pjs: config + plugin imports (see src/ for the app).
//  - src/dnddata.js : rules data (species, classes, backgrounds, feats, gear)
//  - src/spells.js  : curated spellbook
//  - src/core.js    : sheet math, persistence, AI helpers
//  - src/wizard.js  : character creation wizard
//  - src/sheet.js   : character sheet (play view)
//  - src/party.js   : online party table
//  - index.html     : BGN shell, party server, styles, wiring
// ─────────────────────────────────────────────────────────────

$meta
  title = D&D Character Forge
  description = Create, manage and play D&D 5e characters — 2014 Legacy and 2024 rules — with AI-generated options for every field and portrait. Party Table mode brings your heroes to a shared online table.
  tags = dnd, dungeons and dragons, character sheet, rpg, character creator, multiplayer, party
  image = https://user.uploads.dev/file/e690812633065a267cb29447c61a3a56.jpg

hubUrl = https://perchance.org/bgn-boardgame-network  // ← Boardgame Network hub
gameTitle = D&D Character Forge
gameTagline = Forge your heroes under the 2014 or 2024 rules — AI-written names, stories, and portraits — then bring them to the Party Table.
gameKicker = Forge · Play · Gather
gameGenre = Tabletop RPG
gamePlayers = 1–6 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/e690812633065a267cb29447c61a3a56.jpg

createServerSocket = {import:server-plugin}
generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
kv = {import:kv-plugin}

