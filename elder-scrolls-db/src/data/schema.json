{
  "schemaVersion": "1.0.0",
  "description": "Canonical schema for the Elder Archive. Every game's content is normalized into these entity types before storage. Field 'links' values are ids of records of the named target type — the app resolves and cross-references them at render time.",
  "entityTypes": [
    {
      "key": "locations",
      "label": "Locations",
      "glyph": "tower",
      "description": "Places across Tamriel and beyond — cities, ruins, shrines, planes.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true, "description": "Primary name used everywhere." },
        { "key": "aliases", "label": "Aliases", "type": "strings", "placeholder": "Alternate names" },
        { "key": "province", "label": "Province", "type": "enum", "options": ["Aetherius", "Argonia", "Black Marsh", "Cyrodiil", "Deadlands", "Elsweyr", "Hammerfell", "High Rock", "Morrowind", "Oblivion", "Skyrim", "Summerset", "Valenwood"] },
        { "key": "region", "label": "Region", "type": "text", "description": "Geographic region within the province." },
        { "key": "type", "label": "Type", "type": "enum", "options": ["city", "town", "village", "fort", "stronghold", "ruin", "cave", "mine", "dungeon", "temple", "shrine", "tower", "farm", "camp", "landmark", "quarter", "region", "water", "plane"] },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "lore", "label": "Lore", "type": "textarea" },
        { "key": "factions", "label": "Factions", "type": "links", "target": "factions" },
        { "key": "notableCharacters", "label": "Notable characters", "type": "links", "target": "npcs" },
        { "key": "quests", "label": "Quests", "type": "links", "target": "quests" },
        { "key": "connectedTo", "label": "Connected to", "type": "links", "target": "locations" },
        { "key": "coordinates", "label": "Coordinates", "type": "text" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "npcs",
      "label": "Personages",
      "glyph": "bust",
      "description": "Named characters — mortals, gods, spirits and monsters with a name.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "title", "label": "Title", "type": "text", "placeholder": "e.g. Archmagister, Lord Nerevar Indoril" },
        { "key": "race", "label": "Race", "type": "enum", "options": ["Altmer", "Argonian", "Bosmer", "Breton", "Dunmer", "Imperial", "Khajiit", "Nord", "Orsimer", "Redguard", "Daedra", "Dwemer", "Falmer", "Reachman", "Sload", "Ayleid", "Akaviri", "Maormer", "Sea Elf"] },
        { "key": "gender", "label": "Gender", "type": "enum", "options": ["male", "female", "neuter", "androgynous"] },
        { "key": "class", "label": "Class", "type": "text", "placeholder": "e.g. Spellsword" },
        { "key": "level", "label": "Level", "type": "number" },
        { "key": "factions", "label": "Factions", "type": "links", "target": "factions" },
        { "key": "factionRank", "label": "Faction rank", "type": "text", "placeholder": "e.g. Spymaster" },
        { "key": "location", "label": "Location", "type": "links", "target": "locations" },
        { "key": "relatedQuests", "label": "Related quests", "type": "links", "target": "quests" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "lore", "label": "Lore", "type": "textarea" },
        { "key": "death", "label": "Fate", "type": "text", "placeholder": "e.g. slain 3E 427 at Red Mountain" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "factions",
      "label": "Factions",
      "glyph": "banner",
      "description": "Great Houses, guilds, cults, armies and secret societies.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "motto", "label": "Motto", "type": "text" },
        { "key": "type", "label": "Type", "type": "enum", "options": ["great house", "guild", "cult", "military", "criminal", "political", "religious", "daedric", "racial", "arcane", "vampire"] },
        { "key": "joinable", "label": "Joinable", "type": "enum", "options": ["joinable", "not joinable", "conditional"] },
        { "key": "favoredAttributes", "label": "Favored attributes", "type": "strings", "placeholder": "e.g. Strength, Endurance" },
        { "key": "favoredSkills", "label": "Favored skills", "type": "strings", "placeholder": "e.g. Long Blade, Heavy Armor" },
        { "key": "headquarters", "label": "Headquarters", "type": "links", "target": "locations" },
        { "key": "members", "label": "Members", "type": "links", "target": "npcs" },
        { "key": "ranks", "label": "Ranks", "type": "strings", "placeholder": "e.g. Mouth, Archmagister" },
        { "key": "relations", "label": "Relations", "type": "strings", "placeholder": "e.g. ally: House Hlaalu" },
        { "key": "relatedQuests", "label": "Related quests", "type": "links", "target": "quests" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "lore", "label": "Lore", "type": "textarea" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "quests",
      "label": "Quests",
      "glyph": "star",
      "description": "Journeys, tasks and pilgrimages recorded as quests.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "type", "label": "Type", "type": "enum", "options": ["main", "faction", "guild", "daedric", "side", "misc", "pilgrimage", "tribunal"] },
        { "key": "givenBy", "label": "Given by", "type": "links", "target": "npcs" },
        { "key": "location", "label": "Location", "type": "links", "target": "locations" },
        { "key": "faction", "label": "Faction", "type": "links", "target": "factions" },
        { "key": "prerequisites", "label": "Prerequisites", "type": "strings" },
        { "key": "objectives", "label": "Objectives", "type": "strings" },
        { "key": "reward", "label": "Rewards", "type": "strings" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "items",
      "label": "Items",
      "glyph": "sword",
      "description": "Artifacts, arms, armor and curiosities.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "type", "label": "Type", "type": "enum", "options": ["weapon", "armor", "apparel", "ingredient", "potion", "scroll", "artifact", "key", "misc", "clothing", "jewelry"] },
        { "key": "subtype", "label": "Subtype", "type": "text", "placeholder": "e.g. war axe, cuirass, amulet" },
        { "key": "material", "label": "Material", "type": "text", "placeholder": "e.g. ebony, glass, daedric" },
        { "key": "value", "label": "Value (septims)", "type": "number" },
        { "key": "weight", "label": "Weight", "type": "number" },
        { "key": "enchantment", "label": "Enchantment", "type": "text" },
        { "key": "effects", "label": "Effects", "type": "strings" },
        { "key": "location", "label": "Found at", "type": "links", "target": "locations" },
        { "key": "questRelated", "label": "Quest-related", "type": "bool" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "lore", "label": "Lore", "type": "textarea" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "spells",
      "label": "Spells",
      "glyph": "sigil",
      "description": "Incantations of the schools of magic.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "school", "label": "School", "type": "enum", "options": ["alteration", "conjuration", "destruction", "illusion", "mysticism", "restoration"] },
        { "key": "cost", "label": "Magicka cost", "type": "number" },
        { "key": "effects", "label": "Effects", "type": "strings" },
        { "key": "duration", "label": "Duration", "type": "text" },
        { "key": "skill", "label": "Skill", "type": "text" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "creatures",
      "label": "Creatures",
      "glyph": "claw",
      "description": "Beasts, daedra, undead and constructs of the wilds.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "type", "label": "Type", "type": "enum", "options": ["beast", "daedra", "undead", "insect", "fish", "bird", "construct", "atronach", "spirit", "chitin", "god", "artifact", "humanoid"] },
        { "key": "health", "label": "Health", "type": "number" },
        { "key": "soul", "label": "Soul", "type": "text", "placeholder": "e.g. 100 (Common)" },
        { "key": "abilities", "label": "Attacks & Abilities", "type": "strings" },
        { "key": "variants", "label": "Variants & Notables", "type": "strings" },
        { "key": "habitat", "label": "Habitat", "type": "links", "target": "locations" },
        { "key": "loot", "label": "Loot", "type": "strings" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "lore", "label": "Lore", "type": "textarea" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "books",
      "label": "Books",
      "glyph": "book",
      "description": "Tomes, scrolls, journals and accounts.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "author", "label": "Author", "type": "text" },
        { "key": "volume", "label": "Volume / Series", "type": "text", "placeholder": "e.g. 36 Lessons of Vivec, Sermon 4" },
        { "key": "skill", "label": "Skill gained", "type": "text" },
        { "key": "content", "label": "Contents", "type": "textarea" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    },
    {
      "key": "races",
      "label": "Races",
      "glyph": "rune",
      "description": "The peoples of Tamriel and beyond.",
      "fields": [
        { "key": "name", "label": "Name", "type": "text", "required": true },
        { "key": "province", "label": "Homeland", "type": "text", "placeholder": "e.g. Morrowind" },
        { "key": "abilities", "label": "Abilities", "type": "strings" },
        { "key": "bonuses", "label": "Skill bonuses", "type": "strings" },
        { "key": "description", "label": "Description", "type": "textarea" },
        { "key": "lore", "label": "Lore", "type": "textarea" },
        { "key": "status", "label": "Verification", "type": "enum", "options": ["draft", "verified"] }
      ]
    }
  ]
}
