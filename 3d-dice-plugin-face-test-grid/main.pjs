// 3d-dice-plugin-face-test-grid
// A visual test page for 3d-dice-plugin: renders every die-face plate
// (d2-d20, pips + numerals, several colours) plus contact sheets, so
// geometry/cropping/centring issues are visible at a glance.
//
// NOTE: the generator's URL name is set in the editor's settings modal
// (gear icon → generator name) — set it to `3d-dice-plugin-face-test-grid`.

dice = {import:3d-dice-plugin}

$meta
  title = 3d-dice-plugin face test grid
  description = Visual test grid for 3d-dice-plugin SVG face plates — every shape, marking style and colour, plus contact sheets.
  tags = dice, plugin, test, svg
  header
    mode = minimal
