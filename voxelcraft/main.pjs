$meta
  title = VoxelCraft
  description = Minecraft-style blocky image generator with a retro CRT interface. Describe a build, enhance it with AI, then render voxel art in a variety of style lenses.
  image = https://user.uploads.dev/file/f381a1edc53d6dd629b753fe1f00f53f.jpg
  tags = minecraft, image generation, voxel, ai, retro, pixel art

generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}
kv = {import:kv-plugin}

// ===== RANDOM PROMPT LISTS =====
// These build randomized "describe the build" prompts. Tweak words/weights freely!
mcSubject
  a cozy oak cabin
  a towering nether fortress^2
  a floating sky island village
  an underground dwarven mine
  a wheat farm with a windmill
  a lighthouse on a jagged cliff
  an ancient jungle temple
  a grand medieval castle^2
  a hidden underwater base
  a giant treehouse
  a snowy igloo village
  an abandoned mineshaft entrance
  a sandstone desert pyramid
  a giant mushroom house
  an obsidian enderman tower
  a village bakery with a brick oven
  a giant redstone contraption
  a massive glowing portal gate

mcMaterial
  oak and cobblestone
  dark oak and stone brick
  nether brick and blackstone
  quartz with gold trim
  prismarine and sea lanterns
  terracotta and acacia
  snow and packed ice
  end stone and purpur
  jungle wood and vines
  red sandstone and chiseled sandstone
  deepslate and amethyst
  mud brick and mangrove

mcBiome
  the sunflower plains
  a cherry blossom grove
  a snowy taiga
  the badlands mesas
  a lush swamp
  a bamboo jungle
  the crimson forest
  the soul sand valley
  a mushroom island shore
  a windswept mountain pass
  an icy ocean shore
  the ice spikes tundra
  a deep dark cave
  a glowing warped forest
  a desert oasis
  a flower forest
  a glowing dripstone cavern

mcAtmosphere
  golden hour lighting
  moody storm clouds with distant lightning
  soft morning mist
  a starry night with a full moon
  drifting fog at dawn
  falling cherry blossom petals
  a warm torchlight glow
  gentle snow falling
  bioluminescent particles in the air
  rays of light through the tree canopy
  a quiet evening with fireflies
  autumn leaves drifting in the wind
  shimmering heat haze at noon

mcCameo
  A creeper peeking around the corner.^2
  A few sheep grazing in the distance.
  An enderman staring from the shadows.^2
  A cat napping on the doorstep.
  An axolotl splashing in a nearby pond.
  A wandering trader and his llamas passing by.
  An iron golem patrolling the perimeter.
  A skeleton archer silhouetted on a hill.
  A fox chasing its tail nearby.
  Villagers going about their day.^2
  A bee buzzing around a hive.
  A dolphin leaping in the water.

mcRandomPrompt
  [mcSubject] made of [mcMaterial], set in [mcBiome], with [mcAtmosphere]. [mcCameo]
