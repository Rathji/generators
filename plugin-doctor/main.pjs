// ═══════════════════════════════════════════════════════════════
// PLUGIN-DOCTOR — audit any Perchance plugin against Perchance
// best practices + your own standards.
//
// Built on the rathji-template framework (dark theme, gradient
// accents, settings panel, toasts, modals).
// The whole audit engine lives in index.html; this file is config.
// ═══════════════════════════════════════════════════════════════

$meta
  title = plugin-doctor
  description = Audit any Perchance plugin against Perchance best practices plus your own custom standards — enter them directly, import/export them as JSON, get a grade card, and copy an AI-helper fix prompt (or embed the checker right into the plugin).
  tags = plugin, audit, checker, standards, qa, quality, tool, review
  image = https://user.uploads.dev/file/173d240fec386b6c243fea6042aa1d29.jpg
  header
    mode = minimal

superFetch = {import:super-fetch-plugin}
generateText = {import:ai-text-plugin}

pluginDoctor
  name = plugin-doctor
  tagline = Check any Perchance plugin against Perchance best practices + your own standards.
  kicker = Audit · Report · Improve
  accent = #7c6cff
