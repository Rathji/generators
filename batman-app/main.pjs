$meta
  title = Gotham Image Generator
  description = Type any prompt and get a gritty, film-noir Gotham scene rendered by AI.
  tags = gotham, batman, noir, ai, image generator

// IMPORTS
generateText = {import:ai-text-plugin}
generateImage = {import:text-to-image-plugin}

// CONFIG
defaultPrompt = Batman on a rain-slicked rooftop
noirStyle = Gritty Gotham noir aesthetic, film-noir, moody cinematic lighting, dark comic book art
negativePrompt = distorted, extra limbs, cheerful, bright, cartoon, low quality

// RANDOM COORDINATES
randomPrompts
  Batman crouched on a gargoyle high above neon-soaked Gotham alleys
  The Batmobile tearing through rain-flooded streets under strobe lightning
  A noir detective silhouette in a smoky interrogation room, single hanging bulb
  Gotham skyline at midnight, glowing fog, searchlights sweeping the clouds
  The Joker's laugh echoing across a dilapidated funhouse at night
  Catwoman silhouetted on a rooftop in the rain, city lights glittering below
  Commissioner Gordon at a crime scene under a single buzzing streetlamp
  A dark vigilante in a cape watching the red bat signal burn through the clouds
