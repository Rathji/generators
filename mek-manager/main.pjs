// ============================================================================
//  BATTLETECH MERCENARY MANAGER — main.pjs
//  A fan-made management sim: run the business & personnel side of a
//  BattleTech mercenary company; battles are AI-simulated and narrated.
//
//  STATUS  (full spec: src/ROADMAP.md)
//  • All 52 roadmap tasks (14 phases) are implemented and verified —
//    flip an item's `done` back to false in the `features` list below
//    to track new work; the on-page Roadmap panel re-renders from it.
//
//  ARCHITECTURE  (business-template pattern)
//  • main.pjs        — $meta, plugin imports, config, roadmap checklist
//  • index.html      — static shell: header/HUD/nav, screen sections,
//                      new-game modal; loads src/*.js in dependency order
//  • src/base.css    — design system (tokens + all component styles)
//  • src/framework.js— BT: config/theme loader, roadmap panel, UI helpers
//  • src/data.js     — D: eras, factions, weapons, mechs, missions, names
//  • src/core.js     — MGM: company/unit/person generation, market & offers,
//                      battle simulation, finance, events, save sanitizer
//  • src/ai.js       — BMGA: generateText/image narration with fallbacks
//  • src/sound.js    — BMS: menu/battle music, stingers & mute toggle
//  • src/ui.js       — BMUI: screen & modal renderers
//  • src/game.js     — BMG: boot/router/actions, deploy & battle flow,
//                      event queue, save/load/new-game/bankruptcy flows
//  • src/ROADMAP.md  — roadmap spec    • src/README.md — dev notes
// ============================================================================

$meta
  title = BattleTech Mercenary Manager
  description = Fan-made management sim: hire pilots, maintain mechs, take contracts, and read the AI-simulated after-action reports of your mercenary company.
  tags = battletech, management, sim, mech, mercenary, game, strategy
  header
    mode = minimal

// ── Plugin imports (roadmap-driven) ─────────────────────────────────────────
generateText = {import:ai-text-plugin}       // P5/P1: narrative after-action reports, personalities & voices
generateImage = {import:text-to-image-plugin} // P1/P5/P6: portraits, battle-scene & salvage art
kv = {import:kv-plugin}                      // P2/P7: persistent company saves (ledger, roster, mechbay)

// ============================================================================
//  CONFIG — theme & branding for the whole app. Read explicitly into a plain
//  object by src/framework.js at boot; edit the values here to restyle.
// ============================================================================
config
  schemaVersion = 0.1.0

  branding
    companyName = BattleTech Mercenary Manager
    companyShortName = Merc Manager
    logoGlyph = M
    tagline = For the right price, we'll break anything.
    footerText = © \{year\} \{companyName\} — unofficial fan project

  theme
    mode = dark                  // dark | light — see note in src/README.md
    accentStyle = gradient       // gradient | solid
    radius = 14                  // px corner radius
    fontSize = 16                // base px (14–20)
    fontFamily = rajdhani-inter  // rajdhani-inter | lato | inter
    reduceMotion = false

  // primary/secondary/accent apply to both light and dark mode;
  // background/surface/text/textMuted tune the DARK theme's neutrals
  // (light mode uses its own neutral defaults in framework.js).
  // ── BATTLETECH THEME: olive-drab hull, battle-amber highlights ──
  colors
    primary = #e2a63b            // battle-amber — actions, highlights, logo
    secondary = #5f6f3f          // olive drab — gradients, secondary UI
    accent = #9aa75a             // army/CRT green — chips, small details
    background = #0f120b         // olive-black hull
    surface = #161a11            // armored panels
    text = #e7e1ce               // bone white
    textMuted = #968e74          // khaki

  admin
    showSettingsButton = false   // future config panel

// ============================================================================
//  FEATURES — roadmap checklist (the live TODO list; mirrors src/ROADMAP.md).
//  UPDATE AS WE WORK: flip an item's `done` from false to true once its task
//  is implemented and verified. Keys f1..f21 map 1:1 to roadmap tasks 1..21.
//  Rendered on the page by renderRoadmap() in src/framework.js.
// ============================================================================
features

  // ── Phase 1 · Personnel & Unit Foundation ──────────────────────────────────
  f1
    phase = 1
    title = Pilot & Staff Generation
    desc = Personnel (Pilots/Techs/Support) with unique IDs, age & appearance, personality traits, quirks, personal motivations and generated backstories; AI portrait prompts derive from each person's look.
    done = true
  f2
    phase = 1
    title = Mech Data Model
    desc = Mech chassis, faction origin, provenance (founding/market/salvage), condition (per-location HP/Armor), equipped weapons plus critical internal components (gyro, engine, cockpit, sensors, heat sinks, jump jets) that take battle damage, reduce combat power and drive repair costs.
    done = true
  f3
    phase = 1
    title = Personnel Mapping
    desc = Pilot↔Mech assignments editable from the roster dossier, mechbay cards and at deploy; mech readiness reflects pilot availability (injured/down/no-pilot states); Techs & Support on payroll; firing a pilot releases their machine.
    done = true
  f4
    phase = 1
    title = Personnel Interaction System
    desc = Personality surfaces everywhere: trait-driven battle moments, post-battle victory/defeat quotes from survivors, trait-flavored voice lines, and a relationship (bond) system — rivalries, buddies, shipmates, mentors — formed on hiring, shown in dossiers, and driving company events (old grudges, shipmates' pranks).
    done = true

  // ── Phase 2 · Financial & Resource Management ──────────────────────────────
  f5
    phase = 2
    title = Company Ledger
    desc = Full C-bill ledger with live cash-flow analytics: all-time and trailing-4-week income/expense/net, per-category breakdown chips (contracts, payroll, upkeep, repairs, hiring, refits, loans), weekly burn and a runway projection with a LOW RUNWAY warning, alongside the 30-row transaction list.
    done = true
  f6
    phase = 2
    title = Market Logic
    desc = Buy/sell mechs, parts & equipment with era-gated supply, used-new condition pricing and inventory sell-off. Market mood refreshes every two weeks: a per-cycle demand factor (war-boom seller's market, buyer's market, or steady trade) plus era tech-scarcity pricing (tech & mech era multipliers) drive price swings, with a live market-conditions strip showing mood and era flavor.
    done = true
  f7
    phase = 2
    title = Payroll & Logistics Loop
    desc = Recurring weekly billing cycle: payroll from staff count & role (pilot/tech/support salaries scale with skill & gunnery) plus a maintenance & logistics bill that responds to equipment quality — per-mech upkeep scales with armor wear and damaged/destroyed internals (components add up to +40%), while each active tech cuts upkeep 3% (to −30% cap). Advance week levies payroll, maintenance and 8% loan interest; a Payroll & Logistics breakdown on the Company screen shows the burn by role, per-mech base, tech efficiency and component-wear penalty.
    done = true

  // ── Phase 3 · Era & World Setting ──────────────────────────────────────────
  f8
    phase = 3
    title = Era Configuration
    desc = Era selector (Succession Wars → Clan Invasion → Civil War → FedCom Civil War → Jihad → Dark Age) with era dossier stats on the new-game screen. Each era gates available tech (era-valid weapon/machine pools; Clan hardware appears from the Invasion on), the market's mech & weapon catalog, enemy faction pools (era min/max), and LosTech cache rates (scarcity falls, LosTech rises over time). Starting lances are era-valid and salvage pulls era-appropriate hardware — a Succession Wars company never finds a Gauss rifle.
    done = true
  f9
    phase = 3
    title = Faction Relationship Matrix
    desc = Standing (-10..+10) with every Inner Sphere & Clan faction, earned in battle (victory +3 / partial +1 / defeat -3, attacking a House's world costs rep) and eroded by events. Reputation drives contracts: pay multiplier, salvage terms, offer availability, and rep-gated mission types (base defense/capture at rep 1, assassination at 3, objective raids at 4, Clan Trials at 6). It also drives pricing — each market cycle has a Dealer faction whose trust shifts buy & sell prices (up to ±6%), shown in the market-conditions strip. Rep slowly decays toward zero weekly, so standing must be maintained.
    done = true

  // ── Phase 4 · Mission Market & Contract Logic ──────────────────────────────
  f10
    phase = 4
    title = Contract Generator
    desc = Mission types: assassination, base defense, capture/escort, raid, recon, garrison, objective raid, Clan Trial. Mission types are weighted 3x for factions that favor them (each faction has a favor list), and pools are rep-gated, era-aware, and clan-aware. Generated contracts carry a full parameter set: employer, target faction, planet, terrain, threat, pay, salvage %, duration, and victory condition — all shown on the board cards.
    done = true
  f11
    phase = 4
    title = Mission Parameters
    desc = Every contract packs target strength (threat skulls, enemy force multiplier vs your lance power), terrain modifiers (12 biomes with accuracy effects from -15% swamp to +6% open plains; terrain is flavor-weighted per mission type — recon favors open ground, defense/garrison favor urban & ruins, Clan Trials are fought on formal open fields), victory conditions (per-mission objective text), and payout (pay × difficulty × reputation multiplier, salvage % negotiated). Terrain accuracy modifiers are shown on the board cards and in the deploy brief.
    done = true
  f12
    phase = 4
    title = Contract Acceptance Flow
    desc = From the board: Brief & deploy → select up to 4 ready mechs (live lance-power tally, launch gated on selection, 4-machine cap) → pre-flight risk readout comparing your lance power against the estimated enemy force (comfortable / even odds / outgunned) → Launch drop rolls the sim → after-action report modal with AI narrative + battle image, then queued post-battle events. Stale contracts (refreshed off the board mid-modal) are caught with a clear toast.
    done = true

  // ── Phase 5 · AI Battle Simulation & Reporting ─────────────────────────────
  f13
    phase = 5
    title = Combat Resolver
    desc = Outcome engine from unit stats, terrain & mission type (no manual tactics). Seeded per-battle RNG (mulberry32); hits resolve across 8 locations (armor → internal structure → weapon/component loss; CT/cockpit/engine hits fatal, leg hits cripple). Accuracy from pilot Gunnery, company morale, and terrain modifier. Mission-specific AI: assassination hunts the target commander, capture guards the VIP, defense/garrison face reinforcement waves with hold-the-line break conditions, recon withdraws on intel complete, Clan Trials follow honor rules. Per-mission victory/partial/defeat resolution, XP & morale outcomes. Balance locked by sim sweeps: fresh company, regular difficulty ≈ 60% win / 10% partial / 30% defeat.
    done = true
  f14
    phase = 5
    title = Damage Calculation
    desc = Component-level damage & pilot injuries during the simulation. Hits resolve across 8 hit locations (armor → internal structure → weapon loss by location → component damage/destroyed: engine, gyro, cockpit, sensors, heat sinks, jump jets); CT/cockpit/engine breaches are fatal, leg loss cripples. Destroyed mechs zero all locations/components and free their pilot; survivors get damage written back. Pilot injuries (killed in action, cockpit shrapnel) set 1-4 week injured status. Post-battle the Repair Bay prices repairs from the same damage model (armor, structure, destroyed weapons, component damage) — destroyed mechs can be rebuilt as a full rebuild. Battle XP improves gunnery/piloting/skill with on-field skill-up logging and salary recalibration.
    done = true
  f15
    phase = 5
    title = Narrative Report Generator
    desc = Simulation logs → multi-paragraph reports with pilot personalities. The battle log's key moments (kills, component hits, traits, quotes, end conditions) are distilled and fed to the AI as an after-action brief with mission/employer/enemy/terrain/rounds/lance detail and a per-pilot personality line (callsign, background, traits, motivation) so the report reads as authored by the company's own people — pilots speak in their own voice. Reports stream into the modal with a loading indicator; if the AI is unavailable they fall back to a structured template report. Completed narratives are stored with the report and shown again from the Reports archive.
    done = true
  f16
    phase = 5
    title = Visual Asset Integration
    desc = AI battle-scene images & pilot portraits from simulation results. The after-action report renders a battle illustration (planet, terrain & mood per outcome — victory/partial/defeat — generated at 768x512 from the battle's own params) into the report modal, and each pilot dossier can commission a portrait (built from build, hair, features & career into the prompt, 512x512). Portraits are cached in kv by pilot id so they persist, and both run through the text-to-image plugin with streaming loading states.
    done = true

  // ── Phase 6 · Salvage & Discovery ──────────────────────────────────────────
  f17
    phase = 6
    title = Salvage Calculation
    desc = Recoverable parts/mechs determined by simulation damage. Every enemy kill is rolled for salvage against your negotiated salvage rights (Clan hulls 10% harder), and how the machine died matters: catastrophic kills (ammo cook-off, core vent — ~35% of kills) leave 45% less recoverable value and produce lower-condition hulls, while clean kills yield better salvage. Recovered lots are staged as weapon parts (1-3 weapons), mech hulls (condition 12-60%, cheaper to restore when rougher), or scrap with a market value — all visible in the Salvage Bay with restore/sell/scrap/keep actions and bulk liquidate options.
    done = true
  f18
    phase = 6
    title = Salvage Processing
    desc = Salvage Bay menu for every recovered lot with per-kind actions. Scrap is liquidated for C-bills (with a bulk "liquidate all" button), weapon parts can be kept for the refit bay or sold, and mech hulls can be restored (cost scales with condition — rougher hulls are cheaper), sold for their current value, or scrapped — restored machines join the mechbay with a salvage origin. Every transaction posts to the ledgers.
    done = true
  f19
    phase = 6
    title = Star League Cache Events
    desc = LosTech cache discovery; extraction & security logic for rare hardware. Every operation rolls an era-driven cache chance (era LosTech rate, boosted on objective raids and Clan Trials). A discovery opens the Star League Cache event: formal excavation (safe but slow — 40% a rival claim arrives and you salvage scraps), fast extraction tonight (risky, but success grants a tier-2 prize with more rolls on the rare LosTech table — Gauss, ER PPC, ER large laser, UAC/10, LB-X/10 plus era weapons), or selling the coordinates to ComStar for clean C-bills. Event modal flow (incident kicker, body, choice hints, outcomes with real money/rep/morale effects) also drives the wider company-event pool after every battle.
    done = true

  // ── Phase 7 · Company Growth & Loop ────────────────────────────────────────
  f20
    phase = 7
    title = Mechbay Management
    desc = Refit mechs using purchased or salvaged parts. Full mechbay lifecycle: hull-integrity bar, weapon strip (destroyed ✕ markers) and component panels per machine; pilot assignment straight from the bay; repairs priced from the damage model with standard & rush (×2 cost) options, tech-count speed-up, weekly bay-progress ticks, and cancel-with-50%-refund; wrecked mechs can be fully rebuilt. The refit bay installs inventory weapons (25% labor, Clan-on-IS compatibility rules) and strips mounts back to parts; machines can be sold for current-condition value.
    done = true
  f21
    phase = 7
    title = Game Loop Integration
    desc = Mission → Battle → Salvage → Finance → Refit as one cohesive loop. Take a contract from the board → deploy a lance → the resolver yields a battle with payout, reputation shifts, pilot injuries & XP, mech damage, and a salvage queue → Salvage Bay converts the haul into parts/hulls/cash → the weekly finance cycle (payroll, maintenance & logistics, 8% loan interest, era-paced market refresh, offer expiry, rep decay toward zero) funds the next moves → the mechbay repairs/rebuilds and the refit bay re-arms → repeat. Every stage feeds the next with real state — damage, injuries, parts inventory, the ledger — and the whole loop persists through kv saves with forward-compatible save patching.
    done = true

  // ── Phase 8 · Personnel Development ────────────────────────────────────────
  f22
    phase = 8
    title = Pilot XP & Skills
    desc = Pilots earn XP from every mission and level gunnery/piloting on a career track (6 XP per skill-up, career total tracked), with a derived rating (Green → Regular → Veteran → Elite). Wounds reduce effective skills (+1, or +2 for a 3+ week injury) until recovery, cutting both combat power and accuracy; skill-ups and salary recalibration post to the company log.
    done = true
  f23
    phase = 8
    title = Rivalries & Bonds
    desc = Bonds evolve from shared deployments: pilots who drop together deepen their ties (each drop adds strength, buddies can become old shipmates), while rough missions breed fresh rivalries. Deployed feuds cut a pilot's accuracy and damage and bleed morale; bonded pairs gain up to +7% accuracy and fight harder. The pre-flight brief shows a live lance-cohesion readout, dossiers list every bond with its drop count and effect, the dashboard flags active feuds, and the after-action report records new feuds and friendships. A joint simulator program can broker a truce.
    done = true
  f24
    phase = 8
    title = Recruitment Market
    desc = A rotating hiring-hall board of pilots, techs and specialists refreshes every week, each candidate showing role, stats, traits, a reputation-derived asking fee and the market's standing. Signing fees scale with the company's own reputation, and you can pay a talent-scout fee to force a fresh board. Neglected low-morale personnel attract poaching offers from rival outfits, triggering an event where you must match the salary, pay a retention bonus, or let them walk.
    done = true
  f25
    phase = 8
    title = Training & Sim Pods
    desc = Invest C-bills and weeks to develop the roster between contracts. Pilots can take a Gunnery Sim-Pod Intensive, a Piloting & Terrain course, or a three-week Full Combat Simulator Boot Camp; techs earn Senior Technician Certification and support staff take a Support & Logistics course. Tuition scales with the skill being trained, personnel are unavailable for assignment while enrolled, and a course grants its skill-up (plus career XP for pilots) on completion. Enrollment and cancellation (50% refund) run from the dossier, and progress ticks down each week of the finance cycle.
    done = true
  f26
    phase = 8
    title = Morale & Fatigue
    desc = Deployment fatigue accrues per drop (scales with battle length, ejection and injury) and recovers each week on the ground. High fatigue cuts accuracy (up to −12%), erodes mech power, triggers Leave Request events (approve, rotate to a desk, or deny at your peril), and — when morale bottoms out — pilots can quit outright during the weekly cycle.
    done = true

  // ── Phase 9 · Combat & Simulation Depth ────────────────────────────────────
  f27
    phase = 9
    title = Lance Composition Tactics
    desc = Every chassis derives a battlefield role — Scout (fast lights, spotting), Fire Support (LRM/PPC batteries, standoff damage), Brawler (close-assault and heavy/assault anchors) or Trooper — shown on mech cards, the deploy brief and the after-action report. The lance's role mix yields real modifiers in the simulation: scouts sharpen the lance's gunnery, fire support adds damage, brawlers add protection, and a combined-arms mix (scout + fire + brawler) earns a synergy bonus while a one-dimensional lance is penalised. Weight of metal against the opfor matters too — out-mass the enemy and the lance hits harder and shrugs off fire, field a lighter force and it trades armour for accuracy. The deploy brief shows the live composition readout and the report records the modifiers applied.
    done = true
  f28
    phase = 9
    title = Terrain & Weather Effects
    desc = Every contract now carries a biome and a weather report alongside its terrain. Biomes (Urban, Woodland, Jungle, Highland, Desert, Polar, Plains, Wetland, Canyon, Vacuum, Ruins, Coastal) each carry an ambient temperature and sensor profile; weather (clear skies, overcast, rain, electrical storm, fog, snowfall, blizzard, heat wave, sandstorm, night operation) is drawn from conditions the biome can actually produce and adds its own accuracy, heat and sensor penalties. The pre-battle brief and mission board show the weather and a live conditions readout (combined gunnery effect, sensor degradation, heat stress); heat saps energy-weapon damage while cold air keeps heat sinks clean, and degraded sensors risk an enemy opening ambush before the lance can shake out. The after-action report records the conditions and any ambush.
    done = true
  f29
    phase = 9
    title = Enemy Commander Doctrines
    desc = Every opposing force is led by a named commander (rank scaled to their faction — House officer, Clan Star Colonel, ComStar Precentor, pirate Captain) who fights to a doctrine. Aggressive commanders press the attack and mass fire on the wounded; Cautious commanders fight from cover, husband their machines and withdraw before ruin (fewer kills, less salvage); Attritional commanders grind forward methodically; Berserkers throw everything in and refuse to disengage until the last machine falls; and Clan Zellbrigen fights by honour rules, each warrior seeking a single opponent. Doctrine sets enemy gunnery and damage, how quickly they break or withdraw, and how they choose targets, and is surfaced on the contract board, the deploy brief and the after-action report.
    done = true
  f30
    phase = 9
    title = Ammo, Heat & Armor Detail
    desc = Ammo-dependent and LosTech weapons run dry; heat limits alpha strikes. Every weapon carries a heat load and its ammo bins a finite number of volleys (energy weapons never run dry; ballistic and missile weapons, especially LosTech/Clan types, carry the least). In the simulation each machine tracks heat round by round: a lance that generates more heat than its sinks dissipate must stagger its fire — the hottest weapons (energy first) are held back, cutting its volleys — and a mech pushed past its heat capacity overheats, briefly staggering and risking an ammo cook-off. Survivors report their ammunition expenditure, weapons that ran dry, peak heat against capacity and overheat events, alongside a per-machine armour and structure breakdown (with breached locations), on the deploy brief's live ordnance readout and in the after-action report's "Ordnance & armour" block.
    done = true
  f31
    phase = 9
    title = Turn-by-Turn Highlight Reel
    desc = Round-by-round narrative log in the after-action report instead of a single summary. Every entry in the battle log is stamped with its round, and the report adds a collapsible "Round-by-round highlight reel" that replays the engagement round by round — each round listing its most telling moments (kills, injuries, component failures, weapons running dry, overheat events, doctrine and cohesion beats, pilot quotes) in the order they happened, so the player can see how the fight actually unfolded rather than only the final result.
    done = true

  // ── Phase 10 · Economy & Logistics ─────────────────────────────────────────
  f32
    phase = 10
    title = Repair Queue & Parts Inventory
    desc = Repairs are queued and consume real stock. Each machine under repair occupies a bay (one per active tech, plus one) and works through its damage over days, with techs setting both the pace and the quality. A job needs repair crates to cover armour, structure and internal damage plus the exact weapon part for every destroyed weapon — if either is missing the repair is blocked until the company buys crates or strips a replacement part from inventory. Starting a job draws down the crates and weapon parts (fully refunded on cancellation, with only the labour cost halved), a rush job completes at once for double labour, and when a job finishes a low-skill crew may leave a lingering \"field patch\" on an internal component. The mechbay shows a live repair queue with bays on line, crates in stock, each job's parts requirement and added quality notes; the market adds a repair depot and rotating crate lots for restocking, and salvaged weapons feed straight back into the parts inventory.
    done = true
  f33
    phase = 10
    title = Salvage Market & Brokers
    desc = Sell salvage over time for better prices, or broker whole mechs for a premium. Every salvage lot can be liquidated on the spot — at a value scaled by a weekly salvage index — or listed on the salvage market for a better price: scrap and parts fetch a 35% premium after two to three weeks, while whole mech hulls can be brokered to a dealer for a 50% premium in two weeks (though a broker may haggle the price down). Up to six lots can be held at once, any listing can be withdrawn back to the salvage bay, and the index drifts each week so timing matters. The salvage bay shows the current index, each lot's instant value against its listed asking price, and a live board of open listings with weeks remaining and expected payout; sales settle automatically each week and post to the ledger and company news.
    done = true
  f34
    phase = 10
    title = Loans & Credit
    desc = Take C-bill loans with interest; defaulting damages reputation. Three lenders extend credit on their own terms — ComStar Credit Union (3% weekly, requires good standing), a House Mercantile Bank (5%) and a Portside Loan Shark (9%, no credit check). A credit rating earned from punctual repayment and spent on missed payments sets how much each lender will advance and locks out the stricter houses when it falls. Interest capitalises each week and a minimum payment is drawn automatically from company funds; a missed payment cuts credit and reputation, and three misses let a lender seize one of your machines against the debt. The emergency-credit option remains as a last-ditch 8% weekly loan, and the company screen carries a Credit & loans panel with active balances, per-week interest, minimum and full-repayment buttons, live lender offers and the current rating.
    done = true
  f35
    phase = 10
    title = Overhead Itemization
    desc = DropShip/transport lease, ammo resupply and medical bills as distinct recurring costs. Weekly overhead is itemised rather than a single maintenance line: mech maintenance (still scaled by tech skill and damaged internals), a DropShip lease and transport fee that scales with the number of machines under maintenance, ammo and consumables resupply driven by how many ammo-dependent weapons the roster carries (LosTech and Clan guns cost more to feed), and medical and infirmary bills that appear whenever personnel are injured or on leave. Each item posts to its own ledger category, and the company screen's logistics banner lists every line — payroll, maintenance, transport, ammo and medical — against total weekly burn.
    done = true
  f36
    phase = 10
    title = Investments
    desc = A passive-income side-system (stocks/landholds) to sink late-game capital. The market's Investment exchange offers a rotating slate of ComStar bonds, agri-combine landholds, defense and shipping stocks and high-risk LosTech-prospecting or Solaris-arena ventures. Each pays a weekly dividend while its unit price drifts with its risk profile — the riskiest holdings swing hardest and can surge or slump on market events. The exchange shows portfolio value and passive weekly income, tracks each holding's cost basis and profit/loss, and buys and sells in whole units with a 2% brokerage on exit; holdings and offers are capped so a late-game war chest has somewhere to work without trivialising the contract loop.
    done = true

  // ── Phase 11 · World, Era & Factions ───────────────────────────────────────
  f37
    phase = 11
    title = Dynamic Faction Map
    desc = A living map of roughly fifty named worlds — Draconis Combine, Federated Suns, Lyran Commonwealth, Capellan Confederation, Free Worlds League, ComStar, the Periphery and the Clan homeworlds — on the Known Space screen, each world owned by whichever power holds it. Borders shift on their own: as weeks pass, hostile neighbours probe undefended systems, opening flashpoint fronts that the map rings in red and labels with a heat value. A front resolves after a few weeks — the attacker can seize the world (ownership and colour change, logged to company news) or the defender can throw the assault back — so the political map drifts across a campaign, and the era decides the starting lines (Clan space is dark until the Invasion, when the Clans carve out the same corridors history records). Every contract on the board is bound to a specific world: the offer card names the system as its planet, hot systems pay a premium and field heavier opposition, and the map badges worlds holding open work. Clicking a world opens its dossier — owner, control percentage, any attacker and the contracts on offer there. Flashpoints are capped so the map stays legible, and the player's current station is marked.
    done = true
  f38
    phase = 11
    title = Travel & Transit Time
    desc = The company is physically stationed at one world at a time, and reaching another takes weeks and fuel. A jump's duration (one to four weeks, longer for distant systems) and fuel burn are quoted on the world dossier and the mission board, where each remote contract carries a transit chip; the DropShip can only launch a contract once the company is on station, so far-off hotspots must be committed to early — while the journey eats into the offer's five-week window. Departing burns fuel from a hundred-unit tank, fuel is bought in lots on the market, and the company flies only one leg at a time: while in transit the map, command screen and deploy briefing show the weeks remaining, and the DropShip's arrival is posted to company news.
    done = true
  f39
    phase = 11
    title = Reputation Tiers & House Contracts
    desc = Standing with each power now resolves into named tiers — Sworn enemy, Hated, Disliked, Cold, Neutral, Known, Respected, Honored and Trusted ally — shown as glyph-tagged chips across the company screen's faction grid. Once a Great House, Clan or ComStar rates the company Honored or better, that employer starts offering exclusive House (or Clan) Contracts: premium jobs paying roughly half again the market rate with sixty-percent salvage rights, a longer term and a correspondingly heavier enemy, flagged with a gold ★ badge on the mission board and a briefing note. High standing also pays a passive dividend in the field: Respected employers chip in a little on maintenance and ammo, Honored ones more, stacking to a capped discount that appears as its own line — House logistics discount — in the weekly overhead breakdown.
    done = true
  f40
    phase = 11
    title = Story Arcs & Campaign Events
    desc = Once each era the campaign delivers a scripted milestone event that pauses the clock and asks the player to choose a side. The Succession Wars open with a House offensive; the Clan Invasion with the Clans crossing the Periphery (hold the line, sell them star charts, or withdraw rimward); the Civil War with a Commonwealth tearing itself apart; the Jihad with the Word of Blake's holy war; and the Dark Age with the HPG blackout that severs the Inner Sphere. Two universal beats, survivors of a broken mercenary outfit and a Mercenary Review Board audit, can land in any era. Every beat offers three choices whose outcomes move real systems — cash, morale, reputation, credit rating, personnel, salvage, and the political map itself (some choices open a new contested front or relocate the company) — and each fires only once, tracked on a Campaign card on the company screen that records the milestones reached and counts the era's remaining events.
    done = true
  f41
    phase = 11
    title = Rival Merc Company
    desc = A persistent rival mercenary outfit — the Gilded Fist, the Broken Compass, Wolf's Own and others, each with its own name, colours, temperament (Aggressive, Well-connected, Scrappy or Elite) and a power rating tracking yours — competes for the same mission board across the whole campaign. The rival grows week by week toward a share of your strength, and when strong enough it snatches contracts off the board (logged to company news and noted with a red ◆ rival eyeing chip on remaining offers), which shrinks the work available and lets it undercut your pay through a competition multiplier on every offer. Contracts the rival is eyeing can be won back in the field: taking and completing one costs the rival standing and strength, while failing or ignoring it feeds their reputation. The company screen carries a Rival outfit card with the outfit's name, temperament, power against yours, win/loss record, jobs won and latest activity, and a recurring Company Event lets you answer a public challenge — a trial by combat, a show of force, or a snub — each with its own effect on both outfits' standing.
    done = true

  // ── Phase 12 · Interface & Characterization ────────────────────────────────
  f42
    phase = 12
    title = Pilot Dossiers & Career Log
    desc = Every pilot and staffer has a full dossier page — portrait, service record and career log — instead of a bare stat line. The dossier opens with the person's identity, traits, bonds, live skill/XP/fatigue bars and a written biography, then adds a Service record: a six-cell grid tracking contracts flown, confirmed kills, victories, defeats, wounds and total combat drops, plus a running one-line career narrative ("signed on in week 3, has flown 12 contracts (8W / 4L), claiming 7 confirmed kills, wounded twice in the line of duty") and a career win rate. Beneath it a chronological Career log records every milestone with its week — deployments (mission, planet, outcome, kills, wounds, lost machines), field skill improvements, training enrollments and completions, washouts and signings — newest first and capped so it reads as a service history rather than a data dump. Records accrue automatically from the simulation: every battle updates each deployed pilot's tallies and appends a log entry, so a veteran's file tells the story of their war. Existing saves are backfilled with blank records on load.
    done = true
  f43
    phase = 12
    title = Mechbay Refit UI
    desc = The refit bay now works on real hardpoints with live stat previews instead of installing weapons blind. Every machine maps its five locations — left torso, center torso, right torso, left arm and right arm — each with a finite slot capacity where an energy weapon costs one slot, a missile launcher two and a ballistic gun three; the refit panel draws that map, showing every mounted weapon in place with its slot usage and flagging any location pushed over capacity. Available parts from inventory list their damage, class and slot cost, and each offers a location picker limited to the hardpoints with room; changing the picker previews the actual result before you commit — firepower, alpha heat against the machine's sinks (flagged runs-hot or runs-cool) and overall power, computed from the real simulation values. Installing spends the part and 25% of its value in labour, weapons can be relocated between hardpoints with the same slot rules or stripped back into inventory, destroyed mounts can be refitted in place, and the panel's header reports current firepower, heat balance and power at a glance. All of it is locked while a machine is in the repair bays.
    done = true
  f44
    phase = 12
    title = Dashboard & Almanac
    desc = The Command screen gains a Company almanac that turns the campaign's history into charts and records. Every week the game snapshots the company — funds, income, expense, net cash, debt, morale, headcount, operational machines and win/kill counts — building a rolling history, and every contract completed is written to a contract history with its week, mission, planet, employer, outcome, payout, kills, losses and salvage taken. The almanac renders that data as a funds-over-time line chart and a per-week net-cash bar chart drawn in plain SVG, a KPI strip (weeks active, contracts run, win rate, confirmed kills, total payout, machines lost) and the single best-paying contract on record. Below the charts a contract history table lists the most recent dozen engagements with their outcome chips, pay and casualties, so a long campaign has a real ledger of where it has been and what it cost.
    done = true
  f45
    phase = 12
    title = Voice Lines & Banter
    desc = Every pilot now speaks in their own voice, and those lines surface throughout the company. The voice engine was rebuilt around eighteen situations — deploy, briefing, kill, hurt, injury, machine loss, running dry, overheating, extraction, victory, partial, defeat, payday, salvage, camp, training, recruit and event — each with a pool of generic lines into which each of the twenty-eight personality traits injects its own flavour; a trait has a chance to override the generic line with something specific, so a Sharpshooter, a Mystic, a Packrat and a Gloryhound all react to the same event differently. After every battle the sim composes a "Voices from the lance" set from the survivors, the wounded and anyone who lost a machine, and those lines are stored on the report so they are stable and persist in the archive; the report panel renders them as comms-style quotes, the after-action template weaves them into its "comms chatter" paragraph, and the AI narrative prompt receives them so the written report keeps each pilot's distinct voice. Every company and story event now opens with a personality-driven quote from a random active member, and the Command screen carries a "Barracks chatter" card that shows, stable for the week, what the lance is saying around the DropShip. Personality is no longer just a stat block — it talks.
    done = true
  f46
    phase = 12
    title = Music & Sound
    desc = The company now has a soundtrack. Four era-flavoured instrumental tracks — a brooding menu ambience, a driving battle theme and short victory and defeat stings — play through a small audio manager (src/sound.js) that crossfades between them, ducks the music under a stinger and restores it when the sting ends. The menu theme starts on the player's first interaction (browsers block autoplay until then) and is pitch-tempered by the campaign era so each period of the timeline has its own feel; deploying a lance switches to the battle theme, a victory or defeat plays the matching sting, and closing the after-action report fades back to the command ambience. A ♪ button in the header mutes and unmutes at any time, the preference is remembered between sessions, and music pauses when the tab is hidden. All four tracks are fixed assets hosted online, so no generation happens at runtime.
    done = true

  // ── Phase 13 · Meta, Saves & Sharing ───────────────────────────────────────
  f47
    phase = 13
    title = Achievements & Milestones
    desc = The campaign now rewards long service with a milestones system: twenty-four goals across Combat, Command, Finance, Logistics and Campaign, each with a live progress tracker and a piece of company flavour on completion. Combat milestones cover first blood, ten straight victories, a flawless drop with no injuries or losses, a quarter-century of won contracts and a hundred confirmed kills; Command milestones cover a full year under arms, a twelve-strong roster, six bonds in the ranks, a pilot trained to Gunnery 2 / Piloting 2 and reputation 8 with a Great House; Finance covers a 1.5-million treasury, reaching week ten debt-free, prime credit, three million in contract pay and a single 300k contract; Logistics covers eight operational machines and twenty pieces of salvage recovered; and the Campaign track marks marching into a new era and beating the rival outfit three times. Progress is computed from the real simulation — wins, streaks, kills, machines lost, salvage, treasury peak, reputation, credit score, bonds, roster and pilot skills — with new counters (win streak, flawless drops, salvage recovered) tracked automatically through every battle. Unlocking a milestone writes it to company news, fires a toast, records the week on a Milestones card on the Command screen (recently earned plus the next goals in progress) and files it into a full commendation grid on the Company screen; twelve of the milestones also grant a working title — Blooded, The Undefeated, Warlord, Iron Rain, House Favourite, Scavenger Lord and more — that is worn in the HUD beside the company name and collected on the roster. Existing saves are backfilled and evaluated on load, so veterans are honoured for what they have already achieved.
    done = true
  f48
    phase = 13
    title = Scenario Starts & New Game+
    desc = Founding a company is now a choice of scenario rather than a single template, and campaigns can carry a legacy forward. The new-game modal adds a Founding scenario picker beside era and difficulty with five bespoke starts: the Standard Outfit (the classic light lance), the Clan Bondsman (three Clan-tech machines where the era allows and pilots two skill ranks sharper, but a lean treasury and the Great Houses' suspicion — reputation −2 across the board), the Noble Heir (nearly double the seed capital, a heavy machine and goodwill with two Great Houses), the Broke Outfit (six worn machines, six pilots, a hollowed-out treasury and a 250k loan shark debt to dig out of), and New Game+. Each scenario is data-driven in MGM.SCENARIOS with an apply hook that reshapes the freshly-generated company — money, lance composition, pilot skill, reputation, loans and morale — and reflects it in company news and the Company screen. New Game+ only appears once a real campaign exists (a previous outfit with at least one contract or eight weeks): founding a new company inherits a treasury bonus scaled from the old campaign's weeks and victories (up to 1.2 million C-bills), +4 reputation with the old company's most trusted employer, two hand-picked veteran pilots two ranks above the rest, and the Legacy title, all recorded on the roster as a Legacy note naming the command it was raised from.
    done = true
  f49
    phase = 13
    title = Share Company
    desc = The Company screen can now render the whole outfit as a shareable roster card — a 1080px poster carrying the company crest, name and callsign, era, difficulty, founding scenario and worn titles, four headline KPIs (company rating, contracts run with win/loss, win rate and confirmed kills), a service-record grid (weeks active, total payout, salvage recovered, machines in service, best contract, milestones, personnel and treasury), a standing chart of the three key employers with reputation tiers, the full pilot roster (callsign, real name, Gunnery/Piloting, career kills and win/loss record, readiness) and the operational BattleMech lance (chassis, tonnage, tech base, assigned pilot and condition). One click generates it live on a canvas and opens it in a modal with a PNG download named after the company, plus a one-tap text summary (name, titles, rating, era, difficulty, week, record, personnel, milestones and the generator link) that is copied to the clipboard — or displayed inline to copy manually when the clipboard is blocked. The card auto-sizes to fit the roster and uses the game's own colours and typefaces, so a commander can post it as a recruiting poster or hand it round the table.
    done = true
  f50
    phase = 13
    title = Multiple Company Slots
    desc = The campaign now supports several companies side by side instead of a single save. A registry (kv.saves/“slots”) tracks every outfit with its name, callsign, era, difficulty, week, funds, roster size and last-played time, and each company lives under its own save key with its own portrait bundle and its own rolling-snapshot timeline, so nothing bleeds between playthroughs. The Company screen gains a Mercenary commands card listing every outfit — the active one badged, the rest one click away via Take command — with a Forget button to delete a company (save, portraits and snapshots) and a Found a new company button that spins up a fresh outfit in its own slot while leaving the current one untouched. Founding never overwrites an existing company: the first-ever company keeps the legacy “main” slot and importing an existing save adopts the active slot; switching saves the outgoing company (portraits included) and loads the incoming one, then swaps the portrait cache to match. Backups, the ledger, achievements and the roster are all per company, and the whole thing degrades gracefully when storage lacks the registry — an old single-save game is simply adopted as the “main” slot on first load.
    done = true
  f51
    phase = 13
    title = Difficulty & Ironman
    desc = Difficulty is now a full set of modifiers rather than a single payout tweak, and a company can be founded under Ironman rules. The four settings live in one table (MGM.DIFFICULTIES) — Recruit, Regular, Veteran and Elite — and each scales seven things at once: contract payout, enemy threat, enemy gunnery, repair labour costs, the chance a pilot takes a wound, the salvage a contract yields, and weekly upkeep. Recruit pays 35% more, fields weaker and less accurate enemies, repairs cheaply, wounds rarely, recovers rich salvage and runs on 85% overhead; Elite is the mirror — 66% pay, 150% enemy threat, two ranks of enemy gunnery, 45% more expensive repairs, 60% more wounds, 70% salvage and 130% upkeep. The new-game modal lists every multiplier live under the difficulty picker, and the Company screen gains a Difficulty & rules card that spells out the active modifiers. Ironman is a founding choice (or a one-way commitment made later from that card): it permanently disables the rolling snapshot timeline, snapshot restore and save import for that company while keeping autosave, so defeats, losses and bad weeks cannot be reloaded away. An IRONMAN badge rides in the HUD, the Save card explains the rules instead of offering snapshots, and existing saves are backfilled with the full modifier set.
    done = true

  // ── Phase 14 · Solaris Arena Mode ──────────────────────────────────────────
  f52
    phase = 14
    title = Solaris Arena Mode
    desc = A separate arena career at the Game World's arenas, kept clear of the mercenary contract loop. The Solaris screen runs its own stable in its own save with its own C-bills, roster and fame: found one with a name, callsign, starting weight class and tech era, and it opens with two gladiator machines, their pilots and a stable tech. Fight the Light, Medium, Heavy and Assault circuits — every week the card offers a bout per circuit drawn from the arenas your fame lets you enter (The Factory, Boreal Reach, The Reaches, Ishiyama, the Steiner Coliseum), each with its own purse multiplier and a tougher opponent scaled by circuit, venue and fame. Send any ready gladiator and a round-by-round 1v1 duel resolves in its own engine — relative-power to-hit rolls, damage, machine loss, pilot wounds and a live play-by-play with the crowd, capped by a personalised quote in the pilot's own voice; the report reads power against power, purse, fame and hull lost. Victory pays the purse, earns fame and advances the circuit; defeat pays a fraction and can leave a wrecked machine or a wounded pilot. Between bouts repair machines for cash (the Repair Cradle halves it), buy used gladiators and sign free-agent pilots from a market that refreshes weekly, and sell machines for their current value. Six stable upgrades shape the career (Pilot Harness Bay, Stable Med-bay, Repair Cradle, Publicity Office, Expanded Quarters, Corporate Suite) and five fame-gated sponsorships pay a weekly stipend and boost fame on wins. Fame climbs Unknown → Contender → Crowd Favourite → Ranked → Arena Star → Solaris Champion and unlocks the richer venues with it. Advance the week to collect the stipend, pay tonnage-scaled stable upkeep, heal the wounded, let fame decay and refresh the market and card; a stable that cannot pay is forced to liquidate a machine against its debts. The stable keeps its own bout history, circuit wins, record and news log, and can be closed at any time — entirely independent of, and leaving untouched, the mercenary company's save.
    done = true
