$meta
  title = Final Fantasy
  description = A faithful recreation of the classic 8-bit role-playing adventure: gather your party of four heroes, restore the four elemental crystals, and save the world from darkness.
  image = https://user.uploads.dev/file/9323f9d2669a66e14b62e098a33fb191.jpg
  tags = rpg, fantasy, retro, adventure, game

