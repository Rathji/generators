// ─────────────────────────────────────────────
//  TIC-TAC-TOE — main.pjs (config + data)
//  Classic noughts and crosses built with the
//  Pen & Paper template shell.
//
//  The shell (in index.html) provides the timer,
//  difficulty tabs, hints, win screen, shared
//  leaderboard and autosave. This file only holds
//  metadata and the small tuning knobs below.
//
//  Sections: metadata · leaderboard · GAME CONFIG.
// ─────────────────────────────────────────────

$meta
  title = Tic-Tac-Toe
  description = Classic noughts and crosses on Perchance — take on a computer that ranges from sleepy to unbeatable, or grab a friend for a head-to-head round, on one screen or online by room code. Pick a difficulty, race the clock, use hints, and claim a spot on the shared leaderboard.
  tags = tic tac toe, noughts and crosses, game, board game, two player, ai, online, multiplayer, rooms
  image = https://user.uploads.dev/file/30c780936d986e105d51341100a0afc7.jpg

uploadPlugin = {import:upload-plugin}

// ─────────────────────────────────────────────
//  BGN chrome config — read by index.html to
//  build the shared Boardgame Network frame.
// ─────────────────────────────────────────────
hubUrl = https://perchance.org/bgn-boardgame-network  // Boardgame Network hub
projectsUrl = https://perchance.org/rathjis-generators  // shown as "Rathji's Projects" in the top nav
authorInitial = R  // initial on the "Rathji's Projects" badge
gameTitle = Tic-Tac-Toe
gameTagline = Classic noughts and crosses — take on a computer that ranges from sleepy to unbeatable, or grab a friend for a head-to-head round on one screen or online. Race the clock, spend hints, and claim the board.
gameKicker = Easy · Medium · Hard · Online
gameGenre = Strategy
gamePlayers = 2 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/30c780936d986e105d51341100a0afc7.jpg

createServerSocket = {import:server-plugin}  // powers online tables by room code

// Shared leaderboard: a single public editable text file in this generator's
// namespace. Anyone can read it; the game updates it with the edit key below.
//
// NOTE FOR TEMPLATE USERS: this key is a placeholder. On the FIRST score ever
// published in a fresh copy of this generator, the game creates the file and
// shows you the real editKey — paste that value into `leaderboardEditKey`
// below so every player shares one board. (Until you do, only your own browser
// can update it, and the message on the win screen reminds you.) The key is
// public source by design: this is how a shared, crowd-editable board works.
leaderboardFileName = jwwrxlgb9d0gr6z12jwwcvoxw4
leaderboardEditKey = EPs6kDcFHGULEkWsp1VxvhG7KFw4kp_EJABEs6_b

// ─────────────────────────────────────────────
//  GAME CONFIG — tic-tac-toe tuning.
//  The computer's strength (random/block/perfect)
//  lives in index.html's DIFFS (§4). These knobs
//  are what the shell reads from here.
// ─────────────────────────────────────────────
hintPenaltySeconds = 30   // seconds added to your finish time when you take a hint
aiDelayMs = 420           // thinking pause before the computer moves
