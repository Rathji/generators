// ─────────────────────────────────────────────────────────────
//  BGN HEARTS — main.pjs
//  Page config + the server-plugin import that powers online
//  play. The whole game (rules engine, bots, UI, online client)
//  lives in index.html.
// ─────────────────────────────────────────────────────────────

$meta
  title = BGN Hearts
  description = Classic hearts for four — pass three cards, avoid the hearts and the queen of spades, and shoot the moon. Play against three bots or live online over the Boardgame Network.
  tags = hearts, cards, trick taking, card game, four player, multiplayer, online, boardgame network
  image = https://user.uploads.dev/file/732259bb44547be167a5c3252ee7d2ea.jpg

hubUrl = https://perchance.org/bgn-boardgame-network  // the network hub
gameTitle = BGN Hearts
gameTagline = Pass three, dodge the queen, shoot the moon. Hearts — against bots or live over the network.
gameKicker = Pass · Play · Shoot the Moon
gameGenre = Card game
gamePlayers = 4 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/732259bb44547be167a5c3252ee7d2ea.jpg

createServerSocket = {import:server-plugin}
cardDeck = {import:card-deck-plugin}
