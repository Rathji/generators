$meta
  title = diagram-it
  description = Minimalist Excalidraw-inspired diagramming for IT professionals — architecture diagrams, network topologies, cloud infrastructure maps, Kubernetes layouts and UML. draw.io-compatible import/export is on the roadmap.
  image = https://user.uploads.dev/file/64d6beb8620716b413bf6e4eadca534a.jpg
  tags = diagram, whiteboard, architecture, network, cloud, kubernetes, uml, drawio, excalidraw
  header
    mode = minimal

// ============================================================================
//  DIAGRAM-IT  —  PROJECT OVERVIEW & FEATURE TODO LIST
// ============================================================================
//  An Excalidraw-inspired diagramming app for IT professionals (architecture,
//  network, cloud & UML diagrams). The roadmap below mirrors the project's
//  Atomic Roadmap ("Excalidraw for IT, draw.io compatible") and is the source
//  of truth for what is built vs what is pending. The settings menu →
//  Roadmap tab renders this list live.
//
//  To mark a task done: change its  status = todo   →   status = done
// ============================================================================
diagramIt
  name = diagram-it
  tagline = Minimalist diagramming for IT professionals
  status = In development

  // ── Feature TODO list ────────────────────────────────────────────────────
  //  Source of truth: the attached Atomic Roadmap "diagramit-missing-features-roadmap.md"
  //  (formerly excalidraw-it-drawio-roadmap.md). f0 shipped, t1–t15 pending.
  //  Three dependency-coherent phases: P1 Interoperability (draw.io) → P2 IT
  //  component ecosystem → P3 advanced diagramming logic.
  //
  //  Task ids were renumbered to the attached roadmap's sequence; old→new id:
  //  t1→t1, t2→t2, t3→t4, t4→t3, t5→t6, t6→t7, t7→t8, t8→t9, t9→t10,
  //  t10→t12, t11→t13, t12→t14, t13→t15, t14→t5, t15→t11.
  //
  //  To mark a task done: change its  status = todo   →   status = done
  roadmap
    foundation
      title = Foundation · shipped
      tasks
        f0
          title = App shell — full-window canvas, minimalist tools (select / rectangle / ellipse / arrow / text / pan), business-template color themes & settings menu
          status = done
    p1
      title = Phase 1 · Interoperability & Data Exchange (draw.io)
      tasks
        t1
          title = XML Parser — parse a .drawio XML file and extract all vertex & edge data (geometry, labels, styling)
          status = todo
        t2
          title = Element Mapper — convert parsed draw.io XML elements into compatible scene elements (rectangles, ellipses, arrows; draw.io edges → app arrows)
          status = todo
        t3
          title = Coordinate Validator — align the draw.io coordinate system & scale (mxGraphModel absolute coords, y-down) with the canvas for zero-shift positioning on import/export
          status = todo
        t4
          title = XML Exporter — transform the current scene back into a valid, lossless .drawio XML schema (incl. styles: fills, strokes, font sizes)
          status = todo
        t5
          title = Import/Export Triggers — UI to upload .drawio files & download the current scene as .drawio, integrated into the existing Settings → Canvas import/export flow (PNG / JSON)
          status = todo
    p2
      title = Phase 2 · IT Component Ecosystem
      tasks
        t6
          title = Library Framework — registration system to categorize & manage custom shape libraries (AWS, Azure, GCP, Kubernetes, Cisco); adds an SVG shape element type to the existing renderer & PNG export
          status = todo
        t7
          title = Cloud Asset Pack — SVG components for Compute, Storage, Database & Networking, hand-drawn aesthetic matching the app's stroke style
          status = todo
        t8
          title = Kubernetes Asset Pack — Pods, Services, Ingress, Nodes & Control Plane with standardized iconography
          status = todo
        t9
          title = Network Asset Pack — Routers, Switches, Firewalls & Load Balancers
          status = todo
        t10
          title = UML/ERD Asset Pack — standardized UML (Class, Sequence, State) & Crow's Foot ER shapes
          status = todo
        t11
          title = Library Search & Filter — keyword search within the shape library panels
          status = todo
    p3
      title = Phase 3 · Advanced Diagramming Logic
      tasks
        t12
          title = Smart Connection Anchors — snap arrows to logical anchor points (e.g. ports on router components); integrate with the existing snap setting & arrow tool
          status = todo
        t13
          title = Grouping & Nesting — containers (VPC box → subnets) where children keep relative positions during transforms; integrate with selection, undo/redo & JSON export
          status = todo
        t14
          title = Automated Layout Engine — a "tidy" function to auto-align pipeline flows & sequence diagrams while minimizing edge crossings; undoable & group-aware
          status = todo
        t15
          title = Template Gallery — searchable UI panel to browse & insert pre-defined IT architecture templates (inserts as a single undoable action)
          status = todo

  // ── Color themes — borrowed from business-template ────────────────────────
  //  The default preset ("blue") is business-template's exact brand palette.
  //  Each preset defines a light + dark pair; the settings menu →
  //  Appearance tab applies them live (and persists your choice).
  theme
    defaultPreset = blue
    presets
      blue
