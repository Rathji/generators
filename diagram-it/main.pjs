$meta
  title = diagram-it
  description = Minimalist Excalidraw-inspired diagramming for IT professionals — architecture diagrams, network topologies, cloud infrastructure maps, Kubernetes layouts and UML. draw.io-compatible import/export is on the roadmap.
  image = https://user.uploads.dev/file/64d6beb8620716b413bf6e4eadca534a.jpg
  tags = diagram, whiteboard, architecture, network, cloud, kubernetes, uml, drawio, excalidraw
  header
    mode = minimal

// ============================================================================
//  DIAGRAM-IT  —  PROJECT OVERVIEW & FEATURE TODO LIST
// ============================================================================
//  An Excalidraw-inspired diagramming app for IT professionals (architecture,
//  network, cloud & UML diagrams). The roadmap below mirrors the project's
//  Atomic Roadmap ("Excalidraw for IT, draw.io compatible") and is the source
//  of truth for what is built vs what is pending. The settings menu →
//  Roadmap tab renders this list live.
//
//  To mark a task done: change its  status = todo   →   status = done
// ============================================================================
diagramIt
  name = diagram-it
  tagline = Minimalist diagramming for IT professionals
  status = In development

  // ── Feature TODO list ────────────────────────────────────────────────────
  roadmap
    foundation
      title = Foundation · shipped
      tasks
        f0
          title = App shell — full-window canvas, minimalist tools (select / rectangle / ellipse / arrow / text / pan), business-template color themes & settings menu
          status = done
    p1
      title = Phase 1 · Data Interchange & Compatibility
      tasks
        t1
          title = draw.io XML Parser — consume a .drawio XML file and extract all vertex & edge data (geometry, labels, styling)
          status = todo
        t2
          title = Excalidraw Element Mapper — map parsed draw.io XML elements into compatible scene elements (rect, ellipse, arrow, …)
          status = todo
        t3
          title = draw.io XML Exporter — transform the current scene back into a valid, lossless .drawio XML schema
          status = todo
        t4
          title = Coordinate Validation — align the draw.io coordinate system & scale with the canvas to prevent shifting on import/export
          status = todo
    p2
      title = Phase 2 · IT Shape Library Integration
      tasks
        t5
          title = Component Library Framework — register & categorize custom shape libraries (AWS, Azure, GCP, Kubernetes, Cisco)
          status = todo
        t6
          title = Cloud Infrastructure Asset Pack — SVG components for Compute, Storage, Database, Networking (hand-drawn aesthetic)
          status = todo
        t7
          title = Kubernetes Topology Assets — Pods, Services, Ingress, Nodes, Control Plane with standardized iconography
          status = todo
        t8
          title = Network Topology Assets — Routers, Switches, Firewalls, Load Balancers
          status = todo
        t9
          title = UML & ERD Shape Set — standardized UML (Class, Sequence, State) & Crow's Foot ER shapes
          status = todo
    p3
      title = Phase 3 · Advanced Diagramming Logic
      tasks
        t10
          title = Smart Connection Anchors — snap arrows to logical anchor points on IT components (port-level on routers)
          status = todo
        t11
          title = Grouping & Nesting — containers (VPC box → subnets) where children move relative to the parent
          status = todo
        t12
          title = Automated Layout Engine — auto-align / tidy for pipeline flows & sequence diagrams (minimize edge crossing)
          status = todo
    p4
      title = Phase 4 · UX & Integration
      tasks
        t13
          title = Template Gallery Browser — searchable UI panel for pre-defined IT architecture templates
          status = todo
        t14
          title = XML Import/Export Triggers — upload .drawio files & download the current scene as .drawio
          status = todo
        t15
          title = Library Search & Filter — keyword-based search within the shape libraries
          status = todo

  // ── Color themes — borrowed from business-template ────────────────────────
  //  The default preset ("blue") is business-template's exact brand palette.
  //  Each preset defines a light + dark pair; the settings menu →
  //  Appearance tab applies them live (and persists your choice).
  theme
    defaultPreset = blue
    presets
      blue
