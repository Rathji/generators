      rNs.players[0].library.length === nsLib - 1 && rNs.players[0].graveyard.length === 1,
    "hand=" + rNs.players[0].hand.length + " lib=" + rNs.players[0].library.length);

  let sBw = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 });
  let bw = fxPut(sBw, "bramble-warden", 0);
  sBw.step = "declare_attackers";
  let rBw = frActionDeclareAttackers(sBw, { type: "declareAttackers", player: 0, attackers: [bw] });
  push("bramble-warden attacks: attack trigger adds a +1/+1 counter",
    rBw.lastActionError === null && (rBw.objects[bw].counters.p1p1 || 0) === 1 &&
      frPower(rBw, rBw.objects[bw]) === 4,
    "error=" + rBw.lastActionError + " counters=" + (rBw.objects[bw].counters.p1p1 || 0));

  let sTs = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 });
  let ts = fxPut(sTs, "thornshroud-stalker", 0);
  sTs.step = "declare_attackers";
