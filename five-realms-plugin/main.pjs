frCardGet(id) =>
  let db = frCardDb();
  return db[id] || null;


// =====================================================================
// MANA
// =====================================================================
//
// Cost strings parse per the spec's grammar (section 5). `{T}` is the tap symbol, not a
// mana symbol -- it is rejected here and only ever appears inside rulesText.

frManaParseSymbol(body) =>
  if(body === "T") {
    throw new Error("\{T} is the tap symbol, not a mana symbol; it is not valid inside manaCost");
  }
  if(/^[0-9]+$/.test(body)) {
    let n = parseInt(body, 10);
    return { kind: "generic", n: n, cmc: n, colors: [] };
  }
  if(body === "X") {
    return { kind: "variable", cmc: 0, colors: [] };
  }
  if(body === "C") {
    return { kind: "colorless", cmc: 1, colors: [] };
  }
  if(/^[WUBRG]$/.test(body)) {
    return { kind: "colored", color: body, cmc: 1, colors: [body] };
  }
  if(/^[WUBRG]\/[WUBRG]$/.test(body)) {
    let parts = body.split("/");
    return { kind: "hybridColored", options: parts, cmc: 1, colors: parts };
  }
  if(/^[0-9]+\/[WUBRG]$/.test(body)) {
    let parts = body.split("/");
    let n = parseInt(parts[0], 10);
    return { kind: "hybridGeneric", n: n, color: parts[1], cmc: n, colors: [parts[1]] };
  }
  throw new Error("malformed manaCost symbol: {" + body + "}");

frManaParseCost(costStr) =>
  let str = costStr || "";
  let symbols = [];
  let i = 0;
  while(i < str.length) {
    if(str[i] !== "{") {
      throw new Error("malformed manaCost: expected \{ at index " + i);
    }
    let close = str.indexOf("}", i);
    if(close === -1) {
      throw new Error("malformed manaCost: unterminated \{ at index " + i);
    }
    let body = str.slice(i + 1, close);
    symbols.push(frManaParseSymbol(body));
    i = close + 1;
  }
  let cmc = 0;
  let colors = [];
  for(let s = 0; s < symbols.length; s++) {
    cmc += symbols[s].cmc;
    for(let c = 0; c < symbols[s].colors.length; c++) {
      let color = symbols[s].colors[c];
      if(colors.indexOf(color) === -1) colors.push(color);
    }
  }
  return { symbols: symbols, cmc: cmc, colors: colors };

frManaEmptyPool() =>
  return { W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 };

frManaSymbolOrder(kind) =>
  let order = { colored: 0, colorless: 0, hybridColored: 1, hybridGeneric: 2, generic: 3, variable: 4 };
  return order[kind];

frManaTryPay(pool, parsedCost) =>
  let working = {};
  for(let k in pool) working[k] = pool[k];
  let symbols = parsedCost.symbols.slice();
  symbols.sort((a, b) => frManaSymbolOrder(a.kind) - frManaSymbolOrder(b.kind));
  let genericNeeded = 0;
  for(let i = 0; i < symbols.length; i++) {
    let sym = symbols[i];
    if(sym.kind === "colored") {
      if(working[sym.color] > 0) {
        working[sym.color] -= 1;
      } else {
        return { ok: false, pool: null };
      }
    } else if(sym.kind === "colorless") {
      if(working.C > 0) {
        working.C -= 1;
      } else {
        return { ok: false, pool: null };
      }
    } else if(sym.kind === "hybridColored") {
      let paid = false;
      for(let o = 0; o < sym.options.length; o++) {
        let c = sym.options[o];
        if(working[c] > 0) {
          working[c] -= 1;
          paid = true;
          break;
        }
      }
      if(!paid) return { ok: false, pool: null };
    } else if(sym.kind === "hybridGeneric") {
      if(working[sym.color] > 0) {
        working[sym.color] -= 1;
      } else {
        genericNeeded += sym.n;
      }
    } else if(sym.kind === "generic") {
      genericNeeded += sym.n;
    }
    // "variable" ({X}): Phase 1 has no fixture using it; treated as costing 0, per the
    // spec's cmc table. A real X-value choice is deferred.
  }
  if(genericNeeded > 0) {
    let total = 0;
    for(let k in working) total += working[k];
    if(total < genericNeeded) return { ok: false, pool: null };
    let remaining = genericNeeded;
    for(let k in working) {
      if(remaining <= 0) break;
      let take = Math.min(working[k], remaining);
      working[k] -= take;
      remaining -= take;
    }
  }
  return { ok: true, pool: working };

frManaCanPay(pool, parsedCost) =>
  return frManaTryPay(pool, parsedCost).ok;

frManaPay(pool, parsedCost) =>
  let result = frManaTryPay(pool, parsedCost);
  if(!result.ok) return null;
  return result.pool;

frManaAbilityColor(cardId) =>
  let card = frCardGet(cardId);
  if(!card) return null;
  return card.producesMana || null;


// =====================================================================
// ZONES
// =====================================================================
//
// library/hand/graveyard/exile are per-player arrays of object ids; battlefield and stack
// are shared arrays on the game state itself.

frZoneContainer(state, zone, player) =>
  if(zone === "battlefield") return state.battlefield;
  if(zone === "stack") return state.stack;
  let pl = state.players[player];
  if(zone === "hand") return pl.hand;
  if(zone === "library") return pl.library;
  if(zone === "graveyard") return pl.graveyard;
  if(zone === "exile") return pl.exile;
  return null;

frZoneRemove(state, objId, zone, player) =>
  let arr = frZoneContainer(state, zone, player);
  let idx = arr.indexOf(objId);
  if(idx !== -1) arr.splice(idx, 1);
  return state;

frZoneAdd(state, objId, zone, player) =>
  let arr = frZoneContainer(state, zone, player);
  arr.push(objId);
  return state;

frZoneMove(state, objId, fromZone, toZone, player) =>
  let obj = state.objects[objId];
  frZoneRemove(state, objId, fromZone, player);
  frZoneAdd(state, objId, toZone, player);
  obj.zone = toZone;
  obj.controller = player;
  return state;


// =====================================================================
// GAME OBJECTS
// =====================================================================
//
// A game object is a card instance, distinct from its (immutable) card definition in
// frCardDb. Ids are unique strings, assigned once at game creation and stable for the
// whole game regardless of which zone the object visits.

frObjectNew(id, cardId, owner) =>
  return {
    id: id,
    cardId: cardId,
    owner: owner,
    controller: owner,
    zone: "library",
    tapped: false,
    summoningSickness: true,
    counters: {},
    attachments: [],
    buffsUntilEot: { power: 0, toughness: 0 },
    attachedTo: null,
    damage: 0,
    attacking: false,
    blocking: null
  };


// =====================================================================
// PLAYERS AND GAME SETUP
// =====================================================================
//
// frGameNew builds a fresh, plain-object game state: two (or more) players at 20 life,
// empty mana pools, a shuffled library each (seeded, reproducible), and a 7-card opening
// hand each. Turn 1 begins at the upkeep step (there is nothing to untap yet).

frGameDefaultDeck() =>
  // A playable stand-in built from the fixture card database: every card twice, padded
  // with basic-style mana sources so the deck can actually cast what it draws. Exists so
  // frGameNew is callable with no arguments -- a consumer that just wants a game should
  // not have to supply a decklist, and $output must never throw on a bare "newGame".
  let ids = Object.keys(frCardDb());
  let deck = [];
  for(let i = 0; i < ids.length; i++) {
    deck.push(ids[i]);
    deck.push(ids[i]);
  }
  let lands = ["halo-reliquary", "umbral-barrow"];
  while(deck.length < 40) {
    deck.push(lands[deck.length % lands.length]);
  }
  return deck;

frGameNew(config) =>
  // Tolerant of a missing or partial config: a bare frGameNew() yields a valid two-player
  // game on the default deck. Phase 1 has no deck-legality rules, so any card list is
  // accepted as given.
  let cfg = config || {};
  let seed = cfg.seed === undefined ? 1 : cfg.seed;
  let decks = Array.isArray(cfg.decks) && cfg.decks.length > 0
    ? cfg.decks
    : [frGameDefaultDeck(), frGameDefaultDeck()];
  let rngState = frRngCreate(seed);
  let players = [];
  let objects = {};
  let nextId = 1;
  for(let p = 0; p < decks.length; p++) {
    let deck = Array.isArray(decks[p]) ? decks[p] : frGameDefaultDeck();
    let libraryIds = [];
    for(let d = 0; d < deck.length; d++) {
      let objId = "obj" + nextId;
      nextId += 1;
      objects[objId] = frObjectNew(objId, deck[d], p);
      libraryIds.push(objId);
    }
    let shuffled = frShuffle(libraryIds, rngState);
    rngState = shuffled.state;
    players.push({
      id: p,
      life: 20,
      manaPool: frManaEmptyPool(),
      library: shuffled.array,
      hand: [],
      graveyard: [],
      exile: [],
      landPlayedThisTurn: false,
      lost: false
    });
  }
  let state = {
    seed: seed,
    rngState: rngState,
    turnNumber: 1,
    activePlayer: 0,
    priorityPlayer: 0,
    passedPlayers: [],
    step: "upkeep",
    battlefield: [],
    stack: [],
    objects: objects,
    nextObjectId: nextId,
    effects: [],
    nextEffectStamp: 1,
    players: players,
    gameOver: false,
    winner: null,
    lastActionError: null,
    firstTurnDrawSkipped: false
  };
  for(let p = 0; p < state.players.length; p++) {
    state = frGameDrawN(state, p, 7);
  }
  return state;

frGameDrawOne(state, player) =>
  let pl = state.players[player];
  if(pl.library.length === 0) {
    pl.lost = true;
    state.gameOver = true;
    state.winner = frTurnOtherPlayer(state, player);
    return state;
  }
  let objId = pl.library.shift();
  pl.hand.push(objId);
  state.objects[objId].zone = "hand";
  return state;

frGameDrawN(state, player, n) =>
  for(let i = 0; i < n; i++) {
    state = frGameDrawOne(state, player);
  }
  return state;

frCloneState(state) =>
  return JSON.parse(JSON.stringify(state));


// =====================================================================
// TURN STRUCTURE AND PRIORITY
// =====================================================================
//
// Untap and cleanup are turn-based-action-only steps and grant no priority in the normal
// case; every other step grants priority to the active player first. Mana pools empty at
// every step/phase boundary. All-players-pass either resolves the top of the stack (a
// minimal zone-transition stub -- see frStackResolveTop) or ends the step.

frTurnStepOrder() =>
  return [
    "untap", "upkeep", "draw",
    "precombat_main",
    "begin_combat", "declare_attackers", "declare_blockers", "combat_damage", "end_combat",
    "postcombat_main",
    "end_step", "cleanup"
  ];

frTurnPhaseForStep(step) =>
  let map = {
    untap: "beginning",
    upkeep: "beginning",
    draw: "beginning",
    precombat_main: "precombat_main",
    begin_combat: "combat",
    declare_attackers: "combat",
    declare_blockers: "combat",
    combat_damage: "combat",
    end_combat: "combat",
    postcombat_main: "postcombat_main",
    end_step: "ending",
    cleanup: "ending"
  };
  return map[step];

frTurnGrantsPriority(step) =>
  return step !== "untap" && step !== "cleanup";

frTurnNextPlayer(state, player) =>
  return (player + 1) % state.players.length;

frTurnOtherPlayer(state, player) =>
  return (player + 1) % state.players.length;

frStepUntap(state) =>
  let active = state.activePlayer;
  for(let i = 0; i < state.battlefield.length; i++) {
    let obj = state.objects[state.battlefield[i]];
    if(obj.controller === active) {
      obj.tapped = false;
      obj.summoningSickness = false;
      obj.attacking = false;
      obj.blocking = null;
    }
  }
  return state;

frStepDraw(state) =>
  if(state.turnNumber === 1 && state.activePlayer === 0 && !state.firstTurnDrawSkipped) {
    state.firstTurnDrawSkipped = true;
    return state;
  }
  return frGameDrawOne(state, state.activePlayer);

frStepCleanup(state) =>
  for(let i = 0; i < state.battlefield.length; i++) {
    let obj = state.objects[state.battlefield[i]];
    obj.damage = 0;
    obj.attacking = false;
    obj.blocking = null;
    obj.buffsUntilEot = { power: 0, toughness: 0 };
    obj.deathtouchLethal = false;
  }
  state.combatAttackers = [];
  state.combatBlocks = [];
  for(let i = state.effects.length - 1; i >= 0; i--) {
    if(state.effects[i].untilEot) state.effects.splice(i, 1);
  }
  // Hand-size cleanup and the full state-based-actions loop (704) are deferred to a later phase.
  return state;

frTurnRunStepAutomatic(state) =>
  if(state.step === "untap") return frStepUntap(state);
  if(state.step === "draw") return frStepDraw(state);
  if(state.step === "combat_damage") return frStepCombatDamage(state);
  if(state.step === "cleanup") return frStepCleanup(state);
  return state;

frTurnAdvance(state) =>
  for(let p = 0; p < state.players.length; p++) {
    state.players[p].manaPool = frManaEmptyPool();
  }
  let order = frTurnStepOrder();
  let idx = order.indexOf(state.step);
  if(idx === order.length - 1) {
    state.activePlayer = frTurnNextPlayer(state, state.activePlayer);
    state.turnNumber += 1;
    for(let p = 0; p < state.players.length; p++) {
      state.players[p].landPlayedThisTurn = false;
    }
    state.step = order[0];
  } else {
    state.step = order[idx + 1];
  }
  state = frTurnRunStepAutomatic(state);
  if(!frTurnGrantsPriority(state.step)) {
    return frTurnAdvance(state);
  }
  state.priorityPlayer = state.activePlayer;
  state.passedPlayers = [];
  return state;

frStackResolveTop(state) =>
  let entry = state.stack.pop();
  if(!entry) return state;
  if(entry.kind === "ability") return frResolveAbility(state, entry);
  return frResolveSpell(state, entry);

// frResolveSpell resolves a spell on the stack. Phase 2 replaces the Phase 1
// zone-transition stub: permanents enter (firing their enter triggers), auras attach and
// grant their buff, and instants resolve their actual effect. Entry shape
// { kind:"spell", objId, cardId, target } -- the spell object itself sits in the
// "stack" zone until this resolves it.
frResolveSpell(state, entry) =>
  let obj = state.objects[entry.objId];
  if(!obj) return state;
  if(entry.target != null) {
    let tobj = state.objects[entry.target];
    if(tobj && tobj.zone === "battlefield" && tobj.controller !== obj.controller && frHasKeyword(tobj, "ward")) {
      frZoneRemove(state, obj.id, "stack", obj.controller);
      frZoneAdd(state, obj.id, "graveyard", obj.owner);
      obj.zone = "graveyard";
      return state;
    }
  }
  let card = frCardGet(obj.cardId);
  let permanentTypes = ["Creature", "Artifact", "Enchantment"];
  let isPermanent = false;
  for(let t = 0; t < card.types.length; t++) {
    if(permanentTypes.indexOf(card.types[t]) !== -1) isPermanent = true;
  }
  frZoneRemove(state, obj.id, "stack", obj.controller);
  if(isPermanent) {
    frZoneAdd(state, obj.id, "battlefield", obj.controller);
    obj.zone = "battlefield";
    obj.summoningSickness = true;
    if(card.subtypes.indexOf("Aura") !== -1) {
      let enchant = state.objects[entry.target];
      if(enchant && enchant.zone === "battlefield") {
        obj.attachedTo = enchant.id;
        enchant.attachments.push(obj.id);
        if(obj.cardId === "vow-of-radiance") {
          let b = frAuraBuff(obj.cardId);
          state = frEffectAdd(state, obj.id, enchant.id, {
            layer: 7, power: b ? b.power : 0, toughness: b ? b.toughness : 0, untilEot: false
          });
        }
      } else {
        frZoneRemove(state, obj.id, "battlefield", obj.controller);
        frZoneAdd(state, obj.id, "graveyard", obj.owner);
        obj.zone = "graveyard";
      }
    }
    state = frTriggersOnEnter(state, obj);
  } else {
    frZoneMove(state, obj.id, "stack", "graveyard", obj.owner);
    state = frResolveSpellEffect(state, obj, entry.target);
  }
  return state;

// frResolveSpellEffect applies a resolving instant/sorcery's effect (a seeded per-card
// resolution, not a general 608 rules-text interpreter -- the keyword-ability library is a
// later phase, still).
frResolveSpellEffect(state, obj, target) =>
  let id = obj.cardId;
  if(id === "verdant-surge") {
    state = frEffectAdd(state, obj.id, target, {
      layer: 7, power: 3, toughness: 3, untilEot: true
    });
  } else if(id === "withering-grasp") {
    let t = state.objects[target];
    if(t && !frHasKeyword(t, "indestructible")) {
      frZoneMove(state, t.id, "battlefield", "graveyard", t.owner);
      t.zone = "graveyard";
    }
  }
  return state;

// frResolveAbility resolves an activated-ability entry. Only the fixture cards'
// abilities are known here; entry shape { kind:"ability", objId, cardId, target }.
// Mana abilities never reach the stack (they resolve immediately at activation); this is for
// the one on-the-stack ability among the fixtures: Faceted Ember Core's 3-damage.
frResolveAbility(state, entry) =>
  if(entry.cardId === "faceted-ember-core") {
    let t = state.objects[entry.target];
    if(t) {
      t.damage += 3;
      state = frCheckStateBasedActions(state);
    } else if(typeof entry.target === "number" && state.players[entry.target]) {
      state.players[entry.target].life -= 3;
      state = frCheckStateBasedActions(state);
    }
  }
  return state;

// The permanent/aura/combat-model helpers shared by resolution, combat, and
// frLegalActions. frPower/frToughness fold a creature's base P/T, +1/+1 counters,
// until-end-of-turn buffs (Verdant Surge), and attached-aura buffs (Vow of
// Radiance) into one number.
frAuraBuff(cardId) =>
  let card = frCardGet(cardId);
  if(card && card.subtypes.indexOf("Aura") !== -1 && card.rulesText.indexOf("+2/+2") !== -1) {
    return { power: 2, toughness: 2 };
  }
  return null;

// frEffectAdd registers a continuous effect -- a layer-ordered modifier generated by an
// activated/triggered/static ability or a resolving permanent. Effects live apart from the
// object so order of creation (rule 613.7 timestamp order) decides which wins when two
// modify the same characteristic. untilEot effects are dropped in the cleanup step.
frEffectAdd(state, sourceId, targetId, opts) =>
  let eff = {
    id: "fx" + state.nextEffectStamp,
    timestamp: state.nextEffectStamp,
    sourceId: sourceId,
    targetId: targetId,
    layer: opts.layer,           // 7 = power/toughness-modifying
    power: opts.power || 0,
    toughness: opts.toughness || 0,
    untilEot: !!opts.untilEot
  };
  state.nextEffectStamp += 1;
  state.effects.push(eff);
  return state;

// The power/toughness effects targeting a given object, in timestamp order (rule 613.7).
// Ties (same timestamp) break toward the effect whose source most recently moved zones -- the
// fixture set never produces that tie, but the ordering is already dependency sorted.
frEffectsFor(state, objId) =>
  let list = [];
  for(let i = 0; i < state.effects.length; i++) {
    if(state.effects[i].targetId === objId) list.push(state.effects[i]);
  }
  list.sort(function(a, b) { return a.timestamp - b.timestamp; });
  return list;

frPower(state, obj) =>
  let card = frCardGet(obj.cardId);
  let base = (card && typeof card.power === "number") ? card.power : 0;
  let p1 = obj.counters.p1p1 || 0;
  let eot = (obj.buffsUntilEot && obj.buffsUntilEot.power) || 0;
  let fx = frEffectsFor(state, obj.id);
  let sum = 0;
  for(let i = 0; i < fx.length; i++) sum += fx[i].power;
  return base + p1 + eot + sum;

frToughness(state, obj) =>
  let card = frCardGet(obj.cardId);
  let base = (card && typeof card.toughness === "number") ? card.toughness : 0;
  let p1 = obj.counters.p1p1 || 0;
  let eot = (obj.buffsUntilEot && obj.buffsUntilEot.toughness) || 0;
  let fx = frEffectsFor(state, obj.id);
  let sum = 0;
  for(let i = 0; i < fx.length; i++) sum += fx[i].toughness;
  return base + p1 + eot + sum;

frCardNeedsTarget(card) =>
  let id = card ? card.id : null;
  return id === "verdant-surge" || id === "withering-grasp" || id === "vow-of-radiance";

frTargetLegalForSpell(state, card, target, caster) =>
  let t = state.objects[target];
  if(!t || t.zone !== "battlefield") return false;
  if(t.controller !== caster && frHasKeyword(t, "hexproof")) return false;
  let tcard = frCardGet(t.cardId);
  if(!tcard || tcard.types.indexOf("Creature") === -1) return false;
  if(card.id === "withering-grasp") return frToughness(state, t) <= 3;
  return true;

frLegalTargetsForSpell(state, card, caster) =>
  let ids = [];
  for(let i = 0; i < state.battlefield.length; i++) {
    let obj = state.objects[state.battlefield[i]];
    if(!obj) continue;
    let tcard = frCardGet(obj.cardId);
    if(!tcard || tcard.types.indexOf("Creature") === -1) continue;
    if(obj.controller !== caster && frHasKeyword(obj, "hexproof")) continue;
    if(card.id === "withering-grasp" && frToughness(state, obj) > 3) continue;
    ids.push(obj.id);
  }
  return ids;

frAbilityTargetLegal(state, target, caster) =>
  if(typeof target === "number" && state.players[target]) return true;
  let t = state.objects[target];
  if(!t || t.zone !== "battlefield") return false;
  if(t.controller !== caster && frHasKeyword(t, "hexproof")) return false;
  return true;

frLegalAbilityTargets(state, caster) =>
  let tg = [];
  for(let p = 0; p < state.players.length; p++) tg.push(p);
  for(let i = 0; i < state.battlefield.length; i++) {
    let obj = state.objects[state.battlefield[i]];
    if(obj && !(obj.controller !== caster && frHasKeyword(obj, "hexproof"))) tg.push(obj.id);
  }
  return tg;

frTriggersOnEnter(state, obj) =>
  let id = obj.cardId;
  if(id === "sunward-sentinel") {
    state.players[obj.controller].life += 2;
  } else if(id === "nautilus-seer") {
    state = frGameDrawOne(state, obj.controller);
    let pl = state.players[obj.controller];
    if(pl.hand.length > 0) {
      let c = pl.hand.pop();
      frZoneRemove(state, c, "hand", obj.controller);
      frZoneAdd(state, c, "graveyard", obj.controller);
      state.objects[c].zone = "graveyard";
    }
  }
  return state;

frTriggersOnDeclareAttack(state, attacker) =>
  if(attacker.cardId === "bramble-warden") {
    attacker.counters.p1p1 = (attacker.counters.p1p1 || 0) + 1;
  }
  return state;

frTriggersOnCombatDamageToPlayer(state, attacker, player) =>
  if(attacker.cardId === "thornshroud-stalker") {
    let pl = state.players[player];
    if(pl.hand.length > 0) {
      let c = pl.hand.pop();
      frZoneRemove(state, c, "hand", player);
      frZoneAdd(state, c, "graveyard", player);
      state.objects[c].zone = "graveyard";
    }
  }
  return state;

// Keyword ability library (rule 702). A card's static keywords live in card.keywords (an
// array of lower-case tokens); frHasKeyword reads them live, so effects may fold in more.
// frKeywordSet is the full vocabulary the engine gives real meaning to: flying/reach/menace
// shape blocker legality, trample spills combat damage, first/double strike drive the two-pass
// damage step, deathtouch makes any damage lethal, lifelink gains life, haste/vigilance/
// defender shape who may attack, hexproof blocks opponent targeting, skulk blocks only
// lower-or-equal-power blockers, indestructible ignores lethal damage and destroy effects, and
// ward counters opponent spells/abilities that target it (here resolved as countered, since the
// engine is non-interactive -- see below).
frKeywordSet() =>
  return ["flying", "trample", "haste", "vigilance", "defender", "reach", "menace", "deathtouch", "first strike", "double strike", "lifelink", "hexproof", "indestructible", "skulk", "ward"];

frKeywords(obj) =>
  let card = frCardGet(obj.cardId);
  return (card && card.keywords) ? card.keywords : [];

frHasKeyword(obj, kw) =>
  return frKeywords(obj).indexOf(kw) !== -1;

// Replacement effects (rule 614). A permanent may carry a card.replacement rule; each has
// an `event` name it replaces. The one the fixtures use prevents a player from taking combat
// damage (a prevention replacement, rule 615). Each replacement is a player applying to events
// of that kind; the preventing player is the permanent's controller.
frReplacementEffects(state, event) =>
  let list = [];
  for(let i = 0; i < state.battlefield.length; i++) {
    let obj = state.objects[state.battlefield[i]];
    if(!obj || obj.zone !== "battlefield") continue;
    let card = frCardGet(obj.cardId);
    if(card && card.replacement && card.replacement.event === event) list.push(obj);
  }
  return list;

frReplacementPreventsCombatDamageTo(state, player) =>
  let list = frReplacementEffects(state, "prevent-combat-damage-to-player");
  for(let i = 0; i < list.length; i++) {
    if(list[i].controller === player) return true;
  }
  return false;

frDealCombatDamageToPlayer(state, attacker, player) =>
  if(frReplacementPreventsCombatDamageTo(state, player)) return state;
  let dmg = frPower(state, attacker);
  if(frHasKeyword(attacker, "lifelink")) state.players[attacker.controller].life += dmg;
  state.players[player].life -= dmg;
  state = frTriggersOnCombatDamageToPlayer(state, attacker, player);
  return state;

frDealCombatDamageToCreature(state, source, target, dmg) =>
  if(dmg <= 0) return state;
  if(frHasKeyword(source, "deathtouch")) target.deathtouchLethal = true;
  target.damage += dmg;
  if(frHasKeyword(source, "lifelink")) state.players[source.controller].life += dmg;
  return state;

// frDoCombatPass assigns combat damage for one strike (first-strike creatures first, then the
// rest). A blocker first absorbs the attacker's power as damage; with trample, any excess
// over its toughness spills onto the defending player.
frDoCombatPass(state, attackerIds) =>
  let blocks = state.combatBlocks || [];
  let defenders = {};
  for(let i = 0; i < blocks.length; i++) {
    (defenders[blocks[i].attacker] = defenders[blocks[i].attacker] || []).push(blocks[i].blocker);
  }
  for(let i = 0; i < attackerIds.length; i++) {
    let attacker = state.objects[attackerIds[i]];
    if(!attacker || attacker.zone !== "battlefield") continue;
    let bl = defenders[attacker.id] || [];
    if(bl.length === 0) {
      state = frDealCombatDamageToPlayer(state, attacker, frTurnOtherPlayer(state, attacker.controller));
      state = frCheckStateBasedActions(state);
    } else {
      let dmg = frPower(state, attacker);
      let blocker = state.objects[bl[0]];
      if(!blocker || blocker.zone !== "battlefield") continue;
      state = frDealCombatDamageToCreature(state, attacker, blocker, dmg);
      state = frDealCombatDamageToCreature(state, blocker, attacker, frPower(state, blocker));
      if(frHasKeyword(attacker, "trample") && dmg >= frToughness(state, blocker)) {
        let def = frTurnOtherPlayer(state, attacker.controller);
        if(!frReplacementPreventsCombatDamageTo(state, def)) {
          state.players[def].life -= (dmg - frToughness(state, blocker));
        }
      }
      state = frCheckStateBasedActions(state);
    }
  }
  return state;

// frStepCombatDamage runs the two combat-damage strikes (rule 510): first-strike and
// double-strike creatures deal damage in the first strike, then everyone else -- and any
// double-strikers -- in the second. Lethal damage (creature with damage in excess of its
// toughness, or any damage from a deathtouch source) is a state-based action and
// processes after each assignment.
frStepCombatDamage(state) =>
  let attackers = state.combatAttackers || [];
  let first = attackers.filter(function(id) {
    let o = state.objects[id];
    return o && (frHasKeyword(o, "first strike") || frHasKeyword(o, "double strike"));
  });
  let normal = attackers.filter(function(id) {
    let o = state.objects[id];
    return o && !frHasKeyword(o, "first strike");
  });
  state = frDoCombatPass(state, first);
  state = frDoCombatPass(state, normal);
  return state;

// State-based actions -- a real 704-style loop, checked before each player receives
// priority and re-run until nothing changes. Each iteration sweeps the battlefield for a
// creature with toughness 0 or less, a creature with damage in excess of its
// toughness, an Aura attached to no legal object, a token (none among the fixtures) or
// Legendary-duplicate rule (no legendaries yet, but the check is general), and each
// player at 0 or less life. Any legal-Aura condition that fails sends the Aura to the
// graveyard. Because one SBA resolving can trigger another, the whole sweep repeats until a
// pass changes nothing.
frCheckStateBasedActions(state) =>
  let changed = true;
  let guard = 0;
  while(changed && guard < 100) {
    changed = false;
    for(let i = state.battlefield.length - 1; i >= 0; i--) {
      let id = state.battlefield[i];
      let obj = state.objects[id];
      if(!obj) continue;
      let card = frCardGet(obj.cardId);
      let isCreature = card.types.indexOf("Creature") !== -1;
      let toughness = isCreature ? frToughness(state, obj) : 0;
      if(isCreature && toughness <= 0) {
        state = frDeathDestroy(state, id);
        changed = true;
        continue;
      }
      if(isCreature && !frHasKeyword(obj, "indestructible") && (obj.damage >= toughness || (obj.deathtouchLethal && obj.damage > 0))) {
        state = frDeathDestroy(state, id);
        changed = true;
        continue;
      }
      if(card.subtypes.indexOf("Aura") !== -1 && frAuraAttachedIllegally(state, id)) {
        for(let ei = state.effects.length - 1; ei >= 0; ei--) {
          if(state.effects[ei].sourceId === id) state.effects.splice(ei, 1);
        }
        frZoneMove(state, id, "battlefield", "graveyard", obj.owner);
        obj.zone = "graveyard";
        changed = true;
      }
    }
    for(let p = 0; p < state.players.length; p++) {
      if(state.players[p].life <= 0 && !state.players[p].lost) {
        state.players[p].lost = true;
        state.gameOver = true;
        state.winner = frTurnOtherPlayer(state, p);
        changed = true;
      }
    }
    guard++;
  }
  return state;

// Move a battlefield object (and whatever is attached to it) to the graveyard and reset
// its combat bookkeeping, so downstream rules never see stale damage/attack flags.
frDeathDestroy(state, id) =>
  let obj = state.objects[id];
  if(!obj) return state;
  while(obj.attachments.length > 0) {
    let a = obj.attachments.pop();
    if(state.objects[a]) {
      for(let ei = state.effects.length - 1; ei >= 0; ei--) {
        if(state.effects[ei].sourceId === a) state.effects.splice(ei, 1);
      }
      frZoneMove(state, a, "battlefield", "graveyard", state.objects[a].owner);
      state.objects[a].zone = "graveyard";
    }
  }
  for(let i = state.effects.length - 1; i >= 0; i--) {
    if(state.effects[i].sourceId === id) state.effects.splice(i, 1);
  }
  frZoneMove(state, id, "battlefield", "graveyard", obj.owner);
  obj.zone = "graveyard";
  obj.damage = 0;
  obj.deathtouchLethal = false;
  obj.attacking = false;
  obj.blocking = null;
  obj.buffsUntilEot = { power: 0, toughness: 0 };
  return state;

// An Aura is illegally attached when it points at no object, points at an object that
// left the battlefield, or (fixture-specific) enchants a non-creature.
frAuraAttachedIllegally(state, id) =>
  let obj = state.objects[id];
  let ench = obj.attachedTo ? state.objects[obj.attachedTo] : null;
  if(!ench || ench.zone !== "battlefield") return true;
  if(obj.cardId === "vow-of-radiance" && frCardGet(ench.cardId).types.indexOf("Creature") === -1) return true;
  return false;


// =====================================================================
// ACTIONS
// =====================================================================
//
// frApplyAction(state, action) is the single reducer. It never mutates its input: it
// clones state first, then either returns a changed clone or the same clone with
// lastActionError set to why the action was rejected.

frActionPassPriority(state, action) =>
  let player = action.player;
  if(state.priorityPlayer !== player) {
    state.lastActionError = "player " + player + " does not have priority";
    return state;
  }
  state = frCheckStateBasedActions(state);
  if(state.passedPlayers.indexOf(player) === -1) {
    state.passedPlayers.push(player);
  }
  if(state.passedPlayers.length < state.players.length) {
    state.priorityPlayer = frTurnNextPlayer(state, player);
    return state;
  }
  if(state.stack.length > 0) {
    state = frStackResolveTop(state);
    state = frCheckStateBasedActions(state);
    state.passedPlayers = [];
    state.priorityPlayer = state.activePlayer;
    return state;
  }
  state.passedPlayers = [];
  return frTurnAdvance(state);

frActionPlayLand(state, action) =>
  let player = action.player;
  if(state.activePlayer !== player) {
    state.lastActionError = "only the active player may play a land";
    return state;
  }
  if(state.priorityPlayer !== player) {
    state.lastActionError = "player does not have priority";
    return state;
  }
  if(state.step !== "precombat_main" && state.step !== "postcombat_main") {
    state.lastActionError = "lands may only be played during a main phase";
    return state;
  }
  if(state.stack.length > 0) {
    state.lastActionError = "cannot play a land while the stack is non-empty";
    return state;
  }
  let pl = state.players[player];
  if(pl.landPlayedThisTurn) {
    state.lastActionError = "already played a land this turn";
    return state;
  }
  let objId = action.objectId;
  let obj = state.objects[objId];
  if(!obj || obj.zone !== "hand" || obj.owner !== player) {
    state.lastActionError = "object is not in player's hand";
    return state;
  }
  let card = frCardGet(obj.cardId);
  if(!card || card.types.indexOf("Land") === -1) {
    state.lastActionError = "object is not a land";
    return state;
  }
  frZoneMove(state, objId, "hand", "battlefield", player);
  obj.tapped = false;
  obj.summoningSickness = false;
  pl.landPlayedThisTurn = true;
  state.passedPlayers = [];
  state.priorityPlayer = player;
  return state;

frActionCastSpell(state, action) =>
  let player = action.player;
  if(state.priorityPlayer !== player) {
    state.lastActionError = "player does not have priority";
    return state;
  }
  let objId = action.objectId;
  let obj = state.objects[objId];
  if(!obj || obj.zone !== "hand" || obj.owner !== player) {
    state.lastActionError = "object is not in player's hand";
    return state;
  }
  let card = frCardGet(obj.cardId);
  if(!card) {
    state.lastActionError = "unknown card";
    return state;
  }
  if(card.types.indexOf("Land") !== -1) {
    state.lastActionError = "lands are played, not cast";
    return state;
  }
  if(frCardNeedsTarget(card) && !frTargetLegalForSpell(state, card, action.target, player)) {
    state.lastActionError = "invalid target";
    return state;
  }
  let sorcerySpeedTypes = ["Creature", "Sorcery", "Enchantment", "Artifact"];
  let isSorcerySpeed = false;
  for(let t = 0; t < card.types.length; t++) {
    if(sorcerySpeedTypes.indexOf(card.types[t]) !== -1) isSorcerySpeed = true;
  }
  if(isSorcerySpeed) {
    if(state.activePlayer !== player) {
      state.lastActionError = "sorcery-speed spell requires being the active player";
      return state;
    }
    if(state.step !== "precombat_main" && state.step !== "postcombat_main") {
      state.lastActionError = "sorcery-speed spell requires a main phase";
      return state;
    }
    if(state.stack.length > 0) {
      state.lastActionError = "sorcery-speed spell requires an empty stack";
      return state;
    }
  }
  let parsedCost = frManaParseCost(card.manaCost);
  let pl = state.players[player];
  let payResult = frManaTryPay(pl.manaPool, parsedCost);
  if(!payResult.ok) {
    state.lastActionError = "cannot pay mana cost";
    return state;
  }
  pl.manaPool = payResult.pool;
  frZoneMove(state, objId, "hand", "stack", player);
  state.stack.push({ kind: "spell", objId: objId, cardId: card.id, target: action.target || null });
  state.passedPlayers = [];
  state.priorityPlayer = player;
  return state;

frActionActivateAbility(state, action) =>
  let player = action.player;
  if(state.priorityPlayer !== player) {
    state.lastActionError = "player does not have priority";
    return state;
  }
  let objId = action.objectId;
  let obj = state.objects[objId];
  if(!obj || obj.zone !== "battlefield" || obj.controller !== player) {
    state.lastActionError = "object is not a permanent you control";
    return state;
  }
  let card = frCardGet(obj.cardId);
  if(obj.tapped) {
    state.lastActionError = "permanent is already tapped";
    return state;
  }
  if(card.types.indexOf("Creature") !== -1 && obj.summoningSickness) {
    state.lastActionError = "summoning sickness prevents activating a tap ability";
    return state;
  }
  if(card.id === "faceted-ember-core") {
    let payResult = frManaTryPay(state.players[player].manaPool, frManaParseCost("\{3}"));
    if(!payResult.ok) {
      state.lastActionError = "cannot pay the 3 mana";
      return state;
    }
    if(!frAbilityTargetLegal(state, action.target, player)) {
      state.lastActionError = "invalid target";
      return state;
    }
    state.players[player].manaPool = payResult.pool;
    obj.tapped = true;
    frZoneMove(state, objId, "battlefield", "graveyard", obj.owner);
    obj.zone = "graveyard";
    state.stack.push({ kind: "ability", objId: objId, cardId: card.id, target: action.target });
    state.passedPlayers = [];
    state.priorityPlayer = player;
    return state;
  }
  let color = frManaAbilityColor(obj.cardId);
  if(!color) {
    state.lastActionError = "no known mana ability on this permanent";
    return state;
  }
  obj.tapped = true;
  state.players[player].manaPool[color] += 1;
  state.passedPlayers = [];
  state.priorityPlayer = player;
  return state;

frActionTapPermanent(state, action) =>
  let player = action.player;
  let objId = action.objectId;
  let obj = state.objects[objId];
  if(!obj || obj.zone !== "battlefield" || obj.controller !== player) {
    state.lastActionError = "object is not a permanent you control";
    return state;
  }
  if(obj.tapped) {
    state.lastActionError = "permanent is already tapped";
    return state;
  }
  obj.tapped = true;
  return state;

frActionDeclareAttackers(state, action) =>
  let player = action.player;
  if(state.step !== "declare_attackers") {
    state.lastActionError = "not the declare attackers step";
    return state;
  }
  if(state.activePlayer !== player) {
    state.lastActionError = "only the active player declares attackers";
    return state;
  }
  let ids = action.attackers || [];
  for(let i = 0; i < ids.length; i++) {
    let obj = state.objects[ids[i]];
    if(!obj || obj.zone !== "battlefield" || obj.controller !== player) {
      state.lastActionError = "invalid attacker: " + ids[i];
      return state;
    }
    let card = frCardGet(obj.cardId);
    if(card.types.indexOf("Creature") === -1) {
      state.lastActionError = "not a creature: " + ids[i];
      return state;
    }
    if(frHasKeyword(obj, "defender")) {
      state.lastActionError = "creature with defender cannot attack: " + ids[i];
      return state;
    }
    if(obj.tapped) {
      state.lastActionError = "tapped creature cannot attack: " + ids[i];
      return state;
    }
    if(obj.summoningSickness && !frHasKeyword(obj, "haste")) {
      state.lastActionError = "summoning sickness: " + ids[i];
      return state;
    }
  }
  for(let i = 0; i < ids.length; i++) {
    let obj = state.objects[ids[i]];
    obj.attacking = true;
    if(!frHasKeyword(obj, "vigilance")) obj.tapped = true;
    state = frTriggersOnDeclareAttack(state, obj);
  }
  state.combatAttackers = ids;
  return state;

frActionDeclareBlockers(state, action) =>
  let player = action.player;
  if(state.step !== "declare_blockers") {
    state.lastActionError = "not the declare blockers step";
    return state;
  }
  if(state.activePlayer === player) {
    state.lastActionError = "the active player does not declare blockers";
    return state;
  }
  let blocks = action.blocks || [];
  for(let i = 0; i < blocks.length; i++) {
    let blocker = state.objects[blocks[i].blocker];
    let attacker = state.objects[blocks[i].attacker];
    if(!blocker || blocker.zone !== "battlefield" || blocker.controller !== player) {
      state.lastActionError = "invalid blocker: " + blocks[i].blocker;
      return state;
    }
    if(!attacker || !attacker.attacking) {
      state.lastActionError = "not an attacking creature: " + blocks[i].attacker;
      return state;
    }
  }
  let menaceCount = {};
  for(let i = 0; i < blocks.length; i++) {
    let attacker = state.objects[blocks[i].attacker];
    if(frHasKeyword(attacker, "menace")) {
      menaceCount[attacker.id] = (menaceCount[attacker.id] || 0) + 1;
    }
  }
  for(let i = 0; i < blocks.length; i++) {
    let blocker = state.objects[blocks[i].blocker];
    let attacker = state.objects[blocks[i].attacker];
    if(attacker.tapped) {
      state.lastActionError = "tapped creature cannot block: " + blocks[i].blocker;
      return state;
    }
    if(frHasKeyword(attacker, "flying") && !frHasKeyword(blocker, "flying") && !frHasKeyword(blocker, "reach")) {
      state.lastActionError = "only flying/reach can block a flying attacker: " + blocks[i].blocker;
      return state;
    }
    if(frHasKeyword(attacker, "skulk") && frPower(state, blocker) > frPower(state, attacker)) {
      state.lastActionError = "only equal-or-lower-power creatures can block a skulk attacker: " + blocks[i].blocker;
      return state;
    }
    if(frHasKeyword(attacker, "menace") && (menaceCount[attacker.id] || 0) < 2) {
      state.lastActionError = "menace requires two blockers: " + attacker.id;
      return state;
    }
  }
  for(let i = 0; i < blocks.length; i++) {
    state.objects[blocks[i].blocker].blocking = blocks[i].attacker;
  }
  state.combatBlocks = blocks;
  return state;

frActionConcede(state, action) =>
  let player = action.player;
  if(!state.players[player]) {
    state.lastActionError = "no such player: " + player;
    return state;
  }
  state.players[player].lost = true;
  state.gameOver = true;
  state.winner = frTurnOtherPlayer(state, player);
  return state;

frApplyAction(state, action) =>
  // The reducer is the engine's outermost gate: $output("act", ...) routes straight into
  // it, and the plugin's contract is that nothing throws on hostile input. Every action
  // shape that is not an object with a string `type` is rejected here as a recorded
  // error on the returned state rather than an exception.
  let next = frCloneState(state);
  next.lastActionError = null;
  if(!action || typeof action !== "object" || typeof action.type !== "string") {
    next.lastActionError = "malformed action";
    return next;
  }
  if(next.gameOver) {
    next.lastActionError = "game is over";
    return next;
  }
  if(action.type === "concede") return frActionConcede(next, action);
  if(action.type === "passPriority") return frActionPassPriority(next, action);
  if(action.type === "playLand") return frActionPlayLand(next, action);
  if(action.type === "castSpell") return frActionCastSpell(next, action);
  if(action.type === "activateAbility") return frActionActivateAbility(next, action);
  if(action.type === "tapPermanent") return frActionTapPermanent(next, action);
  if(action.type === "declareAttackers") return frActionDeclareAttackers(next, action);
  if(action.type === "declareBlockers") return frActionDeclareBlockers(next, action);
  next.lastActionError = "unknown action type: " + action.type;
  return next;

// =====================================================================
// QUERY HELPERS
// =====================================================================
//
// Fixed reference lists and a best-effort legal-action enumerator. frRealmList/
// frRarityList are the realm-identity and rarity-tier orderings fixed by
// docs/specs/2026-08-21-five-realms-card-model.md sections 1 and 2 -- game data, not DSL,
// same footing as frCardDb.

frRealmList() =>
  return ["solara", "verdant", "tide", "ember", "umbra"];

frRarityList() =>
  return ["Field", "Marked", "Vaulted", "Sovereign", "Ascendant"];

frCardTypeLine(card) =>
  let parts = card.supertypes.concat(card.types);
  let line = parts.join(" ");
  if(card.subtypes.length > 0) line += " \u2014 " + card.subtypes.join(" ");
  return line;

// Combat-move helpers for the legal-action solver below: eligible attackers are your untapped
// creatures that aren't hindered, and blockers are matched to attackers honouring flying/reach
// and menace. Subset enumeration is 2^n (attack) and base-(n+1) (blockers), capped so
// a huge board degrades to listing solo attackers rather than blowing up.
frEligibleAttackers(state, player) =>
  let out = [];
  let bf = state.battlefield;
  for(let i = 0; i < bf.length; i++) {
    let o = state.objects[bf[i]];
    if(!o || o.zone !== "battlefield" || o.controller !== player) continue;
    let card = frCardGet(o.cardId);
    if(!card || card.types.indexOf("Creature") === -1) continue;
    if(o.tapped) continue;
    if(frHasKeyword(o, "defender")) continue;
    if(o.summoningSickness && !frHasKeyword(o, "haste")) continue;
    out.push(o.id);
  }
  return out;

frLegalAttackerActions(state, player) =>
  let elig = frEligibleAttackers(state, player);
  let actions = [];
  let n = elig.length;
  if(n <= 10) {
    for(let mask = 0; mask < (1 << n); mask++) {
      let arr = [];
      for(let i = 0; i < n; i++) {
        if(mask & (1 << i)) arr.push(elig[i]);
      }
      actions.push({ type: "declareAttackers", player: player, attackers: arr });
    }
  } else {
    for(let i = 0; i < n; i++) {
      actions.push({ type: "declareAttackers", player: player, attackers: [elig[i]] });
    }
  }
  return actions;

frBlockerCanBlock(attacker, blocker, state) =>
  if(frHasKeyword(attacker, "flying") && !frHasKeyword(blocker, "flying") && !frHasKeyword(blocker, "reach")) return false;
  if(frHasKeyword(attacker, "skulk") && frPower(state, blocker) > frPower(state, attacker)) return false;
  return true;

frLegalBlockerActions(state, player) =>
  let attackers = state.combatAttackers || [];
  let bf = state.battlefield;
  let blockers = [];
  for(let i = 0; i < bf.length; i++) {
    let o = state.objects[bf[i]];
    if(!o || o.zone !== "battlefield" || o.controller !== player) continue;
    let card = frCardGet(o.cardId);
    if(!card || card.types.indexOf("Creature") === -1) continue;
    if(o.tapped) continue;
    blockers.push(o.id);
  }
  let actions = [];
  let bn = blockers.length, an = attackers.length;
  let base = an + 1;
  let count = 1;
  for(let i = 0; i < bn; i++) count *= base;
  if(count > 2048) count = 2048;
  for(let vi = 0; vi < count; vi++) {
    let num = vi;
    let assign = [];
    for(let bi = 0; bi < bn; bi++) {
      let t = num % base;
      num = Math.floor(num / base);
      assign.push(t);
    }
    let any = false;
    for(let bi = 0; bi < bn; bi++) if(assign[bi] !== 0) any = true;
    if(!any) continue;
    let blocks = [];
    let okc = true;
    for(let ai = 0; ai < an; ai++) {
      let cnt = 0;
      for(let bi = 0; bi < bn; bi++) if(assign[bi] === (ai + 1)) cnt++;
      if(cnt === 0) continue;
      if(frHasKeyword(state.objects[attackers[ai]], "menace") && cnt < 2) { okc = false; break; }
    }
    if(!okc) continue;
    for(let bi = 0; bi < bn; bi++) {
      if(assign[bi] !== 0) {
        let attId = attackers[assign[bi] - 1];
        if(!frBlockerCanBlock(state.objects[attId], state.objects[blockers[bi]], state)) { okc = false; break; }
        blocks.push({ attacker: attId, blocker: blockers[bi] });
      }
    }
    if(!okc) continue;
    actions.push({ type: "declareBlockers", player: player, blocks: blocks });
  }
  return actions;


// frLegalActions for $output("legalActions", state): a planar-legal-action solver whose
// moves mirror each frAction*'s own guard clauses, so it never contradicts a reducer
// at the point it was written. Unlike the old stub it also surfaces a tapPermanent move
// for every untapped permanent (so a client can tap a mana source first and then spend it,
// instead of only seeing spells payable from the current floating pool), and it enumerates real
// attacker and blocker declarations rather than a yes/no stub. Returns [] rather than
// throwing on any malformed state (see NOTES.md, "Never throws").

frLegalActions(state) =>
  let actions = [];
  if(!state || typeof state !== "object" || !Array.isArray(state.players)) return actions;
  if(state.gameOver) return actions;
  let priority = state.priorityPlayer;
  let pl = state.players[priority];
  if(!pl) return actions;

  actions.push({ type: "passPriority", player: priority });
  actions.push({ type: "concede", player: priority });

  let mainPhase = state.step === "precombat_main" || state.step === "postcombat_main";
  let emptyStack = state.stack.length === 0;

  if(priority === state.activePlayer && mainPhase && emptyStack && !pl.landPlayedThisTurn) {
    for(let i = 0; i < pl.hand.length; i++) {
      let objId = pl.hand[i];
      let obj = state.objects[objId];
      let card = obj ? frCardGet(obj.cardId) : null;
      if(card && card.types.indexOf("Land") !== -1) {
        actions.push({ type: "playLand", player: priority, objectId: objId });
      }
    }
  }

  let sorcerySpeedTypes = ["Creature", "Sorcery", "Enchantment", "Artifact"];
  for(let i = 0; i < pl.hand.length; i++) {
    let objId = pl.hand[i];
    let obj = state.objects[objId];
    let card = obj ? frCardGet(obj.cardId) : null;
    if(!card || card.types.indexOf("Land") !== -1) continue;
    let isSorcerySpeed = false;
    for(let t = 0; t < card.types.length; t++) {
      if(sorcerySpeedTypes.indexOf(card.types[t]) !== -1) isSorcerySpeed = true;
    }
    if(isSorcerySpeed && !(priority === state.activePlayer && mainPhase && emptyStack)) continue;
    let parsedCost = frManaParseCost(card.manaCost);
    if(frManaCanPay(pl.manaPool, parsedCost)) {
      if(frCardNeedsTarget(card)) {
        let tg = frLegalTargetsForSpell(state, card, priority);
        for(let ti = 0; ti < tg.length; ti++) {
          actions.push({ type: "castSpell", player: priority, objectId: objId, target: tg[ti] });
        }
      } else {
        actions.push({ type: "castSpell", player: priority, objectId: objId });
      }
    }
  }

  for(let i = 0; i < state.battlefield.length; i++) {
    let objId = state.battlefield[i];
    let obj = state.objects[objId];
    if(!obj || obj.controller !== priority || obj.tapped) continue;
    let card = frCardGet(obj.cardId);
    if(!card) continue;
    if(card.id === "faceted-ember-core") {
      if(frManaCanPay(pl.manaPool, frManaParseCost("\{3}"))) {
        let tg = frLegalAbilityTargets(state, priority);
        for(let ti = 0; ti < tg.length; ti++) {
          actions.push({ type: "activateAbility", player: priority, objectId: objId, target: tg[ti] });
        }
      }
      continue;
    }
    let color = frManaAbilityColor(obj.cardId);
    if(!color) continue;
    if(card.types.indexOf("Creature") !== -1 && obj.summoningSickness) continue;
    actions.push({ type: "activateAbility", player: priority, objectId: objId });
  }

  for(let i = 0; i < state.battlefield.length; i++) {
    let o = state.objects[state.battlefield[i]];
    if(!o || o.zone !== "battlefield" || o.controller !== priority || o.tapped) continue;
    if(frManaAbilityColor(o.cardId)) continue;
    actions.push({ type: "tapPermanent", player: priority, objectId: o.id });
  }

  if(state.step === "declare_attackers" && priority === state.activePlayer) {
    let atk = frLegalAttackerActions(state, priority);
    for(let i = 0; i < atk.length; i++) actions.push(atk[i]);
  }
  if(state.step === "declare_blockers" && priority !== state.activePlayer) {
    let blk = frLegalBlockerActions(state, priority);
    for(let i = 0; i < blk.length; i++) actions.push(blk[i]);
  }

  return actions;


// =====================================================================
// ART PAYLOAD (glyphs, fronts, back, symbols, numerals, ui, gems -- from ../game-assets'
// five-realms family)
// =====================================================================
//
// frInitPayload() lazily populates window.FIVE_REALMS_PAYLOAD exactly once, mirroring
// initCardDeck() (card-deck-plugin/lists.txt:29-44, in turn citing
// examples/wheel-plugin/lists.txt:118 for the lazy-init-a-window-global guard and
// examples/wheel-plugin/lists.txt:348-352,355 for a bulk vendored/generated literal
// assigned inside a plain window.NAME = {...} in one JS statement). The object literal
// below is copied BYTE-FOR-BYTE from game-assets/build/perchance/five-realms-payload.js
// -- only the `const NAME =` wrapper differs -- and that source file states its own
// rebuild is proven "52/52 reconstructed byte-identical" by that repo's
// tools/verify_payload.py before this file ever saw it. Do not hand-edit the object
// literal below; regenerate it in game-assets and re-paste.
//
// 52 assets (B11, grown from B8's original 12) --
//   glyphs (5): glyph-solara/verdant/tide/ember/umbra -- colourless still has NO glyph
//     asset, see NOTES.md, "Only 5 glyphs, not 6".
//   fronts (14): front-solara/verdant/tide/ember/umbra/colourless (the original 6, each
//     carrying its own k.palette), front-land/gold/artifact (card-class fronts, no
//     k.palette published), and front-basicland-solara/verdant/tide/ember/umbra (no
//     colourless basic land exists). See NOTES.md, "Front selection" for which card gets
//     which, and "No frame assets yet" -- still true: rarity is a gem overlay, not a
//     frame variant.
//   back (1): the card back, unchanged since B8.
//   symbols (6): symbol-solara/verdant/tide/ember/umbra/colourless -- cost-size mana
//     symbols, one per realm plus colourless.
//   numerals (12): numeral-0..9, numeral-X, and symbol-tap (the {T} ability-cost glyph;
//     not a mana symbol -- see card-model spec section 1).
//   ui (6): phase-untap/draw/main/combat/end and life-gem -- not consumed by this bucket's
//     renderer; carried through for a future turn/life-tracker consumer.
//   gems (8): gem-marked/vaulted/sovereign/ascendant, each with a "-small" companion for
//     a type-line-sized rendering. Field (basic lands) has no gem -- see frGemForCard.
//
// Every front's own k.safe_areas is read as published, not assumed -- three different
// shapes exist (the original six-plus-gold-plus-artifact shape with ptBox, front-land's
// shape with resourcePip and a taller art window, and the basic-land shape with neither
// and a smaller costArea). Only the original six fronts carry k.palette; front-land,
// front-gold, front-artifact, and every front-basicland-* front do not, so
// frRenderCard's `palette` field is undefined for those -- documented, not patched over.

frInitPayload() =>
  window.FIVE_REALMS_PAYLOAD = {"v":1,"sources":[{"family":"five-realms","style":"glyphs","target_px":40,"view_box":[0,0,200,200],"count":5},{"family":"five-realms","style":"fronts","target_px":48,"view_box":[0,0,300,420],"count":14},{"family":"five-realms","style":"back","target_px":48,"view_box":[0,0,300,420],"count":1},{"family":"five-realms","style":"symbols","target_px":24,"view_box":[0,0,40,40],"count":6},{"family":"five-realms","style":"numerals","target_px":40,"view_box":[0,0,200,200],"count":12},{"family":"five-realms","style":"ui","target_px":32,"view_box":[0,0,50,50],"count":6},{"family":"five-realms","style":"gems","target_px":36,"view_box":[0,0,60,60],"count":8}],"templates":[["<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <radialGradient id=\"fr-glyph-solara-bg\" cx=\"50%\" cy=\"45%\" r=\"65%\">\n      <stop offset=\"0%\" stop-color=\"#FBEFD1\"/>\n      <stop offset=\"100%\" stop-color=\"#E8C877\"/>\n    </radialGradient>\n    <linearGradient id=\"fr-glyph-solara-line\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#B8860B\"/>\n      <stop offset=\"100%\" stop-color=\"#7A5C0E\"/>\n    </linearGradient>\n  </defs>\n\n  <circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"url(#fr-glyph-solara-bg)\" stroke=\"url(#fr-glyph-solara-line)\" stroke-width=\"4\"/>\n  <circle cx=\"100\" cy=\"100\" r=\"86\" fill=\"none\" stroke=\"url(#fr-glyph-solara-line)\" stroke-width=\"2\"/>\n\n  <!-- filigree ticks at compass points -->\n  <g fill=\"url(#fr-glyph-solara-line)\">\n    <circle cx=\"100\" cy=\"16\" r=\"4\"/>\n    <circle cx=\"100\" cy=\"184\" r=\"4\"/>\n    <circle cx=\"16\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"184\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"41\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"41\" cy=\"159\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"159\" r=\"2.5\"/>\n  </g>\n\n  <!-- radiant compass star (8-pointed, alternating long/short rays) -->\n  <g stroke=\"url(#fr-glyph-solara-line)\" stroke-width=\"2.5\" stroke-linejoin=\"round\" fill=\"#FFF7E0\">\n    <path d=\"M100,40 L112,88 L100,100 L88,88 Z\"/>\n    <path d=\"M100,160 L112,112 L100,100 L88,112 Z\"/>\n    <path d=\"M40,100 L88,88 L100,100 L88,112 Z\"/>\n    <path d=\"M160,100 L112,112 L100,100 L112,88 Z\"/>\n    <path d=\"M63,63 L94,89 L100,100 L89,94 Z\" fill=\"#F4D9A0\"/>\n    <path d=\"M137,137 L106,111 L100,100 L111,106 Z\" fill=\"#F4D9A0\"/>\n    <path d=\"M63,137 L89,106 L100,100 L94,111 Z\" fill=\"#F4D9A0\"/>\n    <path d=\"M137,63 L111,94 L100,100 L106,89 Z\" fill=\"#F4D9A0\"/>\n  </g>\n\n  <circle cx=\"100\" cy=\"100\" r=\"14\" fill=\"#FFF7E0\" stroke=\"url(#fr-glyph-solara-line)\" stroke-width=\"3\"/>\n  <circle cx=\"100\" cy=\"100\" r=\"6\" fill=\"url(#fr-glyph-solara-line)\"/>\n</svg>\n"],["<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <radialGradient id=\"fr-glyph-verdant-bg\" cx=\"50%\" cy=\"45%\" r=\"65%\">\n      <stop offset=\"0%\" stop-color=\"#E3F0D3\"/>\n      <stop offset=\"100%\" stop-color=\"#A9C98A\"/>\n    </radialGradient>\n    <linearGradient id=\"fr-glyph-verdant-line\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#3B6B35\"/>\n      <stop offset=\"100%\" stop-color=\"#254A22\"/>\n    </linearGradient>\n  </defs>\n\n  <circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"url(#fr-glyph-verdant-bg)\" stroke=\"url(#fr-glyph-verdant-line)\" stroke-width=\"4\"/>\n  <circle cx=\"100\" cy=\"100\" r=\"86\" fill=\"none\" stroke=\"url(#fr-glyph-verdant-line)\" stroke-width=\"2\"/>\n\n  <g fill=\"url(#fr-glyph-verdant-line)\">\n    <circle cx=\"100\" cy=\"16\" r=\"4\"/>\n    <circle cx=\"100\" cy=\"184\" r=\"4\"/>\n    <circle cx=\"16\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"184\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"41\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"41\" cy=\"159\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"159\" r=\"2.5\"/>\n  </g>\n\n  <!-- spiral vine stem -->\n  <path d=\"M100,150 C60,150 55,110 85,100 C105,93 100,70 78,72 C60,74 58,92 72,96\"\n        fill=\"none\" stroke=\"url(#fr-glyph-verdant-line)\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n\n  <!-- three leaves along the vine -->\n  <g stroke=\"url(#fr-glyph-verdant-line)\" stroke-width=\"2\" fill=\"#CDE6B0\">\n    <path d=\"M100,150 C90,130 108,118 122,128 C118,144 108,152 100,150 Z\"/>\n    <path d=\"M85,100 C68,92 68,72 86,66 C96,80 94,96 85,100 Z\"/>\n    <path d=\"M78,72 C64,66 64,50 80,46 C90,56 90,68 78,72 Z\"/>\n  </g>\n\n  <circle cx=\"100\" cy=\"150\" r=\"4\" fill=\"url(#fr-glyph-verdant-line)\"/>\n</svg>\n"],["<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <radialGradient id=\"fr-glyph-tide-bg\" cx=\"50%\" cy=\"45%\" r=\"65%\">\n      <stop offset=\"0%\" stop-color=\"#DCF1F1\"/>\n      <stop offset=\"100%\" stop-color=\"#8FC4D6\"/>\n    </radialGradient>\n    <linearGradient id=\"fr-glyph-tide-line\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#1B5A78\"/>\n      <stop offset=\"100%\" stop-color=\"#12374A\"/>\n    </linearGradient>\n  </defs>\n\n  <circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"url(#fr-glyph-tide-bg)\" stroke=\"url(#fr-glyph-tide-line)\" stroke-width=\"4\"/>\n  <circle cx=\"100\" cy=\"100\" r=\"86\" fill=\"none\" stroke=\"url(#fr-glyph-tide-line)\" stroke-width=\"2\"/>\n\n  <g fill=\"url(#fr-glyph-tide-line)\">\n    <circle cx=\"100\" cy=\"16\" r=\"4\"/>\n    <circle cx=\"100\" cy=\"184\" r=\"4\"/>\n    <circle cx=\"16\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"184\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"41\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"41\" cy=\"159\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"159\" r=\"2.5\"/>\n  </g>\n\n  <!-- nautilus spiral -->\n  <path d=\"M100,100\n           m0,-38\n           a38,38 0 1 1 -27,65\n           a27,27 0 1 1 19,-46\n           a17,17 0 1 1 -12,29\n           a8,8 0 1 1 6,-14\"\n        fill=\"none\" stroke=\"url(#fr-glyph-tide-line)\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n\n  <!-- flanking wave crests -->\n  <path d=\"M40,140 C55,130 65,150 80,140\" fill=\"none\" stroke=\"url(#fr-glyph-tide-line)\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n  <path d=\"M120,150 C135,140 145,160 160,150\" fill=\"none\" stroke=\"url(#fr-glyph-tide-line)\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n\n  <circle cx=\"100\" cy=\"62\" r=\"4\" fill=\"url(#fr-glyph-tide-line)\"/>\n</svg>\n"],["<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <radialGradient id=\"fr-glyph-ember-bg\" cx=\"50%\" cy=\"45%\" r=\"65%\">\n      <stop offset=\"0%\" stop-color=\"#FBDFC7\"/>\n      <stop offset=\"100%\" stop-color=\"#E4967D\"/>\n    </radialGradient>\n    <linearGradient id=\"fr-glyph-ember-line\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#8C2E1C\"/>\n      <stop offset=\"100%\" stop-color=\"#5C1712\"/>\n    </linearGradient>\n  </defs>\n\n  <circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"url(#fr-glyph-ember-bg)\" stroke=\"url(#fr-glyph-ember-line)\" stroke-width=\"4\"/>\n  <circle cx=\"100\" cy=\"100\" r=\"86\" fill=\"none\" stroke=\"url(#fr-glyph-ember-line)\" stroke-width=\"2\"/>\n\n  <g fill=\"url(#fr-glyph-ember-line)\">\n    <circle cx=\"100\" cy=\"16\" r=\"4\"/>\n    <circle cx=\"100\" cy=\"184\" r=\"4\"/>\n    <circle cx=\"16\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"184\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"41\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"41\" cy=\"159\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"159\" r=\"2.5\"/>\n  </g>\n\n  <!-- faceted crystalline flame, angular not curvy -->\n  <polygon points=\"100,44 118,90 108,88 122,120 100,112 78,120 92,88 82,90\"\n           fill=\"#F6C68F\" stroke=\"url(#fr-glyph-ember-line)\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n  <polygon points=\"100,112 116,124 106,150 100,156 94,150 84,124\"\n           fill=\"#F0A876\" stroke=\"url(#fr-glyph-ember-line)\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n  <line x1=\"100\" y1=\"60\" x2=\"100\" y2=\"150\" stroke=\"url(#fr-glyph-ember-line)\" stroke-width=\"1.5\" opacity=\"0.5\"/>\n\n  <circle cx=\"100\" cy=\"150\" r=\"3.5\" fill=\"url(#fr-glyph-ember-line)\"/>\n</svg>\n"],["<svg viewBox=\"0 0 200 200\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <radialGradient id=\"fr-glyph-umbra-bg\" cx=\"50%\" cy=\"45%\" r=\"65%\">\n      <stop offset=\"0%\" stop-color=\"#DCD4E8\"/>\n      <stop offset=\"100%\" stop-color=\"#9686AF\"/>\n    </radialGradient>\n    <linearGradient id=\"fr-glyph-umbra-line\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#3A2947\"/>\n      <stop offset=\"100%\" stop-color=\"#1E1526\"/>\n    </linearGradient>\n  </defs>\n\n  <circle cx=\"100\" cy=\"100\" r=\"96\" fill=\"url(#fr-glyph-umbra-bg)\" stroke=\"url(#fr-glyph-umbra-line)\" stroke-width=\"4\"/>\n  <circle cx=\"100\" cy=\"100\" r=\"86\" fill=\"none\" stroke=\"url(#fr-glyph-umbra-line)\" stroke-width=\"2\"/>\n\n  <g fill=\"url(#fr-glyph-umbra-line)\">\n    <circle cx=\"100\" cy=\"16\" r=\"4\"/>\n    <circle cx=\"100\" cy=\"184\" r=\"4\"/>\n    <circle cx=\"16\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"184\" cy=\"100\" r=\"4\"/>\n    <circle cx=\"41\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"41\" r=\"2.5\"/>\n    <circle cx=\"41\" cy=\"159\" r=\"2.5\"/>\n    <circle cx=\"159\" cy=\"159\" r=\"2.5\"/>\n  </g>\n\n  <!-- crescent moon -->\n  <path d=\"M115,50 A50,50 0 1 0 115,150 A38,38 0 1 1 115,50 Z\"\n        fill=\"#4B3A5C\" stroke=\"url(#fr-glyph-umbra-line)\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n\n  <!-- thorned vine wrapping the crescent -->\n  <path d=\"M60,60 C50,90 50,110 60,140 C68,155 90,158 108,150\"\n        fill=\"none\" stroke=\"url(#fr-glyph-umbra-line)\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n  <g stroke=\"url(#fr-glyph-umbra-line)\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n    <line x1=\"53\" y1=\"80\" x2=\"42\" y2=\"76\"/>\n    <line x1=\"51\" y1=\"100\" x2=\"40\" y2=\"100\"/>\n    <line x1=\"53\" y1=\"120\" x2=\"42\" y2=\"124\"/>\n    <line x1=\"66\" y1=\"138\" x2=\"60\" y2=\"148\"/>\n  </g>\n\n  <circle cx=\"60\" cy=\"60\" r=\"3.5\" fill=\"url(#fr-glyph-umbra-line)\"/>\n</svg>\n"],["<svg viewBox=\"0 0 300 420\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"","\">\n  <defs>\n    <linearGradient id=\"","\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"","\"/><stop offset=\"100%\" stop-color=\"","\"/>\n    </linearGradient>\n    <linearGradient id=\"","\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"","\"/><stop offset=\"100%\" stop-color=\"","\"/>\n    </linearGradient>\n  </defs>\n\n  <rect width=\"300\" height=\"420\" rx=\"16\" fill=\"","\"/>\n  <rect x=\"10\" y=\"10\" width=\"280\" height=\"400\" rx=\"10\" fill=\"","\" stroke=\"","\" stroke-width=\"2\"/>\n\n  <rect x=\"20\" y=\"20\" width=\"260\" height=\"28\" rx=\"6\" fill=\"","\" stroke=\"","\" stroke-width=\"2\"/>\n\n  <circle cx=\"270\" cy=\"34\" r=\"17\" fill=\"","\" stroke=\"","\" stroke-width=\"2.5\"/>\n  <path d=\"M273,25 A9,9 0 1 0 273,43 A7,7 0 1 1 273,25 Z\" fill=\"","\"/>\n\n  <rect x=\"20\" y=\"54\" width=\"260\" height=\"150\" fill=\"","\" stroke=\"","\" stroke-width=\"2.5\"/>\n\n  <rect x=\"20\" y=\"210\" width=\"260\" height=\"24\" rx=\"4\" fill=\"","\" stroke=\"","\" stroke-width=\"2\"/>\n\n  <rect x=\"20\" y=\"240\" width=\"260\" height=\"130\" rx=\"4\" fill=\"","\" stroke=\"","\" stroke-width=\"2\"/>\n\n  <circle cx=\"270\" cy=\"392\" r=\"16\" fill=\"","\" stroke=\"","\" stroke-width=\"2.5\"/>\n\n  <g transform=\"translate(38,392)\" opacity=\"0.55\">\n    <circle r=\"14\" fill=\"none\" stroke=\"","\" stroke-width=\"1.5\"/>\n    <path d=\"M3,-9 A9,9 0 1 0 3,9 A7,7 0 1 1 3,-9 Z\" fill=\"","\"/>\n  </g>\n</svg>\n"],["<svg viewBox=\"0 0 300 420\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Five Realms Land card front\">\n  <defs>\n    <linearGradient id=\"fr-front-land-border\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#D9C49C\"/><stop offset=\"100%\" stop-color=\"#6B4A2B\"/>\n    </linearGradient>\n    <linearGradient id=\"fr-front-land-line\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#6B4A2B\"/><stop offset=\"100%\" stop-color=\"#4A3018\"/>\n    </linearGradient>\n  </defs>\n\n  <rect width=\"300\" height=\"420\" rx=\"16\" fill=\"url(#fr-front-land-border)\"/>\n  <rect x=\"10\" y=\"10\" width=\"280\" height=\"400\" rx=\"10\" fill=\"#EFE4CB\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"2\"/>\n\n  <!-- title bar -->\n  <rect x=\"20\" y=\"20\" width=\"260\" height=\"28\" rx=\"6\" fill=\"#D9C49C\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"2\"/>\n\n  <!-- tap-for-resource icon (no mana cost on lands) -->\n  <circle cx=\"270\" cy=\"34\" r=\"17\" fill=\"#FAF3E1\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"2.5\"/>\n  <path d=\"M262,42 L278,26 M266,26 L278,26 L278,38\"\n        fill=\"none\" stroke=\"#6B4A2B\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n\n  <!-- art window (full bleed, taller — lands favor landscape art) -->\n  <rect x=\"20\" y=\"54\" width=\"260\" height=\"182\" fill=\"#C9B182\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"2.5\"/>\n\n  <!-- type line -->\n  <rect x=\"20\" y=\"242\" width=\"260\" height=\"24\" rx=\"4\" fill=\"#D9C49C\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"2\"/>\n\n  <!-- rules text box (shorter — lands usually hold one tap ability line) -->\n  <rect x=\"20\" y=\"272\" width=\"260\" height=\"98\" rx=\"4\" fill=\"#FAF3E1\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"2\"/>\n\n  <!-- resource pip bottom-left: slot for realm icon this land produces -->\n  <circle cx=\"38\" cy=\"392\" r=\"16\" fill=\"#FAF3E1\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"2.5\"/>\n\n  <!-- land watermark: mountain/terrain motif -->\n  <g transform=\"translate(270,392)\" opacity=\"0.5\">\n    <circle r=\"14\" fill=\"none\" stroke=\"url(#fr-front-land-line)\" stroke-width=\"1.5\"/>\n    <path d=\"M-9,4 L-3,-6 L2,1 L6,-4 L9,4 Z\" fill=\"#6B4A2B\"/>\n  </g>\n</svg>\n"],["<svg viewBox=\"0 0 300 420\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Five Realms Gold card front\">\n  <defs>\n    <linearGradient id=\"fr-front-gold-border\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#F6E6B4\"/>\n      <stop offset=\"100%\" stop-color=\"#A9791A\"/>\n    </linearGradient>\n    <linearGradient id=\"fr-front-gold-line\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#A9791A\"/><stop offset=\"100%\" stop-color=\"#6E4E0F\"/>\n    </linearGradient>\n    <!-- iridescent sliver blending all 5 realm hues, used only as thin accent -->\n    <linearGradient id=\"fr-front-gold-iris\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n      <stop offset=\"0%\" stop-color=\"#E8C877\"/>\n      <stop offset=\"25%\" stop-color=\"#8FC4D6\"/>\n      <stop offset=\"50%\" stop-color=\"#A9C98A\"/>\n      <stop offset=\"75%\" stop-color=\"#E4967D\"/>\n      <stop offset=\"100%\" stop-color=\"#9686AF\"/>\n    </linearGradient>\n  </defs>\n\n  <rect width=\"300\" height=\"420\" rx=\"16\" fill=\"url(#fr-front-gold-border)\"/>\n  <rect x=\"10\" y=\"10\" width=\"280\" height=\"400\" rx=\"10\" fill=\"#FBF2D6\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"2\"/>\n\n  <!-- iridescent accent strip just inside the outer border, hints at multiple realms -->\n  <rect x=\"14\" y=\"14\" width=\"272\" height=\"392\" rx=\"8\" fill=\"none\" stroke=\"url(#fr-front-gold-iris)\" stroke-width=\"2\" opacity=\"0.85\"/>\n\n  <!-- title bar -->\n  <rect x=\"20\" y=\"20\" width=\"260\" height=\"28\" rx=\"6\" fill=\"#EBD8A0\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"2\"/>\n\n  <!-- split cost gem: two-tone wedge representing hybrid/multicolor cost -->\n  <circle cx=\"270\" cy=\"34\" r=\"17\" fill=\"#FFF8E6\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"2.5\"/>\n  <path d=\"M270,17 A17,17 0 0 1 270,51 Z\" fill=\"#E4967D\" opacity=\"0.85\"/>\n  <path d=\"M270,17 A17,17 0 0 0 270,51 Z\" fill=\"#8FC4D6\" opacity=\"0.85\"/>\n  <line x1=\"270\" y1=\"17\" x2=\"270\" y2=\"51\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"1.5\"/>\n\n  <!-- art window -->\n  <rect x=\"20\" y=\"54\" width=\"260\" height=\"150\" fill=\"#E1CE94\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"2.5\"/>\n\n  <!-- type line -->\n  <rect x=\"20\" y=\"210\" width=\"260\" height=\"24\" rx=\"4\" fill=\"#EBD8A0\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"2\"/>\n\n  <!-- rules text box -->\n  <rect x=\"20\" y=\"240\" width=\"260\" height=\"130\" rx=\"4\" fill=\"#FFF8E6\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"2\"/>\n\n  <!-- bottom stat gem -->\n  <circle cx=\"270\" cy=\"392\" r=\"16\" fill=\"#FFF8E6\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"2.5\"/>\n\n  <!-- multicolor watermark: five small dots orbiting a gold core -->\n  <g transform=\"translate(38,392)\" opacity=\"0.6\">\n    <circle r=\"14\" fill=\"none\" stroke=\"url(#fr-front-gold-line)\" stroke-width=\"1.5\"/>\n    <circle cx=\"0\" cy=\"-9\" r=\"2.4\" fill=\"#E8C877\"/>\n    <circle cx=\"8.5\" cy=\"-2.7\" r=\"2.4\" fill=\"#E4967D\"/>\n    <circle cx=\"5.3\" cy=\"7.3\" r=\"2.4\" fill=\"#8FC4D6\"/>\n    <circle cx=\"-5.3\" cy=\"7.3\" r=\"2.4\" fill=\"#9686AF\"/>\n    <circle cx=\"-8.5\" cy=\"-2.7\" r=\"2.4\" fill=\"#A9C98A\"/>\n  </g>\n</svg>\n"],["<svg viewBox=\"0 0 300 420\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"Five Realms Artifact card front\">\n  <defs>\n    <linearGradient id=\"fr-front-artifact-border\