  let ehSick = fxPut(sEhSick, "ember-hound", 0);
  sEhSick.objects[ehSick].summoningSickness = true;
  let rEhSick = frActionActivateAbility(sEhSick, { type: "activateAbility", player: 0, objectId: ehSick, abilityName: "snap", targets: [0] });
  push("activate ember-hound with summoning sickness: rejected, nothing paid",
    rEhSick.lastActionError === "summoning sickness prevents activating a tap ability" &&
      rEhSick.stack.length === 0 && rEhSick.players[0].manaPool.C === 1,
