"k":{"tier":"Vaulted","size":"small"}},{"i":"gem-sovereign","n":"Sovereign rarity gem","t":30,"f":[],"k":{"tier":"Sovereign","size":"full"}},{"i":"gem-sovereign-small","n":"Sovereign rarity gem (small)","t":28,"f":[399,5],"k":{"tier":"Sovereign","size":"small"}},{"i":"gem-ascendant","n":"Ascendant rarity gem","t":31,"f":[],"k":{"tier":"Ascendant","size":"full"}},{"i":"gem-ascendant-small","n":"Ascendant rarity gem (small)","t":32,"f":[],"k":{"tier":"Ascendant","size":"small"}}]};
// Rebuilds one asset's SVG text from the template + string-pool payload. Identical logic
// to cardDeckBuild (card-deck-plugin/lists.txt:52-58); mirrors game-assets'
// tools/verify_payload.py reconstruct() exactly.

frAssetBuild(asset) =>
  let chunks = window.FIVE_REALMS_PAYLOAD.templates[asset.t];
  let out = chunks[0];
  for(let i = 0; i < asset.f.length; i++) {
    out += window.FIVE_REALMS_PAYLOAD.strings[asset.f[i]] + chunks[i + 1];
  }
  return out;

frAssetGet(id) =>
  if(!window.FIVE_REALMS_PAYLOAD) frInitPayload();
  for(let a of window.FIVE_REALMS_PAYLOAD.assets) {
    if(a.i === id) return a;
  }
  return null;

frAssetList() =>
  if(!window.FIVE_REALMS_PAYLOAD) frInitPayload();
  return window.FIVE_REALMS_PAYLOAD.assets.map(a => a.i);


// =====================================================================
// RENDERER
// =====================================================================
//
// A rendered card is bare SVG plus a rects/text data envelope, NOT a composed HTML
// fragment -- see NOTES.md, "Renderer output shape", for the reasoning. frRenderCard
// resolves a card id (or an already-fetched card record) to: its front SVG (realm, card
// class, or basic-land front -- see frFrontAssetId just below); its realm glyph SVG (null
// for a colourless card, or for any glyph the payload does not carry -- no synthesised
// substitute, see NOTES.md); its rarity gem SVG, full-size and type-line-sized (null for
// `Field` or any unrecognised rarity -- see frGemForCard); the safe-area rects a consumer
// positions text over, in the front's 300x420 view box, straight from the payload's own
// asset.k.safe_areas (three different shapes exist across the fronts -- read, never
// assumed, see the ART PAYLOAD banner comment above); the front's asset.k.palette, so any
// HTML the consumer composes can match ink to the pre-coloured front rather than guessing
// at colours (undefined for the four fronts that publish no palette -- again, see above);
// and the card's mana cost broken into an ordered, per-symbol asset array (see
// frCostSymbols) for a consumer to lay across the title bar, since the front's single
// costArea circle cannot hold more than one symbol -- see NOTES.md, "Multi-symbol mana
// cost is still a layout gap, not solved here". `rarity` and `frame` are passed through
// on the returned `card` for the consumer to read.

// frFrontAssetId resolves which of the 14 front assets a card renders on. This is a
// judgement call, not something the card-model spec fixes (it only fixes `glyph`,
// `types`, `colors`/`colorIdentity`, and rarity) -- see NOTES.md, "Front selection
// precedence", for the full reasoning. Precedence, highest first:
//   1. Basic land -- `card.cardClass === "basicland"` (an explicit tag a future basic-land
//      card record may carry, matching the asset payload's own `k.cardClass` spelling) OR
//      `card.rarity === "Field"` (the card-model spec's own class marker, section 2: Field
//      IS the basic-land card class). Picks `front-basicland-<realm>` when `card.glyph` is
//      one of the five realms; there is no basicland-colourless asset, so a colourless or
//      unrecognised glyph falls through to `front-land` instead of throwing.
//   2. Any other `Land` type -> `front-land`.
//   3. Multicolour (`colors`, or `colorIdentity` if `colors` is absent, has 2+ entries) ->
//      `front-gold`. This un-defers the card-model spec's section 3 note that "multicolour
//      glyph rendering... is explicitly deferred" -- see NOTES.md for why this bucket
//      treats that deferral as closed rather than still-open.
//   4. A colourless `Artifact` (no realm colours at all) -> `front-artifact`.
//   5. Otherwise, the existing per-realm/colourless front -> `front-<glyph>`.
frFrontAssetId(card) =>
  let isBasicLand = card.cardClass === "basicland" || card.rarity === "Field";
  if(isBasicLand) {
    let realm = card.glyph;
    if(realm && frRealmList().indexOf(realm) !== -1) {
      return "front-basicland-" + realm;
    }
    return "front-land";
  }
  let types = Array.isArray(card.types) ? card.types : [];
  if(types.indexOf("Land") !== -1) {
    return "front-land";
  }
  let colors = Array.isArray(card.colors)
    ? card.colors
    : (Array.isArray(card.colorIdentity) ? card.colorIdentity : []);
  if(colors.length >= 2) {
    return "front-gold";
  }
  if(types.indexOf("Artifact") !== -1 && colors.length === 0) {
    return "front-artifact";
  }
  return "front-" + card.glyph;

// frGemAssetIdForRarity/frGemForCard resolve a rarity tier to its gem asset id, per the
// card-model spec section 2's tier table. `Field` (basic lands) and any rarity string this
// plugin doesn't recognise both resolve to null -- a valid, non-throwing answer, not a
// missing-asset bug. This plugin's five tier names (Field, Marked, Vaulted, Sovereign,
// Ascendant) are the only rarity vocabulary this file's own authored text ever emits --
// see NOTES.md for the locked decision behind that and a documented, unavoidable exception
// inside the copied-verbatim art payload itself.
frGemAssetIdForRarity(rarity) =>
  let map = {
    Marked: "gem-marked",
    Vaulted: "gem-vaulted",
    Sovereign: "gem-sovereign",
    Ascendant: "gem-ascendant"
  };
  return map[rarity] || null;

frGemForCard(cardOrId) =>
  let card = (typeof cardOrId === "string") ? frCardGet(cardOrId) : cardOrId;
  if(!card || typeof card !== "object" || typeof card.rarity !== "string") {
    return null;
  }
  return frGemAssetIdForRarity(card.rarity);

// frManaColorAssetMap: the one color-letter -> cost-symbol-asset lookup shared by
// frCostSymbols and $output("gem"/"cost", ...). Kept as its own function (rather than a
// bare object literal duplicated at each call site) so there is exactly one place that
// encodes "W -> solara" etc.
frManaColorAssetMap() =>
  return { W: "symbol-solara", U: "symbol-tide", B: "symbol-umbra", R: "symbol-ember", G: "symbol-verdant", C: "symbol-colourless" };

// frCostSymbols parses a manaCost string (via the existing frManaParseCost -- the grammar
// is not re-derived here) into an ORDERED array of { symbol, assetId, svg } entries, left
// to right, one per brace-delimited symbol in the original cost string. This is the point
// of the B11 asset grant: the front has exactly one 34x34 costArea circle, which cannot
// hold a multi-symbol cost like "{1}{R}{R}" (three symbols) -- returning an ordered array
// lets a consumer lay them out itself. NOT solved here -- see NOTES.md, "Multi-symbol mana
// cost is still a layout gap, not solved here".
//
// Mapping: generic {N} for 0<=N<=9 -> numeral-N; a multi-digit generic (no single asset
// covers e.g. "12") -> assetId null with a `parts` array of each digit's numeral asset,
// same non-fabrication rule as hybrids, below. {X} -> numeral-X. {C} and a coloured {W/
// U/B/R/G} -> the matching symbol-<realm> asset via frManaColorAssetMap. A hybrid symbol
// (colored/colored or generic/colored) has NO single asset in the payload -- per this
// bucket's instructions, this returns assetId: null and a `parts` array of the component
// asset ids, rather than fabricating a hybrid asset that doesn't exist.
//
// Never throws: frManaParseCost throws on `{T}` or any malformed cost string (by design,
// see the MANA section above); frCostSymbols catches that and returns [] rather than
// propagating, matching every other op's "readable placeholder, not an exception" contract.
frCostSymbols(costStr) =>
  let colorAsset = frManaColorAssetMap();
  let parsed;
  try {
    parsed = frManaParseCost(costStr);
  } catch(e) {
    return [];
  }
  let out = [];
  for(let i = 0; i < parsed.symbols.length; i++) {
    let sym = parsed.symbols[i];
    let entry = { symbol: null, assetId: null, svg: null };
    if(sym.kind === "generic") {
      entry.symbol = "{" + sym.n + "}";
      if(sym.n >= 0 && sym.n <= 9) {
        entry.assetId = "numeral-" + sym.n;
      } else {
        entry.parts = String(sym.n).split("").map((d) => "numeral-" + d);
      }
    } else if(sym.kind === "variable") {
      entry.symbol = "{X}";
      entry.assetId = "numeral-X";
    } else if(sym.kind === "colorless") {
      entry.symbol = "{C}";
      entry.assetId = colorAsset.C;
    } else if(sym.kind === "colored") {
      entry.symbol = "{" + sym.color + "}";
      entry.assetId = colorAsset[sym.color] || null;
    } else if(sym.kind === "hybridColored") {
      entry.symbol = "{" + sym.options.join("/") + "}";
      entry.parts = sym.options.map((c) => colorAsset[c] || null);
    } else if(sym.kind === "hybridGeneric") {
      entry.symbol = "{" + sym.n + "/" + sym.color + "}";
      entry.parts = [
        (sym.n >= 0 && sym.n <= 9) ? ("numeral-" + sym.n) : null,
        colorAsset[sym.color] || null
      ];
    } else {
      entry.symbol = "{?}";
    }
    if(entry.assetId) {
      let asset = frAssetGet(entry.assetId);
      entry.svg = asset ? frAssetBuild(asset) : null;
    }
    out.push(entry);
  }
  return out;

frRenderCard(cardOrId) =>
  let card = (typeof cardOrId === "string") ? frCardGet(cardOrId) : cardOrId;
  if(!card || typeof card !== "object" || !card.glyph) {
    return "(unknown card id: " + String(cardOrId) + ")";
  }
  let realm = card.glyph;
  let frontId = frFrontAssetId(card);
  let frontAsset = frAssetGet(frontId);
  if(!frontAsset) {
    return "(unknown realm: " + String(realm) + ")";
  }
  let frontSvg = frAssetBuild(frontAsset);
  let glyphSvg = null;
  if(realm !== "colourless") {
    let glyphAsset = frAssetGet("glyph-" + realm);
    if(glyphAsset) glyphSvg = frAssetBuild(glyphAsset);
  }
  let gemId = frGemForCard(card);
  let gemSvg = null;
  let gemSmallSvg = null;
  if(gemId) {
    let gemAsset = frAssetGet(gemId);
    if(gemAsset) gemSvg = frAssetBuild(gemAsset);
    let gemSmallAsset = frAssetGet(gemId + "-small");
    if(gemSmallAsset) gemSmallSvg = frAssetBuild(gemSmallAsset);
  }
  let costSymbols = card.manaCost ? frCostSymbols(card.manaCost) : [];
  return {
    card: card,
    typeLine: frCardTypeLine(card),
    imageUrl: card.image || null,
    frontSvg: frontSvg,
    glyphSvg: glyphSvg,
    gemSvg: gemSvg,
    gemSmallSvg: gemSmallSvg,
    rects: frontAsset.k.safe_areas,
    palette: frontAsset.k.palette,
    costSymbols: costSymbols
  };


// =====================================================================
// FIXTURE TESTS (X-COST ENGINE + MULTI-COLOR MANA + MULTI-TARGET/MODAL)
// =====================================================================
//
// A self-contained harness for the mana/casting engine, runnable on the plugin's
// own page: `frSelfTest()` returns { total, failed, results } with one { name, ok, detail }
// per assertion. It exercises frManaParseCost's xCount, frManaTryPay's x handling
// (including dual-{X} and validation), and the full frActionCastSpell path for the X-cost
// fixtures (solara-benediction, tide-vortex, ember-conflagration, umbra-life-drain): a
// free X=0 cast, an X=2 cast, an unaffordable chosen X, and an instant cast at instant
// timing (non-active player holding priority). It also exercises the multi-color mana
// engine (#2) via the WU dual luminous-lagoon and the {C} producer prismatic-core: a W
// tap, a U tap after untap, the still-tapped rejection, an invalid chosenColor rejection,
// the missing-chosenColor rejection, the two chosenColor actions frLegalActions offers,
// and {C} colorless production. The multi-target/modal section (#3) covers the
// data-driven targeting model: twin-dart (two distinct creatures), cinder-bolt ("any
// target" -- player or creature), ember-reckoning (modal, one mode rejected, target-slot
// rejection, both resolutions), withering-grasp's toughness filter, and the per-mode
// target-set enumeration frLegalActions emits. Not part of the $output op surface -- it
// is an internal self-test, left in for consumers and CI to run.

frSelfTest() =>
  let results = [];
  let push = (name, ok, detail) => results.push({ name: name, ok: !!ok, detail: detail === undefined ? "" : detail });

  // -- representation -------------------------------------------------
  let p1 = frManaParseCost("\{X}\{R}");
  push("parse {X}{R}: xCount 1, cmc 1",
    p1.xCount === 1 && p1.cmc === 1 && p1.symbols.length === 2,
    "got xCount=" + p1.xCount + " cmc=" + p1.cmc);
  let p2 = frManaParseCost("\{X}\{X}\{U}");
  push("parse {X}{X}{U}: xCount 2, cmc 1 (dual-X, cmc counts X as 0)",
    p2.xCount === 2 && p2.cmc === 1,
    "got xCount=" + p2.xCount + " cmc=" + p2.cmc);
  let p3 = frManaParseCost("\{1}\{W}");
  push("parse {1}{W}: xCount 0 (non-X unchanged)",
    p3.xCount === 0 && p3.cmc === 2,
    "got xCount=" + p3.xCount + " cmc=" + p3.cmc);

  // -- payment --------------------------------------------------------
  let pool = { W: 0, U: 0, B: 0, R: 1, G: 0, C: 3 };
  let pay0 = frManaTryPay(pool, p1, 0);
  push("pay {X}{R} x=0: {R}{C}{C}{C} -> ok, {C}{C}{C} left",
    pay0.ok && pay0.pool.C === 3 && pay0.pool.R === 0,
    "ok=" + pay0.ok + " pool=" + JSON.stringify(pay0.pool));
  let pay2 = frManaTryPay(pool, p1, 2);
  push("pay {X}{R} x=2: {R}{C}{C}{C} -> ok, {C} left",
    pay2.ok && pay2.pool.C === 1 && pay2.pool.R === 0,
    "ok=" + pay2.ok + " pool=" + JSON.stringify(pay2.pool));
  let pay4 = frManaTryPay(pool, p1, 4);
  push("pay {X}{R} x=4: {R}{C}{C}{C} -> unaffordable",
    !pay4.ok,
    "ok=" + pay4.ok);
  let dual = frManaTryPay({ W: 0, U: 1, B: 0, R: 0, G: 0, C: 5 }, p2, 2);
  push("pay {X}{X}{U} x=2: {U}{C}{C}{C}{C}{C} -> ok, {C} left (2x paid)",
    dual.ok && dual.pool.C === 1 && dual.pool.U === 0,
    "ok=" + dual.ok + " pool=" + JSON.stringify(dual.pool));
  let dual2 = frManaTryPay({ W: 0, U: 1, B: 0, R: 0, G: 0, C: 3 }, p2, 2);
  push("pay {X}{X}{U} x=2 with only {U}{C}{C}{C}: unaffordable",
    !dual2.ok,
    "ok=" + dual2.ok);
  let badNeg = frManaTryPay(pool, p1, -1);
  push("pay {X}{R} x=-1: rejected",
    !badNeg.ok,
    "ok=" + badNeg.ok);
  let badFrac = frManaTryPay(pool, p1, 1.5);
  push("pay {X}{R} x=1.5: rejected",
    !badFrac.ok,
    "ok=" + badFrac.ok);
  let badStr = frManaTryPay(pool, p1, "2");
  push("pay {X}{R} x=\"2\": rejected",
    !badStr.ok,
    "ok=" + badStr.ok);
  let omitted = frManaTryPay({ W: 0, U: 0, B: 0, R: 1, G: 0, C: 0 }, p1);
  push("pay {X}{R} x omitted: defaults to 0 (X=0 always legal)",
    omitted.ok && omitted.pool.R === 0,
    "ok=" + omitted.ok + " pool=" + JSON.stringify(omitted.pool));
  let nonX = frManaTryPay({ W: 1, U: 0, B: 0, R: 0, G: 0, C: 1 }, p3, 99);
  push("pay {1}{W} x=99: x ignored on a non-X cost",
    nonX.ok && nonX.pool.W === 0 && nonX.pool.C === 0,
    "ok=" + nonX.ok + " pool=" + JSON.stringify(nonX.pool));

  // -- casting --------------------------------------------------------
  let d0 = ["ember-conflagration","ember-conflagration","ember-conflagration","ember-conflagration","ember-conflagration","ember-conflagration","ember-conflagration"];
  let d1 = ["solara-benediction","solara-benediction","solara-benediction","solara-benediction","ember-conflagration","ember-conflagration","ember-conflagration"];
  let d2 = ["tide-vortex","tide-vortex","tide-vortex","tide-vortex","tide-vortex","tide-vortex","tide-vortex"];
  let base = frGameNew({ seed: 11, decks: [d0, d1, d2] });
  let inHand = (state, player, cardId) => {
    let pl = state.players[player];
    for(let i = 0; i < pl.hand.length; i++) {
      if(state.objects[pl.hand[i]].cardId === cardId) return pl.hand[i];
    }
    return null;
  };
  // the stack zone holds stack entries only; find the spell entry
  let spellEntry = (st) => {
    for(let i = 0; i < st.stack.length; i++) {
      let e = st.stack[i];
      if(e && typeof e === "object" && e.kind === "spell") return e;
    }
    return null;
  };
  let setup = (player, mana, step, active, priority) => {
    let st = frCloneState(base);
    st.players[player].manaPool = mana;
    st.step = step || "precombat_main";
    st.activePlayer = active === undefined ? 0 : active;
    st.priorityPlayer = priority === undefined ? player : priority;
    st.stack = [];
    return st;
  };

  let s0 = setup(0, { W: 0, U: 0, B: 0, R: 1, G: 0, C: 0 });
  let obj0 = inHand(s0, 0, "ember-conflagration");
  let r0 = frActionCastSpell(s0, { type: "castSpell", player: 0, objectId: obj0, x: 0 });
  let e0 = spellEntry(r0);
  push("cast ember-conflagration at X=0 (sorcery, main phase): ok, x exposed on stack",
    r0.lastActionError === null && !!e0 && e0.x === 0 && e0.cardId === "ember-conflagration" &&
      r0.players[0].manaPool.R === 0,
    "error=" + r0.lastActionError + " entry=" + JSON.stringify(e0));

  let s2 = setup(0, { W: 0, U: 0, B: 0, R: 1, G: 0, C: 2 });
  let obj2 = inHand(s2, 0, "ember-conflagration");
  let r2 = frActionCastSpell(s2, { type: "castSpell", player: 0, objectId: obj2, x: 2 });
  let e2 = spellEntry(r2);
  push("cast ember-conflagration at X=2: {R}{C}{C} paid, x=2 on stack",
    r2.lastActionError === null && !!e2 && e2.x === 2 &&
      r2.players[0].manaPool.R === 0 && r2.players[0].manaPool.C === 0,
    "error=" + r2.lastActionError + " entry=" + JSON.stringify(e2));

  let sU = setup(0, { W: 0, U: 0, B: 0, R: 1, G: 0, C: 1 });
  let objU = inHand(sU, 0, "ember-conflagration");
  let rU = frActionCastSpell(sU, { type: "castSpell", player: 0, objectId: objU, x: 3 });
  push("cast ember-conflagration at X=3 with only {R}{C}: rejected, nothing spent",
    rU.lastActionError === "cannot pay mana cost" && rU.stack.length === 0 &&
      rU.players[0].manaPool.R === 1 && rU.players[0].manaPool.C === 1,
    "error=" + rU.lastActionError + " pool=" + JSON.stringify(rU.players[0].manaPool));

  let sBadX = setup(0, { W: 0, U: 0, B: 0, R: 5, G: 0, C: 0 });
  let objBadX = inHand(sBadX, 0, "ember-conflagration");
  let rBadX = frActionCastSpell(sBadX, { type: "castSpell", player: 0, objectId: objBadX, x: -2 });
  push("cast ember-conflagration with x=-2: rejected as invalid",
    rBadX.lastActionError === "x must be a non-negative integer" && rBadX.stack.length === 0,
    "error=" + rBadX.lastActionError);

  let sI = setup(1, { W: 1, U: 0, B: 0, R: 0, G: 0, C: 1 }, "precombat_main", 0, 1);
  let objI = inHand(sI, 1, "solara-benediction");
  let rI = frActionCastSpell(sI, { type: "castSpell", player: 1, objectId: objI, x: 1 });
  let eI = spellEntry(rI);
  push("cast solara-benediction at X=1 at instant timing (player 1, not active): ok",
    rI.lastActionError === null && !!eI && eI.x === 1 &&
      rI.players[1].manaPool.W === 0 && rI.players[1].manaPool.C === 0,
    "error=" + rI.lastActionError + " entry=" + JSON.stringify(eI));

  let sSor = setup(1, { W: 0, U: 0, B: 0, R: 1, G: 0, C: 0 }, "precombat_main", 0, 1);
  let objSor = inHand(sSor, 1, "ember-conflagration");
  let rSor = frActionCastSpell(sSor, { type: "castSpell", player: 1, objectId: objSor, x: 0 });
  push("sorcery X-spell at instant timing: rejected (needs to be the active player)",
    rSor.lastActionError === "sorcery-speed spell requires being the active player" && rSor.stack.length === 0,
    "error=" + rSor.lastActionError);

  let sT = setup(2, { W: 0, U: 1, B: 0, R: 0, G: 0, C: 4 }, "precombat_main", 0, 2);
  let objT = inHand(sT, 2, "tide-vortex");
  let rT = frActionCastSpell(sT, { type: "castSpell", player: 2, objectId: objT, x: 2 });
  let eT = spellEntry(rT);
  push("cast tide-vortex {X}{X}{U} at X=2: {U} + 4 generic paid, x=2 on stack",
    rT.lastActionError === null && !!eT && eT.x === 2 &&
      rT.players[2].manaPool.U === 0 && rT.players[2].manaPool.C === 0,
    "error=" + rT.lastActionError + " entry=" + JSON.stringify(eT));

  // -- legalActions ---------------------------------------------------
  let sL = setup(0, { W: 0, U: 0, B: 0, R: 1, G: 0, C: 2 });
  let legal = frLegalActions(sL);
  let objL = inHand(sL, 0, "ember-conflagration");
  let forObj = legal.filter((a) => a.type === "castSpell" && a.objectId === objL);
  let xs = forObj.map((a) => a.x).sort((a, b) => a - b);
  push("legalActions for ember-conflagration {X}{R} with {R}{C}{C}: offers x=0 and max x=2",
    forObj.length === 2 && xs.length === 2 && xs[0] === 0 && xs[1] === 2,
    "xs=" + JSON.stringify(xs) + " actions=" + JSON.stringify(forObj));

  // -- multi-color mana abilities / dual lands (#2) --------------------
  let dDual = ["luminous-lagoon","luminous-lagoon","luminous-lagoon","luminous-lagoon","luminous-lagoon","luminous-lagoon","luminous-lagoon"];
  let dColor = ["prismatic-core","prismatic-core","prismatic-core","prismatic-core","prismatic-core","prismatic-core","prismatic-core"];
  let baseDual = frGameNew({ seed: 3, decks: [dDual, d1] });
  let baseColor = frGameNew({ seed: 5, decks: [dColor, d1] });
  // play one of player 0's lands onto an empty battlefield in a main phase
  let playLand = (base, cardId) => {
    let st = frCloneState(base);
    st.step = "precombat_main";
    st.activePlayer = 0;
    st.priorityPlayer = 0;
    st.stack = [];
    let objId = inHand(st, 0, cardId);
    let r = frActionPlayLand(st, { type: "playLand", player: 0, objectId: objId });
    return { state: r, objId: r.battlefield[r.battlefield.length - 1], error: r.lastActionError };
  };
  let dl = playLand(baseDual, "luminous-lagoon");
  push("play the WU dual (luminous-lagoon): ok, untapped on the battlefield",
    dl.error === null && dl.objId !== undefined,
    "error=" + dl.error + " objId=" + dl.objId);

  let rDualW = frActionActivateAbility(dl.state, { type: "activateAbility", player: 0, objectId: dl.objId, chosenColor: "W" });
  push("dual taps for W: manaPool.W 1, no bogus 'WU' key, land tapped",
    rDualW.lastActionError === null &&
      rDualW.players[0].manaPool.W === 1 && rDualW.players[0].manaPool.U === 0 &&
      rDualW.players[0].manaPool["WU"] === undefined &&
      rDualW.objects[dl.objId].tapped === true,
    "error=" + rDualW.lastActionError + " pool=" + JSON.stringify(rDualW.players[0].manaPool));

  let rDualTap = frActionActivateAbility(rDualW, { type: "activateAbility", player: 0, objectId: dl.objId, chosenColor: "U" });
  push("dual taps again while still tapped: rejected (tap check kept)",
    rDualTap.lastActionError === "permanent is already tapped" &&
      rDualTap.players[0].manaPool.U === 0,
    "error=" + rDualTap.lastActionError + " pool=" + JSON.stringify(rDualTap.players[0].manaPool));

  let sDualU = frCloneState(rDualW);
  sDualU.objects[dl.objId].tapped = false;
  let rDualU = frActionActivateAbility(sDualU, { type: "activateAbility", player: 0, objectId: dl.objId, chosenColor: "U" });
  push("dual untapped taps for U: manaPool.U 1, W still 1, land tapped",
    rDualU.players[0].manaPool.U === 1 && rDualU.players[0].manaPool.W === 1 &&
      rDualU.objects[dl.objId].tapped === true,
    "error=" + rDualU.lastActionError + " pool=" + JSON.stringify(rDualU.players[0].manaPool));

  let sDualBad = frCloneState(rDualU);
  sDualBad.objects[dl.objId].tapped = false;
  let rDualBad = frActionActivateAbility(sDualBad, { type: "activateAbility", player: 0, objectId: dl.objId, chosenColor: "R" });
  push("dual rejects invalid chosenColor R: error, not tapped, nothing added",
    rDualBad.lastActionError === "chosenColor must be one of: WU" &&
      rDualBad.objects[dl.objId].tapped === false &&
      rDualBad.players[0].manaPool.W === 1 && rDualBad.players[0].manaPool.U === 1 && rDualBad.players[0].manaPool.R === 0,
    "error=" + rDualBad.lastActionError + " pool=" + JSON.stringify(rDualBad.players[0].manaPool));

  let rDualNone = frActionActivateAbility(sDualBad, { type: "activateAbility", player: 0, objectId: dl.objId });
  push("dual without chosenColor: rejected with the produced-color hint",
    rDualNone.lastActionError === "chosenColor must be one of: WU",
    "error=" + rDualNone.lastActionError);

  let dl2 = playLand(baseDual, "luminous-lagoon");
  let legalDual = frLegalActions(dl2.state);
  let dualActs = legalDual.filter((a) => a.type === "activateAbility" && a.objectId === dl2.objId);
  push("legalActions for the WU dual: two actions, chosenColor W and U",
    dualActs.length === 2 && dualActs[0].chosenColor === "W" && dualActs[1].chosenColor === "U",
    "acts=" + JSON.stringify(dualActs));

  let sCol = frCloneState(baseColor);
  let objCol = inHand(sCol, 0, "prismatic-core");
  frZoneMove(sCol, objCol, "hand", "battlefield", 0);
  sCol.step = "precombat_main";
  sCol.activePlayer = 0;
  sCol.priorityPlayer = 0;
  sCol.stack = [];
  sCol.players[0].manaPool = frManaEmptyPool();
  let rCol = frActionActivateAbility(sCol, { type: "activateAbility", player: 0, objectId: objCol });
  push("{C} producer (prismatic-core): taps and adds 1 colorless mana, no chosenColor needed",
    rCol.lastActionError === null && rCol.players[0].manaPool.C === 1 &&
      rCol.players[0].manaPool.W === 0 && rCol.players[0].manaPool["C"] === 1 &&
      rCol.objects[objCol].tapped === true,
    "error=" + rCol.lastActionError + " pool=" + JSON.stringify(rCol.players[0].manaPool));

  // -- multiple targets & modal "Choose one" spells (#3) ---------------
  let dMix = ["twin-dart","cinder-bolt","ember-reckoning","withering-grasp","bramble-warden","bramble-warden","cinderfang-marauder"];
  let baseMix = frGameNew({ seed: 7, decks: [dMix, d1] });
  let inHandAll = (st, player, cardId) => {
    let pl = st.players[player];
    let out = [];
    for(let i = 0; i < pl.hand.length; i++) {
      if(st.objects[pl.hand[i]].cardId === cardId) out.push(pl.hand[i]);
    }
    return out;
  };
  let boardState = () => {
    let st = frCloneState(baseMix);
    st.step = "precombat_main";
    st.activePlayer = 0;
    st.priorityPlayer = 0;
    st.stack = [];
    st.players[0].manaPool = { W: 0, U: 0, B: 3, R: 6, G: 0, C: 6 };
    let brambles = inHandAll(st, 0, "bramble-warden");
    let cinders = inHandAll(st, 0, "cinderfang-marauder");
    for(let i = 0; i < brambles.length; i++) frZoneMove(st, brambles[i], "hand", "battlefield", 0);
    for(let i = 0; i < cinders.length; i++) frZoneMove(st, cinders[i], "hand", "battlefield", 0);
    return st;
  };
  let twoCreatures = (st) => {
    let b = [], c = [];
    for(let i = 0; i < st.battlefield.length; i++) {
      let o = st.objects[st.battlefield[i]];
      if(!o) continue;
      if(o.cardId === "bramble-warden") b.push(o.id);
      else if(o.cardId === "cinderfang-marauder") c.push(o.id);
    }
    return { b0: b[0], b1: b[1], c0: c[0] };
  };

  let sTD = boardState();
  let td = inHand(sTD, 0, "twin-dart");
  let tdT = twoCreatures(sTD);
  let rTD = frActionCastSpell(sTD, { type: "castSpell", player: 0, objectId: td, targets: [tdT.b0, tdT.c0] });
  push("cast twin-dart with 2 target creatures: ok, both on the stack entry",
    rTD.lastActionError === null && rTD.stack.length === 1 &&
      rTD.stack[0].targets.length === 2 &&
      rTD.stack[0].targets[0] === tdT.b0 && rTD.stack[0].targets[1] === tdT.c0,
    "error=" + rTD.lastActionError + " stack=" + JSON.stringify(rTD.stack));

  let sTD1 = boardState();
  let td1 = inHand(sTD1, 0, "twin-dart");
  let rTD1 = frActionCastSpell(sTD1, { type: "castSpell", player: 0, objectId: td1, targets: [twoCreatures(sTD1).b0] });
  push("cast twin-dart with 1 target: rejected (needs at least 2)",
    rTD1.lastActionError === "requires at least 2 targets" && rTD1.stack.length === 0,
    "error=" + rTD1.lastActionError);

  let sTD2 = boardState();
  let td2 = inHand(sTD2, 0, "twin-dart");
  let td2T = twoCreatures(sTD2);
  let rTD2 = frActionCastSpell(sTD2, { type: "castSpell", player: 0, objectId: td2, targets: [td2T.b0, td2T.b0] });
  push("cast twin-dart with the same creature twice: rejected (targets must be distinct)",
    rTD2.lastActionError === "targets must be distinct" && rTD2.stack.length === 0,
    "error=" + rTD2.lastActionError);

  let sTD3 = boardState();
  let td3 = inHand(sTD3, 0, "twin-dart");
  let td3T = twoCreatures(sTD3);
  let rTD3 = frActionCastSpell(sTD3, { type: "castSpell", player: 0, objectId: td3, targets: [td3T.b0, td3T.c0, td3T.b1] });
  push("cast twin-dart with 3 targets: rejected (at most 2)",
    rTD3.lastActionError === "requires at most 2 targets" && rTD3.stack.length === 0,
    "error=" + rTD3.lastActionError);

  let sTD4 = boardState();
  let td4 = inHand(sTD4, 0, "twin-dart");
  let rTD4 = frActionCastSpell(sTD4, { type: "castSpell", player: 0, objectId: td4, targets: [1, 1] });
  push("cast twin-dart targeting players: rejected (slots are creature-only)",
    rTD4.lastActionError === "invalid target #1" && rTD4.stack.length === 0,
    "error=" + rTD4.lastActionError);

  let sTD5 = boardState();
  let td5 = inHand(sTD5, 0, "twin-dart");
  let td5T = twoCreatures(sTD5);
  let rTD5 = frActionCastSpell(sTD5, { type: "castSpell", player: 0, objectId: td5, targets: [td5T.b0, td5T.c0] });
  rTD5 = frStackResolveTop(rTD5);
  push("resolve twin-dart: each target takes 1 damage",
    rTD5.objects[td5T.b0].damage === 1 && rTD5.objects[td5T.c0].damage === 1,
    "damage=" + rTD5.objects[td5T.b0].damage + "," + rTD5.objects[td5T.c0].damage);

  let sCB = boardState();
  let cb = inHand(sCB, 0, "cinder-bolt");
  let rCB = frActionCastSpell(sCB, { type: "castSpell", player: 0, objectId: cb, targets: [1] });
  push("cast cinder-bolt at player 1 (any target): ok",
    rCB.lastActionError === null && rCB.stack.length === 1 && rCB.stack[0].targets[0] === 1,
    "error=" + rCB.lastActionError);
  rCB = frStackResolveTop(rCB);
  push("resolve cinder-bolt on player 1: 2 life lost",
    rCB.players[1].life === 18,
    "life=" + rCB.players[1].life);

  let sCB2 = boardState();
  let cb2 = inHand(sCB2, 0, "cinder-bolt");
  let cb2T = twoCreatures(sCB2);
  let rCB2 = frActionCastSpell(sCB2, { type: "castSpell", player: 0, objectId: cb2, targets: [cb2T.b0] });
  rCB2 = frStackResolveTop(rCB2);
  push("resolve cinder-bolt on a creature: 2 damage",
    rCB2.lastActionError === null && rCB2.objects[cb2T.b0].damage === 2,
    "error=" + rCB2.lastActionError + " damage=" + rCB2.objects[cb2T.b0].damage);

  let sCB3 = boardState();
  let cb3 = inHand(sCB3, 0, "cinder-bolt");
  let artObj = frObjectNew("obj-art-test", "faceted-ember-core", 0);
  artObj.zone = "battlefield";
  sCB3.objects["obj-art-test"] = artObj;
  sCB3.battlefield.push("obj-art-test");
  let rCB3 = frActionCastSpell(sCB3, { type: "castSpell", player: 0, objectId: cb3, targets: ["obj-art-test"] });
  push("cast cinder-bolt at an artifact: rejected (slot is creature/player)",
    rCB3.lastActionError === "invalid target #1" && rCB3.stack.length === 0,
    "error=" + rCB3.lastActionError);

  let sER = boardState();
  let er = inHand(sER, 0, "ember-reckoning");
  let erB = twoCreatures(sER).b0;
  let rER = frActionCastSpell(sER, { type: "castSpell", player: 0, objectId: er, mode: "creature", targets: [erB] });
  push("cast ember-reckoning mode 'creature': ok, mode on the stack entry",
    rER.lastActionError === null && rER.stack.length === 1 && rER.stack[0].mode === "creature" &&
      rER.stack[0].targets[0] === erB,
    "error=" + rER.lastActionError + " stack=" + JSON.stringify(rER.stack));

  let sER2 = boardState();
  let er2 = inHand(sER2, 0, "ember-reckoning");
  let rER2 = frActionCastSpell(sER2, { type: "castSpell", player: 0, objectId: er2, mode: "player", targets: [1] });
  push("cast ember-reckoning mode 'player': ok",
    rER2.lastActionError === null && rER2.stack[0].mode === "player",
    "error=" + rER2.lastActionError);

  let sER3 = boardState();
  let er3 = inHand(sER3, 0, "ember-reckoning");
  let rER3 = frActionCastSpell(sER3, { type: "castSpell", player: 0, objectId: er3, mode: "planeswalker", targets: [1] });
  push("cast ember-reckoning with an unknown mode: rejected with the mode list",
    rER3.lastActionError === "invalid mode: choose one of creature, player" && rER3.stack.length === 0,
    "error=" + rER3.lastActionError);

  let sER4 = boardState();
  let er4 = inHand(sER4, 0, "ember-reckoning");
  let rER4 = frActionCastSpell(sER4, { type: "castSpell", player: 0, objectId: er4, targets: [1] });
  push("cast ember-reckoning with no mode: rejected",
    rER4.lastActionError === "invalid mode: choose one of creature, player" && rER4.stack.length === 0,
    "error=" + rER4.lastActionError);

  let sER5 = boardState();
  let er5 = inHand(sER5, 0, "ember-reckoning");
  let rER5 = frActionCastSpell(sER5, { type: "castSpell", player: 0, objectId: er5, mode: "creature", targets: [1] });
  push("cast ember-reckoning mode 'creature' at a player: rejected (slot type)",
    rER5.lastActionError === "invalid target #1" && rER5.stack.length === 0,
    "error=" + rER5.lastActionError);

  let sER6 = boardState();
  let er6 = inHand(sER6, 0, "ember-reckoning");
  let er6C = twoCreatures(sER6).c0;
  let rER6 = frActionCastSpell(sER6, { type: "castSpell", player: 0, objectId: er6, mode: "creature", targets: [er6C] });
  rER6 = frStackResolveTop(rER6);
  push("resolve ember-reckoning mode 'creature': 3 damage kills the 3/2 via SBA",
    rER6.objects[er6C].zone === "graveyard",
    "zone=" + rER6.objects[er6C].zone);

  let sER7 = boardState();
  let er7 = inHand(sER7, 0, "ember-reckoning");
  let rER7 = frActionCastSpell(sER7, { type: "castSpell", player: 0, objectId: er7, mode: "player", targets: [1] });
  rER7 = frStackResolveTop(rER7);
  push("resolve ember-reckoning mode 'player': 3 life lost",
    rER7.players[1].life === 17,
    "life=" + rER7.players[1].life);

  let sWG = boardState();
  let wg = inHand(sWG, 0, "withering-grasp");
  let wgB = twoCreatures(sWG).b0;
  let rWG = frActionCastSpell(sWG, { type: "castSpell", player: 0, objectId: wg, targets: [wgB] });
  push("cast withering-grasp at a 3/3: ok (declared toughness filter, 3 or less)",
    rWG.lastActionError === null && rWG.stack.length === 1,
    "error=" + rWG.lastActionError);

  let sWG2 = boardState();
  let wg2 = inHand(sWG2, 0, "withering-grasp");
  let wgB2 = twoCreatures(sWG2).b0;
  sWG2.objects[wgB2].counters.p1p1 = 1;
  let rWG2 = frActionCastSpell(sWG2, { type: "castSpell", player: 0, objectId: wg2, targets: [wgB2] });
  push("cast withering-grasp at a 4/4: rejected (toughness filter)",
    rWG2.lastActionError === "invalid target #1" && rWG2.stack.length === 0,
    "error=" + rWG2.lastActionError);

  let sLA = boardState();
  let legalMix = frLegalActions(sLA);
  let laTd = inHand(sLA, 0, "twin-dart");
  let laTdActs = legalMix.filter((a) => a.type === "castSpell" && a.objectId === laTd);
  push("legalActions for twin-dart: 6 ordered two-target sets from 3 creatures",
    laTdActs.length === 6 && laTdActs.every((a) => Array.isArray(a.targets) && a.targets.length === 2),
    "n=" + laTdActs.length + " sample=" + JSON.stringify(laTdActs.slice(0, 1)));

  let laEr = inHand(sLA, 0, "ember-reckoning");
  let laErActs = legalMix.filter((a) => a.type === "castSpell" && a.objectId === laEr);
  push("legalActions for ember-reckoning: 3 creature-mode sets + 2 player-mode sets",
    laErActs.length === 5 &&
      laErActs.filter((a) => a.mode === "creature").length === 3 &&
      laErActs.filter((a) => a.mode === "player").length === 2,
    "n=" + laErActs.length + " modes=" + JSON.stringify(laErActs.map((a) => a.mode)));

  let laCb = inHand(sLA, 0, "cinder-bolt");
  let laCbActs = legalMix.filter((a) => a.type === "castSpell" && a.objectId === laCb);
  push("legalActions for cinder-bolt: 2 players + 3 creatures (any target)",
    laCbActs.length === 5 &&
      laCbActs.some((a) => a.targets[0] === 1) &&
      laCbActs.some((a) => typeof a.targets[0] === "string"),
    "n=" + laCbActs.length + " sample=" + JSON.stringify(laCbActs.slice(0, 2)));

  // -- data-driven card effects (#4) ----------------------------------
  // Every effect/trigger/ability is declared on the card record and resolved through the
  // shared template library. These fixture tests walk one card per template: verdant-surge
  // (pump), ember-conflagration (damageAll), verdant-call (token), ember-hound (activated
  // {1},{T} ability), faceted-ember-core (activated {3},{T},sacrifice), withering-grasp
  // (destroy), solara-benediction (shield vs spell and combat damage), tide-vortex (scry +
  // draw), umbra-life-drain (X life), umbra-whisper (discard), tide-banishment (counter, a
  // spell-slot target), vow-of-radiance (aura buff), and the enter/attack/combat-damage
  // triggers (sunward-sentinel, nautilus-seer, bramble-warden, thornshroud-stalker).
  let dFx0 = [];
  for(let i = 0; i < 14; i++) dFx0.push("halo-reliquary");
  let dFx1 = [];
  for(let i = 0; i < 14; i++) dFx1.push("halo-reliquary");
  let baseFx = frGameNew({ seed: 17, decks: [dFx0, dFx1] });
  let fxSetup = (mana) => {
    let st = frCloneState(baseFx);
    st.step = "precombat_main";
    st.activePlayer = 0;
    st.priorityPlayer = 0;
    st.stack = [];
    st.players[0].manaPool = mana;
    return st;
  };
  let fxPut = (st, cardId, controller) => {
    let id = "fxc" + st.nextObjectId;
    st.nextObjectId += 1;
    let o = frObjectNew(id, cardId, controller);
    o.zone = "battlefield";
    o.summoningSickness = false;
    st.objects[id] = o;
    st.battlefield.push(id);
    return id;
  };
  let fxGive = (st, cardId) => {
    let id = "fxh" + st.nextObjectId;
    st.nextObjectId += 1;
    let o = frObjectNew(id, cardId, 0);
    o.zone = "hand";
    st.objects[id] = o;
    st.players[0].hand.push(id);
    return id;
  };

  let sVs = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 2, C: 0 });
  let vsBram = fxPut(sVs, "bramble-warden", 0);
  let vs = fxGive(sVs, "verdant-surge");
  let rVs = frActionCastSpell(sVs, { type: "castSpell", player: 0, objectId: vs, targets: [vsBram] });
