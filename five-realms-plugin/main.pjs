  let sFe = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 3 });
  let fe = fxPut(sFe, "faceted-ember-core", 0);
  let rFe = frActionActivateAbility(sFe, { type: "activateAbility", player: 0, objectId: fe, abilityName: "combust", targets: [1] });
  push("activate faceted-ember-core {3},{T},sacrifice: on the stack, mana spent, core in graveyard",
    rFe.lastActionError === null && rFe.stack.length === 1 && rFe.stack[0].abilityName === "combust" &&
      rFe.players[0].manaPool.C === 0 && rFe.objects[fe].zone === "graveyard",
    "error=" + rFe.lastActionError + " zone=" + rFe.objects[fe].zone);
  rFe = frStackResolveTop(rFe);
  push("resolve faceted-ember-core combust: 3 damage to the chosen player",
    rFe.players[1].life === 17,
    "life=" + rFe.players[1].life);

  let sWg = fxSetup({ W: 0, U: 0, B: 2, R: 0, G: 0, C: 0 });
  let wgBram = fxPut(sWg, "bramble-warden", 0);
  let wgD = fxGive(sWg, "withering-grasp");
  let rWg = frActionCastSpell(sWg, { type: "castSpell", player: 0, objectId: wgD, targets: [wgBram] });
  rWg = frStackResolveTop(rWg);
  push("resolve withering-grasp: the 3/3 is destroyed to the graveyard",
    rWg.objects[wgBram].zone === "graveyard",
    "zone=" + rWg.objects[wgBram].zone);

  let sSs = fxSetup({ W: 1, U: 0, B: 0, R: 0, G: 0, C: 1 });
  let ss = fxGive(sSs, "sunward-sentinel");
  let rSs = frActionCastSpell(sSs, { type: "castSpell", player: 0, objectId: ss });
  rSs = frStackResolveTop(rSs);
  push("resolve sunward-sentinel: enters and its trigger gains its controller 2 life",
    rSs.objects[ss].zone === "battlefield" && rSs.players[0].life === 22,
    "life=" + rSs.players[0].life);

  let sNs = fxSetup({ W: 0, U: 2, B: 0, R: 0, G: 0, C: 1 });
  let nsHand = sNs.players[0].hand.length;
  let nsLib = sNs.players[0].library.length;
  let ns = fxGive(sNs, "nautilus-seer");
  let rNs = frActionCastSpell(sNs, { type: "castSpell", player: 0, objectId: ns });
  rNs = frStackResolveTop(rNs);
  push("resolve nautilus-seer: enters, draws then discards (hand net 0, library -1)",
