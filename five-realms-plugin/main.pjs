      types: ["Land"],
      subtypes: ["Mountain"],
      rulesText: "\{T}: Add \{R}.",
      producesMana: "R",
      rarity: "Field",
      frame: "field",
      glyph: "ember",
      image: "https://user.uploads.dev/file/adf1479204558e5baa0998f3230cce94.png"
    },
    "ancient-forest": {
      id: "ancient-forest",
