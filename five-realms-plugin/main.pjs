  rTs.step = "combat_damage";
  rTs.combatBlocks = [];
  let tsHand = rTs.players[1].hand.length;
  rTs = frStepCombatDamage(rTs);
  push("thornshroud-stalker unblocked: deals 2 and its combat-damage trigger makes the opponent discard",
    rTs.players[1].life === 18 && rTs.players[1].hand.length === tsHand - 1 &&
      rTs.players[1].graveyard.length === 1,
    "life=" + rTs.players[1].life + " hand=" + rTs.players[1].hand.length);

  let sSb = fxSetup({ W: 1, U: 0, B: 0, R: 0, G: 0, C: 2 });
  let sb = fxGive(sSb, "solara-benediction");
  let rSb = frActionCastSpell(sSb, { type: "castSpell", player: 0, objectId: sb, x: 2 });
  rSb = frStackResolveTop(rSb);
  rSb.players[0].manaPool = { W: 0, U: 0, B: 0, R: 1, G: 0, C: 0 };
  let sbCb = fxGive(rSb, "cinder-bolt");
  let rSb2 = frActionCastSpell(rSb, { type: "castSpell", player: 0, objectId: sbCb, targets: [0] });
  rSb2 = frStackResolveTop(rSb2);
  push("solara-benediction X=2 shield: a 2-damage cinder-bolt is fully prevented",
    rSb2.players[0].life === 20 && rSb2.objects[sbCb].zone === "graveyard",
    "life=" + rSb2.players[0].life);

  let sSbC = fxSetup({ W: 1, U: 0, B: 0, R: 0, G: 0, C: 2 });
  let sbC = fxGive(sSbC, "solara-benediction");
  let rSbC = frActionCastSpell(sSbC, { type: "castSpell", player: 0, objectId: sbC, x: 2 });
  rSbC = frStackResolveTop(rSbC);
  let oppTs = fxPut(rSbC, "thornshroud-stalker", 1);
  rSbC.step = "declare_attackers";
  rSbC.activePlayer = 1;
  rSbC.priorityPlayer = 1;
  let rSbC2 = frActionDeclareAttackers(rSbC, { type: "declareAttackers", player: 1, attackers: [oppTs] });
  rSbC2.step = "combat_damage";
  rSbC2.combatBlocks = [];
  rSbC2 = frStepCombatDamage(rSbC2);
  push("solara-benediction shield also prevents combat damage (and no discard trigger fires)",
    rSbC2.players[0].life === 20 && rSbC2.players[0].hand.length === 7,
    "life=" + rSbC2.players[0].life + " hand=" + rSbC2.players[0].hand.length);

  let sTv = fxSetup({ W: 0, U: 1, B: 0, R: 0, G: 0, C: 4 });
  let tvHand0 = sTv.players[0].hand.length;
  let tv = fxGive(sTv, "tide-vortex");
  let tvLib0 = sTv.players[0].library.slice();
  let rTv = frActionCastSpell(sTv, { type: "castSpell", player: 0, objectId: tv, x: 2 });
  rTv = frStackResolveTop(rTv);
  let tvLibExp = tvLib0.slice(3).concat(tvLib0.slice(0, 2));
  push("resolve tide-vortex X=2: scries 2 (top to bottom) then draws 1",
    rTv.players[0].hand.length === tvHand0 + 1 &&
      JSON.stringify(rTv.players[0].library) === JSON.stringify(tvLibExp),
    "hand=" + rTv.players[0].hand.length);

  let sUld = fxSetup({ W: 0, U: 0, B: 1, R: 0, G: 0, C: 2 });
  let uld = fxGive(sUld, "umbra-life-drain");
  let rUld = frActionCastSpell(sUld, { type: "castSpell", player: 0, objectId: uld, x: 2 });
  rUld = frStackResolveTop(rUld);
  push("resolve umbra-life-drain X=2: each opponent loses 2, its controller gains 2",
