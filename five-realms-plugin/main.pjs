  let sUw = fxSetup({ W: 0, U: 0, B: 2, R: 0, G: 0, C: 1 });
  let uw = fxGive(sUw, "umbra-whisper");
  let uwHand = sUw.players[1].hand.length;
  let rUw = frActionCastSpell(sUw, { type: "castSpell", player: 0, objectId: uw, targets: [1] });
  rUw = frStackResolveTop(rUw);
  push("resolve umbra-whisper: target player discards two cards",
    rUw.players[1].hand.length === uwHand - 2 && rUw.players[1].graveyard.length === 2,
    "hand=" + rUw.players[1].hand.length + " gy=" + rUw.players[1].graveyard.length);

  let sTb = fxSetup({ W: 0, U: 2, B: 0, R: 1, G: 0, C: 2 });
  let tcb = fxGive(sTb, "cinder-bolt");
  let rTb1 = frActionCastSpell(sTb, { type: "castSpell", player: 0, objectId: tcb, targets: [1] });
  let tb = fxGive(rTb1, "tide-banishment");
  let rTb2 = frActionCastSpell(rTb1, { type: "castSpell", player: 0, objectId: tb, targets: [tcb] });
  push("cast tide-banishment on a spell on the stack: ok, two spells stacked",
    rTb2.lastActionError === null && rTb2.stack.length === 2,
    "error=" + rTb2.lastActionError + " stack=" + JSON.stringify(rTb2.stack));
  let rTb3 = frStackResolveTop(rTb2);
  push("resolve tide-banishment: the target spell is countered (graveyard, off the stack)",
    rTb3.stack.length === 0 && rTb3.objects[tcb].zone === "graveyard",
    "stack=" + rTb3.stack.length + " zone=" + rTb3.objects[tcb].zone);

  let sVo = fxSetup({ W: 1, U: 0, B: 0, R: 0, G: 0, C: 2 });
  let voBram = fxPut(sVo, "bramble-warden", 0);
  let vow = fxGive(sVo, "vow-of-radiance");
  let rVo = frActionCastSpell(sVo, { type: "castSpell", player: 0, objectId: vow, targets: [voBram] });
  rVo = frStackResolveTop(rVo);
  push("resolve vow-of-radiance: aura attaches and buffs the creature +2/+2",
    rVo.objects[vow].zone === "battlefield" && rVo.objects[vow].attachedTo === voBram &&
      frPower(rVo, rVo.objects[voBram]) === 5 && frToughness(rVo, rVo.objects[voBram]) === 5,
    "power=" + frPower(rVo, rVo.objects[voBram]));

  let sLa = fxSetup({ W: 0, U: 2, B: 0, R: 1, G: 0, C: 2 });
  let laTb = fxGive(sLa, "tide-banishment");
  let laCb2 = fxGive(sLa, "cinder-bolt");
  let rLa0 = frActionCastSpell(sLa, { type: "castSpell", player: 0, objectId: laCb2, targets: [1] });
  let legalFx = frLegalActions(rLa0);
  let laTbActs = legalFx.filter((a) => a.type === "castSpell" && a.objectId === laTb);
  push("legalActions counter-spell: never offers a spell as its own target, targets the stacked spell",
    laTbActs.length >= 1 &&
      laTbActs.every((a) => a.targets.indexOf(laTb) === -1) &&
      laTbActs.some((a) => a.targets.indexOf(laCb2) !== -1),
    "n=" + laTbActs.length + " sample=" + JSON.stringify(laTbActs.slice(0, 1)));

  let sAe = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 1 });
  let aeHound = fxPut(sAe, "ember-hound", 0);
  let legalAe = frLegalActions(sAe);
  let houndActs = legalAe.filter((a) => a.type === "activateAbility" && a.objectId === aeHound);
  push("legalActions enumerates ember-hound's snap: one any-target set offered",
    houndActs.length >= 1 && houndActs[0].abilityName === "snap" &&
      Array.isArray(houndActs[0].targets) && houndActs[0].targets.length === 1,
    "n=" + houndActs.length + " sample=" + JSON.stringify(houndActs.slice(0, 1)));

  let sFe2 = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 3 });
  let fe2 = fxPut(sFe2, "faceted-ember-core", 0);
  let legalFe = frLegalActions(sFe2);
  let feActs = legalFe.filter((a) => a.type === "activateAbility" && a.objectId === fe2);
  push("legalActions enumerates faceted-ember-core's combust: {3},{T},sacrifice offered",
    feActs.length >= 1 && feActs[0].abilityName === "combust" && feActs[0].targets.length === 1,
    "n=" + feActs.length + " sample=" + JSON.stringify(feActs.slice(0, 1)));

  // -- combat damage assignment order (#5) ------------------------------
  // Blockers of a multi-blocked attacker are ordered at declaration; combat damage assigns
  // the attacker's power in that order (lethal to each in turn, remainder to the last,
  // trample spilling to the player), applied simultaneously within a wave with SBA between
  // waves. These walk one wave end to end: declare attackers, declare blockers with orders,
  // run the damage step.
  let blkAttack = (st, ids) => {
    st.step = "declare_attackers";
    st.activePlayer = 0;
    st.priorityPlayer = 0;
    let r = frActionDeclareAttackers(st, { type: "declareAttackers", player: 0, attackers: ids });
    r.step = "declare_blockers";
    r.priorityPlayer = 1;
    return r;
  };
  let blkGo = (st, blocks) => {
    let r = frActionDeclareBlockers(st, { type: "declareBlockers", player: 1, blocks: blocks });
    if(r.lastActionError !== null) return r;
    r.step = "combat_damage";
    r = frStepCombatDamage(r);
    return r;
  };
  let dbBram = "bramble-warden", dbRam = "molten-ramsprite";
  let sDb = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 2, C: 0 });
  let dbAtt = fxPut(sDb, "ember-brand-stormcaller", 0);
  let dbVs = fxGive(sDb, "verdant-surge");
  let rDb = frActionCastSpell(sDb, { type: "castSpell", player: 0, objectId: dbVs, targets: [dbAtt] });
  rDb = frStackResolveTop(rDb);
  rDb = blkAttack(rDb, [dbAtt]);
  let dbB1 = fxPut(rDb, dbBram, 1);
  let dbB2 = fxPut(rDb, dbRam, 1);
  let rDb2 = blkGo(rDb, [
    { attacker: dbAtt, blocker: dbB1, order: 1 },
    { attacker: dbAtt, blocker: dbB2, order: 2 }
  ]);
  push("5/5 double-blocked by two 3/3s: the first-declared blocker takes lethal and dies, the second survives with 2",
    rDb2.lastActionError === null &&
      rDb2.objects[dbB1].zone === "graveyard" &&
      rDb2.objects[dbB2].zone === "battlefield" && rDb2.objects[dbB2].damage === 2 &&
      rDb2.objects[dbAtt].zone === "graveyard",
    "error=" + rDb2.lastActionError + " b1=" + rDb2.objects[dbB1].zone +
      " b2=" + rDb2.objects[dbB2].zone + "/dmg" + rDb2.objects[dbB2].damage +
      " att=" + rDb2.objects[dbAtt].zone);

  let sDbR = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 2, C: 0 });
  let dbAttR = fxPut(sDbR, "ember-brand-stormcaller", 0);
  let dbVsR = fxGive(sDbR, "verdant-surge");
  let rDbR = frActionCastSpell(sDbR, { type: "castSpell", player: 0, objectId: dbVsR, targets: [dbAttR] });
  rDbR = frStackResolveTop(rDbR);
  rDbR = blkAttack(rDbR, [dbAttR]);
  let dbB1R = fxPut(rDbR, dbBram, 1);
  let dbB2R = fxPut(rDbR, dbRam, 1);
  let rDbR2 = blkGo(rDbR, [
    { attacker: dbAttR, blocker: dbB1R, order: 2 },
    { attacker: dbAttR, blocker: dbB2R, order: 1 }
  ]);
  push("reversing the order flips which 3/3 takes the lethal hit",
    rDbR2.objects[dbB1R].zone === "battlefield" && rDbR2.objects[dbB1R].damage === 2 &&
      rDbR2.objects[dbB2R].zone === "graveyard",
    "b1=" + rDbR2.objects[dbB1R].zone + "/dmg" + rDbR2.objects[dbB1R].damage +
      " b2=" + rDbR2.objects[dbB2R].zone);

  let sNb = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 });
  let nbAtt = fxPut(sNb, "ember-brand-stormcaller", 0);
  sNb = blkAttack(sNb, [nbAtt]);
  let nbB1 = fxPut(sNb, dbBram, 1);
  let nbB2 = fxPut(sNb, dbRam, 1);
  let rNb = frActionDeclareBlockers(sNb, { type: "declareBlockers", player: 1, blocks: [
    { attacker: nbAtt, blocker: nbB2 },
    { attacker: nbAtt, blocker: nbB1 }
  ] });
  push("no orders given: insertion order is recorded (combatBlocks normalized with order fields)",
    rNb.lastActionError === null && rNb.combatBlocks.length === 2 &&
      rNb.combatBlocks[0].blocker === nbB2 && rNb.combatBlocks[0].order === 1 &&
      rNb.combatBlocks[1].blocker === nbB1 && rNb.combatBlocks[1].order === 2,
    "error=" + rNb.lastActionError + " blocks=" + JSON.stringify(rNb.combatBlocks));

  let sDb2 = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 });
  let at1 = fxPut(sDb2, "ember-brand-stormcaller", 0);
  let at2 = fxPut(sDb2, "sunward-sentinel", 0);
  sDb2 = blkAttack(sDb2, [at1, at2]);
  let db2B = fxPut(sDb2, dbBram, 1);
  let rDb2x = frActionDeclareBlockers(sDb2, { type: "declareBlockers", player: 1, blocks: [
    { attacker: at1, blocker: db2B },
    { attacker: at2, blocker: db2B }
  ] });
  push("a creature can only block one attacker: double-assignment is rejected",
    rDb2x.lastActionError === "a creature can only block one attacker: " + db2B,
    "error=" + rDb2x.lastActionError);

  let sIo = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 });
  let ioAtt = fxPut(sIo, "ember-brand-stormcaller", 0);
  sIo = blkAttack(sIo, [ioAtt]);
  let ioB1 = fxPut(sIo, dbBram, 1);
  let ioB2 = fxPut(sIo, dbRam, 1);
  let rIo = frActionDeclareBlockers(sIo, { type: "declareBlockers", player: 1, blocks: [
    { attacker: ioAtt, blocker: ioB1, order: 1 },
    { attacker: ioAtt, blocker: ioB2, order: 1 }
  ] });
  push("duplicate blocker orders are rejected",
    rIo.lastActionError === "invalid blocker order",
    "error=" + rIo.lastActionError);
  let rIo2 = frActionDeclareBlockers(sIo, { type: "declareBlockers", player: 1, blocks: [
    { attacker: ioAtt, blocker: ioB1, order: 1 },
    { attacker: ioAtt, blocker: ioB2 }
  ] });
  push("partial orders (one declared, one not) are rejected",
    rIo2.lastActionError === "every blocker of an attacker must declare order, or none",
    "error=" + rIo2.lastActionError);

  let sTr = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 });
  let trAtt = fxPut(sTr, "ironbark-mastodon", 0);
  sTr = blkAttack(sTr, [trAtt]);
  let trB1 = fxPut(sTr, "wolf-token", 1);
  let trB2 = fxPut(sTr, "wolf-token", 1);
  let rTr = blkGo(sTr, [
    { attacker: trAtt, blocker: trB1, order: 1 },
    { attacker: trAtt, blocker: trB2, order: 2 }
  ]);
  push("4/7 trampler double-blocked by two 1/1s: lethal to each, the remainder tramples to the player",
    rTr.objects[trB1].zone === "graveyard" && rTr.objects[trB2].zone === "graveyard" &&
      rTr.objects[trAtt].zone === "battlefield" && rTr.objects[trAtt].damage === 2 &&
      rTr.players[1].life === 18,
    "b1=" + rTr.objects[trB1].zone + " b2=" + rTr.objects[trB2].zone +
      " attDmg=" + rTr.objects[trAtt].damage + " life=" + rTr.players[1].life);

  let sLaB = fxSetup({ W: 0, U: 0, B: 0, R: 0, G: 0, C: 0 });
  let laBAtt = fxPut(sLaB, "ember-brand-stormcaller", 0);
  sLaB = blkAttack(sLaB, [laBAtt]);
  let laBB1 = fxPut(sLaB, dbBram, 1);
  let laBB2 = fxPut(sLaB, dbRam, 1);
  let laB = frLegalActions(sLaB);
  let laBlockActs = laB.filter((a) => a.type === "declareBlockers");
  let dbActs = laBlockActs.filter((a) => a.blocks.length === 2);
  push("legalActions enumerates blocker order: the double-block offers both orderings",
    laBlockActs.length === 4 && dbActs.length === 2 &&
      dbActs.some((a) => a.blocks[0].blocker === laBB1) &&
      dbActs.some((a) => a.blocks[0].blocker === laBB2) &&
      dbActs.every((a) => a.blocks[0].order === 1 && a.blocks[1].order === 2),
    "n=" + laBlockActs.length + " sample=" + JSON.stringify(laBlockActs));

  // -- custom card database injection + null-safe lookups (#6) ------------
  // newGame accepts config.cards ({id: card}, merged over frCardDb) so a non-fixture
  // database can be injected at runtime, and every frCardGet consumer null-checks, so an
  // unknown card id is skipped (or rejected with a clean lastActionError) rather than
  // crashing the reducer/SBA. This injects a tiny non-fixture DB and plays a full turn
  // through it -- land, tap, cast, resolve, attack, block, damage, SBA -- with zero errors.
  let c6d = [];
  for(let i = 0; i < 20; i++) c6d.push("edgewood");
  for(let i = 0; i < 10; i++) c6d.push("glowpaw");
  for(let i = 0; i < 10; i++) c6d.push("cinderling");
  let c6Game = frGameNew({ seed: 3, cards: {
    "edgewood": { id: "edgewood", name: "Edgewood", types: ["Land"], subtypes: [], colorIdentity: ["G"], producesMana: "G", rarity: "Field", frame: "field", glyph: "verdant" },
    "glowpaw": { id: "glowpaw", name: "Glowpaw", manaCost: "{G}", cmc: 1, colors: ["G"], colorIdentity: ["G"], supertypes: [], types: ["Creature"], subtypes: [], rulesText: "", keywords: [], power: 2, toughness: 2, rarity: "Marked", frame: "marked", glyph: "verdant" },
    "cinderling": { id: "cinderling", name: "Cinderling", manaCost: "{R}", cmc: 1, colors: ["R"], colorIdentity: ["R"], supertypes: [], types: ["Creature"], subtypes: [], rulesText: "Trample", keywords: ["trample"], power: 2, toughness: 1, rarity: "Marked", frame: "marked", glyph: "ember" }
  }, decks: [c6d, c6d] });
  let c6All = Object.keys(c6Game.objects);
  let c6Known = c6All.length;
  for(let i = 0; i < c6All.length; i++) {
    let cid = c6Game.objects[c6All[i]].cardId;
    if(cid !== "edgewood" && cid !== "glowpaw" && cid !== "cinderling") c6Known -= 1;
  }
  push("#6 custom DB: newGame injects cards, merged over the fixture DB",
    c6Known === c6All.length && c6All.length === 80 && !!frCardGet("glowpaw") &&
      !!frCardGet("cinderling") && !!frCardGet("edgewood") &&
      frCardGet("bramble-warden") && frCardGet("bramble-warden").name === "Bramble Warden",
    "known=" + c6Known + " total=" + c6All.length);
  let c6 = frCloneState(c6Game);
  c6.step = "precombat_main"; c6.activePlayer = 0; c6.priorityPlayer = 0; c6.stack = [];
  c6.players[0].manaPool = frManaEmptyPool(); c6.players[1].manaPool = frManaEmptyPool();
  let c6Land = frObjectNew("c6l", "edgewood", 0); c6Land.zone = "hand";
  c6.objects[c6Land.id] = c6Land; c6.players[0].hand.push(c6Land.id);
  let c6Paw = frObjectNew("c6p", "glowpaw", 0); c6Paw.zone = "hand";
  c6.objects[c6Paw.id] = c6Paw; c6.players[0].hand.push(c6Paw.id);
  // p1's blocker goes straight to the battlefield (fxPut-style -- blocking is never
  // restricted by summoning sickness); the custom-DB cast/resolve path is exercised by
  // glowpaw below.
  let c6Cnd = frObjectNew("c6c", "cinderling", 1);
  c6Cnd.zone = "battlefield"; c6Cnd.summoningSickness = false;
  c6.objects[c6Cnd.id] = c6Cnd; c6.battlefield.push(c6Cnd.id);
  let c6R = frActionPlayLand(c6, { type: "playLand", player: 0, objectId: c6Land.id });
  let c6E1 = c6R.lastActionError;
  let c6LandZone = c6R.objects[c6Land.id].zone;
  c6R = frActionActivateAbility(c6R, { type: "activateAbility", player: 0, objectId: c6Land.id });
  let c6E2 = c6R.lastActionError;
  let c6Pool = c6R.players[0].manaPool.G;
  c6R = frActionCastSpell(c6R, { type: "castSpell", player: 0, objectId: c6Paw.id });
  let c6E3 = c6R.lastActionError;
  c6R = frStackResolveTop(c6R);
  c6R.objects[c6Paw.id].summoningSickness = false;
  let c6PawZone = c6R.objects[c6Paw.id].zone;
  let c6CndZone = c6R.objects[c6Cnd.id].zone;
  c6R.step = "declare_attackers"; c6R.activePlayer = 0; c6R.priorityPlayer = 0;
  c6R = frActionDeclareAttackers(c6R, { type: "declareAttackers", player: 0, attackers: [c6Paw.id] });
  let c6E4 = c6R.lastActionError;
  c6R.step = "declare_blockers"; c6R.priorityPlayer = 1;
  c6R = frActionDeclareBlockers(c6R, { type: "declareBlockers", player: 1, blocks: [{ attacker: c6Paw.id, blocker: c6Cnd.id, order: 1 }] });
  let c6E5 = c6R.lastActionError;
  c6R.step = "combat_damage";
  c6R = frStepCombatDamage(c6R);
  push("#6 custom DB: full turn (land->tap->cast->combat->SBA) with zero errors",
    c6E1 === null && c6E2 === null && c6E3 === null && c6E4 === null && c6E5 === null &&
      c6LandZone === "battlefield" && c6Pool === 1 && c6PawZone === "battlefield" &&
      c6CndZone === "battlefield" &&
      c6R.objects[c6Paw.id].zone === "graveyard" && c6R.objects[c6Cnd.id].zone === "graveyard" &&
      !c6R.gameOver && c6R.winner === null,
    "errs=[" + [c6E1, c6E2, c6E3, c6E4, c6E5].join("|") + "] pool=" + c6Pool +
      " glowpaw=" + c6R.objects[c6Paw.id].zone + " cinderling=" + c6R.objects[c6Cnd.id].zone);
  let c6Bogus = frObjectNew("c6b", "no-such-card-anywhere", 0);
  c6Bogus.zone = "battlefield";
  c6.objects[c6Bogus.id] = c6Bogus; c6.battlefield.push(c6Bogus.id);
  let c6Sba = frCheckStateBasedActions(c6);
  c6Sba.step = "declare_attackers";
  let c6Atk = frActionDeclareAttackers(c6Sba, { type: "declareAttackers", player: 0, attackers: [c6Bogus.id] });
  push("#6 null-safe: an unknown card id is skipped by SBA and rejected cleanly by declareAttackers",
    c6Sba.objects[c6Bogus.id].zone === "battlefield" &&
      c6Atk.lastActionError === "not a creature: c6b",
    "sbaZone=" + c6Sba.objects[c6Bogus.id].zone + " atkErr=" + c6Atk.lastActionError);

  let failed = 0;
  for(let i = 0; i < results.length; i++) {
    if(!results[i].ok) failed += 1;
  }
  return { total: results.length, failed: failed, results: results };


// =====================================================================
// PLUGIN ENTRY POINT
// =====================================================================
//
// Column-0 function-form $output, op-dispatch on the first argument -- the same idiom
// card-deck-plugin/lists.txt:99 uses for its id-dispatch. Multi-parameter $output is
// source-verified against the 82 official plugins (not merely corpus-attested the way
// card-deck-plugin/NOTES.md left it): e.g.
// plugins/plugins/fullscreen-button-plugin/main.pjs:1 `$output(text, exitText, style) =>`
// and plugins/plugins/markdown-plugin/main.pjs:1 `$output(text, options, callback) =>`,
// both re-verified this session -- see NOTES.md.
//
// Ops (all lazily init the art payload on first call; NEVER throw -- unknown or hostile
// input returns a readable placeholder string, an empty array, or a defensively cloned
// value, per op, documented here):
//
//   $output("render", cardIdOrCardRecord)
//     -> { card, typeLine, imageUrl, frontSvg, glyphSvg, gemSvg, gemSmallSvg, rects,
//        palette, costSymbols } for a resolvable card, else "(unknown card id: ...)" /
//        "(unknown realm: ...)". imageUrl is the card's full-card art image URL when the
//        card record carries an `image` field (the five basic lands), else null --
//        consumers that want to show the actual card face should prefer it over the
//        procedural frontSvg. glyphSvg is null for a colourless card (or any realm whose
//        glyph asset does not exist). gemSvg/gemSmallSvg are null for a `Field` (basic
//        land) card or any unrecognised rarity. palette is undefined for a front that
//        publishes no k.palette (front-land/gold/artifact/basicland-*). costSymbols is []
//        for a card with no manaCost (a Land).
//   $output("card", cardId)        -> the card record, or "(unknown card id: ...)"
//   $output("cards")               -> array of all 47 card records
//   $output("realms")              -> ["solara","verdant","tide","ember","umbra"]
//   $output("rarities")            -> the five tier names, Field..Ascendant, in order.
//                                     Field is the basic-land card class, not a rarity step,
//                                     and is the one tier with no gem asset.
//   $output("newGame", config)     -> frGameNew(config), or a placeholder string
//   $output("act", state, action)  -> frApplyAction(state, action), or a placeholder
//                                     string if state/action is too malformed for even
//                                     frApplyAction's own guard clauses to absorb (e.g.
//                                     state is not an object at all -- frApplyAction
//                                     already guards a malformed ACTION, not a malformed
//                                     STATE; this op closes that gap, see NOTES.md).
//                                     A castSpell action on an X-cost card takes an
//                                     `x` field (a non-negative integer; X=0 is the
//                                     default when omitted). The engine pays x * xCount +
//                                     the fixed symbols from the floating mana pool and
//                                     records the chosen value on the stack entry as
//                                     `x`, so effects can read it. A castSpell action on
//                                     a targeting card takes `targets` (an ordered array
//                                     of object ids and/or player indices) and, on a
//                                     modal card, `mode` (one of the declared "Choose
//                                     one" mode names) -- both are validated against the
//                                     card's declared targeting and recorded on the
//                                     stack entry for the resolution effect.
//   $output("state", state)        -> a defensively cloned, JSON-safe copy of state, or
//                                     "(invalid state)" if it cannot be round-tripped
//   $output("legalActions", state) -> frLegalActions(state) -- see its own comment; []
//                                     on a malformed/missing state
//   $output("asset", id)           -> that asset's rebuilt SVG string, or
//                                     "(unknown asset id: ...)"
//   $output("assets")              -> array of all 52 asset ids
//   $output("gem", cardIdOrRarity) -> the gem SVG for that card's (or that literal
//                                     rarity's) tier, or "(unknown card id or rarity:
//                                     ...)" / "(no gem for rarity: Field)" -- added B11
//   $output("cost", manaCost)      -> frCostSymbols(manaCost) -- an ordered array of
//                                     { symbol, assetId, svg[, parts] }; [] for an
//                                     unparseable cost string -- added B11
//
// Any other op -- including null, undefined, {}, 42, "", [], or a deeply nested object --
// returns "(unknown op: ...)" rather than throwing. Matched against card-deck-plugin's own
// 11-hostile-input contract; see tools/five-realms-plugin.test.mjs.

$output(op, a, b, c, d, e) =>
  if(!window.FIVE_REALMS_PAYLOAD) frInitPayload();

  if(op === "render") return frRenderCard(a);

  if(op === "card") {
    let card = frCardGet(a);
    if(!card) return "(unknown card id: " + String(a) + ")";
    return card;
  }

  if(op === "cards") return Object.values(frActiveCardDb());

  if(op === "realms") return frRealmList();

  if(op === "rarities") return frRarityList();

  if(op === "newGame") {
    try { return frGameNew(a); }
    catch(e) { return "(could not start a new game: " + String(e && e.message) + ")"; }
  }

  if(op === "act") {
    try { return frApplyAction(a, b); }
    catch(e) { return "(could not apply action: " + String(e && e.message) + ")"; }
  }

  if(op === "state") {
    try { return frCloneState(a); }
    catch(e) { return "(invalid state)"; }
  }

  if(op === "legalActions") return frLegalActions(a);

  if(op === "asset") {
    let asset = frAssetGet(a);
    if(!asset) return "(unknown asset id: " + String(a) + ")";
    return frAssetBuild(asset);
  }

  if(op === "assets") return frAssetList();

  if(op === "gem") {
    let rarityNames = frRarityList();
    let rarity = null;
    if(typeof a === "string" && rarityNames.indexOf(a) !== -1) {
      rarity = a;
    } else {
      let card = (typeof a === "string") ? frCardGet(a) : a;
      if(card && typeof card === "object" && typeof card.rarity === "string") {
        rarity = card.rarity;
      }
    }
    if(!rarity) return "(unknown card id or rarity: " + String(a) + ")";
    let gemId = frGemAssetIdForRarity(rarity);
    if(!gemId) return "(no gem for rarity: " + rarity + ")";
    let asset = frAssetGet(gemId);
    if(!asset) return "(unknown asset id: " + gemId + ")";
    return frAssetBuild(asset);
  }

  if(op === "cost") return frCostSymbols(a);

  return "(unknown op: " + String(op) + ")";
