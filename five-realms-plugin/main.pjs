    },
    // X-cost fixtures -- the four spell forms the mana engine must cast: {X} and {X}{X}
    // costs, both speeds. Their hardcoded cmc counts X as 0 (spec section 5), the same way
    // frManaParseCost computes it. rulesText is flavor: the engine exposes the chosen x on
    // the stack entry ({ kind:"spell", ..., x }) for a consumer's effect to use.
    "solara-benediction": {
      id: "solara-benediction",
