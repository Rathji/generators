$meta
  title = Risk
  description = Classic Risk — the game of world domination. Reinforce your armies, attack neighboring territories with dice, hold entire continents for bonus troops, and conquer every territory on the map. Solo vs AI, hot-seat with friends, or online multiplayer.
  tags = risk, board game, strategy, dice, world domination, multiplayer, turn-based
  image = https://user.uploads.dev/file/be9a4a1b39d76e2e96f14905e3f64f5b.jpg
  header
    mode = minimal

kv = {import:kv-plugin}
createServerSocket = {import:server-plugin}

hubUrl = https://perchance.org/bgn-boardgame-network

// ── BRANDING (read by the engine at boot — see the "TEMPLATE CONFIG" block in index.html) ──
templateName = BGN Strategy Template
gameTitle = Risk
gameSubtitle = THE GAME OF WORLD DOMINATION
tagline = Six armies clash for control of the globe. Reinforce your territories, roll the dice to attack your neighbors, and hold whole continents for bonus armies. The last general standing — or the first to hold every territory — wins.
heroImage = https://user.uploads.dev/file/be9a4a1b39d76e2e96f14905e3f64f5b.jpg
gameTagline = Reinforce, attack with dice, hold continents for bonus armies — and conquer the world.
gameKicker = CLASSIC STRATEGY BOARD GAME
gameGenre = Strategy
gamePlayers = 2-6
accentColor = #e6b320
maxPlayers = 6
