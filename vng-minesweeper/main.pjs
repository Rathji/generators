// ============================================================================
//  VGN GENERIC TEMPLATE  (slug: vgn-generic-template)
//  ============================================================================
//  The official generic starter framework for the Video Game Network (VGN).
//  Hub: https://perchance.org/vgn-video-game-network
//
//  WHAT THIS FILE IS
//  ----------------------------------------------------------------------------
//  main.pjs is the generator's "control panel". Everything defined here at the
//  top level becomes a global on the page, readable from src/main.js via
//  `window.root.<name>` — so this is where you tweak branding, tuning numbers
//  and player-facing text WITHOUT touching JavaScript.
//
//  WHAT THIS FILE IS NOT
//  ----------------------------------------------------------------------------
//  All game code lives in src/ as real ES modules (see index.html for the big
//  "HOW TO BUILD YOUR GAME" write-up). The bundled example game is in
//  src/examplegame.js and is 100% replaceable — see the Game Module API there.
//  ============================================================================


$meta
  title = VGN Generic Template
  description = The official generic starter framework for the Video Game Network. A polished CRT/arcade shell — boot sequence, attract screen, fixed-timestep game loop, state machine, keyboard + pause, WebAudio chiptune engine, responsive retina canvas, high scores, How-to-Play — plus a tiny grab-the-coins example game you can delete and replace with your own genre (platformer, shooter, RPG, puzzle, strategy, text adventure...). Fork it and ship your game on VGN.
  tags = template, vgn, video game network, game framework, starter, crt, arcade, retro, chiptune, canvas, generic
  image = https://user.uploads.dev/file/61c4cf71796e025fd70b5d3e2c0b1e04.jpg


// ============================================================================
//  CONFIG  —  edit this list to brand and tune your game
//  ----------------------------------------------------------------------------
//  Every value below is read at boot by src/main.js (see the `cfg()` helper).
//  Strings stay strings; numbers and booleans are parsed automatically.
//  Add your own settings here too — src/main.js can read anything.
//  ============================================================================
config
  // -- Branding -------------------------------------------------------------
  gameTitle = VGN GENERIC TEMPLATE      // shown on the title screen
  tagline = Plug in any game. Ship it on VGN.   // subtitle under the title
  coinPrompt = INSERT COIN ▶ PRESS START         // the classic arcade invite

  // -- VGN network (do not change the hub URL — it's a Beta requirement) ----
  backHubUrl = https://perchance.org/vgn-video-game-network
  backHubLabel = RETURN TO VGN HUB

  // -- Platform -------------------------------------------------------------
  highScoreKey = vgn-generic-template-best   // localStorage key for hi-score
  titleCfg = vgn-generic-template            // small slug shown in the footer

  // -- Tuning the example game (moved here so tuning lives in one place) ----
  exampleGameEnabled = true                  // set false and the shell runs with no game
  exampleTimerSeconds = 60                   // coin-grab run length
  exampleCoinScore = 100                     // points per coin

  // -- Player-facing "How to Play" body (shown in the How-To overlay) ------
  howToPlay
    Move — ARROWS / WASD
    Jump — SPACE / UP / W / Z
    Pause — P / ESC
    Objective — grab every coin you can before the clock hits 0.
    $output = [this.joinItems("\n")]
