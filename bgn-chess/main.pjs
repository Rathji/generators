// ─────────────────────────────────────────────────────────────
//  BGN CHESS — main.pjs
//  Page config + the server-plugin import that powers online
//  play. The whole game (rules engine, UI, online client) lives
//  in index.html.
// ─────────────────────────────────────────────────────────────

$meta
  title = BGN Chess
  description = Classic chess for two players — hotseat on one screen, against a crafty AI, or live online over the Boardgame Network. Castling, en passant, promotion, checkmate, and the 50-move rule.
  tags = chess, board game, strategy, two player, multiplayer, online
  image = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

hubUrl = https://perchance.org/bgn-boardgame-network  // ← SET THIS to your network hub's URL
gameTitle = BGN Chess
gameTagline = Classic chess — hotseat, vs the machine, or live over the network.
gameKicker = Move · Sacrifice · Checkmate
gameGenre = Board
gamePlayers = 2 players
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

createServerSocket = {import:server-plugin}
