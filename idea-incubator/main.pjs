$meta
  title = Idea Incubator
  description = Paste a rough, half-formed idea and incubate it into a sharp, tested concept. Deep research briefs, a live interviewer panel that pressure-tests your assumptions, competitive landscape analysis, and a final refined blueprint you can copy or share.
  image = https://user.uploads.dev/file/5ac651c7bd6241f62789a53bb5549a82.jpg
  tags = idea, startup, incubator, research, interview, competitive analysis, product
  header
    mode = minimal

superFetch = {import:super-fetch-plugin}
generateText = {import:ai-text-plugin}
uploadPlugin = {import:upload-plugin}

// ============================================================================
//  IDEA INCUBATOR  —  CONFIGURATION
// ============================================================================
//
//  Everything static on the page lives in the `config` list below. The page
//  renders from it, and the settings panel (gear button, bottom-right) can
//  be used to preview colors, scan a website for brand-matching color
//  schemes, edit copy, and import/export the whole configuration as JSON.
//
//  The user's actual work — their idea, research brief, interview and
//  competitive analysis — is stored per-browser (localStorage) and can be
//  exported from the Workbench's Blueprint step (full JSON + markdown).
//
//  ── JSON import/export format ─────────────────────────────────────────────
//  The exported JSON mirrors this structure exactly. Imports may be PARTIAL —
//  any missing field falls back to these defaults.
//
//  {
//    schemaVersion: "1.1.0",
//    branding:  { companyName, companyShortName, logoGlyph, tagline, footerText },
//    theme:     { mode, accentStyle, radius, fontSize, fontFamily, reduceMotion },
//    colors:    { primary, secondary, accent, background, surface, text, textMuted },
//    product:   { name, badge, headline, headlineAccent, subheadline,
//                 primaryCta, primaryCtaUrl, secondaryCta, secondaryCtaUrl },
//    copy:      { heroEyebrow, heroTitle, heroTitleAccent, heroSub, ideaEyebrow, ... },
//    interviewers: [ { id, name, role, focus, avatar }, ... ],
//    admin:     { showSettingsButton }
//  }
// ============================================================================

config
  schemaVersion = 1.1.0

  // ── Branding ─────────────────────────────────────────────────────────────
  branding
    companyName = Idea Incubator    // header, footer, copyright
    companyShortName = Incubator    // compact variant for narrow screens
    logoGlyph = I                   // monogram shown in the logo mark
    tagline = Where rough ideas hatch into products.
    footerText = © \{year\} \{companyName\}. All rights reserved.

  // ── Visual theme ─────────────────────────────────────────────────────────
  theme
    mode = light                      // light | dark
    accentStyle = gradient            // gradient | solid
    radius = 16                       // corner radius in px
    fontSize = 16                     // base text size in px (15 small · 16 normal · 18 large)
    fontFamily = lato                 // lato | inter | roboto | open-sans | source-sans | ibm-plex |
                                      //   dm-sans | manrope | montserrat-lato | playfair-lato | merriweather-inter
    reduceMotion = false              // true disables animations & transitions

  // ── Brand palette (hex) ──────────────────────────────────────────────────
  colors
    primary = #7c3aed                 // violet — brand color, buttons, links, highlights
    secondary = #a78bfa               // soft violet — gradients, avatars, chips
    accent = #4c1d95                  // deep violet — small details, badges
    background = #f7f5fc              // page background
    surface = #ffffff                 // cards & panels
    text = #221c35                    // main text
    textMuted = #6b7280               // secondary text

  // ── Product / hero ───────────────────────────────────────────────────────
  product
    name = Idea Incubator
    badge = Idea incubation studio
    headline = Turn a rough idea into a sharp one.
    headlineAccent = sharp one.       // word(s) highlighted in the brand gradient
    subheadline = Paste any half-formed idea and run it through deep research, a live interviewer panel and a competitive landscape — until you hold a refined, tested, defensible concept.
    primaryCta = Start incubating an idea
    primaryCtaUrl = #idea
    secondaryCta = See how it works
    secondaryCtaUrl = #how
    status = Free · no signup          // small status chip under the CTAs (empty to hide)

  // ── Editable page copy ───────────────────────────────────────────────────
  copy
    heroEyebrow = Paste an idea. Incubate it into a product.
    howEyebrow = The method
    howTitle = One idea, four stages
    howLede = Each stage does one job: gather evidence, pressure-test assumptions, map the field, then write the sharpened concept. Run them in order or revisit any of them anytime.
    ideaEyebrow = Step 1 · Your idea
    ideaTitle = Start with the raw spark
    ideaLede = Describe your idea exactly as it is — messy is fine. The less you polish it here, the more the incubator has to work with.
    ideaProblemLabel = What problem does it solve? (optional)
    ideaAudienceLabel = Who is it for? (optional)
    ideaTitleLabel = Working name (optional)
    ideaStartBtn = Into the incubator →
    researchEyebrow = Step 2 · Research
    researchTitle = Deep-dive research brief
    researchLede = A research analyst studies your idea: the problem, the landscape, the audience, the assumptions it rests on — and what you should validate first. Then keep digging with follow-up questions.
    researchRunBtn = Run research
    researchDigLabel = Dig deeper (ask a follow-up question)
    researchDigBtn = Research this
    interviewEyebrow = Step 3 · Interview
    interviewTitle = Live interviewer panel
    interviewLede = A panel of fictional but fierce interviewers grills you about the idea, one question at a time — an investor, a target customer, a domain expert and a critical friend. Answer honestly; the panel records what it learns.
    interviewPanelLabel = Panel
    interviewRoundsLabel = Rounds
    interviewStartBtn = Start the interview
    interviewAnswerBtn = Answer & continue
    interviewEndBtn = Wrap up & debrief
    compareEyebrow = Step 4 · Compare
    compareTitle = The competitive landscape
    compareLede = A competitive strategist maps similar products and ideas, what they do well, where they fall short — and where yours can win. Then ask it to dig into specific competitors or angles.
    compareRunBtn = Map the landscape
    compareDigLabel = Compare deeper (a specific competitor or angle)
    compareDigBtn = Compare this
    blueprintEyebrow = Step 5 · Blueprint
    blueprintTitle = Your refined idea blueprint
    blueprintLede = Everything the incubator learned is distilled into one sharp, polished concept: pitch, problem, solution, target user, differentiators, risks and a 30-day validation plan. This is your deliverable.
    blueprintRunBtn = Hatch the blueprint
    blueprintNote = The blueprint draws on your idea, research, interview and competitive analysis. Run the earlier steps first for the strongest result.

  // ── Research areas the analyst always covers ─────────────────────────────
  researchAreas = [["what the idea is","the real problem & who feels it","the landscape & adjacent solutions","target audience & willingness to pay","key assumptions","biggest risks & open questions","what to validate first"]]

  // ── Interviewer panel ────────────────────────────────────────────────────
  interviewers
    investor
      name = Maya Chen
      role = Venture partner
      focus = Market size, business model, defensibility, team
      avatar = MC
    customer
      name = Theo Rivera
      role = Target customer
      focus = Real pain, how they solve it today, willingness to pay
      avatar = TR
    expert
      name = Dr. Amara Osei
      role = Domain expert
      focus = Technical and industry feasibility, blind spots
      avatar = AO
    critic
      name = Sam Novak
      role = Critical friend
      focus = Logical holes, weak assumptions, contrarian angles
      avatar = SN

  // ── Editor / admin behavior ──────────────────────────────────────────────
  admin
    showSettingsButton = true
