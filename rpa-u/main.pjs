$meta
  title = RPA-U — Project U integration hub
  description = The integration hub for the Project U family of small-business generators. RPA-U gives IT-U, CRM-U, PSA-U and RMM-U one canonical identity, a shared integration registry with field ownership and sync rules, a versioned event bus, cross-tool entity linking, drift-aware sync, exportable data bundles, and connector monitoring — now with an OpenRPA / OpenFlow connector for agentic RPA automation.
  tags = integration hub, project u, it-u, crm-u, psa-u, rmm-u, openrpa, openflow, rpa, automation, identity, event bus, registry, sync, dashboard
  header
    mode = minimal

// ============================================================================
//  RPA-U — BOOT CONFIGURATION
// ----------------------------------------------------------------------------
//  Declarative configuration read by src/framework/config.js at startup.
//  Implementation belongs in src/; this block holds identity, branding and
//  tunables only. See src/README.md and src/CUSTOMIZATION.md for what to
//  change when deploying your own hub.
// ============================================================================

kv = {import:kv-plugin}

pu
  appId = rpa-u
  appTitle = RPA-U
  appShortTitle = RU
  tagline = One identity, one registry, every Project U tool
  companyName = Project U
  version = 0.8.0
  storageNamespace = pu-rpa-u
  defaultTheme = navy
  logoMark = RU
  copyright = Project U
  docsUrl = https://perchance.org/template-u

  identity
    enabled = true
    requireSignIn = true
    showSimulator = true
    provider = entra
    tenantId = contoso-demo
    authority = https://login.microsoftonline.com
    scopes = openid, profile, email, offline_access
    defaultRole = viewer
    silentRenewal = true

    appRoles
      RPAU.Administrator = administrator
      RPAU.IntegrationManager = integration_manager
      RPAU.Operator = operator
      RPAU.Auditor = auditor
      RPAU.Viewer = viewer

  branding
    primary = #1e3a8a
    accent = #0d9488
    fontSans = Inter


