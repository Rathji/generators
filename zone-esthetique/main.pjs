// --- STRICT DOM LOGIC ---
default_negative_string = [default_negative.selectAll.join(", ")]

// Dropdown Pre-calculations
html_quality_options = [quality_names.selectAll.map((n, i) => "<option value='" + quality_values.selectAll[i] + "'>" + n + "</option>").join("")]
html_injection_options = [prompt_injections.selectAll.map(p => "<option value='" + p + "'>" + p + "</option>").join("")]
html_gender_options = [gender_list.selectAll.map(g => "<option value='" + g + "'>" + g + "</option>").join("")]
html_env_options = [env_list.selectAll.map(e => "<option value='" + e + "'>" + e + "</option>").join("")]
html_ethnicity_options = [ethnicity_list.selectAll.map(e => "<option value='" + e + "'>" + e + "</option>").join("")]
html_pose_options = [pose_list.selectAll.map(p => "<option value='" + p + "'>" + p + "</option>").join("")]

// Export Defaults
