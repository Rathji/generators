$meta
  title = Company Knowledge Base
  description = A knowledge base and SOP system for authoring, reviewing, and publishing company documentation — SOPs, policies, how-tos, references and FAQs — with approval workflows, version history, scheduled reviews, and machine-readable export for your AI assistants.
  tags = knowledge base, SOP, documentation, business, wiki, policies, procedures
  header
    mode = minimal

// ============================================================================
//  KNOWLEDGE BASE / SOP SYSTEM — BOOT CONFIGURATION
// ============================================================================
//  This generator is a documentation (KB/SOP) system. `kb` below holds the
//  boot defaults the app reads on startup. The majority of editable content
//  (articles, categories, templates, review scheduling) lives in the app's own
//  versioned document store once it is built, not here.
//
//  The build follows roadmap.pjs (project root) — an atomic task checklist.
// ============================================================================

kv = {import:kv-plugin}            // local cache + cached edit keys (document store)
uploadPlugin = {import:upload-plugin} // canonical cloud documents (editable files)
generateText = {import:ai-text-plugin} // AI drafting & polish assist (editor)
createServerSocket = {import:server-plugin} // Phase 9: multi-user roles, realtime hub, edit-key sync

kb
  appTitle = Company Knowledge Base
  appShortTitle = Company KB
  tagline = SOPs, policies, how-tos, references & FAQs
  storageNamespace = kb-system

  // Seed category tree, shown in the sidebar. Nested groups go under
  // `subcategories`. Once the category store is built these become editable
  // and are persisted in the document store.
  categories
    c1
      id = operations
      label = Operations
    c2
      id = people
      label = People & HR
    c3
      id = it
      label = IT & Systems
    c4
      id = finance
      label = Finance
    c5
      id = compliance
      label = Compliance & Safety
      subcategories
        c5a
          id = safety
          label = Workplace Safety
        c5b
          id = data-privacy
          label = Data Privacy
