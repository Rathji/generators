$meta
  title = File Format Converter
  description = A Rathji-branded converter that turns pasted text, files, or any URL into clean Markdown or JSON. Powered by Jina Reader for reliable page extraction.
  tags = rathji, converter, markdown, json, url, text
  header
    mode = minimal

