// ============================================================================
//  Plugin Demo Template — a showcase page for a single Perchance plugin.
//
//  This generator is a TEMPLATE. All copy, links and tuning live in the `cfg`
//  list below — edit those values to re-skin the page for any plugin without
//  touching HTML/CSS/JS. The interactive demo logic for the default plugin
//  (github-data-plugin) lives in the <script> at the bottom of index.html; if
//  you swap in a different plugin, update those three step handlers too.
//
//  $meta.header mode = minimal hides the Perchance chrome (a small floating
//  button still exposes save/share/etc.).
// ============================================================================

$meta
  title = github-data-plugin demo — back up & restore your generator
  description = Live interactive demo of the github-data-plugin by rathji: connect a GitHub repo, push your generator's source as a backup, then restore it on any device. Your token never leaves your browser.
  tags = github-data-plugin, plugin demo, backup, rathji
  header
    mode = minimal

// Imports used by the demo. The plugin itself, plus super-fetch: perchance's
// own public API is CORS-blocked from the *.perchance.org output iframe, so
// BOTH perchance API reads (source + html) go through root.superFetch.
// api.github.com and raw.githubusercontent.com work with a plain fetch.
gh = {import:github-data-plugin}
superFetch = {import:super-fetch-plugin}

// ============================================================================
//  CONFIG — edit this list to re-skin the template for another plugin.
//  These values feed both the HTML template ([cfg.key]) and the JS (root.cfg).
//  IMPORTANT: don't use { }, [ ], ^, or "//" inside a value — Perchance treats
//  those as syntax. URLs are fine as-is.
// ============================================================================
cfg
  pluginName = github-data-plugin
  pluginPage = https://perchance.org/github-data-plugin
  pluginPageLabel = plugin page
  tutorialHub = https://perchance.org/rathjis-plugin-tutorials
  tutorialHubLabel = rathji's plugin tutorials
  authorBrand = rathji
  brandMark = R
  brandName = rathji · plugin demos

  heroEyebrow = interactive plugin demo
  heroTitleA = Back up your generator
  heroTitleB = straight to GitHub
  heroSubtitle = An interactive walkthrough of the github-data-plugin by rathji. Connect a repo, push a snapshot of this very generator up to it, then pull it back down on any device — all from your browser, with no servers of your own.
  primaryBtnLabel = Try the demo
  primaryBtnAnchor = #demo
  ghostBtn1Label = plugin page
  ghostBtn2Label = tutorials

  stat1Value = 3
  stat1Label = guided steps
  stat2Value = 1
  stat2Label = commit per push
  stat3Value = 100%
  stat3Label = token stays in your browser

  featureEyebrow = featured
  featureTitle = New to rathji's plugins?
  featureBody = The tutorial hub walks through github-data-plugin and a dozen other plugins — from first import to full backups — with real, copyable examples and common gotchas explained.
  featureBtnLabel = Visit tutorials

  demoSectionEyebrow = the demo
  demoSectionTitle = Try it right now
  demoSectionCount = 3 steps
  demoPanelHint = Everything below runs against the real plugin and the real GitHub API — no mockups, no fake data.

  step1Eyebrow = step 01
  step1Title = Connect
  step1Subtitle = Point the plugin at a GitHub repo and store a fine-grained token. The repo may be private or public — pushing always needs a token scoped to it with Contents: Read and write, plus an expiry date.
  repoInputLabel = owner/repo
  repoPlaceholder = octocat/Hello-World
  tokenInputLabel = fine-grained token
  tokenPlaceholder = github_pat_...
  saveTokenBtn = Save token
  clearTokenBtn = Clear
  securityNote = The token is stored only in this browser's localStorage via the plugin's setToken and sent only to api.github.com. It is never hardcoded, never logged, and never leaves your machine. Anyone who gets hold of it can write to your repo — treat it like a password.

  step2Eyebrow = step 02
  step2Title = Backup → GitHub
  step2Subtitle = One click fetches this generator's main.pjs and index.html through the Perchance API and pushes them to your repo as a single commit.
  backupBtn = Back up this generator
  backupHint = Files land in your-repo/<generator-name>/main.pjs and index.html — one folder per generator, so a single repo can hold backups of many generators.

  step3Eyebrow = step 03
  step3Title = Restore ← GitHub
  step3Subtitle = Pull the backup back down and download the files. Reads go to raw.githubusercontent.com, so restoring from a public repo needs no token at all.
  restoreBtn = Restore from GitHub
  restoreEmptyNote = Nothing to restore yet. Run step 2 first, or point step 1 at a repo that already holds a <generator-name>/ folder (older flat backups at the repo root are found too).
  previewLabel = preview
  downloadMainBtn = ⬇ main.pjs
  downloadHtmlBtn = ⬇ index.html

  footerCredit = Demo template built around the github-data-plugin by rathji
