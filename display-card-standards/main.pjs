// ═══════════════════════════════════════════════════════════════════════════
// DISPLAY-CARD-STANDARDS — the house standard for Rathji's project cards
// ═══════════════════════════════════════════════════════════════════════════
//
// This generator defines what a "beautiful display card" is for the projects
// listed on https://perchance.org/rathjis-generators, and how to detect cards
// that still show only a simple emoji icon instead of a real banner graphic.
//
// The AI helper for rathjis-generators reads this page for instructions. The
// copyable component below (displayCard) is the template those instructions
// point at — drop it into any generator's main.pjs and it works, same spirit
// as rathji-template.
//
//   Call from a list:   [displayCard(displayCardOpts)]
//   Call from a script: cardCtn.innerHTML = displayCard({title:"...", image:"..."});
//
// More generators by Rathji: https://perchance.org/rathjis-generators
// ═══════════════════════════════════════════════════════════════════════════

$meta
  title = display-card-standards
  description = The house standard for Rathji's project cards — what a beautiful display card requires, how to detect cards that still show only a simple emoji icon, and copyable instructions for the rathjis-generators AI helper to upgrade them.
  tags = rathji, standards, cards, display cards, instructions, audit
  header
    mode = minimal

superFetch = {import:super-fetch-plugin}

// ── 1. OPTIONS LISTS (same pattern as rathji-template) ────────────────────

// A single options node: pass it to displayCard() and it reads every key.
displayCardOpts
  title = The Realm
  text = A real-time multiplayer action RPG — create a hero and hunt monsters in a shared fantasy world.
  image = https://user.uploads.dev/file/304c0949839eae0777aafcd53ffa897e.jpg
  icon = 🗡️
  color = #a78bfa
  url = https://perchance.org/the-realm
  tags = rpg, multiplayer, action

// A list of preset options nodes. Pass the whole list and displayCard() picks
// a random item — a handy way to preview themes.
displayCardPresets
  realm
    title = The Realm
    text = A real-time multiplayer action RPG — create a hero, hunt monsters in a shared fantasy world.
    image = https://user.uploads.dev/file/304c0949839eae0777aafcd53ffa897e.jpg
    icon = 🗡️
    color = #a78bfa
    url = https://perchance.org/the-realm
    tags = rpg, multiplayer, action
  starfarer
    title = Starfarer
    text = An endless arcade runner — outrun the nova in a starship that handles like a dream.
    image = https://user.uploads.dev/file/1002bad7c4b339fae4ab00b664c4167f.jpg
    icon = 🚀
    color = #38bdf8
    url = https://perchance.org/vgn-video-game-network
    tags = arcade, space, retro

// ── 2. HELPERS ─────────────────────────────────────────────────────────────

// Read any value through .evaluateItem so Perchance lists work anywhere a
// plain value would (same helper as rathji-template).
displayCardResolve(v) =>
  if(v == null) return v;
  try {
    if(v.evaluateItem !== undefined) return v.evaluateItem; // pjs node → its evaluated value
  } catch(e) {}
  return v; // raw JS value → as-is

// Injects the card CSS once. The card HTML alone is useless without it, so the
// entry point calls this automatically — no setup step for the person copying
// the component in.
displayCardEnsureCss() =>
  if(typeof document === "undefined" || document.getElementById("dc-card-style")) return;
  let style = document.createElement("style");
  style.id = "dc-card-style";
  style.textContent =
    '.dc-card{position:relative;display:flex;flex-direction:column;gap:12px;overflow:hidden;border-radius:18px;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.045);padding:0;text-decoration:none;color:inherit;font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;transition:transform .18s,border-color .18s,box-shadow .18s,background .18s;isolation:isolate;text-align:left}' +
    '.dc-card:hover{transform:translateY(-5px);background:rgba(255,255,255,.075);box-shadow:0 18px 50px -20px rgba(0,0,0,.6);border-color:rgba(255,255,255,.16)}' +
    '.dc-media{position:relative;aspect-ratio:16/9;overflow:hidden;background:linear-gradient(135deg,color-mix(in srgb,var(--dc,#7c6cff) 30%,#0a0c11),#0a0c11)}' +
    '.dc-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .3s ease}' +
    '.dc-card:hover .dc-media img{transform:scale(1.05)}' +
    '.dc-fallback{position:absolute;inset:0;display:grid;place-items:center;font-size:3rem;line-height:1}' +
    '.dc-badge{position:absolute;top:10px;right:10px;z-index:2;font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--dc,#7c6cff);border:1px solid color-mix(in srgb,var(--dc,#7c6cff) 45%,transparent);padding:3px 9px;border-radius:999px;background:color-mix(in srgb,var(--dc,#7c6cff) 12%,rgba(10,12,17,.75))}' +
    '.dc-body{display:flex;flex-direction:column;gap:9px;padding:4px 20px 18px}' +
    '.dc-body h3{margin:0;font-size:17.5px;letter-spacing:-.01em;line-height:1.3;font-weight:700}' +
    '.dc-body p{margin:0;color:#98a1b3;font-size:14px;line-height:1.55;flex:1}' +
    '.dc-tags{display:flex;flex-wrap:wrap;gap:6px}' +
    '.dc-tag{font-size:11.5px;font-weight:500;color:#6b7283;background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.09);padding:3px 9px;border-radius:7px}' +
    '.dc-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:2px}' +
    '.dc-url{font-size:12.5px;color:#6b7283;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}' +
    '.dc-arrow{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;flex-shrink:0;border:1px solid rgba(255,255,255,.09);background:rgba(255,255,255,.045);transition:all .18s}' +
    '.dc-card:hover .dc-arrow{background:color-mix(in srgb,var(--dc,#7c6cff) 22%,transparent);border-color:color-mix(in srgb,var(--dc,#7c6cff) 55%,transparent)}' +
    '.dc-card:hover .dc-arrow svg{transform:translate(2px,-2px)}' +
    '.dc-arrow svg{transition:transform .18s}';
  document.head.appendChild(style);

// Renders one card. Returns plain HTML; called by displayCard() (and directly
// by rathjis-generators' cardHTML replacement if desired).
displayCardStamp(o) =>
  let color = o.color || "#7c6cff";
  let title = o.title || "";
  let text = o.text || o.desc || "";
  let url = o.url || "";
  let badge = o.badge ? '<span class="dc-badge">' + o.badge + "</span>" : "";
  let image = typeof o.image === "string" && o.image.trim() ? o.image.trim() : "";
  let icon = o.icon || "✨";
  let tags = Array.isArray(o.tags) ? o.tags : (typeof o.tags === "string" && o.tags.trim() ? o.tags.split(",").map(function(s){return s.trim();}) : []);
  let host = url.replace(/^https?:\/\//, "").replace(/\/$/, "");
  let media =
    '<div class="dc-media" style="--dc:' + color + '">' +
    '<span class="dc-fallback">' + icon + "</span>" +
    (image ? '<img src="' + image + '" alt="" loading="lazy" onerror="this.style.opacity=0">' : "") +
    badge +
    "</div>";
  let tagHtml = tags.map(function(t){ return '<span class="dc-tag">' + t + "</span>"; }).join("");
  let foot = url
    ? '<span class="dc-url">' + host + '</span><span class="dc-arrow"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg></span>'
    : '<span class="dc-url" style="color:#6b7283">Placeholder — coming soon</span>';
  let body =
    '<div class="dc-body">' +
    "<h3>" + title + "</h3>" +
    (text ? "<p>" + text + "</p>" : "") +
    (tagHtml ? '<div class="dc-tags">' + tagHtml + "</div>" : "") +
    '<div class="dc-foot">' + foot + "</div>" +
    "</div>";
  let inner = media + body;
  return url
    ? '<a class="dc-card" href="' + url + '" target="_blank" rel="noopener" style="--dc:' + color + '">' + inner + "</a>"
    : '<div class="dc-card" style="--dc:' + color + '">' + inner + "</div>";

// ── 3. ENTRY POINT ─────────────────────────────────────────────────────────
// Accepts, all through ONE function (same call patterns as rathji-template):
//   displayCard("Hi")
//   displayCard("Hi", { image:"...", color:"#f00" })
//   displayCard({ title:"Hi", image:"...", url:"..." })
//   displayCard(displayCardOpts)          options read from a list node
//   displayCard(displayCardPresets)       a LIST of options → picks a random one
//
// Never throw — return a readable "(...)" placeholder on bad input.

displayCard(input, opts) =>
  // A LIST of preset options (displayCardPresets) has items but no `.title`
  // key — pick a random item first. A single options node, an options object,
  // or a plain value all keep their own `.title` (or none at all).
  if(input != null && input.title === undefined && input.selectOne != null) {
    let item = null;
    try { item = input.selectOne; } catch(e) {}
    if(item != null && item !== input && item.title !== undefined) input = item;
  }

  let o = {};
  if(opts != null) {
    o.title = displayCardResolve(input);
    o.text = displayCardResolve(opts.text) || displayCardResolve(opts.desc);
    o.image = displayCardResolve(opts.image);
    o.icon = displayCardResolve(opts.icon);
    o.color = displayCardResolve(opts.color);
    o.url = displayCardResolve(opts.url);
    o.tags = displayCardResolve(opts.tags);
    o.badge = displayCardResolve(opts.badge);
  } else if(input != null && input.title !== undefined) {
    o.title = displayCardResolve(input.title);
    o.text = displayCardResolve(input.text) || displayCardResolve(input.desc);
    o.image = displayCardResolve(input.image);
    o.icon = displayCardResolve(input.icon);
    o.color = displayCardResolve(input.color);
    o.url = displayCardResolve(input.url);
    o.tags = displayCardResolve(input.tags);
    o.badge = displayCardResolve(input.badge);
  } else {
    o.title = displayCardResolve(input);
    o.text = displayCardResolve(input);
  }

  if(typeof o.title !== "string" || !o.title.trim()) {
    return "(displayCard: expected a title — got " + JSON.stringify(displayCardResolve(input)) + ")";
  }

  displayCardEnsureCss();
  return displayCardStamp(o);

// ── 4. THE STANDARD (canonical spec, machine + human readable) ─────────────
// The rathjis-generators AI helper should treat this object as the definition
// of "upgraded". Read it with:  displayCardStandard.evaluateItem

displayCardStandard
  name = display-card-standard
  version = 1
  requirement = A project card is UPGRADED when its entry in the rathjis-generators PROJECTS object has an "image" field containing a hosted image URL (the banner graphic). A card is ICON-ONLY when it has only an "icon" (emoji) and no "image"/"img" field.
  graphicSources = Prefer the linked generator's own $meta.image (via getGeneratorStats?names=<slug> → data[0].metaData.image). If none exists, generate a fitting banner with the text-to-image-plugin and host it via the upload-plugin.
  fields = image, icon (fallback), title, desc, url, tags, badge (optional), color (accent)
