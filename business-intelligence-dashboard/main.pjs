$meta
  title = Business Intelligence Dashboard
  description = Reporting cockpit for the small-business pipeline. Pulls every tool's bundles from the shared bus, normalizes them into uniform metrics, and renders live dashboards and reports. Never a source of truth — every number traces back to the tool that owns it.
  tags = business intelligence, reporting, dashboard, analytics, bi, metrics
  header
    mode = minimal

// Plugins used by the BI system (see src/README.md):
//   charts           — data-visualization-plugin: every chart is a responsive SVG string
//   uploadPlugin     — canonical document store + published backup/snapshot bundles
//   superFetch       — pulling tool bundles from the bus (bypasses CORS)
//   generateText     — snapshot-bundle Q&A for the AI assistant
//   createServerSocket — realtime hub: source-refresh broadcasts + live doc updates
charts = {import:data-visualization-plugin}
uploadPlugin = {import:upload-plugin}
superFetch = {import:super-fetch-plugin}
generateText = {import:ai-text-plugin}
createServerSocket = {import:server-plugin}

// ============================================================================
//  BI CONFIG — shell-level configuration, read at boot by src/bi/app.js.
//  The bus + realtime sections drive the data integration layer; module list
//  controls the sidebar. Report / dashboard definitions live in the canonical
//  document store (and the built-in presets in src/bi/reporting.js).
// ============================================================================

biConfig
  appName = Business Intelligence
  appShort = BI
  tagline = Reporting cockpit
  defaultModule = dashboards
  store
    ceilingBytes = 1048576 // canonical document store ceiling (1 MiB) — no write may exceed it
  bus
    manifestUrl = src/bi/fixtures/manifest.json // shared pipeline manifest (public bundle URL index)
    cadenceMs = 21600000 // 6 h — how fresh published data is expected to stay
    stalenessMs = 108000000 // 30 h — cached bundle considered stale beyond this
  realtime
    hubEnabled = true // false → straight polling, no hub connection attempt
    pollFallbackMs = 45000 // poll cadence when the hub is unreachable
  modules
    dashboards
      label = Dashboards
      icon = layout
      description = Curated views over your key metrics — cash position, pipeline, utilization, and health — each drilling into its module's report.
    reports
      label = Reports
      icon = chart
      description = Saved report definitions, templates, and one-off analyses across every tool on the bus.
    dataSources
      label = Data Sources
      icon = cloud
      description = Every participating tool, its published bundle types, freshness, and health.
    schedules
      label = Schedules
      icon = clock
      description = Refresh cadences, exports, and recurring deliveries.
    settings
      label = Settings
      icon = gear
      description = Storage capacity, backup & restore, snapshot publishing, roles & realtime, and data-integrity health.
