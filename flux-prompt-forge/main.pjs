generateImage = {import:text-to-image-plugin}
generateImage1 = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}
generateText1 = {import:ai-text-plugin}
remember = {import:remember-plugin}
favicon = {import:favicon-plugin}

// Note: Text that comes after "//" is ignored.

$meta 
  title 
    Flux Prompt Forge - Dual-Flow Prompt Optimizer for Flux.1 Schnell
  description
    Improve Flux.1 Schnell performance with this specific prompt creator: optimized T5-XXL and CLIP-L prompts with numeric weighting, two parallel flows to compare. Modified fork of the original by Perchance.org/laia. 
  image = https://user.uploads.dev/file/9275d0e5f06590139d2c7185ea27fca6.jpg
  header 
    mode = minimal 
    background = #121212

output
  [app]

