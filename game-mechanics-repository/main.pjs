// ── Game Mechanics Repository ─────────────────────────────────────
// All repo data lives here; index.html renders it automatically.
//
// HOW TO ADD A NEW GAME:
//   Copy the `village-sim` block below, paste it under `games`, and
//   replace the contents. Each entry needs:
//     id, title, category, status, date, tagline, summary, tags,
//     stats (item blocks with label/value), and sections
//     (a title property + a bullets list of plain items).
//   Categories/statuses are free-form — see `repo.organization` for
//   the recommended sets. Keep flavor (story/lore/names) out; this
//   repo catalogs MECHANICS so systems can be reused and compared.
//   IMPORTANT: the entry title must describe the MECHANICS (e.g.
//   "Farming & Life-Sim"), never name the game itself.
//
//   NOTE: bullets must be PLAIN items (no `key = ` prefix), or the
//   UI won't see them — pjs treats `key = value` lines as properties,
//   not list items.
// ──────────────────────────────────────────────────────────────────

repo
  title = Game Mechanics Repository
  subtitle = A living archive of game systems, mechanics, and design ideas

  organization
    about = This repository catalogs game ideas as structured mechanic inventories. Content and flavor (story, lore, names) are deliberately excluded so the systems can be reused, compared, and cross-pollinated between projects.
    categories = Simulation & Management, RPG & Narrative, Strategy & Tactics, Puzzle & Logic, Action & Sandbox, Multiplayer & Social, Experimental
    statuses = Concept, Prototype, Complete, Archived

  games
    village-sim
      id = village-sim
      title = Village Sim
      category = Simulation & Management
      status = Complete
      date = 2026-08-31
      tagline = A day-by-day village simulation with fully simulated villagers and a deep web of economy, buildings, and progression.
      summary = Guide a single village through real calendar years: feed and house a population of individually simulated villagers, work every resource from wheat to whisky, and grow from a handful of huts into a fortified town through buildings, trade, research, festivals, and defence. Every day is a full simulation pass, then the state auto-saves and the UI re-renders.
      tags = simulation, colony, economy, calendar, population, buildings, trade, research, defence
      stats
        item
          label = Building types
          value = 1238
        item
          label = Resources
          value = 512
        item
          label = Occupations
          value = 31
        item
          label = Villager personas
          value = 53
        item
          label = Festivals
          value = 120
        item
          label = Research items
          value = 66
        item
          label = Achievements
          value = 65
        item
          label = Random events
          value = 82
        item
          label = Holidays
          value = 29
      sections
        core-loop
          title = Core Loop
          bullets
            Day-by-day turn simulation; Next Day button + Skip 3 Days button; every day runs a full simulation then auto-saves and re-renders
            Game-over state (village abandoned) with memorial message and auto-restart scheduling
            Victory condition (unlock the endgame building) + one-time victory screen
            Restart button (confirm dialog, full reset)
        calendar-world
          title = Calendar & World
          bullets
            Real 365/366-day calendar (12 named months, weekdays, leap years) starting 2023
            4 seasons with per-crop output multipliers (season-aware production)
            23 weather types rolled per day, each with gameplay effects, plus weather-mitigating buildings
            Moon phases (30-day cycle) and zodiac: Western + Chinese zodiac assigned per villager/year with gameplay bonuses
            29 fixed holidays on dates (bonuses on those days)
        population
          title = Population Simulation
          bullets
            Individual villagers with: name, gender, age, birthday, personality (53 personas), sexuality (15 orientations), neurodivergence (20 types), disability (28 types), skin tone, occupation (31 occupations), favourite food, pet (23 pet types), lifespan and health modifiers
            Aging on birthdays (child → teen → adult → elder), old-age mortality, sickness/plague with mortality, grief from deaths
            Births (need free cradles + food; birth rate multipliers), immigration (needs beds, food, happiness), foundlings via events
            Per-villager profile panel: full bio, rename villager (name-uniqueness enforced)
            Name generation from large curated name lists + unique-name tracking
        resources-economy
          title = Resources & Economy
          bullets
            512 resources (~253 pinned on the resource bar, ~250 food items, plus a souvenir/merchandise line)
            Every resource: emoji, name, stock, and daily net delta (+/- shown on bar)
            Food is a special aggregate (the "Food stocks" pill) with its own net rate
            Water with daily per-soul consumption
            Gold currency
            Daily ration consumption: priority-ordered food list, waste-reduction via storage buildings
            Production multipliers: global building stack, food, crop, cheese, whisky, dairy, honey, water, mill, wool, workplace-risk, research-driven bonuses
        buildings
          title = Buildings
          bullets
            1238 building types in 38 categories (Shelter, Infrastructure, Farms, Crops, Livestock, Hunt, Timber, Woodcraft, Mining, Industry, Craft, Restaurants, Luxury, Community, River, Roads, Trade, Education, Defence, Law, Health, Maternity, Mortuary, Services, Entertainment, Sports, Children's, Camp, Monuments, Decoration, religious, etc.)
            Category-filtered build UI with search/filter
            Per-building: cost, daily outputs (some consume inputs), job title, prerequisites (req/reqs), alts, per-worker output spec, flex recipes
            3 upgrade levels per building (+35% output each) with escalating costs
            Craft mastery per building (3 stars, +10% each) earned by usage
            Housing capacity, crib capacity (babies don't take beds)
            Buildings can also provide: happiness, defence, unit production, and shared production multipliers
        labour
          title = Labour
          bullets
            Auto-assign workers toggle (smart allocation by worker-value ranking)
            Manual worker assignment per building (+/- buttons, capped by population & allowed types)
            Worker trimming, per-worker outputs, workday effects
        trade
          title = Trade
          bullets
            Market with dynamic demand pool and per-good prices; sell goods for gold
            Merchant requests: random requests to fulfil (reward) or dismiss
            Fixed-price market goods list; souvenir/merchandise store line
        festivals
          title = Festivals & Celebrations
          bullets
            120-festival pool (seasonal); hold festival button with 8-day cooldown; costs rations + gold; bonuses vary (food, gold, happiness, "afterglow", production boost for N days)
            Festival upgrading via buildings
        defence
          title = Defence & Combat
          bullets
            30 recruit-able unit types (militia, archers, pikemen, hounds, guards, gunners, musketeers, cavalry, chariots, ships, siege, aircraft, robots…) — each with cost, unit count, defence value, research/law prerequisites
            Buildings with defence values (walls, towers, castles…)
            Daily threat resolution (wolves/bandits/reivers) against total defence; defence/units pills in header
        progression
          title = Progression
          bullets
            66 research items (prerequisite gating, day duration, permanent bonuses, building unlocks)
            Laws (longer, locked progression unlocks) with enact/effect system
            Village title progression by population
            65 achievements with rewards, tracked panel
            Random events: 82 weighted events with ~80 dedicated handlers (bonuses, disasters, travellers, foundlings, trades…)
        simulation-extras
          title = Simulation Extras
          bullets
            26 "life events" — small daily happiness/resource bumps per villager
            Workplace accidents (risk factor per building, mitigation buildings, messages)
            Buildings disabled when prerequisites/fuel missing (e.g. blacksmithy needs ore+coal)
            Validation/sanitization of state, save migration from older versions
        persistence
          title = Persistence
          bullets
            localStorage auto-save (versioned key), save after every day
            Backup to clipboard (export JSON) + restore from clipboard/paste (import), with validation and confirmation
            Restart; game-over auto-restart; state repair/migration
        ui
          title = UI
          bullets
            Header: village name (click to rename), date line, population/happiness/defence/units pills, manual button
            Resource bar with stock + net delta for every resource
            Panels: buildings, villagers roster, units, research, laws, achievements, event log, request, larder, merchandise (accordions)
            Modal system (message modal with emoji/title/body/auto-close; intro modal; villager profile modal; instruction manual modal with TOC)
            Event log line-by-line
            Keyboard: Escape closes modals
            Error handling: safe-day/safe-run wrappers, window error + unhandledrejection handlers that log "hiccup" messages instead of crashing
            Performance: per-frame caching of expensive values (frameVal cache, signature-diff re-renders)
    farming-life-sim
      id = farming-life-sim
      title = Farming & Life-Sim
      category = Simulation & Management
      status = Complete
      date = 2026-09-01
      tagline = The farming/life-sim standard: timed days across four seasons, crops and animals, and a long tail of skill, social, and exploration unlocks.
      summary = A system-level reference of the farming/life-sim genre loop: a timed day/night cycle over 28-day months and four seasons, energy and inventory management, five levelable skills with profession trees, crops and ranching with quality tiers and automation, plus mining, fishing, combat, friendship, marriage, festivals, and quest progression. Useful as a checklist when designing farming/life-sim games.
      tags = farming, life-sim, crops, ranching, mining, fishing, combat, social, progression, automation
      stats
        item
          label = Seasons per year
          value = 4
        item
          label = Levelable skills
          value = 5
        item
          label = Tool upgrade tiers
          value = 4
        item
          label = Exploration maps
          value = 8
      sections
        core-loops
          title = Core Loops
          bullets
            Day/night cycle with a timed day (in-game clock, 28-day months, 4 seasons/year)
            Energy/stamina system (consumed by actions, exhaustion, food refills)
            Inventory management (slots, stacks, sort, chests, item pickup)
            Money/currency economy + shipping bin (sell harvested/foraged goods overnight)
            Save/load, seasons advance, weather system (rain, storms, lightning, wind, snow, random events)
        skills-progression
          title = Skills & Progression
          bullets
            5 levelable skills (farming, mining, foraging, fishing, combat) + profession trees (level-up choices)
            Mastery system / endgame skill expansions
            Tool upgrade tiers (copper → iridium)
            Unlockables gated by skill level (recipes, crafting, machines)
        farming-ranching
          title = Farming & Ranching
          bullets
            Crop lifecycle (till, plant, water, grow, harvest; seasonal crop calendars)
            Crop quality tiers + fertilizer types
            Sprinklers (irrigation automation)
            Animal husbandry (multiple species, housing upgrades, feeding/grazing, petting, product quality, hearts)
            Farm buildings (barns, coops, sheds, silos, greenhouses)
            Bee houses, fish ponds, other production structures
            Junimo huts / harvest automation
        crafting-processing
          title = Crafting, Cooking & Processing
          bullets
            Crafting system (learned recipes, workbenches)
            Cooking system (kitchen, recipe unlocks, buffs)
            Machine processing (preserves, kegs, furnaces, recycling, looms, cheese/mayo, etc.)
            Resource refinement chains
        gathering-exploration
          title = Gathering & Exploration
          bullets
            Foraging (wild plants, fruit trees, tapping)
            Mining (procedural-ish mine floors, ores, gems, ladders)
            Combat (weapons, rings, boots, slingshot, health, death penalty, monster loot & goals)
            Fishing (casting minigame, bait/lures, crab pots, quality, seasonal/timed fish)
            Exploration maps (farm, town, forest, mountains, beach, desert, mines, island)
        social-relationship
          title = Social & Relationship
          bullets
            Friendship system (hearts per NPC, gifts, daily interactions, events)
            Marriage, romance, children, family life
            Festivals & events on a yearly calendar
            Pets (cat/dog adoption)
        quests-meta
          title = Quests & Meta-Progression
          bullets
            Bulletin board / help-wanted quests
            Story quest chain
            Collection/museum donations
            Achievements
            Special orders / long-term goals
            Secret/hidden objectives (notes, etc.)
        building-customization
          title = Building & Customization
          bullets
            Farm layout choice at start + farm expansion
            Building placement/movement, farmhouse upgrades
            Character creation + customization options
            Decorating/furniture system
            Fast travel options (mine carts, etc.)
        multiplayer-tech
          title = Multiplayer & Tech
