// ─────────────────────────────────────────────────────────────
//  D&D 5E RULES & STATS — Boardgame Network
//  A quick-reference tool for Dungeons & Dragons 5th Edition.
//  Two rule sets side by side:
//    2024 → bundled SRD 5.2 data (src/data/*.json, CC-BY-4.0)
//    2014 → fetched live from the free dnd5eapi.co (SRD 5.1)
//  Every result carries a "copy results + references" button.
//  Forked from the BGN Blank Template (bgn-blank-template).
// ─────────────────────────────────────────────────────────────

$meta
  title = D&D 5E Rules & Stats
  description = Quick reference for Dungeons & Dragons 5th Edition — search rules, spells, monsters, feats, species, classes, equipment and magic items across both the 2014 and 2024 rules (SRD 5.1 & 5.2). Copy results and book references to your table.
  tags = d&d, dungeons and dragons, 5e, dnd 5e, 2014, 2024, rules, spells, monsters, reference, rpg, tabletop, sr
  image = https://user.uploads.dev/file/74e64f0214c16474976bdd3e71973f9e.jpg

  async dynamic(inputs) =>
    const q = String(inputs.urlParams.q || "").trim().slice(0, 80);
    const ed = String(inputs.urlParams.ed || "").slice(0, 12);
    if (!q && !ed) return {};
    const edNote = ed === "2024" ? "2024 rules" : ed === "2014" ? "2014 rules" : ed === "both" ? "2014 & 2024 rules" : "";
    let title = "D&D 5E Rules & Stats";
    let description = "Quick reference for Dungeons & Dragons 5th Edition — search rules, spells, monsters, feats, species, classes, equipment and magic items across the 2014 and 2024 rules (SRD 5.1 & 5.2).";
    if (q) title = "\u201C" + q + "\u201D \u2014 D&D 5E Rules & Stats";
    if (q) description = "Quick reference for \u201C" + q + "\u201D in D&D 5e" + (edNote ? " (" + edNote + ")" : "") + ". Open the entry, then copy the result and its book reference straight to your table.";
    return { title, description };

hubUrl = https://perchance.org/bgn-boardgame-network
gameTitle = D&D 5E Rules & Stats
gameTagline = Search the free SRD rules and stats for 5th Edition — 2014 and 2024 — then copy the answer and its reference straight to your table.
gameKicker = Rules · Stats · Copy
gameGenre = Reference
gamePlayers = 2014 + 2024
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/74e64f0214c16474976bdd3e71973f9e.jpg

// Per-user persistent storage for imported house rules / homebrew content.
kv = {import:kv-plugin}
// Hosting for sharing published house rules with other players.
uploadPlugin = {import:upload-plugin}
// Shared table chat for the reference table (see the table panel in index.html).
commentsPlugin = {import:comments-plugin}
// Authoritative BGN table server — rooms, turn order and claim-win
// enforcement live server-side (see the server script in index.html).
createServerSocket = {import:server-plugin}
