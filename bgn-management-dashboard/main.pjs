// ─────────────────────────────────────────────────────────────
//  BGN MANAGEMENT DASHBOARD — main.pjs
//  One ops desk for the Boardgame Network:
//    · Network Dashboard — scan every bgn-* generator in one go:
//      BGN frame, hub link, tags, live/beta, last-edited, views.
//    · Bug Triage — dedupe, group and export the hub's bug inbox.
//    · Template Updates — flag forked templates that have drifted.
//  The whole engine lives in index.html; this file is config only.
// ─────────────────────────────────────────────────────────────

$meta
  title = BGN Management Dashboard
  description = One ops desk for the Boardgame Network. Scan every bgn-* generator for BGN frame compliance, hub links, tags, live/beta status, views and last-edited; triage the hub's bug reports and export them to CSV; and flag forked templates that have drifted from the current source.
  tags = bgn, boardgame network, dashboard, ops, admin, qa, audit, bugs, templates, tools
  image = https://user.uploads.dev/file/5b017dbe0b96fa158ff7a59885b95597.jpg
  header
    mode = minimal

hubUrl = https://perchance.org/bgn-boardgame-network
projectsUrl = https://perchance.org/rathjis-generators
authorInitial = R
gameTitle = BGN Management Dashboard
gameTagline = One desk for the whole network — scan the shelf, triage bugs, catch drifted forks.
gameKicker = Scan · Triage · Track
gameGenre = Tool
gamePlayers = 1 user
