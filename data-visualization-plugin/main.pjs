    let xk = opts.x != null ? String(resolve(opts.x)) : null;
    let yks = [];
    if (opts.y != null) { let yv = resolve(opts.y); yks = Array.isArray(yv) ? yv.map(String) : [String(yv)]; }
    let style = {};
    let styleKeys = ["height", "width", "theme", "colors", "decimals", "stacked", "percent", "horizontal", "trend", "target", "min", "max", "ticks", "gap", "heatColor", "bandColor", "band", "foreground", "background", "log", "smooth", "dots", "mode", "bin", "xLabel", "yLabel"];
    for (let i = 0; i < styleKeys.length; i++) if (opts[styleKeys[i]] !== undefined) style[styleKeys[i]] = opts[styleKeys[i]];
    if (opts.labels !== undefined) style.showAxes = opts.labels;
    if (opts.showValues !== undefined) style.showValues = opts.showValues;
    else if (opts.values !== undefined) style.showValues = opts.values;
    if (opts.showLegend !== undefined) style.showLegend = opts.showLegend;
    if (opts.showGrid !== undefined) style.showGrid = opts.showGrid;
    if (opts.title !== undefined) style.title = opts.title;
    else if (name) style.title = name;

    if (type === "scatter") {
      let scx = xk && numKeys.indexOf(xk) >= 0 ? xk : (numKeys.length ? numKeys[0] : null);
      let scy = [];
      for (let i = 0; i < yks.length; i++) if (yks[i] !== scx) scy.push(yks[i]);
      if (!scy.length) for (let i = 0; i < numKeys.length; i++) if (numKeys[i] !== scx) scy.push(numKeys[i]);
      if (!scx || !scy.length) return mergeSpecStyle({ type: "scatter", points: [] }, style);
      let points = [];
      for (let i = 0; i < scy.length; i++) points.push({ name: scy[i], points: [] });
      for (let i = 0; i < orows.length; i++) {
        let x = num(orows[i][scx]);
        if (!isFinite(x)) continue;
