      }
    }
    if (!keys.length && orows.length) keys = Object.keys(orows[0]);
    let numKeys = [], catKeys = [];
    for (let i = 0; i < keys.length; i++) {
      let k = keys[i];
      let t = colTypes[k];
      let isNum = t ? /^(number|numeric|int|integer|float|double)$/i.test(t) : null;
      if (isNum === null) {
        isNum = true;
        for (let j = 0; j < orows.length && j < 30; j++) {
          let v = orows[j][k];
          if (v == null || v === "") continue;
