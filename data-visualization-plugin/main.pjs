          a = arrOf(pp);
        }
        if (a) { nP += a.length; nS += 1; }
      }
      if (nS) out.push(nS + " series");
      if (nP) out.push(nP + " points");
    } else {
      let nS = s.series.length;
      let nP = nS ? s.series[0].values.length : 0;
