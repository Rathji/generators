  function describeSpec(spec) {
    let s = normaliseSpec(spec);
    let meta = typeMeta(s.type) || typeMeta("bar");
    let out = [meta ? meta.label : "Chart"];
    if (normalizeTypeId(s.type) === "heatmap" || (s.matrix && s.matrix.length)) {
      let rows = Array.isArray(s.matrix) ? s.matrix.length : 0;
      let cols = rows && Array.isArray(resolve(s.matrix[0])) ? resolve(s.matrix[0]).length : 0;
      if (rows && cols) out.push(rows + " × " + cols + " cells");
    } else if (normalizeTypeId(s.type) === "scatter" || s.points) {
      let nS = 0, nP = 0;
      let src = s.points && s.points.length ? s.points : s.series;
      for (let i = 0; i < src.length; i++) {
        let raw = resolve(src[i]);
