        for (let r = 0; r < rowVals.length; r++) { let row = []; for (let c = 0; c < colVals.length; c++) row.push(null); matrix.push(row); }
        for (let i = 0; i < cell.length; i++) if (isFinite(cell[i].v)) matrix[cell[i].r][cell[i].c] = cell[i].v;
        return mergeSpecStyle({ type: "heatmap", rowLabels: rowVals, labels: colVals, matrix: matrix }, style);
      }
      let rowLabels = [], matrix = [];
      for (let i = 0; i < orows.length; i++) {
        rowLabels.push(String(resolve(orows[i][rk] !== undefined ? orows[i][rk] : i)));
        let row = [];
        for (let j = 0; j < numKeys.length; j++) { let v = num(orows[i][numKeys[j]]); row.push(isFinite(v) ? v : null); }
        matrix.push(row);
