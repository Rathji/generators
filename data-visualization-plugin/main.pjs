      let ck = opts.col != null ? String(resolve(opts.col)) : null;
      let vk = opts.value != null ? String(resolve(opts.value)) : null;
      if (ck && vk) {
        let rowVals = [], colVals = [], ridx = {}, cidx = {}, cell = [];
        for (let i = 0; i < orows.length; i++) {
          let rv = String(resolve(orows[i][rk]));
          let cv = String(resolve(orows[i][ck]));
