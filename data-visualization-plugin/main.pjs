  // ---------- PNG rasterisation ----------

  function resolveCssVars(s) {
    let re = /var\(\s*--[A-Za-z0-9_-]+\s*,\s*/g;
    let out = "", last = 0, m;
    while ((m = re.exec(s))) {
      let start = m.index;
      let i = re.lastIndex;
      let depth = 1;
      while (i < s.length && depth > 0) {
        let ch = s.charAt(i);
        if (ch === "(") depth++;
        else if (ch === ")") depth--;
        i++;
      }
      out += s.slice(last, start) + s.slice(m.index + m[0].length, Math.max(start, i - 1));
      last = i;
      re.lastIndex = i;
    }
    out += s.slice(last);
    return out;
  }

  function svgDims(s) {
    let m = s.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
