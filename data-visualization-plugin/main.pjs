      return mergeSpecStyle({ type: "heatmap", rowLabels: rowLabels, labels: numKeys.slice(), matrix: matrix }, style);
    }
    if (!xk) xk = catKeys.length ? catKeys[0] : (keys.length ? keys[0] : null);
    if (!yks.length) { for (let i = 0; i < numKeys.length; i++) if (numKeys[i] !== xk) yks.push(numKeys[i]); }
    if (!yks.length) yks = numKeys.slice();
    let agg = opts.agg != null ? String(resolve(opts.agg)) : null;
    if (agg === "none") agg = null;
    let groups = {}, order = [];
    for (let i = 0; i < orows.length; i++) {
      let lv = (xk != null && orows[i][xk] !== undefined) ? String(resolve(orows[i][xk])) : String(i);
      if (!groups[lv]) { groups[lv] = []; for (let j = 0; j < yks.length; j++) groups[lv].push([]); order.push(lv); }
      for (let j = 0; j < yks.length; j++) { let v = num(orows[i][yks[j]]); if (isFinite(v)) groups[lv][j].push(v); }
    }
    let labels = [], seriesVals = [];
    for (let j = 0; j < yks.length; j++) seriesVals.push([]);
    for (let i = 0; i < order.length; i++) {
      labels.push(order[i]);
      let g = groups[order[i]];
      for (let j = 0; j < yks.length; j++) {
        let a = g[j], val = NaN;
        if (agg === "count") val = a.length;
        else if (agg === "sum") { val = 0; for (let k = 0; k < a.length; k++) val += a[k]; }
        else if (agg === "mean") { val = 0; for (let k = 0; k < a.length; k++) val += a[k]; val = a.length ? val / a.length : NaN; }
        else if (agg === "min") val = a.length ? Math.min.apply(null, a) : NaN;
        else if (agg === "max") val = a.length ? Math.max.apply(null, a) : NaN;
        else val = a.length ? a[0] : NaN;
        seriesVals[j].push(val);
      }
    }
    let series = [];
    for (let j = 0; j < yks.length; j++) series.push({ name: yks[j], values: seriesVals[j] });
    let sort = opts.sort != null ? String(resolve(opts.sort)) : null;
    let limit = opts.limit != null ? Math.floor(+resolve(opts.limit)) : 0;
    if ((sort === "desc" || sort === "asc") && series.length) {
