  function specFrom(dataset, opts) {
    opts = opts || {};
    let name = null, columns = null, types = null, rows = null;
    if (isListNode(dataset)) {
      let its = null;
      try { its = listItems(dataset); } catch (e) { its = null; }
      rows = its ? its.map(valOf) : [];
    } else if (Array.isArray(dataset)) rows = dataset;
    else if (dataset != null && typeof dataset === "object") {
      name = dataset.name != null ? String(resolve(dataset.name)) : null;
      columns = dataset.columns || null;
      types = dataset.types || null;
      rows = dataset.rows || dataset.data || null;
    }
    if (!Array.isArray(rows)) rows = [];
    let keys = [], colTypes = {};
    if (Array.isArray(columns)) {
