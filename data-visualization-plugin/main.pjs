    let n = nFromSpec(s);
    if (!n.ok) return ph(id, n.error);
    if (id === "sparkline" || id === "sparkline-bar") return renderSpark(n, o, id === "sparkline-bar");
    if (id === "histogram") {
      if (!n.dist) {
