      return renderTimeSeries(series, o);
    }
    if (id === "stacked-bar") return renderStackedBars(n, o, false);
    if (id === "stacked-bar-100") return renderStackedBars(n, o, true);
    if (id === "bar-horizontal") { o.horizontal = true; return renderBarsH(n, o); }
    if (id === "stacked-bar-horizontal") return renderStackedBarsH(n, o, false);
