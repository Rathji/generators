    let hm = s.match(/\bheight="([\d.]+)"/);
    return { w: wm ? +wm[1] : 640, h: hm ? +hm[1] : 360 };
  }

  function specWithExportTheme(spec, o) {
    let theme = (o && o.theme != null) ? o.theme : (spec && spec.theme != null ? spec.theme : "light");
    let out = {};
