      }
      return renderHisto(n, o);
    }
    if (id === "pie") return renderPie(n, o, false);
    if (id === "donut") return renderPie(n, o, true);
    if (id === "line") return renderLine(n, o);
    if (id === "area") return renderArea(n, o, false);
    if (id === "stacked-area") return renderArea(n, o, true);
    if (id === "timeseries") {
      let series = [];
      for (let si = 0; si < n.series.length; si++) {
