// ═══════════════════════════════════════════════════════════════════════════
// data-visualization-plugin  ·  v1.2.1
// Clean, dependency-free SVG charts for Perchance — 16 chart types, driven by
// plain arrays, label/value objects, Perchance lists, distribution objects,
// tabular datasets or a declarative spec object. Every chart returns a
// responsive SVG string; any chart can be rasterised to a PNG.
//
//   charts = <import data-visualization-plugin>   (curly-brace import syntax)
//
//   [charts.bar([3, 7, 2])]
//   [charts.line([{label:"Mon", Views:5, Saves:3}, {label:"Tue", Views:8, Saves:6}])]
//   [charts.stackedBar([{label:"Q1", a:3, b:5}, {label:"Q2", a:4, b:2}])]
//   [charts.stackedBar100(data)]          // each category normalised to 100%
//   [charts.barHorizontal(data)] [charts.stackedBarHorizontal(data)]
//   [charts.area(data)] [charts.stackedArea(data)]
//   [charts.scatter([[1,2],[2,4],[3,3]])] // or rows with two numeric columns
//   [charts.heatmap({rowLabels:["r1","r2"], labels:["A","B"], matrix:[[1,4],[7,2]]})]
//   [charts.pie(data)] [charts.donut(data, {centerText:"42"})]
//   [charts.histogram({outcomes:[{v:3,p:0.1}], expr:"1d6", mean:3.5, std:1.2})]
//   [charts.histogram([3,3,4,4,5,5,6])]            // raw samples → auto-binned
//   [charts.histogram(rawSamples, {bins: 12})]     // force the bin count
//   [charts.sparkline([3,7,2,5,9])] [charts.sparklineBar([3,7,2,5,9])]
//   [charts.timeSeries([{t: Date.now(), v: 5}])]  // irregular {t, v} time data
//   [charts.infer(data)]                    // smart default: infers the best chart type
//
// Declarative spec model — persist a chart description and re-render it:
//   [charts.render({type:"heatmap", rowLabels:["A","B"], labels:["x","y"],
//                   matrix:[[1,4],[7,2]], title:"Load"})]
//   [charts.svg(spec)]  // alias for render
//   charts.types / charts.typeGroups / charts.typeMeta(id)
//   [charts.describe(spec)]                 // e.g. "Heatmap · 2 × 2 cells"
//   charts.spec(dataset, {type:"line"})     // tabular dataset → renderable spec
//   charts.fromDataset(...)                 // alias for spec
//   charts.fence(spec) / charts.fenceToSpec(source) // ```chart round-trip
//
// PNG rasterisation (browser only, async):
//   charts.png(svgOrSpec, {scale:2, foreground:"#0f172a", background:"#ffffff"})
//     → Promise<Blob>;  charts.pngBytes(...) → Promise<Uint8Array>;
//     charts.pngDataUrl(...) → Promise<string>;  charts.bytesToDataUrl(bytes, mime)
//
// All chart types accept an optional second options argument:
//   {height, width, title, labels, ticks, gridlines, legend, tooltips, min, max,
//    decimals, horizontal, fill, theme, gap, colors, keys, centerText,
//    stacked, percent, values, trend, target, bins, heatColor, rowLabels, matrix,
//    band:{lower,upper}, bandColor, xLabel, yLabel, foreground, background}
// timeSeries adds: {mode, bin, log, smooth, dots, stacked, percent, trend,
//   target, maxPoints} — mode: "line" | "bars" | "combo" | "norm".
// Full reference + live demos: perchance.org/data-visualization-plugin
//
// Notes
//   · Text (title, xLabel, yLabel, centerText) is taken VERBATIM — square and
//     curly brackets are never template-evaluated, so "{a|b}" renders as-is.
//   · Renderers never throw: bad input yields a "(charts.<type>: …)" placeholder
//     string, and png/pngBytes/pngDataUrl resolve to that placeholder too.
//   · Colours are validated before use, so a colour string can't inject markup.
//   · Perchance lists work directly — [charts.bar(myList)] reads the item nodes via
//     selectAll (including each item's own keys), so data can live in your lists.
// ═══════════════════════════════════════════════════════════════════════════

$meta
  title = Data Visualization Plugin
  description = Dependency-free SVG charts for Perchance — 16 types including stacked, horizontal, area, scatter, heatmap and inline sparklines, plus a declarative chart spec, a machine-readable type catalogue and PNG export. Feed it arrays, lists, distributions or tabular data; drop the SVG into any element.
  tags = charts, data, visualization, svg, graphs, heatmap, scatter, sparkline, png, plugin
  header
    mode = minimal


makeChartsApi() =>
  if (window.__chartsApi) return window.__chartsApi;

  const VERSION = "1.2.1";
  const DEF_COLORS = ["#7c6cff", "#22d3ee", "#34d399", "#f472b6", "#fbbf24", "#f87171", "#a78bfa", "#38bdf8"];
  const VB_W = 520;
  const NODE_SKIP = ["evaluateItem", "selectAll", "selectOne", "selectMany", "selectMultiple", "selectMultipleUnique", "selectUnique", "getLength", "parent", "getParent", "name", "keys", "isItem", "isList", "listKey"];

  // Perchance installs `evaluateItem` on String.prototype, so a plain string like
  // "a[b]" or "{x|y}" WOULD be re-evaluated as a template here — silently mangling
  // user labels/titles and raising "b is not defined" engine errors. Primitives are
  // therefore always returned verbatim; only real list-node objects are resolved.
  function resolve(v) {
    if (v == null) return v;
    let t = typeof v;
    if (t === "string" || t === "number" || t === "boolean") return v;
    try { if (v.evaluateItem !== undefined) return v.evaluateItem; } catch (e) {}
    return v;
  }

  function esc(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  // Colours are interpolated straight into SVG attributes (fill=/stroke=), so a
  // caller-supplied colour that contains a quote would break out of the
  // attribute and inject markup. Keep the unambiguously-safe colour syntaxes and
  // fall back otherwise.
  function escColor(c, fallback) {
    let s = String(c == null ? "" : c).trim();
    if (!s) return fallback;
    if (/["'<>]/.test(s)) return fallback;
    if (/^#[0-9a-fA-F]{3,8}$/.test(s)) return s;
    if (/^[a-zA-Z]+(-[a-zA-Z]+)*$/.test(s)) return s;
    if (/^(rgb|rgba|hsl|hsla|hwb|lab|lch|oklab|oklch|color|color-mix|light-dark)\([^"'<>]*\)$/i.test(s)) return s;
    if (/^var\(--[A-Za-z0-9_-]+\s*(,[^"'<>]*)?\)$/i.test(s)) return s;
    return fallback;
  }

  function fmt(v, dec) {
    if (typeof v !== "number" || !isFinite(v)) return v == null ? "" : String(v);
    if (dec == null) dec = Math.round(v) === v ? 0 : 2;
    let neg = v < 0;
    v = Math.abs(v);
    let s = v.toFixed(dec);
    if (dec === 0) s = String(Math.round(v));
    return (neg ? "-" : "") + s;
  }

  function fmtP(prob, dec) {
    return fmt(prob * 100, dec) + "%";
  }

  function num(v) {
    v = resolve(v);
    let n = typeof v === "number" ? v : Number(v);
    return isFinite(n) ? n : NaN;
  }

  function themeColors(theme) {
    if (theme === "light") return { text: "#1e293b", muted: "#64748b", grid: "rgba(15,23,42,0.10)", axis: "rgba(15,23,42,0.28)", bar: "#7c6cff", barPeak: "#0891b2" };
    if (theme === "dark") return { text: "#e2e8f0", muted: "#94a3b8", grid: "rgba(148,163,184,0.13)", axis: "rgba(148,163,184,0.32)", bar: "#8b7cff", barPeak: "#22d3ee" };
    return { text: "var(--text, #e2e8f0)", muted: "var(--muted, #94a3b8)", grid: "var(--border, rgba(148,163,184,0.13))", axis: "var(--border, rgba(148,163,184,0.32))", bar: "var(--accent, #7c6cff)", barPeak: "var(--accent2, #22d3ee)" };
  }

  function defaultOpts() {
    return {
      height: 300, width: null, title: null, labels: true, ticks: 4, gridlines: true,
      legend: null, tooltips: true, min: null, max: null, decimals: null,
      horizontal: false, fill: true, theme: null,
      centerText: null, gap: 0.25, colors: DEF_COLORS.slice(), keys: null,
      mode: "line", bin: "auto", log: "auto", smooth: false, dots: true,
      stacked: true, percent: false, trend: false, target: null, maxPoints: 400,
      values: false, showValues: false, bins: null, heatColor: null,
      rowLabels: null, matrix: null, band: null, bandColor: null,
      xLabel: null, yLabel: null, foreground: null, background: null
    };
  }

  const COLOUR_KEYS = ["heatColor", "bandColor", "foreground", "background"];
  const TEXT_KEYS = ["title", "xLabel", "yLabel", "centerText"];

  function mergeOpts(o, opts) {
    if (opts == null || typeof opts !== "object") return o;
    let keys = Object.keys(opts);
    for (let i = 0; i < keys.length; i++) {
      let k = keys[i];
      if (k === "__proto__" || k === "constructor" || k === "prototype") continue;
      if (k === "colors" && Array.isArray(opts[k])) {
        o.colors = opts[k].map(function(c, j) { return escColor(c, DEF_COLORS[j % DEF_COLORS.length]); });
        continue;
      }
      if (k === "keys" && opts[k] != null) {
        o.keys = Array.isArray(opts[k]) ? opts[k].map(function(x) { return resolve(x); }) : [resolve(opts[k])];
        continue;
      }
      if (COLOUR_KEYS.indexOf(k) >= 0 && opts[k] != null) { o[k] = escColor(opts[k], null); continue; }
      if (TEXT_KEYS.indexOf(k) >= 0 && opts[k] != null) { o[k] = textOf(opts[k]); continue; }
      o[k] = resolve(opts[k]);
    }
    return o;
  }

  function niceNum(range, round) {
    let exp = Math.floor(Math.log(range) / Math.LN10);
    let f = range / Math.pow(10, exp);
    let nf;
    if (round) { if (f < 1.5) nf = 1; else if (f < 3) nf = 2; else if (f < 7) nf = 5; else nf = 10; }
    else { if (f <= 1) nf = 1; else if (f <= 2) nf = 2; else if (f <= 5) nf = 5; else nf = 10; }
    return nf * Math.pow(10, exp);
  }

  function niceTicks(min, max, count) {
    if (!isFinite(min) || !isFinite(max) || !(min < max)) { min = 0; max = max === min ? max + 1 : (min || 1); }
    let range = niceNum(max - min, false);
    let step = niceNum(range / Math.max(1, count - 1), true);
    if (step <= 0) step = 1;
    let lo = Math.floor(min / step) * step;
    let hi = Math.ceil(max / step) * step;
    let out = [];
    for (let v = lo; v <= hi + step * 0.001; v += step) out.push(v);
    return out;
  }

  function minMax(vals) {
    let mn = Infinity, mx = -Infinity;
    for (let i = 0; i < vals.length; i++) {
      let v = vals[i];
      if (v < mn) mn = v;
      if (v > mx) mx = v;
    }
    if (!isFinite(mn)) { mn = 0; mx = 1; }
    return { mn: mn, mx: mx };
  }

  function valueRange(series, o) {
    let vals = [];
    for (let s = 0; s < series.length; s++) {
      let vs = series[s].values;
      for (let i = 0; i < vs.length; i++) vals.push(vs[i]);
    }
    let r = minMax(vals);
    let mn = r.mn, mx = r.mx;
    if (o.min != null) mn = +o.min;
    if (o.max != null) mx = +o.max;
    if (o.min == null && mn >= 0) mn = 0;
    if (!(mn < mx)) { if (mx === mn) mx = mn + 1; else { let t = mn; mn = mx; mx = t; } }
    return { mn: mn, mx: mx };
  }

  function layout(o, titleH, legendH, xLabelsH) {
    let H = Math.max(160, Math.floor(+o.height || 300));
    let T = titleH + 8;
    let B = xLabelsH + legendH + 6;
    let L = 58, R = 14;
    return { H: H, L: L, R: R, x0: L, x1: VB_W - R, y0: T, y1: H - B, T: T, B: B };
  }

  function svgHead(H) {
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + VB_W + " " + H + '" role="img" style="width:100%;height:auto;display:block;overflow:visible;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;">';
  }

  function drawTitle(o, tc) {
    if (!o.title) return "";
    return '<text x="' + (VB_W / 2) + '" y="18" style="font-size:15px;font-weight:700;fill:' + tc.text + ';text-anchor:middle;">' + esc(o.title) + '</text>';
  }

  function drawGrid(o, tc, ly, x0, x1, y0, y1, ticks, lo, hi) {
    let out = "";
    if (o.gridlines) {
      for (let i = 0; i < ticks.length; i++) {
        let y = ly(ticks[i]);
        out += '<line x1="' + x0 + '" y1="' + y + '" x2="' + x1 + '" y2="' + y + '" style="stroke:' + tc.grid + ';stroke-width:1;"/>';
      }
    }
    let base = Math.max(lo, Math.min(hi, 0));
    let by = Math.max(y0, Math.min(y1, ly(base)));
    out += '<line x1="' + x0 + '" y1="' + by + '" x2="' + x1 + '" y2="' + by + '" style="stroke:' + tc.axis + ';stroke-width:1.3;"/>';
    return out;
  }

  function drawTicksY(o, tc, ly, ticks, x0, dec) {
    let out = "";
    for (let i = 0; i < ticks.length; i++) {
      let y = ly(ticks[i]);
      out += '<text x="' + (x0 - 7) + '" y="' + (y + 4) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">' + fmt(ticks[i], dec) + '</text>';
    }
    return out;
  }

  function drawLegend(o, tc, y, names, colors) {
    if (!names.length) return "";
    let avail = VB_W - 16;
    let fixed = 24;
    let entryMax = 160;
    let maxChars = Math.max(1, Math.min(Math.floor(entryMax / 6.4), Math.floor((avail - fixed * names.length) / (6.4 * names.length))));
    let shown = [];
    for (let i = 0; i < names.length; i++) {
      let nm = String(names[i] == null ? "" : names[i]);
      if (nm.length > maxChars) nm = nm.slice(0, Math.max(1, maxChars - 1)) + "…";
      shown.push(nm);
    }
    let widths = [];
    let totalW = 0;
    for (let i = 0; i < shown.length; i++) {
      let w = Math.min(160, shown[i].length * 6.4) + fixed;
      widths.push(w);
      totalW += w;
    }
    let x = Math.max(8, (VB_W - totalW) / 2);
    let out = "";
    for (let i = 0; i < shown.length; i++) {
      let c = colors[i % colors.length];
      let full = String(names[i] == null ? "" : names[i]);
      out += '<rect x="' + x + '" y="' + (y - 5) + '" width="11" height="11" rx="3" fill="' + c + '" opacity="0.92"/>';
      out += '<text x="' + (x + 16) + '" y="' + (y + 4) + '" style="font-size:12px;fill:' + tc.muted + ';">';
      if (o.tooltips !== false && shown[i] !== full) out += "<title>" + esc(full) + "</title>";
      out += esc(shown[i]) + "</text>";
      x += widths[i];
    }
    return out;
  }

  function yScale(lo, hi, y0, y1) {
    return function(v) { return y1 - (v - lo) / (hi - lo) * (y1 - y0); };
  }

  function xScale(lo, hi, x0, x1) {
    return function(v) { return x0 + (v - lo) / (hi - lo) * (x1 - x0); };
  }

  function polar(cx, cy, r, a) {
    let rad = a * Math.PI / 180;
    return { x: cx + r * Math.cos(rad), y: cy + r * Math.sin(rad) };
  }

  // ---------- data normalization ----------

  // A Perchance list node exposes `selectAll` as an ARRAY of child nodes — it is
  // NOT a function, so a `typeof v.selectAll === "function"` test never matches a
  // real list (that made every list-input branch dead code). Node items also hide
  // their keys from Object.keys(), exposing them via `$valueChildren` instead.
  function listItems(v) {
    if (v == null || typeof v !== "object") return null;
    let sel;
    try { sel = v.selectAll; } catch (e) { return null; }
    if (sel == null) return null;
    let all = sel;
    if (typeof sel === "function") { try { all = sel(); } catch (e) { return null; } }
    if (all == null || typeof all.length !== "number") return null;
    let out = [];
    for (let i = 0; i < all.length; i++) out.push(all[i]);
    return out;
  }

  function isListNode(v) { return listItems(v) !== null; }

  function nodeKeys(e) {
    let k = e.$valueChildren;
    if (Array.isArray(k) && k.length) return k.slice();
    k = e.$allKeys;
    return (Array.isArray(k) && k.length) ? k.slice() : null;
  }

  function toObj(e) {
    if (e == null || typeof e !== "object" || Array.isArray(e)) return null;
    let isNode = e.evaluateItem !== undefined || e.selectAll !== undefined || e.isList !== undefined || e.isItem !== undefined || e.listKey !== undefined;
    let o = {};
    let any = false;
    let keys = isNode ? nodeKeys(e) : null;
    if (!keys) keys = Object.keys(e);
    // A node's `.name` is the node's own key, not data (hence NODE_SKIP); a plain
    // object's `name` is legitimate data — e.g. {name:"Mon", value:3}.
    let skipName = isNode && Array.isArray(e.$valueChildren);
    for (let i = 0; i < keys.length; i++) {
      let k = keys[i];
      if (k.charAt(0) === "$") continue;
      if (NODE_SKIP.indexOf(k) >= 0 && !(k === "name" && !skipName)) continue;
      let v = e[k];
      if (v == null || typeof v === "function") continue;
      o[k] = resolve(v);
      any = true;
    }
    return any ? o : null;
  }

  function classifyObjects(objs, opts) {
    if (!objs.length) return { ok: false, error: "empty data" };
    let first = objs[0];
    let keys = Object.keys(first);
    let hasV = keys.indexOf("v") >= 0 && keys.indexOf("p") >= 0;
    if (hasV) {
      let values = [], probs = [];
      for (let i = 0; i < objs.length; i++) {
        values.push(num(objs[i].v));
        probs.push(num(objs[i].p));
      }
      let labels = [];
      for (let i = 0; i < values.length; i++) labels.push(fmt(values[i], 0));
      return { ok: true, series: [{ name: "value", values: values }], labels: labels, dist: { values: values, probs: probs }, error: null };
    }
    let numericKeys = keys.filter(function(k) {
      return k !== "label" && k !== "name" && k !== "value" && typeof num(first[k]) === "number";
    });
    let hasValue = keys.indexOf("value") >= 0 || first.value !== undefined;
    if (hasValue && !numericKeys.length) {
      let labels = [], values = [];
      for (let i = 0; i < objs.length; i++) {
        labels.push(String(objs[i].label !== undefined ? resolve(objs[i].label) : (objs[i].name !== undefined ? resolve(objs[i].name) : i)));
        values.push(num(objs[i].value));
      }
      return { ok: true, series: [{ name: "value", values: values }], labels: labels, dist: null, error: null };
    }
    if (numericKeys.length) {
      let useKeys = opts && opts.keys && opts.keys.length ? opts.keys : numericKeys;
      let labels = [], series = [];
      for (let s = 0; s < useKeys.length; s++) series.push({ name: String(useKeys[s]), values: [] });
      for (let i = 0; i < objs.length; i++) {
        labels.push(String(objs[i].label !== undefined ? resolve(objs[i].label) : (objs[i].name !== undefined ? resolve(objs[i].name) : i)));
        for (let s = 0; s < useKeys.length; s++) {
          let val = objs[i][useKeys[s]];
          series[s].values.push(val !== undefined ? num(val) : NaN);
        }
      }
      return { ok: true, series: series, labels: labels, dist: null, error: null };
    }
    return { ok: false, error: "objects need a `label` + `value`, or `label` + numeric keys" };
  }

  function classify(d, opts) {
    if (Array.isArray(d)) {
      if (!d.length) return { ok: false, error: "empty data" };
      let elems = d.map(function(x) { return resolve(x); });
      let objects = [];
      let allScalar = true;
      for (let i = 0; i < elems.length; i++) {
        let e = elems[i];
        let o = toObj(e);
        if (o) { objects.push(o); allScalar = false; }
        else if (typeof e === "number" || typeof e === "string") { objects.push({ label: String(i), value: num(e) }); }
        else { objects.push({ label: String(i), value: num(e) }); }
      }
      if (!allScalar) return classifyObjects(objects, opts);
      let values = [];
      let labels = [];
      for (let i = 0; i < elems.length; i++) {
        values.push(num(elems[i]));
        labels.push(String(i));
      }
      return { ok: true, series: [{ name: "value", values: values }], labels: labels, dist: null, error: null };
    }
    if (d != null && typeof d === "object") {
      if (Array.isArray(d.outcomes) && d.outcomes.length && typeof d.outcomes[0] === "object") {
        let values = [], probs = [];
        for (let i = 0; i < d.outcomes.length; i++) {
          values.push(num(d.outcomes[i].v));
          probs.push(num(d.outcomes[i].p));
        }
        let labels = [];
        for (let i = 0; i < values.length; i++) labels.push(fmt(values[i], 0));
        return { ok: true, series: [{ name: "probability", values: probs }], labels: labels, dist: { values: values, probs: probs, expr: resolve(d.expr), mean: num(d.mean), std: num(d.std) }, error: null };
      }
      if (Array.isArray(d.dist) && d.dist.length && typeof d.dist[0] === "object") {
        let values = [], probs = [];
        for (let i = 0; i < d.dist.length; i++) {
          values.push(num(d.dist[i].v));
          probs.push(num(d.dist[i].p));
        }
        let labels = [];
        for (let i = 0; i < values.length; i++) labels.push(fmt(values[i], 0));
        return { ok: true, series: [{ name: "probability", values: probs }], labels: labels, dist: { values: values, probs: probs, expr: resolve(d.expr), mean: num(d.mean), std: num(d.std) }, error: null };
      }
      if (Array.isArray(d.series)) {
        let labels = (d.labels || []).map(function(x) { return String(resolve(x)); });
        let series = [];
        for (let i = 0; i < d.series.length; i++) {
          let s = d.series[i];
          let nm = resolve(s.name != null ? s.name : "Series " + (i + 1));
          let data = (s.data || s.values || []).map(function(v) { return num(v); });
          series.push({ name: String(nm), values: data });
        }
        if (!labels.length && series.length) {
          for (let i = 0; i < series[0].values.length; i++) labels.push(String(i));
        }
        return { ok: true, series: series, labels: labels, dist: null, error: null };
      }
      if (Array.isArray(d.values) && Array.isArray(d.probs) && d.values.length && d.values.length === d.probs.length) {
        let values = d.values.map(function(v) { return num(v); });
        let probs = d.probs.map(function(v) { return num(v); });
        let labels = [];
        for (let i = 0; i < values.length; i++) labels.push(fmt(values[i], 0));
        return { ok: true, series: [{ name: "probability", values: probs }], labels: labels, dist: { values: values, probs: probs, expr: resolve(d.expr), mean: num(d.mean), std: num(d.std) }, error: null };
      }
      let ks = Object.keys(d);
      let arrKeys = [];
      for (let i = 0; i < ks.length; i++) if (Array.isArray(d[ks[i]])) arrKeys.push(ks[i]);
      if (arrKeys.length === ks.length && arrKeys.length) {
        let series = [];
        for (let i = 0; i < ks.length; i++) {
          series.push({ name: String(ks[i]), values: d[ks[i]].map(function(v) { return num(v); }) });
        }
        let labels = [];
        if (series.length) for (let i = 0; i < series[0].values.length; i++) labels.push(String(i));
        return { ok: true, series: series, labels: labels, dist: null, error: null };
      }
      if (d.v !== undefined && d.p !== undefined) {
        return { ok: true, series: [{ name: "probability", values: [num(d.p)] }], labels: [fmt(num(d.v), 0)], dist: { values: [num(d.v)], probs: [num(d.p)], expr: null, mean: NaN, std: NaN }, error: null };
      }
      if (d.label !== undefined || d.value !== undefined) {
        let objs = [];
        let o2 = toObj(d);
        if (o2) objs.push(o2);
        if (objs.length) return classifyObjects(objs, opts);
      }
      return { ok: false, error: "unrecognized data shape" };
    }
    return { ok: false, error: "expected an array, list, or distribution object" };
  }

  function normData(input, opts) {
    if (input == null) return { ok: false, error: "expected data (array, {label,value} items, or a series object)" };
    let d = input;
    if (d != null && isListNode(d)) {
      let items;
      try {
        items = listItems(d);
      } catch (e) {
        return { ok: false, error: "could not read list data" };
      }
      let arr = [];
      for (let i = 0; i < items.length; i++) {
        let it = items[i];
        let o = it != null && typeof it === "object" ? toObj(it) : null;
        if (o) arr.push(o);
        else arr.push(resolve(it));
      }
      return classify(arr, opts);
    }
    return classify(resolve(d), opts);
  }

  // ---------- renderers ----------

  function renderBars(n, o) {
    let tc = themeColors(o.theme);
    let legend = o.legend == null ? n.series.length > 1 : !!o.legend;
    let legendH = legend ? 22 : 0;
    let xLabelsH = o.labels ? 24 : 6;
    let titleH = o.title ? 26 : 0;
    let lay = layout(o, titleH, legendH, xLabelsH);
    let H = lay.H, x0 = lay.x0, x1 = lay.x1, y0 = lay.y0, y1 = lay.y1;
    let vals = [];
    for (let s = 0; s < n.series.length; s++) {
      let vs = n.series[s].values;
      for (let i = 0; i < vs.length; i++) vals.push(vs[i]);
    }
    let y = yScaleInfo(vals, o, y0, y1);
    let lo = y.lo, hi = y.hi, ticks = y.ticks;
    let ly = y.ly, by = y.by, log = y.log;
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let out = svgHead(H);
    out += drawTitle(o, tc);
    out += drawGrid(o, tc, ly, x0, x1, y0, y1, ticks, lo, hi);
    out += drawTicksY(o, tc, ly, ticks, x0, o.decimals);
    let nS = n.series.length;
    let nG = n.labels.length;
    let gap = o.gap == null ? 0.25 : +o.gap;
    let groupW = (x1 - x0) / Math.max(1, nG);
    let bandW = groupW * (1 - gap);
    let barW = bandW / nS;
    let baseY = y.baseY;
    for (let i = 0; i < nG; i++) {
      let cx = x0 + i * groupW;
      for (let s = 0; s < nS; s++) {
        let v = n.series[s].values[i];
        if (v == null || isNaN(v)) continue;
        if (log && !(v > 0)) continue;
        let bx = cx + groupW * gap / 2 + s * barW;
        let topY = Math.max(y0, Math.min(y1, by(v)));
        let y = Math.min(baseY, topY);
        let h = Math.max(0.5, Math.abs(baseY - topY));
        let c = colors[s % colors.length];
        out += '<rect x="' + bx + '" y="' + y + '" width="' + Math.max(1, barW - 1) + '" height="' + h + '" rx="2.5" fill="' + c + '" opacity="0.9"';
        if (o.tooltips !== false) out += '><title>' + esc(n.labels[i] + ": " + fmt(v, o.decimals)) + '</title></rect>';
        else out += '/>';
      }
      if (o.labels) {
        let step = Math.ceil(nG / 12);
        let slotW = step * groupW;
        let maxChars = Math.max(4, Math.floor(slotW / 6.4) - 1);
        if (i % step === 0) {
          let lbl = String(textOf(n.labels[i]));
          if (lbl.length > maxChars) lbl = lbl.slice(0, Math.max(1, maxChars - 1)) + "…";
          let w = lbl.length * 6.4 + 4;
          let x = Math.min(cx + groupW / 2, VB_W - 4 - w / 2);
          out += '<text x="' + fmt(x, 1) + '" y="' + (H - legendH - 6) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:middle;">' + esc(lbl) + '</text>';
        }
      }
    }
    if (legend) {
      let names = [];
      for (let s = 0; s < n.series.length; s++) names.push(n.series[s].name);
      out += drawLegend(o, tc, H - legendH / 2 + 2, names, colors);
    }
    out += "</svg>";
    return out;
  }

  function wrapLabel(s, maxChars) {
    s = String(s == null ? "" : s);
    if (!s.length) return [""];
    let words = s.split(/\s+/);
    let out = [];
    let cur = "";
    for (let i = 0; i < words.length; i++) {
      let w = words[i];
      if (!w.length) continue;
      if (cur.length && cur.length + 1 + w.length <= maxChars) { cur += " " + w; continue; }
      if (cur.length) out.push(cur);
      cur = w;
      while (cur.length > maxChars) {
        out.push(cur.slice(0, maxChars));
        cur = cur.slice(maxChars);
      }
    }
    if (cur.length) out.push(cur);
    return out.length ? out : [""];
  }

  function textOverflows(svg) {
    let bad = [];
    let h = 300;
    let hm = svg.match(/viewBox="0 0 \d+ (\d+)"/);
    if (hm) h = +hm[1];
    let re = /<text\b([^>]*)>([\s\S]*?)<\/text>/g;
    let m;
    while ((m = re.exec(svg))) {
      let attrs = m[1];
      let inner = m[2];
      let xm = attrs.match(/\bx="([-\d.]+)"/);
      let ym = attrs.match(/\by="([-\d.]+)"/);
      if (!xm || !ym) continue;
      let x = +xm[1];
      let y = +ym[1];
      let am = attrs.match(/text-anchor:([a-z]+)/);
      let anchor = am ? am[1] : "start";
      let segs = [];
      let first = inner.replace(/<tspan\b[\s\S]*/, "").trim();
      if (first) segs.push({ x: x, y: y, text: first });
      let ycur = y;
      let re2 = /<tspan\b([^>]*)>([\s\S]*?)(?=<tspan\b|$)/g;
      let m2;
      while ((m2 = re2.exec(inner))) {
        let ax = m2[1].match(/\bx="([-\d.]+)"/);
        let sx = ax ? +ax[1] : x;
        let dy = m2[1].match(/\bdy="([-\d.]+)"/);
        ycur += dy ? +dy[1] : 0;
        let text = m2[2].replace(/<[^>]*>/g, "").trim();
        segs.push({ x: sx, y: ycur, text: text });
      }
      for (let k = 0; k < segs.length; k++) {
        let seg = segs[k];
        let w = seg.text.length * 6.4;
        let left = anchor === "end" ? seg.x - w : (anchor === "middle" ? seg.x - w / 2 : seg.x);
        let right = anchor === "end" ? seg.x : (anchor === "middle" ? seg.x + w / 2 : seg.x + w);
        if (left < -0.5 || right > VB_W + 0.5 || seg.y < -8 || seg.y > h + 0.5) {
          bad.push({ x: seg.x, y: seg.y, content: seg.text.slice(0, 24), left: left, right: right, h: h });
        }
      }
    }
    return bad;
  }

  function renderBarsH(n, o) {
    let tc = themeColors(o.theme);
    let legend = o.legend == null ? n.series.length > 1 : !!o.legend;
    let legendH = legend ? 22 : 0;
    let titleH = o.title ? 26 : 0;
    let H = Math.max(160, Math.floor(+o.height || 300));
    let T = titleH + 8;
    let xL = 86, xR = 44;
    let B = legendH + 6;
    let x0 = xL, x1 = VB_W - xR, y0 = T, y1 = H - B - 24;
    let range = valueRange(n.series, o);
    let lo = range.mn, hi = range.mx;
    let ticks = niceTicks(lo, hi, Math.max(2, Math.floor(+o.ticks) || 4));
    lo = ticks[0]; hi = ticks[ticks.length - 1];
    let xs = xScale(lo, hi, x0, x1);
    let sc = Math.max(hi, range.mx * 1.07);
    let bxs = sc === hi ? xs : xScale(lo, sc, x0, x1);
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let nS = n.series.length;
    let nG = n.labels.length;
    let gap = o.gap == null ? 0.25 : +o.gap;
    let maxChars = Math.max(4, Math.floor((x0 - 8) / 6.4));
    let labelLines = [];
    let totalLines = 0;
    for (let i = 0; i < nG; i++) {
      let lines = wrapLabel(textOf(n.labels[i]), maxChars);
      if (lines.length > 3) {
        lines = lines.slice(0, 3);
        lines[2] = lines[2].slice(0, Math.max(1, maxChars - 1)) + "…";
      }
      labelLines.push(lines);
      totalLines += lines.length;
    }
    let lineH = (y1 - y0) / Math.max(1, totalLines);
    let lsp = Math.min(13, lineH);
    let out = svgHead(H);
    out += drawTitle(o, tc);
    if (o.gridlines) {
      for (let i = 0; i < ticks.length; i++) {
        let x = xs(ticks[i]);
        out += '<line x1="' + x + '" y1="' + y0 + '" x2="' + x + '" y2="' + y1 + '" style="stroke:' + tc.grid + ';stroke-width:1;"/>';
      }
    }
    out += '<line x1="' + xs(0) + '" y1="' + y0 + '" x2="' + xs(0) + '" y2="' + y1 + '" style="stroke:' + tc.axis + ';stroke-width:1.3;"/>';
    for (let i = 0; i < ticks.length; i++) {
      let lbl = fmt(ticks[i], o.decimals);
      let w = lbl.length * 6 + 4;
      let x = Math.min(xs(ticks[i]), VB_W - 4 - w / 2);
      out += '<text x="' + fmt(x, 1) + '" y="' + (H - B + 2) + '" style="font-size:11px;fill:' + tc.muted + ';text-anchor:middle;">' + lbl + '</text>';
    }
    let cy = y0;
    for (let i = 0; i < nG; i++) {
      let lines = labelLines[i];
      let rowH = lines.length * lineH;
      let bandH = rowH * (1 - gap);
      let barH = bandH / nS;
      let firstY = cy + rowH / 2 - (lines.length - 1) * lsp / 2 + 4;
      out += '<text x="' + (x0 - 8) + '" y="' + fmt(firstY, 1) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">';
      for (let j = 0; j < lines.length; j++) {
        if (j === 0) out += esc(lines[j]);
        else out += '<tspan x="' + (x0 - 8) + '" dy="' + fmt(lsp, 1) + '">' + esc(lines[j]) + '</tspan>';
      }
      out += '</text>';
      for (let s = 0; s < nS; s++) {
        let v = n.series[s].values[i];
        if (v == null || isNaN(v)) continue;
        let by = cy + gap * rowH / 2 + s * barH;
        let topX = Math.max(x0, Math.min(x1, bxs(v)));
        let baseX = Math.max(x0, Math.min(x1, bxs(Math.max(lo, Math.min(sc, 0)))));
        let x = Math.min(baseX, topX);
        let w = Math.max(0.5, Math.abs(topX - baseX));
        let c = colors[s % colors.length];
        out += '<rect x="' + x + '" y="' + by + '" width="' + w + '" height="' + Math.max(1, barH - 1) + '" rx="2.5" fill="' + c + '" opacity="0.9"';
        if (o.tooltips !== false) out += '><title>' + esc(n.labels[i] + ": " + fmt(v, o.decimals)) + '</title></rect>';
        else out += '/>';
        if (s === nS - 1 && o.labels) {
          let vx = bxs(v);
          let txt = fmt(v, o.decimals);
          let tw = txt.length * 6 + 8;
          let anchor, tx;
          if (vx + 6 + tw <= VB_W - 4) { anchor = "start"; tx = vx + 6; }
          else if (vx - tw - 4 >= x + 2) { anchor = "start"; tx = vx - tw - 4; }
          else { anchor = "end"; tx = VB_W - 4; }
          out += '<text x="' + tx + '" y="' + (by + barH / 2 + 4) + '" style="font-size:11px;font-weight:700;fill:' + tc.text + ';text-anchor:' + anchor + ';">' + txt + '</text>';
        }
      }
      cy += rowH;
    }
    if (legend) {
      let names = [];
      for (let s = 0; s < n.series.length; s++) names.push(n.series[s].name);
      out += drawLegend(o, tc, H - legendH / 2 + 2, names, colors);
    }
    out += "</svg>";
    return out;
  }

  function renderLine(n, o) {
    let tc = themeColors(o.theme);
    let legend = o.legend == null ? n.series.length > 1 : !!o.legend;
    let legendH = legend ? 22 : 0;
    let xLabelsH = o.labels ? 24 : 6;
    let titleH = o.title ? 26 : 0;
    let lay = layout(o, titleH, legendH, xLabelsH);
    let H = lay.H, x0 = lay.x0, x1 = lay.x1, y0 = lay.y0, y1 = lay.y1;
    let vals = [];
    for (let s = 0; s < n.series.length; s++) {
      let vs = n.series[s].values;
      for (let i = 0; i < vs.length; i++) vals.push(vs[i]);
    }
    let y = yScaleInfo(vals, o, y0, y1);
    let lo = y.lo, hi = y.hi, ticks = y.ticks;
    let ly = y.ly, by = y.by, log = y.log;
    let nG = n.labels.length;
    let xFor = nG <= 1 ? function() { return (x0 + x1) / 2; } : function(i) { return x0 + (x1 - x0) * i / (nG - 1); };
    let baseY = y.baseY;
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let smooth = o.smooth === true || o.smooth === "true";
    let out = svgHead(H);
    out += drawTitle(o, tc);
    out += drawGrid(o, tc, ly, x0, x1, y0, y1, ticks, lo, hi);
    out += drawTicksY(o, tc, ly, ticks, x0, o.decimals);
    let lineBand = bandLoUp(o, nG);
    if (lineBand) out += drawBand(o, xFor, by, lineBand, nG, colors);
    for (let s = 0; s < n.series.length; s++) {
      let c = colors[s % colors.length];
      let vals = n.series[s].values;
      let spts = [];
      for (let i = 0; i < nG; i++) {
        let v = vals[i];
        if (log && !(v > 0)) continue;
        spts.push({ x: xFor(i), y: isFinite(v) ? by(v) : baseY, i: i });
      }
      if (o.fill !== false && spts.length >= 2) {
        let poly = spts.map(function(p) { return fmt(p.x, 1) + "," + fmt(p.y, 1); }).join(" ") + " " + fmt(spts[spts.length - 1].x, 1) + "," + fmt(baseY, 1) + " " + fmt(spts[0].x, 1) + "," + fmt(baseY, 1);
        out += '<polygon points="' + poly + '" fill="' + c + '" opacity="0.13"/>';
      }
      if (smooth && spts.length >= 2) {
        out += '<path d="' + smoothPath(spts) + '" fill="none" stroke="' + c + '" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>';
      } else {
        out += '<polyline points="' + spts.map(function(p) { return fmt(p.x, 1) + "," + fmt(p.y, 1); }).join(" ") + '" fill="none" stroke="' + c + '" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>';
      }
      for (let i = 0; i < spts.length; i++) {
        let p = spts[i];
        out += '<circle cx="' + fmt(p.x, 1) + '" cy="' + fmt(p.y, 1) + '" r="3.2" fill="' + c + '"';
        if (o.tooltips !== false) out += '><title>' + esc(n.labels[p.i] + ": " + fmt(vals[p.i], o.decimals)) + '</title></circle>';
        else out += '/>';
      }
    }
    if (o.labels) {
      let step = Math.ceil(nG / 12);
      let slotW = step * (x1 - x0) / Math.max(1, nG - 1);
      let maxChars = Math.max(4, Math.floor(slotW / 6.4) - 1);
      for (let i = 0; i < nG; i++) {
        if (i % step === 0) {
          let lbl = String(textOf(n.labels[i]));
          if (lbl.length > maxChars) lbl = lbl.slice(0, Math.max(1, maxChars - 1)) + "…";
          let w = lbl.length * 6.4 + 4;
          let x = Math.max(x0 + w / 2, Math.min(xFor(i), VB_W - 4 - w / 2));
          out += '<text x="' + fmt(x, 1) + '" y="' + (H - legendH - 6) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:middle;">' + esc(lbl) + '</text>';
        }
      }
    }
    if (legend) {
      let names = [];
      for (let s = 0; s < n.series.length; s++) names.push(n.series[s].name);
      out += drawLegend(o, tc, H - legendH / 2 + 2, names, colors);
    }
    out += "</svg>";
    return out;
  }

  function renderPie(n, o, isDonut) {
    let tc = themeColors(o.theme);
    let vals = n.series[0].values;
    let labels = n.labels;
    let total = 0;
    for (let i = 0; i < vals.length; i++) if (isFinite(vals[i])) total += Math.abs(vals[i]);
    if (total <= 0) return "(charts." + (isDonut ? "donut" : "pie") + ": values must sum to more than 0)";
    let titleH = o.title ? 26 : 0;
    let showN = Math.min(vals.length, 10);
    let hasMore = vals.length > showN;
    let legendH = showN * 20 + 14 + (hasMore ? 24 : 0);
    let pieH = Math.max(160, Math.floor(+o.height || 300) - titleH - legendH - 16);
    let H = titleH + pieH + legendH + 8;
    let cx = VB_W / 2;
    let cy = titleH + 10 + pieH / 2;
    let r = Math.min(pieH / 2 - 10, VB_W / 2 - 76);
    let ri = isDonut ? r * 0.62 : 0;
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let out = svgHead(H);
    out += drawTitle(o, tc);
    let start = -90;
    for (let i = 0; i < vals.length; i++) {
      let v = Math.abs(isFinite(vals[i]) ? vals[i] : 0);
      if (v <= 0) continue;
      let ang = v / total * 360;
      let c = colors[i % colors.length];
      let tip = "";
      if (o.tooltips !== false) {
        tip = '><title>' + esc(labels[i] + ": " + fmt(v, o.decimals) + " (" + fmt(v / total * 100, 1) + "%)") + '</title></path>';
      } else {
        tip = "/>";
      }
      if (ang >= 359.9) {
        out += '<path d="M ' + cx + " " + (cy - r) + " a " + r + " " + r + " 0 1 1 0.01 0 Z\" fill=\"" + c + '" opacity="0.92"' + tip;
        break;
      }
      let p1 = polar(cx, cy, r, start);
      let p2 = polar(cx, cy, r, start + ang);
      let large = ang > 180 ? 1 : 0;
      let d;
      if (!isDonut) {
        d = "M " + cx + " " + cy + " L " + fmt(p1.x, 2) + " " + fmt(p1.y, 2) + " A " + r + " " + r + " 0 " + large + " 1 " + fmt(p2.x, 2) + " " + fmt(p2.y, 2) + " Z";
      } else {
        let q1 = polar(cx, cy, ri, start);
        let q2 = polar(cx, cy, ri, start + ang);
        d = "M " + fmt(p1.x, 2) + " " + fmt(p1.y, 2) + " A " + r + " " + r + " 0 " + large + " 1 " + fmt(p2.x, 2) + " " + fmt(p2.y, 2) + " L " + fmt(q2.x, 2) + " " + fmt(q2.y, 2) + " A " + ri + " " + ri + " 0 " + large + " 0 " + fmt(q1.x, 2) + " " + fmt(q1.y, 2) + " Z";
      }
      out += '<path d="' + d + '" fill="' + c + '" opacity="0.92"' + tip;
      if (ang >= 15) {
        let mid = start + ang / 2;
        let pr = isDonut ? (r + ri) / 2 : r * 0.62;
        let lp = polar(cx, cy, pr, mid);
        out += '<text x="' + fmt(lp.x, 1) + '" y="' + fmt(lp.y, 1) + '" style="font-size:11px;font-weight:700;fill:' + (isDonut ? tc.text : "#fff") + ';text-anchor:middle;dominant-baseline:central;">' + fmt(v / total * 100, 1) + "%</text>";
      }
      start += ang;
    }
    if (isDonut) {
      let ctv = o.centerText != null ? String(o.centerText) : fmt(total, o.decimals);
      out += '<text x="' + cx + '" y="' + (cy - 4) + '" style="font-size:22px;font-weight:800;fill:' + tc.text + ';text-anchor:middle;">' + esc(ctv) + '</text>';
      out += '<text x="' + cx + '" y="' + (cy + 15) + '" style="font-size:11px;fill:' + tc.muted + ';text-anchor:middle;">total</text>';
    }
    let colX = (VB_W - 330) / 2;
    for (let i = 0; i < showN; i++) {
      let yy = titleH + pieH + 22 + i * 20;
      let v = Math.abs(isFinite(vals[i]) ? vals[i] : 0);
      out += '<rect x="' + colX + '" y="' + (yy - 6) + '" width="11" height="11" rx="3" fill="' + colors[i % colors.length] + '" opacity="0.92"/>';
      out += '<text x="' + (colX + 17) + '" y="' + (yy + 3) + '" style="font-size:12px;fill:' + tc.muted + ';">' + esc(labels[i]) + '</text>';
      out += '<text x="' + (colX + 330) + '" y="' + (yy + 3) + '" style="font-size:12px;font-weight:700;fill:' + tc.text + ';text-anchor:end;">' + fmt(v, o.decimals) + " · " + fmt(v / total * 100, 1) + "%</text>";
    }
    if (vals.length > showN) {
      out += '<text x="' + (VB_W / 2) + '" y="' + (titleH + pieH + 22 + showN * 20 + 12) + '" style="font-size:11px;fill:' + tc.muted + ';text-anchor:middle;">… and ' + (vals.length - showN) + " more</text>";
    }
    out += "</svg>";
    return out;
  }

  function autoBinCount(nv) {
    if (!(nv > 1)) return 1;
    return Math.max(1, Math.min(60, Math.ceil(Math.log2(nv) + 1)));
  }

  function allIntegers(nums) {
    for (let i = 0; i < nums.length; i++) { if (Math.round(nums[i]) !== nums[i]) return false; }
    return true;
  }

  // Bin a raw numeric sample — the actual job of a histogram — honouring `bins`.
  function binSample(vals, binsOpt) {
    let nums = [];
    for (let i = 0; i < vals.length; i++) { let v = num(vals[i]); if (isFinite(v)) nums.push(v); }
    if (!nums.length) return null;
    let r = minMax(nums);
    let lo = r.mn, hi = r.mx;
    let auto = binsOpt == null || binsOpt === "auto" || binsOpt === true;
    let want;
    if (auto) want = autoBinCount(nums.length);
    else { want = Math.floor(+binsOpt); if (!(want > 0)) want = autoBinCount(nums.length); }
    want = Math.max(1, Math.min(120, want));
    let counts = [], labels = [], centers = [];
    // A small-range integer sample (dice totals, star ratings, counts) reads far
    // better as one bar per value than as arbitrary fractional bin edges, so when
    // no explicit `bins` was given we snap to discrete integer bins.
    if (auto && allIntegers(nums) && (hi - lo) <= 30) {
      let base = Math.round(r.mn);
      want = Math.max(1, Math.round(hi - lo) + 1);
      lo = r.mn - 0.5; hi = r.mx + 0.5;
      for (let b = 0; b < want; b++) {
        let x = base + b, sum = 0;
        for (let i = 0; i < nums.length; i++) if (Math.round(nums[i]) === x) sum++;
        counts.push(sum);
        centers.push(x);
        labels.push(fmt(x, 0));
      }
    } else {
      if (!(hi > lo)) { lo = lo - 0.5; hi = hi + 0.5; }
      let step = (hi - lo) / want;
      if (!(step > 0)) step = 1;
      for (let b = 0; b < want; b++) {
        let a = lo + b * step, c = lo + (b + 1) * step;
        let sum = 0;
        for (let i = 0; i < nums.length; i++) {
          let v = nums[i];
          if (b === want - 1 ? (v >= a && v <= c + 1e-9) : (v >= a && v < c)) sum++;
        }
        counts.push(sum);
        centers.push((a + c) / 2);
        labels.push(fmt(a, 2) + "–" + fmt(c, 2));
      }
    }
    let m = 0;
    for (let i = 0; i < nums.length; i++) m += nums[i];
    m /= nums.length;
    let sq = 0;
    for (let i = 0; i < nums.length; i++) sq += (nums[i] - m) * (nums[i] - m);
    return { labels: labels, counts: counts, centers: centers, lo: lo, hi: hi, n: nums.length, mean: m, std: Math.sqrt(sq / nums.length) };
  }

  // Turn a raw sample into the internal distribution shape renderHisto draws.
  function sampleDist(vals, o) {
    let b = binSample(vals || [], o && o.bins);
    if (!b) return null;
    return { values: b.centers, probs: b.counts, labels: b.labels, loc: "count", lo: b.lo, hi: b.hi, expr: null, mean: b.mean, std: b.std, n: b.n };
  }

  function firstSeriesValues(n) {
    if (!n || !n.series) return null;
    for (let s = 0; s < n.series.length; s++) {
      let v = n.series[s] && n.series[s].values;
      if (v && v.length) return v;
    }
    return null;
  }

  function renderHisto(n, o) {
    let dist = n.dist;
    if (!dist || !dist.values || !dist.values.length) return renderBars(n, o);
    let tc = themeColors(o.theme);
    let V = dist.values.slice();
    let P = dist.probs.slice();
    let mean = dist.mean, std = dist.std;
    let dataLo = V[0], dataHi = V[V.length - 1];
    for (let i = 0; i < V.length; i++) {
      if (V[i] < dataLo) dataLo = V[i];
      if (V[i] > dataHi) dataHi = V[i];
    }
    let loc = dist.loc === "count" ? "count" : "prob";
    if (dist.lo != null && dist.hi != null && dist.hi > dist.lo) { dataLo = dist.lo; dataHi = dist.hi; }
    let preLabels = (loc === "count" && Array.isArray(dist.labels) && dist.labels.length === V.length) ? dist.labels : null;
    let labels = [];
    let binned = false;
    let MAXB = 42;
    let count = V.length;
    if (preLabels) {
      for (let i = 0; i < preLabels.length; i++) labels.push(preLabels[i]);
    } else if (count > MAXB) {
      let span = dataHi - dataLo;
      if (span <= 0) span = 1;
      let step = span / MAXB;
      let bv = [], bp = [], bl = [];
      for (let b = 0; b < MAXB; b++) {
        let a = dataLo + b * step;
        let c2 = dataLo + (b + 1) * step;
        let sum = 0;
        for (let i = 0; i < V.length; i++) if (V[i] >= a && V[i] < c2) sum += P[i];
        bv.push((a + c2) / 2);
        bp.push(sum);
        bl.push(fmt(a, 2) + "–" + fmt(c2, 2));
      }
      V = bv; P = bp; labels = bl; binned = true;
    } else {
      for (let i = 0; i < V.length; i++) labels.push(fmt(V[i], o.decimals == null ? 0 : o.decimals));
    }
    let maxP = 0;
    for (let i = 0; i < P.length; i++) if (P[i] > maxP) maxP = P[i];
    if (maxP <= 0) maxP = 1;
    let title = o.title != null ? textOf(o.title) : (textOf(dist.expr) ? "Distribution of " + textOf(dist.expr) : "Histogram");
    let o2 = mergeOpts(defaultOpts(), o);
    o2.title = title;
    let titleH = 26;
    let xLabelsH = o.labels ? 24 : 6;
    let lay = layout(o2, titleH, 0, xLabelsH);
    let H = lay.H, x0 = lay.x0, x1 = lay.x1, y0 = lay.y0, y1 = lay.y1;
    let ticks = niceTicks(0, maxP, Math.max(2, Math.floor(+o.ticks) || 4));
    let hi = ticks[ticks.length - 1];
    let ly = yScale(0, hi, y0, y1);
    let sc = Math.max(hi, maxP * 1.07);
    let by = sc === hi ? ly : yScale(0, sc, y0, y1);
    let decP = o.decimals != null ? +o.decimals : (loc === "count" ? 0 : (maxP * 100 < 3 ? 2 : 1));
    let fmtY = loc === "count" ? function(v) { return fmt(v, decP); } : function(v) { return fmtP(v, decP); };
    let out = svgHead(H);
    out += drawTitle(o2, tc);
    out += drawGrid(o2, tc, ly, x0, x1, y0, y1, ticks, 0, hi);
    for (let i = 0; i < ticks.length; i++) {
      let y = ly(ticks[i]);
      out += '<text x="' + (x0 - 7) + '" y="' + (y + 4) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">' + fmtY(ticks[i]) + '</text>';
    }
    let nB = P.length;
    let stepW = (x1 - x0) / Math.max(1, nB);
    let barW = stepW * 0.72;
    let xStep = Math.max(1, Math.ceil(nB / 10));
    for (let i = 0; i < nB; i++) {
      let p = P[i];
      let h = Math.max(1, p / sc * (y1 - y0));
      let y = y1 - h;
      let peak = p >= maxP - 1e-12;
      let c = peak ? tc.barPeak : tc.bar;
      let bx = x0 + i * stepW + (stepW - barW) / 2;
      out += '<rect x="' + bx + '" y="' + y + '" width="' + barW + '" height="' + h + '" rx="2" fill="' + c + '" opacity="0.88"';
      if (o.tooltips !== false) out += '><title>' + esc(labels[i] + ": " + fmtY(p)) + '</title></rect>';
      else out += '/>';
      if (i % xStep === 0) {
        out += '<text x="' + (bx + barW / 2) + '" y="' + (H - 6) + '" style="font-size:11px;fill:' + tc.muted + ';text-anchor:middle;">' + esc(labels[i]) + '</text>';
      }
    }
    let foot = loc === "count" ? ((dist.n != null ? dist.n : "") + " values · " + count + " bins") : (count + " outcomes");
    out += '<text x="' + (x1 - 2) + '" y="' + (y0 + 11) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">' + esc(foot) + " · μ " + (isFinite(mean) ? fmt(mean, 2) : "—") + " · σ " + (isFinite(std) ? fmt(std, 2) : "—") + "</text>";
    if (isFinite(mean) && mean >= dataLo && mean <= dataHi && dataHi > dataLo) {
      let mx = x0 + (mean - dataLo) / (dataHi - dataLo) * (x1 - x0);
      out += '<line x1="' + mx + '" y1="' + y0 + '" x2="' + mx + '" y2="' + y1 + '" style="stroke:' + tc.axis + ';stroke-width:1.2;stroke-dasharray:4 3;"/>';
      let anchor = mx > x1 - 72 ? "end" : "start";
      let tx = anchor === "end" ? mx - 5 : mx + 5;
      out += '<text x="' + tx + '" y="' + (y0 + 25) + '" style="font-size:11.5px;font-weight:700;fill:' + tc.text + ';text-anchor:' + anchor + ';">μ ' + fmt(mean, 2) + "</text>";
    }
    out += "</svg>";
    return out;
  }


  // ---------- time-series ----------

  function tf(v) {
    return v === true || v === "true";
  }

  function parseT(v) {
    v = resolve(v);
    if (typeof v === "number") return v;
    if (typeof v === "string") {
      let s = v.trim();
      if (/^-?\d+$/.test(s)) {
        let n = +s;
        if (Math.abs(n) >= 1e8) return n;
        let t = Date.parse(s);
        if (isFinite(t)) return t;
        return n;
      }
      let t = Date.parse(s);
      if (isFinite(t)) return t;
    }
    let n2 = num(v);
    return isFinite(n2) ? n2 : NaN;
  }

  function tsOf(e) {
    if (e == null) return null;
    if (Array.isArray(e)) {
      let t = num(e[0]), v = num(e[1]);
      return isFinite(t) ? { t: t, v: isFinite(v) ? v : NaN } : null;
    }
    let o = toObj(e);
    if (!o) return null;
    let t = o.t !== undefined ? parseT(o.t) : (o.time !== undefined ? parseT(o.time) : NaN);
    let v = o.v !== undefined ? num(o.v) : (o.value !== undefined ? num(o.value) : NaN);
    return isFinite(t) ? { t: t, v: v } : null;
  }

  function serPointsOf(raw) {
    if (raw == null || typeof raw !== "object" || Array.isArray(raw)) return null;
    let rdata = raw.data != null ? raw.data : raw.values;
    if (rdata == null) return null;
    let its = [];
    if (Array.isArray(rdata)) {
      its = rdata;
    } else if (typeof rdata === "object" && isListNode(rdata)) {
      try {
        its = listItems(rdata);
      } catch (e) {
        return null;
      }
    } else {
      return null;
    }
    let pts = [];
    for (let j = 0; j < its.length; j++) { let p = tsOf(its[j]); if (p) pts.push(p); }
    return pts;
  }

  function normTime(input, opts) {
    if (input == null) return { ok: false, error: "expected an array of {t, v} points, or a series object" };
    let d = input;
    if (d != null && isListNode(d)) {
      let items;
      try {
        items = listItems(d);
      } catch (e) {
        return { ok: false, error: "could not read list data" };
      }
      if (items.length && items[0] != null && typeof items[0] === "object" && !Array.isArray(items[0]) &&
        (items[0].data !== undefined || items[0].values !== undefined) &&
        items[0].t === undefined && items[0].v === undefined) {
        let series = [];
        for (let i = 0; i < items.length; i++) {
          let raw = items[i];
          let nm = raw.name != null ? textOf(raw.name) : "Series " + (i + 1);
          let pts = serPointsOf(raw);
          if (pts && pts.length) series.push({ name: nm, ts: pts.map(function(p) { return p.t; }), vals: pts.map(function(p) { return p.v; }) });
        }
        if (!series.length) return { ok: false, error: "no {t, v} points found in series data" };
        return { ok: true, series: series, error: null };
      }
      let arr = [];
      for (let i = 0; i < items.length; i++) {
        let it = items[i];
        let o = it != null && typeof it === "object" ? toObj(it) : null;
        if (o) arr.push(o); else arr.push(resolve(it));
      }
      d = arr;
    } else {
      d = resolve(d);
    }
    if (Array.isArray(d)) {
      let fRaw = d.length ? d[0] : null;
      let isSeries = fRaw != null && typeof fRaw === "object" && !Array.isArray(fRaw) &&
        (fRaw.data !== undefined || fRaw.values !== undefined) &&
        fRaw.t === undefined && fRaw.v === undefined;
      if (isSeries) {
        let series = [];
        for (let i = 0; i < d.length; i++) {
          let raw = d[i];
          if (raw == null || typeof raw !== "object" || Array.isArray(raw)) continue;
          let nm = raw.name != null ? textOf(raw.name) : "Series " + (i + 1);
          let pts = serPointsOf(raw);
          if (pts && pts.length) series.push({ name: nm, ts: pts.map(function(p) { return p.t; }), vals: pts.map(function(p) { return p.v; }) });
        }
        if (!series.length) return { ok: false, error: "no {t, v} points found in series data" };
        return { ok: true, series: series, error: null };
      }
      let pts = [];
      for (let i = 0; i < d.length; i++) {
        let p = tsOf(d[i]);
        if (p) pts.push(p);
      }
      if (pts.length) {
        return { ok: true, series: [{ name: "value", ts: pts.map(function(p) { return p.t; }), vals: pts.map(function(p) { return p.v; }) }], error: null };
      }
    }
    let n = normData(d, opts);
    if (!n.ok) return n;
    let series = [];
    for (let s = 0; s < n.series.length; s++) {
      let ts = [], vals = [];
      for (let i = 0; i < n.series[s].values.length; i++) {
        let t = n.labels[i] != null ? parseT(n.labels[i]) : i;
        if (!isFinite(t)) t = i;
        ts.push(t);
        vals.push(num(n.series[s].values[i]));
      }
      series.push({ name: n.series[s].name, ts: ts, vals: vals });
    }
    return { ok: true, series: series, error: null };
  }

  function looksLikeTime(labels) {
    if (!labels || !labels.length) return false;
    let n = 0;
    for (let i = 0; i < labels.length; i++) {
      let l = resolve(labels[i]);
      if (l == null) return false;
      if (typeof l === "number") {
        if (!(l >= 1e9)) return false;
        n++;
      } else if (typeof l === "string") {
        let s = l.trim();
        if (/^\d+$/.test(s)) {
          if (!(Number(s) >= 1e9)) return false;
          n++;
        } else {
          if (!isFinite(Date.parse(s))) return false;
          n++;
        }
      } else {
        return false;
      }
    }
    return n > 0;
  }

  function niceTimeStep(range) {
    let steps = [
      60e3, 5 * 60e3, 10 * 60e3, 15 * 60e3, 30 * 60e3,
      3600e3, 2 * 3600e3, 4 * 3600e3, 6 * 3600e3, 12 * 3600e3,
      24 * 3600e3, 2 * 24 * 3600e3, 3 * 24 * 3600e3, 7 * 24 * 3600e3,
      14 * 24 * 3600e3, 30 * 24 * 3600e3, 90 * 24 * 3600e3,
      180 * 24 * 3600e3, 365 * 24 * 3600e3
    ];
    let target = range / 5.5;
    for (let i = 0; i < steps.length; i++) {
      if (steps[i] >= target) return steps[i];
    }
    return steps[steps.length - 1];
  }

  function binStart(t, hourly) {
    let d = new Date(t);
    if (hourly) d.setMinutes(0, 0, 0);
    else d.setHours(0, 0, 0, 0);
    return d.getTime();
  }

  function nextBinStart(t, hourly) {
    let d = new Date(binStart(t, hourly));
    if (hourly) d.setHours(d.getHours() + 1);
    else d.setDate(d.getDate() + 1);
    return d.getTime();
  }

  function timeTicks(t0, t1, step) {
    let hourly = step < 24 * 3600e3;
    let e0 = binStart(0, hourly);
    let s = e0 + Math.ceil((t0 - e0) / step) * step;
    let out = [];
    for (let t = s; t <= t1 + 0.5; t += step) out.push(t);
    return out;
  }

  function fmtTimeTick(t, step, spanDays) {
    let d = new Date(t);
    if (step < 24 * 3600e3) {
      let h = d.getHours();
      let ap = h >= 12 ? "PM" : "AM";
      h = h % 12; if (h === 0) h = 12;
      return h + " " + ap;
    }
    let mon = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"][d.getMonth()];
    let s = mon + " " + d.getDate();
    if (spanDays > 130) s += " " + d.getFullYear();
    return s;
  }

  function strideDecimate(pts, n) {
    if (!n || pts.length <= n) return pts;
    let step = (pts.length - 1) / Math.max(1, n - 1);
    let out = [];
    for (let i = 0; i < n - 1; i++) out.push(pts[Math.floor(i * step)]);
    out.push(pts[pts.length - 1]);
    return out;
  }

  function linSlope(pts) {
    if (pts.length < 2) return null;
    let n = pts.length;
    let sx = 0, sy = 0, sxx = 0, sxy = 0;
    let t0 = pts[0].t;
    for (let i = 0; i < n; i++) {
      let x = pts[i].t - t0;
      let y = pts[i].v;
      sx += x; sy += y; sxx += x * x; sxy += x * y;
    }
    let den = n * sxx - sx * sx;
    if (den === 0) return null;
    let slope = (n * sxy - sx * sy) / den;
    return { slope: slope, slopeDay: slope * 86400e3, intercept: (sy - slope * sx) / n, t0: t0 };
  }

  function smoothPath(pts) {
    let d = "M " + fmt(pts[0].x, 1) + " " + fmt(pts[0].y, 1);
    for (let i = 0; i < pts.length - 1; i++) {
      let mx = (pts[i].x + pts[i + 1].x) / 2;
      let my = (pts[i].y + pts[i + 1].y) / 2;
      d += " Q " + fmt(pts[i].x, 1) + " " + fmt(pts[i].y, 1) + " " + fmt(mx, 1) + " " + fmt(my, 1);
    }
    let lp = pts[pts.length - 1];
    d += " L " + fmt(lp.x, 1) + " " + fmt(lp.y, 1);
    return d;
  }

  function drawTag(tc, x, y, text, color, icon, anchor) {
    let iconW = icon ? 15 : 0;
    let w = Math.max(30, text.length * 6.2 + iconW + 20);
    let h = 21;
    let px = anchor === "end" ? x - w : (anchor === "start" ? x : x - w / 2);
    px = Math.max(1, Math.min(VB_W - w - 1, px));
    let out = "";
    out += "<g>";
    out += '<rect x="' + px + '" y="' + (y - h / 2) + '" width="' + w + '" height="' + h + '" rx="10.5" fill="' + (color || tc.text) + '" opacity="0.13" stroke="' + (color || tc.text) + '" stroke-width="1" stroke-dasharray="3 2"/>';
    if (icon) out += '<text x="' + (px + 9) + '" y="' + (y + 5) + '" style="font-size:11px;text-anchor:middle;">' + icon + '</text>';
    out += '<text x="' + (px + (icon ? 21 : 11)) + '" y="' + (y + 4) + '" style="font-size:11px;font-weight:700;fill:' + tc.text + ';">' + esc(text) + '</text>';
    out += "</g>";
    return out;
  }

  function logTicks(llo, lhi) {
    let out = [];
    let e0 = Math.floor(llo), e1 = Math.ceil(lhi);
    for (let e = e0; e <= e1; e++) {
      let base = Math.pow(10, e);
      let cands = [1, 2, 5];
      for (let j = 0; j < cands.length; j++) {
        let c = cands[j] * base;
        let lc = Math.log10(c);
        if (lc >= llo - 1e-9 && lc <= lhi + 1e-9) out.push(c);
      }
    }
    let uniq = [];
    for (let i = 0; i < out.length; i++) if (!uniq.length || uniq[uniq.length - 1] !== out[i]) uniq.push(out[i]);
    return uniq;
  }

  function yScaleInfo(vals, o, y0, y1) {
    let mn = Infinity, mx = -Infinity;
    for (let i = 0; i < vals.length; i++) {
      let v = vals[i];
      if (!isFinite(v)) continue;
      if (v < mn) mn = v;
      if (v > mx) mx = v;
    }
    if (!isFinite(mn)) { mn = 0; mx = 1; }
    if (o.min != null) mn = +o.min;
    if (o.max != null) mx = +o.max;
    if (!(mn < mx)) { if (mx === mn) mx = mn + 1; else { let t = mn; mn = mx; mx = t; } }
    let wantLog = o.log === true || o.log === "true";
    if (o.log === "auto") wantLog = mn > 0 && mx / mn > 100;
    if (wantLog && mn > 0) {
      let ticks = logTicks(Math.log10(mn), Math.log10(mx));
      if (!ticks.length) ticks = [mn, mx];
      let tlo = Math.log10(ticks[0]), thi = Math.log10(ticks[ticks.length - 1]);
      let ly = function(v) { return y1 - (Math.log10(v) - tlo) / (thi - tlo) * (y1 - y0); };
      let sc = Math.max(mx, mx * 1.07);
      let by = sc === mx ? ly : function(v) { return y1 - (Math.log10(v) - tlo) / (Math.log10(sc) - tlo) * (y1 - y0); };
      return { lo: ticks[0], hi: ticks[ticks.length - 1], ticks: ticks, ly: ly, by: by, log: true, sc: sc, baseY: y1 };
    }
    if (o.min == null && mn >= 0) mn = 0;
    let ticks = niceTicks(mn, mx, Math.max(2, Math.floor(+o.ticks) || 4));
    let tlo = ticks[0], thi = ticks[ticks.length - 1];
    let ly = yScale(tlo, thi, y0, y1);
    let sc = Math.max(thi, mx * 1.07);
    let by = sc === thi ? ly : yScale(tlo, sc, y0, y1);
    let baseY = Math.max(y0, Math.min(y1, by(Math.max(tlo, Math.min(sc, 0)))));
    return { lo: tlo, hi: thi, ticks: ticks, ly: ly, by: by, log: false, sc: sc, baseY: baseY };
  }

  function binGains(serPts, hourly) {
    let out = [];
    for (let s = 0; s < serPts.length; s++) {
      let g = {};
      let pts = serPts[s];
      for (let i = 0; i < pts.length - 1; i++) {
        let t1 = pts[i].t, t2 = pts[i + 1].t;
        let v1 = pts[i].v, v2 = pts[i + 1].v;
        if (t2 <= t1) continue;
        let gain = v2 - v1;
        let dt = t2 - t1;
        let cur = t1;
        while (cur < t2) {
          let nb = nextBinStart(cur, hourly);
          let end = Math.min(nb, t2);
          let key = binStart(cur, hourly);
          g[key] = (g[key] || 0) + gain * (end - cur) / dt;
          cur = end;
        }
      }
      out.push(g);
    }
    return out;
  }

  function tsEmpty(H, o, tc) {
    let out = svgHead(H);
    out += drawTitle(o, tc);
    out += '<text x="' + (VB_W / 2) + '" y="' + (H / 2) + '" style="font-size:13px;fill:' + tc.muted + ';text-anchor:middle;">No data in range.</text>';
    out += "</svg>";
    return out;
  }

  function renderTimeSeries(series, o) {
    let tc = themeColors(o.theme);
    let titleH = o.title ? 26 : 0;
    let xLabelsH = o.labels ? 24 : 6;
    let H = Math.max(160, Math.floor(+o.height || 300));
    let T = titleH + 8;
    let B = xLabelsH + 6;
    let x0 = 58, R = 88, x1 = VB_W - R, y0 = T, y1 = H - B;
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let mode = (o.mode === "bars" || o.mode === "combo" || o.mode === "norm") ? o.mode : "line";
    let maxPoints = Math.max(2, Math.floor(+o.maxPoints || 400));
    let smooth = tf(o.smooth);
    let log = o.log === true || o.log === "true";

    let names = [];
    let serPts = [];
    let allPts = [];
    for (let s = 0; s < series.length; s++) {
      let pts = [];
      let tsArr = series[s].ts, vs = series[s].vals;
      for (let i = 0; i < tsArr.length; i++) {
        if (isFinite(tsArr[i]) && isFinite(vs[i])) pts.push({ t: tsArr[i], v: vs[i] });
      }
      names.push(series[s].name != null ? String(series[s].name) : "Series " + (s + 1));
      serPts.push(pts);
      for (let i = 0; i < pts.length; i++) allPts.push(pts[i]);
    }

    if (mode === "norm") {
      let keepIdx = [];
      for (let s = 0; s < serPts.length; s++) {
        let anchor = serPts[s].length ? serPts[s][0].v : NaN;
        if (isFinite(anchor) && anchor !== 0 && serPts[s].length) {
          for (let i = 0; i < serPts[s].length; i++) serPts[s][i].v = serPts[s][i].v / anchor * 100;
          keepIdx.push(s);
        }
      }
      let p2 = [], n2 = [];
      for (let i = 0; i < keepIdx.length; i++) { p2.push(serPts[keepIdx[i]]); n2.push(names[keepIdx[i]]); }
      serPts = p2; names = n2;
      allPts = [];
      for (let s = 0; s < serPts.length; s++) for (let i = 0; i < serPts[s].length; i++) allPts.push(serPts[s][i]);
    }

    if (!allPts.length) return tsEmpty(H, o, tc);

    let tLo = allPts[0].t, tHi = allPts[0].t;
    for (let i = 1; i < allPts.length; i++) {
      if (allPts[i].t < tLo) tLo = allPts[i].t;
      if (allPts[i].t > tHi) tHi = allPts[i].t;
    }
    if (!(tLo < tHi)) tHi = tLo + 1;
    let xs = xScale(tLo, tHi, x0, x1);
    let spanDays = (tHi - tLo) / 86400e3;
    let timeAxis = tLo >= 1e9;
    let step = niceTimeStep(tHi - tLo);
    let xticks = timeTicks(tLo, tHi, step);
    if (xticks.length < 2) xticks = [tLo, tHi];

    let hourly = tHi - tLo <= 48 * 3600e3;
    if (o.bin === "hourly") hourly = true;
    else if (o.bin === "daily") hourly = false;

    // bars / combo prep
    let barInfo = null;
    if (mode === "bars" || mode === "combo") {
      let keySet = {};
      let gains = binGains(serPts, hourly);
      for (let s = 0; s < gains.length; s++) for (let k in gains[s]) keySet[k] = true;
      let binKeys = Object.keys(keySet).map(Number).sort(function(a, b) { return a - b; });
      if (binKeys.length > 120) {
        let stride = Math.ceil(binKeys.length / 120);
        let reduced = [];
        for (let i = 0; i < binKeys.length; i += stride) reduced.push(binKeys[i]);
        binKeys = reduced;
      }
      if (binKeys.length) {
        let barData = [];
        for (let b = 0; b < binKeys.length; b++) {
          let arr = [];
          for (let s = 0; s < serPts.length; s++) arr.push(gains[s][binKeys[b]] || 0);
          barData.push(arr);
        }
        let pct = tf(o.percent);
        if (pct) {
          for (let b = 0; b < barData.length; b++) {
            let sum = 0;
            for (let s = 0; s < barData[b].length; s++) sum += Math.abs(barData[b][s]);
            if (sum > 0) for (let s = 0; s < barData[b].length; s++) barData[b][s] = barData[b][s] / sum * 100;
          }
        }
        let stacked = !(o.stacked === false || o.stacked === "false");
        let ext = [0];
        let segments = [];
        for (let b = 0; b < barData.length; b++) {
          let seg = [];
          let run = 0;
          for (let s = 0; s < barData[b].length; s++) {
            let g = barData[b][s];
            let low = stacked ? run : 0;
            let high = low + g;
            if (stacked) run = high;
            seg.push({ s: s, low: low, high: high });
            ext.push(low); ext.push(high);
          }
          segments.push(seg);
        }
        barInfo = { binKeys: binKeys, segments: segments, ext: ext };
      }
    }
    if ((mode === "bars" || mode === "combo") && !barInfo) mode = "line";

    // y range
    let y;
    if (mode === "bars" && barInfo) {
      y = yScaleInfo(barInfo.ext, o, y0, y1);
    } else {
      let vals = [];
      for (let i = 0; i < allPts.length; i++) vals.push(allPts[i].v);
      y = yScaleInfo(vals, o, y0, y1);
    }
    if (y.log) log = true;
    let ly = y.ly, by = y.by;

    let out = svgHead(H);
    out += drawTitle(o, tc);
    if (o.gridlines) {
      for (let i = 0; i < y.ticks.length; i++) {
        let yy = ly(y.ticks[i]);
        out += '<line x1="' + x0 + '" y1="' + fmt(yy, 1) + '" x2="' + x1 + '" y2="' + fmt(yy, 1) + '" style="stroke:' + tc.grid + ';stroke-width:1;"/>';
      }
    }
    out += '<line x1="' + x0 + '" y1="' + fmt(y.baseY, 1) + '" x2="' + x1 + '" y2="' + fmt(y.baseY, 1) + '" style="stroke:' + tc.axis + ';stroke-width:1.3;"/>';
    let pctLabel = mode === "norm" || (mode === "bars" && tf(o.percent));
    for (let i = 0; i < y.ticks.length; i++) {
      let yy = ly(y.ticks[i]);
      out += '<text x="' + (x0 - 7) + '" y="' + (yy + 4) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">' + fmt(y.ticks[i], o.decimals) + (pctLabel ? "%" : "") + '</text>';
    }

    // bars (mode bars / combo)
    if (barInfo) {
      let bandY0 = y0, bandY1 = y1;
      if (mode === "combo") bandY0 = y0 + (y1 - y0) * 0.68;
      let ext = barInfo.ext;
      let barLo = Math.min.apply(null, ext), barHi = Math.max.apply(null, ext);
      if (barHi === barLo) barHi = barLo + 1;
      let byB = yScale(barLo, barHi, bandY0, bandY1);
      let bw = (x1 - x0) / Math.max(1, barInfo.binKeys.length) * 0.7;
      for (let b = 0; b < barInfo.segments.length; b++) {
        let k = barInfo.binKeys[b];
        let bx = xs(k) - bw / 2;
        for (let j = 0; j < barInfo.segments[b].length; j++) {
          let seg = barInfo.segments[b][j];
          let c = colors[seg.s % colors.length];
          let yT = Math.max(bandY0, Math.min(bandY1, byB(seg.high)));
          let yB = Math.max(bandY0, Math.min(bandY1, byB(seg.low)));
          let yy = Math.min(yT, yB);
          let h = Math.max(0.5, Math.abs(yT - yB));
          out += '<rect x="' + fmt(bx, 1) + '" y="' + fmt(yy, 1) + '" width="' + fmt(bw, 1) + '" height="' + fmt(h, 1) + '" rx="2" fill="' + c + '" opacity="' + (mode === "combo" ? "0.45" : "0.9") + '"';
          if (o.tooltips !== false) out += '><title>' + esc(names[seg.s] + ": " + fmt(seg.high - seg.low, o.decimals)) + '</title></rect>';
          else out += '/>';
        }
      }
      if (mode === "combo") {
        out += '<line x1="' + x0 + '" y1="' + fmt(bandY0, 1) + '" x2="' + x1 + '" y2="' + fmt(bandY0, 1) + '" style="stroke:' + tc.axis + ';stroke-width:1;stroke-dasharray:4 3;"/>';
        out += '<text x="' + (x0 + 4) + '" y="' + (bandY0 - 5) + '" style="font-size:10.5px;fill:' + tc.muted + ';">' + (hourly ? "hourly gain" : "daily gain") + '</text>';
      }
    }

    // lines
    if (mode === "line" || mode === "combo" || mode === "norm") {
      for (let s = 0; s < serPts.length; s++) {
        let pts = strideDecimate(serPts[s], maxPoints);
        if (!pts.length) continue;
        let c = colors[s % colors.length];
        let xy = [];
        for (let i = 0; i < pts.length; i++) {
          let v = pts[i].v;
          if (log && !(v > 0)) continue;
          xy.push({ x: xs(pts[i].t), y: by(v), t: pts[i].t, v: v });
        }
        if (!xy.length) continue;
        if (o.fill !== false && xy.length >= 2) {
          let gid = "tsf" + s + "x" + Math.round(tLo);
          out += '<linearGradient id="' + gid + '" x1="0" y1="0" x2="0" y2="1">';
          out += '<stop offset="0" stop-color="' + c + '" stop-opacity="0.28"/>';
          out += '<stop offset="1" stop-color="' + c + '" stop-opacity="0.02"/>';
          out += '</linearGradient>';
          let poly = xy.map(function(p) { return fmt(p.x, 1) + "," + fmt(p.y, 1); }).join(" ");
          out += '<polygon points="' + poly + " " + fmt(xy[xy.length - 1].x, 1) + "," + fmt(y1, 1) + " " + fmt(xy[0].x, 1) + "," + fmt(y1, 1) + '" fill="url(#' + gid + ')"/>';
        }
        if (smooth && xy.length >= 2) {
          out += '<path d="' + smoothPath(xy) + '" fill="none" stroke="' + c + '" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>';
        } else {
          out += '<polyline points="' + xy.map(function(p) { return fmt(p.x, 1) + "," + fmt(p.y, 1); }).join(" ") + '" fill="none" stroke="' + c + '" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>';
        }
        if (o.dots !== false && o.dots !== "false") {
          for (let i = 0; i < xy.length; i++) {
            out += '<circle cx="' + fmt(xy[i].x, 1) + '" cy="' + fmt(xy[i].y, 1) + '" r="3.2" fill="' + c + '"';
            if (o.tooltips !== false) out += '><title>' + esc((timeAxis ? fmtTimeTick(xy[i].t, step, spanDays) : fmt(xy[i].t, 0)) + ": " + fmt(xy[i].v, o.decimals)) + '</title></circle>';
            else out += '/>';
          }
        }
      }
    }

    // target
    if (o.target != null) {
      let tv = +o.target;
      if (isFinite(tv) && (log ? tv > 0 : true)) {
        let yT = Math.max(y0, Math.min(y1, by(tv)));
        let c = colors[0 % colors.length];
        out += '<line x1="' + x0 + '" y1="' + fmt(yT, 1) + '" x2="' + x1 + '" y2="' + fmt(yT, 1) + '" stroke="' + c + '" stroke-width="1.4" stroke-dasharray="6 4" opacity="0.8"/>';
        out += drawTag(tc, x0 + 4, yT - 14, "goal " + fmt(tv, o.decimals), c, "🎯", "start");
      }
    }

    // end chips (slots computed first so other labels can dodge them)
    let chipSlots = [];
    let chips = [];
    if (serPts.length) {
      for (let s = 0; s < serPts.length; s++) {
        let pts = serPts[s];
        if (!pts.length) continue;
        let last = pts[pts.length - 1];
        let v = last.v;
        if (log && !(v > 0)) continue;
        chips.push({ v: v, x: xs(last.t), y: Math.max(y0, Math.min(y1, by(v))), color: colors[s % colors.length] });
      }
      chips.sort(function(a, b) { return b.v - a.v; });
      if (chips.length > 12) chips = chips.slice(0, 12);
      let cTop = y0 + 10, cBot = y1 - 8;
      for (let i = 0; i < chips.length; i++) {
        chipSlots.push(cTop + (cBot - cTop) * (chips.length === 1 ? 0.5 : i / (chips.length - 1)));
      }
    }

    function freeY(yy, pad, occupied) {
      yy = Math.max(y0 + 12, Math.min(y1 - 12, yy));
      let clash = function(v) {
        for (let i = 0; i < occupied.length; i++) if (Math.abs(v - occupied[i]) < pad) return true;
        return false;
      };
      let found = yy;
      if (clash(yy)) {
        let best = null;
        for (let off = pad; off <= (y1 - y0) / 2 && best == null; off += pad) {
          if (yy + off <= y1 - 12 && !clash(yy + off)) best = yy + off;
          else if (yy - off >= y0 + 12 && !clash(yy - off)) best = yy - off;
        }
        if (best == null) best = yy;
        found = best;
      }
      occupied.push(found);
      return found;
    }

    // trend
    if (tf(o.trend)) {
      let occupied = chipSlots.slice();
      for (let s = 0; s < serPts.length; s++) {
        let pts = strideDecimate(serPts[s], maxPoints);
        if (pts.length < 2) continue;
        let ls = linSlope(pts);
        if (!ls) continue;
        let last = pts[pts.length - 1];
        let vEnd = last.v + ls.slope * (tHi - last.t);
        if (log && !(vEnd > 0)) continue;
        let yEnd = Math.max(y0, Math.min(y1, by(vEnd)));
        let c = colors[s % colors.length];
        out += '<line x1="' + fmt(xs(last.t), 1) + '" y1="' + fmt(Math.max(y0, Math.min(y1, by(last.v))), 1) + '" x2="' + fmt(x1, 1) + '" y2="' + fmt(yEnd, 1) + '" stroke="' + c + '" stroke-width="1.6" stroke-dasharray="5 4" opacity="0.85"/>';
        out += '<path d="M ' + fmt(x1, 1) + " " + (yEnd - 5) + " L " + (x1 + 5) + " " + yEnd + " L " + x1 + " " + (yEnd + 5) + " L " + (x1 - 5) + " " + yEnd + " Z" + '" fill="' + c + '"/>';
        let tagY = freeY(yEnd - 14, 16, occupied);
        out += drawTag(tc, x1 - 8, tagY, "proj " + fmt(vEnd, o.decimals), c, "📈", "end");
      }
    }

    // x tick labels
    if (o.labels) {
      let lastRight = -Infinity;
      for (let i = 0; i < xticks.length; i++) {
        let raw = xs(xticks[i]);
        if (raw < x0 - 1 || raw > x1 + 1) continue;
        let label = timeAxis ? fmtTimeTick(xticks[i], step, spanDays) : fmt(xticks[i], 0);
        let w = label.length * 6.4 + 4;
        let x = Math.min(raw, VB_W - 4 - w / 2);
        if (x - w / 2 < lastRight) continue;
        out += '<text x="' + fmt(x, 1) + '" y="' + (H - 6) + '" style="font-size:11px;fill:' + tc.muted + ';text-anchor:middle;">' + esc(label) + '</text>';
        lastRight = x + w / 2 + 6;
      }
    }

    // end chips
    for (let i = 0; i < chips.length; i++) {
      let ch = chips[i];
      let sy = chipSlots[i];
      let cx2 = VB_W - 8;
      out += '<line x1="' + fmt(ch.x, 1) + '" y1="' + fmt(ch.y, 1) + '" x2="' + fmt(cx2 - 40, 1) + '" y2="' + fmt(sy, 1) + '" stroke="' + ch.color + '" stroke-width="1" stroke-dasharray="3 3" opacity="0.55"/>';
      let txt = fmt(ch.v, o.decimals);
      let w = Math.max(28, txt.length * 6 + 22);
      let rx = cx2 - w;
      out += '<rect x="' + fmt(rx, 1) + '" y="' + (sy - 11) + '" width="' + fmt(w, 1) + '" height="22" rx="11" fill="' + ch.color + '" opacity="0.14" stroke="' + ch.color + '" stroke-width="1"/>';
      out += '<circle cx="' + (rx + 10) + '" cy="' + sy + '" r="3.5" fill="' + ch.color + '"/>';
      out += '<text x="' + (rx + 18) + '" y="' + (sy + 4) + '" style="font-size:11px;font-weight:700;fill:' + tc.text + ';">' + esc(txt) + '</text>';
    }

    out += "</svg>";
    return out;
  }

  // ---------- advanced chart types (v1.2.0) ----------

  // Coerce a data item to its usable value: real list nodes and keyed objects
  // become plain objects (so the renderers can read their keys), while leaf nodes
  // resolve to their evaluated scalar.
  function valOf(x) {
    if (x != null && typeof x === "object" && !Array.isArray(x)) {
      let o = toObj(x);
      if (o) return o;
    }
    return resolve(x);
  }

  function arrOf(v) {
    // Check for a list node BEFORE resolving — a list node's `evaluateItem` is not
    // its items, so resolving it first would flatten the list into one string.
    if (isListNode(v)) {
      let items;
      try {
        items = listItems(v);
      } catch (e) { return null; }
      let out = [];
      for (let i = 0; i < items.length; i++) out.push(valOf(items[i]));
      return out;
    }
    v = resolve(v);
    if (v == null) return null;
    if (Array.isArray(v)) {
      let out = [];
      for (let i = 0; i < v.length; i++) out.push(valOf(v[i]));
      return out;
    }
    return null;
  }

  function dataLabelsOn(o) { return tf(o.values) || tf(o.showValues); }

  function clampText(s, maxChars) {
    s = String(s == null ? "" : s);
    if (!(maxChars > 0)) maxChars = 1;
    return s.length > maxChars ? s.slice(0, Math.max(1, maxChars - 1)) + "…" : s;
  }

  function hexToRgb(s) {
    let m = String(s == null ? "" : s).trim().match(/^#([0-9a-f]{3}|[0-9a-f]{6})$/i);
    if (!m) return null;
    let h = m[1];
    if (h.length === 3) h = h.charAt(0) + h.charAt(0) + h.charAt(1) + h.charAt(1) + h.charAt(2) + h.charAt(2);
    return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
  }

  function mixRgb(a, b, t) {
    if (t < 0) t = 0; if (t > 1) t = 1;
    return [Math.round(a[0] + (b[0] - a[0]) * t), Math.round(a[1] + (b[1] - a[1]) * t), Math.round(a[2] + (b[2] - a[2]) * t)];
  }

  function rgbCss(c) { return "rgb(" + c[0] + "," + c[1] + "," + c[2] + ")"; }

  function drawAxisLabels(o, tc, x0, x1, y0) {
    let out = "";
    if (o.yLabel) out += '<text x="' + x0 + '" y="' + (y0 - 5) + '" style="font-size:11px;font-weight:600;fill:' + tc.muted + ';text-anchor:start;">' + esc(o.yLabel) + '</text>';
    if (o.xLabel) out += '<text x="' + x1 + '" y="' + (y0 - 5) + '" style="font-size:11px;font-weight:600;fill:' + tc.muted + ';text-anchor:end;">' + esc(o.xLabel) + '</text>';
    return out;
  }

  function bandLoUp(o, nG) {
    let b = o && o.band;
    if (!b || typeof b !== "object") return null;
    let up = arrOf(b.upper), lo = arrOf(b.lower);
    if (!up || !lo) return null;
    let ups = [], los = [];
    for (let i = 0; i < nG; i++) { ups.push(num(up[i])); los.push(num(lo[i])); }
    return { up: ups, lo: los };
  }

  function drawBand(o, xFor, by, bnd, nG, colors) {
    let top = [], bot = [];
    for (let i = 0; i < nG; i++) {
      let u = bnd.up[i], l = bnd.lo[i];
      if (!isFinite(u) && !isFinite(l)) continue;
      let x = xFor(i);
      top.push({ x: x, y: by(isFinite(u) ? u : l) });
      bot.push({ x: x, y: by(isFinite(l) ? l : u) });
    }
    if (top.length < 2) return "";
    let c = o.bandColor != null ? String(o.bandColor) : (colors && colors.length ? colors[0] : DEF_COLORS[0]);
    let pts = [];
    for (let i = 0; i < top.length; i++) pts.push(fmt(top[i].x, 1) + "," + fmt(top[i].y, 1));
    for (let i = bot.length - 1; i >= 0; i--) pts.push(fmt(bot[i].x, 1) + "," + fmt(bot[i].y, 1));
    return '<polygon points="' + pts.join(" ") + '" fill="' + c + '" opacity="0.15"/>';
  }

  // ----- stacked bars -----

  function stackedInfo(n, percent) {
    let nS = n.series.length, nG = n.labels.length;
    let rows = [], ext = [0];
    for (let i = 0; i < nG; i++) {
      let raw = [];
      for (let s = 0; s < nS; s++) {
        let v = num(n.series[s].values[i]);
        raw.push(isFinite(v) ? v : 0);
      }
      if (percent) {
        let pos = 0;
        for (let s = 0; s < nS; s++) if (raw[s] > 0) pos += raw[s];
        for (let s = 0; s < nS; s++) raw[s] = pos > 0 ? Math.max(0, raw[s]) / pos * 100 : 0;
      }
      let pos = 0, neg = 0, segs = [];
      for (let s = 0; s < nS; s++) {
        let v = raw[s];
        let low, high;
        if (v >= 0) { low = pos; high = pos + v; pos = high; }
        else { high = neg; low = neg + v; neg = low; }
        segs.push({ s: s, low: low, high: high, v: v });
        ext.push(low); ext.push(high);
      }
      rows.push(segs);
    }
    return { rows: rows, ext: ext };
  }

  function renderStackedBars(n, o, percent) {
    let tc = themeColors(o.theme);
    let legend = o.legend == null ? n.series.length > 1 : !!o.legend;
    let legendH = legend ? 22 : 0;
    let xLabelsH = o.labels ? 24 : 6;
    let titleH = o.title ? 26 : 0;
    let lay = layout(o, titleH, legendH, xLabelsH);
    let H = lay.H, x0 = lay.x0, x1 = lay.x1, y0 = lay.y0, y1 = lay.y1;
    let info = stackedInfo(n, percent);
    let y;
    if (percent) {
      let ly = yScale(0, 100, y0, y1);
      y = { lo: 0, hi: 100, ticks: [0, 25, 50, 75, 100], ly: ly, by: ly, baseY: y1 };
    } else {
      y = yScaleInfo(info.ext, o, y0, y1);
    }
    let lo = y.lo, hi = y.hi, ticks = y.ticks, ly = y.ly, by = y.by;
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let nS = n.series.length, nG = n.labels.length;
    let gap = o.gap == null ? 0.25 : +o.gap;
    let groupW = (x1 - x0) / Math.max(1, nG);
    let barW = Math.max(1, groupW * (1 - gap));
    let showV = dataLabelsOn(o);
    let out = svgHead(H);
    out += drawTitle(o, tc);
    out += drawGrid(o, tc, ly, x0, x1, y0, y1, ticks, lo, hi);
    for (let i = 0; i < ticks.length; i++) {
      let yy = ly(ticks[i]);
      out += '<text x="' + (x0 - 7) + '" y="' + (yy + 4) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">' + fmt(ticks[i], percent ? 0 : o.decimals) + (percent ? "%" : "") + '</text>';
    }
    let step = Math.ceil(nG / 12);
    for (let i = 0; i < nG; i++) {
      let cx = x0 + i * groupW;
      let bx = cx + groupW * gap / 2;
      let segs = info.rows[i];
      for (let j = 0; j < segs.length; j++) {
        let seg = segs[j];
        if (!(seg.high > seg.low + 1e-12)) continue;
        let c = colors[seg.s % colors.length];
        let yt = Math.max(y0, Math.min(y1, by(seg.high)));
        let yb = Math.max(y0, Math.min(y1, by(seg.low)));
        let yy = Math.min(yt, yb);
        let span = Math.abs(yt - yb);
        let hh = Math.max(0.5, span - (seg.low > 0 ? 1 : 0));
        out += '<rect x="' + fmt(bx, 1) + '" y="' + fmt(yy, 1) + '" width="' + fmt(barW, 1) + '" height="' + fmt(hh, 1) + '" rx="2" fill="' + c + '" opacity="0.9"';
        if (o.tooltips !== false) out += '><title>' + esc(String(n.labels[i]) + " · " + n.series[seg.s].name + ": " + (percent ? fmt(seg.v, 1) + "%" : fmt(seg.v, o.decimals))) + '</title></rect>';
        else out += '/>';
        if (showV) {
          let txt = percent ? fmt(seg.v, seg.v < 10 ? 1 : 0) + "%" : fmt(seg.v, o.decimals);
          let tw = txt.length * 6.2;
          if (span >= 12 && tw + 4 <= barW) {
            out += '<text x="' + fmt(bx + barW / 2, 1) + '" y="' + fmt(yy + span / 2 + 4, 1) + '" style="font-size:10.5px;font-weight:700;fill:#fff;text-anchor:middle;">' + esc(txt) + '</text>';
          }
        }
      }
      if (o.labels && i % step === 0) {
        let lbl = clampText(textOf(n.labels[i]), Math.max(4, Math.floor(step * groupW / 6.4) - 1));
        let w = lbl.length * 6.4 + 4;
        let x = Math.min(cx + groupW / 2, VB_W - 4 - w / 2);
        out += '<text x="' + fmt(x, 1) + '" y="' + (H - legendH - 6) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:middle;">' + esc(lbl) + '</text>';
      }
    }
    out += drawAxisLabels(o, tc, x0, x1, y0);
    if (legend) {
      let names = [];
      for (let s = 0; s < nS; s++) names.push(n.series[s].name);
      out += drawLegend(o, tc, H - legendH / 2 + 2, names, colors);
    }
    out += "</svg>";
    return out;
  }

  function renderStackedBarsH(n, o, percent) {
    let tc = themeColors(o.theme);
    let legend = o.legend == null ? n.series.length > 1 : !!o.legend;
    let legendH = legend ? 22 : 0;
    let titleH = o.title ? 26 : 0;
    let H = Math.max(160, Math.floor(+o.height || 300));
    let T = titleH + 8;
    let xL = 86, xR = 44;
    let B = legendH + 6;
    let x0 = xL, x1 = VB_W - xR, y0 = T, y1 = H - B - 24;
    let info = stackedInfo(n, percent);
    let ticks, lo, hi, xs;
    if (percent) {
      ticks = [0, 25, 50, 75, 100]; lo = 0; hi = 100;
      xs = xScale(0, 100, x0, x1);
    } else {
      let r = minMax(info.ext);
      let mlo = r.mn, mhi = r.mx;
      if (o.min != null) mlo = +o.min;
      if (o.max != null) mhi = +o.max;
      if (o.min == null && mlo >= 0) mlo = 0;
      if (!(mlo < mhi)) mhi = mlo + 1;
      ticks = niceTicks(mlo, mhi, Math.max(2, Math.floor(+o.ticks) || 4));
      lo = ticks[0]; hi = ticks[ticks.length - 1];
      xs = xScale(lo, hi, x0, x1);
    }
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let nS = n.series.length, nG = n.labels.length;
    let gap = o.gap == null ? 0.25 : +o.gap;
    let maxChars = Math.max(4, Math.floor((x0 - 8) / 6.4));
    let labelLines = [], totalLines = 0;
    for (let i = 0; i < nG; i++) {
      let lines = wrapLabel(textOf(n.labels[i]), maxChars);
      if (lines.length > 3) { lines = lines.slice(0, 3); lines[2] = clampText(lines[2], maxChars); }
      labelLines.push(lines);
      totalLines += lines.length;
    }
    let lineH = (y1 - y0) / Math.max(1, totalLines);
    let lsp = Math.min(13, lineH);
    let showV = dataLabelsOn(o);
    let out = svgHead(H);
    out += drawTitle(o, tc);
    if (o.gridlines) {
      for (let i = 0; i < ticks.length; i++) {
        let x = xs(ticks[i]);
        out += '<line x1="' + fmt(x, 1) + '" y1="' + y0 + '" x2="' + fmt(x, 1) + '" y2="' + y1 + '" style="stroke:' + tc.grid + ';stroke-width:1;"/>';
      }
    }
    out += '<line x1="' + fmt(xs(0), 1) + '" y1="' + y0 + '" x2="' + fmt(xs(0), 1) + '" y2="' + y1 + '" style="stroke:' + tc.axis + ';stroke-width:1.3;"/>';
    for (let i = 0; i < ticks.length; i++) {
      let lbl = fmt(ticks[i], percent ? 0 : o.decimals) + (percent ? "%" : "");
      let w = lbl.length * 6 + 4;
      let x = Math.min(xs(ticks[i]), VB_W - 4 - w / 2);
      out += '<text x="' + fmt(x, 1) + '" y="' + (H - B + 2) + '" style="font-size:11px;fill:' + tc.muted + ';text-anchor:middle;">' + lbl + '</text>';
    }
    let cy = y0;
    for (let i = 0; i < nG; i++) {
      let lines = labelLines[i];
      let rowH = lines.length * lineH;
      let bandH = rowH * (1 - gap);
      let firstY = cy + rowH / 2 - (lines.length - 1) * lsp / 2 + 4;
      out += '<text x="' + (x0 - 8) + '" y="' + fmt(firstY, 1) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">';
      for (let j = 0; j < lines.length; j++) {
        if (j === 0) out += esc(lines[j]);
        else out += '<tspan x="' + (x0 - 8) + '" dy="' + fmt(lsp, 1) + '">' + esc(lines[j]) + '</tspan>';
      }
      out += '</text>';
      let segs = info.rows[i];
      let ry = cy + gap * rowH / 2;
      let rh = Math.max(1, bandH);
      for (let j = 0; j < segs.length; j++) {
        let seg = segs[j];
        if (!(seg.high > seg.low + 1e-12)) continue;
        let c = colors[seg.s % colors.length];
        let xa = Math.max(x0, Math.min(x1, xs(seg.low)));
        let xb = Math.max(x0, Math.min(x1, xs(seg.high)));
        let rx = Math.min(xa, xb);
        let w = Math.max(0.5, Math.abs(xb - xa) - (seg.low > 1e-12 ? 1 : 0));
        out += '<rect x="' + fmt(rx, 1) + '" y="' + fmt(ry, 1) + '" width="' + fmt(w, 1) + '" height="' + fmt(rh, 1) + '" rx="2" fill="' + c + '" opacity="0.9"';
        if (o.tooltips !== false) out += '><title>' + esc(String(n.labels[i]) + " · " + n.series[seg.s].name + ": " + (percent ? fmt(seg.v, 1) + "%" : fmt(seg.v, o.decimals))) + '</title></rect>';
        else out += '/>';
        if (showV) {
          let txt = percent ? fmt(seg.v, seg.v < 10 ? 1 : 0) + "%" : fmt(seg.v, o.decimals);
          let tw = txt.length * 6.2;
          if (w >= tw + 6 && rh >= 11) {
            out += '<text x="' + fmt(rx + w / 2, 1) + '" y="' + fmt(ry + rh / 2 + 4, 1) + '" style="font-size:10.5px;font-weight:700;fill:#fff;text-anchor:middle;">' + esc(txt) + '</text>';
          }
        }
      }
      cy += rowH;
    }
    if (legend) {
      let names = [];
      for (let s = 0; s < nS; s++) names.push(n.series[s].name);
      out += drawLegend(o, tc, H - legendH / 2 + 2, names, colors);
    }
    out += "</svg>";
    return out;
  }

  // ----- area charts -----

  function renderArea(n, o, stacked) {
    let tc = themeColors(o.theme);
    let legend = o.legend == null ? n.series.length > 1 : !!o.legend;
    let legendH = legend ? 22 : 0;
    let xLabelsH = o.labels ? 24 : 6;
    let titleH = o.title ? 26 : 0;
    let lay = layout(o, titleH, legendH, xLabelsH);
    let H = lay.H, x0 = lay.x0, x1 = lay.x1, y0 = lay.y0, y1 = lay.y1;
    let nG = n.labels.length, nS = n.series.length;
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let xFor = nG <= 1 ? function() { return (x0 + x1) / 2; } : function(i) { return x0 + (x1 - x0) * i / (nG - 1); };
    let svs = [];
    if (stacked) {
      let cum = [];
      for (let i = 0; i < nG; i++) cum.push(0);
      for (let s = 0; s < nS; s++) {
        let vals = [], base = [], top = [];
        for (let i = 0; i < nG; i++) {
          let v = num(n.series[s].values[i]);
          if (!isFinite(v)) v = 0;
          vals.push(v); base.push(cum[i]); top.push(cum[i] + v);
        }
        for (let i = 0; i < nG; i++) cum[i] = top[i];
        svs.push({ name: n.series[s].name, vals: vals, base: base, top: top });
      }
    } else {
      for (let s = 0; s < nS; s++) {
        let vals = [];
        for (let i = 0; i < nG; i++) vals.push(num(n.series[s].values[i]));
        svs.push({ name: n.series[s].name, vals: vals, base: null, top: vals });
      }
    }
    let yvals = [];
    if (stacked) { for (let s = 0; s < nS; s++) for (let i = 0; i < nG; i++) { yvals.push(svs[s].top[i]); yvals.push(svs[s].base[i]); } }
    else { for (let s = 0; s < nS; s++) for (let i = 0; i < nG; i++) yvals.push(svs[s].vals[i]); }
    let y = yScaleInfo(yvals, o, y0, y1);
    let lo = y.lo, hi = y.hi, ticks = y.ticks, ly = y.ly, by = y.by, baseY = y.baseY;
    let out = svgHead(H);
    out += drawTitle(o, tc);
    out += drawGrid(o, tc, ly, x0, x1, y0, y1, ticks, lo, hi);
    out += drawTicksY(o, tc, ly, ticks, x0, o.decimals);
    let bnd = bandLoUp(o, nG);
    if (bnd) out += drawBand(o, xFor, by, bnd, nG, colors);
    for (let s = 0; s < nS; s++) {
      let c = colors[s % colors.length];
      let top = [], bot = [];
      for (let i = 0; i < nG; i++) {
        let tv = svs[s].top[i];
        top.push({ x: xFor(i), y: by(tv) });
        bot.push({ x: xFor(i), y: stacked ? by(svs[s].base[i]) : baseY });
      }
      if (top.length >= 2) {
        let pts = [];
        for (let i = 0; i < top.length; i++) pts.push(fmt(top[i].x, 1) + "," + fmt(top[i].y, 1));
        for (let i = bot.length - 1; i >= 0; i--) pts.push(fmt(bot[i].x, 1) + "," + fmt(bot[i].y, 1));
        out += '<polygon points="' + pts.join(" ") + '" fill="' + c + '" opacity="' + (stacked ? "0.55" : "0.18") + '"/>';
        out += '<polyline points="' + top.map(function(p) { return fmt(p.x, 1) + "," + fmt(p.y, 1); }).join(" ") + '" fill="none" stroke="' + c + '" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>';
      }
      if (!stacked && o.dots !== false && o.dots !== "false") {
        for (let i = 0; i < nG; i++) {
          let v = svs[s].vals[i];
          if (!isFinite(v)) continue;
          out += '<circle cx="' + fmt(xFor(i), 1) + '" cy="' + fmt(by(v), 1) + '" r="3.2" fill="' + c + '"';
          if (o.tooltips !== false) out += '><title>' + esc(String(n.labels[i]) + ": " + fmt(v, o.decimals)) + '</title></circle>';
          else out += '/>';
        }
      }
    }
    if (o.labels) {
      let step = Math.ceil(nG / 12);
      let slotW = step * (x1 - x0) / Math.max(1, nG - 1);
      let maxChars = Math.max(4, Math.floor(slotW / 6.4) - 1);
      for (let i = 0; i < nG; i++) {
        if (i % step !== 0) continue;
        let lbl = clampText(textOf(n.labels[i]), maxChars);
        let w = lbl.length * 6.4 + 4;
        let x = Math.max(x0 + w / 2, Math.min(xFor(i), VB_W - 4 - w / 2));
        out += '<text x="' + fmt(x, 1) + '" y="' + (H - legendH - 6) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:middle;">' + esc(lbl) + '</text>';
      }
    }
    out += drawAxisLabels(o, tc, x0, x1, y0);
    if (legend) {
      let names = [];
      for (let s = 0; s < nS; s++) names.push(n.series[s].name);
      out += drawLegend(o, tc, H - legendH / 2 + 2, names, colors);
    }
    out += "</svg>";
    return out;
  }

  // ----- scatter -----

  function pairsFrom(arr) {
    if (!Array.isArray(arr)) return null;
    let pts = [];
    for (let i = 0; i < arr.length; i++) {
      let e = resolve(arr[i]);
      if (Array.isArray(e)) {
        let x = num(e[0]), y = num(e[1]);
        if (isFinite(x) && isFinite(y)) pts.push({ x: x, y: y });
      } else if (e != null && typeof e === "object") {
        let o = toObj(e);
        if (!o) continue;
        let x = o.x !== undefined ? num(o.x) : NaN;
        let y = o.y !== undefined ? num(o.y) : NaN;
        if (isFinite(x) && isFinite(y)) pts.push({ x: x, y: y });
      }
    }
    return pts.length ? pts : null;
  }

  function seriesNameOf(o, i) {
    try {
      if (o != null && typeof o === "object") {
        let nm = o.name;
        if (nm !== undefined && nm !== null && typeof nm !== "function") {
          let s = String(resolve(nm));
          if (s) return s;
        }
      }
    } catch (e) {}
    return "Series " + (i + 1);
  }

  function scatterFromRows(objs, opts) {
    if (!objs.length) return { ok: false, error: "no rows found" };
    let keys = Object.keys(objs[0]);
    let xk = opts && opts.x != null ? String(resolve(opts.x)) : null;
    let yk = [];
    if (opts && opts.y != null) { let yv = resolve(opts.y); yk = Array.isArray(yv) ? yv.map(String) : [String(yv)]; }
    if (!xk) {
      for (let i = 0; i < keys.length; i++) {
        if (keys[i] === "label" || keys[i] === "name") continue;
        if (isFinite(num(objs[0][keys[i]]))) { xk = keys[i]; break; }
      }
    }
    if (!yk.length) {
      for (let i = 0; i < keys.length; i++) {
        if (keys[i] === xk || keys[i] === "label" || keys[i] === "name") continue;
        if (isFinite(num(objs[0][keys[i]]))) yk.push(keys[i]);
      }
    }
    if (!xk || !yk.length) return { ok: false, error: "need two numeric columns (an x and a y)" };
    let series = [];
    for (let j = 0; j < yk.length; j++) series.push({ name: String(yk[j]), points: [] });
    for (let i = 0; i < objs.length; i++) {
      let x = num(objs[i][xk]);
      if (!isFinite(x)) continue;
      for (let j = 0; j < yk.length; j++) {
        let y = num(objs[i][yk[j]]);
        if (isFinite(y)) series[j].points.push({ x: x, y: y });
      }
    }
    series = series.filter(function(s) { return s.points.length; });
    if (!series.length) return { ok: false, error: "no numeric x/y points found" };
    return { ok: true, series: series, error: null };
  }

  function normScatter(input, opts) {
    if (input == null) return { ok: false, error: "expected [x, y] pairs or rows with two numeric columns" };
    let d = input;
    if (d != null && isListNode(d)) {
      let items;
      try {
        items = listItems(d);
      } catch (e) { return { ok: false, error: "could not read list data" }; }
      d = [];
      for (let i = 0; i < items.length; i++) d.push(valOf(items[i]));
    } else {
      d = resolve(d);
    }
    if (Array.isArray(d)) {
      let f = d.length ? resolve(d[0]) : null;
      let fo = f != null && typeof f === "object" && !Array.isArray(f) ? toObj(f) : null;
      if (fo && (fo.points !== undefined || fo.data !== undefined || fo.values !== undefined) && fo.x === undefined && fo.y === undefined) {
        let series = [];
        for (let i = 0; i < d.length; i++) {
          let el = resolve(d[i]);
          let raw = toObj(el) || {};
          let nm = seriesNameOf(el, i);
          let src = raw.points !== undefined ? raw.points : (raw.data !== undefined ? raw.data : raw.values);
          let pts = pairsFrom(arrOf(src));
          if (pts) series.push({ name: nm, points: pts });
        }
        if (series.length) return { ok: true, series: series, error: null };
      }
      let pts = pairsFrom(d);
      if (pts) return { ok: true, series: [{ name: "points", points: pts }], error: null };
      let objs = [];
      for (let i = 0; i < d.length; i++) { let o = toObj(resolve(d[i])); if (o) objs.push(o); }
      return scatterFromRows(objs, opts);
    }
    if (d != null && typeof d === "object") {
      if (Array.isArray(d.series)) {
        let series = [];
        for (let i = 0; i < d.series.length; i++) {
          let el = resolve(d.series[i]);
          let raw = toObj(el) || {};
          let nm = seriesNameOf(el, i);
          let src = raw.points !== undefined ? raw.points : (raw.data !== undefined ? raw.data : raw.values);
          let pts = pairsFrom(arrOf(src));
          if (pts) series.push({ name: nm, points: pts });
        }
        if (series.length) return { ok: true, series: series, error: null };
      }
      if (d.points !== undefined) {
        let pts = pairsFrom(arrOf(d.points));
        if (pts) return { ok: true, series: [{ name: "points", points: pts }], error: null };
      }
      if (d.values !== undefined && Array.isArray(resolve(d.values)) && Array.isArray(resolve(d.values)[0])) {
        let pts = pairsFrom(arrOf(d.values));
        if (pts) return { ok: true, series: [{ name: "points", points: pts }], error: null };
      }
      if (d.x !== undefined && d.y !== undefined) {
        let xs = arrOf(d.x), ys = arrOf(d.y);
        if (xs && ys) {
          let pts = [];
          for (let i = 0; i < Math.min(xs.length, ys.length); i++) {
            let x = num(xs[i]), y = num(ys[i]);
            if (isFinite(x) && isFinite(y)) pts.push({ x: x, y: y });
          }
          if (pts.length) return { ok: true, series: [{ name: "points", points: pts }], error: null };
        }
      }
      let o = toObj(d);
      if (o) {
        let keys = Object.keys(o);
        let numeric = [];
        for (let i = 0; i < keys.length; i++) if (isFinite(num(o[keys[i]]))) numeric.push(keys[i]);
        if (numeric.length) return scatterFromRows([o], opts);
      }
    }
    return { ok: false, error: "expected [x, y] pairs or rows with two numeric columns" };
  }

  function axisRange(vals, o, isY, tickCount) {
    let r = minMax(vals);
    let lo = r.mn, hi = r.mx;
    if (isY) { if (o.min != null) lo = +o.min; if (o.max != null) hi = +o.max; }
    if (!(lo < hi)) hi = lo + 1;
    let ticks = niceTicks(lo, hi, Math.max(2, Math.floor(+tickCount) || 4));
    return { lo: ticks[0], hi: ticks[ticks.length - 1], ticks: ticks };
  }

  function renderScatter(n, o) {
    let tc = themeColors(o.theme);
    let legend = o.legend == null ? n.series.length > 1 : !!o.legend;
    let legendH = legend ? 22 : 0;
    let xLabelsH = o.labels ? 24 : 6;
    let titleH = o.title ? 26 : 0;
    let lay = layout(o, titleH, legendH, xLabelsH);
    let H = lay.H, x0 = lay.x0, x1 = lay.x1, y0 = lay.y0, y1 = lay.y1;
    let allX = [], allY = [];
    for (let s = 0; s < n.series.length; s++) {
      let pts = n.series[s].points || [];
      for (let i = 0; i < pts.length; i++) { allX.push(pts[i].x); allY.push(pts[i].y); }
    }
    if (!allX.length) return ph("scatter", "no points to plot");
    let xr = axisRange(allX, o, false, o.ticks);
    let yr = axisRange(allY, o, true, o.ticks);
    let xs = xScale(xr.lo, xr.hi, x0, x1);
    let ys = yScale(yr.lo, yr.hi, y0, y1);
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let out = svgHead(H);
    out += drawTitle(o, tc);
    if (o.gridlines) {
      for (let i = 0; i < yr.ticks.length; i++) { let yy = ys(yr.ticks[i]); out += '<line x1="' + x0 + '" y1="' + fmt(yy, 1) + '" x2="' + x1 + '" y2="' + fmt(yy, 1) + '" style="stroke:' + tc.grid + ';stroke-width:1;"/>'; }
      for (let i = 0; i < xr.ticks.length; i++) { let xx = xs(xr.ticks[i]); out += '<line x1="' + fmt(xx, 1) + '" y1="' + y0 + '" x2="' + fmt(xx, 1) + '" y2="' + y1 + '" style="stroke:' + tc.grid + ';stroke-width:1;"/>'; }
    }
    let baseY2 = ys(Math.max(yr.lo, Math.min(yr.hi, 0)));
    let baseX2 = xs(Math.max(xr.lo, Math.min(xr.hi, 0)));
    out += '<line x1="' + x0 + '" y1="' + fmt(baseY2, 1) + '" x2="' + x1 + '" y2="' + fmt(baseY2, 1) + '" style="stroke:' + tc.axis + ';stroke-width:1.3;"/>';
    out += '<line x1="' + fmt(baseX2, 1) + '" y1="' + y0 + '" x2="' + fmt(baseX2, 1) + '" y2="' + y1 + '" style="stroke:' + tc.axis + ';stroke-width:1.3;"/>';
    for (let i = 0; i < yr.ticks.length; i++) {
      out += '<text x="' + (x0 - 7) + '" y="' + fmt(ys(yr.ticks[i]) + 4, 1) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">' + fmt(yr.ticks[i], o.decimals) + '</text>';
    }
    if (o.labels) {
      let lastRight = -Infinity;
      for (let i = 0; i < xr.ticks.length; i++) {
        let lbl = fmt(xr.ticks[i], o.decimals);
        let w = lbl.length * 6.4 + 4;
        let xx = Math.max(x0 + w / 2, Math.min(xs(xr.ticks[i]), VB_W - 4 - w / 2));
        if (xx - w / 2 < lastRight) continue;
        out += '<text x="' + fmt(xx, 1) + '" y="' + (H - legendH - 6) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:middle;">' + lbl + '</text>';
        lastRight = xx + w / 2 + 4;
      }
    }
    for (let s = 0; s < n.series.length; s++) {
      let c = colors[s % colors.length];
      let pts = n.series[s].points || [];
      for (let i = 0; i < pts.length; i++) {
        let px = xs(pts[i].x), py = ys(pts[i].y);
        out += '<circle cx="' + fmt(px, 1) + '" cy="' + fmt(py, 1) + '" r="3.6" fill="' + c + '" opacity="0.85"';
        if (o.tooltips !== false) out += '><title>' + esc(n.series[s].name + ": (" + fmt(pts[i].x, o.decimals) + ", " + fmt(pts[i].y, o.decimals) + ")") + '</title></circle>';
        else out += '/>';
      }
      if (tf(o.trend) && pts.length >= 2) {
        let n2 = pts.length, sx = 0, sy = 0, sxx = 0, sxy = 0;
        for (let i = 0; i < n2; i++) { sx += pts[i].x; sy += pts[i].y; sxx += pts[i].x * pts[i].x; sxy += pts[i].x * pts[i].y; }
        let den = n2 * sxx - sx * sx;
        if (den !== 0) {
          let b = (n2 * sxy - sx * sy) / den;
          let a = (sy - b * sx) / n2;
          out += '<line x1="' + x0 + '" y1="' + fmt(ys(a + b * xr.lo), 1) + '" x2="' + x1 + '" y2="' + fmt(ys(a + b * xr.hi), 1) + '" stroke="' + c + '" stroke-width="1.6" stroke-dasharray="5 4" opacity="0.8"/>';
        }
      }
    }
    out += drawAxisLabels(o, tc, x0, x1, y0);
    if (legend) {
      let names = [];
      for (let s = 0; s < n.series.length; s++) names.push(n.series[s].name);
      out += drawLegend(o, tc, H - legendH / 2 + 2, names, colors);
    }
    out += "</svg>";
    return out;
  }

  // ----- heatmap -----

  function heatmapFromRows(arr, opts) {
    let objs = [];
    for (let i = 0; i < arr.length; i++) { let o = toObj(resolve(arr[i])); if (o) objs.push(o); }
    if (!objs.length) return { ok: false, error: "no row objects found" };
    let keys = Object.keys(objs[0]);
    let numericKeys = [];
    for (let i = 0; i < keys.length; i++) if (isFinite(num(objs[0][keys[i]]))) numericKeys.push(keys[i]);
    let catKeys = [];
    for (let i = 0; i < keys.length; i++) if (numericKeys.indexOf(keys[i]) < 0 && keys[i] !== "label" && keys[i] !== "name") catKeys.push(keys[i]);
    let rk = opts && opts.row != null ? String(resolve(opts.row)) : (catKeys.length ? catKeys[0] : "label");
    if (opts && opts.col != null && opts.value != null) {
      let ck = String(resolve(opts.col)), vk = String(resolve(opts.value));
      let rowVals = [], colVals = [], ridx = {}, cidx = {}, cell = [];
      for (let i = 0; i < objs.length; i++) {
        let rv = String(resolve(objs[i][rk]));
        let cv = String(resolve(objs[i][ck]));
        if (ridx[rv] === undefined) { ridx[rv] = rowVals.length; rowVals.push(rv); }
        if (cidx[cv] === undefined) { cidx[cv] = colVals.length; colVals.push(cv); }
        cell.push({ r: ridx[rv], c: cidx[cv], v: num(objs[i][vk]) });
      }
      let matrix = [];
      for (let r = 0; r < rowVals.length; r++) { let row = []; for (let c = 0; c < colVals.length; c++) row.push(null); matrix.push(row); }
      for (let i = 0; i < cell.length; i++) if (isFinite(cell[i].v)) matrix[cell[i].r][cell[i].c] = cell[i].v;
      return { ok: true, rowLabels: rowVals, colLabels: colVals, rows: matrix, error: null };
    }
    let rowLabels = [], matrix = [];
    for (let i = 0; i < objs.length; i++) {
      rowLabels.push(String(resolve(objs[i][rk] !== undefined ? objs[i][rk] : i)));
      let row = [];
      for (let j = 0; j < numericKeys.length; j++) { let v = num(objs[i][numericKeys[j]]); row.push(isFinite(v) ? v : null); }
      matrix.push(row);
    }
    if (!numericKeys.length) return { ok: false, error: "no numeric columns for the matrix" };
    return { ok: true, rowLabels: rowLabels, colLabels: numericKeys.map(String), rows: matrix, error: null };
  }

  function normHeatmap(data, opts) {
    let d = data;
    if (d != null && isListNode(d)) {
      let items;
      try {
        items = listItems(d);
      } catch (e) { return { ok: false, error: "could not read list data" }; }
      let arr = [];
      for (let i = 0; i < items.length; i++) arr.push(valOf(items[i]));
      d = arr;
    } else {
      d = resolve(d);
    }
    if (Array.isArray(d)) {
      if (d.length && Array.isArray(resolve(d[0]))) {
        d = { matrix: d };
      } else {
        return heatmapFromRows(d, opts);
      }
    }
    let matrix = null, rowLabels = null, colLabels = null;
    if (d != null && typeof d === "object") {
      if (Array.isArray(d.matrix)) matrix = d.matrix;
      else if (Array.isArray(d.values) && d.values.length && Array.isArray(resolve(d.values[0]))) matrix = d.values;
      if (Array.isArray(d.rowLabels)) rowLabels = d.rowLabels;
      if (Array.isArray(d.labels)) colLabels = d.labels;
    }
    if (!matrix && opts && Array.isArray(opts.matrix)) matrix = opts.matrix;
    if (!matrix) return { ok: false, error: "expected {rowLabels, labels, matrix}" };
    let rows = [];
    for (let r = 0; r < matrix.length; r++) {
      let row = resolve(matrix[r]);
      if (!Array.isArray(row)) return { ok: false, error: "matrix rows must be arrays" };
      let rr = [];
      for (let c = 0; c < row.length; c++) {
        let cell = resolve(row[c]);
        if (cell == null || cell === "") { rr.push(null); continue; }
        let v = num(cell);
        rr.push(isFinite(v) ? v : null);
      }
      rows.push(rr);
    }
    if (!rows.length) return { ok: false, error: "empty matrix" };
    let nCols = 0;
    for (let r = 0; r < rows.length; r++) if (rows[r].length > nCols) nCols = rows[r].length;
    if (!colLabels) { colLabels = []; for (let c = 0; c < nCols; c++) colLabels.push(String(c)); }
    if (!rowLabels) { rowLabels = []; for (let r = 0; r < rows.length; r++) rowLabels.push(String(r)); }
    colLabels = colLabels.map(function(x) { return String(resolve(x)); });
    rowLabels = rowLabels.map(function(x) { return String(resolve(x)); });
    return { ok: true, rowLabels: rowLabels, colLabels: colLabels, rows: rows, error: null };
  }

  function renderHeatmap(h, o) {
    let tc = themeColors(o.theme);
    let titleH = o.title ? 26 : 0;
    let xLabelsH = o.labels ? 18 : 4;
    let legendH = 30;
    let nRows = h.rows.length;
    let nCols = h.colLabels.length;
    let baseH = Math.max(180, Math.floor(+o.height || 300));
    let H = Math.max(baseH, titleH + 8 + nRows * 22 + xLabelsH + legendH + 12);
    let maxRowChars = 0;
    for (let i = 0; i < h.rowLabels.length; i++) maxRowChars = Math.max(maxRowChars, h.rowLabels[i].length);
    let rowChars = Math.min(maxRowChars, 14);
    let leftPad = 14;
    let rowLabelW = Math.max(20, rowChars * 6.4 + 8);
    let x0 = leftPad + rowLabelW, x1 = VB_W - 14;
    let T = titleH + 8;
    let y0 = T + (o.labels ? 16 : 2);
    let y1 = H - xLabelsH - legendH;
    if (y1 <= y0 + 10) y1 = y0 + 10;
    let cellW = (x1 - x0) / Math.max(1, nCols);
    let cellH = (y1 - y0) / Math.max(1, nRows);
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let heat = hexToRgb(o.heatColor != null ? o.heatColor : colors[0]) || hexToRgb(DEF_COLORS[0]);
    let white = [255, 255, 255];
    let mn = Infinity, mx = -Infinity;
    for (let r = 0; r < nRows; r++) for (let c = 0; c < nCols; c++) { let v = h.rows[r][c]; if (v == null) continue; if (v < mn) mn = v; if (v > mx) mx = v; }
    if (!isFinite(mn)) { mn = 0; mx = 1; }
    if (mx === mn) mx = mn + 1;
    let showV = dataLabelsOn(o);
    let out = svgHead(H);
    out += drawTitle(o, tc);
    let colChars = Math.max(3, Math.floor(cellW / 6.4));
    for (let c = 0; c < nCols; c++) {
      let lbl = clampText(h.colLabels[c], colChars);
      out += '<text x="' + fmt(x0 + (c + 0.5) * cellW, 1) + '" y="' + fmt(y0 - 5, 1) + '" style="font-size:11px;fill:' + tc.muted + ';text-anchor:middle;">' + esc(lbl) + '</text>';
    }
    for (let r = 0; r < nRows; r++) {
      let lbl = clampText(h.rowLabels[r], rowChars);
      out += '<text x="' + (x0 - 7) + '" y="' + fmt(y0 + (r + 0.5) * cellH + 4, 1) + '" style="font-size:11.5px;fill:' + tc.muted + ';text-anchor:end;">' + esc(lbl) + '</text>';
    }
    for (let r = 0; r < nRows; r++) {
      for (let c = 0; c < nCols; c++) {
        let v = h.rows[r][c];
        let cx = x0 + c * cellW, cy = y0 + r * cellH;
        let rw = Math.max(0.5, cellW - 2), rh = Math.max(0.5, cellH - 2);
        if (v == null) {
          out += '<rect x="' + fmt(cx + 1, 1) + '" y="' + fmt(cy + 1, 1) + '" width="' + fmt(rw, 1) + '" height="' + fmt(rh, 1) + '" rx="3" fill="' + tc.grid + '"/>';
          continue;
        }
        let t = (v - mn) / (mx - mn);
        if (t < 0) t = 0; if (t > 1) t = 1;
        let col = mixRgb(white, heat, 0.14 + 0.86 * t);
        out += '<rect x="' + fmt(cx + 1, 1) + '" y="' + fmt(cy + 1, 1) + '" width="' + fmt(rw, 1) + '" height="' + fmt(rh, 1) + '" rx="3" fill="' + rgbCss(col) + '"';
        if (o.tooltips !== false) out += '><title>' + esc(h.rowLabels[r] + " · " + h.colLabels[c] + ": " + fmt(v, o.decimals)) + '</title></rect>';
        else out += '/>';
        if (showV && cellW >= 26 && cellH >= 14) {
          let lum = (0.299 * col[0] + 0.587 * col[1] + 0.114 * col[2]) / 255;
          let tcol = lum > 0.62 ? "#0f172a" : "#ffffff";
          out += '<text x="' + fmt(cx + cellW / 2, 1) + '" y="' + fmt(cy + cellH / 2 + 4, 1) + '" style="font-size:11px;font-weight:700;fill:' + tcol + ';text-anchor:middle;">' + esc(fmt(v, o.decimals)) + '</text>';
        }
      }
    }
    let lw = Math.min(180, (x1 - x0) * 0.5);
    let lx = x0;
    let lyy = H - legendH + 12;
    let steps = 20;
    for (let i = 0; i < steps; i++) {
      let col = mixRgb(white, heat, 0.14 + 0.86 * (steps > 1 ? i / (steps - 1) : 1));
      out += '<rect x="' + fmt(lx + i * lw / steps, 1) + '" y="' + fmt(lyy, 1) + '" width="' + fmt(lw / steps + 0.6, 1) + '" height="10" fill="' + rgbCss(col) + '"/>';
    }
    out += '<text x="' + fmt(lx, 1) + '" y="' + fmt(lyy - 3, 1) + '" style="font-size:10.5px;fill:' + tc.muted + ';text-anchor:start;">' + fmt(mn, o.decimals) + '</text>';
    out += '<text x="' + fmt(lx + lw, 1) + '" y="' + fmt(lyy - 3, 1) + '" style="font-size:10.5px;fill:' + tc.muted + ';text-anchor:end;">' + fmt(mx, o.decimals) + '</text>';
    out += "</svg>";
    return out;
  }

  // ----- sparklines -----

  function renderSpark(n, o, isBar) {
    let src = n.series && n.series.length ? n.series[0].values : [];
    let vals = [];
    for (let i = 0; i < src.length; i++) { let v = num(src[i]); if (isFinite(v)) vals.push(v); }
    if (!vals.length) return ph(isBar ? "sparklineBar" : "sparkline", "no numeric values");
    let W = Math.floor(+o.width > 0 ? +o.width : 120);
    let Hc = (+o.height > 0) ? Math.max(8, Math.min(600, Math.floor(+o.height))) : 28;
    if (W < 20) W = 20;
    let pad = 3;
    let r = minMax(vals);
    let lo = r.mn, hi = r.mx;
    if (o.min != null) lo = +o.min;
    if (o.max != null) hi = +o.max;
    if (!(hi > lo)) hi = lo + 1;
    let colors = o.colors && o.colors.length ? o.colors : DEF_COLORS;
    let c = colors[0];
    let out = '<svg xmlns="http://www.w3.org/2000/svg" width="' + W + '" height="' + Hc + '" viewBox="0 0 ' + W + ' ' + Hc + '" role="img" style="max-width:100%;height:auto;display:inline-block;vertical-align:middle;overflow:visible;font-family:ui-sans-serif,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;">';
    let xFor = function(i) { return vals.length <= 1 ? W / 2 : pad + (W - 2 * pad) * i / (vals.length - 1); };
    let yFor = function(v) { return Hc - pad - (v - lo) / (hi - lo) * (Hc - 2 * pad); };
    if (isBar) {
      let bw = (W - 2 * pad) / Math.max(1, vals.length);
      let base = yFor(Math.max(lo, Math.min(hi, 0)));
      for (let i = 0; i < vals.length; i++) {
        let yv = yFor(vals[i]);
        let y = Math.min(yv, base), h = Math.max(1, Math.abs(yv - base));
        out += '<rect x="' + fmt(pad + i * bw + bw * 0.15, 2) + '" y="' + fmt(y, 2) + '" width="' + fmt(Math.max(0.7, bw * 0.7), 2) + '" height="' + fmt(h, 2) + '" rx="1" fill="' + c + '" opacity="0.9"/>';
      }
    } else {
      let pts = [];
      for (let i = 0; i < vals.length; i++) pts.push(fmt(xFor(i), 2) + "," + fmt(yFor(vals[i]), 2));
      if (o.fill !== false && vals.length >= 2) {
        out += '<polygon points="' + pts.join(" ") + " " + fmt(xFor(vals.length - 1), 2) + "," + fmt(Hc, 2) + " " + fmt(xFor(0), 2) + "," + fmt(Hc, 2) + '" fill="' + c + '" opacity="0.14"/>';
      }
      if (vals.length >= 2) out += '<polyline points="' + pts.join(" ") + '" fill="none" stroke="' + c + '" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/>';
      out += '<circle cx="' + fmt(xFor(vals.length - 1), 2) + '" cy="' + fmt(yFor(vals[vals.length - 1]), 2) + '" r="1.9" fill="' + c + '"/>';
    }
    out += "</svg>";
    return out;
  }

  // ---------- declarative spec model ----------

  const TYPE_CATALOG = [
    { id: "bar", label: "Bar", group: "Compare", method: "bar", description: "Vertical bars; grouped when several series." },
    { id: "stacked-bar", label: "Stacked bar", group: "Compare", method: "stackedBar", description: "Segments stacked to a per-category total." },
    { id: "stacked-bar-100", label: "100% stacked bar", group: "Compare", method: "stackedBar100", description: "Each category normalised to 100% — shares, not totals." },
    { id: "bar-horizontal", label: "Horizontal bar", group: "Compare", method: "barHorizontal", description: "Horizontal bars; best for long category names and rankings." },
    { id: "stacked-bar-horizontal", label: "Horizontal stacked bar", group: "Compare", method: "stackedBarHorizontal", description: "Horizontal stacked bars." },
    { id: "line", label: "Line", group: "Trend", method: "line", description: "Value over an ordered axis." },
    { id: "area", label: "Area", group: "Trend", method: "area", description: "Filled line — magnitude over an ordered axis." },
    { id: "stacked-area", label: "Stacked area", group: "Trend", method: "stackedArea", description: "Cumulative stacked fills." },
    { id: "timeseries", label: "Time series", group: "Trend", method: "timeSeries", description: "Line over a date axis, with optional trend line." },
    { id: "pie", label: "Pie", group: "Composition", method: "pie", description: "Parts of a whole (single series)." },
    { id: "donut", label: "Donut", group: "Composition", method: "donut", description: "Pie with an open centre and optional centerText." },
    { id: "histogram", label: "Histogram", group: "Distribution", method: "histogram", description: "Binned distribution of one numeric column." },
    { id: "heatmap", label: "Heatmap", group: "Distribution", method: "heatmap", description: "A value matrix shaded by intensity." },
    { id: "scatter", label: "Scatter", group: "Relationship", method: "scatter", description: "Two numeric columns plotted as x/y points." },
    { id: "sparkline", label: "Sparkline", group: "Compact", method: "sparkline", description: "Tiny inline trend line." },
    { id: "sparkline-bar", label: "Sparkline bars", group: "Compact", method: "sparklineBar", description: "Tiny inline bar strip." }
  ];
  const TYPE_GROUPS = ["Compare", "Trend", "Composition", "Distribution", "Relationship", "Compact"];

  // Extra id spellings worth accepting beyond the catalogue ids/method names.
  const TYPE_ALIASES = { "heat": "heatmap", "matrix": "heatmap", "grid": "heatmap", "spark": "sparkline", "sparkbar": "sparkline-bar", "sparkbars": "sparkline-bar", "column": "bar", "columns": "bar", "bars": "bar", "ts": "timeseries", "time": "timeseries" };

  function normalizeTypeId(id) {
    if (id == null) return null;
    let k = String(resolve(id)).trim().toLowerCase();
    if (!k) return null;
    let kk = k.replace(/[\s_]+/g, "-");
    let flat = kk.replace(/-/g, "");
    if (flat === "ts" || flat === "time" || flat === "timeseries") return "timeseries";
    if (TYPE_ALIASES[flat]) return TYPE_ALIASES[flat];
    for (let i = 0; i < TYPE_CATALOG.length; i++) {
      let t = TYPE_CATALOG[i];
      if (t.id === kk || t.id === k) return t.id;
      if (t.id.replace(/-/g, "") === flat) return t.id;
      if (t.method.toLowerCase() === flat) return t.id;
    }
    return null;
  }

  function typeMeta(id) {
    let nid = normalizeTypeId(id);
    if (!nid) return null;
    for (let i = 0; i < TYPE_CATALOG.length; i++) if (TYPE_CATALOG[i].id === nid) return TYPE_CATALOG[i];
    return null;
  }

  function mergeSpecStyle(spec, style) {
    for (let k in style) if (style[k] !== undefined) spec[k] = style[k];
    return spec;
  }

  function normaliseSpec(spec) {
    let s = (spec != null && typeof spec === "object" && !Array.isArray(spec)) ? spec : {};
    let type = s.type != null ? String(resolve(s.type)) : "bar";
    let labels = [];
    if (Array.isArray(s.labels)) for (let i = 0; i < s.labels.length; i++) labels.push(textOf(s.labels[i]));
    let rowLabels = [];
    if (Array.isArray(s.rowLabels)) for (let i = 0; i < s.rowLabels.length; i++) rowLabels.push(textOf(s.rowLabels[i]));
    let matrix = Array.isArray(s.matrix) ? s.matrix : null;
    let series = [], points = null, dist = null;
    if (Array.isArray(s.points) && s.points.length) points = s.points;
    if (Array.isArray(s.probs) && Array.isArray(s.values)) {
      let vals = arrOf(s.values) || [];
      let probs = arrOf(s.probs) || [];
      dist = {
        values: vals.map(function(v) { return num(v); }),
        probs: probs.map(function(v) { return num(v); }),
        expr: s.expr != null ? String(resolve(s.expr)) : null,
        mean: s.mean != null ? num(s.mean) : NaN,
        std: s.std != null ? num(s.std) : NaN
      };
    }
    if (Array.isArray(s.series) && s.series.length) {
      for (let i = 0; i < s.series.length; i++) {
        let raw = resolve(s.series[i]);
        if (raw == null || typeof raw !== "object") raw = {};
        let nm = raw.name != null ? textOf(raw.name) : "Series " + (i + 1);
        let color = raw.color != null ? escColor(raw.color, null) : null;
        let varr = arrOf(raw.values !== undefined ? raw.values : raw.data);
        let pts = raw.points !== undefined ? arrOf(raw.points) : null;
        let numeric = null;
        if (varr) {
          if (varr.length && Array.isArray(varr[0]) && !pts) pts = varr;
          else numeric = varr.map(function(v) { return num(v); });
        }
        series.push({ name: nm, values: numeric || [], points: pts, color: color });
      }
    } else if (s.values !== undefined) {
      let varr = arrOf(s.values) || [];
      let nm = s.name != null ? textOf(s.name) : "Value";
      let isMatrix = varr.length && Array.isArray(varr[0]);
      let isRows = !isMatrix && varr.length && varr[0] != null && typeof varr[0] === "object";
      let heatLike = /^(heat|matrix|grid)/.test(type);
      if (isMatrix && heatLike) {
        matrix = varr;
      } else if (isMatrix) {
        points = varr;
        series.push({ name: nm, values: [], points: varr, color: null });
      } else if (isRows && heatLike) {
        // A heatmap given tabular rows (e.g. a Perchance list of objects) has no
        // matrix yet — build one from the numeric columns.
        let hm = heatmapFromRows(varr, null);
        if (hm && hm.ok) {
          matrix = hm.rows;
          rowLabels = hm.rowLabels.slice();
          labels = hm.colLabels.map(String);
        } else {
          series.push({ name: nm, values: varr.map(function(v) { return num(v); }), points: null, color: null });
        }
      } else {
        series.push({ name: nm, values: varr.map(function(v) { return num(v); }), points: null, color: null });
      }
    }
    return {
      type: type,
      title: s.title != null ? textOf(s.title) : null,
      xLabel: s.xLabel != null ? textOf(s.xLabel) : null,
      yLabel: s.yLabel != null ? textOf(s.yLabel) : null,
      labels: labels,
      series: series,
      rowLabels: rowLabels,
      matrix: matrix,
      points: points,
      dist: dist,
      width: s.width != null ? num(s.width) : null,
      height: s.height != null ? num(s.height) : null,
      stacked: s.stacked,
      percent: s.percent,
      horizontal: s.horizontal,
      trend: s.trend,
      target: s.target != null ? num(s.target) : null,
      bins: s.bins,
      showValues: !!(s.showValues || s.values === true),
      showLegend: s.showLegend,
      showGrid: s.showGrid,
      showAxes: s.showAxes,
      donut: s.donut,
      centerText: s.centerText != null ? textOf(s.centerText) : null,
      heatColor: s.heatColor != null ? escColor(s.heatColor, null) : null,
      band: (s.band && typeof s.band === "object") ? s.band : null,
      bandColor: s.bandColor != null ? escColor(s.bandColor, null) : null,
      foreground: s.foreground != null ? escColor(s.foreground, null) : null,
      background: s.background != null ? escColor(s.background, null) : null,
      theme: s.theme != null ? String(resolve(s.theme)) : null,
      colors: Array.isArray(s.colors) ? s.colors.map(function(c, j) { return escColor(c, DEF_COLORS[j % DEF_COLORS.length]); }) : null,
      decimals: s.decimals != null ? num(s.decimals) : null,
      min: s.min != null ? num(s.min) : null,
      max: s.max != null ? num(s.max) : null,
      ticks: s.ticks != null ? num(s.ticks) : null,
      gap: s.gap != null ? num(s.gap) : null,
      log: s.log,
