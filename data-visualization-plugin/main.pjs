    put("title", s.title);
    put("xLabel", s.xLabel); put("yLabel", s.yLabel);
    put("height", s.height); put("width", s.width);
    put("stacked", s.stacked); put("percent", s.percent); put("horizontal", s.horizontal);
    put("trend", s.trend); put("target", s.target); put("bins", s.bins);
    if (s.showValues) { raw.values = true; raw.showValues = true; }
    put("donut", s.donut); put("centerText", s.centerText);
    put("heatColor", s.heatColor); put("bandColor", s.bandColor);
    put("colors", specColors(s)); put("decimals", s.decimals);
    put("min", s.min); put("max", s.max); put("ticks", s.ticks); put("gap", s.gap);
    put("theme", s.theme); put("foreground", s.foreground); put("background", s.background);
    put("log", s.log); put("smooth", s.smooth); put("dots", s.dots);
    put("mode", s.mode); put("bin", s.bin);
    if (s.band) raw.band = s.band;
    if (s.showLegend === false) raw.legend = false;
    if (s.showLegend === true) raw.legend = true;
