    if (t === "string") return v;
    if (t === "number" || t === "boolean") return String(v);
    let r = resolve(v);
    return typeof r === "string" ? r : (r == null ? "" : String(r));
  }

  function fenceSpec(spec) {
    let s = normaliseSpec(spec);
