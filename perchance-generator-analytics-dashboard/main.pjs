// ═══════════════════════════════════════════════════════════════════════════
// Perchance Generator Analytics Dashboard
//
// Scans every generator listed on https://perchance.org/generators (via the
// same /api/getGeneratorList endpoint that page uses), classifies each one
// into a category, persists the results (kv-plugin), and renders an analytics
// dashboard using the data-visualization-plugin's `charts` API.
//
// INCREMENTAL UPDATES: on every refresh, each generator is compared against
// the stored snapshot. New generators are classified; generators whose
// lastEditTime changed are re-classified and re-stored; generators that only
// changed views get just their view count/views-gained updated; everything
// else is left untouched. Only changed views/attributes are written back.
// ═══════════════════════════════════════════════════════════════════════════

// ── FEATURE ROADMAP (todo list — tick a box when the feature ships) ──────────
featureTodo
  ✅ 1. Snapshot history / time-series — keep the last N snapshots (not just one) so views, gains and category counts trend over days/weeks; add "Trends" charts
  ✅ 2. Watchlist + change alerts — pin any generators; toast/badge when a watched gen is edited or jumps in views; "movers" row highlight
  ✅ 3. Rankings with deltas — rank positions (and per-category) with ↑/↓ vs last scan; biggest risers/fallers
  ✅ 4. Shareable filtered links — URL query params (cat, q, adult, sort) that open a pre-filtered view; wire into dynamic metadata for proper share titles and descriptions
  ✅ 5. Generator comparison — select 2-5 generators, compare stats side-by-side + overlaid trend chart
  ✅ 6. Thumbnail lightbox + gallery mode — click any thumbnail for full-size preview; grid/browse view toggle alongside the table
  ✅ 7. CSV/JSON export of the table — export current filtered/sorted view (not just markdown); optional auto-refresh on load with "data fresh as of…" note
  ✅ 8. Interactive charts ↔ table linkage — hover tooltips with exact values; click a bar/slice to filter the table to that category
  ✅ 9. AI insights digest — "Today in generators" summary via generateText (top gainers, notable new gens, category shifts); AI-assisted category suggestions
  ✅ 10. Keep departed generators in history — flag removed gens (darklingslop, ChatNEX vanished silently) as "removed" instead of dropping them, so rankings/history stay consistent
  ✅ 11. Spotlight — a daily "Spotlight" puff piece on a top generator (AI-written), auto-queued 5 days in advance; each entry stays hidden until its scheduled live day, so spotlights keep appearing even if you skip updates

kv = {import:kv-plugin}
rathji = {import:rathji-template}
generateText = {import:ai-text-plugin}

// ── State machine ────────────────────────────────────────────────
// A tiny finite-state machine. With states [0, 1], go() toggles
// 0 -> 1 -> 0. Add more states to the array to grow it, and
// optional `onEnter(state)` / `onExit(state)` hooks run on each transition.
//
// HELPER INSTRUCTIONS:
//   Whenever the user says "go" in the helper, call `stateMachine.go()`.
//   That advances the state and triggers `onEnter`, which:
//     1) saves the new state (kv) so it survives a reload, and
//     2) the page also picks a new random quote at the bottom of the page.
//   So "go" => change the state AND swap the Hitchhiker's Guide quote.
fsm
  state = 0
  states = [[0, 1]]
  quotes = [["Don't Panic.", "The ships hung in the sky in much the same way that bricks don't.", "The answer to the great question of life, the universe and everything is forty-two.", "So long, and thanks for all the fish.", "A towel, it says, is about the most massively useful thing an interstellar hitchhiker can have.", "Time is an illusion. Lunchtime doubly so.", "I love deadlines. I love the whooshing sound they make as they fly by.", "In the beginning the Universe was created. This has made a lot of people very angry and been widely regarded as a bad move.", "Space is big. You just won't believe how vastly, hugely, mind-bogglingly big it is.", "If there's anything more important than my ego around, I want it caught and shot now.", "It is known that there are an infinite number of worlds, simply because there is an infinite amount of space to put them in.", "Oh no, not again.", "The Guide is definitive. Reality is frequently inaccurate.", "Isn't it enough to see that a garden is beautiful without having to believe that there are fairies at the bottom of it too?", "Share and enjoy.", "Don't Panic. And that is what the guide is about."]]
  pickQuote() =>
    let arr = Array.isArray(this.quotes) ? this.quotes : this.quotes.selectAll;
    return arr[Math.floor(Math.random() * arr.length)];
  onEnter(state) =>
    // called after each transition with the new state — add side effects here
    console.log("[fsm] state -> " + state);
    try { root.kv.fsm.set("state", state).catch(function () {}); } catch (e) {}
    try { let q = document.getElementById("quoteEl"); if (q) q.textContent = this.pickQuote(); } catch (e) {}
    return state;
  go() =>
    let arr = Array.isArray(this.states) ? this.states : this.states.selectAll;
    let cur = this.state;
    let next = arr[(arr.indexOf(cur) + 1) % arr.length];
    this.state = next;
    if (typeof this.onEnter === "function") this.onEnter(next);
    try { if (window.__dashExports && typeof window.__dashExports.saveView === "function") window.__dashExports.saveView(); } catch (e) {}
    return next;
  async restore() =>
    try {
      let s = await root.kv.fsm.get("state");
      if (s === 0 || s === 1) this.state = s;
    } catch (e) {}
    return this.state;

stateMachine = [fsm]

$meta
  title = Perchance Generator Analytics Dashboard
  description = Automatically scans every generator on the Perchance generators page, classifies them into categories, and visualizes the results — category shares, top generators, activity over time, tag frequency, view counts and more. Refreshing only re-processes generators that actually changed.
  tags = dashboard, analytics, charts, statistics, categories, generators, data-visualization, perchance

  // Shareable filtered links: ?cat=&q=&adult=&sort= open a pre-filtered view
  // (the dashboard reads them on load). This dynamic metadata gives shared
  // links proper titles/descriptions in embeds and the listing page. Self-
  // contained by design — the sandbox has none of the generator's scope.
  async dynamic(inputs) =>
    const p = inputs.urlParams || {};
    const q = typeof p.q === "string" ? p.q.trim().slice(0, 100) : "";
    const cat = typeof p.cat === "string" ? p.cat.trim().slice(0, 40) : "";
    const adult = typeof p.adult === "string" ? p.adult.trim().slice(0, 12) : "";
    const sort = typeof p.sort === "string" ? p.sort.trim().slice(0, 24) : "";
    if (!q && !cat && !adult) return {};
    const catNames = { games: "Games & RPGs", ai: "AI & Chat", art: "Art & Images", writing: "Writing & Stories", names: "Names & Words", music: "Music & Audio", people: "People & Roleplay", world: "Worldbuilding", tools: "Utilities & Tools", web: "Web & Templates", fun: "Quizzes & Fun", nature: "Nature & Animals", data: "Data & Math", food: "Food & Drink", other: "Everything Else" };
    const bits = [];
    if (cat === "__adult_explicit") bits.push("explicit content");
    else if (cat === "__adult_mature") bits.push("mature content");
    else if (cat === "__watched") bits.push("watched generators");
    else if (cat === "__movers") bits.push("rank movers");
    else if (catNames[cat]) bits.push(catNames[cat]);
    else if (cat) bits.push("a custom category");
    if (adult === "explicit") bits.push("explicit content");
    else if (adult === "mature") bits.push("mature content");
    if (q) bits.push("matching \"" + q + "\"");
    let label = bits.join(", ") || "a filtered view";
    let title = "Perchance Analytics — " + label;
    if (title.length > 80) title = title.slice(0, 77) + "…";
    let description = "Generator analytics filtered to " + label + (sort ? " · sorted by " + sort : "") + ": category shares, top generators, rank movers, activity and trends across every generator on Perchance.";
    if (description.length > 300) description = description.slice(0, 297) + "…";
    return { title: title, description: description };
  header
    mode = minimal

// ─────────────────────────────────────────────────────────────────────────────
// data-visualization-plugin — imported as `charts` (published plugin).
// API: charts.bar(data, opts) · charts.line · charts.pie · charts.donut ·
// charts.histogram · charts.timeSeries — every function returns inline <svg>.
// Data shapes: numbers, [{label, value}], [{label, key1, key2}],
// {labels:[...], series:[...]}, or distribution objects.
// NOTE: the plugin's $output is a callable FUNCTION, and Perchance's function
// wrapping strips its .bar/.line/... properties — so this `charts` binding is
// only the plugin's import hook (it loads the plugin). The dashboard reads the
// full API object from the plugin's `window.__chartsApi` global, which the
// plugin sets when it loads. Chart labels wrap/truncate inside the viewBox
// since data-visualization-plugin v1.1.0's label-wrapping update.
// ─────────────────────────────────────────────────────────────────────────────

charts = {import:data-visualization-plugin}
