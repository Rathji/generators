// ============================================================================
//  PERCHANCE OFFICE — suite configuration (business-template style)
//
//  Everything the launcher shows lives in the `config` list below — brand,
//  colors, the four apps and the recent-files list. The page renders
//  entirely from it; edit here rather than in the HTML/JS where possible.
// ============================================================================

$meta
  title = Perchance Office
  description = A browser-based office suite on the Perchance platform — Documents, Spreadsheets, Mail and Presentations, with a launcher home page and one module per app.
  tags = office, suite, documents, spreadsheets, presentations, mail, productivity, template
  header
    mode = minimal

config
  schemaVersion = 0.1.0

  // ── Suite identity ────────────────────────────────────────────────────────
  suite
    name = Perchance Office
    shortName = POffice
    monogram = P
    tagline = Write, calculate, present and communicate — one suite, right in your browser.
    homeTitle = What will you create today?
    homeSub = Open an app from the grid below, or jump straight back into a recent file.
    version = v0.1 · framework seed

  // ── Brand palette (hex) — mirrors the business-template trust-blue theme ──
  brand
    primary = #0a58ca
    secondary = #4f8ff7
    accent = #084298

  // ── The apps. Order in this list = order on the start page ───────────────
  apps
    docs
      id = docs
      name = Documents
      blurb = Letters, reports and rich documents with full formatting.
      badge = .docx
      color = #185ABD
    sheets
      id = sheets
      name = Spreadsheets
      blurb = Budgets, ledgers and formulas — from small lists to big data.
      badge = .xlsx
      color = #107C41
    slides
      id = slides
      name = Presentations
      blurb = Slide decks with text, images, charts and speaker notes.
      badge = .pptx
      color = #C43E1C
    mail
      id = mail
      name = Mail
      blurb = A calm inbox: compose, draft and organize messages.
      badge = @
      color = #6A4FD8

  // ── Start-page "recent files" (apps are opened, actual file storage
  //    arrives with the app builds — edit or clear this list freely) ─────────
  recents
    r1
      name = Q3 business review.docx
      app = docs
      meta = Edited 2 h ago
    r2
      name = Team budget 2027.xlsx
      app = sheets
      meta = Edited yesterday
    r3
      name = Welcome to the team.pptx
      app = slides
      meta = Edited Mon
    r4
      name = Draft — client proposal.docx
      app = docs
      meta = Edited 3 days ago
    r5
      name = Launch checklist.xlsx
      app = sheets
      meta = Edited last week
