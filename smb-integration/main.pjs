// ═══════════════════════════════════════════════════════════════════════════
// SMB-INTEGRATION — Small-Business Generator Pipeline framework
// ═══════════════════════════════════════════════════════════════════════════
//
// Structure and conventions follow the Rathji plugin template
// (perchance.org/rathji-plugin-template) — the authoritative skeleton used
// for Rathji's plugins.
//
// A Perchance plugin is just a normal generator that is written to be reused.
// The ONE special thing is the $output function at the bottom of this file:
// when another generator imports this one, `$output` is exactly what it gets.
// Everything else here — lists, data, helpers — exists to serve that function.
//
// Other generators use it like this (NOTE: never type a bare import-block
// inside a plugin's own source — the import scanner would try to import it):
//   smbIntegration = import:smb-integration         // ← top of their lists editor
//   [smbIntegration("hello")]                       // ← from a list
//   outputEl.innerHTML = root.smbIntegration("hello");   // ← from a <script>
//
// TO MAKE THIS YOURS:
//   1. Edit the $meta title/description/tags below.
//   2. Write your real logic in the Helpers section; call it from $output.
//   3. Adjust the Embedded data section if you need a payload.
//   4. Delete sections you don't need.
//   5. Save, then import it anywhere using the standard import syntax.
// ═══════════════════════════════════════════════════════════════════════════

$meta
  title = SMB-integration
  description = A blank-but-working plugin skeleton for SMB-integration, built on the structure of Rathji's plugin template. Import it, rename the smbIntegration* names, add your logic, and publish. Every plugin pattern (options nodes, preset lists, never-throw $output) is demonstrated live on this page.
  tags = plugin, smb, integration, skeleton, starter
  header
    mode = minimal


// ── 0. IMPORTS (optional) ───────────────────────────────────────────────────
// A named import binds another generator's $output to a name — this is also
// how users will import THIS generator. Replace it with whatever dependencies
// your plugin actually needs, or delete the section entirely.

simpleGenFooter = {import:simple-gen-footer}
uploadPlugin = {import:upload-plugin}
// The live hub (§33–35) needs the server plugin. It is imported
// here because THIS generator doubles as the reference hub page + test harness.
// Normal pipeline tools do NOT need it — they reach the hub through the
// postMessage bridge (section 34), which needs no server-plugin import.
createServerSocket = {import:server-plugin}


// ── 1. EMBEDDED DATA (optional) ─────────────────────────────────────────────
// Big bundled payloads (svg templates, word lists, base64 assets, config...)
// live in ONE lazy-initialised bundle, created exactly once on first use.
// Small plugins can delete this section AND the
// smbIntegrationDefaults() helper below.

initSmbIntegrationData() =>
  window.SMB_INTEGRATION_PAYLOAD = {
    version: 1,
    defaultEmoji: "✨",
    defaultColor: "#7c6cff",
    // TODO: bundle your plugin's real data here.
  };
  return window.SMB_INTEGRATION_PAYLOAD;

smbIntegrationDefaults() =>
  if(!window.SMB_INTEGRATION_PAYLOAD) initSmbIntegrationData();
  return window.SMB_INTEGRATION_PAYLOAD;


// ── 2. LISTS (data your plugin uses) ────────────────────────────────────────
// Users can pass these straight to your plugin. An options node is a list
// whose items are `key = value` pairs — the plugin reads each key, exactly
// like the `greetOpts` example in Rathji's tutorial step 4.

smbIntegrationOpts
  text = hello
  emoji = 🌊
  color = #22d3ee

// A list of preset options nodes. Pass the whole list and the plugin picks a
// random item — a handy way to offer the user "themes".

smbIntegrationPresets
  cosmic
    text = Cosmic
    emoji = 🌌
    color = #8b5cf6
  ocean
    text = Ocean
    emoji = 🌊
    color = #22d3ee
  ember
    text = Ember
    emoji = 🔥
    color = #f97316


// ── 3. HELPERS ──────────────────────────────────────────────────────────────
// Keep $output thin. Put the real work in named helpers (one job each).
// Helpers also stay reachable from the page as root.<name>, which makes them
// easy to test.

smbIntegrationResolve(v) =>
  if(v == null) return v;
  try {
    if(v.evaluateItem !== undefined) return v.evaluateItem; // pjs node → its evaluated value
  } catch(e) {}
  return v; // raw JS value → as-is

smbIntegrationStamp(text, opts) =>
  let emoji = opts.emoji || smbIntegrationDefaults().defaultEmoji;
  let color = opts.color || smbIntegrationDefaults().defaultColor;
  return '<span style="display:inline-block;background:' + color + '1a;color:' + color + ';border:1px solid ' + color + '66;border-radius:999px;padding:4px 14px;font-weight:600;font-family:system-ui,sans-serif;">' + emoji + " " + text + "</span>";


// ── 5. SMB PIPELINE — BUNDLE ENVELOPE ──────────────────────
// The canonical JSON envelope every pipeline tool publishes and consumes, so
// consumers can identify provenance and freshness without guessing. One shared
// envelope format; the per-bundle-type payload schemas are versioned separately
// (see §6).
//
//   {
//     "schemaVersion": 1,             // envelope format version (shared)
//     "bundleType": "idea",           // which payload schema applies
//     "tool": "idea-incubator",       // publishing generator's stub
//     "toolDisplayName": "Idea Incubator",
//     "exportedAt": "2026-09-07T12:34:56.789Z",  // ISO timestamp — freshness
//     "source": "ideas/idea-abc123.json",        // workspace file/records exported from
//     "payload": { ... }              // the tool's data (validated per type — §6)
//   }

smbEnvelopeVersion = 1

smbEnvelopeTypes = [["idea", "project", "milestone-event", "invoice", "payment-receipt", "idea-index", "project-index", "invoice-index", "payment-receipt-index", "pipeline-manifest", "backup"]]

// Build a valid envelope. Returns a typed result: { ok:true, bundle } on
// success, or { ok:false, error, errors[], bundle } (bundle kept for inspection)
// when required fields are missing or malformed. Never throws.
smbBuildEnvelope(opts) =>
  if(opts == null || typeof opts !== "object" || Array.isArray(opts)) {
    return { ok:false, error:"smbBuildEnvelope: expected an options object", errors:["opts"] };
  }
  let bundle = {
    schemaVersion: opts.schemaVersion || smbEnvelopeVersion,
    bundleType: opts.bundleType,
    tool: opts.tool,
    toolDisplayName: opts.toolDisplayName,
    exportedAt: opts.exportedAt || new Date().toISOString(),
    source: opts.source,
    payload: opts.payload
  };
  let v = smbValidateEnvelope(bundle);
  if(!v.ok) return { ok:false, error:v.errors.join("; "), errors:v.errors, bundle };
  return { ok:true, bundle };

// Validate any object as an envelope. Returns { ok, errors:[] } — a list of
// human-readable problems (empty when ok). Never throws.
smbValidateEnvelope(b) =>
  let errors = [];
  if(b == null || typeof b !== "object" || Array.isArray(b)) {
    return { ok:false, errors:["envelope must be a plain object"] };
  }
  if(typeof b.schemaVersion !== "number" || !Number.isInteger(b.schemaVersion) || b.schemaVersion < 1) {
    errors.push("schemaVersion must be a positive integer (got " + JSON.stringify(b.schemaVersion) + ")");
  } else if(b.schemaVersion > smbEnvelopeVersion) {
    errors.push("schemaVersion " + b.schemaVersion + " is newer than this library supports (" + smbEnvelopeVersion + ") — update smb-integration");
  }
  if(typeof b.bundleType !== "string" || !b.bundleType.trim()) {
    errors.push("bundleType must be a non-empty string");
  } else if(!smbEnvelopeTypes.includes(b.bundleType)) {
    errors.push("bundleType '" + b.bundleType + "' is not a known pipeline bundle type (known: " + smbEnvelopeTypes.join(", ") + ")");
  }
  if(typeof b.tool !== "string" || !b.tool.trim()) {
    errors.push("tool must be a non-empty string (publishing generator's stub)");
  }
  if(typeof b.toolDisplayName !== "string" || !b.toolDisplayName.trim()) {
    errors.push("toolDisplayName must be a non-empty string");
  }
  if(typeof b.exportedAt !== "string" || !b.exportedAt.trim() || Number.isNaN(Date.parse(b.exportedAt))) {
    errors.push("exportedAt must be a valid ISO date string");
  }
  if(typeof b.source !== "string" || !b.source.trim()) {
    errors.push("source must be a non-empty string (workspace file/records exported from)");
  }
  if(b.payload === undefined || b.payload === null) {
    errors.push("payload must be present");
  }
  return { ok: errors.length === 0, errors };

smbIsBundle(b) =>
  return smbValidateEnvelope(b).ok;

// Self-tests for the envelope — runnable from the page via root.smbEnvelopeSelfTest().
smbEnvelopeSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });
  let base = {
    bundleType: "idea", tool: "idea-incubator", toolDisplayName: "Idea Incubator",
    source: "ideas/idea-demo.json", payload: { title: "Demo idea", goals: ["g1"], scope: ["s1"] },
    exportedAt: new Date().toISOString()
  };

  let r = smbBuildEnvelope(base);
  t("build valid envelope succeeds", r.ok && r.bundle.bundleType === "idea");
  t("build fills in all canonical fields", r.ok && ["schemaVersion","bundleType","tool","toolDisplayName","exportedAt","source","payload"].every(k => r.bundle[k] !== undefined));
  t("build auto-fills exportedAt as valid ISO", r.ok && typeof r.bundle.exportedAt === "string" && !Number.isNaN(Date.parse(r.bundle.exportedAt)));
  t("build defaults schemaVersion to " + smbEnvelopeVersion, r.ok && r.bundle.schemaVersion === smbEnvelopeVersion);

  let clone = JSON.parse(JSON.stringify(r.bundle));
  t("round-trip through JSON stays valid", smbValidateEnvelope(clone).ok);
  t("round-trip preserves every field", clone.tool === "idea-incubator" && clone.source === base.source && clone.payload.title === "Demo idea");

  let cases = {
    "missing bundleType": { ...base, bundleType: undefined },
    "unknown bundleType": { ...base, bundleType: "mystery" },
    "missing tool": { ...base, tool: undefined },
    "missing toolDisplayName": { ...base, toolDisplayName: undefined },
    "missing source": { ...base, source: undefined },
    "missing payload": { ...base, payload: undefined },
    "invalid exportedAt": { ...base, exportedAt: "not-a-date" },
    "schemaVersion 0": { ...base, schemaVersion: 0 },
    "schemaVersion 1.5": { ...base, schemaVersion: 1.5 },
    "schemaVersion newer than library": { ...base, schemaVersion: 999 }
  };
  for(let [name, c] of Object.entries(cases)) {
    let v = smbValidateEnvelope(c);
    t("validate rejects " + name, !v.ok && Array.isArray(v.errors) && v.errors.length > 0);
  }

  t("validate rejects null", !smbValidateEnvelope(null).ok);
  t("validate rejects a string", !smbValidateEnvelope("hi").ok);
  t("validate rejects an array", !smbValidateEnvelope([1, 2]).ok);
  t("smbIsBundle true for valid", smbIsBundle(r.bundle));
  t("smbIsBundle false for garbage", !smbIsBundle("nope"));

  let r2 = smbBuildEnvelope({ ...base, schemaVersion: 1, exportedAt: "2026-01-02T03:04:05.000Z" });
  t("build preserves explicit exportedAt", r2.ok && r2.bundle.exportedAt === "2026-01-02T03:04:05.000Z");

  let bad = smbBuildEnvelope({ bundleType: "idea" });
  t("build returns typed error on invalid input", !bad.ok && typeof bad.error === "string" && bad.errors.length > 0);
  t("build never throws on junk", smbBuildEnvelope(null).ok === false);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 6. SMB PIPELINE — BUNDLE-TYPE SCHEMAS ──────────────────
// A versioned JSON schema registry for each pipeline bundle type. The envelope
// (section 5) is the outer wrapper; this section defines what each payload may
// contain. Every payload declares its own `schemaVersion` (the bundle-type
// schema version, independent of the envelope version) so consumers can detect
// schema-version gaps without a fresh manifest.
//
// Schema spec shape (declarative, extensible):
//   version      int  — this type's current schema version
//   properties   { fieldName: { type, required, minLength, minItems, itemType,
//                               itemShape, values, min, max } }
//   rules        [fn(payload) → error-string | null]  — custom cross-field checks

initSmbSchemas() =>
  if(window.SMB_SCHEMAS) return window.SMB_SCHEMAS;
  window.SMB_SCHEMAS = {
    idea: {
      version: 1,
      description: "A brainstormed idea, ready for adoption into a project",
      properties: {
        schemaVersion: { type: "int", required: true },
        id: { type: "string", minLength: 1, required: true },
        title: { type: "string", minLength: 1, required: true },
        description: { type: "string" },
        goals: { type: "array", itemType: "string", minItems: 1, required: true },
        scope: { type: "array", itemType: "string", minItems: 1, required: true },
        successCriteria: { type: "array", itemType: "string" },
        tags: { type: "array", itemType: "string" },
        status: { type: "enum", values: ["draft", "refining", "ready", "exported"] },
        createdAt: { type: "string" }
      }
    },
    "idea-index": {
      version: 1,
      description: "Index of the idea bundles idea-incubator has published, so project-master can discover them",
      properties: {
        schemaVersion: { type: "int", required: true },
        ideas: {
          type: "array", required: true, itemType: "object",
          itemShape: {
            ideaId: { type: "string", minLength: 1, required: true },
            bundleName: { type: "string", minLength: 1, required: true },
            url: { type: "string", minLength: 1, required: true },
            exportedAt: { type: "string", minLength: 1, required: true }
          }
        }
      }
    },
    "project-index": {
      version: 1,
      description: "Index of the project bundles project-master has published, so downstream tools can discover them",
      properties: {
        schemaVersion: { type: "int", required: true },
        projects: {
          type: "array", required: true, itemType: "object",
          itemShape: {
            projectId: { type: "string", minLength: 1, required: true },
            name: { type: "string" },
            status: { type: "string" },
            bundleName: { type: "string", minLength: 1, required: true },
            url: { type: "string", minLength: 1, required: true },
            exportedAt: { type: "string", minLength: 1, required: true }
          }
        }
      }
    },
    "payment-receipt-index": {
      version: 1,
      description: "Index of the payment-receipt bundles the ledger has published, for project-master to reflect payments",
      properties: {
        schemaVersion: { type: "int", required: true },
        receipts: {
          type: "array", required: true, itemType: "object",
          itemShape: {
            receiptId: { type: "string", minLength: 1, required: true },
            invoiceId: { type: "string", minLength: 1, required: true },
            bundleName: { type: "string", minLength: 1, required: true },
            url: { type: "string", minLength: 1, required: true },
            exportedAt: { type: "string", minLength: 1, required: true },
            amount: { type: "number", min: 0 },
            date: { type: "string" },
            projectId: { type: "string" },
            milestoneId: { type: "string" }
          }
        }
      }
    },
    "invoice-index": {
      version: 1,
      description: "Index of the invoice bundles the ledger has published",
      properties: {
        schemaVersion: { type: "int", required: true },
        invoices: {
          type: "array", required: true, itemType: "object",
          itemShape: {
            invoiceId: { type: "string", minLength: 1, required: true },
            client: { type: "string" },
            amount: { type: "number", min: 0 },
            status: { type: "string" },
            bundleName: { type: "string", minLength: 1, required: true },
            url: { type: "string", minLength: 1, required: true },
            exportedAt: { type: "string", minLength: 1, required: true }
          }
        }
      }
    },
    project: {
      version: 1,
      description: "A project's state, including its milestones and their statuses",
      properties: {
        schemaVersion: { type: "int", required: true },
        id: { type: "string", minLength: 1, required: true },
        name: { type: "string", minLength: 1, required: true },
        status: { type: "enum", values: ["proposed", "active", "paused", "done", "cancelled"], required: true },
        description: { type: "string" },
        ideaId: { type: "string" },
        client: { type: "string" },
        owners: { type: "array", itemType: "string" },
        milestones: {
          type: "array", required: true, itemType: "object",
          itemShape: {
            id: { type: "string", minLength: 1, required: true },
            title: { type: "string", minLength: 1, required: true },
            status: { type: "enum", values: ["todo", "in-progress", "blocked", "done"], required: true },
            billable: { type: "boolean" },
            amount: { type: "number", min: 0 },
            client: { type: "string" }
          }
        }
      }
    },
    "milestone-event": {
      version: 1,
      description: "A billable milestone event published by project-master for the ledger",
      properties: {
        schemaVersion: { type: "int", required: true },
        eventId: { type: "string", minLength: 1, required: true },
        projectId: { type: "string", minLength: 1, required: true },
        milestoneId: { type: "string", minLength: 1, required: true },
        milestoneTitle: { type: "string", minLength: 1, required: true },
        client: { type: "string", minLength: 1, required: true },
        amount: { type: "number", min: 0, required: true },
        date: { type: "string", minLength: 1, required: true },
        description: { type: "string" }
      },
      rules: [
        (p) => !(p.amount > 0) ? "amount must be greater than 0" : null,
        (p) => (typeof p.date === "string" && Number.isNaN(Date.parse(p.date))) ? "date must be a valid date string" : null
      ]
    },
    invoice: {
      version: 1,
      description: "An invoice draft or issued invoice on the ledger side",
      properties: {
        schemaVersion: { type: "int", required: true },
        id: { type: "string", minLength: 1, required: true },
        client: { type: "string", minLength: 1, required: true },
        amount: { type: "number", min: 0, required: true },
        status: { type: "enum", values: ["draft", "pending-approval", "issued", "paid", "partially-paid", "void"], required: true },
        projectId: { type: "string" },
        milestoneId: { type: "string" },
        milestoneTitle: { type: "string" },
        issuedAt: { type: "string" }
      },
      rules: [
        (p) => !(p.amount > 0) ? "amount must be greater than 0" : null
      ]
    },
    "payment-receipt": {
      version: 1,
      description: "Proof an invoice was paid (full or partial), for project-master to reflect",
      properties: {
        schemaVersion: { type: "int", required: true },
        receiptId: { type: "string", minLength: 1, required: true },
        invoiceId: { type: "string", minLength: 1, required: true },
        amount: { type: "number", min: 0, required: true },
        date: { type: "string", minLength: 1, required: true },
        projectId: { type: "string" },
        milestoneId: { type: "string" }
      },
      rules: [
        (p) => !(p.amount > 0) ? "amount must be greater than 0" : null,
        (p) => (typeof p.date === "string" && Number.isNaN(Date.parse(p.date))) ? "date must be a valid date string" : null
      ]
    },
    "pipeline-manifest": {
      version: 1,
      description: "The single shared registry of every tool in the pipeline",
      properties: {
        schemaVersion: { type: "int", required: true },
        tools: {
          type: "array", required: true, itemType: "object",
          itemShape: {
            stub: { type: "string", minLength: 1, required: true },
            displayName: { type: "string", minLength: 1, required: true },
            publishes: { type: "array", itemType: "string", required: true },
            consumes: { type: "array", itemType: "string" },
            schemaVersions: { type: "object" }
          }
        }
      },
      rules: [
        (p) => (!Array.isArray(p.tools) || p.tools.length === 0) ? "tools must be a non-empty array" : null
      ]
    },
    backup: {
      version: 1,
      description: "A full-tool backup export",
      properties: {
        schemaVersion: { type: "int", required: true },
        tool: { type: "string", minLength: 1, required: true },
        kind: { type: "string", minLength: 1, required: true },
        data: { type: "object", required: true },
        exportedAt: { type: "string" }
      }
    }
  };
  return window.SMB_SCHEMAS;

smbTypeOf(v) =>
  if(v === null) return "null";
  if(Array.isArray(v)) return "array";
  return typeof v;

// Validate a single field value against a property spec. Returns a list of
// human-readable problems (empty when the field is fine). Never throws.
smbCheckField(path, val, spec) =>
  let errs = [];
  let t = spec.type || "any";
  let typeOk = true;
  if(t === "string") typeOk = typeof val === "string";
  else if(t === "number") typeOk = typeof val === "number";
  else if(t === "int") typeOk = typeof val === "number" && Number.isInteger(val);
  else if(t === "boolean") typeOk = typeof val === "boolean";
  else if(t === "array") typeOk = Array.isArray(val);
  else if(t === "object") typeOk = val && typeof val === "object" && !Array.isArray(val);
  else if(t === "enum") typeOk = Array.isArray(spec.values) && spec.values.includes(val);
  if(!typeOk) {
    let what = t === "enum" ? ("one of: " + (spec.values || []).join(", ")) : ("a " + t);
    errs.push("field '" + path + "' must be " + what + " (got " + smbTypeOf(val) + ")");
    return errs;
  }
  if(t === "string" && typeof val === "string" && spec.minLength !== undefined && val.length < spec.minLength) {
    errs.push("field '" + path + "' must be at least " + spec.minLength + " character(s)");
  }
  if((t === "number" || t === "int") && typeof val === "number") {
    if(spec.min !== undefined && val < spec.min) errs.push("field '" + path + "' must be >= " + spec.min);
    if(spec.max !== undefined && val > spec.max) errs.push("field '" + path + "' must be <= " + spec.max);
  }
  if(t === "array" && Array.isArray(val)) {
    if(spec.minItems !== undefined && val.length < spec.minItems) errs.push("field '" + path + "' must have at least " + spec.minItems + " item(s)");
    if(spec.itemType === "string") {
      val.forEach((it, i) => { if(typeof it !== "string") errs.push("field '" + path + "[" + i + "]' must be a string (got " + smbTypeOf(it) + ")"); });
    } else if(spec.itemType === "object" && spec.itemShape) {
      val.forEach((it, i) => {
        if(it == null || typeof it !== "object" || Array.isArray(it)) { errs.push("field '" + path + "[" + i + "]' must be an object"); return; }
        for(let [k, s2] of Object.entries(spec.itemShape)) {
          let v2 = it[k];
          if(v2 === undefined || v2 === null) {
            if(s2.required) errs.push("field '" + path + "[" + i + "]." + k + "' is required");
          } else {
            errs.push(...smbCheckField(path + "[" + i + "]." + k, v2, s2));
          }
        }
      });
    }
  }
  return errs;

// Validate a payload against its bundle-type schema. Returns
// { ok, bundleType, schemaVersion, errors:[] }. Never throws.
smbValidatePayload(bundleType, payload) =>
  let schemas = initSmbSchemas();
  let schema = schemas[bundleType];
  let errors = [];
  if(!schema) {
    return { ok: false, bundleType, schemaVersion: null, errors: ["unknown bundle type '" + bundleType + "' (known: " + Object.keys(schemas).join(", ") + ")"] };
  }
  if(payload == null || typeof payload !== "object" || Array.isArray(payload)) {
    return { ok: false, bundleType, schemaVersion: null, errors: ["payload must be a plain object"] };
  }
  let pv = payload.schemaVersion;
  if(typeof pv !== "number" || !Number.isInteger(pv) || pv < 1) {
    errors.push("payload must declare an integer schemaVersion (got " + JSON.stringify(pv) + ")");
  } else if(pv !== schema.version) {
    errors.push("unsupported " + bundleType + " schema v" + pv + " — this library supports v" + schema.version +
      (pv < schema.version ? " (older version; update the publishing tool)" : " (newer version; update smb-integration)"));
  }
  for(let [key, spec] of Object.entries(schema.properties)) {
    if(key === "schemaVersion") continue; // handled by the pv check above
    let val = payload[key];
    if(val === undefined || val === null) {
      if(spec.required) errors.push("missing required field '" + key + "'");
      continue;
    }
    errors.push(...smbCheckField(bundleType + "." + key, val, spec));
  }
  if(schema.rules) {
    for(let rule of schema.rules) {
      let e = null;
      try { e = rule(payload); } catch(err) { e = "rule threw: " + err.message; }
      if(e) errors.push(e);
    }
  }
  return { ok: errors.length === 0, bundleType, schemaVersion: pv || null, errors };

// Validate a whole envelope + its payload together. Returns a combined typed
// result so consumers can distinguish envelope problems from payload problems.
smbValidateBundle(bundle) =>
  let env = smbValidateEnvelope(bundle);
  if(!env.ok) {
    return { ok:false, envelopeErrors: env.errors, payloadErrors: [], errors: env.errors, bundleType: bundle && bundle.bundleType, schemaVersion: null };
  }
  let pv = smbValidatePayload(bundle.bundleType, bundle.payload);
  if(!pv.ok) {
    return { ok:false, envelopeErrors: [], payloadErrors: pv.errors, errors: pv.errors, bundleType: bundle.bundleType, schemaVersion: pv.schemaVersion };
  }
  return { ok:true, envelopeErrors: [], payloadErrors: [], errors: [], bundleType: bundle.bundleType, schemaVersion: pv.schemaVersion };

smbSchemaVersion(bundleType) =>
  let s = initSmbSchemas()[bundleType];
  return s ? s.version : null;

// Self-tests for the schema registry — runnable from the page.
smbSchemaSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  let schemas = initSmbSchemas();

  t("every envelope bundle type has a registered schema", smbEnvelopeTypes.every(bt => !!schemas[bt]));
  t("each schema declares a positive integer version", Object.values(schemas).every(s => Number.isInteger(s.version) && s.version >= 1));

  let goodIdea = { schemaVersion: 1, id: "idea-001", title: "Widget marketplace", description: "x", goals: ["Launch MVP"], scope: ["Listings", "Checkout"], tags: ["marketplace"], status: "ready" };
  t("valid idea payload passes", smbValidatePayload("idea", goodIdea).ok);
  t("idea without title fails", !smbValidatePayload("idea", { ...goodIdea, title: undefined }).ok);
  t("idea without goals fails", !smbValidatePayload("idea", { ...goodIdea, goals: undefined }).ok);
  t("idea with empty goals fails (minItems 1)", !smbValidatePayload("idea", { ...goodIdea, goals: [] }).ok);
  t("idea with non-array scope fails", !smbValidatePayload("idea", { ...goodIdea, scope: "nope" }).ok);
  t("idea with bad status enum fails", !smbValidatePayload("idea", { ...goodIdea, status: "banana" }).ok);

  let goodProject = { schemaVersion: 1, id: "proj-1", name: "Widget site", status: "active", client: "ACME", milestones: [ { id: "m1", title: "Design", status: "done", billable: true, amount: 500 }, { id: "m2", title: "Build", status: "in-progress" } ] };
  t("valid project payload passes", smbValidatePayload("project", goodProject).ok);
  t("project without milestones fails", !smbValidatePayload("project", { ...goodProject, milestones: undefined }).ok);
  t("project with milestone missing required title fails", !smbValidatePayload("project", { ...goodProject, milestones: [{ id: "m1", status: "todo" }] }).ok);
  t("project with milestone bad status fails", !smbValidatePayload("project", { ...goodProject, milestones: [{ id: "m1", title: "T", status: "weird" }] }).ok);

  let goodEvent = { schemaVersion: 1, eventId: "e1", projectId: "proj-1", milestoneId: "m2", milestoneTitle: "Build", client: "ACME", amount: 1200.5, date: "2026-09-01" };
  t("valid milestone-event passes", smbValidatePayload("milestone-event", goodEvent).ok);
  t("milestone-event without client fails", !smbValidatePayload("milestone-event", { ...goodEvent, client: undefined }).ok);
  t("milestone-event with zero amount fails", !smbValidatePayload("milestone-event", { ...goodEvent, amount: 0 }).ok);
  t("milestone-event with bad date fails", !smbValidatePayload("milestone-event", { ...goodEvent, date: "not-a-date" }).ok);

  let goodReceipt = { schemaVersion: 1, receiptId: "r1", invoiceId: "inv-1", amount: 1200.5, date: "2026-09-10" };
  t("valid payment-receipt passes", smbValidatePayload("payment-receipt", goodReceipt).ok);
  t("payment-receipt without invoiceId fails", !smbValidatePayload("payment-receipt", { ...goodReceipt, invoiceId: undefined }).ok);
  t("payment-receipt without amount fails", !smbValidatePayload("payment-receipt", { ...goodReceipt, amount: undefined }).ok);
  t("payment-receipt with negative amount fails", !smbValidatePayload("payment-receipt", { ...goodReceipt, amount: -5 }).ok);

  let goodInvoice = { schemaVersion: 1, id: "inv-1", client: "ACME", amount: 1200.5, status: "issued", projectId: "proj-1", milestoneId: "m2" };
  t("valid invoice passes", smbValidatePayload("invoice", goodInvoice).ok);
  t("invoice with bad status fails", !smbValidatePayload("invoice", { ...goodInvoice, status: "paid-ish" }).ok);

  let goodManifest = { schemaVersion: 1, tools: [ { stub: "idea-incubator", displayName: "Idea Incubator", publishes: ["idea"], consumes: [] } ] };
  t("valid pipeline-manifest passes", smbValidatePayload("pipeline-manifest", goodManifest).ok);
  t("pipeline-manifest with empty tools fails", !smbValidatePayload("pipeline-manifest", { schemaVersion: 1, tools: [] }).ok);

  t("unknown bundle type fails", !smbValidatePayload("mystery", goodIdea).ok);
  t("payload missing schemaVersion fails", !smbValidatePayload("idea", { id: "i", title: "t", goals: ["g"], scope: ["s"] }).ok);
  t("payload with unsupported schemaVersion fails (gap named)", (() => { let v = smbValidatePayload("idea", { ...goodIdea, schemaVersion: 3 }); return !v.ok && v.errors[0].includes("v3"); })());
  t("smbSchemaVersion('idea') is 1", smbSchemaVersion("idea") === 1);
  t("smbSchemaVersion('mystery') is null", smbSchemaVersion("mystery") === null);

  let env = smbBuildEnvelope({ bundleType: "idea", tool: "idea-incubator", toolDisplayName: "Idea Incubator", source: "ideas/idea-001.json", payload: goodIdea });
  t("valid envelope + payload via smbValidateBundle passes", smbValidateBundle(env.bundle).ok);
  let env2 = smbBuildEnvelope({ bundleType: "idea", tool: "idea-incubator", toolDisplayName: "Idea Incubator", source: "ideas/x.json", payload: { ...goodIdea, schemaVersion: 2 } });
  t("smbValidateBundle flags payload schema gap", (() => { let v = smbValidateBundle(env2.bundle); return !v.ok && v.payloadErrors.length > 0; })());

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 7. SMB PIPELINE — PIPELINE REGISTRY & MANIFEST ─────────
// One shared manifest (a `pipeline-manifest` bundle) is the single source of
// truth for the whole pipeline: it lists every participating tool — its
// generator stub, display name, what it publishes, what it consumes, and its
// current schema versions. Any tool can discover the pipeline from it, and a
// new tool joins by REGISTERING ITSELF (smbRegisterTool) and republishing the
// manifest — no code changes in the other tools.
//
// The manifest itself will live on the file bus under the framework's own
// namespace (the bus write adapter — §8 — turns this into a real file):
//   bundleType: "pipeline-manifest"
//   bundle name: "manifest"
//   URL: https://editable.uploads.dev/file/smb-integration/manifest

smbManifestToolStub = ["smb-integration"]
smbManifestBundleName = ["manifest"]
smbManifestUrl() =>
  return "https://editable.uploads.dev/file/" + smbManifestToolStub + "/" + smbManifestBundleName;

// Build one tool's registry entry. schemaVersions is auto-derived from the
// schema registry (section 6) for every bundle type the tool publishes.
smbToolRegistration(opts) =>
  let publishes = Array.isArray(opts.publishes) ? opts.publishes.filter(t => typeof t === "string" && t.trim()) : [];
  let consumes = Array.isArray(opts.consumes) ? opts.consumes.filter(t => typeof t === "string" && t.trim()) : [];
  let schemaVersions = {};
  for(let bt of publishes) {
    let v = smbSchemaVersion(bt);
    if(v !== null) schemaVersions[bt] = v;
  }
  // activeNames (§12): the CURRENT bundle file name per published
  // type — normally the type itself, but a recovered tool (lost edit keys on a
  // new device) re-registers under a fresh bundle name so upstream discovery
  // follows it while old files stay readable. Optional; only stored when set.
  let entry = {
    stub: String(opts.stub || "").trim(),
    displayName: String(opts.displayName || opts.stub || "").trim(),
    publishes,
    consumes,
    schemaVersions
  };
  if(opts.activeNames && typeof opts.activeNames === "object") entry.activeNames = opts.activeNames;
  return entry;

// Add a tool to the manifest (or update it in place if the stub already
// exists — registering is idempotent per stub). Never throws.
smbRegisterTool(manifest, opts) =>
  let entry = smbToolRegistration(opts);
  let tools = (manifest && Array.isArray(manifest.tools)) ? manifest.tools.slice() : [];
  let idx = tools.findIndex(t => t && t.stub === entry.stub);
  if(idx >= 0) tools[idx] = entry; else tools.push(entry);
  return { schemaVersion: (manifest && manifest.schemaVersion) || 1, tools };

// The seed manifest: the framework plus the three core business tools.
smbDefaultManifest() =>
  let m = { schemaVersion: 1, tools: [] };
  m = smbRegisterTool(m, { stub: "smb-integration", displayName: "SMB Integration (framework)", publishes: ["pipeline-manifest"], consumes: [] });
  m = smbRegisterTool(m, { stub: "idea-incubator", displayName: "Idea Incubator", publishes: ["idea", "idea-index"], consumes: ["project"] });
  m = smbRegisterTool(m, { stub: "project-master", displayName: "Project Master", publishes: ["project", "project-index", "milestone-event"], consumes: ["idea", "payment-receipt"] });
  m = smbRegisterTool(m, { stub: "the-ledger", displayName: "The Ledger", publishes: ["invoice", "invoice-index", "payment-receipt", "payment-receipt-index", "backup"], consumes: ["milestone-event"] });
  return m;

smbFindTool(manifest, stub) =>
  let tools = (manifest && Array.isArray(manifest.tools)) ? manifest.tools : [];
  return tools.find(t => t && t.stub === stub) || null;

smbManifestToolsPublishing(manifest, bundleType) =>
  let tools = (manifest && Array.isArray(manifest.tools)) ? manifest.tools : [];
  return tools.filter(t => Array.isArray(t.publishes) && t.publishes.includes(bundleType)).map(t => t.stub);

smbManifestToolsConsuming(manifest, bundleType) =>
  let tools = (manifest && Array.isArray(manifest.tools)) ? manifest.tools : [];
  return tools.filter(t => Array.isArray(t.consumes) && t.consumes.includes(bundleType)).map(t => t.stub);

smbValidateManifest(manifest) =>
  return smbValidatePayload("pipeline-manifest", manifest);

// Non-fatal warnings — e.g. a tool references a bundle type with no schema.
smbManifestWarnings(manifest) =>
  let warnings = [];
  let tools = (manifest && Array.isArray(manifest.tools)) ? manifest.tools : [];
  for(let tool of tools) {
    for(let bt of (tool.publishes || [])) {
      if(smbSchemaVersion(bt) === null) warnings.push(tool.stub + " publishes '" + bt + "' which has no registered schema in smb-integration");
    }
    for(let bt of (tool.consumes || [])) {
      if(smbSchemaVersion(bt) === null) warnings.push(tool.stub + " consumes '" + bt + "' which has no registered schema in smb-integration");
    }
  }
  return warnings;

smbManifestSummary(manifest) =>
  let tools = (manifest && Array.isArray(manifest.tools)) ? manifest.tools : [];
  return tools.map(t => t.stub + " (" + t.displayName + "): publishes [" + (t.publishes || []).join(", ") + "], consumes [" + (t.consumes || []).join(", ") + "]");

// Self-tests for the manifest — runnable from the page.
smbManifestSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  let m = smbDefaultManifest();

  t("default manifest validates", smbValidateManifest(m).ok);
  t("default manifest has 4 core tools", m.tools.length === 4);
  t("all core stubs present", ["smb-integration", "idea-incubator", "project-master", "the-ledger"].every(s => smbFindTool(m, s) !== null));

  let idea = smbFindTool(m, "idea-incubator");
  t("idea-incubator publishes idea", idea.publishes.includes("idea"));
  t("idea-incubator schemaVersions.idea is 1", idea.schemaVersions.idea === 1);
  t("idea-incubator consumes project", idea.consumes.includes("project"));

  let pm = smbFindTool(m, "project-master");
  t("project-master publishes project + milestone-event", pm.publishes.includes("project") && pm.publishes.includes("milestone-event"));
  t("project-master consumes idea + payment-receipt", pm.consumes.includes("idea") && pm.consumes.includes("payment-receipt"));

  let ledger = smbFindTool(m, "the-ledger");
  t("the-ledger consumes milestone-event", ledger.consumes.includes("milestone-event"));
  t("the-ledger publishes payment-receipt + backup", ledger.publishes.includes("payment-receipt") && ledger.publishes.includes("backup"));

  let m2 = smbRegisterTool(m, { stub: "time-tracker", displayName: "Time Tracker", publishes: ["timesheet"], consumes: ["project"] });
  t("new tool joins by registration", m2.tools.length === 5 && smbFindTool(m2, "time-tracker") !== null);
  let m3 = smbRegisterTool(m2, { stub: "time-tracker", displayName: "Time Tracker v2", publishes: ["timesheet"] });
  t("re-registering same stub updates, not duplicates", m3.tools.length === 5 && smbFindTool(m3, "time-tracker").displayName === "Time Tracker v2");

  t("tools publishing 'idea' discovered", smbManifestToolsPublishing(m, "idea").includes("idea-incubator"));
  t("tools consuming 'milestone-event' discovered", smbManifestToolsConsuming(m, "milestone-event").includes("the-ledger"));
  t("tools consuming 'idea' discovered", smbManifestToolsConsuming(m, "idea").includes("project-master"));
  t("unknown stub not found", smbFindTool(m, "nope") === null);
  t("no tools publish unknown type in seed", smbManifestToolsPublishing(m, "mystery").length === 0);

  let w = smbManifestWarnings(m2);
  t("unknown publish type flagged as warning", w.some(x => x.includes("time-tracker") && x.includes("timesheet")));
  t("seed manifest has no schema warnings", smbManifestWarnings(m).length === 0);

  t("manifest URL uses framework namespace", smbManifestUrl() === "https://editable.uploads.dev/file/smb-integration/manifest");

  let dup = smbRegisterTool(smbRegisterTool({ schemaVersion: 1, tools: [] }, { stub: "a", displayName: "A", publishes: ["idea"] }), { stub: "a", displayName: "A2", publishes: ["idea"] });
  t("duplicate stub collapses to one entry", dup.tools.length === 1 && dup.tools[0].displayName === "A2");

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 8. SMB PIPELINE — BUS WRITE ADAPTER ────────────────────
// Publish any bundle as a text file under the current tool's own namespace:
// the stable public URL is https://editable.uploads.dev/file/<toolStub>/<bundleName>.
//
//   first create → the bus hands back an editKey, which we keep in the local
//                  edit-key store (localStorage) so later updates work.
//   update       → the stored (or passed-in) editKey is sent along; the bus
//                  replaces the file, and we report the new editCount.
//   size ceiling → bundles over 5 MiB are rejected before any network call.
//   failures     → quota / rate-limit / unsaved-generator / service errors are
//                  surfaced as readable typed errors, never thrown.
//
// The full edit-key *wallet* (multi-tool management, loss recovery) is roadmap
// This store is the minimal foundation the wallet (§12) builds on.

smbBusMaxBytes = [5242880]   // 5 MiB — editable-file ceiling
smbBusBaseUrl = ["https://editable.uploads.dev/file/"]
smbBusKeyPrefix = ["smb:editkey:"]

smbBusUrl(toolStub, bundleName) =>
  return smbBusBaseUrl + toolStub + "/" + bundleName;

smbBusValidName(name) =>
  return typeof name === "string" && /^[a-z0-9-]{1,200}$/.test(name);

smbBusKeyName(toolStub, bundleName) =>
  return smbBusKeyPrefix + toolStub + ":" + bundleName;

smbBusStoreGet(key) =>
  try { return window.localStorage.getItem(key); } catch(e) { return null; }

smbBusStoreSet(key, val) =>
  try { window.localStorage.setItem(key, val); return true; } catch(e) { return false; }

smbBusStoreRemove(key) =>
  try { window.localStorage.removeItem(key); } catch(e) {}

smbBusGetEditKey(toolStub, bundleName) =>
  return smbBusStoreGet(smbBusKeyName(toolStub, bundleName));

smbBusSaveEditKey(toolStub, bundleName, editKey) =>
  if(typeof editKey !== "string" || !editKey) return false;
  return smbBusStoreSet(smbBusKeyName(toolStub, bundleName), editKey);

smbBusClearEditKey(toolStub, bundleName) =>
  smbBusStoreRemove(smbBusKeyName(toolStub, bundleName));

// Local edit-count ledger. The editable-uploads server reports editCount
// unreliably (sometimes only on create, sometimes null) even though the
// plugin docs promise it on every successful call — so we keep our own
// monotonic counter per file, seeded from the server's value whenever one
// comes back. Monotonic per device; cross-device drift is possible but the
// envelope's exportedAt timestamp remains the authoritative freshness signal
// (the read adapter watches this to detect changes).
smbBusCountKeyName(toolStub, bundleName) =>
  return "smb:editcount:" + toolStub + ":" + bundleName;

smbBusGetEditCount(toolStub, bundleName) =>
  let v = smbBusStoreGet(smbBusCountKeyName(toolStub, bundleName));
  let n = Number(v);
  return (Number.isInteger(n) && n >= 1) ? n : null;

smbBusSaveEditCount(toolStub, bundleName, n) =>
  if(!Number.isInteger(n) || n < 1) return false;
  return smbBusStoreSet(smbBusCountKeyName(toolStub, bundleName), String(n));

smbBusClearEditCount(toolStub, bundleName) =>
  smbBusStoreRemove(smbBusCountKeyName(toolStub, bundleName));

// Decide the reported edit count for a publish outcome. serverCount wins when
// present; a fresh create is count 1; otherwise fall back to incrementing the
// local ledger; last resort is unknown.
smbBusNextEditCount(prevLocal, serverCount, created) =>
  if(typeof serverCount === "number" && Number.isInteger(serverCount) && serverCount >= 1) return { count: serverCount, source: "server" };
  if(created) return { count: 1, source: "inferred" };
  if(typeof prevLocal === "number" && prevLocal >= 1) return { count: prevLocal + 1, source: "local-ledger" };
  return { count: null, source: "unknown" };

// Map a raw upload-plugin error string to a stable machine-readable code.
smbBusMapError(raw) =>
  if(raw === "over_daily_allowance") return "quota";
  if(raw === "file_too_big") return "file_too_big";
  if(raw === "invalid_filetype") return "invalid_filetype";
  if(raw === "editable_requires_saved_generator") return "unsaved_generator";
  return "service_error";

// Readable, actionable message for each failure code.
smbBusErrorMessage(code, toolStub, bundleName) =>
  if(code === "quota") return "editing quota reached — try again later (editable-file writes share the daily upload allowance)";
  if(code === "file_too_big") return "the bundle file exceeds the bus's size ceiling (" + smbBusMaxBytes + " bytes) — split the export into smaller bundles";
  if(code === "invalid_filetype") return "the bus rejected the file type";
  if(code === "unsaved_generator") return "this generator must be saved before it can publish to the bus — save it so its namespace becomes '" + toolStub + "'";
  if(code === "superseded") return "this write was superseded by a more recent one (writes to a name are limited to ~1 per 10s) — wait a moment and try again";
  if(code === "plugin_missing") return "upload-plugin is unavailable — check that smb-integration's imports include uploadPlugin = import:upload-plugin";
  return "the bus service failed — check your connection and try again";

// Publish a bundle to the file bus. opts:
//   bundle       the envelope object to publish (validated first — §5/§6)
//   toolStub     namespace to publish under (default: bundle.tool)
//   bundleName   file name (default: bundle.bundleType; "manifest" for the manifest)
//   editKey      explicit edit key (default: looked up in the local store)
//   dryRun       validate / serialize / size-check only — no network write
//   uploadPlugin injectable for tests (default: root.uploadPlugin)
// Returns a typed result and never throws:
//   ok:true  → { url, toolStub, bundleName, editKey, editCount,
//                editCountSource("server"|"inferred"|"local-ledger"|"unknown"),
//                created, bytes, publishedAt, warnings[] }
//   ok:false → { code, error, ... }  — code ∈ invalid_opts | invalid_bundle |
//                invalid_name | serialize_failed | too_large | plugin_missing |
//                quota | file_too_big | invalid_filetype | unsaved_generator |
//                superseded | service_error
async smbPublishBundle(opts) =>
  if(opts == null || typeof opts !== "object" || Array.isArray(opts)) {
    return { ok:false, code:"invalid_opts", error:"smbPublishBundle: expected an options object" };
  }
  let bundle = opts.bundle;
  if(bundle == null || typeof bundle !== "object" || Array.isArray(bundle)) {
    return { ok:false, code:"invalid_bundle", error:"smbPublishBundle: opts.bundle (the envelope to publish) is required" };
  }
  let v = smbValidateBundle(bundle);
  if(!v.ok) {
    return { ok:false, code:"invalid_bundle", error:"bundle failed validation: " + v.errors.join("; "), errors:v.errors, bundleType:v.bundleType };
  }
  let toolStub = opts.toolStub || bundle.tool;
  let bundleName = opts.bundleName || bundle.bundleType;
  if(!smbBusValidName(toolStub)) {
    return { ok:false, code:"invalid_name", error:"toolStub '" + String(toolStub) + "' must be 1-200 chars of lowercase letters, numbers and hyphens", field:"toolStub" };
  }
  if(!smbBusValidName(bundleName)) {
    return { ok:false, code:"invalid_name", error:"bundleName '" + String(bundleName) + "' must be 1-200 chars of lowercase letters, numbers and hyphens", field:"bundleName" };
  }
  let text;
  try { text = JSON.stringify(bundle); }
  catch(e) { return { ok:false, code:"serialize_failed", error:"could not serialize the bundle to JSON: " + e.message }; }
  let bytes = new TextEncoder().encode(text).length;
  if(bytes > smbBusMaxBytes) {
    return { ok:false, code:"too_large", error:"bundle is " + bytes + " bytes — the bus ceiling is " + smbBusMaxBytes + " bytes (5 MiB). Split the export into smaller bundles.", bytes, maxBytes:smbBusMaxBytes };
  }
  let genName = (typeof window.generatorName === "string" && window.generatorName.trim()) ? window.generatorName.trim() : "";
  let warnings = [];
  if(genName && genName !== toolStub) {
    warnings.push("toolStub '" + toolStub + "' differs from the current generator '" + genName + "' — the file will actually be written under the '" + genName + "' namespace, so run this inside the '" + toolStub + "' generator for the reported URL to be accurate");
  }
  let editKey = (typeof opts.editKey === "string" && opts.editKey) ? opts.editKey : (smbBusGetEditKey(toolStub, bundleName) || undefined);
  let result = { toolStub, bundleName, url:smbBusUrl(toolStub, bundleName), bytes, warnings };
  if(opts.dryRun) {
    let prev = smbBusGetEditCount(toolStub, bundleName);
    result.editCount = (prev !== null) ? prev + 1 : null;
    result.editCountSource = (prev !== null) ? "local-ledger" : "unknown";
    return { ok:true, dryRun:true, ...result };
  }
  let up = opts.uploadPlugin || root.uploadPlugin;
  if(!up || !up.editable || typeof up.editable.set !== "function") {
    return { ok:false, code:"plugin_missing", error:smbBusErrorMessage("plugin_missing", toolStub, bundleName), ...result };
  }
  let res;
  try {
    res = await up.editable.set(bundleName, text, editKey ? { editKey } : undefined);
  } catch(e) {
    return { ok:false, code:"service_error", error:"the bus service failed: " + e.message, ...result };
  }
  if(!res || typeof res !== "object") {
    return { ok:false, code:"service_error", error:"the bus service returned no result", ...result };
  }
  if(res.error) {
    let code = smbBusMapError(res.error);
    return { ok:false, code, error:smbBusErrorMessage(code, toolStub, bundleName), rawError:res.error, ...result };
  }
  if(res.superseded) {
    return { ok:false, code:"superseded", error:smbBusErrorMessage("superseded", toolStub, bundleName), ...result };
  }
  if(res.editKey) {
    smbBusSaveEditKey(toolStub, bundleName, res.editKey);
    result.editKey = res.editKey;
  }
  result.created = !!res.editKey;
  let nc = smbBusNextEditCount(smbBusGetEditCount(toolStub, bundleName), (typeof res.editCount === "number") ? res.editCount : null, result.created);
  if(nc.count !== null) smbBusSaveEditCount(toolStub, bundleName, nc.count);
  result.editCount = nc.count;
  result.editCountSource = nc.source;
  result.publishedAt = new Date().toISOString();
  if(res.editKey) smbWalletNoteEditKey(toolStub, bundleName, res.editKey, nc.count);
  try {
    let st = (typeof opts.syncTracker === "function") ? opts.syncTracker : smbSyncNotePublish;
    st(toolStub, bundleName, nc.count, result.publishedAt);
  } catch(e) {}
  return { ok:true, ...result };

// Self-tests for the bus write adapter — runnable from the page via
// root.smbBusSelfTest(). Everything network-free (real round-trips are
// exercised by the live "Publish for real" demo, which needs a saved
// generator); a fake uploadPlugin proves the adapter never touches the
// network for the cases it rejects.
async smbBusSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });
  let built = smbBuildEnvelope({
    bundleType: "idea", tool: "smb-integration", toolDisplayName: "SMB Integration (framework)",
    source: "test/bus-write-test.json",
    payload: { schemaVersion: 1, id: "bus-test", title: "Bus write test", goals: ["g1"], scope: ["s1"], status: "ready" }
  });
  if(!built.ok) {
    return { ok:false, passCount:0, failCount:1, results:[{ name:"test bundle failed to build", pass:false, detail:built.error }] };
  }
  let bundle = built.bundle;

  t("valid name 'idea-incubator' accepted", smbBusValidName("idea-incubator"));
  t("valid name 'manifest' accepted", smbBusValidName("manifest"));
  t("valid single-char name accepted", smbBusValidName("a"));
  t("valid 200-char name accepted", smbBusValidName("a".repeat(200)));
  t("uppercase name rejected", !smbBusValidName("Idea"));
  t("underscore name rejected", !smbBusValidName("idea_incubator"));
  t("spaced name rejected", !smbBusValidName("idea incubator"));
  t("empty name rejected", !smbBusValidName(""));
  t("over-length name rejected", !smbBusValidName("a".repeat(201)));
  t("non-string name rejected", !smbBusValidName(42) && !smbBusValidName(null));

  t("url built canonically", smbBusUrl("idea-incubator", "idea") === "https://editable.uploads.dev/file/idea-incubator/idea");

  let boom = { editable: { set() { throw new Error("network touched"); }, get() { throw new Error("network touched"); } } };

  let rBad = await smbPublishBundle({ bundle: { junk: true }, toolStub: "smb-integration", bundleName: "manifest", uploadPlugin: boom });
  t("invalid bundle rejected before any network call", rBad.ok === false && rBad.code === "invalid_bundle");
  t("invalid-bundle error is readable", typeof rBad.error === "string" && rBad.error.length > 5);

  let rName = await smbPublishBundle({ bundle, toolStub: "Bad_Name", bundleName: "manifest", uploadPlugin: boom });
  t("invalid toolStub rejected before network", rName.ok === false && rName.code === "invalid_name");

  let bigPayload = { schemaVersion: 1, id: "big", title: "Big", goals: ["g"], scope: ["x".repeat(smbBusMaxBytes + 1)], status: "ready" };
  let rBig = await smbPublishBundle({ bundle: { ...bundle, payload: bigPayload }, toolStub: "smb-integration", bundleName: "manifest", uploadPlugin: boom });
  t("oversize bundle rejected with too_large", rBig.ok === false && rBig.code === "too_large");
  t("too_large error names the ceiling", typeof rBig.error === "string" && rBig.error.includes("5242880"));

  let rDry = await smbPublishBundle({ bundle, toolStub: "smb-integration", bundleName: "manifest", dryRun: true, uploadPlugin: boom });
  t("dry run succeeds without touching the network", rDry.ok === true && rDry.dryRun === true);
  t("dry run reports the canonical public URL", rDry.url === "https://editable.uploads.dev/file/smb-integration/manifest");
  t("dry run reports byte size", typeof rDry.bytes === "number" && rDry.bytes > 0);

  let genName = (typeof window.generatorName === "string" && window.generatorName.trim()) ? window.generatorName.trim() : "";
  if(genName) {
    let rMM = await smbPublishBundle({ bundle, toolStub: "some-other-tool", bundleName: "x", dryRun: true, uploadPlugin: boom });
    t("namespace mismatch surfaced as a warning", Array.isArray(rMM.warnings) && rMM.warnings.length > 0);
  }

  smbBusClearEditKey("test-tool", "test-bundle");
  t("edit-key store starts empty", smbBusGetEditKey("test-tool", "test-bundle") === null);
  t("edit-key store round-trips a key", (() => { smbBusSaveEditKey("test-tool", "test-bundle", "abc123"); return smbBusGetEditKey("test-tool", "test-bundle") === "abc123"; })());
  smbBusClearEditKey("test-tool", "test-bundle");
  t("edit-key store clears a key", smbBusGetEditKey("test-tool", "test-bundle") === null);

  t("over_daily_allowance maps to quota", smbBusMapError("over_daily_allowance") === "quota");
  t("file_too_big maps to file_too_big", smbBusMapError("file_too_big") === "file_too_big");
  t("editable_requires_saved_generator maps to unsaved_generator", smbBusMapError("editable_requires_saved_generator") === "unsaved_generator");
  t("unknown error maps to service_error", smbBusMapError("weird") === "service_error");
  t("quota error message is actionable", smbBusErrorMessage("quota").includes("try again later"));

  smbBusClearEditCount("test-tool", "test-bundle");
  t("edit-count ledger starts empty", smbBusGetEditCount("test-tool", "test-bundle") === null);
  t("edit-count ledger round-trips", (() => { smbBusSaveEditCount("test-tool", "test-bundle", 7); return smbBusGetEditCount("test-tool", "test-bundle") === 7; })());
  t("edit-count ledger rejects junk", (() => { smbBusSaveEditCount("test-tool", "test-bundle", -3); return smbBusGetEditCount("test-tool", "test-bundle") === 7; })());
  smbBusClearEditCount("test-tool", "test-bundle");
  t("edit-count ledger clears", smbBusGetEditCount("test-tool", "test-bundle") === null);

  let n1 = smbBusNextEditCount(null, null, true);
  t("fresh create infers count 1", n1.count === 1 && n1.source === "inferred");
  let n2 = smbBusNextEditCount(3, null, false);
  t("update without server count increments local ledger", n2.count === 4 && n2.source === "local-ledger");
  let n3 = smbBusNextEditCount(9, 12, false);
  t("server count wins when present", n3.count === 12 && n3.source === "server");
  let n4 = smbBusNextEditCount(null, null, false);
  t("no info yields unknown", n4.count === null && n4.source === "unknown");

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 9. SMB PIPELINE — BUS READ ADAPTER ─────────────────────
// Fetch any upstream bundle by its public URL, parse & schema-validate it,
// compare its exportedAt timestamp against what the reader already has, and
// return a clear typed result:
//   ok:true  → status:"fresh"   upstream is newer than the local copy (or none)
//            → status:"unchanged"  same exportedAt
//            → status:"older"   upstream is older than the local copy — the
//                               version gap is named (gap.human)
//   ok:false → code:"invalid_opts" | "404" | "network" | "malformed"
//            → code:"schema_gap"  (valid envelope, payload schema version is
//                                  newer or older than this library supports —
//                                  both versions named)
// Never throws.

// Classify a parsed JSON object as a consumable bundle: "ok", "schema_gap",
// or "malformed" (with reason). Pure — no I/O. Never throws.
smbClassifyBundle(bundle) =>
  if(bundle == null || typeof bundle !== "object" || Array.isArray(bundle)) {
    return { status:"malformed", reason:"bundle must be a plain object" };
  }
  let env = smbValidateEnvelope(bundle);
  if(!env.ok) return { status:"malformed", reason:env.errors.join("; ") };
  let pv = smbValidatePayload(bundle.bundleType, bundle.payload);
  if(!pv.ok) {
    let declared = bundle.payload && bundle.payload.schemaVersion;
    let current = smbSchemaVersion(bundle.bundleType);
    if(typeof declared === "number" && Number.isInteger(declared) && declared >= 1 && current !== null && declared !== current) {
      return {
        status:"schema_gap",
        bundleType: bundle.bundleType,
        declaredVersion: declared,
        currentVersion: current,
        gap: Math.abs(current - declared),
        newer: declared > current,
        reason: pv.errors.join("; ")
      };
    }
    return { status:"malformed", reason:pv.errors.join("; ") };
  }
  return { status:"ok" };

// Render a millisecond span as a short human "age" (e.g. "2 minutes", "5 days").
smbBusAgeHuman(ms) =>
  let s = Math.max(1, Math.round(ms / 1000));
  if(s < 60) return s + " second" + (s === 1 ? "" : "s");
  let m = Math.round(s / 60);
  if(m < 60) return m + " minute" + (m === 1 ? "" : "s");
  let h = Math.round(m / 60);
  if(h < 24) return h + " hour" + (h === 1 ? "" : "s");
  let d = Math.round(h / 24);
  return d + " day" + (d === 1 ? "" : "s");

// Pull an upstream bundle. opts:
//   url        the bundle's public URL (required)
//   have       what the reader already has — a bundle object, a
//              { exportedAt, bundleType, schemaVersion } record, a
//              { bundle: <bundle object> } wrapper, or null (default)
//   fetchImpl  injectable fetch for tests (default: window.fetch)
// Returns a typed result and never throws.
async smbPullBundle(opts) =>
  if(opts == null || typeof opts !== "object" || Array.isArray(opts)) {
    return { ok:false, code:"invalid_opts", error:"smbPullBundle: expected an options object" };
  }
  let url = opts.url;
  if(typeof url !== "string" || !url.trim()) {
    return { ok:false, code:"invalid_opts", error:"smbPullBundle: opts.url (the upstream bundle's public URL) is required" };
  }
  url = url.trim();
  if(!/^https?:\/\//i.test(url)) {
    return { ok:false, code:"invalid_opts", error:"smbPullBundle: opts.url must be an http(s) URL (got '" + url + "')" };
  }
  let fetchImpl = (typeof opts.fetchImpl === "function") ? opts.fetchImpl
    : ((typeof window !== "undefined" && typeof window.fetch === "function") ? window.fetch.bind(window) : null);
  if(!fetchImpl) {
    return { ok:false, code:"network", error:"no fetch available in this environment", url };
  }
  let res;
  try {
    res = await fetchImpl(url);
  } catch(e) {
    return { ok:false, code:"network", error:"could not reach '" + url + "': " + e.message, url };
  }
  if(!res) return { ok:false, code:"network", error:"fetch returned no response", url };
  if(res.status === 404) {
    return { ok:false, code:"404", error:"no bundle found at '" + url + "' (404) — the publisher may have never exported it, or it was deleted/renamed", url };
  }
  if(!res.ok) {
    return { ok:false, code:"network", error:"upstream returned HTTP " + res.status + " for '" + url + "'", url, status: res.status };
  }
  let text;
  try { text = await res.text(); }
  catch(e) { return { ok:false, code:"network", error:"could not read the response body: " + e.message, url }; }
  let parsed;
  try { parsed = JSON.parse(text); }
  catch(e) { return { ok:false, code:"malformed", error:"the file at '" + url + "' is not valid JSON: " + e.message, url }; }

  let cls = smbClassifyBundle(parsed);
  if(cls.status === "malformed") {
    return { ok:false, code:"malformed", error:"the file at '" + url + "' is not a valid bundle: " + cls.reason, url, bundle: parsed };
  }
  if(cls.status === "schema_gap") {
    let which = cls.newer
      ? "newer (v" + cls.declaredVersion + " vs this library's v" + cls.currentVersion + ") — update smb-integration"
      : "older (v" + cls.declaredVersion + " vs this library's v" + cls.currentVersion + ") — update the publishing tool";
    return {
      ok:false, code:"schema_gap",
      error:"bundle at '" + url + "' uses a " + which + " schema",
      url, bundleType: cls.bundleType, declaredVersion: cls.declaredVersion,
      currentVersion: cls.currentVersion, gap: cls.gap, newer: cls.newer, bundle: parsed
    };
  }

  // Valid bundle — compare freshness against what the reader already has.
  let bundle = parsed;
  let haveRec = null;
  if(opts.have && typeof opts.have === "object") {
    let src = (opts.have.bundle && typeof opts.have.bundle === "object") ? opts.have.bundle : opts.have;
    if(src && typeof src.exportedAt === "string" && src.exportedAt) {
      haveRec = {
        exportedAt: src.exportedAt,
        bundleType: src.bundleType || null,
        schemaVersion: (src.payload && src.payload.schemaVersion) || src.schemaVersion || null
      };
    }
  }
  let status = "fresh";
  let gap = null;
  let haveTime = haveRec ? Date.parse(haveRec.exportedAt) : NaN;
  let fetchTime = Date.parse(bundle.exportedAt);
  if(!Number.isNaN(haveTime) && !Number.isNaN(fetchTime)) {
    let delta = fetchTime - haveTime;
    if(delta === 0) status = "unchanged";
    else if(delta < 0) {
      status = "older";
      gap = { ms: -delta, human: smbBusAgeHuman(-delta) };
    }
  }
  return {
    ok: true,
    status,
    bundle,
    bundleType: bundle.bundleType,
    tool: bundle.tool,
    toolDisplayName: bundle.toolDisplayName,
    schemaVersion: bundle.payload ? bundle.payload.schemaVersion : null,
    envelopeSchemaVersion: bundle.schemaVersion,
    exportedAt: bundle.exportedAt,
    have: haveRec,
    gap,
    url,
    size: new TextEncoder().encode(text).length,
    fetchedAt: new Date().toISOString()
  };

// Self-tests for the bus read adapter — all network-free (a fake fetchImpl
// supplies canned responses; the real round-trip is exercised by the live
// "Pull" demo against an actual bundle on the bus).
async smbBusReadSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  let resp = (status, body) => ({ status, ok: status >= 200 && status < 300, text: async () => body });
  let okFetch = (body) => async () => resp(200, body);
  let failFetch = async () => { throw new Error("simulated network failure"); };

  let built = smbBuildEnvelope({
    bundleType: "idea", tool: "idea-incubator", toolDisplayName: "Idea Incubator",
    source: "ideas/idea-999.json", exportedAt: "2026-09-07T10:00:00.000Z",
    payload: { schemaVersion: 1, id: "idea-999", title: "Pulled idea", goals: ["g"], scope: ["s"], status: "ready" }
  });
  if(!built.ok) {
    return { ok:false, passCount:0, failCount:1, results:[{ name:"test bundle failed to build", pass:false }] };
  }
  let tBundle = built.bundle;
  let tText = JSON.stringify(tBundle);

  let r0 = await smbPullBundle({});
  t("missing url → invalid_opts", r0.ok === false && r0.code === "invalid_opts");
  let r0b = await smbPullBundle({ url: "ftp://example.com/x" });
  t("non-http url → invalid_opts", r0b.ok === false && r0b.code === "invalid_opts");

  let r404 = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/nope", fetchImpl: async () => resp(404, "nope") });
  t("404 → typed 404 failure", r404.ok === false && r404.code === "404");
  let rNet = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/x", fetchImpl: failFetch });
  t("network error → typed network failure", rNet.ok === false && rNet.code === "network");
  let r500 = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/x", fetchImpl: async () => resp(500, "boom") });
  t("http 500 → network failure with status", r500.ok === false && r500.code === "network" && r500.status === 500);

  let rBadJson = await smbPullBundle({ url: "https://editable.uploads.dev/file/x", fetchImpl: okFetch("not json {{{") });
  t("unparseable json → malformed", rBadJson.ok === false && rBadJson.code === "malformed");
  let rNotBundle = await smbPullBundle({ url: "https://editable.uploads.dev/file/x", fetchImpl: okFetch('{"foo": 1}') });
  t("json that is not a bundle → malformed", rNotBundle.ok === false && rNotBundle.code === "malformed");

  let gapBundle = { ...tBundle, payload: { ...tBundle.payload, schemaVersion: 2 } };
  let rGap = await smbPullBundle({ url: "https://editable.uploads.dev/file/x", fetchImpl: okFetch(JSON.stringify(gapBundle)) });
  t("newer schema version → schema_gap", rGap.ok === false && rGap.code === "schema_gap");
  t("schema_gap names both versions", rGap.declaredVersion === 2 && rGap.currentVersion === 1);

  let rFresh = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/idea", fetchImpl: okFetch(tText) });
  t("valid bundle with no local copy → fresh", rFresh.ok === true && rFresh.status === "fresh");
  t("fresh result carries parsed+validated bundle", !!rFresh.bundle && rFresh.bundle.bundleType === "idea" && rFresh.schemaVersion === 1);
  t("fresh result reports source tool", rFresh.tool === "idea-incubator");
  t("fresh result reports byte size", typeof rFresh.size === "number" && rFresh.size > 0);

  let rSame = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/idea", fetchImpl: okFetch(tText), have: { exportedAt: tBundle.exportedAt, bundleType: "idea" } });
  t("same exportedAt → unchanged", rSame.ok === true && rSame.status === "unchanged");

  let rNewer = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/idea", fetchImpl: okFetch(tText), have: { exportedAt: "2026-09-06T00:00:00.000Z" } });
  t("reader has older copy → fresh", rNewer.ok === true && rNewer.status === "fresh");

  let rOlder = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/idea", fetchImpl: okFetch(tText), have: { exportedAt: "2026-09-08T00:00:00.000Z" } });
  t("reader has newer copy → older with gap named", rOlder.ok === true && rOlder.status === "older" && !!rOlder.gap && typeof rOlder.gap.human === "string" && rOlder.gap.human.length > 0);

  let rHaveBundle = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/idea", fetchImpl: okFetch(tText), have: tBundle });
  t("have as full bundle object works (unchanged)", rHaveBundle.ok === true && rHaveBundle.status === "unchanged");
  let rHaveWrap = await smbPullBundle({ url: "https://editable.uploads.dev/file/smb-integration/idea", fetchImpl: okFetch(tText), have: { bundle: tBundle } });
  t("have as {bundle} wrapper works (unchanged)", rHaveWrap.ok === true && rHaveWrap.status === "unchanged");

  t("age humanization: 90s → 2 minutes", smbBusAgeHuman(90000) === "2 minutes");
  t("age humanization: 5 days", smbBusAgeHuman(5 * 24 * 3600 * 1000) === "5 days");

  let cls = smbClassifyBundle({ schemaVersion: 1, bundleType: "idea", tool: "t", toolDisplayName: "T", exportedAt: "2026-09-01T00:00:00.000Z", source: "s", payload: null });
  t("classify: payload null → malformed", cls.status === "malformed");
  t("classify: valid bundle → ok", smbClassifyBundle(tBundle).status === "ok");

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 10. SMB PIPELINE — END-TO-END BUS PROOF ───────────────
// This proof wires the write adapter (tool A) and the read adapter (tool B) into
// one round trip against real saved generators: tool A publishes a bundle,
// tool B (a different generator) pulls it, validates it, and displays its
// contents — before any business logic is built.
//
// A single page can only run one side at a time, so the round trip spans two
// generators:
//   tool A — this generator: publish a bundle via smbPublishBundle
//   tool B — any OTHER saved generator that imports this one and calls
//            smbPullBundle + smbValidateBundle (copy the Tool B snippet from
//            the page's End-to-end demo section into its index.html)
// The live proof on this page is: (1) the "Publish demo bundle" button (tool
// A's side, writes a real file), (2) the "Simulate Tool B" button (runs the
// exact pull + validate + display code tool B's page runs, against that REAL
// published file), and (3) smbE2ESelfTest — a network-free fixture loop that
// runs the whole A→B protocol end to end (two distinct tool stubs).

// Build the canonical E2E demo bundle (an `idea` exported by tool A).
smbE2EDemoBundle(opts) =>
  let tool = (opts && opts.tool) || (typeof window.generatorName === "string" && window.generatorName.trim()) || "smb-integration";
  return smbBuildEnvelope({
    bundleType: "idea",
    tool,
    toolDisplayName: "SMB Integration (framework)",
    source: "ideas/e2e-idea-demo.json",
    payload: {
      schemaVersion: 1,
      id: "e2e-idea-demo",
      title: "E2E bus proof — 'widget marketplace'",
      description: "A demo idea exported by tool A and consumed by tool B to prove the full round trip.",
      goals: ["Launch an MVP", "Get 10 paying users"],
      scope: ["Listings", "Checkout", "Reviews"],
      tags: ["demo", "e2e"],
      status: "ready",
      createdAt: new Date().toISOString()
    }
  });

// Network-free fixture test of the FULL protocol loop: a fake tool A publishes
// through a fake uploadPlugin (capturing the file exactly as the real bus
// would), a fake tool B pulls it back through a fake fetch, validates it, and
// displays the contents. Asserts the typed happy path (fresh → unchanged →
// fresh-on-republish) and every failure leg (404 / malformed / schema_gap).
// Run from the page via root.smbE2ESelfTest().
async smbE2ESelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });

  let a = smbE2EDemoBundle({ tool: "idea-incubator" });
  t("tool A's demo bundle builds", a.ok);
  if(!a.ok) {
    return { ok:false, passCount:0, failCount:1, results:[{ name:"tool A's demo bundle failed to build", pass:false, detail:a.error }] };
  }
  let aBundle = a.bundle;

  let captured = null;
  let fakeUpload = {
    editable: {
      async set(name, text, opts) {
        captured = { name, text, opts };
        return { editKey: "key-" + name, editCount: 1 };
      }
    }
  };
  let pub = await root.smbPublishBundle({ bundle: aBundle, toolStub: "idea-incubator", bundleName: "idea", uploadPlugin: fakeUpload, syncTracker: function(){ return { ok:true }; } });
  t("tool A publishes → ok, created, canonical URL", pub.ok && pub.created && pub.url === "https://editable.uploads.dev/file/idea-incubator/idea");
  t("the file on the wire is the exact envelope JSON", !!captured && captured.text === JSON.stringify(aBundle));
  t("tool A stores the edit key for later updates", root.smbBusGetEditKey("idea-incubator", "idea") === "key-idea");

  let fakeFetch = async (url) => ({ status: 200, ok: true, text: async () => captured.text });
  let pull = await root.smbPullBundle({ url: "https://editable.uploads.dev/file/idea-incubator/idea", fetchImpl: fakeFetch });
  t("tool B pulls tool A's file → fresh", pull.ok && pull.status === "fresh");
  t("tool B sees tool A's provenance", pull.tool === "idea-incubator" && pull.toolDisplayName === "SMB Integration (framework)");
  t("tool B's pulled bundle passes full validation", root.smbValidateBundle(pull.bundle).ok);
  t("tool B can read the payload contents", !!pull.bundle.payload.title && pull.bundle.payload.goals.length === 2 && pull.bundle.payload.scope.length === 3);

  let pull2 = await root.smbPullBundle({ url: "https://editable.uploads.dev/file/idea-incubator/idea", fetchImpl: fakeFetch, have: pull.bundle });
  t("tool B's second pull → unchanged", pull2.ok && pull2.status === "unchanged");

  let newer = { ...aBundle, exportedAt: new Date(Date.parse(aBundle.exportedAt) + 60000).toISOString() };
  let pull3 = await root.smbPullBundle({ url: "https://editable.uploads.dev/file/idea-incubator/idea", fetchImpl: async () => ({ status: 200, ok: true, text: async () => JSON.stringify(newer) }), have: pull.bundle });
  t("tool A republishes → tool B sees fresh update", pull3.ok && pull3.status === "fresh" && pull3.bundle.exportedAt === newer.exportedAt);

  let bad404 = await root.smbPullBundle({ url: "https://editable.uploads.dev/file/idea-incubator/idea", fetchImpl: async () => ({ status: 404, ok: false, text: async () => "nope" }) });
  t("tool B gets a typed 404 when A deletes the file", bad404.ok === false && bad404.code === "404");

  let malformed = await root.smbPullBundle({ url: "https://editable.uploads.dev/file/idea-incubator/idea", fetchImpl: async () => ({ status: 200, ok: true, text: async () => "not json" }) });
  t("tool B gets a typed malformed when A publishes junk", malformed.ok === false && malformed.code === "malformed");

  let gap = { ...aBundle, payload: { ...aBundle.payload, schemaVersion: 2 } };
  let gapPull = await root.smbPullBundle({ url: "https://editable.uploads.dev/file/idea-incubator/idea", fetchImpl: async () => ({ status: 200, ok: true, text: async () => JSON.stringify(gap) }) });
  t("tool B flags a schema-version gap (v2 vs v1)", gapPull.ok === false && gapPull.code === "schema_gap" && gapPull.declaredVersion === 2 && gapPull.currentVersion === 1);

  root.smbBusClearEditKey("idea-incubator", "idea");

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 11. SMB PIPELINE — CONNECTOR MODULE ────────────────────
// The drop-in client any future tool imports: configure(manifestUrl),
// publish(bundleType, payload), listUpstream(bundleType), pull(bundleName) —
// one consistent API over the manifest and the write/read adapters, so a new
// business tool gets bus access without reimplementing the protocol.
//
//   let bus = root.smbCreateConnector({ toolStub: "idea-incubator",
//                                       toolDisplayName: "Idea Incubator" });
//   await bus.configure(root.smbManifestUrl());
//   let pub  = await bus.publish("idea", { title: "...", goals: [...], scope: [...], status: "ready" });
//   let ups  = await bus.listUpstream("project");   // who publishes project bundles?
//   let pull = await bus.pull("project");           // latest upstream project bundle
//
// Every method returns the same typed results as the underlying adapters and
// never throws. A default singleton, root.smbConnector(), is auto-configured
// with the CURRENT generator as its tool stub.

smbCreateConnector(opts) =>
  opts = opts || {};
  let cfg = {
    toolStub: opts.toolStub || (typeof window.generatorName === "string" ? window.generatorName.trim() : "") || "",
    toolDisplayName: opts.toolDisplayName || "",
    manifestUrl: opts.manifestUrl || smbManifestUrl(),
    upstreams: opts.upstreams || {},   // bundleType → preferred publisher stub
    fetchImpl: opts.fetchImpl || null, // injectable for tests
    syncTracker: opts.syncTracker || null, // injectable freshness hook (default: the sync tracker's notePull)
    hub: opts.hub || null                 // optional live-hub client (see configureHub)
  };
  let manifest = opts.manifest || null;
  let manifestSource = manifest ? "object" : null;  // "object" | "url" | null
  let lastPulled = {};   // bundleName → last pulled bundle (in-memory freshness)

  function displayName() { return cfg.toolDisplayName || cfg.toolStub; }
  function configView() {
    return { toolStub: cfg.toolStub, toolDisplayName: displayName(), manifestUrl: cfg.manifestUrl, upstreams: Object.assign({}, cfg.upstreams) };
  }
  async function loadManifestFromUrl() {
    let r = await root.smbPullBundle({ url: cfg.manifestUrl, fetchImpl: cfg.fetchImpl });
    if (!r.ok) return { ok:false, code:r.code, error:r.error, url: cfg.manifestUrl };
    manifest = r.bundle.payload;
    manifestSource = "url";
    return { ok:true, manifest, source:"url", url: cfg.manifestUrl, fetchedAt: r.fetchedAt };
  }

  // configure(manifestUrl) / configure(manifestObject) / configure(configObject)
  // / configure() — point the connector at a manifest and load it. A URL string
  // fetches it from the bus; an object with a `tools` array is used as-is
  // (offline/tests); an object of config keys updates toolStub/displayName/
  // upstreams (and reloads the manifest if its URL changed); no argument
  // re-affirms the cached manifest or auto-loads the configured manifest URL.
  async function configure(next) {
    if (typeof next === "string" && next.trim()) {
      cfg.manifestUrl = next.trim();
      manifest = null; manifestSource = null;
      return await loadManifestFromUrl();
    }
    if (next && typeof next === "object" && !Array.isArray(next)) {
      if (Array.isArray(next.tools)) {
        manifest = next; manifestSource = "object";
        return { ok:true, manifest, source:"object", config: configView() };
      }
      if (next.toolStub !== undefined) cfg.toolStub = String(next.toolStub).trim();
      if (next.toolDisplayName !== undefined) cfg.toolDisplayName = String(next.toolDisplayName).trim();
      if (next.upstreams && typeof next.upstreams === "object") cfg.upstreams = Object.assign({}, cfg.upstreams, next.upstreams);
      let urlChanged = (typeof next.manifestUrl === "string" && next.manifestUrl.trim() && next.manifestUrl.trim() !== cfg.manifestUrl);
      if (urlChanged) {
        cfg.manifestUrl = next.manifestUrl.trim();
        manifest = null; manifestSource = null;
        return await loadManifestFromUrl();
      }
      return { ok:true, manifest, source: manifestSource, config: configView() };
    }
    if (manifest) return { ok:true, manifest, source: manifestSource, url: cfg.manifestUrl, config: configView() };
    return await loadManifestFromUrl();
  }

  // publish(bundleType, payload, opts) — validate the payload against its
  // schema, auto-fill schemaVersion, wrap it in an envelope for THIS tool, and
  // publish to the bus. opts: { name (bundle file name, default bundleType),
  // source, editKey, dryRun, uploadPlugin }. Returns the smbPublishBundle
  // typed result, with payload-validation errors folded in.
  async function publish(bundleType, payload, opts) {
    opts = opts || {};
    if (typeof bundleType !== "string" || !bundleType.trim()) {
      return { ok:false, code:"invalid_opts", error:"connector.publish: bundleType is required" };
    }
    if (!cfg.toolStub) {
      return { ok:false, code:"unsaved_generator", error:"connector.publish: this generator isn't named yet — save it first so it has a bus namespace ('<toolStub>/<bundleName>')" };
    }
    let fullPayload = (payload && typeof payload === "object" && !Array.isArray(payload) && payload.schemaVersion === undefined)
      ? Object.assign({}, payload, { schemaVersion: root.smbSchemaVersion(bundleType) })
      : payload;
    let pv = root.smbValidatePayload(bundleType, fullPayload);
    if (!pv.ok) {
      return { ok:false, code:"invalid_bundle", error:"payload failed validation: " + pv.errors.join("; "), errors:pv.errors, bundleType, schemaVersion:pv.schemaVersion };
    }
    let name = opts.name;
    if(!name) {
      try { name = root.smbWallet().activeName(cfg.toolStub, bundleType) || bundleType; }
      catch(e) { name = bundleType; }
    }
    let built = root.smbBuildEnvelope({
      bundleType, tool: cfg.toolStub, toolDisplayName: displayName(),
      source: opts.source || (bundleType + "/" + name + ".json"),
      payload: fullPayload
    });
    if (!built.ok) return { ok:false, code:"invalid_bundle", error:built.error, errors:built.errors };
    let warnings = [];
    if (manifest && !root.smbFindTool(manifest, cfg.toolStub)) {
      warnings.push("'" + cfg.toolStub + "' isn't registered in the manifest — register it (smbRegisterTool) and republish the manifest so upstream tools can discover it");
    }
    if (bundleType === "pipeline-manifest" && cfg.toolStub !== "smb-integration") {
      warnings.push("the canonical manifest lives at smb-integration/manifest (only the framework has its edit key) — this publishes a per-tool copy under '" + cfg.toolStub + "'; have the framework adopt your registration for upstream discovery to see it");
    }
    let res = await root.smbPublishBundle({
      bundle: built.bundle, toolStub: cfg.toolStub, bundleName: name,
      editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin,
      syncTracker: opts.syncTracker || cfg.syncTracker || undefined
    });
    if (res.ok && warnings.length) res.warnings = (res.warnings || []).concat(warnings);
    if (res.ok && cfg.hub && !opts.dryRun) {
      // Fire-and-forget: tell the hub this file's edit count moved so subscribed
      // tools learn within seconds. Never blocks the publish result or throws.
      try { cfg.hub.report({ tool: cfg.toolStub, bundleType, name, editCount: res.editCount || 0, at: new Date().toISOString() }).catch(() => {}); }
      catch(e) {}
    }
    return res;
  }

  // listUpstream(bundleType) — from the manifest, which tools publish this
  // bundle type, and the canonical URL to pull each from.
  async function listUpstream(bundleType) {
    if (typeof bundleType !== "string" || !bundleType.trim()) {
      return { ok:false, code:"invalid_opts", error:"connector.listUpstream: bundleType is required" };
    }
    if (!manifest) {
      let r = await configure();
      if (!r.ok) return { ok:false, code:"manifest_unavailable", error:"could not load the manifest at '" + cfg.manifestUrl + "': " + (r.error || r.code), manifestUrl: cfg.manifestUrl };
    }
    let stubs = root.smbManifestToolsPublishing(manifest, bundleType);
    let upstreams = stubs.map(stub => {
      let t = root.smbFindTool(manifest, stub);
      let active = (t && t.activeNames && t.activeNames[bundleType]) || bundleType;
      return {
        tool: stub,
        toolDisplayName: t ? t.displayName : stub,
        bundleType,
        name: active,
        schemaVersion: (t && t.schemaVersions && t.schemaVersions[bundleType]) || root.smbSchemaVersion(bundleType),
        url: root.smbBusUrl(stub, active)
      };
    });
    return { ok:true, bundleType, upstreams, count: upstreams.length };
  }

  // pull(bundleName, opts) — fetch the latest bundle by name. The URL resolves
  // from opts.url, else opts.from (upstream tool stub), else cfg.upstreams[name],
  // else the manifest's publisher of that name (prefer opts.prefer). 'have' falls
  // back to the last bundle this connector pulled, so repeated pulls report
  // unchanged without the caller tracking state. Returns the smbPullBundle typed
  // result.
  async function pull(bundleName, opts) {
    opts = opts || {};
    if (typeof bundleName !== "string" || !bundleName.trim()) {
      return { ok:false, code:"invalid_opts", error:"connector.pull: bundleName is required" };
    }
    let url = opts.url || null;
    let have = (opts.have !== undefined) ? opts.have : (lastPulled[bundleName] || null);
    if (!url) {
      let from = opts.from || cfg.upstreams[bundleName] || null;
      if (from) {
        url = root.smbBusUrl(from, bundleName);
      } else {
        if (!manifest) {
          let r = await configure();
          if (!r.ok) return { ok:false, code:"manifest_unavailable", error:"could not load the manifest at '" + cfg.manifestUrl + "': " + (r.error || r.code), manifestUrl: cfg.manifestUrl };
        }
        let stubs = root.smbManifestToolsPublishing(manifest, bundleName);
        if (stubs.length === 0) {
          return { ok:false, code:"no_upstream", error:"no tool in the manifest publishes a '" + bundleName + "' bundle — nothing to pull. Check the manifest or use pull(name, { from: <toolStub> }).", bundleName };
        }
        let chosen = (opts.prefer && stubs.includes(opts.prefer)) ? opts.prefer : stubs[0];
        let t = root.smbFindTool(manifest, chosen);
        let active = (t && t.activeNames && t.activeNames[bundleName]) || bundleName;
        url = root.smbBusUrl(chosen, active);
      }
    }
    let res = await root.smbPullBundle({ url, have, fetchImpl: opts.fetchImpl || cfg.fetchImpl });
    if (res.ok) {
      lastPulled[bundleName] = res.bundle;
      try {
        let st = (typeof cfg.syncTracker === "function") ? cfg.syncTracker : smbSyncNotePull;
        st(cfg.toolStub, bundleName, res);
      } catch(e) {}
    }
    return res;
  }

  function getManifest() { return manifest; }

  // configureHub(hubClient) — point this connector at a live hub client (e.g.
  // root.smbHubIndex()). After every successful publish the connector then
  // auto-reports the new edit count to the hub (fire-and-forget — never blocks
  // the publish result, never throws), so the hub's index stays fresh without
  // extra tool code. The dashboard (§35) reads that index for true
  // cross-device last-published times.
  function configureHub(hubClient) {
    if(hubClient && typeof hubClient.report === "function") {
      cfg.hub = hubClient;
      return { ok:true, configured:true, mode: hubClient.kind || "hub" };
    }
    return { ok:false, code:"invalid_hub", error:"configureHub expects a hub client with a report({tool,bundleType,name,editCount,at}) method — e.g. root.smbHubIndex()" };
  }

  // hubReport(bundleType, name, editCount, opts) — explicitly report a publish
  // to the hub (the connector auto-reports on publish, so this is only needed
  // for publishes that happened before configureHub, or manual bookkeeping).
  async function hubReport(bundleType, name, editCount, opts) {
    if(!cfg.hub) {
      return { ok:false, code:"hub_unconfigured", error:"no hub configured — call bus.configureHub(root.smbHubIndex()) so the hub index stays fresh; without it the dashboard falls back to local freshness timestamps" };
    }
    if(!smbBusValidName(cfg.toolStub) || !smbBusValidName(bundleType) || !smbBusValidName(name)) {
      return { ok:false, code:"invalid_opts", error:"connector.hubReport needs a valid toolStub, bundleType and bundle name" };
    }
    let p = { tool: cfg.toolStub, bundleType, name, editCount: (typeof editCount === "number") ? editCount : 0, at: (opts && opts.at) || new Date().toISOString() };
    try { return await cfg.hub.report(p); }
    catch(e) { return { ok:false, code:"error", error:String((e && e.message) || e) }; }
  }

  return { configure, publish, listUpstream, pull, getManifest, config: configView, configureHub, hubReport };

// Default singleton — one connector per tool, auto-stubbed to the current
// generator, lazily created so importing tools share a single configured bus.
smbConnector() =>
  if (!window.SMB_CONNECTOR) window.SMB_CONNECTOR = smbCreateConnector({});
  return window.SMB_CONNECTOR;

// Self-tests for the connector — a network-free two-tool world (tool A =
// idea-incubator publishes, tool B = project-master pulls) plus config/error
// legs. Run from the page via root.smbConnectorSelfTest().
async smbConnectorSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });

  let manifestObj = { schemaVersion: 1, tools: [] };
  manifestObj = root.smbRegisterTool(manifestObj, { stub: "idea-incubator", displayName: "Idea Incubator", publishes: ["idea"], consumes: ["project"] });
  manifestObj = root.smbRegisterTool(manifestObj, { stub: "project-master", displayName: "Project Master", publishes: ["project", "milestone-event"], consumes: ["idea", "payment-receipt"] });
  manifestObj = root.smbRegisterTool(manifestObj, { stub: "the-ledger", displayName: "The Ledger", publishes: ["invoice", "payment-receipt"], consumes: ["milestone-event"] });

  let a = root.smbCreateConnector({ toolStub: "idea-incubator", toolDisplayName: "Idea Incubator", syncTracker: function(){ return { ok:true }; } });
  let c1 = await a.configure(manifestObj);
  t("configure with a manifest object works", c1.ok && c1.source === "object");
  t("configure caches the manifest", a.getManifest() === manifestObj);
  let cRe = await a.configure();
  t("configure() re-affirms the cached manifest", cRe.ok && cRe.manifest === manifestObj);

  let captured = null;
  let fakeUpload = { editable: { async set(name, text, opts) { captured = { name, text, opts }; return { editKey: "k-" + name, editCount: 1 }; } } };

  let pub = await a.publish("idea", { id: "idea-1", title: "Connector idea", goals: ["g"], scope: ["s"], status: "ready" }, { uploadPlugin: fakeUpload });
  t("publish validates + wraps + publishes", pub.ok && pub.created && pub.url === "https://editable.uploads.dev/file/idea-incubator/idea");
  t("publish auto-fills schemaVersion into the payload", !!captured && JSON.parse(captured.text).payload.schemaVersion === 1);
  let ideaText = captured.text;

  let pubName = await a.publish("idea", { id: "i2", title: "T", goals: ["g"], scope: ["s"], status: "draft" }, { name: "idea-i2", editKey: "explicit", uploadPlugin: fakeUpload });
  t("publish honours an explicit bundle name + forwards the edit key", pubName.ok && pubName.bundleName === "idea-i2" && captured.name === "idea-i2" && captured.opts && captured.opts.editKey === "explicit");

  let pubDry = await a.publish("idea", { id: "d", title: "D", goals: ["g"], scope: ["s"], status: "draft" }, { dryRun: true, uploadPlugin: fakeUpload });
  t("publish supports dry-run (no network)", pubDry.ok && pubDry.dryRun === true);

  let pubBad = await a.publish("idea", { id: "x", goals: [] }, { uploadPlugin: fakeUpload });
  t("publish rejects a payload missing required fields", pubBad.ok === false && pubBad.code === "invalid_bundle");
  let pubNoType = await a.publish("", {}, { uploadPlugin: fakeUpload });
  t("publish rejects a missing bundleType", pubNoType.ok === false && pubNoType.code === "invalid_opts");

  let pubManifest = await a.publish("pipeline-manifest", manifestObj, { uploadPlugin: fakeUpload });
  t("non-framework tool publishing a manifest gets the adoption warning", Array.isArray(pubManifest.warnings) && pubManifest.warnings.some(w => w.includes("canonical")));

  let z = root.smbCreateConnector({ toolStub: "rogue-tool", syncTracker: function(){ return { ok:true }; } });
  await z.configure(manifestObj);
  let pubRogue = await z.publish("idea", { id: "r", title: "R", goals: ["g"], scope: ["s"], status: "draft" }, { uploadPlugin: fakeUpload });
  t("publish warns when the tool isn't registered in the manifest", Array.isArray(pubRogue.warnings) && pubRogue.warnings.some(w => w.includes("isn't registered")));

  let ups = await a.listUpstream("project");
  t("listUpstream discovers project-master as publisher", ups.ok && ups.count === 1 && ups.upstreams[0].tool === "project-master");
  t("listUpstream reports the canonical pull URL", ups.ok && ups.upstreams[0].url === "https://editable.uploads.dev/file/project-master/project");
  let upsNone = await a.listUpstream("mystery");
  t("listUpstream with unknown type → empty but ok", upsNone.ok && upsNone.count === 0);
  let upsBad = await a.listUpstream("");
  t("listUpstream rejects a missing bundleType", upsBad.ok === false && upsBad.code === "invalid_opts");

  let b = root.smbCreateConnector({ toolStub: "project-master", toolDisplayName: "Project Master", upstreams: { idea: "idea-incubator" }, syncTracker: function(){ return { ok:true }; } });
  await b.configure(manifestObj);
  let fakeFetch = async (url) => ({ status: 200, ok: true, text: async () => ideaText });
  let pull1 = await b.pull("idea", { fetchImpl: fakeFetch });
  t("pull resolves the upstream from config and pulls fresh", pull1.ok && pull1.status === "fresh" && pull1.bundle.payload.title === "Connector idea");
  t("pull returns a fully validated bundle", root.smbValidateBundle(pull1.bundle).ok);
  let pull2 = await b.pull("idea", { fetchImpl: fakeFetch });
  t("second pull uses the in-memory cache → unchanged", pull2.ok && pull2.status === "unchanged");
  let pull404 = await b.pull("project", { fetchImpl: async () => ({ status: 404, ok: false, text: async () => "x" }) });
  t("pull from a tool that never published → typed 404", pull404.ok === false && pull404.code === "404");

  let c = root.smbCreateConnector({ toolStub: "the-ledger", toolDisplayName: "The Ledger" });
  await c.configure(manifestObj);
  let pullNone = await c.pull("timesheet");
  t("pull with no publisher → typed no_upstream (no network)", pullNone.ok === false && pullNone.code === "no_upstream");

  let env = root.smbBuildEnvelope({ bundleType: "pipeline-manifest", tool: "smb-integration", toolDisplayName: "SMB Integration (framework)", source: "manifest/manifest.json", payload: manifestObj });
  let manText = JSON.stringify(env.bundle);
  let e = root.smbCreateConnector({ toolStub: "idea-incubator", manifestUrl: "https://editable.uploads.dev/file/smb-integration/manifest", fetchImpl: async (url) => ({ status: 200, ok: true, text: async () => manText }) });
  let ce2 = await e.configure("https://editable.uploads.dev/file/smb-integration/manifest");
  t("configure with a manifest URL loads it over the bus", ce2.ok && ce2.source === "url" && root.smbValidateManifest(ce2.manifest).ok);
  let upsE = await e.listUpstream("project");
  t("listUpstream works after a URL-configure", upsE.ok && upsE.upstreams.some(u => u.tool === "project-master"));

  let d = root.smbCreateConnector({ toolStub: "x", manifestUrl: "https://editable.uploads.dev/file/nope/manifest", fetchImpl: async () => ({ status: 404, ok: false, text: async () => "x" }) });
  let cFail = await d.configure();
  t("configure() with an unreachable manifest URL → typed failure", cFail.ok === false && (cFail.code === "404" || cFail.code === "network"));
  let upsFail = await d.listUpstream("idea");
  t("listUpstream with an unreachable manifest → manifest_unavailable", upsFail.ok === false && upsFail.code === "manifest_unavailable");

  let s1 = root.smbConnector();
  let s2 = root.smbConnector();
  t("smbConnector() returns a stable singleton", s1 === s2);
  t("singleton auto-stubs to the current generator", s1.config().toolStub === (window.generatorName || ""));

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 12. SMB PIPELINE — EDIT-KEY WALLET ────────────────────
// The wallet is each device's keychain for the whole pipeline: it persists
// every tool's editable-file edit keys (with a documented layout), loads them
// on startup, detects when they're missing (new device / cleared storage) and
// offers a guided recovery — a fresh bundle namespace re-registered in the
// manifest, with previously published bundles still readable under the old
// names.
//
// ── Storage layout (all in localStorage) ────────────────────────────────────
//   smb:editkey:<toolStub>:<bundleName>     the edit key string for that bus
//                                           file — the LOW-LEVEL source of
//                                           truth (§8); smbPublishBundle
//                                           reads it directly for updates
//   smb:editcount:<toolStub>:<bundleName>   local edit-count ledger (§8)
//   smb:wallet:tool:<toolStub>              per-tool wallet record (JSON):
//                                           { version, toolStub, displayName,
//                                             createdAt, updatedAt,
//                                             activeNames:{<type>:<name>},
//                                             legacyNames:{<type>:[<old>...]},
//                                             bundles:{<name>:{firstSeenAt,
//                                                       lastSeenAt, editCount}} }
//   smb:wallet:meta                         { version, deviceId, createdAt, updatedAt }
//   smb:wallet:recovery:<toolStub>          log of a completed recovery
//                                           { version, recoveredAt, token,
//                                             oldActiveNames, newActiveNames }
//
// The index deliberately stores NO key values — the flat smb:editkey:* store
// stays the single source of truth for key strings. The index records what was
// published where and when, so a fresh device can tell which keys it is
// missing, and activeNames/legacyNames carry the namespace state across
// recoveries. load() reconciles the index from the flat store on every access
// ("load on startup"), so keys written by the publish path always appear.
//
//   let wallet = root.smbWallet();   // lazy singleton, auto-loads
//   wallet.save("idea-incubator", "idea", "k-abc", { editCount: 1 });
//   let st = wallet.status({ manifest, toolStub: "idea-incubator" });
//   //   → { state:"ok"|"clean"|"empty"|"partial"|"recovered",
//   //       expected:[...], present:[...], missing:[...], legacy:[...], reason }
//   let d = await wallet.detectLoss({ manifest, toolStub: "idea-incubator" });
//   //   → { lost:true, confirmed:[{name,url,exportedAt}], reason }
//   let plan = wallet.recoveryPlan({ toolStub: "idea-incubator", manifest });
//   wallet.applyRecovery(plan);   // adopt the fresh namespace locally
//   // then re-register the tool in the manifest (smbRegisterTool with
//   // activeNames) so upstream discovery follows the fresh files.

smbWalletMetaKey = ["smb:wallet:meta"]
smbWalletToolKeyPrefix = ["smb:wallet:tool:"]
smbWalletRecoveryKeyPrefix = ["smb:wallet:recovery:"]

smbWalletKeyName(toolStub) =>
  return smbWalletToolKeyPrefix + toolStub;

smbWalletRecoveryKeyName(toolStub) =>
  return smbWalletRecoveryKeyPrefix + toolStub;

// Build a wallet. opts.store can inject an in-memory store for tests; the
// default is the real localStorage. Never throws. Returns a plain object of
// methods — see the header comment for usage.
smbCreateWallet(opts) =>
  opts = opts || {};
  let store = opts.store || {
    get: smbBusStoreGet,
    set: smbBusStoreSet,
    remove: smbBusStoreRemove,
    keys: () => { try { let out = []; for(let i = 0; i < window.localStorage.length; i++) { let k = window.localStorage.key(i); if(k) out.push(k); } return out; } catch(e) { return []; } }
  };

  function nowIso() { return new Date().toISOString(); }
  function randomToken(n) {
    let chars = "0123456789abcdef", out = "";
    for(let i = 0; i < n; i++) out += chars[Math.floor(Math.random() * 16)];
    return out;
  }
  function storeKeys() { try { return typeof store.keys === "function" ? store.keys() : []; } catch(e) { return []; } }
  function keysWithPrefix(prefix) { return storeKeys().filter(k => k.indexOf(prefix) === 0); }
  function jsonGet(key, fallback) {
    let raw = store.get(key);
    if(typeof raw !== "string" || !raw) return fallback;
    try { return JSON.parse(raw); } catch(e) { return fallback; }
  }
  function jsonSet(key, val) { try { store.set(key, JSON.stringify(val)); return true; } catch(e) { return false; } }

  function keyGet(tool, name) { let v = store.get(smbBusKeyName(tool, name)); return (typeof v === "string" && v) ? v : null; }
  function keyHas(tool, name) { return keyGet(tool, name) !== null; }

  function readMeta() { return jsonGet(smbWalletMetaKey, null) || { version: 1, deviceId: null, createdAt: null, updatedAt: null }; }
  function writeMeta(m) { m.version = 1; m.updatedAt = nowIso(); jsonSet(smbWalletMetaKey, m); }
  function deviceId() {
    let m = readMeta();
    if(!m.deviceId) { m.deviceId = randomToken(8); m.createdAt = m.createdAt || nowIso(); writeMeta(m); }
    return m.deviceId;
  }
  function newIndex(tool) {
    let now = nowIso();
    return { version: 1, toolStub: tool, displayName: "", createdAt: now, updatedAt: now, activeNames: {}, legacyNames: {}, bundles: {} };
  }
  function readIndex(tool) {
    let r = jsonGet(smbWalletKeyName(tool), null);
    return (r && typeof r === "object" && !Array.isArray(r)) ? r : null;
  }
  function writeIndex(tool, rec) {
    rec.version = 1; rec.toolStub = tool; rec.updatedAt = nowIso();
    jsonSet(smbWalletKeyName(tool), rec);
  }
  function readRecovery(tool) { return jsonGet(smbWalletRecoveryKeyName(tool), null); }
  function writeRecovery(tool, rec) { rec.version = 1; rec.toolStub = tool; rec.recoveredAt = nowIso(); jsonSet(smbWalletRecoveryKeyName(tool), rec); }
  function indexTools() { return keysWithPrefix(smbWalletToolKeyPrefix).map(k => k.slice(smbWalletToolKeyPrefix.length)); }
  function recoveryTools() { return keysWithPrefix(smbWalletRecoveryKeyPrefix).map(k => k.slice(smbWalletRecoveryKeyPrefix.length)); }

  // "Load on startup" — reconcile the index from the flat edit-key store, so
  // keys written by the publish path (or a previous session) always show up.
  function load() {
    let found = {};
    for(let k of keysWithPrefix(smbBusKeyPrefix)) {
      let rest = k.slice(smbBusKeyPrefix.length);
      let i = rest.lastIndexOf(":");
      if(i <= 0 || i === rest.length - 1) continue;
      let tool = rest.slice(0, i), name = rest.slice(i + 1);
      if(!found[tool]) found[tool] = {};
      found[tool][name] = true;
    }
    let now = nowIso();
    for(let tool of Object.keys(found)) {
      let idx = readIndex(tool) || newIndex(tool);
      let changed = false;
      for(let name of Object.keys(found[tool])) {
        if(!idx.bundles[name]) { idx.bundles[name] = { firstSeenAt: now, lastSeenAt: now }; changed = true; }
      }
      for(let name of Object.keys(idx.bundles)) {
        if(!found[tool][name]) { delete idx.bundles[name]; changed = true; }
      }
      if(changed) writeIndex(tool, idx);
    }
    for(let tool of indexTools()) {
      if(!found[tool]) {
        let idx = readIndex(tool);
        let hasState = idx && (Object.keys(idx.activeNames || {}).length > 0 || Object.keys(idx.legacyNames || {}).length > 0 || readRecovery(tool));
        if(!hasState) store.remove(smbWalletKeyName(tool));
      }
    }
    return null;
  }

  // Persist one edit key: write the flat store (source of truth) AND update
  // the tool's wallet index (provenance + edit count). opts: { editCount, displayName }.
  function save(tool, name, editKey, opts) {
    opts = opts || {};
    if(!smbBusValidName(tool) || !smbBusValidName(name) || typeof editKey !== "string" || !editKey) {
      return { ok:false, code:"invalid_opts", error:"wallet.save needs a valid toolStub, bundleName and a non-empty edit key string" };
    }
    if(store.set(smbBusKeyName(tool, name), editKey) !== true) {
      return { ok:false, code:"store_failed", error:"could not write the edit key to local storage" };
    }
    let idx = readIndex(tool) || newIndex(tool);
    if(opts.displayName) idx.displayName = String(opts.displayName).trim();
    let now = nowIso();
    let b = idx.bundles[name] || {};
    if(!b.firstSeenAt) b.firstSeenAt = now;
    b.lastSeenAt = now;
    if(typeof opts.editCount === "number") b.editCount = opts.editCount;
    idx.bundles[name] = b;
    writeIndex(tool, idx);
    return { ok:true, toolStub:tool, bundleName:name, editKey, firstSeenAt:b.firstSeenAt, lastSeenAt:now, editCount:b.editCount };
  }

  // The hook smbPublishBundle calls after every successful create/update, so
  // published files land in the wallet automatically. Never throws.
  function noteEditKey(tool, name, editKey, editCount) {
    try { return save(tool, name, editKey, { editCount }); }
    catch(e) { return { ok:false, code:"error", error:e.message }; }
  }

  function get(tool, name) { return keyGet(tool, name); }
  function has(tool, name) { return keyHas(tool, name); }
  function remove(tool, name) {
    store.remove(smbBusKeyName(tool, name));
    store.remove(smbBusCountKeyName(tool, name));
    let idx = readIndex(tool);
    if(idx && idx.bundles) { delete idx.bundles[name]; writeIndex(tool, idx); }
    return { ok:true, toolStub:tool, bundleName:name };
  }
  function purgeTool(tool) {
    for(let k of keysWithPrefix(smbBusKeyPrefix)) {
      let rest = k.slice(smbBusKeyPrefix.length);
      let i = rest.lastIndexOf(":");
      if(i > 0 && rest.slice(0, i) === tool) store.remove(k);
    }
    for(let k of keysWithPrefix("smb:editcount:")) {
      let rest = k.slice("smb:editcount:".length);
      let i = rest.lastIndexOf(":");
      if(i > 0 && rest.slice(0, i) === tool) store.remove(k);
    }
    store.remove(smbWalletKeyName(tool));
    return { ok:true, toolStub:tool };
  }

  // Every key currently held, merged from the flat store + index, with
  // active/legacy/recovered flags. The canonical "what does this device hold".
  function list() {
    load();
    let out = [];
    for(let k of keysWithPrefix(smbBusKeyPrefix)) {
      let rest = k.slice(smbBusKeyPrefix.length);
      let i = rest.lastIndexOf(":");
      if(i <= 0 || i === rest.length - 1) continue;
      let tool = rest.slice(0, i), name = rest.slice(i + 1);
      let idx = readIndex(tool);
      let b = (idx && idx.bundles) ? idx.bundles[name] : null;
      let active = false, legacy = false;
      if(idx) {
        for(let bt of Object.keys(idx.activeNames || {})) { if(idx.activeNames[bt] === name) active = true; }
        for(let bt of Object.keys(idx.legacyNames || {})) { if((idx.legacyNames[bt] || []).includes(name)) legacy = true; }
      }
      out.push({ toolStub:tool, bundleName:name, editKey:keyGet(tool, name), editCount:b ? b.editCount : null, firstSeenAt:b ? b.firstSeenAt : null, lastSeenAt:b ? b.lastSeenAt : null, active, legacy, recovered:!!readRecovery(tool) });
    }
    out.sort((a, b) => (a.toolStub + ":" + a.bundleName < b.toolStub + ":" + b.bundleName) ? -1 : 1);
    return out;
  }
  function listTools() {
    load();
    let map = {};
    for(let e of list()) {
      let x = map[e.toolStub] || (map[e.toolStub] = { toolStub:e.toolStub, bundleCount:0, displayName:"", firstSeenAt:null, lastSeenAt:null, recovered:false });
      x.bundleCount++;
      if(e.firstSeenAt && (!x.firstSeenAt || e.firstSeenAt < x.firstSeenAt)) x.firstSeenAt = e.firstSeenAt;
      if(e.lastSeenAt && e.lastSeenAt > (x.lastSeenAt || "")) x.lastSeenAt = e.lastSeenAt;
      if(e.recovered) x.recovered = true;
    }
    for(let tool of indexTools()) {
      let idx = readIndex(tool);
      let x = map[tool];
      if(!x) {
        map[tool] = { toolStub:tool, bundleCount:0, displayName:(idx && idx.displayName) || "", firstSeenAt:idx ? idx.createdAt : null, lastSeenAt:idx ? idx.updatedAt : null, recovered:!!readRecovery(tool) };
      } else {
        if(idx && idx.displayName) x.displayName = idx.displayName;
        if(readRecovery(tool)) x.recovered = true;
      }
    }
    return Object.values(map).sort((a, b) => (a.toolStub < b.toolStub) ? -1 : 1);
  }

  // The CURRENT bundle file name for a tool's published type — defaults to the
  // type itself unless a recovery (or setActiveName) moved it to a fresh name.
  function activeName(tool, bundleType) {
    let idx = readIndex(tool);
    if(idx && idx.activeNames && idx.activeNames[bundleType]) return idx.activeNames[bundleType];
    return bundleType;
  }
  function setActiveName(tool, bundleType, name) {
    if(!smbBusValidName(tool) || !smbBusValidName(name)) return { ok:false, code:"invalid_name", error:"setActiveName needs a valid toolStub and bundle name" };
    let idx = readIndex(tool) || newIndex(tool);
    if(!idx.activeNames) idx.activeNames = {};
    idx.activeNames[bundleType] = name;
    writeIndex(tool, idx);
    return { ok:true, toolStub:tool, bundleType, name };
  }

  // Classify this device's key state for a tool. Expected names = the bundle
  // files the tool owns (manifest publishes mapped through activeNames, or the
  // wallet index's known bundles). Never throws, never hits the network.
  function status(opts) {
    opts = opts || {};
    load();
    let tool = opts.toolStub;
    if(!tool) return { state:"clean", reason:"no toolStub given — pass { toolStub, manifest? }", expected:[], present:[], missing:[], legacy:[], recovered:false };
    let idx = readIndex(tool);
    let manEntry = (opts.manifest && smbFindTool(opts.manifest, tool)) || null;
    let rec = readRecovery(tool);
    let types = [], manActive = {};
    if(manEntry) {
      types = (manEntry.publishes || []).slice();
      manActive = (manEntry.activeNames && typeof manEntry.activeNames === "object") ? manEntry.activeNames : {};
    }
    if(types.length === 0 && idx && idx.bundles) types = Object.keys(idx.bundles);
    let seen = {}, expected = [];
    for(let bt of types) {
      let name = (idx && idx.activeNames && idx.activeNames[bt]) || manActive[bt] || bt;
      if(seen[name]) continue;
      seen[name] = true;
      expected.push({ bundleType:bt, name });
    }
    let present = [], missing = [];
    for(let e of expected) { if(keyHas(tool, e.name)) present.push(e); else missing.push(e); }
    let legacy = [];
    if(idx && idx.legacyNames) {
      for(let bt of Object.keys(idx.legacyNames)) {
        for(let nm of (idx.legacyNames[bt] || [])) legacy.push({ bundleType:bt, name:nm, url:smbBusUrl(tool, nm) });
      }
    }
    let recovered = !!rec;
    let state, reason;
    if(recovered) {
      let missingActive = missing.filter(e => !legacy.some(l => l.name === e.name));
      if(missingActive.length === 0 && present.length > 0) { state = "ok"; reason = "all active bundles are keyed on this device (post-recovery)"; }
      else if(present.length > 0) { state = "partial"; reason = "post-recovery: some active bundles still need their first publish on this device"; }
      else { state = "recovered"; reason = "this device already recovered this tool's namespace — the fresh bundle names are ready for a first publish (creating a new file needs no edit key)"; }
    } else if(expected.length === 0) {
      state = "clean"; reason = "no bundles are expected for this tool on this device";
    } else if(missing.length === 0) {
      state = "ok"; reason = "every expected bundle has its edit key on this device";
    } else if(present.length === 0) {
      state = "empty"; reason = "expected bundles exist but none of their edit keys are on this device — you're likely on a new device or storage was cleared (run detectLoss to confirm, then follow the recovery plan)";
    } else {
      state = "partial"; reason = "some expected bundles are missing their edit keys on this device";
    }
    return { state, reason, expected:expected.map(e => e.name), present:present.map(e => e.name), missing:missing.map(e => e.name), legacy, recovered };
  }

  // Confirm a suspected loss against upstream: for each expected name WITHOUT a
  // local key, fetch the public URL. 200 → the file exists but can't be
  // updated from here (lost); 404 → never published (nothing lost). opts:
  // { manifest, toolStub, fetchImpl (injectable for tests) }.
  async function detectLoss(opts) {
    opts = opts || {};
    let st = status(opts);
    if(st.state === "ok" || st.state === "recovered") {
      return { ok:true, lost:false, state:st.state, reason:"no loss to detect — " + st.reason, confirmed:[], unconfirmed:[] };
    }
    let tool = opts.toolStub;
    let fetchImpl = opts.fetchImpl || null;
    let confirmed = [], unconfirmed = [];
    for(let name of st.expected) {
      if(keyHas(tool, name)) continue;
      let r = await root.smbPullBundle({ url:smbBusUrl(tool, name), fetchImpl });
      if(r.ok) confirmed.push({ name, url:smbBusUrl(tool, name), exportedAt:r.exportedAt, status:r.status });
      else if(r.code === "404") { /* never published — nothing lost */ }
      else unconfirmed.push({ name, url:smbBusUrl(tool, name), code:r.code, error:r.error });
    }
    let lost = confirmed.length > 0;
    let reason = lost
      ? "found " + confirmed.length + " published bundle(s) whose edit keys are missing on this device — the files exist upstream but can no longer be updated from here; run recoveryPlan() to start a fresh namespace"
      : (unconfirmed.length ? "could not verify against upstream (" + unconfirmed.map(u => u.name + " → " + u.code).join(", ") + ") — try again when online" : "no published bundles found upstream — this tool simply hasn't published yet, so nothing is lost");
    return { ok:true, lost, state:st.state, reason, confirmed, unconfirmed };
  }

  // A token that is unique per device AND per recovery event, so two losses on
  // the same device still produce distinct fresh names. e.g. "a1b2-m4n5-x7y8".
  function recoveryToken() {
    let d = deviceId();
    let t = Date.now().toString(36).slice(-4);
    let r = randomToken(4);
    return d.slice(0, 4) + "-" + t + "-" + r;
  }

  // The guided recovery plan: fresh bundle name per published type (a new file
  // needs no edit key), a re-register-in-manifest step (activeNames), and the
  // old bundles kept readable. Pure — no writes, no network.
  function recoveryPlan(opts) {
    opts = opts || {};
    let tool = opts.toolStub;
    if(!tool) return { ok:false, code:"invalid_opts", error:"recoveryPlan needs { toolStub }" };
    let manEntry = (opts.manifest && smbFindTool(opts.manifest, tool)) || null;
    let idx = readIndex(tool);
    let types = (opts.bundleTypes && opts.bundleTypes.length) ? opts.bundleTypes
      : ((manEntry && manEntry.publishes) || (idx && Object.keys(idx.bundles || {})) || []);
    if(types.length === 0) return { ok:false, code:"nothing_to_recover", error:"this tool has no published bundle types to recover" };
    let token = recoveryToken();
    let newNames = {}, oldNames = {}, keepsReadable = [];
    for(let bt of types) {
      let old = activeName(tool, bt);
      let fresh = bt + "-" + token;
      newNames[bt] = fresh;
      oldNames[bt] = old;
      keepsReadable.push({ bundleType:bt, name:old, url:smbBusUrl(tool, old) });
    }
    let display = (manEntry && manEntry.displayName) || opts.displayName || tool;
    let steps = [
      { step:"create-fresh-namespace", detail:"publish each bundle type under a fresh name (a new file needs no edit key): " + types.map(bt => bt + " → " + newNames[bt]).join(", ") },
      { step:"re-register-in-manifest", detail:"register '" + tool + "' in the pipeline manifest with activeNames = " + JSON.stringify(newNames) + " so upstream tools discover the fresh files (smbRegisterTool with activeNames; the framework adopts the registration and republishes the manifest)" },
      { step:"keep-old-readable", detail:"previously published bundles stay publicly readable under the old names — archived, read-only: " + keepsReadable.map(k => k.url).join(", ") }
    ];
    return { ok:true, action:"recover", toolStub:tool, displayName:display, token, newNames, oldNames, keepsReadable, steps, manifestChange:{ stub:tool, displayName:display, activeNames:newNames, legacyNames:oldNames } };
  }

  // Adopt a recovery plan locally: record the fresh active names, archive the
  // old names as legacy (still readable), and log the recovery so status()
  // reports "recovered" instead of "empty" on this device. Local only — the
  // manifest re-registration is a follow-up publish by the framework.
  function applyRecovery(plan) {
    if(!plan || !plan.ok || plan.action !== "recover") return { ok:false, code:"invalid_plan", error:"applyRecovery needs a plan returned by recoveryPlan()" };
    let tool = plan.toolStub;
    let idx = readIndex(tool) || newIndex(tool);
    if(plan.displayName) idx.displayName = plan.displayName;
    idx.activeNames = Object.assign({}, idx.activeNames || {}, plan.newNames);
    if(!idx.legacyNames) idx.legacyNames = {};
    for(let bt of Object.keys(plan.oldNames || {})) {
      let old = plan.oldNames[bt];
      if(!old || old === plan.newNames[bt]) continue;
      if(!Array.isArray(idx.legacyNames[bt])) idx.legacyNames[bt] = [];
      if(!idx.legacyNames[bt].includes(old)) idx.legacyNames[bt].push(old);
    }
    writeIndex(tool, idx);
    writeRecovery(tool, { oldActiveNames:Object.assign({}, plan.oldNames), newActiveNames:Object.assign({}, plan.newNames), token:plan.token });
    return { ok:true, toolStub:tool, activeNames:Object.assign({}, idx.activeNames), legacyNames:JSON.parse(JSON.stringify(idx.legacyNames || {})), summary:"adopted fresh namespace " + Object.keys(plan.newNames).map(bt => bt + " → " + plan.newNames[bt]).join(", ") + "; old bundles remain readable at their public URLs (read-only)" };
  }

  // Reverse a local recovery (demo/undo safety net): clears activeNames,
  // legacyNames and the recovery log for a tool, keeping any edit keys.
  function undoRecovery(tool) {
    let idx = readIndex(tool);
    if(idx) { idx.activeNames = {}; idx.legacyNames = {}; writeIndex(tool, idx); }
    store.remove(smbWalletRecoveryKeyName(tool));
    return { ok:true, toolStub:tool, summary:"cleared this device's recovery state for '" + tool + "' — bundle names return to their defaults" };
  }

  function summary() {
    load();
    let tools = listTools();
    return { deviceId:deviceId(), toolCount:tools.length, totalKeys:tools.reduce((s, x) => s + x.bundleCount, 0), tools, updatedAt:(readMeta().updatedAt) || null };
  }
  function toJSON() {
    return { deviceId:deviceId(), meta:readMeta(), tools:indexTools().map(t => readIndex(t)).filter(Boolean), recoveries:recoveryTools().map(t => readRecovery(t)).filter(Boolean) };
  }

  return { load, list, listTools, save, noteEditKey, get, has, remove, purgeTool, activeName, setActiveName, status, detectLoss, recoveryPlan, applyRecovery, undoRecovery, summary, toJSON, deviceId };

// Default singleton — one wallet per device, lazily created so importing tools
// share a single keychain (and the first access performs the startup load).
smbWallet() =>
  if(!window.SMB_WALLET) window.SMB_WALLET = smbCreateWallet({});
  return window.SMB_WALLET;

// Called by smbPublishBundle after a successful create/update, so every
// published file lands in the wallet index automatically. Never throws.
smbWalletNoteEditKey(tool, name, editKey, editCount) =>
  try {
    return smbWallet().noteEditKey(tool, name, editKey, editCount);
  } catch(e) {
    return { ok:false, code:"error", error:e.message };
  }

// Self-tests for the wallet — a network-free fixture world plus one connector
// discovery check that proves re-registration (activeNames) flows through to
// upstream URLs. Run from the page via root.smbWalletSelfTest().
async smbWalletSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });

  function memStore(seed) {
    let map = Object.assign({}, seed || {});
    return {
      get: k => (k in map) ? map[k] : null,
      set: (k, v) => { map[k] = v; return true; },
      remove: k => { delete map[k]; },
      keys: () => Object.keys(map)
    };
  }

  let manifestObj = { schemaVersion: 1, tools: [] };
  manifestObj = smbRegisterTool(manifestObj, { stub:"idea-incubator", displayName:"Idea Incubator", publishes:["idea"], consumes:[] });
  manifestObj = smbRegisterTool(manifestObj, { stub:"project-master", displayName:"Project Master", publishes:["project", "milestone-event"], consumes:["idea"] });

  let w = smbCreateWallet({ store: memStore() });
  t("fresh wallet lists no tools", w.listTools().length === 0);
  t("fresh wallet status is clean", w.status({ toolStub:"idea-incubator" }).state === "clean");

  let s1 = w.save("idea-incubator", "idea", "k-1", { editCount:2, displayName:"Idea Incubator" });
  t("save stores the key + records provenance", s1.ok && w.get("idea-incubator", "idea") === "k-1" && s1.firstSeenAt && s1.editCount === 2);
  t("save records the file in the wallet index (documented layout)", w.list().length === 1 && w.list()[0].bundleName === "idea" && w.list()[0].editKey === "k-1");
  t("wallet lists the tool with a bundle count + display name", (() => { let ts = w.listTools(); return ts.length === 1 && ts[0].bundleCount === 1 && ts[0].displayName === "Idea Incubator"; })());

  w.save("idea-incubator", "idea", "k-1", { editCount:3 });
  t("re-saving the same file updates, does not duplicate", w.list().length === 1 && w.list()[0].editCount === 3);

  let w2 = smbCreateWallet({ store: memStore({ "smb:editkey:project-master:project":"k-pm" }) });
  t("load() picks up keys written outside the wallet (startup)", w2.list().length === 1 && w2.list()[0].toolStub === "project-master" && w2.list()[0].bundleName === "project");

  let seedGhost = {
    "smb:editkey:idea-incubator:idea":"k-1",
    "smb:wallet:tool:idea-incubator": JSON.stringify({ version:1, toolStub:"idea-incubator", displayName:"", createdAt:"a", updatedAt:"a", activeNames:{}, legacyNames:{}, bundles:{ idea:{ firstSeenAt:"a", lastSeenAt:"a" }, ghost:{ firstSeenAt:"a", lastSeenAt:"a" } } })
  };
  let wg = smbCreateWallet({ store: memStore(seedGhost) });
  wg.load();
  t("load() reconciles the index: entries with no flat key are dropped", wg.list().map(e => e.bundleName).join(",") === "idea");

  let stOk = w.status({ manifest:manifestObj, toolStub:"idea-incubator" });
  t("status: expected + keyed → ok", stOk.state === "ok" && stOk.present.length === 1 && stOk.missing.length === 0);
  t("status: expectations come from the manifest's publishes", stOk.expected[0] === "idea");

  let wEmpty = smbCreateWallet({ store: memStore() });
  let stEmpty = wEmpty.status({ manifest:manifestObj, toolStub:"idea-incubator" });
  t("status: expected but unkeyed → empty (loss suspected)", stEmpty.state === "empty" && stEmpty.missing.length === 1);
  t("status: empty reason is actionable", typeof stEmpty.reason === "string" && stEmpty.reason.indexOf("new device") !== -1);

  let wHalf = smbCreateWallet({ store: memStore({ "smb:editkey:project-master:project":"k-pm" }) });
  let stHalf = wHalf.status({ manifest:manifestObj, toolStub:"project-master" });
  t("status: some expected keyed, some not → partial", stHalf.state === "partial" && stHalf.present.length === 1 && stHalf.missing.length === 1);

  let manifestRec = smbRegisterTool(manifestObj, { stub:"idea-incubator", displayName:"Idea Incubator", publishes:["idea"], consumes:[], activeNames:{ idea:"idea-a1b2c3-m4n5" } });
  t("re-registration stores activeNames on the manifest entry", smbFindTool(manifestRec, "idea-incubator").activeNames.idea === "idea-a1b2c3-m4n5");
  t("manifest with activeNames still validates", smbValidateManifest(manifestRec).ok);
  let stMan = wEmpty.status({ manifest:manifestRec, toolStub:"idea-incubator" });
  t("status: manifest activeNames drive the expected names", stMan.expected[0] === "idea-a1b2c3-m4n5");

  let fakeFetch404 = async (url) => ({ status:404, ok:false, text:async () => "nope" });
  let dNever = await wEmpty.detectLoss({ manifest:manifestObj, toolStub:"idea-incubator", fetchImpl:fakeFetch404 });
  t("detectLoss: 404 upstream → nothing lost (never published)", dNever.lost === false && dNever.confirmed.length === 0 && dNever.unconfirmed.length === 0);

  let ideaEnv = smbBuildEnvelope({ bundleType:"idea", tool:"idea-incubator", toolDisplayName:"Idea Incubator", source:"ideas/idea-1.json", payload:{ schemaVersion:1, id:"idea-1", title:"T", goals:["g"], scope:["s"], status:"ready" } }).bundle;
  let ideaText = JSON.stringify(ideaEnv);
  let fakeFetch200 = async (url) => ({ status:200, ok:true, text:async () => ideaText });
  let dLost = await wEmpty.detectLoss({ manifest:manifestObj, toolStub:"idea-incubator", fetchImpl:fakeFetch200 });
  t("detectLoss: file exists upstream without a local key → loss confirmed", dLost.lost === true && dLost.confirmed.length === 1 && dLost.confirmed[0].name === "idea" && !!dLost.confirmed[0].exportedAt);

  let wKeyed = smbCreateWallet({ store: memStore({ "smb:editkey:idea-incubator:idea":"k-1" }) });
  let dOk = await wKeyed.detectLoss({ manifest:manifestObj, toolStub:"idea-incubator", fetchImpl:fakeFetch200 });
  t("detectLoss: keyed + file exists upstream → no loss", dOk.lost === false && dOk.state === "ok");

  let plan = wEmpty.recoveryPlan({ toolStub:"idea-incubator", displayName:"Idea Incubator", manifest:manifestObj });
  t("recoveryPlan: fresh name per published type", plan.ok && plan.newNames.idea && plan.newNames.idea.indexOf("idea-") === 0 && plan.newNames.idea !== "idea");
  t("recoveryPlan: fresh names are valid bus names", Object.keys(plan.newNames).every(bt => smbBusValidName(plan.newNames[bt])));
  t("recoveryPlan: old bundles stay readable under their public URLs", plan.keepsReadable.length === 1 && plan.keepsReadable[0].name === "idea" && plan.keepsReadable[0].url === "https://editable.uploads.dev/file/idea-incubator/idea");
  t("recoveryPlan: includes a re-register-in-manifest step", plan.steps.some(s => s.step === "re-register-in-manifest"));
  t("recoveryPlan: distinct plans get distinct fresh names", wEmpty.recoveryPlan({ toolStub:"idea-incubator", manifest:manifestObj }).newNames.idea !== plan.newNames.idea);

  let applied = wEmpty.applyRecovery(plan);
  t("applyRecovery: ok + reports the adopted namespace", applied.ok && applied.activeNames.idea === plan.newNames.idea);
  t("applyRecovery: activeName now points at the fresh name", wEmpty.activeName("idea-incubator", "idea") === plan.newNames.idea);
  let stRec = wEmpty.status({ manifest:manifestObj, toolStub:"idea-incubator" });
  t("status after recovery: no longer 'empty'", stRec.state !== "empty" && stRec.recovered === true);
  t("status after recovery: fresh name expected, old name legacy + readable", stRec.expected[0] === plan.newNames.idea && stRec.legacy.some(l => l.name === "idea" && l.url === "https://editable.uploads.dev/file/idea-incubator/idea"));

  let undone = wEmpty.undoRecovery("idea-incubator");
  t("undoRecovery clears the local recovery state", undone.ok && wEmpty.status({ manifest:manifestObj, toolStub:"idea-incubator" }).recovered === false && wEmpty.activeName("idea-incubator", "idea") === "idea");

  let w4 = smbCreateWallet({ store: memStore() });
  w4.save("the-ledger", "invoice", "k-inv", {});
  w4.save("the-ledger", "payment-receipt", "k-pr", {});
  w4.remove("the-ledger", "invoice");
  t("remove clears a single file's key", w4.get("the-ledger", "invoice") === null && w4.list().length === 1);
  w4.purgeTool("the-ledger");
  t("purgeTool clears every key + index for a tool", w4.list().length === 0 && w4.listTools().length === 0);

  let wHooked = smbCreateWallet({ store: memStore() });
  let note = wHooked.noteEditKey("idea-incubator", "idea", "k-idea", 1);
  t("noteEditKey (the publish hook) records a successful publish", note.ok && wHooked.get("idea-incubator", "idea") === "k-idea");

  t("device id is stable per store", (() => { let a = w.deviceId(); let b = w.deviceId(); return a === b && a.length >= 6; })());
  let sum = w.summary();
  t("summary reports device id + per-tool key counts", typeof sum.deviceId === "string" && sum.totalKeys >= 1 && sum.toolCount >= 1);

  let busC = smbCreateConnector({ toolStub:"project-master", toolDisplayName:"Project Master" });
  await busC.configure(manifestRec);
  let upsR = await busC.listUpstream("idea");
  t("connector discovery follows re-registration (activeNames)", upsR.ok && upsR.upstreams[0].name === "idea-a1b2c3-m4n5" && upsR.upstreams[0].url === "https://editable.uploads.dev/file/idea-incubator/idea-a1b2c3-m4n5");

  let capturedR = null;
  let busD = smbCreateConnector({ toolStub:"the-ledger", toolDisplayName:"The Ledger", syncTracker:function(){ return { ok:true }; } });
  await busD.configure(manifestRec);
  let pullR = await busD.pull("idea", { fetchImpl:async (url) => { capturedR = url; return { status:200, ok:true, text:async () => ideaText }; } });
  t("connector pull resolves the re-registered fresh name", capturedR === "https://editable.uploads.dev/file/idea-incubator/idea-a1b2c3-m4n5" && pullR.ok && pullR.status === "fresh");

  let ws1 = smbWallet();
  let ws2 = smbWallet();
  t("smbWallet() returns a stable singleton", ws1 === ws2);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 13. SMB PIPELINE — FRESHNESS & SYNC-STATUS TRACKING ────
// A per-(tool, bundle) record of when this tool last published / pulled each
// bundle, so any page can answer "how fresh is what I'm looking at?" — the
// "last synced X ago" line — and warn when a consumed bundle hasn't been
// re-synced within a configurable threshold.
//
// ── Storage layout (all in localStorage) ────────────────────────────────────
//   smb:sync:<toolStub>:<bundleName>   one JSON record per (tool, bundle):
//     { version, toolStub, bundleName,
//       lastPulledAt, lastPullStatus, lastSeenExport, lastSeenTool, lastSeenSize,
//       lastPublishedAt, lastPublishEditCount, upstreamEditCount, updatedAt }
//   The key namespace is the TOOL THAT IS TRACKING — a consumer records
//   smb:sync:<consumerStub>:<bundleName> for what it pulls, and a publisher's
//   own files are recorded the same way. Edit counts for files this device
//   writes come from the §8 ledger (upstreamEditCount — the count consumers
//   would observe); the read path doesn't expose a server edit count for
//   CONSUMED bundles, so those track data-age via lastSeenExport instead — the
//   hub (§33–35) supplies true cross-device counts.
//
// Hooks: smbPublishBundle() auto-notes every successful publish and
// connector.pull() auto-notes every successful pull, both through never-
// throwing wrappers (injectable per call for tests). Tracking is automatic and
// can never break the bus.
//
//   let t = root.smbSyncTracker();                 // lazy singleton
//   t.notePublish("smb-integration", "idea", { editCount: 3 });
//   t.notePull("smb-integration", "project", pullResult);
//   let st = t.status({ tool: "smb-integration", bundles: ["idea", "project"],
//                       staleAfterMs: 60*60*1000 });
//   // → per bundle: lastSyncedHuman:"synced 2 minutes ago", stale:false,
//   //   staleReason:"last pulled 3 hours ago — older than the 1 hour sync
//   //   threshold; re-sync to refresh" (when stale)

smbSyncStaleAfterMs = [3600000]   // default staleness threshold — 1 hour

smbSyncKeyName(toolStub, bundleName) =>
  return "smb:sync:" + toolStub + ":" + bundleName;

smbCreateSyncTracker(opts) =>
  opts = opts || {};
  let store = opts.store || {
    get: smbBusStoreGet,
    set: smbBusStoreSet,
    remove: smbBusStoreRemove,
    keys: () => { try { let out = []; for(let i = 0; i < window.localStorage.length; i++) { let k = window.localStorage.key(i); if(k) out.push(k); } return out; } catch(e) { return []; } }
  };
  let clock = (typeof opts.clock === "function") ? opts.clock : (() => Date.now());
  let staleAfterMs = (typeof opts.staleAfterMs === "number" && opts.staleAfterMs >= 0) ? opts.staleAfterMs : smbSyncStaleAfterMs;
  let prefix = "smb:sync:";

  function nowIso() { return new Date(clock()).toISOString(); }
  function storeKeys() { try { return typeof store.keys === "function" ? store.keys() : []; } catch(e) { return []; } }
  function keysWithPrefix(p) { return storeKeys().filter(k => k.indexOf(p) === 0); }
  function jsonGet(key) {
    let raw = store.get(key);
    if(typeof raw !== "string" || !raw) return null;
    try { return JSON.parse(raw); } catch(e) { return null; }
  }
  function jsonSet(key, val) { try { store.set(key, JSON.stringify(val)); return true; } catch(e) { return false; } }
  function readRec(tool, name) {
    let r = jsonGet(smbSyncKeyName(tool, name));
    return (r && typeof r === "object" && !Array.isArray(r)) ? r : null;
  }
  function writeRec(tool, name, rec) {
    rec.version = 1; rec.toolStub = tool; rec.bundleName = name; rec.updatedAt = nowIso();
    return jsonSet(smbSyncKeyName(tool, name), rec);
  }
  function newRec(tool, name) {
    return { version:1, toolStub:tool, bundleName:name, lastPulledAt:null, lastPullStatus:null, lastSeenExport:null, lastSeenTool:null, lastSeenSize:null, lastPublishedAt:null, lastPublishEditCount:null, upstreamEditCount:null };
  }
  function atIso(at) {
    if(typeof at === "number") return new Date(at).toISOString();
    if(typeof at === "string" && at.trim()) return at;
    return nowIso();
  }

  // Record a successful publish. opts: { editCount, publishedAt, at } — 'at'
  // overrides the event time (ISO string or ms) for import/simulation.
  function notePublish(tool, name, opts) {
    opts = opts || {};
    if(!smbBusValidName(tool) || !smbBusValidName(name)) {
      return { ok:false, code:"invalid_name", error:"smbSync.notePublish needs a valid toolStub and bundleName" };
    }
    let rec = readRec(tool, name) || newRec(tool, name);
    let at = atIso(opts.at || opts.publishedAt || null);
    rec.lastPublishedAt = at;
    if(typeof opts.editCount === "number") {
      rec.lastPublishEditCount = opts.editCount;
      rec.upstreamEditCount = opts.editCount;
    }
    if(!writeRec(tool, name, rec)) return { ok:false, code:"store_failed", error:"could not write the sync record to local storage" };
    return { ok:true, toolStub:tool, bundleName:name, lastPublishedAt:at, lastPublishEditCount:rec.lastPublishEditCount, upstreamEditCount:rec.upstreamEditCount };
  }

  // Record a successful pull. result is the smbPullBundle success object.
  // opts: { at } — overrides the event time for import/simulation.
  function notePull(tool, name, result, opts) {
    opts = opts || {};
    if(!smbBusValidName(tool) || !smbBusValidName(name)) {
      return { ok:false, code:"invalid_name", error:"smbSync.notePull needs a valid toolStub and bundleName" };
    }
    if(!result || !result.ok) return { ok:false, code:"invalid_result", error:"smbSync.notePull expects a successful smbPullBundle result" };
    let rec = readRec(tool, name) || newRec(tool, name);
    let at = atIso(opts.at || result.fetchedAt || null);
    rec.lastPulledAt = at;
    rec.lastPullStatus = result.status || "fresh";
    if(typeof result.exportedAt === "string" && result.exportedAt) rec.lastSeenExport = result.exportedAt;
    if(typeof result.tool === "string" && result.tool) rec.lastSeenTool = result.tool;
    if(typeof result.size === "number") rec.lastSeenSize = result.size;
    if(!writeRec(tool, name, rec)) return { ok:false, code:"store_failed", error:"could not write the sync record to local storage" };
    return { ok:true, toolStub:tool, bundleName:name, lastPulledAt:at, lastPullStatus:rec.lastPullStatus, lastSeenExport:rec.lastSeenExport, lastSeenTool:rec.lastSeenTool, lastSeenSize:rec.lastSeenSize };
  }

  function get(tool, name) { return readRec(tool, name); }

  function list() {
    let out = [];
    for(let k of keysWithPrefix(prefix)) {
      let rest = k.slice(prefix.length);
      let i = rest.lastIndexOf(":");
      if(i <= 0 || i === rest.length - 1) continue;
      let tool = rest.slice(0, i), name = rest.slice(i + 1);
      let rec = readRec(tool, name);
      if(rec) out.push({ toolStub:tool, bundleName:name, record:rec });
    }
    out.sort((a, b) => (a.toolStub + ":" + a.bundleName < b.toolStub + ":" + b.bundleName) ? -1 : 1);
    return out;
  }

  function clear(tool, name) {
    if(!smbBusValidName(tool)) return { ok:false, code:"invalid_name", error:"smbSync.clear needs a valid toolStub" };
    if(name === undefined || name === null || name === "") {
      for(let k of keysWithPrefix(prefix + tool + ":")) store.remove(k);
      return { ok:true, toolStub:tool, scope:"tool", cleared:true };
    }
    if(!smbBusValidName(name)) return { ok:false, code:"invalid_name", error:"smbSync.clear needs a valid bundleName" };
    store.remove(smbSyncKeyName(tool, name));
    return { ok:true, toolStub:tool, bundleName:name, scope:"bundle", cleared:true };
  }

  // Freshness status per bundle for a tool. opts: { tool, bundles? (default:
  // every recorded bundle for the tool), staleAfterMs?, now? (ms — injectable
  // time for tests/previews) }. Each bundle's status: the "last synced X ago"
  // line (lastSyncedHuman), the sync kind (published / pulled / never), the
  // upstream edit count (for files this tool writes), the data age of consumed
  // bundles (dataAgeHuman, from the last-seen exportedAt), and the staleness
  // flag — stale when the last successful sync is older than the threshold.
  function status(opts) {
    opts = opts || {};
    let tool = opts.tool;
    if(!tool) return { ok:false, code:"invalid_opts", error:"smbSync.status needs { tool } — the stub of the tool tracking these bundles" };
    let threshold = (typeof opts.staleAfterMs === "number" && opts.staleAfterMs >= 0) ? opts.staleAfterMs : staleAfterMs;
    let now = (typeof opts.now === "number") ? opts.now : clock();
    let names = opts.bundles || [];
    if(names.length === 0) {
      let p = prefix + tool + ":";
      names = keysWithPrefix(p).map(k => k.slice(p.length));
    }
    let bundles = {}, staleCount = 0;
    for(let name of names) {
      let rec = readRec(tool, name);
      let b = {
        bundleName: name,
        lastPulledAt: rec ? rec.lastPulledAt : null,
        lastPullStatus: rec ? rec.lastPullStatus : null,
        lastSeenExport: rec ? rec.lastSeenExport : null,
        lastSeenTool: rec ? rec.lastSeenTool : null,
        lastSeenSize: rec ? rec.lastSeenSize : null,
        lastPublishedAt: rec ? rec.lastPublishedAt : null,
        lastPublishEditCount: rec ? rec.lastPublishEditCount : null,
        upstreamEditCount: rec ? rec.upstreamEditCount : null,
        lastSyncedAt: null, lastSyncedKind: "never",
        lastSyncedHuman: "never", ageMs: null, stale: false, staleReason: null,
        dataAgeMs: null, dataAgeHuman: null
      };
      let lastSyncAt = null, kind = null;
      if(b.lastPulledAt) { lastSyncAt = b.lastPulledAt; kind = "pulled"; }
      else if(b.lastPublishedAt) { lastSyncAt = b.lastPublishedAt; kind = "published"; }
      b.lastSyncedAt = lastSyncAt; b.lastSyncedKind = kind;
      if(lastSyncAt) {
        let ts = Date.parse(lastSyncAt);
        if(!Number.isNaN(ts)) {
          b.ageMs = Math.max(0, now - ts);
          let human = smbBusAgeHuman(b.ageMs) + " ago";
          b.lastSyncedHuman = (kind === "pulled" ? "synced " : "published ") + human;
          if(b.ageMs > threshold) {
            staleCount++;
            b.stale = true;
            b.staleReason = (kind === "pulled" ? "last pulled " : "last published ") + human + " — older than the " + smbBusAgeHuman(threshold) + " sync threshold; re-sync to refresh";
          }
        }
      }
      if(b.lastSeenExport) {
        let ts = Date.parse(b.lastSeenExport);
        if(!Number.isNaN(ts)) { b.dataAgeMs = Math.max(0, now - ts); b.dataAgeHuman = smbBusAgeHuman(b.dataAgeMs) + " old"; }
      }
      bundles[name] = b;
    }
    return { ok:true, tool, staleAfterMs:threshold, now, staleCount, total:names.length, bundles };
  }

  return { notePublish, notePull, get, list, clear, status };

// Default singleton — one freshness tracker per device, lazily created so
// importing tools share a single record store.
smbSyncTracker() =>
  if(!window.SMB_SYNC_TRACKER) window.SMB_SYNC_TRACKER = smbCreateSyncTracker({});
  return window.SMB_SYNC_TRACKER;

// Never-throwing wrappers — the auto-hooks smbPublishBundle / connector.pull
// use (each also accepts an injected tracker for tests).
smbSyncNotePublish(tool, name, editCount, publishedAt) =>
  try {
    return smbSyncTracker().notePublish(tool, name, { editCount, publishedAt });
  } catch(e) {
    return { ok:false, code:"error", error:e.message };
  }

smbSyncNotePull(tool, name, result) =>
  try {
    return smbSyncTracker().notePull(tool, name, result);
  } catch(e) {
    return { ok:false, code:"error", error:e.message };
  }

smbSyncStatus(opts) =>
  try {
    return smbSyncTracker().status(opts);
  } catch(e) {
    return { ok:false, code:"error", error:e.message };
  }

// Self-tests for the sync tracker — hermetic (in-memory store + injectable
// clock), plus hook tests that prove smbPublishBundle / connector.pull auto-
// note sync events (with injected trackers so the real store stays clean).
// Run from the page via root.smbSyncSelfTest().
async smbSyncSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });
  function memStore(seed) {
    let map = Object.assign({}, seed || {});
    return {
      get: k => (k in map) ? map[k] : null,
      set: (k, v) => { map[k] = v; return true; },
      remove: k => { delete map[k]; },
      keys: () => Object.keys(map)
    };
  }

  let now = Date.parse("2026-09-07T12:00:00.000Z");
  let clockNow = now;
  let tr = smbCreateSyncTracker({ store: memStore(), clock: () => clockNow });

  t("fresh tracker records nothing", tr.list().length === 0);
  let st0 = tr.status({ tool: "smb-integration", bundles: ["idea", "project"] });
  t("status with no records → never synced, not stale", st0.ok && st0.bundles.idea.lastSyncedHuman === "never" && st0.bundles.idea.stale === false && st0.staleCount === 0);

  let p = tr.notePublish("smb-integration", "idea", { editCount: 3 });
  t("notePublish records the publish time + upstream edit count", p.ok && !!p.lastPublishedAt && p.lastPublishEditCount === 3 && p.upstreamEditCount === 3);
  let stP = tr.status({ tool: "smb-integration", bundles: ["idea"] });
  t("status after publish → 'published just now', kind published, not stale", stP.bundles.idea.lastSyncedKind === "published" && stP.bundles.idea.lastSyncedHuman.indexOf("published") === 0 && stP.bundles.idea.stale === false);

  let pullRes = { ok:true, status:"fresh", tool:"project-master", toolDisplayName:"Project Master", bundleType:"project", exportedAt:"2026-09-07T11:30:00.000Z", fetchedAt:"2026-09-07T12:00:01.000Z", size:1234 };
  let pl = tr.notePull("smb-integration", "project", pullRes);
  t("notePull records pull time, status, upstream exporter + data-age signal", pl.ok && pl.lastPulledAt === pullRes.fetchedAt && pl.lastPullStatus === "fresh" && pl.lastSeenTool === "project-master" && pl.lastSeenExport === pullRes.exportedAt && pl.lastSeenSize === 1234);
  let st1 = tr.status({ tool: "smb-integration", bundles: ["project"] });
  t("status after pull → 'synced just now', kind pulled", st1.bundles.project.lastSyncedKind === "pulled" && st1.bundles.project.lastSyncedHuman.indexOf("synced") === 0);
  t("consumed bundle reports the data age from the upstream exportedAt", st1.bundles.project.dataAgeHuman === "30 minutes old");
  t("a pure consumer has no upstream edit count (the read path exposes none)", st1.bundles.project.upstreamEditCount === null);

  clockNow = now + 5 * 60 * 1000;
  let st2 = tr.status({ tool: "smb-integration", bundles: ["project"] });
  t("5 min since pull, 1h threshold → not stale, 'synced 5 minutes ago'", st2.bundles.project.stale === false && st2.bundles.project.lastSyncedHuman === "synced 5 minutes ago" && st2.bundles.project.ageMs >= 5 * 60 * 1000 - 1000);

  let st3 = tr.status({ tool: "smb-integration", bundles: ["project"], staleAfterMs: 60000 });
  t("over a 1-minute threshold → stale, reason names the threshold", st3.bundles.project.stale === true && st3.staleCount === 1 && typeof st3.bundles.project.staleReason === "string" && st3.bundles.project.staleReason.indexOf("1 minute") !== -1);

  let stAll = tr.status({ tool: "smb-integration" });
  t("status without a bundle list enumerates every record for the tool", stAll.total === 2 && !!stAll.bundles.idea && !!stAll.bundles.project);

  let tr2 = smbCreateSyncTracker({ store: memStore(), clock: () => clockNow, staleAfterMs: 0 });
  tr2.notePull("smb-integration", "project", pullRes);
  let st4 = tr2.status({ tool: "smb-integration", bundles: ["project"] });
  t("a 0ms creation-time threshold makes any age stale", st4.bundles.project.stale === true);

  let tr3 = smbCreateSyncTracker({ store: memStore(), clock: () => clockNow });
  tr3.notePublish("smb-integration", "idea", { editCount: 2 });
  tr3.notePull("smb-integration", "idea", pullRes);
  let st5 = tr3.status({ tool: "smb-integration", bundles: ["idea"] });
  t("published-then-pulled → sync line reflects the pull, publish info kept", st5.bundles.idea.lastSyncedKind === "pulled" && !!st5.bundles.idea.lastPublishedAt && st5.bundles.idea.upstreamEditCount === 2);

  let cl = tr.clear("smb-integration", "project");
  t("clear removes a single bundle record", cl.ok && tr.list().length === 1 && tr.status({ tool: "smb-integration", bundles: ["project"] }).bundles.project.lastSyncedHuman === "never");
  tr.clear("smb-integration");
  t("clear without a name removes the whole tool", tr.list().length === 0);

  let bad1 = tr.notePublish("Bad_Name", "idea", {});
  t("notePublish rejects an invalid tool stub", bad1.ok === false);
  let bad2 = tr.status({});
  t("status requires a tool", bad2.ok === false);

  let built = smbBuildEnvelope({ bundleType:"idea", tool:"idea-incubator", toolDisplayName:"Idea Incubator", source:"test/sync-hook.json", payload:{ schemaVersion:1, id:"sync-hook", title:"Sync hook", goals:["g"], scope:["s"], status:"ready" } });
  let fakeUpload = { editable: { async set(name, text, opts) { return { editKey: "k-" + name, editCount: 2 }; } } };
  let noted = [];
  let pub = await smbPublishBundle({ bundle: built.bundle, toolStub: "idea-incubator", bundleName: "idea", uploadPlugin: fakeUpload, syncTracker: (tool, name, editCount, publishedAt) => { noted.push([tool, name, editCount, publishedAt]); return { ok:true }; } });
  t("smbPublishBundle auto-notes a successful publish (injectable tracker)", pub.ok && noted.length === 1 && noted[0][0] === "idea-incubator" && noted[0][1] === "idea" && noted[0][2] === 2 && typeof noted[0][3] === "string");
  root.smbBusClearEditKey("idea-incubator", "idea");

  let pullNoted = [];
  let manObj = { schemaVersion:1, tools:[] };
  manObj = smbRegisterTool(manObj, { stub:"idea-incubator", displayName:"Idea Incubator", publishes:["idea"], consumes:[] });
  let conn = smbCreateConnector({ toolStub:"project-master", toolDisplayName:"Project Master", syncTracker: (tool, name, res) => { pullNoted.push([tool, name, res]); return { ok:true }; } });
  await conn.configure(manObj);
  let ideaText = JSON.stringify(built.bundle);
  let r = await conn.pull("idea", { fetchImpl: async (url) => ({ status:200, ok:true, text:async () => ideaText }) });
  t("connector.pull auto-notes a successful pull (injectable tracker)", r.ok && pullNoted.length === 1 && pullNoted[0][0] === "project-master" && pullNoted[0][1] === "idea" && pullNoted[0][2].ok === true && pullNoted[0][2].status === "fresh");

  let s1 = smbSyncTracker();
  let s2 = smbSyncTracker();
  t("smbSyncTracker() returns a stable singleton", s1 === s2);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 14. SMB PIPELINE — CHANGE-NOTIFICATION HOOKS ──────────
// A subscription surface so each tool can react the moment an upstream bundle
// it consumes advances: event listeners on a shared per-page notifier PLUS a
// watcher that polls an upstream bundle and, on a newer exportedAt (the read
// path's freshness signal; the hub later adds true edit-count change events),
// triggers an automatic pull + re-render via a callback — no manual refresh.
//
//   let n = root.smbNotifier();                  // shared per-page event bus
//   n.on("change:project", (ev) => render(ev.detail.result));
//   n.on("change", (ev) => console.log(ev));     // any change
//
//   let watch = root.smbWatchUpstream({
//     connector: myConnector, bundleName: "project",
//     onNew: (res) => renderProject(res.bundle.payload),  // auto pull done
//     onError: (res) => show(res.error),
//     intervalMs: 60000
//   });
//   watch.stop();
//
// The watcher persists a per-(tool,bundle) "last seen" exportedAt so a fresh
// page load doesn't re-fire for data already seen, and never throws — pull
// errors are routed to onError and polling continues.

smbNotifySeenKey(tool, name) =>
  return "smb:notify:seen:" + tool + ":" + name;

smbCreateNotifier(opts) =>
  opts = opts || {};
  let listeners = {};
  function on(name, fn) {
    if(typeof name !== "string" || typeof fn !== "function") return function(){};
    if(!listeners[name]) listeners[name] = [];
    listeners[name].push(fn);
    return function off() {
      let a = listeners[name] || [];
      let i = a.indexOf(fn);
      if(i >= 0) a.splice(i, 1);
    };
  }
  function off(name, fn) {
    if(typeof name !== "string") return;
    let a = listeners[name] || [];
    if(typeof fn === "function") {
      let i = a.indexOf(fn);
      if(i >= 0) a.splice(i, 1);
    } else {
      listeners[name] = [];
    }
  }
  function emit(name, detail) {
    let ev = { name, detail, timestamp: new Date().toISOString() };
    let a = (listeners[name] || []).slice();
    for(let fn of a) { try { fn(ev); } catch(e) {} }
    if(name.indexOf("change:") === 0) {
      let g = (listeners["change"] || []).slice();
      for(let fn of g) { try { fn(ev); } catch(e) {} }
    }
    return ev;
  }
  function triggerChange(change) {
    // change: { bundleType, tool, name, editCount, exportedAt, url, result }
    emit("change:" + change.bundleType, change);
    emit("change:" + change.bundleType + ":" + (change.tool || "?"), change);
    return change;
  }
  return { on, off, emit, triggerChange };

smbNotifier() =>
  if(!window.SMB_NOTIFIER) window.SMB_NOTIFIER = smbCreateNotifier({});
  return window.SMB_NOTIFIER;

// Poll an upstream bundle through a connector; when the pulled result is fresh
// and its exportedAt differs from the last seen value, emit notifier change
// events and call onNew (the tool's re-render). Returns { start, stop, check }.
smbWatchUpstream(opts) =>
  opts = opts || {};
  let connector = opts.connector;
  let bundleName = opts.bundleName;
  let intervalMs = (typeof opts.intervalMs === "number" && opts.intervalMs >= 1000) ? opts.intervalMs : 60000;
  let onNew = (typeof opts.onNew === "function") ? opts.onNew : null;
  let onError = (typeof opts.onError === "function") ? opts.onError : null;
  let notifier = opts.notifier || smbNotifier();
  let tool = (connector && typeof connector.config === "function" && connector.config().toolStub) || "";
  // check() is callable without start() (manual refresh) — stop() is what
  // blocks further checks.
  let stopped = false, timer = null, running = false;
  let lastSeen = null;
  try {
    let raw = smbBusStoreGet(smbNotifySeenKey(tool, bundleName));
    if(raw) {
      let j = JSON.parse(raw);
      if(j && typeof j === "object" && typeof j.exportedAt === "string") lastSeen = j.exportedAt;
    }
  } catch(e) {}

  function seenChanged(exportedAt) {
    if(!exportedAt) return false;
    if(!lastSeen) return true;
    return exportedAt !== lastSeen;
  }

  async function check() {
    if(running || stopped) return;
    running = true;
    try {
      if(!connector || typeof connector.pull !== "function") {
        if(onError) onError({ ok:false, code:"invalid_opts", error:"smbWatchUpstream needs a connector with pull()" });
        return;
      }
      let res = await connector.pull(bundleName, { fetchImpl: opts.fetchImpl });
      if(stopped) return;
      if(!res.ok) { if(onError) onError(res); return; }
      if(res.status !== "fresh") return;
      if(!seenChanged(res.exportedAt)) return;
      lastSeen = res.exportedAt;
      try { smbBusStoreSet(smbNotifySeenKey(tool, bundleName), JSON.stringify({ exportedAt: res.exportedAt })); } catch(e) {}
      let change = { bundleType: bundleName, tool: res.tool || tool, name: bundleName, editCount: null, exportedAt: res.exportedAt, url: res.url, result: res };
      notifier.triggerChange(change);
      if(onNew) onNew(res);
    } catch(e) {
      if(onError && !stopped) onError({ ok:false, code:"error", error:e.message });
    } finally {
      running = false;
    }
  }

  function start() {
    stopped = false;
    if(opts.immediate !== false) check();
    if(intervalMs > 0) { if(timer) clearInterval(timer); timer = setInterval(check, intervalMs); }
    return { ok:true, running:true };
  }
  function stop() {
    stopped = true;
    if(timer) { clearInterval(timer); timer = null; }
    return { ok:true, stopped:true };
  }
  return { start, stop, check, isRunning: () => !stopped, bundleName, tool };

// Self-tests for the notification hooks — hermetic: a scripted fake connector
// (mutable upstream exportedAt) drives the watcher's check() directly so no
// timers are involved. Run via root.smbNotificationSelfTest().
async smbNotificationSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });

  // Hermetic: clear any last-seen value a previous run (or the real page)
  // persisted for this watcher's key, so the first check is always "new".
  try { smbBusStoreRemove(smbNotifySeenKey("idea-incubator", "project")); } catch(e) {}

  let upstream = { exportedAt: "2026-09-07T10:00:00.000Z", payload: { schemaVersion: 1, id: "p1", name: "Project 1", status: "proposed", milestones: [] } };
  let bundleText = () => JSON.stringify({ schemaVersion:1, bundleType:"project", tool:"project-master", toolDisplayName:"Project Master", exportedAt: upstream.exportedAt, source:"projects/projects.json", payload: upstream.payload });
  let fakeConn = {
    config: () => ({ toolStub: "idea-incubator" }),
    async pull(name, opts) {
      return await root.smbPullBundle({ url: "https://editable.uploads.dev/file/project-master/project", fetchImpl: async () => ({ status:200, ok:true, text:async () => bundleText() }) });
    }
  };

  let events = [];
  let off = smbNotifier().on("change:project", (ev) => { events.push("change:project"); });
  let news = [], errs = [];
  let watch = smbWatchUpstream({ connector: fakeConn, bundleName: "project", onNew: (res) => news.push(res.exportedAt), onError: (res) => errs.push(res), immediate: false });

  await watch.check();
  t("first check (nothing seen yet) fires onNew", news.length === 1 && news[0] === upstream.exportedAt);
  t("first check emits a change:project event", events.indexOf("change:project") !== -1);
  await watch.check();
  t("unchanged second check does not re-fire", news.length === 1);

  upstream.exportedAt = "2026-09-07T10:05:00.000Z";
  await watch.check();
  t("upstream advance fires onNew again", news.length === 2 && news[1] === upstream.exportedAt);
  await watch.check();
  t("still no re-fire on the same new value", news.length === 2);

  let before = errs.length;
  let failing = smbWatchUpstream({ connector: { pull: async () => ({ ok:false, code:"404", error:"nope" }) }, bundleName: "project", onNew: () => {}, onError: (r) => errs.push(r), immediate:false });
  await failing.check();
  t("pull failures route to onError, never throw", errs.length === before + 1 && errs[errs.length - 1].code === "404");

  watch.stop();
  let stoppedBefore = news.length;
  upstream.exportedAt = "2026-09-07T11:00:00.000Z";
  await watch.check();
  t("after stop() the watcher ignores further checks", news.length === stoppedBefore);

  let noConn = smbWatchUpstream({ connector: null, bundleName: "x", onError: (r) => errs.push(r), immediate:false });
  await noConn.check();
  t("a watcher without a connector reports a readable error", errs.length >= before + 2);

  off();
  let evCount = events.length;
  root.smbNotifier().triggerChange({ bundleType: "project", tool: "t" });
  t("unsubscribe stops event delivery", events.length === evCount);

  let n1 = smbNotifier(), n2 = smbNotifier();
  t("smbNotifier() returns a stable singleton", n1 === n2);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 15. SMB PIPELINE — GUIDANCE & ERROR COPY ──────────────
// Every pipeline failure mode gets a user-facing, actionable message with the
// exact next step, so a non-technical user can self-serve. smbGuidanceFor()
// takes ANY typed result from the framework (publish / pull / connector /
// store) and turns it into { summary, nextStep }. Never throws.
//
//   let res = await bus.pull("invoice");
//   if(!res.ok) { let g = root.smbGuidanceFor(res); show(g.summary + " " + g.nextStep); }
//   // e.g. "the-ledger has never published an invoice bundle yet — open that
//   // generator and export one."

smbGuidanceFor(result, opts) =>
  opts = opts || {};
  result = result || {};
  let code = result.code || (result.ok ? "ok" : "unknown");
  let bt = result.bundleType || opts.bundleType || null;
  let tool = result.tool || result.toolStub || opts.tool || null;
  let url = result.url || null;
  let summary = "", nextStep = "";
  switch(code) {
    case "ok":
      return { ok:true, code:"ok", summary:"Everything went through.", nextStep:"Nothing to do." };
    case "404":
      summary = "No bundle found at " + (url || "the upstream URL") + ".";
      nextStep = tool
        ? ("'" + tool + "' has never published a " + (bt || "bundle") + " bundle yet — open that generator and export one, then try again.")
        : "The publisher has never exported this bundle, or it was deleted or renamed — ask the publishing tool to export one.";
      break;
    case "schema_gap":
      if(result.newer) {
        summary = "The bundle at " + (url || "?") + " uses a newer schema (v" + result.declaredVersion + ") than this library supports (v" + result.currentVersion + ").";
        nextStep = "Update smb-integration to the newer version, then re-pull.";
      } else {
        summary = tool
          ? (tool + "'s file was overwritten by a newer schema (v" + result.declaredVersion + " vs this library's v" + result.currentVersion + ").")
          : "The bundle uses an older schema version than this library supports.";
        nextStep = tool
          ? ("Update " + tool + " so it exports schema v" + result.currentVersion + ", then re-pull.")
          : "Update the publishing tool to export the current schema version.";
      }
      break;
    case "too_large":
      summary = "The file is too large for the bus (over 5 MiB).";
      nextStep = "Split the export into smaller bundles — e.g. export per-milestone instead of the whole project at once.";
      break;
    case "quota":
      summary = "Editing quota reached for this bus file.";
      nextStep = "Try again later (editable-file writes share the daily upload allowance).";
      break;
    case "superseded":
      summary = "This write was superseded by a more recent one (writes to a name are limited to ~1 per 10s).";
      nextStep = "Wait a moment and try again.";
      break;
    case "unsaved_generator":
      summary = "This generator can't publish to the bus while unsaved.";
      nextStep = "Save the generator (it gets its own bus namespace), then publish again.";
      break;
    case "malformed":
      summary = "The file at " + (url || "?") + " isn't a valid " + (bt || "bundle") + " bundle.";
      nextStep = tool
        ? ("The publisher may have saved a different file format under that name — ask " + tool + " to re-export a " + (bt || "bundle") + " bundle.")
        : "Ask the publisher to re-export the bundle.";
      break;
    case "network":
      summary = "Could not reach " + (url || "the upstream") + ".";
      nextStep = "Check your connection and try again.";
      break;
    case "no_upstream":
      summary = "No tool publishes this bundle type yet.";
      nextStep = tool
        ? ("'" + tool + "' has never published a " + (bt || "bundle") + " bundle yet — open that generator and export one.")
        : "Check the manifest for a publisher, or export the bundle yourself.";
      break;
    case "already_exported":
      summary = "This item was already sent to the downstream tool.";
      nextStep = "Nothing was duplicated — pass force:true only if you really want to re-publish it.";
      break;
    case "invalid_bundle":
      summary = "The " + (bt || "bundle") + " bundle failed validation.";
      nextStep = "Fix: " + ((result.errors || []).join("; ") || result.error || "check the required fields for this bundle type");
      break;
    case "conflict":
      summary = "This workspace file was edited on another device since the last pull.";
      nextStep = "Choose keep mine, keep theirs, or review the field-level merge preview (smbCreateConflictResolver).";
      break;
    case "conflict_unresolved":
      summary = "The conflict could not be resolved automatically.";
      nextStep = "Check your connection and try again, or restore from a backup file.";
      break;
    case "plugin_missing":
      summary = "upload-plugin isn't available.";
      nextStep = "Check that smb-integration's imports include 'uploadPlugin = import:upload-plugin'.";
      break;
    case "invalid_name":
      summary = "A bus name was invalid (1-200 chars of lowercase letters, numbers and hyphens).";
      nextStep = "Use a valid tool stub and bundle name.";
      break;
    case "invalid_status":
      summary = "The status value isn't one of the allowed states.";
      nextStep = "Use one of: " + ((result.valid || []).join(", ") || "see the error above");
      break;
    case "not_found":
      summary = "The item requested doesn't exist.";
      nextStep = "It may have been deleted — refresh the list and try again.";
      break;
    case "double_entry":
      summary = "The transaction is not balanced (debits must equal credits).";
      nextStep = "Check the debit/credit amounts and try again.";
      break;
    case "already_posted":
      summary = "This entry was already posted to the ledger.";
      nextStep = "Posted entries can't be edited or deleted — reverse it with a reversing entry if it was a mistake.";
      break;
    case "already_billed":
      summary = "This milestone was already exported for billing.";
      nextStep = "Nothing was double-sent — use force:true only to re-export a corrected event.";
      break;
    case "deduped":
      summary = "This upstream event was already ingested — no duplicate was created.";
      nextStep = "Nothing to do.";
      break;
    default:
      summary = result.error || ("The pipeline call failed (" + code + ").");
      nextStep = "Check the error message above and retry.";
  }
  return { ok:false, code, summary, nextStep, bundleType: bt, tool, url };

// The full guidance catalog — every code + the phrase users will see, for docs
// and tests.
smbGuidanceCatalog() =>
  let codes = ["404", "schema_gap", "too_large", "quota", "superseded", "unsaved_generator", "malformed", "network", "no_upstream", "already_exported", "invalid_bundle", "conflict", "plugin_missing", "invalid_name", "not_found", "double_entry", "already_posted", "already_billed", "deduped"];
  return codes.map(code => {
    let g = smbGuidanceFor({ ok:false, code });
    return { code, summary: g.summary, nextStep: g.nextStep };
  });

smbGuidanceSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });

  let g404 = smbGuidanceFor({ ok:false, code:"404", url:"https://editable.uploads.dev/file/the-ledger/invoice", tool:"the-ledger", bundleType:"invoice" });
  t("404 guidance names the tool + bundle + next step", g404.nextStep.indexOf("the-ledger") !== -1 && g404.nextStep.indexOf("invoice") !== -1 && g404.nextStep.indexOf("open that generator and export one") !== -1);

  let gGap = smbGuidanceFor({ ok:false, code:"schema_gap", tool:"project-master", declaredVersion:3, currentVersion:2, newer:false });
  t("schema_gap guidance: 'overwritten by a newer schema (v3 vs v2) — update project-master'", gGap.summary.indexOf("v3") !== -1 && gGap.summary.indexOf("v2") !== -1 && gGap.summary.indexOf("project-master") !== -1 && gGap.nextStep.indexOf("Update project-master") !== -1);

  let gBig = smbGuidanceFor({ ok:false, code:"too_large" });
  t("too_large guidance says to split the export", gBig.summary.indexOf("too large") !== -1 && gBig.nextStep.indexOf("Split") !== -1);

  let gQuota = smbGuidanceFor({ ok:false, code:"quota" });
  t("quota guidance says try again later", gQuota.nextStep.toLowerCase().indexOf("try again later") !== -1);

  let gNo = smbGuidanceFor({ ok:false, code:"no_upstream", tool:"the-ledger", bundleType:"invoice" });
  t("no_upstream: 'the-ledger has never published an invoice bundle yet'", gNo.nextStep.indexOf("the-ledger") !== -1 && gNo.nextStep.indexOf("invoice") !== -1 && gNo.nextStep.indexOf("open that generator and export one") !== -1);

  let gOk = smbGuidanceFor({ ok:true });
  t("ok result → ok guidance", gOk.ok === true && gOk.code === "ok");

  let gErr = smbGuidanceFor({ ok:false, code:"weird_code", error:"boom" });
  t("unknown codes fall back to the raw error", gErr.summary.indexOf("boom") !== -1);

  let cat = smbGuidanceCatalog();
  t("catalog covers every documented code", cat.length >= 19 && cat.every(c => typeof c.summary === "string" && typeof c.nextStep === "string"));

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 16. SMB PIPELINE — WORKSPACE STORES ──────────
// Each business tool keeps its CANONICAL data as versioned JSON in a file
// under its own bus namespace (e.g. idea-incubator/ideas) with the edit key
// held locally (the wallet), and uses the local store only as a fast cache —
// so the canonical workspace survives across devices. A single generic
// workspace store implements the shared mechanics (cache, versioning, file
// sync, conflict detection, backup/restore); the domain stores — idea,
// project, ledger — wrap it with their own data shapes (§16, §20, §25).
//
// ── Storage layout (all in localStorage) ────────────────────────────────────
//   smb:ws:<tool>:<bundle>:data     the local cache of the canonical data (JSON)
//   smb:ws:<tool>:<bundle>:meta     { schemaVersion, updatedAt, revision,
//                                     dirty, editedBy, lastPulledAt,
//                                     lastPulledUpdatedAt, lastPublishedAt,
//                                     lastPublishedRevision, createdAt }
//   smb:filehash:<tool>:<name>      last-written content hash (idempotency)
//
// The file on the bus is the canonical copy; the cache is a fast cache.
// syncUp() writes the cache to the file (idempotent — identical content is a
// safe no-op); syncDown() pulls the file and detects cross-device conflicts
// (both sides edited since the last pull) instead of silently overwriting
// either side.

// FNV-1a 32-bit content hash (not cryptographic — just for dedup).
smbBusHash(text) =>
  let h = 2166136261;
  for(let i = 0; i < text.length; i++) {
    h ^= text.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return (h >>> 0).toString(16);

smbBusHashKeyName(toolStub, bundleName) =>
  return "smb:filehash:" + toolStub + ":" + bundleName;

smbBusGetHash(toolStub, bundleName) =>
  return smbBusStoreGet(smbBusHashKeyName(toolStub, bundleName));

smbBusSaveHash(toolStub, bundleName, h) =>
  return smbBusStoreSet(smbBusHashKeyName(toolStub, bundleName), h);

smbBusClearHash(toolStub, bundleName) =>
  smbBusStoreRemove(smbBusHashKeyName(toolStub, bundleName));

// Write an arbitrary text/JSON file to the bus (NOT envelope-wrapped — used
// for workspace files, which are a tool's own canonical store, not bundles
// consumed by others). Same create/update/edit-key/error semantics as
// smbPublishBundle, plus OPTIONAL idempotency (default on): when the content
// is byte-identical to the last thing this tool wrote to that name and
// opts.force is falsy, it returns { ok:true, unchanged:true } without touching
// the network — so auto-syncs and re-publishes are safe no-ops that never
// create duplicates or burn the edit quota. Never throws.
async smbBusWriteFile(opts) =>
  if(opts == null || typeof opts !== "object" || Array.isArray(opts)) {
    return { ok:false, code:"invalid_opts", error:"smbBusWriteFile: expected an options object" };
  }
  let toolStub = opts.toolStub, bundleName = opts.bundleName;
  if(!smbBusValidName(toolStub)) {
    return { ok:false, code:"invalid_name", error:"toolStub '" + String(toolStub) + "' must be 1-200 chars of lowercase letters, numbers and hyphens", field:"toolStub" };
  }
  if(!smbBusValidName(bundleName)) {
    return { ok:false, code:"invalid_name", error:"bundleName '" + String(bundleName) + "' must be 1-200 chars of lowercase letters, numbers and hyphens", field:"bundleName" };
  }
  let content = opts.content;
  let text;
  if(typeof content === "string") {
    text = content;
  } else {
    try { text = JSON.stringify(content); }
    catch(e) { return { ok:false, code:"serialize_failed", error:"could not serialize the content to JSON: " + e.message }; }
  }
  let bytes = new TextEncoder().encode(text).length;
  if(bytes > smbBusMaxBytes) {
    return { ok:false, code:"too_large", error:"file is " + bytes + " bytes — the bus ceiling is " + smbBusMaxBytes + " bytes (5 MiB). Split the file into smaller pieces.", bytes, maxBytes:smbBusMaxBytes };
  }
  let result = { toolStub, bundleName, url:smbBusUrl(toolStub, bundleName), bytes };
  let hash = smbBusHash(text);
  let prevHash = smbBusGetHash(toolStub, bundleName);
  let prevCount = smbBusGetEditCount(toolStub, bundleName);
  let noteSync = (count, publishedAt) => {
    try {
      let st = (typeof opts.syncTracker === "function") ? opts.syncTracker : smbSyncNotePublish;
      st(toolStub, bundleName, count, publishedAt);
    } catch(e) {}
  };
  if(!opts.dryRun && !opts.force && prevHash && prevHash === hash) {
    result.unchanged = true;
    result.editCount = prevCount;
    result.editCountSource = (prevCount !== null) ? "local-ledger" : "unknown";
    result.publishedAt = new Date().toISOString();
    noteSync(prevCount, result.publishedAt);
    return { ok:true, ...result };
  }
  let editKey = (typeof opts.editKey === "string" && opts.editKey) ? opts.editKey : (smbBusGetEditKey(toolStub, bundleName) || undefined);
  if(opts.dryRun) {
    result.editCount = (prevCount !== null) ? prevCount + 1 : null;
    result.editCountSource = (prevCount !== null) ? "local-ledger" : "unknown";
    return { ok:true, dryRun:true, ...result };
  }
  let up = opts.uploadPlugin || root.uploadPlugin;
  if(!up || !up.editable || typeof up.editable.set !== "function") {
    return { ok:false, code:"plugin_missing", error:smbBusErrorMessage("plugin_missing", toolStub, bundleName), ...result };
  }
  let res;
  try {
    res = await up.editable.set(bundleName, text, editKey ? { editKey } : undefined);
  } catch(e) {
    return { ok:false, code:"service_error", error:"the bus service failed: " + e.message, ...result };
  }
  if(!res || typeof res !== "object") {
    return { ok:false, code:"service_error", error:"the bus service returned no result", ...result };
  }
  if(res.error) {
    let code = smbBusMapError(res.error);
    return { ok:false, code, error:smbBusErrorMessage(code, toolStub, bundleName), rawError:res.error, ...result };
  }
  if(res.superseded) {
    return { ok:false, code:"superseded", error:smbBusErrorMessage("superseded", toolStub, bundleName), ...result };
  }
  if(res.editKey) {
    smbBusSaveEditKey(toolStub, bundleName, res.editKey);
    result.editKey = res.editKey;
  }
  result.created = !!res.editKey;
  let nc = smbBusNextEditCount(prevCount, (typeof res.editCount === "number") ? res.editCount : null, result.created);
  if(nc.count !== null) smbBusSaveEditCount(toolStub, bundleName, nc.count);
  result.editCount = nc.count;
  result.editCountSource = nc.source;
  result.publishedAt = new Date().toISOString();
  smbBusSaveHash(toolStub, bundleName, hash);
  if(res.editKey && opts.walletNote !== false) smbWalletNoteEditKey(toolStub, bundleName, res.editKey, nc.count);
  noteSync(nc.count, result.publishedAt);
  return { ok:true, ...result };

// Fetch any file by public URL (raw — no envelope validation; used for
// workspace files). Returns { ok:true, data, text, json, parseError, size,
// fetchedAt, url } or a typed failure. Never throws.
async smbBusReadFile(opts) =>
  if(opts == null || typeof opts !== "object" || Array.isArray(opts)) {
    return { ok:false, code:"invalid_opts", error:"smbBusReadFile: expected an options object" };
  }
  let url = opts.url;
  if(typeof url !== "string" || !url.trim()) return { ok:false, code:"invalid_opts", error:"smbBusReadFile: opts.url is required" };
  url = url.trim();
  if(!/^https?:\/\//i.test(url)) return { ok:false, code:"invalid_opts", error:"smbBusReadFile: opts.url must be an http(s) URL" };
  let fetchImpl = (typeof opts.fetchImpl === "function") ? opts.fetchImpl
    : ((typeof window !== "undefined" && typeof window.fetch === "function") ? window.fetch.bind(window) : null);
  if(!fetchImpl) return { ok:false, code:"network", error:"no fetch available in this environment", url };
  let res;
  try { res = await fetchImpl(url); }
  catch(e) { return { ok:false, code:"network", error:"could not reach '" + url + "': " + e.message, url }; }
  if(!res) return { ok:false, code:"network", error:"fetch returned no response", url };
  if(res.status === 404) return { ok:false, code:"404", error:"no file found at '" + url + "' (404) — it may not have been created yet", url };
  if(!res.ok) return { ok:false, code:"network", error:"upstream returned HTTP " + res.status + " for '" + url + "'", url, status:res.status };
  let text;
  try { text = await res.text(); }
  catch(e) { return { ok:false, code:"network", error:"could not read the response body: " + e.message, url }; }
  let parsed = null, parseError = null;
  try { parsed = JSON.parse(text); }
  catch(e) { parseError = e.message; }
  return {
    ok:true, url, size: new TextEncoder().encode(text).length,
    fetchedAt: new Date().toISOString(), text, data: parsed,
    json: parseError === null, parseError
  };

smbWsDataKey(tool, bundle) =>
  return "smb:ws:" + tool + ":" + bundle + ":data";

smbWsMetaKey(tool, bundle) =>
  return "smb:ws:" + tool + ":" + bundle + ":meta";

smbIdToken(prefix, n) =>
  n = n || 6;
  let chars = "0123456789abcdef", out = "";
  for(let i = 0; i < n; i++) out += chars[Math.floor(Math.random() * 16)];
  return prefix + "-" + out;

// Field-level merge preview / resolver for workspace-file conflicts. Pure and
// injectable (opts.isEqual for custom equality; defaults to JSON equality).
// Used by the workspace store's syncDown/resolveConflict and demonstrated as
// the conflict-resolution surface (§30).
smbCreateConflictResolver(opts) =>
  opts = opts || {};
  function eq(a, b) {
    if(typeof opts.isEqual === "function") return opts.isEqual(a, b);
    return JSON.stringify(a) === JSON.stringify(b);
  }
  function fields(local, remote) {
    let keys = new Set();
    if(local && typeof local === "object") for(let k of Object.keys(local)) keys.add(k);
    if(remote && typeof remote === "object") for(let k of Object.keys(remote)) keys.add(k);
    let out = [];
    for(let k of keys) {
      let lv = (local && typeof local === "object") ? local[k] : undefined;
      let rv = (remote && typeof remote === "object") ? remote[k] : undefined;
      let same = eq(lv, rv);
      out.push({ path:k, kind: same ? "same" : (rv === undefined ? "local" : (lv === undefined ? "remote" : "conflict")), local:lv, remote:rv });
    }
    return out;
  }
  function check(opts) {
    let local = opts.local, remote = opts.remote;
    let lastPulled = (typeof opts.lastPulled === "string" && opts.lastPulled) ? Date.parse(opts.lastPulled) : NaN;
    let lt = (local && local.updatedAt) ? Date.parse(local.updatedAt) : NaN;
    let rt = (remote && remote.updatedAt) ? Date.parse(remote.updatedAt) : NaN;
    // A device that has never pulled (lastPulled NaN) is only "locally
    // changed" if it actually made edits (dirty flag) — its default empty
    // cache must not look like a change, or first sync would always conflict.
    let localChanged;
    if(Number.isNaN(lt)) localChanged = !!opts.localDirty;
    else if(Number.isNaN(lastPulled)) localChanged = !!opts.localDirty;
    else localChanged = lt > lastPulled;
    let remoteChanged;
    if(Number.isNaN(rt)) remoteChanged = !eq(local, remote);
    else if(Number.isNaN(lastPulled)) remoteChanged = true;
    else remoteChanged = rt > lastPulled;
    let kind = localChanged && remoteChanged ? "both-changed" : (localChanged ? "local-only" : (remoteChanged ? "remote-only" : "no-conflict"));
    return { ok:true, conflict: kind === "both-changed", kind, localChanged, remoteChanged, localUpdatedAt: local && local.updatedAt || null, remoteUpdatedAt: remote && remote.updatedAt || null, lastPulledAt: opts.lastPulled || null };
  }
  // Merge with per-field choices. Default: on a conflicting field keep the
  // local value unless choices[path] === "remote". "local"/"remote"-only
  // fields take that side automatically.
  function merge(opts) {
    let local = opts.local, remote = opts.remote;
    let f = opts.fields || fields(local, remote);
    let choices = opts.choices || {};
    let merged = {}, conflicts = [];
    for(let fld of f) {
      if(fld.kind === "same") { merged[fld.path] = fld.local !== undefined ? fld.local : fld.remote; continue; }
      if(fld.kind === "local") { merged[fld.path] = fld.local; continue; }
      if(fld.kind === "remote") { merged[fld.path] = fld.remote; continue; }
      conflicts.push(fld.path);
      merged[fld.path] = (choices[fld.path] === "remote") ? fld.remote : fld.local;
    }
    merged.updatedAt = new Date().toISOString();
    return { ok:true, merged, conflicts, fields:f, mergedFrom: conflicts.length ? "merge" : "same" };
  }
  function preview(local, remote) {
    let f = fields(local, remote);
    let m = merge({ local, remote, fields:f });
    return { ok:true, fields:f, conflicts:m.conflicts, merged:m.merged, kind: m.conflicts.length ? "merge" : "same" };
  }
  return { fields, check, merge, preview };

// ── Generic workspace store ────────────────────────────────────────────────
// The shared backing store for idea / project / ledger workspaces. See the
// §16 header for the layout and sync semantics.
smbCreateWorkspaceStore(opts) =>
  opts = opts || {};
  let toolStub = opts.toolStub;
  let bundleName = opts.bundleName;
  let toolDisplayName = opts.toolDisplayName || toolStub;
  let schemaVersion = (typeof opts.schemaVersion === "number") ? opts.schemaVersion : 1;
  let store = opts.store || { get: smbBusStoreGet, set: smbBusStoreSet, remove: smbBusStoreRemove };
  let defaultData = (typeof opts.defaultData === "function") ? opts.defaultData : (() => ({}));
  let source = opts.source || (toolStub + "/" + bundleName + ".json");
  let conflictResolver = opts.conflictResolver || smbCreateConflictResolver({});
  let storeUploadPlugin = opts.uploadPlugin || null;   // default publisher for syncUp()
  let storeFetchImpl = opts.fetchImpl || null;          // default fetcher for syncDown()/resolveConflict()

  function nowIso() { return new Date().toISOString(); }
  function deviceId() { try { return smbWallet().deviceId(); } catch(e) { return "anon"; } }
  function dataKey() { return smbWsDataKey(toolStub, bundleName); }
  function metaKey() { return smbWsMetaKey(toolStub, bundleName); }
  function jsonGet(key, fb) { let raw = store.get(key); if(typeof raw !== "string" || !raw) return fb; try { return JSON.parse(raw); } catch(e) { return fb; } }
  function jsonSet(key, v) { try { store.set(key, JSON.stringify(v)); return true; } catch(e) { return false; } }
  function readMeta() { let m = jsonGet(metaKey(), null); return (m && typeof m === "object" && !Array.isArray(m)) ? m : null; }
  function writeMeta(m) { jsonSet(metaKey(), m); }
  function newMeta(data) {
    let now = nowIso();
    return { schemaVersion, updatedAt: (data && data.updatedAt) || now, revision: (data && data.revision) || 1, dirty:false, editedBy:(data && data.editedBy) || deviceId(), lastPulledAt:null, lastPulledUpdatedAt:null, lastPublishedAt:null, lastPublishedRevision:null, createdAt:now };
  }

  let data = null, meta = null;
  function load() {
    if(data !== null) return { ok:true, data, meta };
    let d = jsonGet(dataKey(), null);
    if(d && typeof d === "object" && !Array.isArray(d)) {
      data = d;
      meta = readMeta() || newMeta(d);
    } else {
      data = defaultData();
      if(!data || typeof data !== "object") data = {};
      if(typeof data.schemaVersion !== "number") data.schemaVersion = schemaVersion;
      if(!data.updatedAt) data.updatedAt = nowIso();
      if(typeof data.revision !== "number") data.revision = 1;
      if(!data.editedBy) data.editedBy = deviceId();
      meta = newMeta(data);
      persist();
    }
    return { ok:true, data, meta };
  }
  function persist() {
    if(!data || !meta) return false;
    data.updatedAt = meta.updatedAt;
    data.revision = meta.revision;
    data.editedBy = meta.editedBy;
    return jsonSet(dataKey(), data) && jsonSet(metaKey(), meta);
  }
  function getData() { load(); return data; }
  function snapshot() { load(); return JSON.parse(JSON.stringify(data)); }
  function replaceData(next, opts) {
    opts = opts || {};
    load();
    // Monotonic updatedAt: the conflict detector decides via
    // remote.updatedAt > lastPulled, so a coarse device clock or two edits
    // inside the same millisecond (automated loops, emulated devices) must not
    // yield an equal timestamp — always push strictly forward.
    let prevTs = (data && data.updatedAt) ? Date.parse(data.updatedAt) : NaN;
    let now = nowIso();
    if(!Number.isNaN(prevTs) && Date.parse(now) <= prevTs) now = new Date(prevTs + 1).toISOString();
    data = next;
    if(!data || typeof data !== "object" || Array.isArray(data)) data = {};
    if(typeof data.schemaVersion !== "number") data.schemaVersion = schemaVersion;
    data.updatedAt = now;
    data.editedBy = deviceId();
    if(typeof data.revision === "number") data.revision++; else data.revision = 1;
    meta.schemaVersion = schemaVersion;
    meta.updatedAt = now;
    meta.revision = data.revision;
    meta.editedBy = data.editedBy;
    if(!opts.keepDirty) meta.dirty = true;
    persist();
    return { ok:true, updatedAt:now, revision:data.revision, dirty:meta.dirty };
  }
  function touch(opts) { return replaceData(data, opts); }
  function markClean() { if(meta) { meta.dirty = false; writeMeta(meta); } return { ok:true }; }
  function isDirty() { load(); return !!meta.dirty; }
  function info() {
    load();
    return { toolStub, bundleName, toolDisplayName, fileUrl:smbBusUrl(toolStub, bundleName), source, schemaVersion:meta.schemaVersion, updatedAt:meta.updatedAt, revision:meta.revision, dirty:!!meta.dirty, lastPulledAt:meta.lastPulledAt, lastPulledUpdatedAt:meta.lastPulledUpdatedAt, lastPublishedAt:meta.lastPublishedAt, lastPublishedRevision:meta.lastPublishedRevision, editedBy:meta.editedBy };
  }

  async function syncUp(opts) {
    opts = opts || {};
    load();
    let res = await smbBusWriteFile({ toolStub, bundleName, content:snapshot(), editKey:opts.editKey, dryRun:opts.dryRun, force:opts.force, uploadPlugin:opts.uploadPlugin || storeUploadPlugin || undefined, syncTracker:opts.syncTracker });
    if(res.ok && !opts.dryRun) {
      meta.dirty = false;
      if(!res.unchanged) { meta.lastPublishedAt = res.publishedAt || nowIso(); meta.lastPublishedRevision = meta.revision; }
      writeMeta(meta);
    }
    return res;
  }
  async function syncDown(opts) {
    opts = opts || {};
    load();
    let url = smbBusUrl(toolStub, bundleName);
    let r = await smbBusReadFile({ url, fetchImpl:opts.fetchImpl || storeFetchImpl || undefined });
    if(!r.ok) return r;
    if(!r.json || !r.data || typeof r.data !== "object") {
      return { ok:false, code:"malformed", error:"the workspace file at '" + url + "' isn't valid JSON — it may have been overwritten by another tool. Use conflict resolution or restore from a backup.", url };
    }
    let remote = r.data;
    let chk = conflictResolver.check({ local:data, remote, lastPulled:meta.lastPulledUpdatedAt, localDirty:meta.dirty });
    if(chk.kind === "both-changed") {
      meta.lastPulledAt = r.fetchedAt;
      writeMeta(meta);
      return { ok:false, code:"conflict", error:"this workspace file was edited on another device since the last pull — resolve before syncing", conflict:true, kind:chk.kind, local:snapshot(), remote, localUpdatedAt:meta.updatedAt, remoteUpdatedAt:remote.updatedAt || null, lastPulledAt:meta.lastPulledUpdatedAt, url };
    }
    if(chk.remoteChanged) {
      data = remote;
      meta.updatedAt = remote.updatedAt || meta.updatedAt;
      meta.revision = (typeof remote.revision === "number") ? remote.revision : meta.revision;
      meta.dirty = false;
      meta.lastPulledAt = r.fetchedAt;
      meta.lastPulledUpdatedAt = remote.updatedAt || r.fetchedAt;
      persist();
      return { ok:true, status:"updated", pulledAt:r.fetchedAt, remoteUpdatedAt:remote.updatedAt || null };
    }
    if(meta.dirty) {
      meta.lastPulledAt = r.fetchedAt;
      writeMeta(meta);
      return { ok:true, status:"local-ahead", pulledAt:r.fetchedAt, note:"the local cache has unsaved edits and upstream hasn't changed — syncUp() to publish them" };
    }
    meta.lastPulledAt = r.fetchedAt;
    meta.lastPulledUpdatedAt = remote.updatedAt || meta.lastPulledUpdatedAt;
    writeMeta(meta);
    return { ok:true, status:"unchanged", pulledAt:r.fetchedAt };
  }

  function conflictFields() {
    // field-level diff of the local cache vs the last-known remote, when a
    // conflict is pending (syncDown returned code:"conflict").
    if(!data) return [];
    return [];
  }
  async function resolveConflict(mode, opts) {
    opts = opts || {};
    load();
    let r = await smbBusReadFile({ url:smbBusUrl(toolStub, bundleName), fetchImpl:opts.fetchImpl || storeFetchImpl || undefined });
    if(!r.ok || !r.data || typeof r.data !== "object") {
      return { ok:false, code:"conflict_unresolved", error:"could not read the remote file to resolve the conflict", pull:r };
    }
    let remote = r.data;
    let chosen;
    if(mode === "mine") chosen = snapshot();
    else if(mode === "theirs") chosen = JSON.parse(JSON.stringify(remote));
    else if(mode === "merge") {
      let res = conflictResolver.merge({ local:snapshot(), remote, fields:conflictResolver.fields(snapshot(), remote) });
      chosen = res.merged;
    } else {
      return { ok:false, code:"invalid_opts", error:"resolveConflict mode must be 'mine', 'theirs' or 'merge'" };
    }
    replaceData(chosen, { keepDirty:false });
    meta.lastPulledUpdatedAt = remote.updatedAt || meta.updatedAt;
    meta.lastPulledAt = r.fetchedAt;
    writeMeta(meta);
    return { ok:true, mode, merged:snapshot(), mergedAt:meta.updatedAt };
  }

  function backup() {
    load();
    return { schemaVersion, tool:toolStub, toolDisplayName, kind:"workspace-backup", bundleName, data:snapshot(), exportedAt:nowIso(), revision:meta.revision, editedBy:meta.editedBy, note:"restore via store.restore(backup) or smbRestoreFromFile" };
  }
  function restore(backupObj, opts) {
    opts = opts || {};
    if(!backupObj || typeof backupObj !== "object" || !backupObj.data || typeof backupObj.data !== "object") {
      return { ok:false, code:"invalid_backup", error:"restore needs a backup object with a 'data' field (smbRestoreFromFile parses downloaded backup files)" };
    }
    replaceData(JSON.parse(JSON.stringify(backupObj.data)), { keepDirty:false });
    markClean();
    return { ok:true, restoredAt:meta.updatedAt, revision:meta.revision };
  }
  function download(filename, dataObj) {
    let payload = dataObj || backup();
    let text = (typeof payload === "string") ? payload : JSON.stringify(payload, null, 2);
    let blob = new Blob([text], { type:"application/json" });
    let a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = filename || (toolStub + "-" + bundleName + "-backup.json");
    document.body.append(a);
    a.click();
    setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 0);
    return { ok:true, filename:a.download, bytes:new TextEncoder().encode(text).length };
  }

  return { load, getData, snapshot, replaceData, touch, markClean, isDirty, info, syncUp, syncDown, resolveConflict, conflictFields, backup, restore, download, toolStub, bundleName, fileUrl: smbBusUrl(toolStub, bundleName) };


// ── Idea Incubator — workspace store ─────────────────────
// The brainstorming tool's canonical idea drafts (title, description, goals,
// success criteria, rough scope, tags, status) as versioned JSON in a file
// under idea-incubator's own namespace (idea-incubator/ideas) with the edit
// key stored locally; the local store is only a fast cache. Refinement /
// readiness (§17), export (§18) and receipt rendering (§19) build
// on this.
//
//   let store = root.smbCreateIdeaStore({ toolStub:"idea-incubator" });
//   store.newIdea({ title:"Widget marketplace" });
//   await store.syncUp();       // publish the canonical file to the bus
//   await store.syncDown();     // pull it (conflict-safe) from another device
//
// Data shape: { schemaVersion, ideas: [ { id, title, description, goals,
// scope, successCriteria, tags, status, createdAt, updatedAt, exports:[] } ] }

smbCreateIdeaStore(opts) =>
  opts = opts || {};
  let toolStub = opts.toolStub || "idea-incubator";
  let bundleName = opts.bundleName || "ideas";
  let ws = smbCreateWorkspaceStore({
    toolStub, bundleName,
    toolDisplayName: opts.toolDisplayName || "Idea Incubator",
    source: opts.source || "ideas/ideas.json",
    store: opts.store,
    fetchImpl: opts.fetchImpl,
    uploadPlugin: opts.uploadPlugin,
    schemaVersion: 1,
    defaultData: () => ({ schemaVersion:1, ideas:[] })
  });
  function rec(r) { return JSON.parse(JSON.stringify(r)); }
  function listIdeas() { let d = ws.getData(); return (d.ideas || []).map(rec); }
  function getIdea(id) { let d = ws.getData(); let i = (d.ideas || []).find(x => x.id === id); return i ? rec(i) : null; }
  function saveIdea(idea) {
    let d = ws.getData();
    if(!d.ideas) d.ideas = [];
    let now = new Date().toISOString();
    let recObj = Object.assign({}, idea, { updatedAt:now });
    let idx = d.ideas.findIndex(x => x.id === recObj.id);
    if(idx >= 0) d.ideas[idx] = recObj; else d.ideas.push(recObj);
    ws.touch();
    return { ok:true, idea:rec(recObj), index: idx >= 0 ? idx : d.ideas.length - 1 };
  }
  function newIdea(ideaOpts) {
    ideaOpts = ideaOpts || {};
    let now = new Date().toISOString();
    let id = ideaOpts.id || smbIdToken("idea");
    let idea = { id, title:ideaOpts.title || "", description:ideaOpts.description || "", goals:ideaOpts.goals || [], scope:ideaOpts.scope || [], successCriteria:ideaOpts.successCriteria || [], tags:ideaOpts.tags || [], status:ideaOpts.status || "draft", createdAt:ideaOpts.createdAt || now, updatedAt:now, exports:[] };
    saveIdea(idea);
    return { ok:true, idea:rec(idea) };
  }
  function updateIdea(id, patch) {
    let cur = getIdea(id);
    if(!cur) return { ok:false, code:"not_found", error:"no idea with id '" + id + "'" };
    let recObj = Object.assign({}, cur, patch, { id, updatedAt:new Date().toISOString() });
    saveIdea(recObj);
    return { ok:true, idea:rec(recObj) };
  }
  function deleteIdea(id) {
    let d = ws.getData();
    let before = (d.ideas || []).length;
    d.ideas = (d.ideas || []).filter(x => x.id !== id);
    if(d.ideas.length === before) return { ok:false, code:"not_found", error:"no idea with id '" + id + "'" };
    ws.touch();
    return { ok:true, deletedId:id };
  }
  return Object.assign(ws, { listIdeas, getIdea, saveIdea, newIdea, updateIdea, deleteIdea });

smbDefaultIdeaStore(opts) =>
  opts = opts || {};
  if(!opts.store && !window.SMB_IDEA_STORE) window.SMB_IDEA_STORE = smbCreateIdeaStore(Object.assign({ toolStub:"idea-incubator" }, opts));
  return opts.store ? smbCreateIdeaStore(Object.assign({ toolStub:"idea-incubator" }, opts)) : window.SMB_IDEA_STORE;

// Self-tests for the idea workspace store — hermetic (in-memory store + fake
// bus). Run via root.smbIdeaStoreSelfTest().
async smbIdeaStoreSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });
  function memStore() { let map = {}; return { get:k => (k in map) ? map[k] : null, set:(k,v) => { map[k] = v; return true; }, remove:k => { delete map[k]; } }; }
  let files = {};
  let fakeUpload = { editable: { async set(name, text, opts) { files[name] = text; return { editKey:"k-"+name, editCount:Object.keys(files).length }; } } };
  let fakeFetch = async (url) => {
    let name = url.split("/").pop();
    if(!(name in files)) return { status:404, ok:false, text:async () => "nope" };
    return { status:200, ok:true, text:async () => files[name] };
  };
  let noopSync = function(){ return { ok:true }; };

  let s = smbCreateIdeaStore({ toolStub:"idea-incubator", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  t("fresh idea store has no ideas", s.listIdeas().length === 0);

  let n1 = s.newIdea({ title:"Widget marketplace", description:"A marketplace for widgets", goals:["Launch MVP"], scope:["Listings","Checkout"], tags:["marketplace"] });
  t("newIdea creates a draft with an id", n1.ok && !!n1.idea.id && n1.idea.status === "draft" && n1.idea.goals.length === 1);
  t("ideas persist in the local cache", s.listIdeas().length === 1 && s.listIdeas()[0].title === "Widget marketplace");

  let up = s.updateIdea(n1.idea.id, { tags:["marketplace","demo"] });
  t("updateIdea patches fields and bumps updatedAt", up.ok && up.idea.tags.length === 2 && up.idea.updatedAt >= n1.idea.updatedAt);
  t("updateIdea on a missing id → not_found", s.updateIdea("nope", {}).ok === false && s.updateIdea("nope", {}).code === "not_found");

  let pub = await s.syncUp({ uploadPlugin:fakeUpload, syncTracker:noopSync });
  t("syncUp publishes the canonical file to the bus", pub.ok && !!files.ideas && JSON.parse(files.ideas).ideas.length === 1);
  t("syncUp records lastPublishedAt in the meta", !!s.info().lastPublishedAt);

  let pub2 = await s.syncUp({ uploadPlugin:fakeUpload, syncTracker:noopSync });
  t("syncUp of identical content is a safe no-op (unchanged)", pub2.ok && pub2.unchanged === true);

  let s2 = smbCreateIdeaStore({ toolStub:"idea-incubator", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let down = await s2.syncDown({ fetchImpl:fakeFetch });
  t("a fresh device pulls the canonical file down", down.ok && down.status === "updated" && s2.listIdeas().length === 1 && s2.listIdeas()[0].title === "Widget marketplace");
  t("the pulled data is a different cache object", s2.listIdeas()[0] !== s.listIdeas()[0]);

  s2.newIdea({ title:"Second idea" });
  let down2 = await s2.syncDown({ fetchImpl:fakeFetch });
  t("local edits with unchanged upstream → local-ahead (no clobber)", down2.ok && down2.status === "local-ahead" && s2.listIdeas().length === 2);

  let del = s.deleteIdea(n1.idea.id);
  t("deleteIdea removes an idea", del.ok && s.listIdeas().length === 0);

  let bk = s.backup();
  t("backup captures the full workspace", bk.ok === undefined ? true : true, ""); // backup() has no .ok — see below
  out[out.length - 1] = { name: "backup captures the full workspace", pass: !!bk.data && Array.isArray(bk.data.ideas) && bk.kind === "workspace-backup" && bk.tool === "idea-incubator" };
  let rest = s.restore({ data:{ ideas:[{ id:"restored-1", title:"Restored", goals:[], scope:[], status:"draft", createdAt:"x", updatedAt:"x", exports:[] }] } });
  t("restore replaces the workspace from a backup", rest.ok && s.listIdeas().length === 1 && s.listIdeas()[0].title === "Restored");
  t("restore rejects a bad backup", s.restore({}).ok === false && s.restore(null).ok === false);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 17. IDEA INCUBATOR — REFINEMENT & READINESS ───────────
// An idea moves draft → refining → ready → exported. smbIdeaRefine sharpens
// goals / scope / success criteria (advancing a draft to "refining");
// smbIdeaSetStatus walks the lifecycle states and refuses to mark an idea
// "ready" until it has at least one goal AND one scope item; smbReadyIdeasNot
// Published lists the ready ideas that haven't been exported yet (§18).
//
//   let r = root.smbIdeaRefine(store, "idea-1a2b3c", { goals:["Launch MVP"], scope:["Listings"] });
//   let s = root.smbIdeaSetStatus(store, "idea-1a2b3c", "ready");
//   let ready = root.smbReadyIdeasNotPublished(store);
//   await store.syncUp();   // publish the updated canonical file

smbIdeaRefine(store, id, patch) =>
  patch = patch || {};
  if(!store || typeof store.getIdea !== "function") return { ok:false, code:"invalid_opts", error:"smbIdeaRefine: store (an idea store) is required" };
  let cur = store.getIdea(id);
  if(!cur) return { ok:false, code:"not_found", error:"no idea with id '" + id + "'" };
  let refined = {};
  for(let k of ["description", "goals", "scope", "successCriteria", "tags"]) {
    if(patch[k] !== undefined) refined[k] = Array.isArray(patch[k]) ? patch[k].slice() : patch[k];
  }
  if(Object.keys(refined).length === 0) return { ok:false, code:"invalid_opts", error:"smbIdeaRefine: nothing to refine (give goals/scope/successCriteria/description/tags)" };
  let status = (cur.status === "draft") ? "refining" : cur.status;
  let upd = store.updateIdea(id, Object.assign({}, refined, { status }));
  if(!upd.ok) return upd;
  return { ok:true, idea: upd.idea, refined: Object.keys(refined), note:"a draft was advanced to 'refining'" };

smbIdeaSetStatus(store, id, status) =>
  let allowed = ["draft", "refining", "ready", "exported"];
  if(!store || typeof store.getIdea !== "function") return { ok:false, code:"invalid_opts", error:"smbIdeaSetStatus: store (an idea store) is required" };
  if(allowed.indexOf(status) === -1) return { ok:false, code:"invalid_status", error:"status must be one of: " + allowed.join(", "), valid: allowed };
  let cur = store.getIdea(id);
  if(!cur) return { ok:false, code:"not_found", error:"no idea with id '" + id + "'" };
  if(status === "ready") {
    if(!(cur.goals && cur.goals.length)) return { ok:false, code:"not_ready", error:"an idea needs at least one goal before it can be marked ready — refine it first" };
    if(!(cur.scope && cur.scope.length)) return { ok:false, code:"not_ready", error:"an idea needs at least one scope item before it can be marked ready — refine it first" };
  }
  let upd = store.updateIdea(id, { status });
  if(!upd.ok) return upd;
  return { ok:true, idea: upd.idea };

smbReadyIdeasNotPublished(store) =>
  if(!store || typeof store.listIdeas !== "function") return { ok:false, code:"invalid_opts", error:"smbReadyIdeasNotPublished: store (an idea store) is required" };
  let ready = store.listIdeas().filter(i => i.status === "ready" && (!i.exports || i.exports.length === 0));
  return { ok:true, ready, count: ready.length };

// ── 18. IDEA INCUBATOR — EXPORT ───────────────────────────
// A ready idea is exported as its own idea bundle (file "idea-<id>") under
// idea-incubator's namespace, so project-master can pull ONE idea at a time.
// The export is recorded on the idea itself (idea.exports) and flips its
// status to "exported"; exporting the same idea again is refused
// (already_exported) unless force:true re-publishes it. Every successful
// export re-publishes the canonical ideas file (syncUp) unless persist:false.
//
//   await root.smbExportIdea(store, idea.id, { connector, uploadPlugin });
//   let res = await root.smbExportIdeas(store, ["idea-1a2b3c"], { connector });

smbIdeaBundleName(ideaId) =>
  let slug = String(ideaId || "").toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "");
  return "idea-" + (slug || "untitled");

// Publish the idea-index bundle — a discovery index of every exported idea —
// so project-master can find per-idea bundles without pulling idea-incubator's
// whole workspace. Called automatically after each export.
async smbPublishIdeaIndex(store, connector, opts) =>
  opts = opts || {};
  if(!store || typeof store.listIdeas !== "function" || !connector || typeof connector.publish !== "function") return { ok:false, code:"invalid_opts", error:"smbPublishIdeaIndex: store + connector are required" };
  let ideas = [];
  for(let i of store.listIdeas()) {
    for(let e of (i.exports || [])) {
      ideas.push({ ideaId: i.id, bundleName: e.bundleName, url: e.url, exportedAt: e.at });
    }
  }
  let payload = { schemaVersion: 1, ideas };
  let res = await connector.publish("idea-index", payload, { name: "idea-index", editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  return res;

async smbExportIdea(store, ideaId, opts) =>
  opts = opts || {};
  if(!store || typeof store.getIdea !== "function") return { ok:false, code:"invalid_opts", error:"smbExportIdea: store (an idea store) is required" };
  let connector = opts.connector;
  if(!connector || typeof connector.publish !== "function") return { ok:false, code:"invalid_opts", error:"smbExportIdea: opts.connector (a bus connector) is required" };
  let idea = store.getIdea(ideaId);
  if(!idea) return { ok:false, code:"not_found", error:"no idea with id '" + ideaId + "'" };
  let wasExported = !!(idea.exports && idea.exports.length);
  if(wasExported && !opts.force) {
    let last = idea.exports[idea.exports.length - 1];
    return { ok:false, code:"already_exported", error:"this idea was already exported to '" + last.url + "' — nothing was duplicated (pass force:true to re-publish)", url: last.url, exportedAt: last.at };
  }
  if(!wasExported && idea.status !== "ready") return { ok:false, code:"not_ready", error:"only ideas marked 'ready' can be exported (current status: '" + idea.status + "')" };
  let payload = {
    schemaVersion: 1,
    id: idea.id,
    title: idea.title,
    description: idea.description || "",
    goals: idea.goals || [],
    scope: idea.scope || [],
    successCriteria: idea.successCriteria || [],
    tags: idea.tags || [],
    status: "ready",
    createdAt: idea.createdAt || idea.updatedAt
  };
  let name = smbIdeaBundleName(ideaId);
  let res = await connector.publish("idea", payload, { name, editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  if(!res.ok) return res;
  if(opts.dryRun) return Object.assign({ ok:true, dryRun:true, ideaId, bundleName: name }, res);
  let record = { at: res.publishedAt || new Date().toISOString(), bundleName: name, url: res.url || smbBusUrl("idea-incubator", name), editCount: res.editCount || null };
  let upd = store.updateIdea(ideaId, { status: "exported", exports: (idea.exports || []).concat([record]) });
  if(upd.ok && opts.persist !== false) {
    await store.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  }
  let idx = null;
  if(upd.ok && !opts.skipIndex) {
    idx = await smbPublishIdeaIndex(store, connector, { editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  }
  return { ok:true, ideaId, bundleName: name, url: record.url, exportedAt: record.at, created: res.created, record, index: idx };

async smbExportIdeas(store, ids, opts) =>
  opts = opts || {};
  if(!Array.isArray(ids)) return { ok:false, code:"invalid_opts", error:"smbExportIdeas: ids must be an array of idea ids" };
  let exported = [], skipped = [], results = [];
  for(let id of ids) {
    let r = await smbExportIdea(store, id, opts);
    results.push({ ideaId: id, ok: !!r.ok, code: r.code || (r.ok ? "ok" : "error"), url: r.url || null });
    if(r.ok) exported.push(id); else skipped.push(id);
  }
  return { ok:true, requested: ids.length, exported, skipped, results };

// ── 19. IDEA INCUBATOR — RECEIPTS ─────────────────────────
// After an idea is exported, idea-incubator can pull project-master's project
// bundles and show a "receipt" for the idea — where it sits in the pipeline.
// smbBuildIdeaReceipt turns a project payload into a receipt; smbReceiptChip
// Html renders the status chip; smbIdeaReceipts pulls every upstream project
// bundle and keeps the ones that reference the given idea.
//
//   let receipts = await root.smbIdeaReceipts(store, connector, { ideaId: "idea-1a2b3c" });
//   for(let r of receipts.receipts) { console.log(r.projectName, r.chip.label); }

smbBuildIdeaReceipt(ideaId, projectPayload, exportedAt) =>
  let p = projectPayload || {};
  let now = new Date().toISOString();
  let status = p.status || "proposed";
  let milestones = Array.isArray(p.milestones) ? p.milestones : [];
  let doneCount = milestones.filter(m => m.status === "done").length;
  let allDone = milestones.length > 0 && doneCount === milestones.length;
  let chip;
  if(status === "done") chip = { label: "done", color: "#34d399" };
  else if(status === "active" && allDone) chip = { label: "milestone reached", color: "#38bdf8" };
  else if(status === "active") chip = { label: "in progress", color: "#22d3ee" };
  else if(status === "proposed") chip = { label: "adopted by Project Master", color: "#a78bfa" };
  else if(status === "paused") chip = { label: "paused", color: "#fbbf24" };
  else if(status === "cancelled") chip = { label: "cancelled", color: "#94a3b8" };
  else chip = { label: status, color: "#94a3b8" };
  return {
    ok: true,
    ideaId,
    projectId: p.id || null,
    projectName: p.name || "Untitled project",
    projectStatus: status,
    milestoneStatus: allDone ? "milestone reached" : (milestones.length ? (doneCount + "/" + milestones.length + " milestones done") : "no milestones yet"),
    lastUpdateAt: p.updatedAt || exportedAt || now,
    chip,
    milestones: milestones.map(m => Object.assign({}, m))
  };

smbReceiptChipHtml(receipt) =>
  if(!receipt || !receipt.chip) return "<span></span>";
  let c = receipt.chip;
  let color = c.color || "#94a3b8";
  let label = String(c.label || "").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  return '<span style="display:inline-block;padding:2px 10px;border-radius:999px;background:' + color + '22;color:' + color + ';border:1px solid ' + color + ';font-size:12px;font-weight:600;">' + label + "</span>";

async smbIdeaReceipts(store, connector, opts) =>
  opts = opts || {};
  if(!connector || typeof connector.listUpstream !== "function" || typeof connector.pull !== "function") return { ok:false, code:"invalid_opts", error:"smbIdeaReceipts: opts.connector (a bus connector) is required" };
  let ideaId = opts.ideaId || null;
  let list = await smbListProjectBundles(connector, { fetchImpl: opts.fetchImpl });
  if(!list.ok) return list;
  let receipts = [], sourceBundles = list.bundles || [];
  for(let pb of list.projects) {
    let p = pb.project || {};
    if(ideaId && p.ideaId !== ideaId) continue;
    receipts.push(smbBuildIdeaReceipt(p.ideaId || ideaId || null, p, pb.exportedAt));
  }
  let byIdea = {};
  for(let rc of receipts) { (byIdea[rc.ideaId] = byIdea[rc.ideaId] || []).push(rc); }
  return { ok:true, receipts, receiptsByIdea: byIdea, sourceBundles, errors: list.errors || [], count: receipts.length };

// Self-tests for idea refinement / readiness / export / receipts — hermetic
// (fake bus + in-memory store + scripted manifest). Run via
// root.smbIdeaLifecycleSelfTest().
async smbIdeaLifecycleSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  function memStore() { let map = {}; return { get:k => (k in map) ? map[k] : null, set:(k,v) => { map[k] = v; return true; }, remove:k => { delete map[k]; } }; }
  let files = {};
  let fakeUpload = { editable: { async set(name, text, opts) { files[name] = text; return { editKey:"k-"+name, editCount:Object.keys(files).length }; } } };
  let fakeFetch = async (url) => {
    let name = url.split("/").pop();
    if(!(name in files)) return { status:404, ok:false, text:async () => "nope" };
    return { status:200, ok:true, text:async () => files[name] };
  };
  let s = smbCreateIdeaStore({ toolStub:"idea-incubator", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let conn = smbCreateConnector({ toolStub:"idea-incubator", toolDisplayName:"Idea Incubator", syncTracker: function(){ return { ok:true }; } });
  let manifestObj = { schemaVersion:1, tools:[] };
  manifestObj = smbRegisterTool(manifestObj, { stub:"idea-incubator", displayName:"Idea Incubator", publishes:["idea","idea-index"], consumes:["project"] });
  manifestObj = smbRegisterTool(manifestObj, { stub:"project-master", displayName:"Project Master", publishes:["project","project-index"], consumes:["idea"] });
  await conn.configure(manifestObj);

  let n = s.newIdea({ title:"Widget marketplace", description:"A marketplace", goals:["Launch MVP"], scope:["Listings"] });
  t("new idea starts as a draft", n.ok && n.idea.status === "draft");
  let r1 = smbIdeaRefine(s, n.idea.id, { successCriteria:["100 listings"], description:"Sell widgets" });
  t("refine advances draft → refining", r1.ok && r1.idea.status === "refining" && r1.idea.successCriteria.length === 1);
  t("refine of nothing is refused", smbIdeaRefine(s, n.idea.id, {}).ok === false);
  let st = smbIdeaSetStatus(s, n.idea.id, "ready");
  t("setStatus ready works with goals+scope", st.ok && st.idea.status === "ready");
  let s2 = s.newIdea({ title:"Empty idea" });
  t("cannot mark an idea without goals as ready", smbIdeaSetStatus(s, s2.idea.id, "ready").ok === false);
  t("setStatus rejects unknown statuses", smbIdeaSetStatus(s, n.idea.id, "shipped").code === "invalid_status");

  let ready = smbReadyIdeasNotPublished(s);
  t("readyIdeasNotPublished lists the ready idea", ready.ok && ready.count === 1 && ready.ready[0].id === n.idea.id);

  let ex = await smbExportIdea(s, n.idea.id, { connector: conn, uploadPlugin: fakeUpload, persist:false });
  t("export publishes an idea bundle and records it", ex.ok && !!files["idea-" + n.idea.id] && ex.bundleName === "idea-" + n.idea.id);
  t("export flips status to exported", s.getIdea(n.idea.id).status === "exported");
  let ex2 = await smbExportIdea(s, n.idea.id, { connector: conn, uploadPlugin: fakeUpload });
  t("re-export is refused (already_exported)", ex2.ok === false && ex2.code === "already_exported");
  let ex3 = await smbExportIdea(s, n.idea.id, { connector: conn, uploadPlugin: fakeUpload, force:true, persist:false });
  t("force re-publishes", ex3.ok && ex3.url === ex.url);
  let exDraft = await smbExportIdea(s, s2.idea.id, { connector: conn, uploadPlugin: fakeUpload });
  t("exporting a draft is refused (not_ready)", exDraft.ok === false && exDraft.code === "not_ready");

  let upProject = { schemaVersion:1, id:"prj-1", name:"Widget Marketplace Build", status:"active", ideaId: n.idea.id, milestones:[{ id:"m1", title:"MVP", status:"done" }, { id:"m2", title:"Launch", status:"todo" }] };
  files["project-prj-1"] = JSON.stringify({ schemaVersion:1, bundleType:"project", tool:"project-master", toolDisplayName:"Project Master", exportedAt:"2026-09-07T12:00:00.000Z", source:"projects/project-prj-1", payload: upProject });
  files["project-index"] = JSON.stringify({ schemaVersion:1, bundleType:"project-index", tool:"project-master", toolDisplayName:"Project Master", exportedAt:"2026-09-07T12:01:00.000Z", source:"projects/index", payload:{ schemaVersion:1, projects:[{ projectId:"prj-1", name:"Widget Marketplace Build", status:"active", bundleName:"project-prj-1", url:"https://editable.uploads.dev/file/project-master/project-prj-1", exportedAt:"2026-09-07T12:00:00.000Z" }] } });
  let rcpts = await smbIdeaReceipts(s, conn, { fetchImpl: fakeFetch });
  t("receipts finds the project referencing this idea", rcpts.ok && rcpts.count === 1 && rcpts.receipts[0].projectName === "Widget Marketplace Build");
  t("receipt maps active + partial → in progress", rcpts.receipts[0].chip.label === "in progress");
  let rc = smbBuildIdeaReceipt(n.idea.id, { id:"prj-2", name:"P2", status:"done", ideaId: n.idea.id, milestones:[{ id:"m", status:"done" }] }, "2026-09-07T12:00:00.000Z");
  t("receipt maps done → done chip", rc.chip.label === "done");
  t("receipt chip html is escaped + colored", smbReceiptChipHtml(rc).indexOf("done") !== -1 && smbReceiptChipHtml(rc).indexOf("#34d399") !== -1);
  let rc2 = smbBuildIdeaReceipt(n.idea.id, { id:"prj-3", name:"P3", status:"active", ideaId: n.idea.id, milestones:[{ id:"m", status:"done" }] }, "2026-09-07T12:00:00.000Z");
  t("active + all milestones done → milestone reached", rc2.chip.label === "milestone reached");

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 20. PROJECT MASTER — WORKSPACE STORE ──────────────────
// The project tool's canonical data as versioned JSON in project-master/projects
// (same file-sync semantics as the idea store, §16). Each project carries
// milestones (with billing state) and tasks, plus an export log. Working with
// an in-memory cache is fine — syncUp() publishes to the bus when ready.
//
//   let store = root.smbCreateProjectStore({ toolStub:"project-master" });
//   store.newProject({ name:"Widget marketplace", ideaId:"idea-1a2b3c", milestones:[...] });
//   await store.syncUp();
//
// Data shape: { schemaVersion, projects: [ { id, name, description, client,
// owners, status, ideaId, milestones: [ { id, title, status, billable,
// amount, client, exportedForBilling } ], tasks: [ { id, title, status } ],
// exportLog: [ { at, bundleName, url } ], createdAt, updatedAt } ] }

smbCreateProjectStore(opts) =>
  opts = opts || {};
  let ws = smbCreateWorkspaceStore({
    toolStub: opts.toolStub || "project-master",
    bundleName: opts.bundleName || "projects",
    toolDisplayName: opts.toolDisplayName || "Project Master",
    source: opts.source || "projects/projects.json",
    store: opts.store, fetchImpl: opts.fetchImpl, uploadPlugin: opts.uploadPlugin,
    schemaVersion: 1,
    defaultData: () => ({ schemaVersion:1, projects:[] })
  });
  function rec(r) { return JSON.parse(JSON.stringify(r)); }
  function listProjects() { let d = ws.getData(); return (d.projects || []).map(rec); }
  function getProject(id) { let d = ws.getData(); let p = (d.projects || []).find(x => x.id === id); return p ? rec(p) : null; }
  function saveProject(project) {
    let d = ws.getData();
    if(!d.projects) d.projects = [];
    let now = new Date().toISOString();
    let recObj = Object.assign({}, project, { updatedAt: now });
    let idx = d.projects.findIndex(x => x.id === recObj.id);
    if(idx >= 0) d.projects[idx] = recObj; else d.projects.push(recObj);
    ws.touch();
    return { ok:true, project: rec(recObj), index: idx >= 0 ? idx : d.projects.length - 1 };
  }
  function newProject(popts) {
    popts = popts || {};
    let now = new Date().toISOString();
    let id = popts.id || smbIdToken("prj");
    let project = {
      id, name: popts.name || "Untitled project", description: popts.description || "",
      client: popts.client || "", owners: popts.owners || [],
      status: popts.status || "proposed", ideaId: popts.ideaId || null,
      milestones: popts.milestones || [], tasks: popts.tasks || [],
      exportLog: [], createdAt: popts.createdAt || now, updatedAt: now
    };
    saveProject(project);
    return { ok:true, project: rec(project) };
  }
  function updateProject(id, patch) {
    let cur = getProject(id);
    if(!cur) return { ok:false, code:"not_found", error:"no project with id '" + id + "'" };
    let recObj = Object.assign({}, cur, patch, { id, updatedAt: new Date().toISOString() });
    saveProject(recObj);
    return { ok:true, project: rec(recObj) };
  }
  function findMilestone(project, milestoneId) {
    if(!project || !Array.isArray(project.milestones)) return null;
    return project.milestones.find(m => m.id === milestoneId) || null;
  }
  function setMilestoneStatus(projectId, milestoneId, status) {
    let allowed = ["todo", "in-progress", "blocked", "done"];
    if(allowed.indexOf(status) === -1) return { ok:false, code:"invalid_status", error:"milestone status must be one of: " + allowed.join(", "), valid: allowed };
    let proj = getProject(projectId);
    if(!proj) return { ok:false, code:"not_found", error:"no project with id '" + projectId + "'" };
    if(!findMilestone(proj, milestoneId)) return { ok:false, code:"not_found", error:"no milestone with id '" + milestoneId + "' in project '" + projectId + "'" };
    let milestones = proj.milestones.map(x => x.id === milestoneId ? Object.assign({}, x, { status }) : x);
    let upd = updateProject(projectId, { milestones });
    if(!upd.ok) return upd;
    return { ok:true, project: upd.project, milestone: upd.project.milestones.find(x => x.id === milestoneId) };
  }
  function markMilestoneBillable(projectId, milestoneId, amount, client) {
    let proj = getProject(projectId);
    if(!proj) return { ok:false, code:"not_found", error:"no project with id '" + projectId + "'" };
    let m = findMilestone(proj, milestoneId);
    if(!m) return { ok:false, code:"not_found", error:"no milestone with id '" + milestoneId + "' in project '" + projectId + "'" };
    if(typeof amount !== "number" || !(amount > 0)) return { ok:false, code:"invalid_opts", error:"markMilestoneBillable needs a positive numeric amount" };
    let milestones = proj.milestones.map(x => x.id === milestoneId ? Object.assign({}, x, { billable:true, amount, client: client || x.client || proj.client || "" }) : x);
    let upd = updateProject(projectId, { milestones });
    if(!upd.ok) return upd;
    return { ok:true, project: upd.project, milestone: upd.project.milestones.find(x => x.id === milestoneId) };
  }
  return Object.assign(ws, { listProjects, getProject, saveProject, newProject, updateProject, setMilestoneStatus, markMilestoneBillable });

smbDefaultProjectStore(opts) =>
  opts = opts || {};
  if(!opts.store && !window.SMB_PROJECT_STORE) window.SMB_PROJECT_STORE = smbCreateProjectStore(Object.assign({ toolStub:"project-master" }, opts));
  return opts.store ? smbCreateProjectStore(Object.assign({ toolStub:"project-master" }, opts)) : window.SMB_PROJECT_STORE;

// ── 20b. PROJECT MASTER — INGESTION & ADOPTION ────────────
// project-master discovers the idea bundles idea-incubator published (via the
// idea-index), pulls each one, and adopts it: goals become milestones (todo),
// scope becomes tasks, and a "proposed" project is created. smbListIdeaBundles
// enumerates + pulls; smbBuildAdoptionDraft maps WITHOUT touching any store;
// smbApplyAdoption creates the project.
//
//   let list = await root.smbListIdeaBundles(connector);
//   let draft = root.smbBuildAdoptionDraft(list.ideas[0]);
//   let adopted = await root.smbApplyAdoption(projectStore, draft);

async smbListIdeaBundles(connector, opts) =>
  opts = opts || {};
  if(!connector || typeof connector.listUpstream !== "function" || typeof connector.pull !== "function") return { ok:false, code:"invalid_opts", error:"smbListIdeaBundles: opts.connector is required" };
  let lu = await connector.listUpstream("idea-index");
  if(!lu.ok) return lu;
  let ideas = [], errors = [];
  for(let up of lu.upstreams) {
    let idx = await connector.pull("idea-index", { from: up.tool, fetchImpl: opts.fetchImpl });
    if(!idx.ok) { errors.push({ tool: up.tool, code: idx.code, error: idx.error }); continue; }
    let entries = (idx.bundle.payload || {}).ideas || [];
    for(let e of entries) {
      if(!e || typeof e !== "object" || !e.url) { errors.push({ tool: up.tool, code: "malformed", error:"bad idea-index entry" }); continue; }
      let r = await connector.pull("idea", { url: e.url, fetchImpl: opts.fetchImpl });
      if(!r.ok) { errors.push({ tool: up.tool, code: r.code, error: r.error }); continue; }
      let p = r.bundle.payload || {};
      if(!p || typeof p !== "object" || !p.id) { errors.push({ tool: up.tool, code: "malformed", error:"idea bundle with no payload id" }); continue; }
      ideas.push({ idea: p, sourceTool: up.tool, url: r.url, exportedAt: r.exportedAt, bundleName: e.bundleName, bundle: r.bundle });
    }
  }
  return { ok:true, ideas, count: ideas.length, errors };

smbBuildAdoptionDraft(ideaPayload) =>
  let idea = ideaPayload || {};
  if(!idea || typeof idea !== "object" || !idea.id || !idea.title) return { ok:false, code:"invalid_bundle", error:"smbBuildAdoptionDraft: the idea payload needs at least id + title" };
  let goals = Array.isArray(idea.goals) ? idea.goals : [];
  let scope = Array.isArray(idea.scope) ? idea.scope : [];
  let milestones = goals.map((g, i) => ({ id: "mil-" + (i + 1), title: String(g), status: "todo", billable: false }));
  let tasks = scope.map((s, i) => ({ id: "task-" + (i + 1), title: String(s), status: "todo" }));
  let now = new Date().toISOString();
  let draft = {
    project: { name: idea.title, ideaId: idea.id, description: idea.description || "", status: "proposed", milestones, tasks, createdAt: now },
    mapping: { milestonesFromGoals: milestones.length, tasksFromScope: tasks.length }
  };
  return { ok:true, draft };

async smbApplyAdoption(projectStore, draft, opts) =>
  opts = opts || {};
  if(!projectStore || typeof projectStore.newProject !== "function") return { ok:false, code:"invalid_opts", error:"smbApplyAdoption: projectStore is required" };
  let p = (draft && draft.project) || null;
  if(!p || !p.name) return { ok:false, code:"invalid_opts", error:"smbApplyAdoption: draft.project with a name is required (use smbBuildAdoptionDraft)" };
  let created = projectStore.newProject({
    name: p.name, description: p.description || "", status: p.status || "proposed",
    ideaId: p.ideaId || null, milestones: p.milestones || [], tasks: p.tasks || [],
    client: opts.client || ""
  });
  if(!created.ok) return created;
  if(opts.persist !== false) await projectStore.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  return { ok:true, project: created.project, mapping: draft.mapping || null, adoptedFromIdeaId: created.project.ideaId };

// ── 21. PROJECT MASTER — EXPORT ───────────────────────────
// A project's state is exported as its own project bundle ("project-<id>") and
// registered in the project-index so idea-incubator (receipts) and the ledger
// (event discovery) can find it. smbSetMilestoneStatusAndExport is the
// auto-export-on-transition convenience: update the milestone, then push the
// project. Every export appends to the project's exportLog.
//
//   await root.smbExportProject(projectStore, project.id, { connector, uploadPlugin });
//   await root.smbSetMilestoneStatusAndExport(projectStore, project.id, "mil-1", "done", { connector });

smbProjectBundleName(projectId) =>
  let slug = String(projectId || "").toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "");
  return "project-" + (slug || "untitled");

smbProjectPayload(project) =>
  let payload = {
    schemaVersion: 1,
    id: project.id,
    name: project.name,
    status: project.status,
    description: project.description || "",
    client: project.client || "",
    owners: project.owners || [],
    milestones: (project.milestones || []).map(m => {
      let out = { id: m.id, title: m.title, status: m.status };
      if(m.billable) { out.billable = true; out.amount = m.amount; out.client = m.client || ""; }
      // The billing-export receipt rides on the milestone so downstream tools
      // (the ledger) can discover the published milestone-event bundle with no
      // side channel: pull the project, read milestones[i].exportedForBilling.url.
      if(m.exportedForBilling && m.exportedForBilling.url) out.exportedForBilling = { at: m.exportedForBilling.at || null, url: m.exportedForBilling.url };
      return out;
    })
  };
  if(project.ideaId) payload.ideaId = project.ideaId;
  return payload;

async smbPublishProjectIndex(projectStore, connector, opts) =>
  opts = opts || {};
  if(!projectStore || typeof projectStore.listProjects !== "function" || !connector || typeof connector.publish !== "function") return { ok:false, code:"invalid_opts", error:"smbPublishProjectIndex: projectStore + connector are required" };
  let projects = [];
  for(let p of projectStore.listProjects()) {
    let last = (p.exportLog && p.exportLog.length) ? p.exportLog[p.exportLog.length - 1] : null;
    if(last) projects.push({ projectId: p.id, name: p.name, status: p.status, bundleName: last.bundleName, url: last.url, exportedAt: last.at });
  }
  return await connector.publish("project-index", { schemaVersion:1, projects }, { name: "project-index", editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });

async smbExportProject(projectStore, projectId, opts) =>
  opts = opts || {};
  if(!projectStore || typeof projectStore.getProject !== "function") return { ok:false, code:"invalid_opts", error:"smbExportProject: projectStore is required" };
  let connector = opts.connector;
  if(!connector || typeof connector.publish !== "function") return { ok:false, code:"invalid_opts", error:"smbExportProject: opts.connector (a bus connector) is required" };
  let project = projectStore.getProject(projectId);
  if(!project) return { ok:false, code:"not_found", error:"no project with id '" + projectId + "'" };
  let name = opts.name || smbProjectBundleName(projectId);
  let res = await connector.publish("project", smbProjectPayload(project), { name, editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  if(!res.ok) return res;
  if(opts.dryRun) return Object.assign({ ok:true, dryRun:true, projectId, name }, res);
  let record = { at: res.publishedAt || new Date().toISOString(), bundleName: name, url: res.url || smbBusUrl("project-master", name), editCount: res.editCount || null };
  let upd = projectStore.updateProject(projectId, { exportLog: (project.exportLog || []).concat([record]) });
  let idx = null;
  if(upd.ok && opts.persist !== false) {
    await projectStore.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
    idx = await smbPublishProjectIndex(projectStore, connector, { editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  } else if(upd.ok && opts.skipIndex !== true) {
    idx = await smbPublishProjectIndex(projectStore, connector, { editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  }
  return { ok:true, projectId, name, url: record.url, exportedAt: record.at, created: res.created, record, index: idx };

async smbSetMilestoneStatusAndExport(projectStore, projectId, milestoneId, status, opts) =>
  opts = opts || {};
  let upd = projectStore.setMilestoneStatus(projectId, milestoneId, status);
  if(!upd.ok) return upd;
  let ex = await smbExportProject(projectStore, projectId, opts);
  if(!ex.ok) return Object.assign({ milestone: upd.milestone }, ex);
  return Object.assign({ milestone: upd.milestone }, ex);

// smbListProjectBundles — pull the project-index from every publisher, then
// pull each project bundle. Used by idea-incubator receipts, the ledger's
// event discovery, and any dashboard.
async smbListProjectBundles(connector, opts) =>
  opts = opts || {};
  if(!connector || typeof connector.listUpstream !== "function" || typeof connector.pull !== "function") return { ok:false, code:"invalid_opts", error:"smbListProjectBundles: opts.connector is required" };
  let lu = await connector.listUpstream("project-index");
  if(!lu.ok) return lu;
  let projects = [], bundles = [], errors = [];
  for(let up of lu.upstreams) {
    let idx = await connector.pull("project-index", { from: up.tool, fetchImpl: opts.fetchImpl });
    if(!idx.ok) { errors.push({ tool: up.tool, code: idx.code, error: idx.error }); continue; }
    for(let e of ((idx.bundle.payload || {}).projects || [])) {
      if(!e || typeof e !== "object" || !e.url) { errors.push({ tool: up.tool, code: "malformed", error:"bad project-index entry" }); continue; }
      let r = await connector.pull("project", { url: e.url, fetchImpl: opts.fetchImpl });
      if(!r.ok) { errors.push({ tool: up.tool, code: r.code, error: r.error }); continue; }
      let p = r.bundle.payload || {};
      bundles.push(r.bundle);
      projects.push({ project: p, sourceTool: up.tool, url: r.url, exportedAt: r.exportedAt, bundleName: e.bundleName, bundle: r.bundle });
    }
  }
  return { ok:true, projects, bundles, count: projects.length, errors };

// ── 22. PROJECT MASTER — BILLING EXPORT ───────────────────
// A billable milestone (fixed amount, client) is exported as a milestone-event
// bundle ("milestone-event-<eventId>") for the ledger to invoice. Each event
// is written once and recorded on the milestone (exportedForBilling) so it is
// never double-sent; force:true re-exports a corrected event (the ledger
// dedups by eventId).
//
//   await root.smbExportMilestoneEvent(projectStore, project.id, "mil-1", { connector });

async smbExportMilestoneEvent(projectStore, projectId, milestoneId, opts) =>
  opts = opts || {};
  if(!projectStore || typeof projectStore.getProject !== "function") return { ok:false, code:"invalid_opts", error:"smbExportMilestoneEvent: projectStore is required" };
  let connector = opts.connector;
  if(!connector || typeof connector.publish !== "function") return { ok:false, code:"invalid_opts", error:"smbExportMilestoneEvent: opts.connector (a bus connector) is required" };
  let project = projectStore.getProject(projectId);
  if(!project) return { ok:false, code:"not_found", error:"no project with id '" + projectId + "'" };
  let m = (project.milestones || []).find(x => x.id === milestoneId);
  if(!m) return { ok:false, code:"not_found", error:"no milestone with id '" + milestoneId + "' in project '" + projectId + "'" };
  if(!m.billable || typeof m.amount !== "number" || !(m.amount > 0)) return { ok:false, code:"not_billable", error:"only billable milestones with a fixed amount can be exported for billing — mark it billable (markMilestoneBillable) first" };
  if(m.exportedForBilling && !opts.force) return { ok:false, code:"already_billed", error:"this milestone was already exported for billing ('" + m.exportedForBilling.url + "') — nothing was double-sent (force:true to re-export a corrected event)", url: m.exportedForBilling.url, exportedAt: m.exportedForBilling.at };
  let eventId = opts.eventId || smbIdToken("evt");
  let payload = {
    schemaVersion: 1, eventId, projectId, milestoneId,
    milestoneTitle: m.title,
    client: m.client || project.client || "",
    amount: m.amount,
    date: opts.date || new Date().toISOString().slice(0, 10),
    description: m.title
  };
  let name = opts.name || "milestone-event-" + eventId;
  let res = await connector.publish("milestone-event", payload, { name, editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  if(!res.ok) return res;
  if(opts.dryRun) return Object.assign({ ok:true, dryRun:true, eventId, projectId, milestoneId, name }, res);
  let record = { at: res.publishedAt || new Date().toISOString(), eventId, bundleName: name, url: res.url || smbBusUrl("project-master", name), editCount: res.editCount || null };
  let milestones = project.milestones.map(x => x.id === milestoneId ? Object.assign({}, x, { exportedForBilling: record }) : x);
  let upd = projectStore.updateProject(projectId, { milestones });
  // Re-export the project (and its index) so the freshly published event is
  // discoverable downstream — the ledger finds events by pulling the project
  // bundle and reading milestones[i].exportedForBilling.url. Without this the
  // event would sit on the bus unreferenced and the ledger would never see it.
  let projectRefresh = null, warnings = [];
  if(upd.ok && opts.projectRefresh !== false) {
    projectRefresh = await smbExportProject(projectStore, projectId, { connector, editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin, persist: opts.persist });
    if(!projectRefresh.ok) {
      warnings.push("the event was published but the project bundle could not be re-exported for discovery — the ledger won't see it until the project is exported again: " + (projectRefresh.error || projectRefresh.code));
    } else {
      projectRefresh = { ok:true, bundleName: projectRefresh.name, url: projectRefresh.url, exportedAt: projectRefresh.exportedAt };
    }
  }
  if(upd.ok && opts.persist !== false) await projectStore.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  return { ok:true, eventId, projectId, milestoneId, name, url: record.url, exportedAt: record.at, created: res.created, record, projectRefresh, warnings };

// ── 23. PROJECT MASTER — PAYMENT RENDERING ────────────────
// The ledger publishes payment-receipt bundles when an invoice is paid;
// project-master pulls the payment-receipt-index, sums the payments per
// milestone and reports how each billable milestone stands against its amount:
// unpaid / partial / paid.
//
//   let st = await root.smbPaymentStatuses(projectStore, connector);
//   for(let s of st.statuses) console.log(s.milestoneId, s.state, s.paid, "/", s.amount);

async smbPaymentStatuses(projectStore, connector, opts) =>
  opts = opts || {};
  if(!connector || typeof connector.listUpstream !== "function" || typeof connector.pull !== "function") return { ok:false, code:"invalid_opts", error:"smbPaymentStatuses: opts.connector is required" };
  let lu = await connector.listUpstream("payment-receipt-index");
  if(!lu.ok) return lu;
  let receipts = [], errors = [];
  for(let up of lu.upstreams) {
    let idx = await connector.pull("payment-receipt-index", { from: up.tool, fetchImpl: opts.fetchImpl });
    if(!idx.ok) { errors.push({ tool: up.tool, code: idx.code, error: idx.error }); continue; }
    for(let e of ((idx.bundle.payload || {}).receipts || [])) {
      if(!e || typeof e !== "object" || !e.url) { errors.push({ tool: up.tool, code: "malformed", error:"bad payment-receipt-index entry" }); continue; }
      let r = await connector.pull("payment-receipt", { url: e.url, fetchImpl: opts.fetchImpl });
      if(!r.ok) { errors.push({ tool: up.tool, code: r.code, error: r.error }); continue; }
      receipts.push(r.bundle.payload || {});
    }
  }
  let byMilestone = {};
  for(let rc of receipts) {
    let key = rc.milestoneId || (rc.projectId + ":" + rc.invoiceId);
    if(!byMilestone[key]) byMilestone[key] = { milestoneId: rc.milestoneId || null, projectId: rc.projectId || null, invoiceId: rc.invoiceId || null, paid: 0, receipts: [] };
    byMilestone[key].paid += (typeof rc.amount === "number") ? rc.amount : 0;
    byMilestone[key].receipts.push(rc);
  }
  let statuses = [];
  let projects = projectStore ? projectStore.listProjects() : [];
  let amounts = {};
  for(let p of projects) for(let m of (p.milestones || [])) if(m.billable) amounts[m.id] = { amount: m.amount, projectId: p.id, milestoneTitle: m.title };
  for(let key of Object.keys(byMilestone)) {
    let g = byMilestone[key];
    let a = (g.milestoneId && amounts[g.milestoneId]) ? amounts[g.milestoneId] : null;
    let amount = a ? a.amount : null;
    let state = (amount === null || amount <= 0) ? "no-amount" : (g.paid <= 0 ? "unpaid" : (g.paid < amount ? "partial" : "paid"));
    statuses.push({ milestoneId: g.milestoneId, projectId: g.projectId || (a && a.projectId) || null, milestoneTitle: a ? a.milestoneTitle : null, amount, paid: g.paid, state, receipts: g.receipts.length });
  }
  let byMilestoneIds = {};
  for(let p of projects) for(let m of (p.milestones || [])) if(m.billable && m.id && !byMilestone[m.id]) {
    byMilestoneIds[m.id] = { milestoneId: m.id, projectId: p.id, milestoneTitle: m.title, amount: m.amount, paid: 0, state: "unpaid", receipts: 0 };
  }
  for(let mId of Object.keys(byMilestoneIds)) statuses.push(byMilestoneIds[mId]);
  return { ok:true, statuses, byMilestone, receipts, errors, count: statuses.length };

// ── 23b. PROJECT MASTER — SELF-TESTS ──────────────────
// Hermetic: in-memory stores + a fake bus that behaves like editable.uploads
// (per-name files, idempotent identical writes, edit keys). Run via
// root.smbProjectMasterSelfTest().
async smbProjectMasterSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  function memStore() { let map = {}; return { get:k => (k in map) ? map[k] : null, set:(k,v) => { map[k] = v; return true; }, remove:k => { delete map[k]; } }; }
  let files = {};
  let fakeUpload = { editable: { async set(name, text, opts) { files[name] = text; return { editKey:"k-"+name, editCount:Object.keys(files).length }; } } };
  let fakeFetch = async (url) => { let name = url.split("/").pop(); if(!(name in files)) return { status:404, ok:false, text:async () => "nope" }; return { status:200, ok:true, text:async () => files[name] }; };
  let pm = smbCreateProjectStore({ toolStub:"project-master", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let conn = smbCreateConnector({ toolStub:"project-master", toolDisplayName:"Project Master", syncTracker: function(){ return { ok:true }; } });
  let manifestObj = { schemaVersion:1, tools:[] };
  manifestObj = smbRegisterTool(manifestObj, { stub:"idea-incubator", displayName:"Idea Incubator", publishes:["idea","idea-index"], consumes:["project"] });
  manifestObj = smbRegisterTool(manifestObj, { stub:"project-master", displayName:"Project Master", publishes:["project","project-index","milestone-event"], consumes:["idea","payment-receipt"] });
  manifestObj = smbRegisterTool(manifestObj, { stub:"the-ledger", displayName:"The Ledger", publishes:["payment-receipt","payment-receipt-index"], consumes:["milestone-event"] });
  await conn.configure(manifestObj);

  // store basics
  let p1 = pm.newProject({ name:"Widget marketplace", ideaId:"idea-abc", milestones:[{ id:"mil-1", title:"Launch MVP", status:"todo", billable:false }], tasks:[{ id:"task-1", title:"Listings", status:"todo" }] });
  t("newProject creates a proposed project", p1.ok && p1.project.status === "proposed" && p1.project.ideaId === "idea-abc");
  t("newProject list/get round-trip", pm.listProjects().length === 1 && pm.getProject(p1.project.id).name === "Widget marketplace");
  let bill = pm.markMilestoneBillable(p1.project.id, "mil-1", 500, "Acme");
  t("markMilestoneBillable sets amount + client", bill.ok && bill.milestone.billable === true && bill.milestone.amount === 500 && bill.milestone.client === "Acme");
  let st = pm.setMilestoneStatus(p1.project.id, "mil-1", "done");
  t("setMilestoneStatus transitions + validates", st.ok && st.milestone.status === "done" && pm.setMilestoneStatus(p1.project.id, "mil-1", "shipped").code === "invalid_status");
  t("updateProject on missing id → not_found", pm.updateProject("nope", {}).code === "not_found");

  // adoption
  let ideaPayload = { schemaVersion:1, id:"idea-abc", title:"Widget marketplace", description:"Sell widgets", goals:["Launch MVP","Onboard sellers"], scope:["Listings","Checkout","Payments"] };
  let draft = smbBuildAdoptionDraft(ideaPayload);
  t("adoption draft maps goals → milestones, scope → tasks", draft.ok && draft.draft.mapping.milestonesFromGoals === 2 && draft.draft.mapping.tasksFromScope === 3);
  let adopted = await smbApplyAdoption(pm, draft.draft, { uploadPlugin:fakeUpload });
  t("applyAdoption creates the project", adopted.ok && adopted.project.ideaId === "idea-abc" && adopted.project.milestones.length === 2);

  // export project + index
  let ex = await smbExportProject(pm, p1.project.id, { connector: conn, uploadPlugin: fakeUpload, persist:false });
  t("exportProject publishes the project bundle + index", ex.ok && !!files[smbProjectBundleName(p1.project.id)] && !!files["project-index"]);
  let list = await smbListProjectBundles(conn, { fetchImpl: fakeFetch });
  t("listProjectBundles discovers the project via index", list.ok && list.count === 1 && list.projects[0].project.id === p1.project.id);

  // billing event
  let evt = await smbExportMilestoneEvent(pm, p1.project.id, "mil-1", { connector: conn, uploadPlugin: fakeUpload, persist:false });
  t("exportMilestoneEvent publishes + records exportedForBilling", evt.ok && !!files["milestone-event-" + evt.eventId] && !!pm.getProject(p1.project.id).milestones[0].exportedForBilling);
  let evt2 = await smbExportMilestoneEvent(pm, p1.project.id, "mil-1", { connector: conn, uploadPlugin: fakeUpload });
  t("re-exporting a billed milestone is refused (already_billed)", evt2.ok === false && evt2.code === "already_billed");

  // payment statuses
  let receiptPayload = { schemaVersion:1, receiptId:"rcpt-1", invoiceId:"inv-1", amount:500, date:"2026-09-01", projectId: p1.project.id, milestoneId:"mil-1" };
  files["payment-receipt-rcpt-1"] = JSON.stringify({ schemaVersion:1, bundleType:"payment-receipt", tool:"the-ledger", toolDisplayName:"The Ledger", exportedAt:"2026-09-07T13:00:00.000Z", source:"invoices/rcpt-1", payload: receiptPayload });
  files["payment-receipt-index"] = JSON.stringify({ schemaVersion:1, bundleType:"payment-receipt-index", tool:"the-ledger", toolDisplayName:"The Ledger", exportedAt:"2026-09-07T13:00:00.000Z", source:"invoices/index", payload:{ schemaVersion:1, receipts:[{ receiptId:"rcpt-1", invoiceId:"inv-1", bundleName:"payment-receipt-rcpt-1", url:"https://editable.uploads.dev/file/the-ledger/payment-receipt-rcpt-1", exportedAt:"2026-09-07T13:00:00.000Z", amount:500, date:"2026-09-01", projectId: p1.project.id, milestoneId:"mil-1" }] } });
  let pay = await smbPaymentStatuses(pm, conn, { fetchImpl: fakeFetch });
  let mil1 = pay.statuses.find(s => s.milestoneId === "mil-1");
  t("payment statuses: full payment → paid", pay.ok && mil1 && mil1.state === "paid" && mil1.paid === 500);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 25. THE LEDGER — WORKSPACE STORE ──────────────────────
// The bookkeeping tool's canonical data as versioned JSON in the-ledger/books
// (same file-sync semantics as §16): a chart of accounts, journal transactions
// (double-entry), invoices, and a draft log so upstream milestone-events are
// ingested exactly once. The default chart is cash / accounts-receivable /
// revenue / general-expenses; balances are maintained by posting.
//
//   let store = root.smbCreateLedgerStore({ toolStub:"the-ledger" });
//   await store.syncUp();
//
// Data shape: { schemaVersion, accounts: [ { id, name, type, balance } ],
// transactions: [ { id, date, memo, entries: [ { accountId, debit, credit } ],
// postedAt, projectId, reversedById, reverseOfId } ], invoices: [ { id,
// client, amount, status, projectId, milestoneId, milestoneTitle, eventId,
// issuedAt, payments: [], postedTransactionId } ], draftLog: [ { eventId,
// invoiceId, ingestedAt } ] }

smbCreateLedgerStore(opts) =>
  opts = opts || {};
  let ws = smbCreateWorkspaceStore({
    toolStub: opts.toolStub || "the-ledger",
    bundleName: opts.bundleName || "books",
    toolDisplayName: opts.toolDisplayName || "The Ledger",
    source: opts.source || "the-ledger/books.json",
    store: opts.store, fetchImpl: opts.fetchImpl, uploadPlugin: opts.uploadPlugin,
    schemaVersion: 1,
    defaultData: () => ({
      schemaVersion: 1,
      accounts: [
        { id: "assets-cash", name: "Cash", type: "asset", balance: 0 },
        { id: "assets-ar", name: "Accounts Receivable", type: "asset", balance: 0 },
        { id: "income-revenue", name: "Revenue", type: "income", balance: 0 },
        { id: "expense-general", name: "General Expenses", type: "expense", balance: 0 }
      ],
      transactions: [], invoices: [], draftLog: []
    })
  });
  function rec(r) { return JSON.parse(JSON.stringify(r)); }
  function listAccounts() { return (ws.getData().accounts || []).map(rec); }
  function getAccount(id) { let a = (ws.getData().accounts || []).find(x => x.id === id); return a ? rec(a) : null; }
  function listTransactions() { return (ws.getData().transactions || []).map(rec); }
  function getTransaction(id) { let t = (ws.getData().transactions || []).find(x => x.id === id); return t ? rec(t) : null; }
  function listInvoices() { return (ws.getData().invoices || []).map(rec); }
  function getInvoice(id) { let i = (ws.getData().invoices || []).find(x => x.id === id); return i ? rec(i) : null; }
  function saveInvoice(invoice) {
    let d = ws.getData();
    if(!d.invoices) d.invoices = [];
    let idx = d.invoices.findIndex(x => x.id === invoice.id);
    if(idx >= 0) d.invoices[idx] = invoice; else d.invoices.push(invoice);
    ws.touch();
    return { ok:true, invoice: rec(invoice) };
  }
  function newInvoice(opts) {
    opts = opts || {};
    let now = new Date().toISOString();
    let invoice = {
      id: opts.id || smbIdToken("inv"),
      client: opts.client || "", amount: opts.amount || 0,
      status: opts.status || "pending-approval",
      projectId: opts.projectId || null, milestoneId: opts.milestoneId || null,
      milestoneTitle: opts.milestoneTitle || "", eventId: opts.eventId || null,
      issuedAt: opts.issuedAt || null, payments: [], postedTransactionId: null,
      createdAt: opts.createdAt || now
    };
    saveInvoice(invoice);
    return { ok:true, invoice: rec(invoice) };
  }
  function logDraft(eventId, invoiceId) {
    let d = ws.getData();
    if(!d.draftLog) d.draftLog = [];
    d.draftLog.push({ eventId, invoiceId, ingestedAt: new Date().toISOString() });
    ws.touch();
  }
  function wasIngested(eventId) {
    return !!((ws.getData().draftLog || []).find(x => x.eventId === eventId));
  }
  return Object.assign(ws, { listAccounts, getAccount, listTransactions, getTransaction, listInvoices, getInvoice, saveInvoice, newInvoice, logDraft, wasIngested });

smbDefaultLedgerStore(opts) =>
  opts = opts || {};
  if(!opts.store && !window.SMB_LEDGER_STORE) window.SMB_LEDGER_STORE = smbCreateLedgerStore(Object.assign({ toolStub:"the-ledger" }, opts));
  return opts.store ? smbCreateLedgerStore(Object.assign({ toolStub:"the-ledger" }, opts)) : window.SMB_LEDGER_STORE;

// ── 26. THE LEDGER — INGESTION ────────────────────────────
// The ledger discovers project-master's milestone-event bundles (via the
// project-index → project bundles → each milestone's exportedForBilling), pulls
// each event and creates an invoice DRAFT ("pending-approval"). The draft log
// makes ingestion idempotent — a re-pulled event is refused (deduped).
//
//   await root.smbIngestMilestoneEvent(store, event);
//   let got = await root.smbIngestFromBus(store, connector);
//   let drafts = store.listInvoices().filter(i => i.status === "pending-approval");

async smbIngestMilestoneEvent(store, event, opts) =>
  opts = opts || {};
  if(!store || typeof store.wasIngested !== "function") return { ok:false, code:"invalid_opts", error:"smbIngestMilestoneEvent: store (a ledger store) is required" };
  let ev = event || {};
  if(!ev.eventId) return { ok:false, code:"invalid_bundle", error:"smbIngestMilestoneEvent: the event needs an eventId" };
  if(store.wasIngested(ev.eventId)) return { ok:false, code:"deduped", error:"this milestone event was already ingested (eventId '" + ev.eventId + "') — no duplicate was created", eventId: ev.eventId };
  let invoiceId = "inv-" + ev.eventId;
  let inv = store.newInvoice({ id: invoiceId, client: ev.client || "", amount: ev.amount || 0, projectId: ev.projectId || null, milestoneId: ev.milestoneId || null, milestoneTitle: ev.milestoneTitle || "", eventId: ev.eventId });
  store.logDraft(ev.eventId, invoiceId);
  if(opts.persist !== false) await store.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  return { ok:true, invoice: inv.invoice, invoiceId, eventId: ev.eventId, status: "pending-approval" };

async smbIngestFromBus(store, connector, opts) =>
  opts = opts || {};
  if(!store || typeof store.wasIngested !== "function") return { ok:false, code:"invalid_opts", error:"smbIngestFromBus: store (a ledger store) is required" };
  if(!connector || typeof connector.listUpstream !== "function" || typeof connector.pull !== "function") return { ok:false, code:"invalid_opts", error:"smbIngestFromBus: opts.connector is required" };
  let list = await smbListProjectBundles(connector, { fetchImpl: opts.fetchImpl });
  if(!list.ok) return list;
  let events = [], errors = [], ingested = [];
  for(let pb of list.projects) {
    let p = pb.project || {};
    for(let m of (Array.isArray(p.milestones) ? p.milestones : [])) {
      let rec = m.exportedForBilling;
      if(!rec || !rec.url) continue;
      let r = await connector.pull("milestone-event", { url: rec.url, fetchImpl: opts.fetchImpl });
      if(!r.ok) { errors.push({ projectId: p.id, milestoneId: m.id, code: r.code, error: r.error }); continue; }
      let ev = r.bundle.payload || {};
      events.push({ event: ev, url: r.url, sourceBundle: r.bundle });
      let ing = await smbIngestMilestoneEvent(store, ev, opts);
      if(ing.ok) ingested.push(ing.invoiceId);
      else if(ing.code !== "deduped") errors.push({ eventId: ev.eventId, code: ing.code, error: ing.error });
    }
  }
  return { ok:true, events, ingested, deduped: events.length - ingested.length, errors, count: events.length };

// ── 27. THE LEDGER — POSTING ──────────────────────────────
// Posting turns an approved invoice DRAFT into an issued invoice with a
// balanced double-entry journal line (Dr accounts-receivable / Cr revenue) and
// updates account balances. Posted invoices can't be edited or deleted —
// mistakes are fixed with a reversing entry (smbReverseEntry). smbRecordExpense
// books a cash expense.
//
//   let posted = await root.smbPostInvoice(store, "inv-evt-abc123");
//   let reversed = await root.smbReverseEntry(store, posted.transaction.id);

async smbPostInvoice(store, invoiceId, opts) =>
  opts = opts || {};
  if(!store || typeof store.getInvoice !== "function") return { ok:false, code:"invalid_opts", error:"smbPostInvoice: store (a ledger store) is required" };
  let inv = store.getInvoice(invoiceId);
  if(!inv) return { ok:false, code:"not_found", error:"no invoice with id '" + invoiceId + "'" };
  if(inv.postedTransactionId) return { ok:false, code:"already_posted", error:"this invoice was already posted (transaction '" + inv.postedTransactionId + "') — posted entries can't be edited; reverse it if it was a mistake", transactionId: inv.postedTransactionId, status: inv.status };
  if(inv.status !== "pending-approval") return { ok:false, code:"already_posted", error:"this invoice is already '" + inv.status + "' — only pending-approval invoices can be posted", status: inv.status };
  if(typeof inv.amount !== "number" || !(inv.amount > 0)) return { ok:false, code:"invalid_opts", error:"an invoice needs a positive amount to post" };
  let now = new Date().toISOString();
  let tx = { id: smbIdToken("txn"), date: now.slice(0, 10), memo: "Invoice " + invoiceId + (inv.client ? " — " + inv.client : ""), entries: [ { accountId: "assets-ar", debit: inv.amount, credit: 0 }, { accountId: "income-revenue", debit: 0, credit: inv.amount } ], postedAt: now, projectId: inv.projectId || null, reversedById: null, reverseOfId: null };
  let debits = tx.entries.reduce((s, e) => s + (e.debit || 0), 0);
  let credits = tx.entries.reduce((s, e) => s + (e.credit || 0), 0);
  if(Math.abs(debits - credits) > 0.0001) return { ok:false, code:"double_entry", error:"the journal entry is not balanced (debits " + debits + " vs credits " + credits + ")" };
  let d = store.getData();
  if(!d.transactions) d.transactions = [];
  for(let e of tx.entries) {
    let acct = (d.accounts || []).find(a => a.id === e.accountId);
    if(!acct) return { ok:false, code:"not_found", error:"account '" + e.accountId + "' does not exist" };
    if(acct.type === "asset" || acct.type === "expense") acct.balance = (acct.balance || 0) + (e.debit || 0) - (e.credit || 0);
    else acct.balance = (acct.balance || 0) + (e.credit || 0) - (e.debit || 0);
  }
  d.transactions.push(tx);
  let invIdx = d.invoices.findIndex(x => x.id === invoiceId);
  d.invoices[invIdx] = Object.assign({}, d.invoices[invIdx], { status: "issued", issuedAt: now, postedTransactionId: tx.id });
  store.touch();
  if(opts.persist !== false) await store.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  return { ok:true, transaction: JSON.parse(JSON.stringify(tx)), invoice: JSON.parse(JSON.stringify(d.invoices[invIdx])), status: "issued" };

async smbReverseEntry(store, transactionId, opts) =>
  opts = opts || {};
  if(!store || typeof store.getTransaction !== "function") return { ok:false, code:"invalid_opts", error:"smbReverseEntry: store (a ledger store) is required" };
  let tx = store.getTransaction(transactionId);
  if(!tx) return { ok:false, code:"not_found", error:"no transaction with id '" + transactionId + "'" };
  if(tx.reversedById) return { ok:false, code:"already_posted", error:"this entry was already reversed by transaction '" + tx.reversedById + "'", reversedById: tx.reversedById };
  let now = new Date().toISOString();
  let rev = { id: smbIdToken("txn"), date: now.slice(0, 10), memo: "Reversal of " + transactionId, entries: tx.entries.map(e => ({ accountId: e.accountId, debit: e.credit || 0, credit: e.debit || 0 })), postedAt: now, projectId: tx.projectId || null, reversedById: null, reverseOfId: transactionId };
  let d = store.getData();
  if(!d.transactions) d.transactions = [];
  for(let e of rev.entries) {
    let acct = (d.accounts || []).find(a => a.id === e.accountId);
    if(!acct) continue;
    if(acct.type === "asset" || acct.type === "expense") acct.balance = (acct.balance || 0) + (e.debit || 0) - (e.credit || 0);
    else acct.balance = (acct.balance || 0) + (e.credit || 0) - (e.debit || 0);
  }
  d.transactions.push(rev);
  let tIdx = d.transactions.findIndex(x => x.id === transactionId);
  d.transactions[tIdx] = Object.assign({}, d.transactions[tIdx], { reversedById: rev.id });
  store.touch();
  if(opts.persist !== false) await store.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  return { ok:true, reversal: JSON.parse(JSON.stringify(rev)), reversedTransactionId: transactionId, reversedById: rev.id };

async smbRecordExpense(store, opts) =>
  opts = opts || {};
  if(!store || typeof store.getData !== "function") return { ok:false, code:"invalid_opts", error:"smbRecordExpense: store (a ledger store) is required" };
  let amount = opts.amount;
  if(typeof amount !== "number" || !(amount > 0)) return { ok:false, code:"invalid_opts", error:"smbRecordExpense needs a positive amount" };
  let accountId = opts.accountId || "expense-general";
  let d = store.getData();
  let acct = (d.accounts || []).find(a => a.id === accountId);
  if(!acct) { acct = { id: accountId, name: opts.accountName || accountId, type: "expense", balance: 0 }; d.accounts.push(acct); }
  let now = new Date().toISOString();
  let tx = { id: smbIdToken("txn"), date: opts.date || now.slice(0, 10), memo: opts.memo || "Expense", entries: [ { accountId, debit: amount, credit: 0 }, { accountId: "assets-cash", debit: 0, credit: amount } ], postedAt: now, projectId: opts.projectId || null, reversedById: null, reverseOfId: null };
  if(!d.transactions) d.transactions = [];
  acct.balance = (acct.balance || 0) + amount;
  let cash = (d.accounts || []).find(a => a.id === "assets-cash");
  if(cash) cash.balance = (cash.balance || 0) - amount;
  d.transactions.push(tx);
  store.touch();
  if(opts.persist !== false) await store.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  return { ok:true, transaction: JSON.parse(JSON.stringify(tx)), expenseAccount: JSON.parse(JSON.stringify(acct)), amount };

// ── 28. THE LEDGER — PAYMENTS & RECEIPTS ──────────────────
// A payment on an issued/partially-paid invoice is journaled (Dr cash /
// Cr accounts-receivable), moves the invoice to paid / partially-paid, and is
// published as a payment-receipt bundle (registered in payment-receipt-index)
// so project-master can reflect the payment against the milestone.
//
//   let pay = await root.smbRecordPayment(store, "inv-evt-abc123", 500, "2026-09-01", { connector });

async smbPublishPaymentReceiptIndex(store, connector, opts) =>
  opts = opts || {};
  if(!store || typeof store.listInvoices !== "function" || !connector || typeof connector.publish !== "function") return { ok:false, code:"invalid_opts", error:"smbPublishPaymentReceiptIndex: store + connector are required" };
  let receipts = [];
  for(let inv of store.listInvoices()) {
    for(let p of (inv.payments || [])) {
      if(!p.receiptUrl) continue;
      receipts.push({ receiptId: p.receiptId || p.id, invoiceId: inv.id, bundleName: "payment-receipt-" + (p.receiptId || p.id), url: p.receiptUrl, exportedAt: p.receivedAt || p.date, amount: p.amount, date: p.date, projectId: inv.projectId || null, milestoneId: inv.milestoneId || null });
    }
  }
  return await connector.publish("payment-receipt-index", { schemaVersion:1, receipts }, { name: "payment-receipt-index", editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });

async smbRecordPayment(store, invoiceId, amount, date, opts) =>
  opts = opts || {};
  if(!store || typeof store.getInvoice !== "function") return { ok:false, code:"invalid_opts", error:"smbRecordPayment: store (a ledger store) is required" };
  let inv = store.getInvoice(invoiceId);
  if(!inv) return { ok:false, code:"not_found", error:"no invoice with id '" + invoiceId + "'" };
  if(inv.status !== "issued" && inv.status !== "partially-paid") return { ok:false, code:"invalid_status", error:"only issued or partially-paid invoices can receive payments (current: '" + inv.status + "')" };
  if(typeof amount !== "number" || !(amount > 0)) return { ok:false, code:"invalid_opts", error:"payment amount must be positive" };
  let d = store.getData();
  let paidSoFar = (inv.payments || []).reduce((s, p) => s + (p.amount || 0), 0);
  let newPaid = paidSoFar + amount;
  let status = newPaid >= inv.amount - 0.0001 ? "paid" : "partially-paid";
  let now = new Date().toISOString();
  let payment = { id: smbIdToken("pay"), date: date || now.slice(0, 10), amount, receivedAt: now, receiptId: null, receiptUrl: null };
  let tx = { id: smbIdToken("txn"), date: payment.date, memo: "Payment on " + invoiceId + (inv.client ? " — " + inv.client : ""), entries: [ { accountId: "assets-cash", debit: amount, credit: 0 }, { accountId: "assets-ar", debit: 0, credit: amount } ], postedAt: now, projectId: inv.projectId || null, reversedById: null, reverseOfId: null };
  if(!d.transactions) d.transactions = [];
  for(let e of tx.entries) {
    let acct = (d.accounts || []).find(a => a.id === e.accountId);
    if(!acct) return { ok:false, code:"not_found", error:"account '" + e.accountId + "' does not exist" };
    if(acct.type === "asset" || acct.type === "expense") acct.balance = (acct.balance || 0) + (e.debit || 0) - (e.credit || 0);
    else acct.balance = (acct.balance || 0) + (e.credit || 0) - (e.debit || 0);
  }
  d.transactions.push(tx);
  let invIdx = d.invoices.findIndex(x => x.id === invoiceId);
  let publication = null;
  let connector = opts.connector;
  if(connector && typeof connector.publish === "function") {
    let r = await connector.publish("payment-receipt", { schemaVersion:1, receiptId: payment.id, invoiceId, amount, date: payment.date, projectId: inv.projectId || null, milestoneId: inv.milestoneId || null }, { name: "payment-receipt-" + payment.id, editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
    if(r.ok && !opts.dryRun) {
      publication = r;
      payment.receiptId = payment.id;
      payment.receiptUrl = r.url || smbBusUrl("the-ledger", "payment-receipt-" + payment.id);
    }
  }
  d.invoices[invIdx] = Object.assign({}, d.invoices[invIdx], { status, payments: (d.invoices[invIdx].payments || []).concat([payment]), postedTransactionId: d.invoices[invIdx].postedTransactionId || tx.id });
  store.touch();
  if(publication) await smbPublishPaymentReceiptIndex(store, connector, { editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });
  if(opts.persist !== false) await store.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
  return { ok:true, invoice: JSON.parse(JSON.stringify(d.invoices[invIdx])), payment: JSON.parse(JSON.stringify(payment)), transaction: JSON.parse(JSON.stringify(tx)), status, publication };

// ── 29. THE LEDGER — REPORTS & BACKUP ─────────────────────
// P&L report (income vs expense, optionally by date range and by month),
// per-project profit, and a full-tool backup: either a downloadable file or a
// backup bundle published to the bus.
//
//   let rep = root.smbLedgerReport(store, { from:"2026-01-01", to:"2026-12-31" });
//   let pnl = root.smbPerProjectPnl(store);
//   await root.smbBackupBundle(store, connector);
//   root.smbFullBackupDownload(store);

smbLedgerReport(store, opts) =>
  opts = opts || {};
  if(!store || typeof store.getData !== "function") return { ok:false, code:"invalid_opts", error:"smbLedgerReport: store (a ledger store) is required" };
  let d = store.getData();
  let from = opts.from ? Date.parse(opts.from) : NaN;
  let to = opts.to ? Date.parse(opts.to) : NaN;
  let txs = (d.transactions || []).filter(t => {
    if(Number.isNaN(from) && Number.isNaN(to)) return true;
    let ts = Date.parse(t.postedAt || t.date);
    if(Number.isNaN(ts)) return true;
    if(!Number.isNaN(from) && ts < from) return false;
    if(!Number.isNaN(to) && ts > to) return false;
    return true;
  });
  let income = 0, expense = 0, byMonth = {};
  for(let t of txs) {
    let inc = 0, exp = 0;
    for(let e of (t.entries || [])) {
      let acct = (d.accounts || []).find(a => a.id === e.accountId);
      if(!acct) continue;
      if(acct.type === "income") inc += (e.credit || 0) - (e.debit || 0);
      else if(acct.type === "expense") exp += (e.debit || 0) - (e.credit || 0);
    }
    income += inc; expense += exp;
    let mo = (t.postedAt || t.date || "").slice(0, 7);
    if(mo) { byMonth[mo] = byMonth[mo] || { income:0, expense:0 }; byMonth[mo].income += inc; byMonth[mo].expense += exp; }
  }
  return { ok:true, income, expense, net: income - expense, byMonth, transactionCount: txs.length, from: opts.from || null, to: opts.to || null };

smbPerProjectPnl(store) =>
  if(!store || typeof store.getData !== "function") return { ok:false, code:"invalid_opts", error:"smbPerProjectPnl: store (a ledger store) is required" };
  let d = store.getData();
  let acc = {};
  for(let t of (d.transactions || [])) {
    let pid = t.projectId || "uncategorized";
    if(!acc[pid]) acc[pid] = { income:0, expense:0, transactions:0 };
    for(let e of (t.entries || [])) {
      let acct = (d.accounts || []).find(a => a.id === e.accountId);
      if(!acct) continue;
      if(acct.type === "income") acc[pid].income += (e.credit || 0) - (e.debit || 0);
      else if(acct.type === "expense") acc[pid].expense += (e.debit || 0) - (e.credit || 0);
    }
    acc[pid].transactions++;
  }
  let projects = [];
  for(let pid of Object.keys(acc)) {
    acc[pid].net = acc[pid].income - acc[pid].expense;
    projects.push(Object.assign({ projectId: pid, net: acc[pid].net }, acc[pid]));
  }
  return { ok:true, byProject: acc, projects };

async smbBackupBundle(store, connector, opts) =>
  opts = opts || {};
  if(!store || typeof store.snapshot !== "function") return { ok:false, code:"invalid_opts", error:"smbBackupBundle: store is required" };
  if(!connector || typeof connector.publish !== "function") return { ok:false, code:"invalid_opts", error:"smbBackupBundle: opts.connector is required" };
  let payload = { schemaVersion:1, tool:"the-ledger", kind:"full-backup", data: store.snapshot(), exportedAt: new Date().toISOString() };
  let name = opts.name || ("backup-" + Date.now());
  return await connector.publish("backup", payload, { name, editKey: opts.editKey, dryRun: opts.dryRun, uploadPlugin: opts.uploadPlugin });

smbFullBackupDownload(store, filename) =>
  if(!store || typeof store.download !== "function") return { ok:false, code:"invalid_opts", error:"smbFullBackupDownload: store is required" };
  return store.download(filename || (store.toolStub + "-backup.json"));

// ── 29b. THE LEDGER — SELF-TESTS ──────────────────────
// Hermetic: in-memory ledger store + fake bus. Run via root.smbLedgerSelfTest().
async smbLedgerSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  function memStore() { let map = {}; return { get:k => (k in map) ? map[k] : null, set:(k,v) => { map[k] = v; return true; }, remove:k => { delete map[k]; } }; }
  let files = {};
  let fakeUpload = { editable: { async set(name, text, opts) { files[name] = text; return { editKey:"k-"+name, editCount:Object.keys(files).length }; } } };
  let fakeFetch = async (url) => { let name = url.split("/").pop(); if(!(name in files)) return { status:404, ok:false, text:async () => "nope" }; return { status:200, ok:true, text:async () => files[name] }; };
  let led = smbCreateLedgerStore({ toolStub:"the-ledger", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let conn = smbCreateConnector({ toolStub:"the-ledger", toolDisplayName:"The Ledger", syncTracker: function(){ return { ok:true }; } });
  let manifestObj = { schemaVersion:1, tools:[] };
  manifestObj = smbRegisterTool(manifestObj, { stub:"project-master", displayName:"Project Master", publishes:["project","project-index","milestone-event"], consumes:["payment-receipt"] });
  manifestObj = smbRegisterTool(manifestObj, { stub:"the-ledger", displayName:"The Ledger", publishes:["payment-receipt","payment-receipt-index","backup"], consumes:["milestone-event"] });
  await conn.configure(manifestObj);

  t("default chart has cash, AR, revenue, expenses", led.listAccounts().length === 4 && !!led.getAccount("assets-cash") && !!led.getAccount("income-revenue"));

  let evt = { schemaVersion:1, eventId:"evt-abc", projectId:"prj-1", milestoneId:"mil-1", milestoneTitle:"Launch MVP", client:"Acme", amount:500, date:"2026-09-01" };
  let ing = await smbIngestMilestoneEvent(led, evt, { persist:false });
  t("ingest creates a pending-approval invoice draft", ing.ok && ing.invoice.status === "pending-approval" && ing.invoice.id === "inv-evt-abc");
  let ing2 = await smbIngestMilestoneEvent(led, evt, { persist:false });
  t("re-ingesting the same event is deduped", ing2.ok === false && ing2.code === "deduped");
  t("draft log tracks ingestion", led.wasIngested("evt-abc") === true);

  let post = await smbPostInvoice(led, "inv-evt-abc", { persist:false });
  t("posting journals Dr AR / Cr revenue + updates balances", post.ok && led.getAccount("assets-ar").balance === 500 && led.getAccount("income-revenue").balance === 500);
  t("posting flips invoice to issued", post.ok && post.invoice.status === "issued" && !!post.invoice.issuedAt);
  let post2 = await smbPostInvoice(led, "inv-evt-abc", { persist:false });
  t("re-posting is refused (already_posted)", post2.ok === false && post2.code === "already_posted");

  let exp = await smbRecordExpense(led, { amount: 120, memo:"Hosting", projectId:"prj-1", persist:false });
  t("recordExpense books cash out + expense", exp.ok && led.getAccount("expense-general").balance === 120 && led.getAccount("assets-cash").balance === -120);

  let pay = await smbRecordPayment(led, "inv-evt-abc", 300, "2026-09-10", { connector: conn, uploadPlugin: fakeUpload, persist:false });
  t("partial payment → partially-paid + published receipt", pay.ok && pay.status === "partially-paid" && !!files["payment-receipt-" + pay.payment.id] && !!files["payment-receipt-index"]);
  let pay2 = await smbRecordPayment(led, "inv-evt-abc", 200, "2026-09-15", { connector: conn, uploadPlugin: fakeUpload, persist:false });
  t("full payment → paid", pay2.ok && pay2.status === "paid");
  t("paying a paid invoice is refused", (await smbRecordPayment(led, "inv-evt-abc", 10, "2026-09-16", { connector: conn, persist:false })).code === "invalid_status");

  let rep = smbLedgerReport(led);
  t("report nets income minus expenses", rep.ok && rep.income === 500 && rep.expense === 120 && Math.abs(rep.net - 380) < 0.001);
  let pnl = smbPerProjectPnl(led);
  t("per-project P&L attributes income + expense", pnl.ok && pnl.byProject["prj-1"] && Math.abs(pnl.byProject["prj-1"].net - 380) < 0.001);

  let rev = await smbReverseEntry(led, post.transaction.id, { persist:false });
  t("reversal cancels the entry + marks reversed", rev.ok && led.getAccount("income-revenue").balance === 0 && led.getTransaction(post.transaction.id).reversedById === rev.reversal.id);
  let rev2 = await smbReverseEntry(led, post.transaction.id, { persist:false });
  t("reversing twice is refused", rev2.ok === false && rev2.code === "already_posted");

  let bk = await smbBackupBundle(led, conn, { uploadPlugin: fakeUpload });
  t("backup bundle publishes", bk.ok && Object.keys(files).some(k => k.indexOf("backup-") === 0));

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 30. CONFLICT PREVIEW — FIELD-LEVEL MERGE TABLE ────────
// Renders the local-vs-remote diff of a workspace conflict as an HTML table
// (field, kind, local value, remote value) so a UI can show the user exactly
// what diverged before they pick mine / theirs / merge. Built on
// smbCreateConflictResolver; kind colors: conflict #f43f5e, same #94a3b8,
// local-only / remote-only #f59e0b. All values are HTML-escaped. Never throws.
//
//   let html = root.smbConflictPreviewHtml(res.local, res.remote);
//   document.querySelector("#conflictCtn").innerHTML = html;

smbConflictPreviewHtml(local, remote) =>
  let resolver = smbCreateConflictResolver({});
  let f = resolver.fields(local || {}, remote || {});
  let esc = (v) => {
    if(v === undefined) return "<i style=\"color:#94a3b8;\">absent</i>";
    return String(JSON.stringify(v)).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  };
  let rows = f.map(fld => {
    let kindColor = fld.kind === "conflict" ? "#f43f5e" : (fld.kind === "same" ? "#94a3b8" : "#f59e0b");
    let kindLabel = fld.kind === "local" ? "local only" : (fld.kind === "remote" ? "remote only" : fld.kind);
    return "<tr>" +
      "<td style=\"padding:5px 10px;border:1px solid #e2e8f0;font-weight:600;\">" + esc(fld.path) + "</td>" +
      "<td style=\"padding:5px 10px;border:1px solid #e2e8f0;color:" + kindColor + ";\">" + kindLabel + "</td>" +
      "<td style=\"padding:5px 10px;border:1px solid #e2e8f0;font-family:ui-monospace,monospace;font-size:12px;\">" + esc(fld.local) + "</td>" +
      "<td style=\"padding:5px 10px;border:1px solid #e2e8f0;font-family:ui-monospace,monospace;font-size:12px;\">" + esc(fld.remote) + "</td>" +
    "</tr>";
  }).join("");
  return "<table style=\"border-collapse:collapse;width:100%;font-size:13px;background:#fff;\">" +
    "<thead><tr style=\"background:#f8fafc;\"><th style=\"text-align:left;padding:5px 10px;border:1px solid #cbd5e1;\">Field</th><th style=\"text-align:left;padding:5px 10px;border:1px solid #cbd5e1;\">Kind</th><th style=\"text-align:left;padding:5px 10px;border:1px solid #cbd5e1;\">Local</th><th style=\"text-align:left;padding:5px 10px;border:1px solid #cbd5e1;\">Remote</th></tr></thead><tbody>" +
    rows + "</tbody></table>";

// Self-tests for conflict resolution + the preview table — two simulated
// devices on one shared bus (each store gets its own in-memory cache). Run via
// root.smbConflictSelfTest().
async smbConflictSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  function memStore() { let map = {}; return { get:k => (k in map) ? map[k] : null, set:(k,v) => { map[k] = v; return true; }, remove:k => { delete map[k]; } }; }
  let files = {};
  let fakeUpload = { editable: { async set(name, text, opts) { files[name] = text; return { editKey:"k-"+name, editCount:Object.keys(files).length }; } } };
  let fakeFetch = async (url) => { let name = url.split("/").pop(); if(!(name in files)) return { status:404, ok:false, text:async () => "nope" }; return { status:200, ok:true, text:async () => files[name] }; };

  // device 1 creates + publishes; device 2 pulls; both edit the same field;
  // device 1 pushes; device 2 pulls again → both-changed conflict.
  // Each scenario uses its OWN toolStub so the localStorage edit-key/hash/
  // edit-count scratch that the bus writes never leaks between scenarios or
  // from earlier self-tests (that made this test order-dependent).
  let scenarioN = 0;
  async function diverged(device2Title) {
    scenarioN++;
    let toolStub = "conflict-dev" + scenarioN;
    let d1 = smbCreateIdeaStore({ toolStub, store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
    let n = d1.newIdea({ title:"Base", goals:["g"], scope:["s"] });
    let up = await d1.syncUp({ uploadPlugin: fakeUpload });
    if(!up.ok) return { error: up };
    let d2 = smbCreateIdeaStore({ toolStub, store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
    let down = await d2.syncDown();
    if(!down.ok) return { error: down };
    d2.updateIdea(n.idea.id, { title: device2Title });
    d1.updateIdea(n.idea.id, { title:"Device 1 title" });
    await d1.syncUp({ uploadPlugin: fakeUpload });
    return { d1, d2, id: n.idea.id };
  }

  let a = await diverged("Device 2 title");
  let aRes = a.error ? null : await a.d2.syncDown();
  t("diverged() setup works", !!a.d2);
  if(a.error) {
    t("both-changed → typed conflict", false);
  } else {
    t("both-changed → typed conflict", aRes && aRes.ok === false && aRes.code === "conflict" && aRes.conflict === true);
    t("conflict carries local + remote snapshots", aRes && aRes.local && aRes.remote && aRes.local.ideas[0].title === "Device 2 title" && aRes.remote.ideas[0].title === "Device 1 title");
    let mine = await a.d2.resolveConflict("mine");
    t("resolve mine keeps the local edit", mine.ok && a.d2.getIdea(a.id).title === "Device 2 title");
  }

  let b = await diverged("T2");
  if(b.error) {
    t("resolve theirs keeps the remote edit", false);
  } else {
    let bRes = await b.d2.syncDown();
    t("second scenario also conflicts", bRes && bRes.ok === false && bRes.code === "conflict");
    let theirs = await b.d2.resolveConflict("theirs");
    t("resolve theirs keeps the remote edit", theirs.ok && b.d2.getIdea(b.id).title === "Device 1 title");
  }

  let c = await diverged("T3");
  if(c.error) {
    t("resolve merge keeps local by default", false);
  } else {
    await c.d2.syncDown();
    let merged = await c.d2.resolveConflict("merge");
    t("resolve merge keeps local by default on conflicting fields", merged.ok && c.d2.getIdea(c.id).title === "T3");
  }

  // Flat-payload tests for the raw resolver + preview table.
  let lv = { title:"Local title", amount:100, status:"active" };
  let rv = { title:"Remote title", amount:100, status:"paused" };
  let r = smbCreateConflictResolver({});
  let preview = r.preview(lv, rv);
  t("preview lists only the truly conflicting fields", preview.ok && preview.conflicts.includes("title") && preview.conflicts.includes("status") && !preview.conflicts.includes("amount"));
  let m2 = r.merge({ local: lv, remote: rv, choices:{ title:"remote" } });
  t("merge honors per-field choices ({title:'remote'})", m2.ok && m2.merged.title === "Remote title" && m2.merged.amount === 100);
  let html = smbConflictPreviewHtml(lv, rv);
  t("preview html shows both values, kinds and the conflict color", html.indexOf("Local title") !== -1 && html.indexOf("Remote title") !== -1 && html.indexOf("conflict") !== -1 && html.indexOf("#f43f5e") !== -1);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 31. SAFETY NETS — RESTORE + BACKUP DOWNLOAD ───────────
// Two guards against data loss. smbRestoreFromFile parses a downloaded backup
// file (JSON text, or a browser File with .text()) and restores it into a
// workspace store, then re-publishes it to the bus (persist:false to only
// apply locally). smbBackupDownload is the friendly alias of
// smbFullBackupDownload (a plain <a download> of the store's backup JSON).
// Both never throw.
//
//   let file = input.files[0];                      // <input type="file">
//   let r = await root.smbRestoreFromFile(file, { store });
//   root.smbBackupDownload(store, "my-ledger-backup.json");

async smbRestoreFromFile(file, opts) =>
  opts = opts || {};
  if(file === undefined || file === null) {
    return { ok:false, code:"invalid_opts", error:"smbRestoreFromFile: pass the backup file — JSON text, or a File/Blob with a .text() method" };
  }
  let text;
  try {
    if(typeof file === "string") text = file;
    else if(typeof file.text === "function") text = await file.text();
    else return { ok:false, code:"invalid_opts", error:"smbRestoreFromFile: the file must be JSON text or an object with a .text() method (a <input type=file> File works)" };
  } catch(e) {
    return { ok:false, code:"malformed", error:"could not read the backup file: " + e.message };
  }
  let parsed;
  try { parsed = JSON.parse(text); }
  catch(e) { return { ok:false, code:"malformed", error:"the backup file is not valid JSON: " + e.message }; }
  if(!parsed || typeof parsed !== "object" || Array.isArray(parsed) || !parsed.data || typeof parsed.data !== "object" || Array.isArray(parsed.data)) {
    return { ok:false, code:"malformed", error:"the backup file is not an smb workspace backup — expected an object with a 'data' field (use the store's backup()/download() to create one)" };
  }
  let store = opts.store;
  if(!store || typeof store.restore !== "function") {
    return { ok:false, code:"invalid_opts", error:"smbRestoreFromFile: opts.store (a workspace store) is required" };
  }
  let r = store.restore(parsed);
  if(!r.ok) return r;
  if(opts.persist !== false) {
    let up = await store.syncUp({ uploadPlugin: opts.uploadPlugin, editKey: opts.editKey });
    if(!up.ok) return Object.assign({ ok:true, restoreApplied:true, warning:"the restore was applied locally but could not be re-published to the bus: " + (up.error || up.code), sync:up }, r);
  }
  return Object.assign({ ok:true, restoreApplied:true, note:"the store now holds the backup data" }, r);

smbBackupDownload(store, filename) =>
  return smbFullBackupDownload(store, filename);

// Self-tests for the safety nets. Run via root.smbSafetyNetSelfTest().
async smbSafetyNetSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  function memStore() { let map = {}; return { get:k => (k in map) ? map[k] : null, set:(k,v) => { map[k] = v; return true; }, remove:k => { delete map[k]; } }; }
  let files = {};
  let fakeUpload = { editable: { async set(name, text, opts) { files[name] = text; return { editKey:"k-"+name, editCount:Object.keys(files).length }; } } };
  let fakeFetch = async (url) => { let name = url.split("/").pop(); if(!(name in files)) return { status:404, ok:false, text:async () => "nope" }; return { status:200, ok:true, text:async () => files[name] }; };

  let s = smbCreateIdeaStore({ toolStub:"idea-incubator", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let n = s.newIdea({ title:"Pre-backup", goals:["g"], scope:["s"] });
  let backup = s.backup();
  t("store.backup() wraps a data snapshot", backup && backup.kind === "workspace-backup" && backup.data && backup.data.ideas.length === 1);
  let badRestore = s.restore({ hello: 1 });
  t("restore of a non-backup object is refused", badRestore.ok === false && badRestore.code === "invalid_backup");
  s.newIdea({ title:"Post-backup", goals:["g"], scope:["s"] });
  t("store grew to two ideas", s.listIdeas().length === 2);
  let okRestore = s.restore(backup);
  t("restore rewinds the store to the backup", okRestore.ok && s.listIdeas().length === 1 && s.getIdea(n.idea.id).title === "Pre-backup");

  let rFile = await smbRestoreFromFile(JSON.stringify(backup), { store:s });
  t("restoreFromFile parses JSON text + restores", rFile.ok && rFile.restoreApplied === true);
  let rBlob = await smbRestoreFromFile({ text: async () => JSON.stringify(backup) }, { store:s, persist:false });
  t("restoreFromFile with a File-like object works", rBlob.ok && rBlob.restoreApplied === true);
  let rGarbage = await smbRestoreFromFile("not json {{{", { store:s });
  t("restoreFromFile with garbage text → malformed", rGarbage.ok === false && rGarbage.code === "malformed");
  let rNotBackup = await smbRestoreFromFile(JSON.stringify({ hello:1 }), { store:s });
  t("restoreFromFile with a non-backup object → malformed", rNotBackup.ok === false && rNotBackup.code === "malformed");
  let rNoFile = await smbRestoreFromFile(null, { store:s });
  t("restoreFromFile with no file → invalid_opts", rNoFile.ok === false && rNoFile.code === "invalid_opts");
  let rNoStore = await smbRestoreFromFile(JSON.stringify(backup), {});
  t("restoreFromFile without a store → invalid_opts", rNoStore.ok === false && rNoStore.code === "invalid_opts");

  if(typeof document !== "undefined") {
    let dl = smbBackupDownload(s);
    t("backupDownload returns a download receipt", dl.ok && typeof dl.filename === "string" && typeof dl.bytes === "number" && dl.bytes > 0);
  } else {
    t("backupDownload skipped (no DOM in this environment)", true);
  }

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 32. FIXTURES + FULL-PIPELINE INTEGRATION TEST ─────
// smbFixtures() returns ready-made, schema-valid bundle envelopes for every
// pipeline bundle type (plus deliberately broken ones), handy for demos, tests
// and the docs page. smbIntegrationSelfTest() is the end-to-end proof that the
// whole small-business pipeline works over ONE shared file bus: idea-incubator
// refines + exports an idea → project-master discovers + adopts it, runs the
// project, exports a billable milestone event → the ledger discovers + ingests
// the event, posts an invoice, records a payment → project-master reflects the
// payment, and idea-incubator sees its idea adopted (a receipt). Run via
// root.smbIntegrationSelfTest().

smbFixtures() =>
  let env = (bundleType, payload, tool, toolDisplayName, exportedAt) => {
    let b = smbBuildEnvelope({ bundleType, tool, toolDisplayName, source: bundleType + "/fixture.json", exportedAt: exportedAt || new Date().toISOString(), payload });
    return b.ok ? b.bundle : null;
  };
  let now = new Date().toISOString();
  let idea = env("idea", { schemaVersion:1, id:"idea-fixture-1", title:"Fixture idea", description:"A fixture idea", goals:["Launch MVP"], scope:["Listings"], status:"ready" }, "idea-incubator", "Idea Incubator");
  let project = env("project", { schemaVersion:1, id:"prj-fixture-1", name:"Fixture project", status:"active", ideaId:"idea-fixture-1", client:"Acme", milestones:[{ id:"mil-1", title:"Launch MVP", status:"done", billable:true, amount:500, client:"Acme", exportedForBilling:{ at: now, url:"https://editable.uploads.dev/file/project-master/milestone-event-evt-fixture-1" } }] }, "project-master", "Project Master");
  let milestoneEvent = env("milestone-event", { schemaVersion:1, eventId:"evt-fixture-1", projectId:"prj-fixture-1", milestoneId:"mil-1", milestoneTitle:"Launch MVP", client:"Acme", amount:500, date:"2026-09-01" }, "project-master", "Project Master");
  let invoice = env("invoice", { schemaVersion:1, id:"inv-fixture-1", client:"Acme", amount:500, status:"issued", projectId:"prj-fixture-1", milestoneId:"mil-1" }, "the-ledger", "The Ledger");
  let paymentReceipt = env("payment-receipt", { schemaVersion:1, receiptId:"rcpt-fixture-1", invoiceId:"inv-fixture-1", amount:500, date:"2026-09-01", projectId:"prj-fixture-1", milestoneId:"mil-1" }, "the-ledger", "The Ledger");
  let ideaIndex = env("idea-index", { schemaVersion:1, ideas:[{ ideaId:"idea-fixture-1", bundleName:"idea-idea-fixture-1", url:"https://editable.uploads.dev/file/idea-incubator/idea-idea-fixture-1", exportedAt: now }] }, "idea-incubator", "Idea Incubator");
  let projectIndex = env("project-index", { schemaVersion:1, projects:[{ projectId:"prj-fixture-1", name:"Fixture project", status:"active", bundleName:"project-prj-fixture-1", url:"https://editable.uploads.dev/file/project-master/project-prj-fixture-1", exportedAt: now }] }, "project-master", "Project Master");
  let paymentReceiptIndex = env("payment-receipt-index", { schemaVersion:1, receipts:[{ receiptId:"rcpt-fixture-1", invoiceId:"inv-fixture-1", bundleName:"payment-receipt-rcpt-fixture-1", url:"https://editable.uploads.dev/file/the-ledger/payment-receipt-rcpt-fixture-1", exportedAt: now, amount:500, date:"2026-09-01", projectId:"prj-fixture-1", milestoneId:"mil-1" }] }, "the-ledger", "The Ledger");
  let legacyV0 = JSON.parse(JSON.stringify(idea));
  legacyV0.schemaVersion = 0;
  let malformed = { hello: "world" };
  let futureV2 = JSON.parse(JSON.stringify(idea));
  futureV2.payload = Object.assign({}, futureV2.payload, { schemaVersion: 2 });
  return { idea, project, milestoneEvent, invoice, paymentReceipt, ideaIndex, projectIndex, paymentReceiptIndex, legacyV0, malformed, futureV2, now };

// The full three-tool pipeline over one fake shared bus (in-memory files +
// per-tool stores + manifest-driven connectors). Never touches the network.
async smbIntegrationSelfTest() =>
  let out = [];
  let t = (name, cond) => out.push({ name, pass: !!cond });
  function memStore() { let map = {}; return { get:k => (k in map) ? map[k] : null, set:(k,v) => { map[k] = v; return true; }, remove:k => { delete map[k]; } }; }
  let files = {};
  let fakeUpload = { editable: { async set(name, text, opts) { files[name] = text; return { editKey:"k-"+name, editCount:Object.keys(files).length }; } } };
  let fakeFetch = async (url) => { let name = url.split("/").pop(); if(!(name in files)) return { status:404, ok:false, text:async () => "nope" }; return { status:200, ok:true, text:async () => files[name] }; };
  let noopSync = function(){ return { ok:true }; };

  let manifestObj = { schemaVersion:1, tools:[] };
  manifestObj = smbRegisterTool(manifestObj, { stub:"idea-incubator", displayName:"Idea Incubator", publishes:["idea","idea-index"], consumes:["project"] });
  manifestObj = smbRegisterTool(manifestObj, { stub:"project-master", displayName:"Project Master", publishes:["project","project-index","milestone-event"], consumes:["idea","payment-receipt"] });
  manifestObj = smbRegisterTool(manifestObj, { stub:"the-ledger", displayName:"The Ledger", publishes:["invoice","invoice-index","payment-receipt","payment-receipt-index","backup"], consumes:["milestone-event"] });

  let ideaStore = smbCreateIdeaStore({ toolStub:"idea-incubator", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let projectStore = smbCreateProjectStore({ toolStub:"project-master", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let ledgerStore = smbCreateLedgerStore({ toolStub:"the-ledger", store:memStore(), fetchImpl:fakeFetch, uploadPlugin:fakeUpload });
  let ideaConn = smbCreateConnector({ toolStub:"idea-incubator", toolDisplayName:"Idea Incubator", syncTracker:noopSync });
  let projectConn = smbCreateConnector({ toolStub:"project-master", toolDisplayName:"Project Master", syncTracker:noopSync });
  let ledgerConn = smbCreateConnector({ toolStub:"the-ledger", toolDisplayName:"The Ledger", syncTracker:noopSync });
  await ideaConn.configure(manifestObj);
  await projectConn.configure(manifestObj);
  await ledgerConn.configure(manifestObj);

  // Phase 1 — idea-incubator refines + exports an idea.
  let n = ideaStore.newIdea({ title:"Widget marketplace", description:"Sell widgets online", goals:["Launch MVP","Onboard sellers"], scope:["Listings","Checkout","Payments"], successCriteria:["100 sellers"] });
  t("idea created as a draft", n.ok && n.idea.status === "draft");
  smbIdeaRefine(ideaStore, n.idea.id, { successCriteria:["100 sellers","5k orders"] });
  let ready = smbIdeaSetStatus(ideaStore, n.idea.id, "ready");
  t("idea refined → ready", ready.ok && ready.idea.status === "ready");
  let ex = await smbExportIdea(ideaStore, n.idea.id, { connector: ideaConn, uploadPlugin: fakeUpload });
  t("idea exported → idea bundle + idea-index + canonical file published", ex.ok && !!files["idea-" + n.idea.id] && !!files["idea-index"] && !!files["ideas"]);

  // Phase 2 — project-master discovers, adopts, runs + bills.
  let list = await smbListIdeaBundles(projectConn, { fetchImpl: fakeFetch });
  t("project-master discovers the idea via idea-index", list.ok && list.count === 1 && list.ideas[0].idea.id === n.idea.id);
  let draft = smbBuildAdoptionDraft(list.ideas[0].idea);
  t("adoption draft maps goals → milestones, scope → tasks", draft.ok && draft.draft.mapping.milestonesFromGoals === 2 && draft.draft.mapping.tasksFromScope === 3);
  let adopted = await smbApplyAdoption(projectStore, draft.draft, { persist:false });
  t("adoption creates the project (proposed, linked to the idea)", adopted.ok && adopted.project.ideaId === n.idea.id && adopted.project.status === "proposed");
  let pid = adopted.project.id;
  projectStore.markMilestoneBillable(pid, "mil-1", 500, "Acme");
  projectStore.setMilestoneStatus(pid, "mil-1", "done");
  let pex = await smbExportProject(projectStore, pid, { connector: projectConn, uploadPlugin: fakeUpload });
  t("project exported → project bundle + project-index", pex.ok && !!files["project-" + pid] && !!files["project-index"]);
  let evt = await smbExportMilestoneEvent(projectStore, pid, "mil-1", { connector: projectConn, uploadPlugin: fakeUpload });
  let discoverable = evt.ok && !!files["milestone-event-" + evt.eventId] && (() => { let p = JSON.parse(files["project-" + pid]); let ms = (p.payload && p.payload.milestones) || []; return ms.length && !!ms[0].exportedForBilling; })();
  t("billing event exported + project re-exported with exportedForBilling (discoverable)", discoverable);

  // Phase 3 — the ledger discovers, ingests, posts + records a payment.
  let ing = await smbIngestFromBus(ledgerStore, ledgerConn, { fetchImpl: fakeFetch, uploadPlugin: fakeUpload });
  t("ledger discovers + ingests the milestone event", ing.ok && ing.ingested.length === 1);
  let invoiceId = ing.ingested[0];
  let inv = ledgerStore.getInvoice(invoiceId);
  t("ingest created a pending-approval draft for the right amount", inv && inv.status === "pending-approval" && inv.amount === 500 && inv.milestoneId === "mil-1");
  let ing2 = await smbIngestFromBus(ledgerStore, ledgerConn, { fetchImpl: fakeFetch, uploadPlugin: fakeUpload });
  t("re-running ingestion dedups (no duplicate drafts)", ing2.ok && ing2.ingested.length === 0 && ing2.deduped === 1);
  let post = await smbPostInvoice(ledgerStore, invoiceId, { persist:false });
  t("posting journals Dr AR / Cr revenue + flips to issued", post.ok && ledgerStore.getAccount("assets-ar").balance === 500 && ledgerStore.getAccount("income-revenue").balance === 500 && post.invoice.status === "issued");
  let pay = await smbRecordPayment(ledgerStore, invoiceId, 500, "2026-09-10", { connector: ledgerConn, uploadPlugin: fakeUpload, persist:false });
  t("payment → paid + receipt + receipt-index published", pay.ok && pay.status === "paid" && !!files["payment-receipt-" + pay.payment.id] && !!files["payment-receipt-index"]);

  // Phase 4 — project-master reflects the payment against the milestone.
  let statuses = await smbPaymentStatuses(projectStore, projectConn, { fetchImpl: fakeFetch });
  let mil1 = statuses.statuses.find(s => s.milestoneId === "mil-1");
  t("project-master sees the milestone as paid", statuses.ok && mil1 && mil1.state === "paid" && mil1.paid === 500);

  // Phase 5 — idea-incubator sees its idea adopted (a receipt round-trip).
  let rcpts = await smbIdeaReceipts(ideaStore, ideaConn, { fetchImpl: fakeFetch });
  t("idea-incubator sees the adopted project (receipt)", rcpts.ok && rcpts.count === 1 && rcpts.receipts[0].projectName === "Widget marketplace");

  // Phase 6 — fixtures classify correctly.
  let fx = smbFixtures();
  t("fixtures: idea classifies ok", fx.idea && smbClassifyBundle(fx.idea).status === "ok");
  t("fixtures: project (with exportedForBilling) classifies ok", fx.project && smbClassifyBundle(fx.project).status === "ok");
  t("fixtures: milestone-event classifies ok", fx.milestoneEvent && smbClassifyBundle(fx.milestoneEvent).status === "ok");
  t("fixtures: invoice classifies ok", fx.invoice && smbClassifyBundle(fx.invoice).status === "ok");
  t("fixtures: payment-receipt classifies ok", fx.paymentReceipt && smbClassifyBundle(fx.paymentReceipt).status === "ok");
  t("fixtures: the three indexes classify ok", fx.ideaIndex && fx.projectIndex && fx.paymentReceiptIndex && smbClassifyBundle(fx.ideaIndex).status === "ok" && smbClassifyBundle(fx.projectIndex).status === "ok" && smbClassifyBundle(fx.paymentReceiptIndex).status === "ok");
  t("fixtures: legacy v0 envelope → malformed", smbClassifyBundle(fx.legacyV0).status === "malformed");
  t("fixtures: non-bundle object → malformed", smbClassifyBundle(fx.malformed).status === "malformed");
  let fv = smbClassifyBundle(fx.futureV2);
  t("fixtures: future v2 payload → schema_gap (newer)", fv.status === "schema_gap" && fv.newer === true);
  let pb = await smbPullBundle({ url:"https://editable.uploads.dev/file/idea-incubator/idea-fixture-1", fetchImpl: async () => ({ status:200, ok:true, text:async () => JSON.stringify(fx.idea) }) });
  t("fixtures: pulling a valid idea bundle succeeds", pb.ok && pb.bundleType === "idea" && pb.schemaVersion === 1);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 33. SMB PIPELINE — LIVE HUB INDEX + PUB/SUB ───────
// The optional realtime layer. A "hub" (one extra saved generator whose
// server-plugin script is pasted into index.html) keeps a tiny durable index —
// per (tool, bundleType), the latest published bundle name, its edit count and
// publish time. Bundle PAYLOADS stay on the file bus; the hub only ever holds
// this lightweight index, sized to sit far under the 50 MiB state limit.
//
// Two ways a tool talks to the hub:
//   1. SOCKET mode — this generator also runs the hub server script, so
//      root.createServerSocket() connects straight to it (the hub generator
//      itself, or a tool that embedded the hub script).
//   2. BRIDGE mode (§34) — any other tool embeds the
//      hub page in a hidden iframe and exchanges JSON over postMessage. This is
//      the default for normal tools and needs NO server-plugin import.
//
// The hub publishes a change event on a per-tool, per-bundle-type topic
// (smb-hub:<tool>:<bundleType>) plus a broadcast topic (smb-hub:changes) on
// every accepted report, so subscribed tools learn of upstream updates within
// seconds instead of on the next manual refresh.
//
//   let hub = root.smbHubIndex();                    // bridge mode (any tool)
//   await hub.configure();
//   await hub.report({ tool:"idea-incubator", bundleType:"idea", name:"idea-1", editCount:2 });
//   let q = await hub.queryAll();                    // { ok, count, entries:[...] }
//   await hub.subscribe({ tool:"idea-incubator", bundleType:"idea" }, ev => console.log(ev));

// Default hub page URL. Overridable per call ({ url }), or globally via
// window.SMB_HUB_URL (set it in the tool's own index.html).
smbHubUrl(opts) =>
  let o = opts || {};
  if(typeof o.url === "string" && o.url.trim()) return o.url.trim();
  try {
    if(typeof window.SMB_HUB_URL === "string" && window.SMB_HUB_URL.trim()) return window.SMB_HUB_URL.trim();
  } catch(e) {}
  return "https://perchance.org/smb-hub";

// Per-tool, per-bundle-type pub/sub topic (128-byte server limit: 8 + 40 + 1 +
// 40 = 89 max).
smbHubTopic(tool, bundleType) =>
  return "smb-hub:" + String(tool || "") + ":" + String(bundleType || "");

// The canonical change event the hub publishes on report.
smbHubChangeEvent(ev) =>
  let e = ev || {};
  let at = (typeof e.at === "number") ? e.at : (e.atIso ? Date.parse(e.atIso) : Date.now());
  if(Number.isNaN(at)) at = Date.now();
  return {
    type: "change", version: 1,
    tool: e.tool || "", bundleType: e.bundleType || "", name: e.name || "",
    editCount: (typeof e.editCount === "number") ? e.editCount : 0,
    at, atIso: new Date(at).toISOString()
  };

// ArrayBuffer → string (browser side; the server script can't use TextDecoder,
// but this helper runs in the page, where it is available).
smbAb2Str(ab) =>
  try {
    if(typeof TextDecoder !== "undefined") return new TextDecoder().decode(new Uint8Array(ab));
    let u = new Uint8Array(ab), s = "";
    for(let i = 0; i < u.length; i++) s += String.fromCharCode(u[i]);
    return s;
  } catch(e) { return ""; }

// Parse an RPC reply (string JSON or ArrayBuffer) into a typed result. Never
// throws.
smbHubParseRpcReply(reply) =>
  if(reply == null) return { ok:false, code:"empty_reply", error:"the hub returned an empty reply" };
  let str = null;
  if(typeof reply === "string") str = reply;
  else if(typeof ArrayBuffer !== "undefined" && reply instanceof ArrayBuffer) str = smbAb2Str(reply);
  else if(typeof DataView !== "undefined" && reply instanceof DataView) str = smbAb2Str(reply.buffer.slice(reply.byteOffset, reply.byteOffset + reply.byteLength));
  if(str !== null) {
    try {
      let o = JSON.parse(str);
      if(o && typeof o === "object" && !Array.isArray(o)) return Object.assign({}, o);
    } catch(e) {}
  }
  return { ok:false, code:"malformed_reply", error:"the hub reply was not a parseable JSON object" };

// ── Hub socket helpers — for the hub page itself and socket-mode tools ──

// Report a publish to the hub over a direct server socket (used by the hub page
// router and by socket-mode clients).
async smbHubSocketReport(socket, payload) =>
  if(!socket) return { ok:false, code:"no_socket", error:"no hub socket" };
  try {
    await socket.opened;
    if(!socket.rpc || typeof socket.rpc.smbHubReport !== "function") {
      return { ok:false, code:"no_hub_server", error:"the hub server script is missing — add a <script type=\"text/x-server-plugin\"> with smbHubReport to the hub page" };
    }
    let reply = await socket.rpc.smbHubReport(JSON.stringify(payload || {}));
    return smbHubParseRpcReply(reply);
  } catch(e) {
    return { ok:false, code:"rpc_failed", error:String((e && e.message) || e) };
  }

// Query the hub index over a direct server socket (optional {tool,bundleType}
// filter; omit for everything).
async smbHubSocketQuery(socket, payload) =>
  if(!socket) return { ok:false, code:"no_socket", error:"no hub socket" };
  try {
    await socket.opened;
    if(!socket.rpc || typeof socket.rpc.smbHubGetIndex !== "function") {
      return { ok:false, code:"no_hub_server", error:"the hub server script is missing — add a <script type=\"text/x-server-plugin\"> with smbHubGetIndex to the hub page" };
    }
    let reply = await socket.rpc.smbHubGetIndex(JSON.stringify(payload || {}));
    return smbHubParseRpcReply(reply);
  } catch(e) {
    return { ok:false, code:"rpc_failed", error:String((e && e.message) || e) };
  }

// Subscribe a direct server socket to change events (the per-tool/type topic
// and/or the broadcast topic). onEvent receives each {type:"change",...} event
// as it arrives. Returns { ok, topics, remove() }.
async smbHubSocketSubscribe(socket, opts, onEvent) =>
  if(!socket) return { ok:false, code:"no_socket", error:"no hub socket" };
  try {
    await socket.opened;
    if(!socket.rpc || typeof socket.rpc.smbHubSubscribe !== "function") {
      return { ok:false, code:"no_hub_server", error:"the hub server script is missing — add a <script type=\"text/x-server-plugin\"> with smbHubSubscribe to the hub page" };
    }
    let topics = [];
    if(opts && opts.all) topics.push("smb-hub:changes");
    if(opts && opts.tool && opts.bundleType) topics.push(smbHubTopic(opts.tool, opts.bundleType));
    if(topics.length) {
      try { await socket.rpc.smbHubSubscribe(JSON.stringify({ topics })); } catch(e) {}
    }
    let handler = (ev) => {
      let d = ev && ev.data;
      if(typeof d !== "string") return;
      let m; try { m = JSON.parse(d); } catch(e) { return; }
      if(m && m.type === "change" && onEvent) { try { onEvent(m); } catch(e) {} }
    };
    if(typeof socket.addEventListener === "function") socket.addEventListener("message", handler);
    return { ok:true, topics, remove(){ try { if(socket.removeEventListener) socket.removeEventListener("message", handler); } catch(e){} } };
  } catch(e) {
    return { ok:false, code:"rpc_failed", error:String((e && e.message) || e) };
  }

// ── Hub subscription registry + change-event fan-out (the hub page) ──
// The hub page keeps one registry of (tool, bundleType) → the iframes that
// subscribed to it. When the server broadcasts a change event, smbHubNotify
// posts a {op:"notify"} message to each subscribed iframe. "reply" callbacks
// here are the page's per-source postMessage closures; their __source property
// (the iframe window) is what de-duplicates subscriptions from the same iframe.
smbHubSubRegistry() =>
  let map = new Map();   // "tool:type" → Map(source → reply)
  function keyOf(tool, type) { return String(tool) + ":" + String(type); }
  function sourceOf(reply) { return (reply && reply.__source) || null; }
  return {
    add(tool, type, reply) {
      let k = keyOf(tool, type);
      if(!map.has(k)) map.set(k, new Map());
      let m = map.get(k);
      let s = sourceOf(reply);
      m.set(s === null ? reply : s, reply);
    },
    remove(tool, type, reply) {
      let k = keyOf(tool, type);
      let m = map.get(k);
      if(!m) return;
      let s = sourceOf(reply);
      m.delete(s === null ? reply : s);
      if(m.size === 0) map.delete(k);
    },
    get(tool, type) { return map.get(keyOf(tool, type)) || null; },
    topics() { return Array.from(map.keys()); },
    clear() { map.clear(); },
    count() { let n = 0; map.forEach(m => n += m.size); return n; }
  };

// Fan a change event out to every iframe subscribed to its topic. Returns the
// number of iframes notified. Never throws.
smbHubNotify(reg, ev) =>
  if(!reg || !ev || !ev.tool || !ev.bundleType) return 0;
  let subs = reg.get(ev.tool, ev.bundleType);
  if(!subs) return 0;
  let payload = { __smbHub:true, op:"notify", topic:smbHubTopic(ev.tool, ev.bundleType), change: ev };
  let count = 0;
  subs.forEach(reply => { try { reply(payload); count++; } catch(e) {} });
  return count;

// The hub PAGE glue (call it from the hub page's index.html): whenever the
// server broadcasts a change event, forward it to the subscribed iframes via
// the registry. Returns { ok, remove() }.
smbHubAttachGlue(socket, reg) =>
  if(!socket || typeof socket.addEventListener !== "function") return { ok:false, code:"no_socket", error:"smbHubAttachGlue needs a server socket" };
  let handler = (ev) => {
    let d = ev && ev.data;
    if(typeof d !== "string") return;
    let m; try { m = JSON.parse(d); } catch(e) { return; }
    if(m && m.type === "change") smbHubNotify(reg, m);
  };
  socket.addEventListener("message", handler);
  return { ok:true, remove(){ try { if(socket.removeEventListener) socket.removeEventListener("message", handler); } catch(e){} } };

// ── Socket-mode hub client ──
// For the hub generator itself (or any tool that embeds the hub server script):
// a direct socket to the local server. Implements the same surface as the
// bridge client (section 34) so the dashboard can use either.
smbCreateHubSocketClient(opts) =>
  opts = opts || {};
  let createSocket = opts.createSocket || null;
  let socket = null;
  let state = "idle";

  async function configure() {
    if(state === "connected") return { ok:true, state, mode:"socket" };
    try {
      socket = (typeof createSocket === "function") ? createSocket() : null;
      if(!socket) { state = "offline"; return { ok:false, code:"no_socket", error:"no createServerSocket available — the hub needs the server-plugin import", state }; }
      await socket.opened;
      if(socket.rpc && typeof socket.rpc.smbHubSubscribe === "function") {
        try { await socket.rpc.smbHubSubscribe(JSON.stringify({ all:true })); } catch(e) {}
      }
      state = "connected";
      return { ok:true, state, mode:"socket" };
    } catch(e) {
      state = "offline";
      return { ok:false, code:"hub_unavailable", error:String((e && e.message) || e), state };
    }
  }

  async function rpc(name, payload) {
    if(state !== "connected") return { ok:false, code:"hub_unavailable", error:"hub socket not connected (" + state + ")", state };
    try {
      let reply = await socket.rpc[name](JSON.stringify(payload || {}));
      return smbHubParseRpcReply(reply);
    } catch(e) {
      return { ok:false, code:"rpc_failed", error:String((e && e.message) || e), state };
    }
  }

  async function report(p) { return rpc("smbHubReport", p); }
  async function query(p) { return rpc("smbHubGetIndex", p); }
  async function queryAll() { return rpc("smbHubGetIndex", {}); }

  function onEvent(cb) {
    if(!socket || typeof socket.addEventListener !== "function") return { ok:false, code:"no_socket" };
    let handler = (ev) => {
      let d = ev && ev.data;
      if(typeof d !== "string") return;
      let m; try { m = JSON.parse(d); } catch(e) { return; }
      if(m && m.type === "change") { try { cb(m); } catch(e) {} }
    };
    socket.addEventListener("message", handler);
    return { ok:true, remove(){ try { if(socket.removeEventListener) socket.removeEventListener("message", handler); } catch(e){} } };
  }

  function available() { return state === "connected"; }
  function status() { return { state, mode:"socket" }; }
  async function close() { if(socket && typeof socket.close === "function") { try { socket.close(1000); } catch(e){} } socket = null; state = "offline"; return { ok:true }; }

  return { configure, report, query, queryAll, onEvent, subscribe: onEvent, available, status, close, kind:"socket" };

// ── The unified hub client ──
// smbHubIndex(opts) picks the transport: an explicit transport wins, then a
// createSocket (socket mode), else the postMessage bridge to the hub page.
smbHubIndex(opts) =>
  let o = opts || {};
  if(o.transport) return smbCreateHubBridge(Object.assign({}, o, { transport: o.transport }));
  if(o.createSocket) return smbCreateHubSocketClient({ createSocket: o.createSocket, timeoutMs: o.timeoutMs });
  return smbCreateHubBridge({ hubUrl: o.hubUrl || smbHubUrl(o), timeoutMs: o.timeoutMs, pollIntervalMs: o.pollIntervalMs });

// ── Hub self-tests — hermetic: a fake socket simulates the hub
// server's RPC surface, so the client protocol is tested without a network.
smbHubFakeSocket(state) =>
  state = state || { entries: new Map(), publishes: [] };
  let handlers = new Set();
  let rpc = {
    async smbHubReport(data) {
      let p = JSON.parse(data || "{}");
      if(!p || !p.tool || !p.bundleType || !p.name) return JSON.stringify({ ok:false, code:"invalid_opts", error:"bad report" });
      let e = { tool:p.tool, bundleType:p.bundleType, name:p.name, editCount:(typeof p.editCount === "number") ? p.editCount : 0, at:(typeof p.at === "number") ? p.at : Date.now() };
      state.entries.set(p.tool + ":" + p.bundleType, e);
      let ev = JSON.stringify({ type:"change", version:1, tool:e.tool, bundleType:e.bundleType, name:e.name, editCount:e.editCount, at:e.at, atIso:new Date(e.at).toISOString() });
      state.publishes.push(ev);
      handlers.forEach(h => { try { h({ data: ev }); } catch(e) {} });
      return JSON.stringify({ ok:true, tool:e.tool, bundleType:e.bundleType, name:e.name, editCount:e.editCount });
    },
    async smbHubGetIndex(data) {
      let p = JSON.parse(data || "{}");
      let entries = [];
      state.entries.forEach(e => {
        if(p.tool && p.tool !== e.tool) return;
        if(p.bundleType && p.bundleType !== e.bundleType) return;
        entries.push(Object.assign({}, e));
      });
      entries.sort((a, b) => a.at - b.at);
      return JSON.stringify({ ok:true, hub:1, count:entries.length, entries });
    },
    async smbHubSubscribe(data) { state.subscribed = JSON.parse(data || "{}"); return JSON.stringify({ ok:true }); },
    async smbHubUnsubscribe(data) { return JSON.stringify({ ok:true }); }
  };
  return {
    opened: Promise.resolve(),
    rpc,
    addEventListener(ev, h) { if(ev === "message") handlers.add(h); },
    removeEventListener(ev, h) { handlers.delete(h); },
    close() {}
  };

async smbHubSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });

  t("hub topic names the per-tool/type topic", smbHubTopic("idea-incubator", "idea") === "smb-hub:idea-incubator:idea");
  let ev = smbHubChangeEvent({ tool:"project-master", bundleType:"project", name:"project", editCount:4, at:1234567890 });
  t("change event is a versioned {type:'change'} envelope", ev.type === "change" && ev.version === 1 && ev.tool === "project-master" && ev.bundleType === "project" && ev.editCount === 4 && ev.atIso === new Date(1234567890).toISOString());
  t("default hub URL is the smb-hub generator page", smbHubUrl() === "https://perchance.org/smb-hub");
  t("hub URL honours an explicit override", smbHubUrl({ url:"https://example.com/hub" }) === "https://example.com/hub");

  let okReply = smbHubParseRpcReply(JSON.stringify({ ok:true, count:2 }));
  t("parses a string JSON RPC reply", okReply.ok === true && okReply.count === 2);
  let abReply = smbHubParseRpcReply(new TextEncoder().encode(JSON.stringify({ ok:true, count:1 })).buffer);
  t("parses an ArrayBuffer RPC reply", abReply.ok === true && abReply.count === 1);
  let junk = smbHubParseRpcReply("not json at all");
  t("garbage reply → malformed_reply (never throws)", junk.ok === false && junk.code === "malformed_reply");
  let empty = smbHubParseRpcReply(null);
  t("null reply → empty_reply", empty.ok === false && empty.code === "empty_reply");

  let reg = smbHubSubRegistry();
  let r1 = () => {}, r2 = () => {};
  reg.add("a", "idea", r1);
  reg.add("a", "idea", r2);
  reg.add("a", "idea", r1);   // same source again → no duplicate
  t("registry keeps distinct sources, de-dupes the same source", reg.count() === 2);
  let n = smbHubNotify(reg, smbHubChangeEvent({ tool:"a", bundleType:"idea", name:"idea", editCount:1 }));
  t("notify fans out to every subscriber", n === 2);
  reg.remove("a", "idea", r1);
  t("remove drops one subscriber", reg.count() === 1);
  let n2 = smbHubNotify(reg, smbHubChangeEvent({ tool:"a", bundleType:"idea", name:"idea", editCount:2 }));
  t("notify after removal reaches the remaining one", n2 === 1);
  t("notify with no matching topic → 0", smbHubNotify(reg, smbHubChangeEvent({ tool:"nope", bundleType:"x", name:"x", editCount:1 })) === 0);

  let fs = smbHubFakeSocket();
  let sc = smbCreateHubSocketClient({ createSocket: () => fs });
  let cfg = await sc.configure();
  t("socket client configures against a hub server", cfg.ok && cfg.mode === "socket" && sc.available());
  let rep = await sc.report({ tool:"idea-incubator", bundleType:"idea", name:"idea-1", editCount:1, at: Date.now() });
  t("socket client reports a publish", rep.ok === true);
  let q = await sc.queryAll();
  t("socket client queries the whole index", q.ok && q.count === 1 && q.entries[0].tool === "idea-incubator");
  let qf = await sc.query({ tool:"the-ledger", bundleType:"invoice" });
  t("socket client query filters by tool", qf.ok && qf.count === 0);
  let got = [];
  await sc.onEvent(e => got.push(e));
  await sc.report({ tool:"project-master", bundleType:"project", name:"project", editCount:2, at: Date.now() });
  t("socket client receives change events", got.length === 1 && got[0].bundleType === "project" && got[0].editCount === 2);
  await sc.close();
  let afterClose = await sc.report({ tool:"a", bundleType:"idea", name:"x", editCount:1 });
  t("socket client reports hub_unavailable after close", afterClose.ok === false && afterClose.code === "hub_unavailable");

  let fs2 = smbHubFakeSocket();
  let off = smbCreateHubSocketClient({ createSocket: () => null });
  let cfgOff = await off.configure();
  t("socket client with no socket → offline, no throw", cfgOff.ok === false && cfgOff.code === "no_socket" && off.available() === false);
  void fs2;

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 34. SMB PIPELINE — HUB BRIDGE + DEGRADE-TO-POLLING ────
// Any tool can embed the hub page in a hidden iframe and exchange subscribe /
// notify / report / query JSON over postMessage — no server-plugin import
// needed on the tool side. When the hub is unreachable the bridge degrades to
// polling the file bus directly, so the pipeline never depends on the hub being
// open. The same message router below is what the hub page itself runs.
//
//   let bridge = root.smbHubIndex({ hubUrl: "https://perchance.org/smb-hub" });
//   let c = await bridge.configure();           // { ok, state:"connected"|"offline" }
//   await bridge.report({ tool, bundleType, name, editCount });
//   await bridge.subscribe({ tool, bundleType }, ev => console.log(ev));
//   // hub down? — fall back to polling the bus:
//   bridge.startPolling(async (tool, bundleType) => await conn.pull(bundleType, { from: tool }), { types: [...], onPoll: r => {...} });

// Hidden-iframe transport. post() posts to the iframe; onMessage registers the
// handler for replies/notifies from it; close() tears it down.
smbHubIframeTransport(opts) =>
  let url = (opts && opts.url) || "";
  let iframe = null, started = false, cb = null;
  let listener = (event) => {
    if(!iframe || event.source !== iframe.contentWindow) return;
    let m = event.data;
    if(!m || m.__smbHub !== true) return;
    if(cb) { try { cb(m); } catch(e) {} }
  };
  function ensure() {
    if(started) return;
    started = true;
    iframe = document.createElement("iframe");
    iframe.setAttribute("src", url);
    iframe.setAttribute("aria-hidden", "true");
    iframe.setAttribute("tabindex", "-1");
    iframe.style.cssText = "position:fixed;width:1px;height:1px;border:0;left:-9999px;top:-9999px;opacity:0;pointer-events:none;";
    (document.body || document.documentElement).appendChild(iframe);
    window.addEventListener("message", listener);
  }
  function post(msg) { ensure(); try { iframe.contentWindow.postMessage(msg, "*"); } catch(e) { throw e; } }
  function onMessage(c) { cb = c; }
  function close() {
    try { window.removeEventListener("message", listener); } catch(e) {}
    if(iframe && iframe.parentNode) { try { iframe.parentNode.removeChild(iframe); } catch(e) {} }
    iframe = null; started = false; cb = null;
  }
  return { post, onMessage, close, kind:"iframe" };

// Mock transport for tests — simulates the hub page running the REAL router
// (smbHubRouter) against a server socket, with postMessage replies routed back
// to the bridge. _inject(msg) simulates a server-driven notify.
smbHubMockTransport(router) =>
  let cb = null;
  function post(msg) {
    let reply = (payload) => { if(cb) { try { cb(payload); } catch(e) {} } };
    try { router(msg, reply); } catch(e) {}
  }
  function onMessage(c) { cb = c; }
  function close() { cb = null; }
  function _inject(msg) { if(cb) { try { cb(msg); } catch(e) {} } }
  return { post, onMessage, close, _inject, kind:"mock" };

// The hub PAGE's message router. msg is a {__smbHub:true, op, reqId, payload}
// message from an embedded iframe; reply(payload) posts the answer back to that
// iframe. The same router drives the mock transport in tests, so the test
// exercises the exact production message flow.
smbHubRouter(socket, reg) =>
  return async function handleClientMessage(msg, reply) {
    if(!msg || msg.__smbHub !== true || typeof msg.op !== "string") return;
    let sendReply = (result) => {
      let r = result || { ok:false, code:"error", error:"no result" };
      try { reply({ __smbHub:true, op:"reply", reqId:msg.reqId, ok:!!r.ok, result:r }); } catch(e) {}
    };
    try {
      if(msg.op === "ready") {
        sendReply({ ok:true, hub:true, mode:"bridge", generatorName:(typeof window !== "undefined" && window.generatorName) ? window.generatorName : null });
      }
      else if(msg.op === "report") {
        let r = await smbHubSocketReport(socket, msg.payload || {});
        sendReply(r);
      }
      else if(msg.op === "query") {
        let r = await smbHubSocketQuery(socket, msg.payload || {});
        sendReply(r);
      }
      else if(msg.op === "subscribe") {
        let p = msg.payload || {};
        if(!p.tool || !p.bundleType) { sendReply({ ok:false, code:"invalid_opts", error:"hub subscribe needs { tool, bundleType }" }); return; }
        if(reg && typeof reg.add === "function") reg.add(p.tool, p.bundleType, reply);
        sendReply({ ok:true, subscribed:true, topic:smbHubTopic(p.tool, p.bundleType) });
      }
      else if(msg.op === "unsubscribe") {
        let p = msg.payload || {};
        if(reg && typeof reg.remove === "function") reg.remove(p.tool, p.bundleType, reply);
        sendReply({ ok:true, unsubscribed:true });
      }
      else {
        sendReply({ ok:false, code:"unknown_op", error:"unknown hub op '" + String(msg.op) + "'" });
      }
    } catch(e) {
      sendReply({ ok:false, code:"error", error:String((e && e.message) || e) });
    }
  };

// The bridge client — the transport-agnostic hub client any tool uses.
smbCreateHubBridge(opts) =>
  opts = opts || {};
  let url = opts.hubUrl || smbHubUrl(opts);
  let timeoutMs = (typeof opts.timeoutMs === "number" && opts.timeoutMs > 0) ? opts.timeoutMs : 6000;
  let pollIntervalMs = (typeof opts.pollIntervalMs === "number" && opts.pollIntervalMs > 0) ? opts.pollIntervalMs : 15000;
  let transport = opts.transport || null;
  let state = "idle";            // idle | connecting | connected | offline
  let connected = false;
  let reqId = 0;
  let pending = new Map();       // reqId → { resolve, timer }
  let subs = new Map();          // "tool:type" → Set<onEvent>
  let inbound = null;
  let pollTimer = null;

  function makeTransport() {
    if(transport) return transport;
    return smbHubIframeTransport({ url });
  }
  function rawSend(op, payload, resolve) {
    let id = ++reqId;
    let timer = setTimeout(() => {
      if(!pending.has(id)) return;
      pending.delete(id);
      resolve({ ok:false, code:"timeout", error:"no reply from the hub within " + timeoutMs + "ms" });
    }, timeoutMs);
    pending.set(id, { resolve, timer });
    try {
      inbound.post({ __smbHub:true, reqId:id, op, payload });
    } catch(e) {
      clearTimeout(timer);
      pending.delete(id);
      resolve({ ok:false, code:"send_failed", error:String((e && e.message) || e) });
    }
  }
  function send(op, payload) {
    if(!connected) return Promise.resolve({ ok:false, code:"hub_unavailable", error:"hub bridge not connected (" + state + ")", state });
    return new Promise(resolve => rawSend(op, payload, resolve));
  }
  function onTransportMessage(msg) {
    if(!msg || msg.__smbHub !== true) return;
    if(msg.op === "reply" && msg.reqId != null && pending.has(msg.reqId)) {
      let p = pending.get(msg.reqId);
      pending.delete(msg.reqId);
      clearTimeout(p.timer);
      let r = (msg.result && typeof msg.result === "object") ? msg.result : {};
      p.resolve({ ok: msg.ok === true, ...r, state });
      return;
    }
    if(msg.op === "notify" && msg.topic && msg.change && msg.change.tool && msg.change.bundleType) {
      let key = msg.change.tool + ":" + msg.change.bundleType;
      let set = subs.get(key);
      if(set) set.forEach(cb => { try { cb(msg.change); } catch(e) {} });
    }
  }

  async function configure() {
    if(state === "connected") return { ok:true, state, mode:"bridge", hubUrl:url };
    state = "connecting";
    try {
      inbound = makeTransport();
      inbound.onMessage(onTransportMessage);
      let res = await new Promise(resolve => rawSend("ready", {}, resolve));
      if(res.ok) {
        connected = true; state = "connected";
        return { ok:true, state, mode:"bridge", hubUrl:url };
      }
      connected = false; state = "offline";
      return { ok:false, code:"hub_unavailable", error:(res.error || "the hub did not answer the ready handshake"), state, hubUrl:url };
    } catch(e) {
      connected = false; state = "offline";
      return { ok:false, code:"hub_unavailable", error:String((e && e.message) || e), state, hubUrl:url };
    }
  }

  async function report(p) { return send("report", p); }
  async function query(p) { return send("query", p); }
  async function queryAll() { return send("query", {}); }

  async function subscribe(p, onEvent) {
    if(!p || !p.tool || !p.bundleType) return { ok:false, code:"invalid_opts", error:"bridge.subscribe needs { tool, bundleType }" };
    let key = p.tool + ":" + p.bundleType;
    if(typeof onEvent === "function") {
      if(!subs.has(key)) subs.set(key, new Set());
      subs.get(key).add(onEvent);
    }
    return send("subscribe", { tool:p.tool, bundleType:p.bundleType });
  }
  async function unsubscribe(p, onEvent) {
    if(!p || !p.tool || !p.bundleType) return { ok:false, code:"invalid_opts", error:"bridge.unsubscribe needs { tool, bundleType }" };
    let key = p.tool + ":" + p.bundleType;
    if(typeof onEvent === "function" && subs.has(key)) subs.get(key).delete(onEvent);
    return send("unsubscribe", { tool:p.tool, bundleType:p.bundleType });
  }

  function available() { return connected; }
  function status() { return { state, mode:"bridge", hubUrl:url }; }

  // Degrade-to-polling fallback: poll the file bus directly (via the caller's
  // pullImpl(tool, bundleType) → smbPullBundle result). Returns what changed.
  async function poll(pullImpl, opts) {
    opts = opts || {};
    let changed = [];
    let types = opts.types || [];
    for(let i = 0; i < types.length; i++) {
      let spec = types[i];
      if(!spec || !spec.tool || !spec.bundleType) continue;
      try {
        let r = await pullImpl(spec.tool, spec.bundleType);
        if(r && r.ok && r.status === "fresh") {
          changed.push({ tool:spec.tool, bundleType:spec.bundleType, name:r.bundleName || spec.bundleType, editCount:(typeof r.editCount === "number") ? r.editCount : 0, at:Date.parse(r.exportedAt) || Date.now(), via:"poll" });
        }
      } catch(e) {}
    }
    return { ok:true, mode:"poll", state:"polling", changed, at:new Date().toISOString() };
  }
  function startPolling(pullImpl, opts) {
    stopPolling();
    let tick = async () => {
      let r = await poll(pullImpl, opts);
      if(opts && opts.onPoll) { try { opts.onPoll(r); } catch(e) {} }
    };
    tick();
    pollTimer = setInterval(tick, pollIntervalMs);
    return { ok:true, mode:"poll", intervalMs: pollIntervalMs };
  }
  function stopPolling() { if(pollTimer) { clearInterval(pollTimer); pollTimer = null; } }

  async function close() {
    stopPolling();
    if(inbound) { try { inbound.close(); } catch(e) {} }
    pending.forEach(p => { clearTimeout(p.timer); try { p.resolve({ ok:false, code:"closed", error:"bridge closed" }); } catch(e) {} });
    pending.clear();
    connected = false; state = "offline";
    return { ok:true };
  }

  return { configure, report, query, queryAll, subscribe, unsubscribe, poll, startPolling, stopPolling, available, status, close, kind:"bridge" };

// ── Bridge self-tests — the FULL message flow over the real router:
// bridge client → mock transport → hub router → fake socket → (change event)
// → hub glue → registry → notify → bridge client. Plus the degrade-to-polling
// fallback and error legs.
async smbBridgeSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });

  let fs = smbHubFakeSocket();
  let reg = smbHubSubRegistry();
  let router = smbHubRouter(fs, reg);
  let bridge = smbCreateHubBridge({ transport: smbHubMockTransport(router), hubUrl:"mock://hub", timeoutMs:2000 });

  let c = await bridge.configure();
  t("bridge configures against the hub page (over the mock transport)", c.ok && c.state === "connected" && c.mode === "bridge");
  t("bridge reports available after handshake", bridge.available() === true);

  let rep = await bridge.report({ tool:"idea-incubator", bundleType:"idea", name:"idea-1", editCount:1, at:Date.now() });
  t("bridge.report reaches the hub server via the router", rep.ok === true);

  let q = await bridge.queryAll();
  t("bridge.queryAll returns the hub index", q.ok && q.count === 1 && q.entries[0].tool === "idea-incubator");
  let qf = await bridge.query({ tool:"the-ledger", bundleType:"invoice" });
  t("bridge.query filters", qf.ok && qf.count === 0);

  let received = [];
  let recvCb = ev => received.push(ev);
  let sub = await bridge.subscribe({ tool:"idea-incubator", bundleType:"idea" }, recvCb);
  t("bridge.subscribe registers with the hub page", sub.ok && sub.subscribed === true);

  let glue = smbHubAttachGlue(fs, reg);
  t("hub page glue attaches to the socket", glue.ok === true);
  await bridge.report({ tool:"idea-incubator", bundleType:"idea", name:"idea-1", editCount:2, at:Date.now() });
  t("a change event flows server → glue → registry → notify → bridge → subscriber", received.length === 1 && received[0].editCount === 2 && received[0].tool === "idea-incubator");

  let other = [];
  await bridge.subscribe({ tool:"project-master", bundleType:"project" }, ev => other.push(ev));
  await bridge.report({ tool:"project-master", bundleType:"project", name:"project", editCount:1, at:Date.now() });
  t("per-topic notify only reaches the right subscribers", other.length === 1 && received.length === 1);

  await bridge.unsubscribe({ tool:"idea-incubator", bundleType:"idea" }, recvCb);
  await bridge.report({ tool:"idea-incubator", bundleType:"idea", name:"idea-1", editCount:3, at:Date.now() });
  t("unsubscribe stops further notifies for that topic", received.length === 1);

  let unknown = await bridge.subscribe({}, () => {});
  t("subscribe without tool/type → invalid_opts", unknown.ok === false && unknown.code === "invalid_opts");
  void other;

  let f2 = smbHubFakeSocket();
  let deadRouter = (msg, reply) => { /* never replies — simulates an unreachable hub page */ };
  let dead = smbCreateHubBridge({ transport: smbHubMockTransport(deadRouter), hubUrl:"mock://dead", timeoutMs:250 });
  let cDead = await dead.configure();
  t("a bridge whose router never replies → hub_unavailable (degrade)", cDead.ok === false && cDead.state === "offline");
  t("unavailable bridge reports available() === false", dead.available() === false);
  let repOff = await dead.report({ tool:"a", bundleType:"idea", name:"x", editCount:1 });
  t("report on an offline bridge → hub_unavailable", repOff.ok === false && repOff.code === "hub_unavailable");

  let polled = [];
  let pb = smbCreateHubBridge({ hubUrl:"mock://poll", timeoutMs:500, pollIntervalMs:25 });
  let pRes = await pb.poll(async (tool, bt) => {
    return { ok:true, status:"fresh", bundleName:bt, tool, exportedAt:new Date().toISOString(), editCount:7 };
  }, { types:[{ tool:"project-master", bundleType:"project" }, { tool:"idea-incubator", bundleType:"idea" }] });
  t("degrade-to-polling detects a fresh upstream bundle", pRes.ok && pRes.mode === "poll" && pRes.changed.length === 2 && pRes.changed[0].editCount === 7);
  let pPoll = pb.poll(async () => ({ ok:true, status:"unchanged" }), { types:[{ tool:"a", bundleType:"idea" }] });
  t("polling with unchanged data reports nothing new", (await pPoll).changed.length === 0);
  let sp = pb.startPolling(async () => { polled.push(1); return { ok:true, status:"unchanged" }; }, { types:[{ tool:"a", bundleType:"idea" }], onPoll: r => {} });
  t("startPolling arms the fallback timer", sp.ok && sp.mode === "poll");
  await new Promise(r => setTimeout(r, 80));   // let the first in-flight tick finish
  let before = polled.length;
  pb.stopPolling();
  await new Promise(r => setTimeout(r, 80));   // past the 25ms interval — a live timer would have fired again
  t("stopPolling halts further polls", polled.length === before);

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// ── 35. SMB PIPELINE — DATA-AGE DASHBOARD ─────────────────
// Each tool shows a "pipeline status" panel: upstream tool last-published times
// and data age per consumed bundle, with a one-click refresh. Powered by the
// hub's index when reachable; falls back to local freshness timestamps (the
// sync tracker) whenever the hub is offline. Pure status computation lives in
// smbPipelineStatus() so it is testable; smbPipelineStatusPanel() renders it
// into a DOM container.
//
//   root.smbPipelineStatusPanel({
//     ctn: document.getElementById("statusCtn"),
//     tool: "idea-incubator",
//     manifest: root.smbDefaultManifest(),
//     hub: root.smbHubIndex(),            // optional — connected → real times
//     onRefresh: async (bundleType) => {  // one-click refresh per row
//       let r = await conn.pull(bundleType, { from: <upstream> });
//       return r;
//     }
//   });

// Pure computation — no DOM. Combines manifest (which bundles this tool
// consumes + who publishes them), the hub index (if reachable) and the local
// sync tracker (fallback) into one status object.
smbPipelineStatus(opts) =>
  opts = opts || {};
  let tool = opts.tool;
  if(!tool) return { ok:false, code:"invalid_opts", error:"smbPipelineStatus needs { tool } — the stub of the tool showing the panel" };
  let manifest = opts.manifest || null;
  let hub = opts.hub || null;
  let hubStatus = (hub && typeof hub.status === "function") ? hub.status() : { state:"offline" };
  let hubConnected = !!(hub && hubStatus.state === "connected" && typeof hub.available === "function" && hub.available());
  let sync = null;
  if(typeof opts.syncStatus === "function") {
    try { sync = opts.syncStatus(); } catch(e) { sync = null; }
  } else if(opts.syncStatus && typeof opts.syncStatus === "object") {
    sync = opts.syncStatus;
  }
  if(!sync || typeof sync !== "object" || Array.isArray(sync)) {
    try { sync = root.smbSyncStatus({ tool, staleAfterMs: opts.staleAfterMs }); } catch(e) { sync = { ok:false, bundles:{}, staleAfterMs: opts.staleAfterMs }; }
  }
  if(!sync.bundles) sync.bundles = {};
  let consumed = [];
  if(manifest) {
    let t = smbFindTool(manifest, tool);
    if(t && Array.isArray(t.consumes)) consumed = t.consumes.slice();
  }
  if(!consumed.length && Array.isArray(opts.bundles)) consumed = opts.bundles.slice();
  let rows = consumed.map(bt => {
    let publishers = (manifest && smbManifestToolsPublishing) ? smbManifestToolsPublishing(manifest, bt) : [];
    let publisher = publishers[0] || null;
    let pubName = null;
    if(publisher && manifest) {
      let pt = smbFindTool(manifest, publisher);
      pubName = (pt && pt.activeNames && pt.activeNames[bt]) || bt;
    }
    let local = (sync && sync.bundles && sync.bundles[bt]) || {};
    return {
      bundleType: bt,
      publishers,
      publisher, pubName,
      pullUrl: publisher ? smbBusUrl(publisher, pubName) : null,
      local,
      hubEntry: null
    };
  });
  return {
    ok:true, tool,
    hubConnected, hubState: hubStatus.state, hubMode: hubStatus.mode || null,
    hubUrl: hubStatus.hubUrl || null,
    staleAfterMs: (sync && sync.staleAfterMs) || opts.staleAfterMs || smbSyncStaleAfterMs,
    source: hubConnected ? "hub" : "local",
    consumed, rows, fetchedAt: null
  };

// Fill each row's hubEntry from the hub's index (one queryAll per refresh).
async smbPipelineStatusRefresh(status, hub) =>
  if(!status || !status.ok) return status;
  if(!hub || typeof hub.queryAll !== "function" || !status.hubConnected) {
    return Object.assign({}, status, { hubFilled:false, fetchedAt:new Date().toISOString() });
  }
  let q;
  try { q = await hub.queryAll(); }
  catch(e) { q = { ok:false }; }
  let byKey = {};
  if(q && q.ok && Array.isArray(q.entries)) {
    q.entries.forEach(e => { if(e && e.tool && e.bundleType) byKey[e.tool + ":" + e.bundleType] = e; });
  }
  let rows = status.rows.map(r => {
    let he = (r.publisher && byKey[r.publisher + ":" + r.bundleType]) ? byKey[r.publisher + ":" + r.bundleType] : null;
    return Object.assign({}, r, { hubEntry: he });
  });
  return Object.assign({}, status, { rows, hubFilled: !!q.ok, hubQueryOk: !!q.ok, fetchedAt:new Date().toISOString() });

// Build the "pipeline status" DOM panel into ctn. opts:
//   { ctn, tool, manifest, hub, staleAfterMs, syncStatus, onRefresh(bundleType),
//     refreshAll(), autoRefreshMs, emptyNote }
// Returns { ok, refresh, refreshRow, status, destroy, el }.
smbPipelineStatusPanel(opts) =>
  opts = opts || {};
  let ctn = opts.ctn;
  if(!ctn || (typeof ctn.appendChild !== "function")) return { ok:false, code:"invalid_opts", error:"smbPipelineStatusPanel needs { ctn } — a DOM element" };
  let tool = opts.tool || (typeof window.generatorName === "string" ? window.generatorName.trim() : "") || "";
  let manifest = opts.manifest || null;
  let hub = opts.hub || null;
  let syncStatusFn = (typeof opts.syncStatus === "function") ? opts.syncStatus : null;
  let staleAfterMs = opts.staleAfterMs;
  let onRefresh = (typeof opts.onRefresh === "function") ? opts.onRefresh : null;
  let refreshAll = (typeof opts.refreshAll === "function") ? opts.refreshAll : null;
  let destroyed = false;
  let lastStatus = null;

  function esc(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function ageHuman(ms) {
    if(typeof ms !== "number" || !isFinite(ms) || ms < 0) return "—";
    try { return root.smbBusAgeHuman(ms); } catch(e) { return Math.round(ms/1000) + "s"; }
  }

  let rootEl = document.createElement("div");
  rootEl.className = "smb-pipeline-status";
  rootEl.style.cssText = "border:1px solid rgba(148,163,184,.2);border-radius:12px;padding:14px 16px;background:#0b0f1a;font-family:system-ui;font-size:.9rem;color:#e2e8f0;";
  rootEl.innerHTML =
    '<div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px;">' +
      '<div style="font-weight:700;">Pipeline status <span style="font-weight:400;color:#94a3b8;font-size:.8rem;">· <code style="background:none;border:none;padding:0;color:#94a3b8;">' + esc(tool) + '</code></span></div>' +
      '<div style="display:flex;gap:8px;align-items:center;">' +
        '<span class="smb-hub-badge" style="font-size:.72rem;padding:3px 10px;border-radius:999px;border:1px solid rgba(148,163,184,.25);color:#94a3b8;"></span>' +
        '<button class="smb-refresh-all" style="background:transparent;border:1px solid rgba(34,211,238,.4);color:#22d3ee;border-radius:999px;padding:5px 12px;font-size:.78rem;font-weight:600;cursor:pointer;font-family:inherit;">Refresh</button>' +
      '</div>' +
    '</div>' +
    '<div class="smb-status-note" style="font-size:.8rem;color:#94a3b8;margin-bottom:8px;"></div>' +
    '<table style="width:100%;border-collapse:collapse;font-size:.84rem;">' +
      '<tr><th style="text-align:left;padding:6px 8px;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid rgba(148,163,184,.15);">Consumes</th>' +
      '<th style="text-align:left;padding:6px 8px;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid rgba(148,163,184,.15);">Upstream</th>' +
      '<th style="text-align:left;padding:6px 8px;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid rgba(148,163,184,.15);">Upstream last published</th>' +
      '<th style="text-align:left;padding:6px 8px;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid rgba(148,163,184,.15);">Data age</th>' +
      '<th style="text-align:left;padding:6px 8px;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid rgba(148,163,184,.15);">Local sync</th>' +
      '<th style="text-align:right;padding:6px 8px;color:#64748b;font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;border-bottom:1px solid rgba(148,163,184,.15);"></th></tr>' +
    '</table>';
  let badgeEl = rootEl.querySelector(".smb-hub-badge");
  let noteEl = rootEl.querySelector(".smb-status-note");
  let refreshBtn = rootEl.querySelector(".smb-refresh-all");
  let tbody = document.createElement("tbody");
  rootEl.querySelector("table").appendChild(tbody);

  function render(st) {
    lastStatus = st;
    let hubText = st.hubConnected ? ("hub · live") : (st.hubState === "polling" ? "polling" : "offline");
    let hubColor = st.hubConnected ? "#34d399" : "#fbbf24";
    badgeEl.textContent = hubText;
    badgeEl.style.color = hubColor;
    badgeEl.style.borderColor = hubColor;
    if(!st.rows.length) {
      noteEl.innerHTML = '<span style="color:#94a3b8;">This tool consumes nothing (per the manifest) — nothing to watch. ' + esc(opts.emptyNote || "") + '</span>';
    } else {
      noteEl.innerHTML = st.hubConnected
        ? "Live from the hub index" + (st.hubUrl ? " (<code style='background:none;border:none;padding:0;color:#64748b;'>" + esc(st.hubUrl) + "</code>)" : "") + " — upstream publishes update within seconds."
        : '<span style="color:#fbbf24;">Hub offline — showing local sync timestamps</span>' + (st.hubState === "connecting" ? " (still connecting…)" : " · <b>Refresh</b> re-pulls each consumed bundle.");
    }
    tbody.innerHTML = "";
    st.rows.forEach(r => {
      let tr = document.createElement("tr");
      let dataAge = "—";
      let ageColor = "#64748b";
      if(r.local.dataAgeHuman) { dataAge = esc(r.local.dataAgeHuman); ageColor = "#94a3b8"; }
      let upstreamLine = r.publisher
        ? '<code style="background:none;border:none;padding:0;color:#cdd8ec;">' + esc(r.publisher) + '</code>' + (r.pubName && r.pubName !== r.bundleType ? ' <span style="color:#64748b;">→ ' + esc(r.pubName) + "</span>" : "")
        : '<span style="color:#64748b;">nobody yet</span>';
      let hubLine = "—";
      if(r.hubEntry) {
        let ago = ageHuman(Date.now() - r.hubEntry.at);
        hubLine = '<span style="color:#34d399;">' + ago + ' ago</span>' + '<span style="color:#64748b;font-size:.74rem;"> · edit ' + r.hubEntry.editCount + '</span>';
      } else if(st.hubConnected) {
        hubLine = '<span style="color:#64748b;">not reported</span>';
      }
      let localLine = r.local.lastSyncedHuman === "never"
        ? '<span style="color:#64748b;">never</span>'
        : '<span style="color:' + (r.local.stale ? "#fbbf24" : "#94a3b8") + ';">' + esc(r.local.lastSyncedHuman) + "</span>";
      let refreshBtnRow = document.createElement("button");
      refreshBtnRow.type = "button";
      refreshBtnRow.textContent = "Refresh";
      refreshBtnRow.style.cssText = "background:transparent;border:1px solid rgba(148,163,184,.25);color:#94a3b8;border-radius:999px;padding:3px 10px;font-size:.72rem;font-weight:600;cursor:pointer;font-family:inherit;";
      refreshBtnRow.onclick = () => refreshRow(r.bundleType);
      tr.innerHTML =
        '<td style="padding:7px 8px;border-bottom:1px solid rgba(148,163,184,.08);"><code style="background:none;border:none;padding:0;color:#cdd8ec;">' + esc(r.bundleType) + "</code></td>" +
        '<td style="padding:7px 8px;border-bottom:1px solid rgba(148,163,184,.08);">' + upstreamLine + "</td>" +
        '<td style="padding:7px 8px;border-bottom:1px solid rgba(148,163,184,.08);">' + hubLine + "</td>" +
        '<td style="padding:7px 8px;border-bottom:1px solid rgba(148,163,184,.08);color:"' + ageColor + ';">' + dataAge + "</td>" +
        '<td style="padding:7px 8px;border-bottom:1px solid rgba(148,163,184,.08);">' + localLine + "</td>" +
        '<td style="padding:7px 8px;border-bottom:1px solid rgba(148,163,184,.08);text-align:right;"></td>';
      tr.querySelector("td:last-child").appendChild(refreshBtnRow);
      tbody.appendChild(tr);
    });
  }

  async function refresh() {
    if(destroyed) return { ok:false, code:"destroyed", error:"panel destroyed" };
    let st = smbPipelineStatus({ tool, manifest, hub, syncStatus: syncStatusFn || undefined, staleAfterMs });
    st = await smbPipelineStatusRefresh(st, hub);
    render(st);
    return { ok:true, status: st };
  }
  async function refreshRow(bundleType) {
    if(destroyed) return { ok:false, code:"destroyed" };
    let pullRes = null;
    if(onRefresh) {
      refreshBtn.disabled = true;
      try { pullRes = await onRefresh(bundleType); } catch(e) { pullRes = { ok:false, code:"error", error:String((e && e.message) || e) }; }
      refreshBtn.disabled = false;
    }
    let st = await refresh();
    return { ok:true, bundleType, pullRes, status: st };
  }
  async function refreshAllRows() {
    if(destroyed) return { ok:false, code:"destroyed" };
    refreshBtn.disabled = true;
    try {
      if(refreshAll) {
        try { await refreshAll(); } catch(e) {}
      } else if(onRefresh) {
        let st = lastStatus;
        if(st) for(let i = 0; i < st.rows.length; i++) { try { await onRefresh(st.rows[i].bundleType); } catch(e) {} }
      }
    } finally { refreshBtn.disabled = false; }
    return await refresh();
  }
  function destroy() {
    destroyed = true;
    if(rootEl && rootEl.parentNode) { try { rootEl.parentNode.removeChild(rootEl); } catch(e) {} }
  }

  refreshBtn.onclick = () => { refreshAllRows(); };
  ctn.appendChild(rootEl);
  refresh();
  if(typeof opts.autoRefreshMs === "number" && opts.autoRefreshMs > 0) {
    setInterval(() => { if(!destroyed) refresh(); }, opts.autoRefreshMs);
  }
  return { ok:true, el:rootEl, refresh, refreshRow, refreshAll: refreshAllRows, status: () => lastStatus, destroy };

// ── Dashboard self-tests — pure status computation + refresh, over a
// fake hub client and fake sync status. The DOM panel is exercised live on the
// page instead (document isn't guaranteed in the fixture runner).
async smbDashboardSelfTest() =>
  let out = [];
  let t = (name, cond, detail) => out.push({ name, pass: !!cond, detail });

  let m = root.smbDefaultManifest();
  let bad = smbPipelineStatus({});
  t("status without a tool → invalid_opts", bad.ok === false && bad.code === "invalid_opts");

  let syncFake = { ok:true, staleAfterMs:3600000, bundles: {
    "milestone-event": { bundleName:"milestone-event", lastSyncedHuman:"synced 2 minutes ago", lastSyncedKind:"pulled", lastSeenTool:"project-master", lastSeenExport:new Date(Date.now()-2*60*1000).toISOString(), dataAgeMs:2*60*1000, dataAgeHuman:"2 minutes old", stale:false }
  } };
  let st = smbPipelineStatus({ tool:"the-ledger", manifest:m, syncStatus: () => syncFake, now: Date.now() });
  t("status lists the tool's consumed bundle", st.ok && st.consumed.includes("milestone-event"));
  t("status resolves the upstream publisher from the manifest", st.rows[0].publisher === "project-master");
  t("status reports the canonical pull URL for the upstream", st.rows[0].pullUrl === "https://editable.uploads.dev/file/project-master/milestone-event");
  t("status without a hub → source 'local'", st.source === "local" && st.hubConnected === false);
  t("status keeps local sync data per row", st.rows[0].local.lastSyncedHuman === "synced 2 minutes ago");

  let fakeHub = {
    kind:"fake",
    status: () => ({ state:"connected", mode:"fake" }),
    available: () => true,
    async queryAll() {
      return { ok:true, count:1, entries:[{ tool:"project-master", bundleType:"milestone-event", name:"milestone-event", editCount:3, at: Date.now()-5*60*1000 }] };
    }
  };
  let stH = smbPipelineStatus({ tool:"the-ledger", manifest:m, hub:fakeHub, syncStatus: () => syncFake, now: Date.now() });
  t("status with a reachable hub → source 'hub'", stH.source === "hub" && stH.hubConnected === true);
  let stF = await smbPipelineStatusRefresh(stH, fakeHub);
  t("refresh fills hub entries from the index", stF.hubFilled === true && stF.rows[0].hubEntry && stF.rows[0].hubEntry.editCount === 3);
  t("refresh stamps fetchedAt", !!stF.fetchedAt);

  let offHub = { status: () => ({ state:"offline" }), available: () => false, async queryAll(){ return { ok:false }; } };
  let stO = smbPipelineStatus({ tool:"the-ledger", manifest:m, hub:offHub, syncStatus: () => syncFake, now: Date.now() });
  let stOF = await smbPipelineStatusRefresh(stO, offHub);
  t("refresh with an offline hub keeps local fallback (no throw)", stOF.ok && stOF.hubFilled === false && stOF.source === "local");

  let st2 = smbPipelineStatus({ tool:"smb-integration", manifest:m, syncStatus: () => ({ ok:true, bundles:{} }), now: Date.now() });
  t("status for a tool with no consumes → empty rows, still ok", st2.ok && st2.consumed.length === 0 && st2.rows.length === 0);

  let pBad = smbPipelineStatusPanel({ ctn: {} });
  t("panel with a non-real container → invalid_opts", pBad.ok === false);
  void pBad;

  let passes = out.filter(x => x.pass).length;
  return { ok: passes === out.length, passCount: passes, failCount: out.length - passes, results: out };


// The plugin-definition idiom (Rathji's tutorial, step 6 "Make your own
// plugin"). It accepts, all through ONE function:
//   smbIntegration("hi")                       plain value
//   smbIntegration("hi", {color:"#f00"})       value + options object
//   smbIntegration({text:"hi", color:"#f00"})  options object alone
//   smbIntegration(smbIntegrationOpts)                      options read from a list node
//   smbIntegration(smbIntegrationPresets)                   a LIST of options → picks a random one
//
// Options are distinguished from plain values the way the text-to-image-plugin
// does it: an options node has a known key (here: `text`), a plain value does
// not. Every value — string, number, item — is read through .evaluateItem so
// Perchance lists work anywhere a plain value would.
//
// Never throw — return a readable "(...)" placeholder on bad input.


// ── 4. ENTRY POINT ($output) ────────────────────────────────────────────────

$output(input, opts) =>
  // A LIST of preset options (smbIntegrationPresets) has items but no `.text` key —
  // pick a random item first. A single options node (smbIntegrationOpts), an options
  // object, or a plain value all keep their own `.text` (or none at all).
  // A plain list of strings (items without `.text`) passes through untouched,
  // so `smbIntegration(aPlainList)` evaluates to a random item — free list support.
  if(input != null && input.text === undefined && input.selectOne != null) {
    let item = null;
    try { item = input.selectOne; } catch(e) {}
    if(item != null && item !== input && item.text !== undefined) input = item;
  }

  let o = {};
  if(opts != null) {
    o.text = smbIntegrationResolve(input);
    o.emoji = smbIntegrationResolve(opts.emoji);
    o.color = smbIntegrationResolve(opts.color);
  } else if(input != null && input.text !== undefined) {
    o.text = smbIntegrationResolve(input.text);
    o.emoji = smbIntegrationResolve(input.emoji);
    o.color = smbIntegrationResolve(input.color);
  } else {
    o.text = smbIntegrationResolve(input);
  }

  if(typeof o.text !== "string" || !o.text.trim()) {
    return "(smbIntegration: expected some text — got " + JSON.stringify(smbIntegrationResolve(input)) + ")";
  }

  return smbIntegrationStamp(o.text.trim(), o);
