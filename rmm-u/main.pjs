  // ── Editor / admin behavior ───────────────────────────────────────────────
  admin
    showSettingsButton = true         // shows the ⚙ panel used to configure, scan & export

  // ── ERP application settings ──────────────────────────────────────────────
  // Read by src/erp.js at boot. Role-aware module visibility (Task 1) uses
  // roleDefault until the server-authorised role model lands in Phase 10.
  erp
    version = 0.1.0
    roleDefault = owner               // owner | manager | staff

  // ── RMM application settings ──────────────────────────────────────────────
  // Read by src/erp.store.js & src/rmm.tenancy.js at boot. `namespace` is the
  // editable-file prefix every RMM document is stored under (rmm-v1-*), so it
  // must stay stable once the platform has data. `seedDemo` writes a demo
  // tenant on first run so a new console is never empty.
  rmm
    namespace = rmm
    seedDemo = true
    seedDemoDevices = true
    seedMasterConfig = true
    staleAfterMinutes = 15
    providerPrefix = prov
    defaultTimezone = UTC
    defaultCurrency = USD
    demoProviderName = Demo Managed Services
    versionHistoryPerDoc = 25
    versionHistoryBytes = 3145728
    versionSnapshotBytes = 1572864
    // ── Agent (Phase 2) ──────────────────────────────────────────────────────
    agentVersion = 1.0.0                // version the generated installer/agent reports
    heartbeatSeconds = 300              // agent check-in interval, in seconds
    enrollmentTokenTtlMinutes = 1440    // lifetime of a one-time enrollment token (0 = never expires)
    collectorUrl =                      // collector address embedded in installers (empty = derive from this page's origin)
    // ── Inventory, metrics & jobs (Phase 2 · Tasks 9–11) ─────────────────────
    inventoryDeltaLimit = 25            // per-device inventory delta log retained
    inventorySoftwareCap = 500          // max installed-software titles accepted per collection
    metricsSampleSeconds = 60           // agent performance-sampling interval, in seconds
    metricsRawPoints = 240              // raw metric samples retained per device
    metricsHourlyPoints = 168           // hourly metric roll-ups retained per device (7 days)
    metricsDailyPoints = 30             // daily metric roll-ups retained per device
    metricsMaxSamplesPerPost = 60       // max metric samples accepted in one authenticated post
    jobTimeoutSeconds = 300             // default per-job execution timeout
    jobOutputBytes = 65536              // stdout/stderr captured per job per device
    jobRetentionHours = 168             // finished jobs retained (7 days)
    jobDeliveryTimeoutMinutes = 30      // delivered-but-never-started jobs re-queued after this
    jobExpiryMinutes = 1440             // queued-but-never-delivered jobs expire after this
    jobMaxAttempts = 2                  // delivery attempts before a run is marked timed-out
    jobScriptMaxBytes = 262144          // max script size accepted per job
    // ── Resilience, safety & self-update (Phase 3 · Task 12) ─────────────────
    backoffBaseSeconds = 5              // first reconnect delay after a failed check-in, in seconds
    backoffMaxSeconds = 900             // cap on the exponential reconnect backoff, in seconds
    backoffFactor = 2                   // backoff multiplier per consecutive failure
    backoffJitter = 0.25                // random jitter applied to each delay (0 = none, 1 = ±100%)
    retryMaxAttempts = 8                // consecutive failures before an agent reports itself degraded
    spoolMaxBytes = 26214400            // offline replay buffer cap per endpoint, in bytes (25 MiB)
    spoolMaxItems = 5000                // offline replay buffer cap per endpoint, in items
    spoolFlushPerCycle = 50             // buffered posts replayed per successful heartbeat
    agentMaxCpuPercent = 25             // soft CPU ceiling for agent-spawned jobs, in percent
    agentCpuNice = 10                   // niceness applied to agent-spawned job processes (0–19)
    agentIoNice = 6                     // I/O priority class for agent-spawned job processes (0–7)
    agentMaxMemMB = 256                 // hard memory ceiling per job process, in MB
    agentMaxConcurrentJobs = 1          // job processes the agent runs at once
    agentLogMaxBytes = 2097152          // agent log rotation threshold per log file, in bytes
    agentLogKeep = 3                    // rotated agent log files retained
    tlsMode = system                    // system (trust store) | pinned (certificate pin) | insecure
    tlsPinSha256 =                      // collector certificate SPKI SHA-256 pin when tlsMode = pinned
    tlsAllowInsecure = false            // true permits a plain-HTTP collector address (lab use only)
    selfUpdateEnabled = true            // allow releases to replace the agent in place
    selfUpdateChannel = stable          // release channel an agent follows (stable | beta)
    selfUpdateKeepVersions = 2          // agent builds retained for rollback
    selfUpdateRollbackOnFailure = true  // restore the previous build if a new one fails its self-test
    updateDeliveryRetryMinutes = 15     // re-deliver an update request that was never acknowledged
    updateHistoryLimit = 20             // update events retained per device
    // ── Diagnostics & support (Phase 3 · Task 13) ────────────────────────────
    diagnosticRequestLines = 400        // log lines an agent returns for a log-collection request
    diagnosticLogMaxBytes = 262144      // uploaded log excerpt cap, in bytes
    diagnosticLogKeep = 10              // log uploads retained per device
    diagnosticSelfTestKeep = 20         // self-test reports retained per device
    // ── Dispatch, event stream & retention (Phase 3 · Tasks 15–17) ──────────
    jobHistoryKeep = 50                 // job-result entries retained per device on the collector
    eventHistory = 200                  // device/alert/job events retained in the console stream
    eventPollSeconds = 15               // collector poll interval used when the realtime stream is unavailable
    alertRetentionDays = 30             // alert history retained (Phase 5; the prune hook is live now)
    // ── Groups, tags, policies & monitors (Phase 4 · Tasks 18–20) ───────────
    seedDemoGroups = true               // seed rule-based demo groups alongside the demo tenant
    groupConditionCap = 24              // max conditions in one dynamic-group rule
    policyEnabled = true                // master switch for policy resolution (Task 19)
    monitorEnabled = true               // master switch for monitor evaluation (Task 20)
    monitorForMinutes = 5               // default "for N minutes" before a monitor fires
    monitorIntervalSeconds = 60         // default monitor polling interval, in seconds
    // ── Schedules, maintenance, automation & scripts (Phase 4 · Tasks 21–23) ─
    maintenanceDefersJobs = true        // maintenance windows defer non-essential jobs by default
    suppressionsCap = 500               // suppression-log + deferral records retained
    scheduleDueWindowMinutes = 5        // how late a schedule trigger may fire (AUTO.scheduleDue)
    notificationHistory = 500           // notification records retained
    automationEnabled = true            // master switch for the automation engine
    automationRunHistory = 20           // runs retained per automation rule
    automationConditionCap = 24         // max conditions in one automation rule
    scriptLibraryEnabled = true         // master switch for the script & component library
    scriptVersionHistory = 10           // version snapshots retained per library entry
    scriptMaxComponentDepth = 4         // max nested {{component:…}} depth
    scriptComponentMaxBytes = 262144    // max expanded component/script size, in bytes
    // ── Alerting & response (Phase 5 · Tasks 24–26) ─────────────────────────
    alertEnabled = true                 // master switch for the alert lifecycle
    alertFlapMinutes = 10               // a re-fire inside this window reopens the alert (flapping)
    alertFlapThreshold = 3              // reopens on one alert before it is flagged as flapping
    alertHistory = 500                  // alert records retained per provider
    notifyEnabled = true                // master switch for notification routing (Task 25)
    routingEnabled = true               // master switch for severity/site routing
    notifyDedupeMinutes = 15            // identical alert+channel+recipient notifications collapsed
    notifyDigestMinutes = 60            // digest flush period, in minutes
    notifyDigestMax = 200               // items retained per queued digest
    escalationEnabled = true            // master switch for escalation paths
    psaEnabled = true                   // master switch for the psa-u ticket bridge (Task 26)
    psaUrl =                            // psa-u base URL (empty = simulate locally)
    psaQueue =                          // default psa-u queue
    psaAutoTicket = true                // open/update a ticket automatically for critical alerts
    psaTicketPrefix = PSA               // simulated psa-u ticket reference prefix
    // ── Alert triage (Phase 5 · Task 27) ────────────────────────────────────
    triageWindowDays = 30               // response-metric window (volume/MTTA/MTTR), in days
    triageAckTargetMinutes = 15         // target time-to-acknowledge used for the SLA share
    // ── Patch management (Phase 6 · Tasks 28–29) ────────────────────────────
    patchEnabled = true                 // master switch for patch policy + scanning
    patchPolicyEnabled = true           // allow custom patch policies on top of the default
    patchScanEnabled = true             // master switch for running compliance scans
    patchScanHistory = 200              // scan-run records retained per provider
    patchScanStateCap = 500             // scan records retained in the hidden patchscan doc
    patchDefaultDeadlineDays = 0        // fallback deadline when a classification states none
    patchAlertEnabled = false           // raise/clear an alert when a device's compliance changes
    patchStaleHours = 24                // a device's last scan older than this counts as not-recently-scanned
    patchMissingGraceDays = 14          // how long a device may be non-compliant before it is flagged
    // ── Patch deployment & audit (Phase 6 · Task 30) ────────────────────────
    patchDeployEnabled = true           // master switch for agent-driven deployment of approved patches
    patchRebootEnabled = true           // master switch for dispatching reboots
    patchRetryMax = 2                   // automatic retries for a device whose patches partially failed
    patchRetryBackoffMinutes = 30       // minimum wait between a failure and its automatic retry
    patchDeployHistory = 100            // deployment records retained per provider
    patchDeployMaxPerJob = 25           // patches bundled into a single agent job
    patchDeployTimeoutSeconds = 3600    // agent job timeout for a deployment
    // ── Software catalog & deployment (Phase 7 · Tasks 31–33) ───────────────
    softwareEnabled = true              // master switch for the software catalog
    softwareDeployEnabled = true        // master switch for agent-driven software deployment
    softwareDetectEnabled = true        // read install state from the device software inventory
    softwareLicenseEnabled = true       // master switch for licence reconciliation
    softwareRetryMax = 2                // automatic retries for a device whose package actions failed
    softwareRetryBackoffMinutes = 30    // minimum wait between a failure and its automatic retry
    softwareDeployHistory = 100         // deployment records retained per provider
    softwareDeployMaxPerJob = 25        // package actions bundled into a single agent job
    softwareDeployTimeoutSeconds = 3600 // agent job timeout for a software deployment
    // ── Security, compliance & backup (Phase 8 · Tasks 34–36) ───────────────
    securityEnabled = true              // master switch for security posture monitoring
    securityScanEnabled = true          // master switch for running posture scans
    securityAlertEnabled = false        // raise/clear an alert when a device's posture changes
    securityScanHistory = 200           // scan records retained per provider
    securityDriftHistory = 500          // drift-run records retained per provider
    securityTrackAdmins = true          // detect local-administrator set changes between scans
    backupMonitorEnabled = true         // master switch for backup verification monitoring
    backupAlertEnabled = true           // raise/clear an alert when a backup is missed or fails
    backupDefaultMaxAgeHours = 26        // fallback hours between an expected successful backup
    backupDefaultGraceHours = 4          // fallback grace window before a backup counts as missed
    backupJobHistory = 500               // backup job records retained per provider
    backupRecoveryTestEnabled = true     // prompt periodic recovery-test confirmation
    // ── Remote access & field actions (Phase 9 · Tasks 37–39) ───────────────
    remoteEnabled = true                // master switch for the remote console
    remoteAllowStaff = false            // allow the staff role (not just owner/manager) to run remote actions
    remoteConfirmCommands = true        // require confirmation for deny-list "confirm"-level commands
    remoteCommandTimeoutSeconds = 120   // agent job timeout for a single remote command
    remoteCommandHistory = 500          // command transcript entries retained per shell session
    remoteSessionHistory = 500          // shell + tool-session records retained per provider
    remoteTransferHistory = 500         // file-transfer records retained per provider
    remoteMaxFileBytes = 1048576        // largest file the console will push/pull (bytes)
    remoteChunkChars = 65536            // characters per transfer chunk
    remoteQuarantineUploads = true      // quarantine uploads for review before release
    remoteCommandMaxChars = 20000       // largest single command the console will accept
    remoteDenyExtra =                   // extra confirm-level deny patterns (comma-separated regex/substring)
    // ── Dashboards, reporting & integrations (Phase 10 · Tasks 40–42) ───────
    dashboardEnabled = true             // master switch for the fleet dashboard
    agentLatestVersion =                // override the "latest agent" version shown on the dashboard (empty = auto)
    reportsEnabled = true               // master switch for the client report library
    reportDeliveryHistory = 200         // report-delivery records retained per provider
    integrationsEnabled = true          // master switch for field ownership, the event bus & outbound webhooks
    integrationPublicationHistory = 500 // published event envelopes retained per provider
    // ── Data-quality linter (Phase 10 · Task 43) ───────────────────────────
    dataQualityEnabled = true           // master switch for the data-quality linter
    dqOfflineDays = 7                   // an offline agent older than this many days is a critical finding
    dqManualAlertDays = 30              // a manual (monitor-less) alert left active longer than this is flagged
    dqDuplicateFields = hostname,serial // device fields checked for duplicate records (hostname,serial,mac,domain,displayName)
    // ── Realtime console & multi-user control (Phase 12 · Tasks 49–50) ──────
    liveEnabled = true                  // master switch for the realtime console stream
    livePresenceEnabled = true          // announce which device each console session is viewing
    liveAutoRefreshSeconds = 3          // throttle for live auto-refreshes of the active view (seconds)
    livePanelHistory = 50               // events shown in the realtime-console panel
    rateLimitPerNetConnections = 10     // max concurrent console sessions allowed from one network group
    rateLimitActionsPerMinute = 240     // guarded console actions allowed per connection per minute
    rateLimitClaimsPerMinute = 60       // document claims allowed per connection per minute
    auditRemoteActions = true           // log every remote action to the true actor's server audit trail
    docClaimsEnabled = true             // hub-mediated edit claims stop one user silently overwriting another
    docClaimTtlSeconds = 900            // an idle edit claim is released after this many seconds
