// ─────────────────────────────────────────────────────────────
//  BGN STANDARDS CHECKER — main.pjs
//  Page config only. The entire audit engine (checklists, the
//  perchance API fetches, scoring, rendering) lives in index.html.
// ─────────────────────────────────────────────────────────────

$meta
  title = BGN Standards Checker
  description = Audits Boardgame Network generators against the BGN house standards — list structure, $meta, design-system CSS, HTML layout, the online-play feature set, and the fullscreen-board standard. Enter any generator name (or paste a link), scan the whole shelf in one go, or embed it in your own generator for a one-click self-check.
  tags = boardgame network, bgn, standards, audit, qa, quality, checker, css, html
  image = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

hubUrl = https://perchance.org/bgn-boardgame-network
gameTitle = BGN Standards Checker
gameTagline = Every Boardgame Network generator gets checked against the house standards — CSS, HTML, list structure, layout and features.
gameKicker = Audit · Report · Improve
gameGenre = Tool
gamePlayers = 1 user
accentColor = #d4af37
heroImage = https://user.uploads.dev/file/153ea2e2e252ff04df5dbf01ecf787b0.jpg

superFetch = {import:super-fetch-plugin}
