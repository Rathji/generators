  Fields

disease
  Cholera
    fatal = 0.4
    days = 3
    drain = 14
    msg = has come down with a violent case of cholera
  Dysentery
    fatal = 0.3
    days = 4
    drain = 10
    msg = is feverish with dysentery
  Typhoid
    fatal = 0.35
    days = 4
    drain = 11
    msg = is burning up with typhoid fever
  Measles
    fatal = 0.12
    days = 3
    drain = 8
    msg = has broken out in the measles
  Fever
    fatal = 0.2
    days = 3
    drain = 9
    msg = is laid low by a fever
  Flu
    fatal = 0.08
    days = 2
    drain = 7
    msg = has caught a bad flu
  Snakebite
    fatal = 0.28
    days = 1
    drain = 20
    msg = was bitten by a rattlesnake
  BrokenLeg
    fatal = 0.1
    days = 6
    drain = 5
    msg = fell from the wagon and broke a leg
  Pneumonia
    fatal = 0.3
    days = 4
    drain = 10
    msg = has come down with pneumonia

huntAnimal
  squirrel
    emoji = 🐿️
    weight = 2
    speed = 3
    size = 1
    odds = 60
  rabbit
    emoji = 🐇
    weight = 5
    speed = 5
    size = 1
    odds = 50
  fox
    emoji = 🦊
    weight = 15
    speed = 5
    size = 1.4
    odds = 12
  deer
    emoji = 🦌
    weight = 180
    speed = 4
    size = 1.8
    odds = 8
  elk
    emoji = 🦌
    weight = 320
    speed = 3
    size = 2.2
    odds = 4
  bison
    emoji = 🦬
    weight = 500
    speed = 1.5
    size = 2.6
    odds = 3
  bear
    emoji = 🐻
    weight = 350
    speed = 2
    size = 2.4
    odds = 2
  moose
    emoji = 🦌
    weight = 400
    speed = 2.5
    size = 2.4
    odds = 2

landmark
  KansasRiver
    name = Kansas River Crossing
    mile = 102
    kind = river
    text = You reach the Kansas River. It is wide and brown, with sandbars scattered across the crossing.
  BigBlueRiver
    name = Big Blue River Crossing
    mile = 200
    kind = river
    text = You come to the Big Blue River. No ferry here. You will have to ford it or caulk the wagon and float across.
  FortKearney
    name = Fort Kearney
    mile = 305
    kind = fort
    text = Fort Kearney rises out of the plains. A good place to rest and buy supplies.
  ChimneyRock
    name = Chimney Rock
    mile = 575
    kind = site
    text = You spot Chimney Rock looming on the horizon, a great stone spire worn by a hundred years of wind. Every emigrant stops to gape at it.
  FortLaramie
    name = Fort Laramie
    mile = 635
    kind = fort
    text = Fort Laramie bustles with traders and wagon companies. Supplies can be bought here.
  IndependenceRock
    name = Independence Rock
    mile = 780
    kind = site
    text = Independence Rock rises beside the trail, covered in the carved names of thousands of pioneers who passed this way before you.
  SouthPass
    name = South Pass
    mile = 830
    kind = site
    text = You climb into the Rocky Mountains. South Pass is a gentle gap, but the air grows thin and the nights turn cold.
  GreenRiver
    name = Green River Crossing
    mile = 880
    kind = river
    text = The Green River runs deep and fast through a red rock canyon. A ferry waits on the far bank.
  FortBridger
    name = Fort Bridger
    mile = 1000
    kind = fort
    text = Fort Bridger, a mountain trading post. Warm fires, flour, and news from home.
  FortHall
    name = Fort Hall
    mile = 1160
    kind = fort
    text = Fort Hall stands where the trail splits. Emigrants restock here before the hard country ahead.
  SnakeRiver
    name = Snake River Crossing
    mile = 1280
    kind = river
    text = The Snake River thunders past, wide and brutal. A ferry charges a steep fare, and the ford is notorious.
  FortBoise
    name = Fort Boise
    mile = 1350
    kind = fort
    text = Fort Boise, a rough trading post on the banks of the Boise River.
  BlueMountains
    name = The Blue Mountains
    mile = 1450
    kind = site
    text = The Blue Mountains loom ahead, a steep and tree-choked climb. In late season, snow can trap a wagon for weeks.
  FortWallaWalla
    name = Fort Walla Walla
    mile = 1540
    kind = fort
    text = Fort Walla Walla. The worst of the mountains lie behind you now, and the country is green again.
  TheDalles
    name = The Dalles
    mile = 1800
    kind = site
    text = The Dalles! The Columbia River roars below, and Oregon City lies just beyond the Cascades.
  OregonCity
    name = Oregon City
    mile = 2040
    kind = destination
    text = The gates of Oregon City at last!
