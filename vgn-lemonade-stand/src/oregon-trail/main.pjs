/* ════════════════════════════════════════════════════════════
   REFERENCE COPY — the original OREGON TRAIL game (pre-template).
   This is the full game as it existed before the generator was
   converted into the VGN Text-Game Template. It is NOT loaded by
   the generator; it is kept here as reference source so the game
   can be restored or studied. To restore: copy its main.pjs and
   index.html back into the generator root.
   ════════════════════════════════════════════════════════════ */

// OREGON TRAIL — a recreation of the classic 1848 wagon-train journey.
// Data & config live here. The game logic lives in index.html.
// Tweak numbers below to rebalance the game.

$meta
  title = VGN TVe
  description = The classic Oregon Trail wagon-train game: outfit your wagon, gather your party, hunt for food, ford rivers, survive disease and storms, and make it to Oregon City before winter.
  image = https://user.uploads.dev/file/b6ccac2977b8cbb39dadf1a31db97d1a.jpg
  tags = game, oregon trail, western, history, survival, classic
  header
    mode = minimal

kv = {import:kv-plugin}

profession
  Banker
    money = 3200
    desc = A banker with deep pockets and soft hands. Best chance of outfitting a fine wagon.
  Carpenter
    money = 1600
    desc = A carpenter. Skilled hands, but the money is tight.
  Farmer
    money = 800
    desc = A farmer. Tough as nails and poor as a church mouse. You will hunt to survive.

givenName
  James
  William
  John
  Robert
  Thomas
  Henry
  George
  Charles
