// ════════════════════════════════════════════════════════════════
//  LEMONADE STAND — a faithful reproduction of the 1979 MECC
//  Apple II classic, running inside the VGN CRT cabinet on a
//  green monochrome monitor.
//
//  Rules (matching the Apple IIe original):
//    • You start with $2.00 and run the stand for N days.
//    • Each day the weather is reported, then you decide:
//        1. How many glasses of lemonade to make   (2¢ each)
//        2. How many advertising signs to make     (10¢ each)
//        3. What to charge per glass (in cents)
//    • You cannot spend more than your cash on hand.
//    • Demand depends on weather, price and signs. You can't
//      sell more glasses than you made.
//    • Random events after day 2 (street crews buy you out / a
//      cloudburst ruins your batch), plus a chance of a
//      thunderstorm sellout on CLOUDY days.
//    • If your cash drops to $2.00 or below you're BANKRUPT.
//    • After the last day the stand closes — net profit wins.
//
//  Everything below is CONFIG: tweak numbers to rebalance the
//  game. All money values are in CENTS.
// ════════════════════════════════════════════════════════════════

$meta
  title = Lemonade Stand
  description = The 1979 MECC Apple II classic, faithfully reproduced on a green monochrome CRT. Run a lemonade stand for a week — read the weather, price your lemonade, buy advertising signs, and turn $2.00 into a fortune before the stand closes.
  image = https://user.uploads.dev/file/ebfe64214b8b6c0a69cb973ef0902cbc.jpg
  tags = lemonade stand, apple ii, mecc, simulation, business, retro, crt, arcade, monochrome
  header
    mode = minimal

kv = {import:kv-plugin}

// ──────────────────────────────────────────────────────────────
//  GAME CONFIG — costs & difficulty (all amounts in cents)
// ──────────────────────────────────────────────────────────────

lemonade
  startCash = 200       // you start with $2.00
  minDays = 1
  maxDays = 10
  defaultDays = 7       // length of a standard game
  maxPlayers = 4        // alternating turns, most cash wins
  glassCost = 2         // cost to make one glass
  signCost = 10         // cost of one advertising sign
  fairPrice = 15        // the "fair" price — demand is highest here
  adK = 0.04            // how strongly signs boost demand (0.04)
  eventChance = 0.12    // chance of a random event after day 2
  stormChance = 0.25    // thunderstorm chance on CLOUDY days

  // ── the weather table ──
  // s2   = base demand in fair-price glasses for that weather
  // j    = temperature factor 0 (hot) … 70 (cold); demand shrinks
  //        to (1 - j/100) of base as it gets cold
  // weight = probability weight
  weathers
    hotSunny
      name = HOT AND SUNNY
      s2 = 45
      j = 0
      weight = 16
    hotDry
      name = HOT AND DRY
      s2 = 38
      j = 5
      weight = 13
    hotCloudy
      name = HOT AND CLOUDY
      s2 = 32
      j = 10
      weight = 8
    mildSunny
      name = MILD AND SUNNY
      s2 = 28
      j = 30
      weight = 18
    mildCloudy
      name = MILD AND CLOUDY
      s2 = 22
      j = 40
      weight = 13
    cloudy
      name = CLOUDY
      s2 = 16
      j = 50
      weight = 12
      stormy = 1
    lightRain
      name = LIGHT RAIN
      s2 = 10
      j = 60
      weight = 8
    cold
      name = COLD
      s2 = 6
      j = 70
      weight = 7
