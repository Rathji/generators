// NUCLEUS VAULT // VERTICAL LISTS
// Indentation: 2 Spaces

// 1. EXCLUSIONS
exclusions
  universal
    ugly
    blurry
    low quality
    watermark
    text
    jpeg artifacts
  minecraft
    round
    curves
    organic
    photorealistic
    spheres
    mesh
  fantasy
    modern
    sci-fi
    cars
    guns
    suit
  photo
    painting
    drawing
    sketch
    cartoon
    3d render

// 2. PRESETS
// Format: Title -> List of keywords
presets
  minecraft
    Vanilla
      minecraft screenshot
      blocky
      low poly model
      hard edges
    RTX On
      minecraft with BSL shaders
      raytracing
      volumetric lighting
      realistic water
    Isometric
      isometric minecraft voxel art
      3d render
      white background
      orthographic
    Retro Alpha
      minecraft alpha version
      bright green grass
      old textures
      fog
    Dungeons
      minecraft dungeons style
      top down view
      cinematic lighting
    Title Screen
      minecraft title screen panorama
      blur background
      vignette

  fantasy
    Oil Painting
      oil painting
      textured
      brushstrokes
      masterpiece
    Digital Art
      digital art
      artstation
      concept art
      sharp focus
    Ink Sketch
      ink drawing
      parchment
      cross-hatching
      rough sketch
    80s Fantasy
      retro fantasy art
      frank frazetta style
      vibrant
      grainy

  realism
    Cinematic
      cinematic lighting
      8k
      movie still
      depth of field
    Polaroid
      polaroid photo
      vintage camera
      flash photography
      hard shadows

// 3. WANDS
wands
  minecraft = Rewrite the following prompt to be a detailed description of a Minecraft build or mob. Mention blocks and biomes.
  fantasy = Rewrite the following prompt to be a descriptive visual request for a fantasy oil painting.
  general = Enhance the following prompt with descriptive visual adjectives.
// 4. APP MANIFESTS (Saved Projects)
// Stores the full configuration for Foundry apps
apps
  minecraft_v1 = {"identity":{"name":"Minecraft","vaultKey":"minecraft","fontMode":"retro"},"theme":{"colors":{"bgPage":"#2d1b00","bgCard":"#1e606e","bgInput":"#103840","border":"#000000","textMain":"#c4f0c2","accent":"#d9a066"},"geometry":{"radius":"0","width":"3"}},"logic":{"negative":"round, curves","wand":"Convert to Minecraft"}}
  
  fantasy_v1 = {"identity":{"name":"Fantasy","vaultKey":"fantasy","fontMode":"fantasy"},"theme":{"colors":{"bgPage":"#1a1a1a","bgCard":"#2a2a2a","bgInput":"#333333","border":"#444444","textMain":"#ffffff","accent":"#ff0055"},"geometry":{"radius":"8","width":"1"}},"logic":{"negative":"sci-fi","wand":"Enhance fantasy"}}

$output = [null]
