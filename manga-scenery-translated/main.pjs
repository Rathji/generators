$meta
  title = Manga Scenery (B&W)
  description = Traditional black-and-white manga background generator with AI. Pick scene, time of day, weather, angle and line style — scenery only, no characters. Available in English, Portuguese, Japanese, French and Spanish.
  image = https://user.uploads.dev/file/a388089a49e6b935276b8a5f25a4c956.jpg
  tags = manga, scenery, background, black and white, screentone, ai, image, generator, english, portuguese, japanese, french, spanish

generateImage = {import:text-to-image-plugin}

// Style appended to EVERY prompt — keeps it a black & white manga scene with no characters.
mangaBase() =>
  return "traditional hand-drawn black and white manga background illustration, pure monochrome greyscale ink drawing on paper, screentone dot shading with bold solid black areas, crisp pen and ink linework, high contrast, dramatic composition, highly detailed environment, completely empty scenery with no people, no text, no lettering, masterpiece, best quality";

mangaNegative() =>
  return "color, colorful, colour, coloured, sepia, color tint, warm tones, cool tones, tinted, people, person, humans, man, woman, child, boy, girl, crowd, character, characters, figure, figures, face, portrait, body, hands, skin, text, letters, words, kanji, kana, japanese text, english text, signage lettering, numbers, caption, speech bubble, watermark, signature, logo, artist name, frame, border, blurry, out of focus, low quality, lowres, jpeg artifacts, cgi, 3d render, 3d, photograph, photo, photorealistic, realistic, western comic coloring, flat vector art";

// Prompt fragments (`v`) are always English (image models render best from English).
// `id` is a stable key used to look up the display label in the matching language.
mangaOptions() =>
  return {
    scenes: [
      { v: "narrow Tokyo backstreet at night, neon signs, vending machines, tangled overhead power lines, wet asphalt", id: "tokyo-street" },
      { v: "city skyline seen from a rooftop, dense skyscrapers, water towers, scattered clouds", id: "city-skyline" },
      { v: "empty Japanese high school classroom, rows of desks and chairs, blackboard, large windows", id: "classroom" },
      { v: "long school hallway with lockers and doors, strong one-point perspective", id: "hallway" },
      { v: "school courtyard with old trees, bicycle racks, a clock tower", id: "courtyard" },
      { v: "shinto shrine deep in a forest, red torii gate, mossy stone stairs, stone lanterns", id: "shrine" },
      { v: "dense bamboo forest, towering stalks, narrow dirt path, filtered light", id: "bamboo" },
      { v: "traditional Japanese garden, koi pond, arched wooden bridge, stone lantern, manicured pines", id: "garden" },
      { v: "suburban train station platform, railway tracks, overhead wires, station signs", id: "station" },
      { v: "empty commuter train interior, rows of seats, hanging hand straps, windows", id: "train-interior" },
      { v: "narrow alley with steep concrete stairs, laundry lines, drain pipes, cluttered walls", id: "alley-stairs" },
      { v: "city rooftop covered with air conditioners and antennas, distant buildings", id: "rooftop" },
      { v: "old steel bridge over a wide river, railings, city on the far bank", id: "bridge" },
      { v: "rocky coastline, crashing waves, sea spray, dramatic clouds", id: "coast" },
      { v: "layered mountain ridges fading into mist, pine trees in the foreground", id: "mountains" },
      { v: "terraced rice paddies on a hillside, narrow paths, distant village", id: "rice-terraces" },
      { v: "vast desert dunes, cracked dry earth, a lone dead tree, heat haze", id: "desert" },
      { v: "ruined overgrown city, collapsed buildings, vines and weeds, abandoned rusted cars", id: "ruined-city" },
      { v: "abandoned stone castle interior, broken pillars, shafts of light through holes in the ceiling", id: "castle" },
      { v: "abandoned laboratory, broken machines, dangling cables, scattered papers", id: "laboratory" },
      { v: "old library with towering bookshelves, dust floating in light beams", id: "library" },
      { v: "abandoned greenhouse, shattered glass panes, overgrown exotic plants", id: "greenhouse" },
      { v: "rural road through rice fields, telephone poles, distant mountains", id: "rural-road" },
      { v: "dark twisted forest, bare gnarled trees, thick fog, full moon", id: "dark-forest" },
      { v: "old hillside cemetery, crooked gravestones, iron fence, crows", id: "cemetery" },
      { v: "deep space nebula, ringed planet, dense starfield, science-fiction vista", id: "space" },
      { v: "cyberpunk megacity canyon of towers, huge billboards, elevated highways", id: "cyberpunk" },
      { v: "sci-fi spaceship corridor, metal panels, pipes, glowing lights", id: "spaceship" },
      { v: "space station interior with a huge window overlooking the Earth", id: "space-station" },
      { v: "traditional Japanese countryside village, wooden houses, stone walls, rice paddies", id: "village" },
      { v: "night street market stalls with paper lanterns, hanging signs, crates of produce", id: "night-market" },
      { v: "city park in heavy rain, puddles, benches, dense trees, lamp posts", id: "park-rain" },
      { v: "traditional Japanese room, tatami floor, shoji screens, low table, tokonoma alcove", id: "tatami-room" },
      { v: "underwater coral reef, schools of fish, shafts of sunlight, seaweed", id: "underwater" },
      { v: "volcanic landscape, rivers of lava, ash clouds, jagged black rock", id: "volcanic" },
      { v: "lone island with steep cliffs in a vast ocean, waves, seabirds", id: "island" },
      { v: "snowy mountain pass road, guardrails, pine forest, grey sky", id: "snow-road" }
    ],
    periods: [
      { v: "at dawn, soft pale morning light, long shadows", id: "dawn" },
      { v: "in the morning, clear bright daylight", id: "morning" },
      { v: "at high noon, harsh overhead sunlight", id: "noon" },
      { v: "in the late afternoon, warm low-angle light", id: "afternoon" },
      { v: "at sunset, dramatic backlight and silhouettes", id: "sunset" },
      { v: "at night under bright moonlight, deep shadows", id: "night-moon" },
      { v: "at night illuminated by artificial lights and neon", id: "night-city" },
      { v: "in the dead of night, eerie all-consuming darkness", id: "deep-night" }
    ],
    weathers: [
      { v: "clear sky", id: "clear" },
      { v: "overcast sky, soft diffuse light", id: "overcast" },
      { v: "heavy rain, falling rain streaks, wet reflective surfaces", id: "rain" },
      { v: "violent thunderstorm, lightning, towering dark clouds", id: "storm" },
      { v: "falling snow, heavy snow cover", id: "snow" },
      { v: "thick rolling fog, hazy atmosphere", id: "fog" },
      { v: "strong wind, swirling leaves and debris", id: "wind" }
    ],
    angles: [
      { v: "wide establishing shot", id: "wide" },
      { v: "bird's-eye view looking down from above", id: "birds-eye" },
      { v: "worm's-eye view looking up from below", id: "worms-eye" },
      { v: "very low ground-level camera angle", id: "ground" },
      { v: "ultra-wide panoramic vista", id: "panoramic" },
      { v: "extreme close-up on a single environmental detail, shallow depth of field", id: "closeup" },
      { v: "aerial drone view", id: "aerial" }
    ],
    styles: [
      { v: "classic pen and ink drawing, clean confident linework", id: "pen-ink" },
      { v: "modern manga screentone shading, varied dot patterns, crisp edges", id: "screentone" },
      { v: "dense cross-hatching in the shadows, engraved look", id: "crosshatch" },
      { v: "high-contrast chiaroscuro inking, bold black and white tonal masses", id: "chiaroscuro" },
      { v: "rough pencil sketch, graphite texture, loose strokes", id: "pencil" },
      { v: "sumi-e ink wash painting, expressive brush strokes, generous negative space", id: "sumi-e" },
      { v: "dry-brush ink texture, gritty grainy shading", id: "dry-brush" },
      { v: "ultra-detailed seinen manga background linework, realistic architecture", id: "seinen" }
    ],
    densities: [
      { v: "lightly shaded with sparing screentone", id: "light" },
      { v: "balanced screentone shading", id: "medium" },
      { v: "heavily shaded, dense layered screentone", id: "dense" }
    ],
    details: [
      { v: "simple uncluttered composition", id: "simple" },
      { v: "intricate and richly detailed", id: "detailed" },
      { v: "extremely intricate and meticulous detail everywhere", id: "ultra" }
    ],
    extras: [
      { v: "dramatic exaggerated perspective", id: "perspective" },
      { v: "strong depth of field, sharp foreground and blurred background", id: "dof" },
      { v: "wet reflective surfaces", id: "wet" },
      { v: "volumetric god rays", id: "godrays" },
      { v: "floating dust particles", id: "dust" },
      { v: "birds in the sky", id: "birds" },
      { v: "speed lines and focus lines", id: "speedlines" },
      { v: "billowing smoke and dust", id: "smoke" },
      { v: "overgrown vegetation", id: "overgrowth" },
      { v: "cracked and weathered textures", id: "weathered" },
      { v: "reflections in still water", id: "reflections" }
    ]
  };

// To add a language: append an entry to `languages`, then add matching `strings[code]`
// and `labels[code]` blocks. Missing keys fall back to `defaultLanguage` (English).
