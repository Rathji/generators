  return {
    languages: [
      { code: "en", label: "English" },
      { code: "pt", label: "Português (BR)" },
      { code: "ja", label: "日本語" },
      { code: "fr", label: "Français" },
      { code: "es", label: "Español" }
    ],
    defaultLanguage: "en",
    strings: {
      en: {
        appTitle: "Manga ",
