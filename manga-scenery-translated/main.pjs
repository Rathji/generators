buildMangaPrompt(opts = {}) =>
  let parts = [];
  let scene = (opts.scene || "").trim();
  parts.push(scene || "an evocative empty environment");
  if (opts.period) parts.push(opts.period);
  if (opts.weather) parts.push(opts.weather);
  if (opts.angle) parts.push(opts.angle);
  if (opts.style) parts.push(opts.style);
  if (opts.density) parts.push(opts.density);
  if (opts.detail) parts.push(opts.detail);
  if (opts.extras && opts.extras.length) parts.push(opts.extras.join(", "));
  parts.push(mangaBase());
  return parts.filter(Boolean).join(", ");
