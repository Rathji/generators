// ─────────────────────────────────────────────────────────────
//  CHARTERSTONE — a Perchance recreation of the 2017 Stonemaier
//  legacy board game (worker placement · deck-building · 12-game
//  legacy campaign · 1–6 players).
//
//  Roadmap/backlog lives in src/roadmap.pjs (80 tasks, 17 phases).
//  Game engine + UI are built task-by-task from that backlog.
//  Phase 14 (multiplayer) re-imports the server-plugin.
// ─────────────────────────────────────────────────────────────

$meta
  title = Charterstone — Build Your Legacy
  description = A faithful Perchance recreation of Charterstone, the 12-game legacy board game. Found a village, place workers, construct buildings, unlock crates and stickers as twelve games permanently reshape the board. 1–6 players at the table, online with friends, or solo vs the Automa.
  tags = board game, legacy, worker placement, campaign, multiplayer, online, solo, automa, building, stonemaier
  image = https://user.uploads.dev/file/95b42b398dedb399141e07015172aea4.jpg
  header
    mode = minimal

// ── Plugins ──
// kv-plugin: per-user IndexedDB persistence for save/load (Task 6 serialization).
kv = {import:kv-plugin}
// server-plugin: authoritative room/turn/chat server for online play (Phase 14).
createServerSocket = {import:server-plugin}

// ── Brand ──
gameTitle = Charterstone
gameTagline = Build the village. Shape the kingdom. Make your mark on a land that remembers.
gameKicker = A 12-game legacy campaign
gameGenre = Legacy Board Game
gamePlayers = 1–6 players · ~60 min per game
accentColor = #2fae8c
heroImage = https://user.uploads.dev/file/95b42b398dedb399141e07015172aea4.jpg

// ── The founding facts (shown on the landing page) ──
foundingFacts
  The village remembers. Buildings you construct stay on the board forever.
  Twelve games tell one story — each one permanently changes the next.
  2 workers. 12 influence. 6 resources. One immortal village.
  Solo with the Automa, or fill your charter with friends.

// ── Current build status (mirrors src/roadmap.pjs) ──
buildStatus = ✅ Charterstone is complete — all 80 of 80 roadmap tasks across 17 phases are implemented and validated (40 test suites). Foundation, cards, objectives, crates, stickers, Archive, Chronicle, the full building set, campaign meta-progression, Automa solo, AI opponents, online multiplayer (1-6 seats), learn-as-you-play tutorial, how-to-play guide, icon legend, save slots, WebAudio SFX + ambient music, accessibility (keyboard, color-blind-safe tokens, WCAG AA), performance safeguards, campaign-complete replay and campaign summary with export. Published with the branded hero + discovery metadata for the listing page and share cards.
