// @downloadURL https://sttampermonkey6234.blob.core.windows.net/scripts/tampermonkey.user.js

// --- 1. CONFIGURATION ---
$meta
  title = GENESIS Image Generator
  description = Powerful AI image generator with basic and advanced character controls: identity, body, attire, scene, lighting, style and safety filters.
  tags = ai, image, generator, art, character, portrait, style, stable diffusion, text to image
generateImage = {import:text-to-image-plugin}
generateText = {import:ai-text-plugin}

// Hardcoded Overrides
force_safety = false
force_quality = true
force_mass_negative = false

display_output = Ready to generate...

// --- 2. HTML INJECTION MAPPINGS (LOGIC LAYER) ---
// Note: Uses .shift()/.pop() and .split("'") to ensure "Logic First" structure works without parser errors.

// > Advanced Mode: Character & Identity
// UPDATED: Now utilizes 'full_gender_list' for comprehensive identity options
html_gender   = [full_gender_list.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_people   = [type_of_people.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_body     = [body_type.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_bmod     = [body_type_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_visual   = [visual_descriptor.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]

// > Gender Specifics
html_fmod     = [female_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_mmod     = [male_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_nmod     = [nonbinary_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]

// > Appearance & Attire
html_face     = [facial_expression.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_hair     = [hairstyle.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_hmod     = [hairstyle_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_pos      = [body_position.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_cloth    = [clothing_item.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_adj      = [clothing_adjective.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_fab      = [fabric_state.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_col      = [color.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]

// NEW: Jewelry
html_jewel    = [jewelry.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_jmod     = [jewelry_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]

// > Environment & Style
html_loc      = [location.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_lmod     = [location_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_time     = [time_period.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_tmod     = [time_period_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_light    = [lighting.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_angle    = [camera_angle.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_art      = [style_list.selectAll.map(i => "<option value='" + String(i).split("|").pop().trim().split("'").join("&#39;") + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_smod     = [style_list_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
// NEW: Props
html_prop     = [prop.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_pmod     = [prop_mods.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]

// > Safety & Quality Mappings (Unchanged)
html_safety_nsfw_clothing      = [safety_nsfw_clothing.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_safety_nsfw_positions     = [safety_nsfw_positions.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_safety_nsfw_anatomy       = [safety_nsfw_anatomy.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_safety_nsfw_acts          = [safety_nsfw_acts.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_safety_nsfw_concepts      = [safety_nsfw_concepts.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]

html_negative_quality_camera     = [negative_quality_camera.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_negative_quality_visuals    = [negative_quality_visuals.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_negative_quality_anatomy    = [negative_quality_anatomy.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_negative_quality_limbs      = [negative_quality_limbs.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]
html_negative_quality_artificial = [negative_quality_artificial.selectAll.map(i => "<option value='" + String(i).split("|").shift().trim() + "'>" + String(i).split("|").shift().trim() + "</option>").join("")]// --- 3. DATA LAYER (LISTS) ---

style_list
  Abstract Expressionism | chaotic splashes, jackson pollock style, emotional energy, non-representational, textured
