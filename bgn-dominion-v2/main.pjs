// ─────────────────────────────────────────────────────────────
//  DOMINION COMPLETE — main.pjs
//  Page config + branding for a full browser recreation of
//  Dominion: the base game and every official expansion.
//  Game logic lives in src/ (see src/roadmap.pjs for the build
//  backlog). This file is mostly user-tweakable config.
// ─────────────────────────────────────────────────────────────

$meta
  title = Dominion Complete
  description = Release 0.1 — a complete browser recreation of Dominion with the Base Game, Intrigue, Seaside, Alchemy and Prosperity (all 2nd Edition) — hotseat, AI opponents, online play, and every expansion on the roadmap.
  tags = dominion, deck builder, board game, card game, strategy, multiplayer, ai
  image = https://user.uploads.dev/file/2efb2ace2b634986ad5afc9bb90c6fb0.jpg
  header
    mode = minimal

// ── Branding / config (editable) ──────────────────────────────
gameTitle = Dominion Complete
gameTagline = Every card. Every expansion. One kingdom.
gameKicker = Deck-building · 2–6 players · Release 0.1
gameGenre = Deck-building
gamePlayers = 2–6 players
accentColor = #c9a227      // gold — primary accent
accentColor2 = #2fae8c     // emerald — secondary accent
heroImage = https://user.uploads.dev/file/2efb2ace2b634986ad5afc9bb90c6fb0.jpg

// ── Release info (v0.1) ───────────────────────────────────────
releaseVersion = 0.1
releaseLabel = Release 0.1
releaseNote = Base Game + Intrigue, Seaside, Alchemy and Prosperity (all 2nd Edition) — every card implemented, tested and playable. Cornucopia is next on the roadmap.
shippedExpansions = 4        // Intrigue · Seaside · Alchemy · Prosperity (the first 4 in the list below)

// ── The 16 official expansions (order of release) ─────────────
expansions
  Intrigue            // live in v0.1
  Seaside             // live in v0.1
  Alchemy             // live in v0.1
  Prosperity          // live in v0.1
  Cornucopia          // next up
  Hinterlands
  Dark Ages
  Guilds
  Adventures
  Empires
  Nocturne
  Renaissance
  Menagerie
  Allies
  Plunder
  Rising Sun

// ── Online play (rooms/sync arrive in the multiplayer phase) ──
createServerSocket = {import:server-plugin}

// ── Persistent saves & stats (kv-plugin: autosave/resume, settings) ──
kv = {import:kv-plugin}
