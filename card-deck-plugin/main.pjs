// =====================================================================
// RECONSTRUCTION
// =====================================================================
//
// Rebuilds one asset's SVG text from the template + string-pool payload. Mirrors
// game-assets' tools/verify_payload.py `reconstruct()` exactly: start with chunks[0], then
// alternate (pooled string, next chunk) for every entry in the asset's field-index list.

cardDeckBuild(asset) =>
  let chunks = window.CARD_DECK_PAYLOAD.templates[asset.t];
  let out = chunks[0];
  for(let i = 0; i < asset.f.length; i++) {
    out += window.CARD_DECK_PAYLOAD.strings[asset.f[i]] + chunks[i + 1];
  }
  return out;


// Recolours an already-rebuilt card SVG by substituting its baked-in hex values.
// `asset.k.color` is the card's baked ink (black or red); "#ffffff"/"#d0d0d0" are the
// baked background/border shared by every `simple`-style card (confirmed by reading the
// payload's own template and string pool -- see NOTES.md). The four-colour-deck suit map
// and the substitution approach itself are our own composition, not corpus-derived: see
// NOTES.md, "Not from the corpus".

cardDeckRecolor(svg, asset, opts) =>
  let ink = opts.ink;
  if(!ink && opts.fourColor && asset.k && asset.k.suit) {
    let fourColourInk = {S: "#1a1a1a", C: "#1a7a3c", H: "#d32f2f", D: "#1a56d3"};
    ink = fourColourInk[asset.k.suit];
  }
  if(ink && asset.k && asset.k.color) svg = svg.split(asset.k.color).join(ink);
  if(opts.ground) svg = svg.split("#ffffff").join(opts.ground);
  if(opts.border) svg = svg.split("#d0d0d0").join(opts.border);
  return svg;


// =====================================================================
// PLUGIN ENTRY POINT
// =====================================================================
//
// Column-0 function-form $output -- the plugin-definition idiom cited at
// examples/wheel-plugin/lists.txt:117 (`$output(wheelOptions) =>`) and
// examples/ai-furry-generator/lists.txt:1072 (`$output(txt) =>`). This is a different
// construct from the nested `$output = [expr]` assignment form discussed in
// reference/lists-dsl-cheatsheet.md:282-317 -- that entry is explicit that a
// plugin-definition $output does not resolve its "top-level $output" open question, and
// this file's $output is exactly that excluded case. Multiple named parameters on $output
// itself are not directly attested by either witness (both take one parameter) -- see
// NOTES.md, "Multi-parameter $output", for the composed citation and the residual risk.

$output(id, arg2, arg3) =>
  if(!window.CARD_DECK_PAYLOAD) initCardDeck();

  if(id === "list") {
    return window.CARD_DECK_PAYLOAD.assets.map(a => a.i);
  }

  let lookupId = id;
  if(id === "back") {
    let motif = arg2;
    let colourway = arg3;
    let knownMotifs = ["lattice", "rosette", "chevrons", "dots"];
    let knownColourways = ["navy", "maroon", "pine", "plum"];
    if(knownMotifs.indexOf(motif) === -1) return "(unknown back motif: " + motif + ")";
    if(knownColourways.indexOf(colourway) === -1) return "(unknown colourway: " + colourway + ")";
    lookupId = "back_" + motif + "_" + colourway;
  }

  let asset = null;
  for(let a of window.CARD_DECK_PAYLOAD.assets) {
    if(a.i === lookupId) { asset = a; break; }
  }
  if(!asset) return "(unknown card id: " + id + ")";

  let svg = cardDeckBuild(asset);
  if(id !== "back" && arg2) svg = cardDeckRecolor(svg, asset, arg2);
  return svg;
