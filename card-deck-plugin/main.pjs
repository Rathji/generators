// Card Deck Plugin -- Lists panel
//
// Renders inline <svg> playing cards and card backs from ids, sourced from one embedded
// payload (game-assets' tools/export_payload.py output). Zero imports -- everything the
// plugin needs travels inside this file. See NOTES.md for a citation on every non-obvious
// construct used below.
//
// Public API, called from a consuming generator that binds this plugin, e.g.
// `cardDeck = {import:card-deck-plugin}`:
//   cardDeck(id)                          -> inline <svg> for "AS", "10C", "joker_black", ...
//   cardDeck(id, opts)                    -> same, opts = {fourColor, ink, ground, border}
//   cardDeck("back", motif, colourway)    -> one of the 16 card backs
//   cardDeck("list")                      -> array of the 70 valid ids
// Never throws: an unknown id/motif/colourway returns a parenthesised placeholder string
// instead of an exception.

$meta
  title = Card Deck Plugin
  description = Renders inline SVG playing cards and card backs by id. Outline paths only, no fonts, no external assets. Never throws -- an unknown id returns a readable placeholder string.
  tags = cards, playing-cards, svg, plugin, deck
  header
    mode = minimal


// =====================================================================
// EMBEDDED PAYLOAD
// =====================================================================
//
// initCardDeck() lazily populates window.CARD_DECK_PAYLOAD exactly once. This mirrors
// examples/wheel-plugin/lists.txt:249 (initWinwheel), which the $output body below guards
// the same way wheel-plugin guards window.Winwheel: `if(!window.X) initX();`
// (examples/wheel-plugin/lists.txt:118). The bulk vendored data living inside a plain
// `window.NAME = {...}` assignment nested in this helper is the same shape as
// examples/wheel-plugin/lists.txt:348-352 and :355 (the vendored Winwheel library and its
// base64 sound data URIs).
//
// Generated by tools/export_payload.py in game-assets from playing-cards/simple x54 and
// playing-cards/backs x16 (game-assets/index.json). 70 assets collapsed to 1 template and
// 124 pooled strings, 132,523 B. Rebuild is proven byte-identical for all 70 assets by
// tools/verify_payload.py in that repo ("70/70 reconstructed byte-identical", exit 0). Do
// not hand-edit the object literal below -- regenerate it in game-assets and re-paste.

initCardDeck() =>
  window.CARD_DECK_PAYLOAD = {"v":1,"sources":[{"family":"playing-cards","style":"simple","target_px":40,"view_box":[0,0,240,336],"count":54},{"family":"playing-cards","style":"backs","target_px":40,"view_box":[0,0,240,336],"count":16}],"templates":[["<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 240 336\" role=\"img\" aria-label=\"","\">\n<rect width=\"240\" height=\"336\" rx=\"16\" fill=\"","\"/>\n<rect x=\"3.0\" y=\"3.0\" width=\"234\" height=\"330\" rx=\"13.0\" fill=\"none\" stroke=\"","\" stroke-width=\"6\"/>\n<path fill=\"","\" d=\"","\"/>\n</svg>\n"]],"strings":["ace of spades","#ffffff","#d0d0d0","#1a1a1a","M21.824 58L31.529 58L38 37.294L44.471 58L54.176 58L38 14ZM28.941 50.235L47.059 50.235L47.059 42.471L28.941 42.471ZM38 64C29.25 70.875 23 77.125 23 82.75C23 89 27.688 92.75 32.688 92.75C35.812 92.75 37.375 90.562 38 88.062C38.625 90.562 40.188 92.75 43.312 92.75C48.312 92.75 53 89 53 82.75C53 77.125 46.75 70.875 38 64ZM38 80.25C38 86.5 36.75 91.5 33 94L43 94C39.25 91.5 38 86.5 38 80.25ZM218.176 278L208.471 278L202 298.706L195.529 278L185.824 278L202 322ZM211.059 285.765L192.941 285.765L192.941 293.529L211.059 293.529ZM202 272C210.75 265.125 217 258.875 217 253.25C217 247 212.312 243.25 207.312 243.25C204.188 243.25 202.625 245.438 202 247.938C201.375 245.438 199.812 243.25 196.688 243.25C191.688 243.25 187 247 187 253.25C187 258.875 193.25 265.125 202 272ZM202 255.75C202 249.5 203.25 244.5 207 242L197 242C200.75 244.5 202 249.5 202 255.75ZM72.941 232L101.176 232L120 171.765L138.824 232L167.059 232L120 104ZM93.647 209.412L146.353 209.412L146.353 186.824L93.647 186.824ZM120 244C99.583 260.042 85 274.625 85 287.75C85 302.333 95.938 311.083 107.604 311.083C114.896 311.083 118.542 305.979 120 300.146C121.458 305.979 125.104 311.083 132.396 311.083C144.062 311.083 155 302.333 155 287.75C155 274.625 140.417 260.042 120 244ZM120 281.917C120 296.5 117.083 308.167 108.333 314L131.667 314C122.917 308.167 120 296.5 120 281.917Z","two of spades","M32.091 26.5