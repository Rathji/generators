$meta
  title = Five Realms / MTG Deck Import/Export Studio
  description = Import decklist text (Arena, Moxfield, Archidekt, TappedOut) or a raw MTGJSON Deck JSON, convert to the precise MTGJSON Deck model (mainBoard / sideBoard / commander), and build with an interactive builder — card search, set autofill, auto manabase, live Scryfall legality and interactive builder, live mana-curve stats. Works for both Five Realms (plays just like MTG — play it at perchance.org/bgn-five-realms) and Magic: The Gathering. Card data (mana-cost parsing, colors, frames/gems/glyphs) is handled by the shared five-realms card-data engine.
  tags = five-realms, mtg, magic, magic-the-gathering, deck, deckbuilder, import, export, arena, moxfield, tappedout, archidekt, mtgjson, json, scryfall
  header
    mode = minimal

// super-fetch lets the page try loading a TappedOut deck URL directly through a
// proxy. If a deck is Cloudflare-blocked the UI falls back to pasting its text.
superFetch = {import:super-fetch-plugin}

// Rendering for the mana-curve + deck-stats charts.
charts = {import:data-visualization-plugin}

// Card data: mana-cost parsing, colors, and card frame/gem/glyph rendering come from
// the shared five-realms card-data engine. We route cost -> color/identity extraction
// and card rendering through it.
fr = {import:five-realms-plugin}
