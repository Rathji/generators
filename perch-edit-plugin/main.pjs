$meta
  title = PerchEdit Plugin
  description = A full-featured browser-based code editor with file tree, terminal, and AI assistance.
  tags = code editor, ide, javascript, tools
  image = https://perchance.org/perch-edit

// SECTION 0: IMPORTS
perchEditKv = {import:kv-plugin}
perchEditGenerateText = {import:ai-text-plugin}
perchEditUploadPlugin = {import:upload-plugin}
perchEditSuperFetch = {import:super-fetch-plugin}

// SECTION 1: EMBEDDED DATA
initPerchEditData() =>
  if (window.PERCH_EDIT_PAYLOAD) return;
  window.PERCH_EDIT_PAYLOAD = { slug: "perch-edit", title: "PerchEdit", hostPage: "https://perchance.org/perch-edit", embedHost: "https://null.perchance.org/perch-edit", defaultHeight: 800 };

perchEditData() =>
  initPerchEditData();
  return window.PERCH_EDIT_PAYLOAD;

// SECTION 2: CATALOG
// Each item is a toolset variant exposed through the plugin API.
perchEditCatalog
  editor
    slug = editor
    title = Code Editor
    description = Full browser-based code editor for Perchance projects with syntax highlighting and autosave.
    url = https://null.perchance.org/perch-edit
  terminal
    slug = terminal
    title = Terminal
    description = Integrated terminal to run scripts and commands right in the browser.
    url = https://null.perchance.org/perch-edit
  files
    slug = files
    title = File Tree
    description = Browse, create, and manage project files from a collapsible tree view.
    url = https://null.perchance.org/perch-edit
  ai
    slug = ai
    title = AI Assistant
    description = Get AI-powered code help, explanations, and generated snippets.
    url = https://null.perchance.org/perch-edit

perchEditConfig
  appName = Code

// SECTION 3: HELPERS
perchEditFind(slug) =>
  for (let item of perchEditCatalog.selectAll) {
    if (item.slug === slug) return item;
  }
  return null;

perchEditToPlain(item) =>
  return { slug: item.slug, title: item.title, description: item.description, url: item.url };

perchEditEmbed(slug, opts) =>
  let data = perchEditData();
  let item = perchEditFind(slug) || { slug: slug, title: data.title, url: data.embedHost };
  let height = (opts && opts.height) || data.defaultHeight;
  return `<iframe src="${item.url}" style="width:100%; height:${height}px; border:none;" sandbox="allow-scripts allow-forms allow-modals allow-same-origin"></iframe>`;

perchEditCard(slug) =>
  let data = perchEditData();
  let item = perchEditFind(slug) || { slug: slug, title: data.title, description: "" };
  return `<div class="perch-edit-card"><b>${item.title}</b><br>${item.description} <a href="${data.hostPage}" target="_blank">Open Editor</a></div>`;

perchEditFindPlain(slug) =>
  let item = perchEditFind(slug);
  return item ? perchEditToPlain(item) : null;

perchEditRunCode(code) =>
  try { return eval(code); } catch (e) { return "Error: " + e.message; }

// SECTION 4: ENTRY POINT
perchEditMakeApi() =>
  let api = {};
  api.embed = (slug, opts) => perchEditEmbed(slug, opts);
  api.card = (slug) => perchEditCard(slug);
  api.all = () => perchEditCatalog.selectAll.map(perchEditToPlain);
  api.find = perchEditFindPlain;
  api.data = () => perchEditData();
  api.config = perchEditConfig;
  api.runCode = perchEditRunCode;
  window.PERCH_EDIT_API = api;
  return api;

$output = [perchEditMakeApi()]
