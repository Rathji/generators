$meta
  title = Radiant Bodies ✦ Free AI Beautiful People
  description = Free, unlimited AI-generated portraits of beautiful people — 10 styles, SFW and NSFW modes. Adult content; 18+ only. No signup, no watermark.
  tags = ai art, ai image, image generator, portrait, beautiful people, nsfw
  header
    mode = minimal

generateImage = {import:text-to-image-plugin}

// Radiant Faces — beautiful people, 10 styles × SFW/NSFW.
// Style helpers live in the `styles` list; each has an `sfw` and an `nsfw`
// prompt suffix. The nsfw helpers encourage explicit adult content, while the
// negative prompts always block illegal content (minors, non-consent, etc.).

personWoman
  a beautiful adult woman, age 25
  a gorgeous woman in her early thirties
  a stunning woman in her forties
  an elegant woman in her fifties
  a beautiful woman in her twenties
  a radiant woman with a gentle face

personMan
  a handsome adult man, age 27
  an attractive man in his early thirties
  a striking man in his forties
  a distinguished man in his fifties
  a handsome man in his twenties
  a charming man with a warm face

descent
  of caucasian descent
  of east asian descent
  of south asian descent
  of african descent
  of middle eastern descent
  of latin american descent
  of nordic descent
  of mediterranean descent
  of southeast asian descent
  of north african descent
  of mixed heritage

