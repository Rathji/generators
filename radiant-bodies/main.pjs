  with long flowing [hairColor] hair
  with shoulder-length [hairColor] hair
  with short [hairColor] hair
  with curly [hairColor] hair
  with wavy [hairColor] hair
  with sleek straight [hairColor] hair
  with voluminous [hairColor] hair
  with [hairColor] hair in an elegant updo

hairColor
  golden blonde
  chestnut brown
  jet black
  auburn
  silvery
  honey blonde
  deep brown
  copper red

eyes
  with striking [eyeColor] eyes
  with deep [eyeColor] eyes
  with warm [eyeColor] eyes
  with luminous [eyeColor] eyes
  with gentle [eyeColor] eyes

eyeColor
  blue
  green
  hazel
  brown
  amber
  grey
  emerald
  dark brown

features
  with soft features
  with sharp cheekbones
  with a warm smile
  with a light sprinkling of freckles
  with flawless skin
  with a confident expression
  with a radiant expression
  with dimples
  with a subtle, knowing smile
  with kind eyes and a serene expression

outfit
  wearing a cozy knit sweater
  wearing an elegant evening dress
  wearing a crisp linen shirt
  wearing a stylish leather jacket
  wearing a flowing silk blouse
  wearing a tailored suit
  wearing a soft cashmere scarf
  dressed in casual-chic streetwear
  wearing a delicate lace dress
  dressed in a smart casual outfit

pg13Outfit
  wearing a skimpy bikini
  wearing lacy lingerie
  wearing a sheer mesh top
  wearing a revealing bodysuit
  in a wet white tank top
  wearing a tiny crop top and shorts
  in a sheer nightgown
  wrapped in a towel, freshly showered
  in a barely-there swimsuit
  wearing a lace-trimmed camisole

setting
  in a sunlit garden
  at golden hour in a wildflower meadow
  in a cozy cafe with warm light
  against soft bokeh city lights at night
  on a misty mountain overlook
  at a colorful flower market
  beside a quiet lake at sunrise
  in warm studio lighting
  in an old library lit by afternoon sun
  on a rooftop at dusk
  on a rainy city street with neon reflections
  on a windswept beach

sfwTail = [descent], [hair] and [eyes], [features], [outfit]
pg13Tail = [descent], [hair] and [eyes], [features], [pg13Outfit]
nsfwTail = [descent], [hair] and [eyes], [features], adult, fully nude, naked, topless, explicit, pornographic, erotic, sensual

sfwNegative = NSFW, nudity, explicit, naked, topless, underwear, lingerie, revealing clothing, sexual, erotic, blurry, low quality, low resolution, deformed, disfigured, extra fingers, extra limbs, bad anatomy, bad hands, text, watermark, logo, cartoon, 3d render

pg13Negative = nudity, naked, topless, explicit, pornographic, erotic, sexual, genitals, full frontal, hardcore, blurry, low quality, low resolution, deformed, disfigured, extra fingers, extra limbs, bad anatomy, bad hands, text, watermark, logo, cartoon, 3d render

nsfwNegative = underage, child, minor, teenager, teen, schoolgirl, loli, kid, non-consensual, forced, coercion, drugged, unconscious, sleeping, snuff, gore, blood, violence, mutilation, bestiality, animal, incest, blurry, low quality, low resolution, deformed, disfigured, extra fingers, extra limbs, bad anatomy, bad hands, text, watermark, logo

