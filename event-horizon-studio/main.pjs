title
  Event Horizon Studio

ai = {import:ai-text-plugin}
t2i = {import:t2i-plugin}

output
  [null]

// Variables
user_input = waiting
viewpoint = earth
theme_flag = 1
background_image_url = "https://images.unsplash.com/photo-1656464868371-602be27fd4c2?q=80&w=1964&auto=format&fit=crop"

// Lists for dynamic prompt generation
space_objects
  satellite
  space station
  deep-space probe
  asteroid
  lunar lander
  Mars rover
  telescope
  orbital platform

earth_views
  from desert observatory
  from snowy mountain peak
  from coastal launch site
  from urban rooftop

space_views
  near asteroid belt
  orbiting Jupiter
  above Saturn’s rings
  deep interstellar void
  near a distant exoplanet

style_vector
  hyper-realistic
  cinematic lighting
  ultra high definition
  volumetric detail
  ray tracing
  impeccable composition

end_vector
  8K resolution
  sharp focus
  dramatic contrast
  photorealistic textures

negative_prompt
  cartoon
  anime
  low quality
  blurry
  distorted
  unrealistic

// Selectors
viewpoint_selector
  [viewpoint == "earth" ? earth_views.selectOne : space_views.selectOne]

neg_selector
  [negative_prompt.selectAll.join(", ")]

fabrication_matrix
  [style_vector.selectAll.join(", ")], [space_objects.selectOne] viewed [viewpoint_selector], [end_vector.selectAll.join(", ")]

// Theme selectors
theme_background
  [theme_flag == 1 ? "#0B0C10" : theme_flag == 2 ? "#121212" : "#0D0D0D"]

theme_primary
  [theme_flag == 1 ? "#1F2833" : theme_flag == 2 ? "#1E1E1E" : "#2C2F33"]

theme_accent
  [theme_flag == 1 ? "#66FCF1" : theme_flag == 2 ? "#BB86FC" : "#7289DA"]

theme_text
  [theme_flag == 1 ? "#C5C6C7" : theme_flag == 2 ? "#E0E0E0" : "#FFFFFF"]

theme_header_font
  Orbitron, sans-serif

theme_body_font
  Exo 2, sans-serif

// Background style with gradient overlay
background_style
  ["background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url(" + background_image_url + "); background-size:cover; background-position:center; background-attachment:fixed; background-color:" + theme_background + ";"]
